---
import { getCollection } from 'astro:content';

interface Translation {
  locale: string;
  slug: string;
}

interface Props {
  locale: string;
  title: string;
  description: string;
  /** Other language versions of this exact page, for hreflang + the language switcher. Omit on pages that don't vary by tool (e.g. homepage). */
  translations?: Translation[];
  /** Path after the locale segment, e.g. "km-v-mili" or "" for the homepage. */
  path?: string;
  /** Category link shown above the page content, e.g. { label: "Длина", href: "/ru/tools/length" }. Omit on pages with no parent category (homepage, category pages themselves). */
  breadcrumb?: { label: string; href: string };
}

const { locale, title, description, translations = [], path = '', breadcrumb } = Astro.props;

const LOCALE_NAMES: Record<string, string> = { ru: 'Русский', en: 'English' };
const DEFAULT_LOCALE = 'ru';

// Every page needs a way to browse to other categories — fetched here once, in the shared
// Layout, instead of every page having to remember to pass it down.
const allCategories = await getCollection('categories');
const navCategories = allCategories.filter((c) => c.data.locale === locale);

// No trailing slash, ever — must match wrangler.jsonc's html_handling: "drop-trailing-slash",
// or canonical/hreflang URLs disagree with what the server actually serves (caught live on
// the homepage after the tool-page version of this same bug was already fixed once).
function localePath(loc: string, p: string) {
  return p ? `/${loc}/${p}` : `/${loc}`;
}

const canonicalUrl = new URL(localePath(locale, path), Astro.site).toString();
---

<!DOCTYPE html>
<html lang={locale}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content="index, follow">
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalUrl}>
<meta name="theme-color" content="#0e0f11">
<link rel="canonical" href={canonicalUrl}>
{translations.map((t) => (
  <link rel="alternate" hreflang={t.locale} href={new URL(localePath(t.locale, path), Astro.site).toString()} />
))}
{translations.some((t) => t.locale === DEFAULT_LOCALE) && (
  <link rel="alternate" hreflang="x-default" href={new URL(localePath(DEFAULT_LOCALE, path), Astro.site).toString()} />
)}
<style is:global>
  :root{
    --bg:#0e0f11;--surface:#181a20;--surface-2:#1c1e24;--line:rgba(255,255,255,0.09);
    --accent:#4ade9e;--accent2:#60efb8;--text:#f0f0f2;--muted:rgba(214,219,230,0.82);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{background:var(--bg);overflow-x:hidden;width:100%}
  body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:14px;display:flex;flex-direction:column;min-height:100vh;overflow-x:hidden;width:100%}
  nav{display:flex;align-items:center;justify-content:space-between;padding:0 2.5rem;height:56px;border-bottom:1px solid rgba(255,255,255,0.06);position:relative}
  .logo{font-size:20px;font-weight:700;color:#fff;text-decoration:none;display:flex;align-items:center;gap:8px}
  .logo img{border-radius:6px;display:block}
  .nav-right{display:flex;align-items:center;gap:8px}
  .dropdown{position:relative}
  .dd-btn{display:flex;align-items:center;gap:6px;background:var(--surface-2);border:1px solid var(--line);color:var(--text);font-family:inherit;font-size:12.5px;font-weight:700;letter-spacing:.03em;padding:7px 10px;border-radius:9px;cursor:pointer}
  .dd-btn:hover{border-color:rgba(255,255,255,0.2)}
  .dd-btn svg{width:12px;height:12px;color:var(--muted)}
  .dd-menu{display:none;position:absolute;top:calc(100% + 6px);right:0;min-width:170px;max-height:70vh;overflow-y:auto;background:#14161c;border:1px solid rgba(255,255,255,0.1);border-radius:12px;flex-direction:column;gap:0;padding:6px;z-index:100;box-shadow:0 12px 36px rgba(0,0,0,0.5)}
  .dd-menu.open{display:flex}
  .dd-link{font-size:13.5px;color:rgba(210,215,228,0.82);text-decoration:none;padding:10px 12px;border-radius:8px;white-space:nowrap;transition:all 0.15s}
  .dd-link:hover{color:#f0f0f2;background:rgba(255,255,255,0.05)}
  .dd-link.active{color:var(--accent);background:rgba(74,222,158,0.1)}
  .breadcrumb{max-width:680px;margin:0 auto;padding:14px 2rem 0;text-align:center}
  .breadcrumb a{font-size:12px;color:var(--muted);text-decoration:none}
  .breadcrumb a:hover{color:var(--accent)}
  @media(max-width:640px){nav{padding:0 1rem}.logo{font-size:18px}.breadcrumb{padding:12px 1rem 0}}
  .main{max-width:680px;margin:0 auto;width:100%;padding:2.5rem 2rem 3rem;flex:1;overflow-x:hidden}
  h1{font-size:24px;font-weight:600;text-align:center;margin-bottom:8px;letter-spacing:-0.3px}
  .subtitle{font-size:13px;color:var(--muted);text-align:center;margin-bottom:28px}
  .field{margin-bottom:16px}
  .field label{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:6px}
  .field select,.field input{width:100%;background:var(--surface-2);border:1px solid var(--line);border-radius:10px;color:var(--text);font-family:inherit;font-size:15px;padding:10px 12px;height:46px}
  .result-box{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px;text-align:center;margin-top:8px}
  .result-value{font-size:28px;font-weight:700;color:var(--accent)}
  .result-label{font-size:12px;color:var(--muted);margin-top:4px}
  section.seo{max-width:680px;margin:40px auto 0;padding:0 2rem;color:var(--muted);font-size:13px;line-height:1.7}
  section.seo h2{font-size:18px;color:rgba(210,215,228,0.85);font-weight:600;margin-bottom:14px}
  section.seo h3{font-size:15px;color:rgba(210,215,228,0.82);font-weight:500;margin-bottom:5px}
  section.seo p{margin-bottom:14px}
  .all-tools{max-width:900px;margin:50px auto 0;padding:0 2rem}
  .all-tools-title{font-size:18px;font-weight:600;color:rgba(210,215,228,0.85);margin-bottom:18px;text-align:center}
  .all-tools-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
  .tool-card{display:flex;flex-direction:column;gap:5px;padding:16px 14px;background:var(--surface);border:1px solid var(--line);border-radius:13px;text-decoration:none;transition:transform .12s,border-color .2s,background .2s}
  .tool-card:hover{transform:translateY(-3px);border-color:var(--accent);background:rgba(74,222,158,0.05)}
  .tc-name{font-size:14px;font-weight:600;color:var(--text)}
  .tc-desc{font-size:11.5px;color:rgba(210,215,228,0.7);line-height:1.35}
  @media(max-width:760px){.all-tools-grid{grid-template-columns:repeat(2,1fr)}.all-tools{padding:0 1rem}}
  @media(max-width:640px){.main{padding:1.5rem 1rem 2rem}section.seo{padding:0 1rem}}
  footer{padding:1.25rem;text-align:center;font-size:12px;color:rgba(200,205,220,0.78);border-top:1px solid rgba(255,255,255,0.05);margin-top:auto}
  footer a{color:rgba(200,205,220,0.75);text-decoration:none;margin:0 8px}
</style>
</head>
<body>
<nav>
  <a class="logo" href={localePath(locale, '')}>
    <img src="/favicon.svg" alt="" width="22" height="22">
    Opitro
  </a>
  <div class="nav-right">
    {navCategories.length > 0 && (
      <div class="dropdown" data-dropdown>
        <button class="dd-btn dd-btn-icon" aria-haspopup="listbox" aria-expanded="false" aria-label={locale === 'ru' ? 'Категории' : 'Categories'}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="dd-menu" role="listbox">
          {navCategories.map((c) => (
            <a href={localePath(locale, `tools/${c.data.catSlug}`)} class="dd-link">{c.data.title}</a>
          ))}
        </div>
      </div>
    )}
    {translations.length > 1 && (
      <div class="dropdown" data-dropdown>
        <button class="dd-btn" aria-haspopup="listbox" aria-expanded="false">
          {locale.toUpperCase()}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="dd-menu" role="listbox">
          {translations.map((t) => (
            <a href={localePath(t.locale, path)} class={`dd-link${t.locale === locale ? ' active' : ''}`}>{LOCALE_NAMES[t.locale] ?? t.locale}</a>
          ))}
        </div>
      </div>
    )}
  </div>
</nav>
{breadcrumb && (
  <div class="breadcrumb"><a href={breadcrumb.href}>← {breadcrumb.label}</a></div>
)}
<slot />
<footer>
  © 2026 Opitro
</footer>
<script>
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');
  dropdowns.forEach((dd) => {
    const btn = dd.querySelector<HTMLButtonElement>('.dd-btn');
    const menu = dd.querySelector<HTMLElement>('.dd-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = !menu.classList.contains('open');
      dropdowns.forEach((other) => {
        other.querySelector('.dd-menu')?.classList.remove('open');
        other.querySelector('.dd-btn')?.setAttribute('aria-expanded', 'false');
      });
      if (willOpen) {
        menu.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
  document.addEventListener('click', (e) => {
    dropdowns.forEach((dd) => {
      if (!dd.contains(e.target as Node)) {
        dd.querySelector('.dd-menu')?.classList.remove('open');
        dd.querySelector('.dd-btn')?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
</body>
</html>
