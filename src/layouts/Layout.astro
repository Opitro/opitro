---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t as translate } from '../lib/ui-strings.js';

interface Translation {
  locale: string;
  slug: string;
}

interface Props {
  locale: string;
  title: string;
  description: string;
  /** Other language versions of this exact page, for hreflang + the language switcher. Omit on pages that don't vary by tool (e.g. homepage). */
  translations?: Translation[];
  /** Path after the locale segment, e.g. "km-v-mili" or "" for the homepage. */
  path?: string;
  /** Category link shown above the page content, e.g. { label: "Длина", href: "/ru/tools/length" }. Omit on pages with no parent category (homepage, category pages themselves). */
  breadcrumb?: { label: string; href: string };
}

const { locale, title, description, translations = [], path = '', breadcrumb } = Astro.props;

const LOCALE_NAMES: Record<string, string> = { en: 'English', ru: 'Русский', es: 'Español', uk: 'Українська' };
const DEFAULT_LOCALE = 'en';

// Standing rule: every page title ends with the site name. Applied here rather than typed into
// each of the ~170 content files, so it can't be forgotten on a new page and can be changed in
// one place. Titles that already name the brand are left alone instead of doubling it up.
const BRAND = 'Opitro';
const fullTitle = title.includes(BRAND) ? title : `${title} | ${BRAND}`;

// Every page needs a way to browse to other categories — fetched here once, in the shared
// Layout, instead of every page having to remember to pass it down.
const allCategories = await getCollection('categories');
const navCategories = allCategories.filter((c) => c.data.locale === locale);

// Astro's own astro:i18n helper, not a hand-rolled string template -- verified via a real
// build that it still produces no trailing slash (must match wrangler.jsonc's
// html_handling: "drop-trailing-slash", or canonical/hreflang disagree with what the server
// actually serves, a bug caught live twice already before this URL-building was centralized).
const canonicalUrl = new URL(getRelativeLocaleUrl(locale, path), Astro.site).toString();
---

<!DOCTYPE html>
<html lang={locale}>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/manifest.json">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Opitro">
<title>{fullTitle}</title>
<meta name="description" content={description}>
<meta name="robots" content="index, follow">
<meta property="og:type" content="website">
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalUrl}>
<meta name="theme-color" content="#0e0f11">
<link rel="canonical" href={canonicalUrl}>
{translations.map((t) => (
  <link rel="alternate" hreflang={t.locale} href={new URL(getRelativeLocaleUrl(t.locale, path), Astro.site).toString()} />
))}
{translations.some((t) => t.locale === DEFAULT_LOCALE) && (
  <link rel="alternate" hreflang="x-default" href={new URL(getRelativeLocaleUrl(DEFAULT_LOCALE, path), Astro.site).toString()} />
)}
<style is:global>
  :root{
    --bg:#0e0f11;--surface:#181a20;--surface-2:#1c1e24;--line:rgba(255,255,255,0.09);
    --accent:#4ade9e;--accent2:#60efb8;--text:#f0f0f2;--muted:rgba(214,219,230,0.82);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{background:var(--bg);overflow-x:hidden;width:100%}
  body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:14px;display:flex;flex-direction:column;min-height:100vh;overflow-x:hidden;width:100%}
  nav{display:flex;align-items:center;justify-content:space-between;padding:0 2.5rem;height:56px;border-bottom:1px solid rgba(255,255,255,0.06);position:relative}
  main{flex:1;display:flex;flex-direction:column}
  .logo{font-size:20px;font-weight:700;color:#fff;text-decoration:none;display:flex;align-items:center;gap:8px}
  .logo img{border-radius:6px;display:block}
  .nav-right{display:flex;align-items:center;gap:8px}
  .dropdown{position:relative}
  .dd-btn{display:flex;align-items:center;gap:5px;background:var(--surface-2);border:1px solid var(--line);color:var(--text);font-family:inherit;font-size:11px;font-weight:700;letter-spacing:.03em;padding:6px 9px;border-radius:9px;cursor:pointer}
  .dd-btn:hover{border-color:rgba(255,255,255,0.2)}
  .dd-btn svg{width:11px;height:11px;color:var(--muted)}
  .dd-btn-icon{padding:8px;background:none;border:none}
  .dd-btn-icon svg{width:24px;height:24px;color:#f0f0f2}
  .dd-menu{display:none;position:absolute;top:calc(100% + 6px);right:0;min-width:170px;max-height:70vh;overflow-y:auto;background:#14161c;border:1px solid rgba(255,255,255,0.1);border-radius:12px;flex-direction:column;gap:0;padding:6px;z-index:100;box-shadow:0 12px 36px rgba(0,0,0,0.5)}
  .dd-menu.open{display:flex}
  .dd-link{font-size:13.5px;color:rgba(210,215,228,0.82);text-decoration:none;padding:10px 12px;border-radius:8px;white-space:nowrap;transition:all 0.15s}
  .dd-link:hover{color:#f0f0f2;background:rgba(255,255,255,0.05)}
  .dd-link.active{color:var(--accent);background:rgba(74,222,158,0.1)}
  .breadcrumb{max-width:680px;margin:0 auto;padding:14px 2rem 0;text-align:center}
  .breadcrumb a{font-size:12px;color:var(--muted);text-decoration:none}
  .breadcrumb a:hover{color:var(--accent)}
  @media(max-width:640px){nav{padding:0 1rem}.logo{font-size:18px}.breadcrumb{padding:12px 1rem 0}}
  .main{max-width:680px;margin:0 auto;width:100%;padding:2.5rem 2rem 3rem;overflow-x:hidden}
  h1{font-size:24px;font-weight:600;text-align:center;margin-bottom:8px;letter-spacing:-0.3px}
  .subtitle{font-size:13px;color:var(--muted);text-align:center;margin-bottom:28px}
  .field{margin-bottom:16px}
  .field label{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:6px}
  .field select,.field input{width:100%;background:var(--surface-2);border:1px solid var(--line);border-radius:10px;color:var(--text);font-family:inherit;font-size:15px;padding:10px 12px;height:46px}
  .result-box{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:20px;text-align:center;margin-top:8px}
  .result-value{font-size:28px;font-weight:700;color:var(--accent)}
  .result-label{font-size:12px;color:var(--muted);margin-top:4px}
  .lc-swap{display:flex;align-items:center;justify-content:center;width:34px;height:34px;margin:2px auto;border-radius:10px;background:var(--surface-2);border:1px solid var(--line);color:var(--muted);transition:border-color .15s,color .15s}
  .lc-swap:hover{border-color:var(--accent);color:var(--accent)}
  .lc-swap svg{width:16px;height:16px}
  .uc-row{display:flex;align-items:center;gap:10px}
  .uc-row .field{flex:1;display:flex;flex-direction:column;gap:8px;margin-bottom:0}
  .uc-row input,.uc-row select{height:46px;border-radius:10px;background:var(--surface-2);border:1px solid var(--line);color:var(--text);font-family:inherit;font-size:15px;padding:0 12px;width:100%}
  .uc-row input#uc-output{color:var(--accent);font-weight:700}
  .uc-swap{flex:none;width:38px;height:38px;margin-top:26px;border-radius:10px;background:var(--surface-2);border:1px solid var(--line);color:var(--text);cursor:pointer;display:flex;align-items:center;justify-content:center}
  .uc-swap:hover{border-color:var(--accent)}
  .uc-swap svg{width:17px;height:17px}
  @media(max-width:480px){.uc-row{flex-direction:column;align-items:stretch}.uc-swap{align-self:center;margin-top:0;transform:rotate(90deg)}}
  @supports (appearance: base-select) {
    .uc-row select{appearance:base-select;cursor:pointer;display:flex;align-items:center}
    .uc-row select::picker(select){appearance:base-select;border:1px solid rgba(255,255,255,0.09);border-radius:12px;background:#1c1e24;box-shadow:0 12px 36px rgba(0,0,0,0.5);padding:6px;margin-top:6px;position-try-fallbacks:none}
    .uc-row select::picker-icon{color:var(--muted)}
    .uc-row option{padding:9px 12px;border-radius:8px;color:var(--text);background:transparent}
    .uc-row option:hover,.uc-row option:focus,.uc-row option:focus-visible{background:rgba(74,222,158,0.12) !important;color:var(--text) !important}
    .uc-row option:checked{color:var(--accent)}
    .uc-row select::checkmark{display:none}
  }
  section.seo{max-width:680px;margin:40px auto 0;padding:0 2rem;color:var(--muted);font-size:13px;line-height:1.7}
  section.seo h2{font-size:18px;color:rgba(210,215,228,0.85);font-weight:600;margin-bottom:14px}
  section.seo h3{font-size:15px;color:rgba(210,215,228,0.82);font-weight:500;margin-bottom:5px}
  section.seo p{margin-bottom:14px}
  section.seo a{color:var(--accent);text-decoration:underline;text-decoration-color:rgba(74,222,158,0.4)}
  section.seo a:hover{text-decoration-color:var(--accent)}
  /* --- Образец новой вёрстки текста. Пока включён только на /ru/audio-to-midi (класс v2 ставит
     [slug].astro). Если понравится -- условие снимается и это становится общим правилом.
     Смысл правок: инструменту дать ширину, а тексту наоборот оставить узкую колонку, потому что
     строка длиннее ~75 символов читается заметно хуже. Сам текст был 13px приглушённо-серым --
     это и есть причина, по которой он "сливался". */
  section.seo.v2{font-size:15px;line-height:1.75;color:rgba(216,221,232,0.92)}
  section.seo.v2 h2{font-size:21px;color:var(--text);font-weight:650;letter-spacing:-.01em;margin:38px 0 15px}
  /* Короткая цветная черта под заголовком: глазу есть за что зацепиться при прокрутке, и разделы
     отличаются друг от друга не только словами. Цвет задаётся переменной ниже. */
  section.seo.v2 h2::after{content:"";display:block;width:44px;height:3px;border-radius:2px;margin-top:10px;background:var(--rule,var(--accent))}
  section.seo.v2 > h2:nth-of-type(1){--rule:#4ade9e;margin-top:0}
  section.seo.v2 > h2:nth-of-type(2){--rule:#e8b563}
  section.seo.v2 > h2:nth-of-type(3){--rule:#7fa8f0}
  section.seo.v2 > h2:nth-of-type(4){--rule:#f08a72}
  section.seo.v2 p{margin-bottom:15px}
  section.seo.v2 ul{margin:0 0 15px;padding-left:2px;list-style:none}
  section.seo.v2 li{position:relative;padding-left:20px;margin-bottom:9px}
  section.seo.v2 li::before{content:"";position:absolute;left:2px;top:9px;width:6px;height:6px;border-radius:50%;background:var(--accent);opacity:.75}
  section.seo.v2 li strong{color:var(--text);font-weight:600}
  /* Вопросы. Каждый отделён волосяной линией сверху и своей короткой чертой под текстом -- так
     двенадцать вопросов подряд перестают быть одной сплошной стеной. */
  section.seo.v2 > div{margin-bottom:0 !important;padding:18px 0;border-top:1px solid rgba(255,255,255,0.07)}
  section.seo.v2 > div:first-of-type{border-top:none}
  section.seo.v2 h3{font-size:16.5px;color:var(--text);font-weight:600;margin-bottom:0;line-height:1.4}
  section.seo.v2 h3::after{content:"";display:block;width:28px;height:2px;border-radius:2px;margin:8px 0 9px;background:var(--rule,var(--accent))}
  section.seo.v2 > div:nth-of-type(4n+1) h3{--rule:#4ade9e}
  section.seo.v2 > div:nth-of-type(4n+2) h3{--rule:#e8b563}
  section.seo.v2 > div:nth-of-type(4n+3) h3{--rule:#7fa8f0}
  section.seo.v2 > div:nth-of-type(4n+4) h3{--rule:#f08a72}
  section.seo.v2 > div p{margin-bottom:0}
  @media(max-width:640px){section.seo.v2{font-size:14.5px}section.seo.v2 h2{font-size:19px;margin-top:30px}}


  /* Плитки «Попробуйте ещё». Раскладка та же, что у карточек на страницах категорий, чтобы на
     сайте был один язык, а не два. Значок обозначает род действия -- резать, склеивать, слушать;
     см. src/lib/tool-icons.js, там же объяснено, почему не по значку на каждый инструмент.
     ВНИМАНИЕ: эти правила однажды были снесены заодно с отвергнутыми набросками оформления,
     и плитки уехали на боевой сайт без стилей -- гигантский значок вместо ряда плиток. Держать
     их отдельным блоком и проверять плитки глазами после любой уборки в этом файле. */
  section.seo.v2 ul.chips{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));
    gap:10px;list-style:none;margin:0 0 8px;padding:0;max-width:none;column-span:all}
  section.seo.v2 ul.chips li{margin:0;padding:0}
  section.seo.v2 ul.chips li::before{display:none}
  section.seo.v2 ul.chips a{display:flex;align-items:center;gap:10px;padding:13px 15px;
    background:var(--surface);border:1px solid var(--line);border-radius:13px;
    color:var(--text);font-size:14px;font-weight:600;text-decoration:none;
    transition:transform .12s,border-color .2s,background .2s}
  section.seo.v2 ul.chips a:hover{transform:translateY(-2px);border-color:var(--accent);
    background:rgba(74,222,158,0.06)}
  section.seo.v2 ul.chips svg{width:19px;height:19px;flex:none;color:var(--accent)}

  /* Д. Одна широкая колонка: текст идёт во всю ширину контейнера, подчёркнуты только
     заголовки разделов -- у вопросов ни полос, ни цвета. Кегль поднят до 16px и межстрочное
     Кегль такой же, как везде -- 15px: поднимать его на широкой строке я пробовал, но это
     удлиняет строку в знаках, а не укорачивает. */
  /* Ширину в 1000px задаёт [slug].astro и только медиастраницам. Здесь -- ширина по умолчанию:
     на странице калькулятора текст остаётся в колонке инструмента, иначе края разъезжаются. */
  section.seo.ve{max-width:680px}
  section.seo.ve h2{font-size:22px;color:#fff;font-weight:650;letter-spacing:-.015em;
    margin:46px 0 18px;padding-bottom:11px;border-bottom:2px solid var(--rule,rgba(74,222,158,0.5))}
  section.seo.ve > h2:nth-of-type(1){--rule:rgba(74,222,158,0.5);margin-top:8px}
  section.seo.ve > h2:nth-of-type(2){--rule:rgba(232,181,99,0.45)}
  section.seo.ve > h2:nth-of-type(3){--rule:rgba(127,168,240,0.45)}
  section.seo.ve > h2:nth-of-type(4){--rule:rgba(240,138,114,0.45)}
  section.seo.ve h2::after{display:none}
  section.seo.ve h3{font-size:16.5px;color:#fff;font-weight:600;margin-bottom:8px}
  section.seo.ve h3::after{display:none}
  section.seo.ve > div{padding:0 0 22px;border-top:none}
  section.seo.ve > p:first-of-type{font-size:16.5px;line-height:1.65;color:rgba(226,231,240,0.95);margin-bottom:8px}
  @media(max-width:640px){section.seo.ve h2{font-size:20px;margin-top:32px}}


  .all-tools{max-width:900px;margin:50px auto 0;padding:0 2rem}
  .all-tools-title{font-size:18px;font-weight:600;color:rgba(210,215,228,0.85);margin-bottom:18px;text-align:center}
  .all-tools-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
  .tool-card{display:flex;flex-direction:column;gap:5px;padding:16px 14px;background:var(--surface);border:1px solid var(--line);border-radius:13px;text-decoration:none;transition:transform .12s,border-color .2s,background .2s}
  .tool-card:hover{transform:translateY(-3px);border-color:var(--accent);background:rgba(74,222,158,0.05)}
  .tc-name{font-size:14px;font-weight:600;color:var(--text)}
  .tc-desc{font-size:11.5px;color:rgba(210,215,228,0.7);line-height:1.35}
  @media(max-width:760px){.all-tools-grid{grid-template-columns:repeat(2,1fr)}.all-tools{padding:0 1rem}}
  @media(max-width:640px){.main{padding:1.5rem 1rem 2rem}section.seo{padding:0 1rem}}
  footer{padding:1.25rem;text-align:center;font-size:12px;color:rgba(200,205,220,0.78);border-top:1px solid rgba(255,255,255,0.05);margin-top:auto}
  footer a{color:rgba(200,205,220,0.75);text-decoration:none;margin:0 8px}
</style>
</head>
<body>
<script is:inline>
  // Запоминает сбои в коде страницы, чтобы человек мог приложить их к письму, если сам захочет.
  // Никуда ничего не отправляется: это sessionStorage, он живёт до закрытия вкладки и виден
  // только этому браузеру. Молчаливую отправку на сервер здесь делать нельзя -- на каждой
  // странице обещано, что данные остаются у человека, и отладка не повод это нарушать.
  (() => {
    const KEY = 'opitro:errors';
    const push = (text) => {
      try {
        const list = JSON.parse(sessionStorage.getItem(KEY) || '[]');
        if (list.includes(text) || list.length >= 5) return;
        list.push(text);
        sessionStorage.setItem(KEY, JSON.stringify(list));
      } catch { /* приватный режим -- просто ничего не запоминаем */ }
    };
    addEventListener('error', (e) => {
      const where = e.filename ? ' (' + String(e.filename).split('/').pop() + ':' + e.lineno + ')' : '';
      push((e.message || 'error') + where);
    });
    addEventListener('unhandledrejection', (e) => {
      const r = e.reason;
      push('promise: ' + String(r && r.message ? r.message : r).slice(0, 200));
    });
  })();
</script>
<nav>
  <a class="logo" href={getRelativeLocaleUrl(locale, '')}>
    <img src="/favicon.svg" alt="" width="22" height="22">
    Opitro
  </a>
  <div class="nav-right">
    {translations.length > 1 && (
      <div class="dropdown" data-dropdown>
        <button class="dd-btn" aria-haspopup="listbox" aria-expanded="false">
          {locale.toUpperCase()}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="dd-menu" role="listbox">
          {translations.map((t) => (
            <a href={getRelativeLocaleUrl(t.locale, path)} class={`dd-link${t.locale === locale ? ' active' : ''}`}>{LOCALE_NAMES[t.locale] ?? t.locale}</a>
          ))}
        </div>
      </div>
    )}
    {navCategories.length > 0 && (
      <div class="dropdown" data-dropdown>
        <button class="dd-btn dd-btn-icon" aria-haspopup="listbox" aria-expanded="false" aria-label={translate(locale, 'categoriesAriaLabel')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="dd-menu" role="listbox">
          {navCategories.map((c) => (
            <a href={getRelativeLocaleUrl(locale, `tools/${c.data.catSlug}`)} class="dd-link">{c.data.name}</a>
          ))}
        </div>
      </div>
    )}
  </div>
</nav>
<main>
  {breadcrumb && (
    <div class="breadcrumb"><a href={breadcrumb.href}>← {breadcrumb.label}</a></div>
  )}
  <slot />
</main>
<footer>
  © 2026 Opitro
  <a href={getRelativeLocaleUrl(locale, 'contact')}>{translate(locale, 'contactFooterLink')}</a>
</footer>
<script>
  const dropdowns = document.querySelectorAll<HTMLElement>('[data-dropdown]');
  dropdowns.forEach((dd) => {
    const btn = dd.querySelector<HTMLButtonElement>('.dd-btn');
    const menu = dd.querySelector<HTMLElement>('.dd-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const willOpen = !menu.classList.contains('open');
      dropdowns.forEach((other) => {
        other.querySelector('.dd-menu')?.classList.remove('open');
        other.querySelector('.dd-btn')?.setAttribute('aria-expanded', 'false');
      });
      if (willOpen) {
        menu.classList.add('open');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
  document.addEventListener('click', (e) => {
    dropdowns.forEach((dd) => {
      if (!dd.contains(e.target as Node)) {
        dd.querySelector('.dd-menu')?.classList.remove('open');
        dd.querySelector('.dd-btn')?.setAttribute('aria-expanded', 'false');
      }
    });
  });
</script>
</body>
</html>
