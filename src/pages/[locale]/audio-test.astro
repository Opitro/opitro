---
// Scratch page to verify the ffmpeg.wasm engine actually works before wiring the real
// content-collection/routing for the audio-tools family. Delete once confirmed.
import Layout from '../../layouts/Layout.astro';
import AudioConverter from '../../components/AudioConverter.astro';

export function getStaticPaths() {
  const locales = ['en', 'ru', 'es', 'uk'];
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
---
<Layout
  locale={locale}
  title="Audio engine test"
  description="test"
  translations={[]}
>
  <div style="max-width:760px;margin:0 auto;padding:2rem;">
    <h1>Audio converter test</h1>
    <AudioConverter
      dropLabel="Upload an audio file"
      dropHint="MP3, WAV, M4A, OGG, FLAC — or drag it here (up to 500 MB)"
      formatLabel="Format"
      bitrateLabel="Bitrate"
      convertLabel="Convert"
      newFileLabel="Другой файл"
      preparingLabel="Preparing…"
      convertingLabel="Converting…"
      doneLabel="Done! File downloaded."
      loadingEncoderLabel="Loading encoder…"
    />
  </div>
</Layout>
