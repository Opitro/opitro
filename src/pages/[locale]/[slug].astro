      <CaseConverter locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'list-generator' && (
      <ListGenerator locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'remove-empty-lines' && (
