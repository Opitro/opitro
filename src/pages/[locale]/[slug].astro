      <ExifView locale={entry.data.locale} режим="чистить" />
    )}

    {kind === 'media' && entry.data.tool === 'color-scan' && (
      <ColorScan locale={entry.data.locale} />
    )}

    {kind === 'media' && entry.data.tool === 'mrz-scan' && (
      <MrzScan locale={entry.data.locale} />
    )}

    {kind === 'media' && entry.data.tool === 'image-to-text' && (
      <TextScan locale={entry.data.locale} />
    )}

    {kind === 'media' && entry.data.tool === 'pdf-to-text' && (
      <PdfText locale={entry.data.locale} />
    )}

    {kind === 'media' && entry.data.tool === 'document-scanner' && (
      <DocScan locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'favicon-generator' && (
      <FaviconGen locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'color-converter' && (
      <ColorConvert locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'color-palette' && (
      <PaletteGen locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'contrast-checker' && (
      <ContrastCheck locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'css-gradient' && (
      <GradientGen locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'box-shadow' && (
      <ShadowGen locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'border-radius' && (
      <RadiusGen locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'markdown-html' && (
      <MarkdownHtml locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'regex-tester' && (
      <RegexTester locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'uuid-generator' && (
      <UuidGen locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'unix-timestamp' && (
      <UnixTime locale={entry.data.locale} />
    )}
    {kind === 'media' && ['minify-html', 'minify-css', 'minify-js'].includes(entry.data.tool) && (
      <Minify locale={entry.data.locale} kind={entry.data.tool.replace('minify-', '')} />
    )}
    {kind === 'media' && entry.data.tool === 'htaccess-generator' && (
      <Htaccess locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'hash-generator' && (
      <HashGen locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'jwt-decoder' && (
      <JwtDecoder locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'url-parser' && (
      <UrlParser locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'html-entities' && (
      <HtmlEntities locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'number-base-converter' && (
      <NumberBase locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'code-diff' && (
      <CodeDiff locale={entry.data.locale} />
    )}

    {kind === 'media' && AUDIO_TOOLS[entry.data.tool]
      && !РАЗДЕЛЕНИЕ[entry.data.tool] && !EDITOR_TOOLS.includes(entry.data.tool) && (
      <AudioTool tool={entry.data.tool} locale={entry.data.locale} labels={audioLabels} />
    )}
  </div>

  <AdSlot />

  <section class="seo v2 ve">
    <Content />
    {convTable.length > 0 && (
      <>
        <h2>{convFormulaHeading}</h2>
        <p class="conv-formula">{convFormula}</p>
        <h2>{convTableHeading}</h2>
        <div class="conv-wrap">
          <table class="conv-table">
            <thead>
              {}
              <tr><th>{ep.fromUnit}</th><th>{ep.toUnit}</th></tr>
            </thead>
            <tbody>
              {}
              {convTable.map((r) => (
                <tr><td>{r.from}</td><td>{r.to}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
    {tiles.length > 0 && (
      <>
        <h2>{tryMoreLabel}</h2>
        <div class="рядом-сетка">
          {tiles.map((x) => <ToolCard данные={x.data} />)}
        </div>
      </>
    )}
    <h2>{faqLabel}</h2>
    {entry.data.faq.map((item) => (
      <div style="margin-bottom:18px">
        <h3>{item.question}</h3>
        <p set:html={answerHtml(item.answer)} />
      </div>
    ))}

  <a class="report-tile" href={`/${entry.data.locale}/contact?from=${entry.data.toolSlug}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4L3 21l1.1-3.3A8.4 8.4 0 1 1 21 11.5Z"/><path d="M12 8.2v4"/><path d="M12 15.6h.01"/>
    </svg>
    <span class="rt-text">{translate(entry.data.locale, 'contactToolLine')}</span>
    <b class="rt-link">{translate(entry.data.locale, 'contactToolLineLink')}</b>
  </a>
  </section>

  <AdSlot />

</Layout>

