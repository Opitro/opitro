      <BarcodeScan locale={entry.data.locale} />
    )}

    {kind === 'media' && entry.data.tool === 'datamatrix-scan' && (
      <CodeScan locale={entry.data.locale} вид="datamatrix" />
    )}
    {kind === 'media' && entry.data.tool === 'pdf417-scan' && (
