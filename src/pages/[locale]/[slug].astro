---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LinearConverter from '../../components/LinearConverter.astro';
import TemperatureConverter from '../../components/TemperatureConverter.astro';
import AudioTool from '../../components/AudioTool.astro';
import AudioToMidi from '../../components/AudioToMidi.astro';
import SpeechToText from '../../components/SpeechToText.astro';
import AudioEditor from '../../components/AudioEditor.astro';
// Три страницы разделения дорожек -- на своём компоненте со своими стилями: у них
// накапливается несколько результатов, каждый со своим воспроизведением и скачиванием, чего
// общий компонент не умеет. Правки в нём не касаются остальных инструментов.
import StemTool from '../../components/StemTool.astro';
// Тест клавиатуры -- своя страница: ни звука, ни файлов, чистый браузер, и с общим звуковым
// инструментом у неё нет ничего общего.
import KeyboardTest from '../../components/KeyboardTest.astro';
import RolloverTest from '../../components/RolloverTest.astro';
import ChatterTest from '../../components/ChatterTest.astro';
import TypingTest from '../../components/TypingTest.astro';
import MobileTypingTest from '../../components/MobileTypingTest.astro';
import TextCounter from '../../components/TextCounter.astro';
import ClickSpeed from '../../components/ClickSpeed.astro';
import PollingRate from '../../components/PollingRate.astro';
import RefreshRate from '../../components/RefreshRate.astro';
import PixelTest from '../../components/PixelTest.astro';
import StuckPixel from '../../components/StuckPixel.astro';
import BurnIn from '../../components/BurnIn.astro';
import ColorTest from '../../components/ColorTest.astro';
import HdrTest from '../../components/HdrTest.astro';
import ProjectorTest from '../../components/ProjectorTest.astro';
import SpeakerCleaner from '../../components/SpeakerCleaner.astro';
import SubwooferTest from '../../components/SubwooferTest.astro';
import ToneGenerator from '../../components/ToneGenerator.astro';
import HearingTest from '../../components/HearingTest.astro';
import AudioDelay from '../../components/AudioDelay.astro';
import Ultrasound from '../../components/Ultrasound.astro';
import MouseTest from '../../components/MouseTest.astro';
import TouchTest from '../../components/TouchTest.astro';
import MultiTouch from '../../components/MultiTouch.astro';
import StylusTest from '../../components/StylusTest.astro';
const РАЗДЕЛЕНИЕ = { 'split-vocal': 'split', 'vocal-remover': 'music', 'remove-music': 'voice' };

// Инструменты, уже переведённые на единый редактор. Пока один: расширяем по мере проверки,
// каждый следующий -- только после того, как предыдущий проверен живьём.
import { EDITOR_TOOLS } from '../../lib/audio-tools-config.js';
import AdSlot from '../../components/AdSlot.astro';
import { t as translate } from '../../lib/ui-strings.js';
import { iconFor } from '../../lib/tool-icons.js';

export async function getStaticPaths() {
  const locales = ['en', 'ru', 'es', 'uk'];
  const allTools = await getCollection('tools');
  const allMedia = await getCollection('mediaTools');
  return [
    ...allTools
      .filter((entry) => locales.includes(entry.data.locale))
      .map((entry) => ({
        params: { locale: entry.data.locale, slug: entry.data.toolSlug },
        props: { entry, kind: 'tool' },
      })),
    ...allMedia
      .filter((entry) => locales.includes(entry.data.locale))
      .map((entry) => ({
        params: { locale: entry.data.locale, slug: entry.data.toolSlug },
        props: { entry, kind: 'media' },
      })),
  ];
}

const { entry, kind } = Astro.props;
const { Content } = await render(entry);

const allCategories = await getCollection('categories');
const category = allCategories.find(
  (c) => c.data.catSlug === entry.data.category && c.data.locale === entry.data.locale
);
const breadcrumb = category
  ? { label: category.data.name, href: `/${entry.data.locale}/tools/${category.data.catSlug}` }
  : undefined;

const faqLabel = translate(entry.data.locale, 'faqLabel');
const relatedLabel = translate(entry.data.locale, 'relatedLabel');

// FAQ answers are plain strings in the frontmatter and were printed as text, so a markdown link
// written in one reached the reader verbatim: "сначала попробуйте [убрать вокал](/ru/vocal-remover)".
// 113 answers across 76 content files do this, on the live site right now. Escape first, then turn
// the link syntax into a real anchor -- the escaping is what makes set:html safe below.
const escapeHtml = (s) =>
  String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const answerHtml = (s) =>
  escapeHtml(s).replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, (_, label, href) => `<a href="${href}">${label}</a>`);
// Google gets the prose without the link syntax -- the markup would otherwise show up in the
// rich result as literal brackets.
const answerText = (s) => String(s).replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entry.data.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: answerText(item.answer) },
  })),
};

let translations = [];
let related = [];
let reverseTool;
let categoryLabel;
let audioLabels;

if (kind === 'tool') {
  const allTools = await getCollection('tools');
  translations = allTools
    .filter((t) => t.data.toolSlug === entry.data.toolSlug)
    .map((t) => ({ locale: t.data.locale, slug: t.data.toolSlug }));
  related = allTools.filter(
    (t) =>
      t.data.category === entry.data.category &&
      t.data.locale === entry.data.locale &&
      t.data.toolSlug !== entry.data.toolSlug
  );
  categoryLabel = translate(entry.data.locale, 'seeAllConvertersLink');
  // Pair slugs follow "{a}-to-{b}" -- derive the reverse pair's slug from the convention,
  // then confirm it actually exists before offering the swap link (so a pair without a
  // reverse page yet just doesn't show the button, instead of linking to a 404).
  const slugParts = entry.data.toolSlug.split('-to-');
  const reverseSlug = slugParts.length === 2 ? `${slugParts[1]}-to-${slugParts[0]}` : null;
  reverseTool = reverseSlug
    ? allTools.find((t) => t.data.toolSlug === reverseSlug && t.data.locale === entry.data.locale)
    : undefined;
} else {
  const allMedia = await getCollection('mediaTools');
  translations = allMedia
    .filter((t) => t.data.toolSlug === entry.data.toolSlug)
    .map((t) => ({ locale: t.data.locale, slug: t.data.toolSlug }));
  related = allMedia.filter(
    (t) =>
      t.data.category === entry.data.category &&
      t.data.locale === entry.data.locale &&
      t.data.toolSlug !== entry.data.toolSlug
  );
  const audioDict = translate(entry.data.locale, 'audio');
  audioLabels = audioDict;
}

const reverseAriaLabel = translate(entry.data.locale, 'swapDirectionAriaLabel');

// Таблица частых значений и формула для страниц калькуляторов.
//
// Тексты этих страниц были самыми короткими на сайте -- 359 знаков против 798 у медиастраниц,
// два абзаца, ни одного заголовка, ни одного списка. При этом запросы там самые конкурентные.
// Отдельный запрос вроде «сколько кг в 70 фунтах» отвечается не калькулятором, а строкой в
// таблице -- поэтому таблица и появляется.
//
// Числа берутся из тех же параметров, по которым считает сам калькулятор, поэтому они верны по
// построению и не расходятся с ним. Писать руками ничего не нужно, и это сразу 104 страницы.
const ep = entry.data.engineParams || {};
const convert = (x) => entry.data.engine === 'temperature-converter'
  ? x * (ep.scale ?? 1) + (ep.offset ?? 0)
  : x * (ep.factor ?? 1);
// Для температуры ряд другой: 1 или 2 градуса никто не переводит, а вот ноль, комнатная
// температура, температура тела и точка кипения -- это то, что действительно ищут.
const tableInputs = entry.data.engine === 'temperature-converter'
  ? [-40, -10, 0, 10, 20, 25, 30, 37, 100]
  : [1, 2, 5, 10, 20, 50, 100, 500, 1000];
// Столько знаков после запятой, чтобы маленькие значения не превращались в ноль, но и хвост из
// нулей не тянулся: 0.453592 нужен целиком, а 45.3592 уже избыточен.
const fmtNum = (n) => {
  const abs = Math.abs(n);
  const digits = abs >= 100 ? 1 : abs >= 10 ? 2 : abs >= 1 ? 3 : 6;
  // Разделитель дробной части -- точка, а не запятая, даже в русском и украинском. Решает не
  // грамматика, а сам калькулятор: он печатает «4.53592 кг» через точку, и таблица стоит прямо
  // под ним. Два разных вида чисел на одной странице читаются как небрежность. По той же причине
  // так написаны и все тексты сайта: 287 чисел через точку против 34 через запятую.
  // Тысячи разделяются узким пробелом -- «1 000» читается быстрее, чем «1000».
  const fixed = Number(n.toFixed(digits)).toString();
  const [int, frac] = fixed.split('.');
  const grouped = int.replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
  return frac ? grouped + '.' + frac : grouped;
};
const convTable = kind === 'tool' && (ep.factor || ep.scale)
  ? tableInputs.map((x) => ({ from: fmtNum(x), to: fmtNum(convert(x)) }))
  : [];
// Числа в формуле проходят через тот же fmtNum, что и таблица. Иначе на одной странице
// оказывались «0.453592» через точку в формуле и «0,453592» через запятую в таблице -- ровно та
// же несостыковка, что была с «0.4 MB» и «366 KB» в плеере.
// Считается только там, где есть что считать. Без этой проверки формула вычислялась и на
// медиастраницах, у которых параметров пересчёта нет вовсе, и сборка падала на toFixed от
// undefined -- раньше это молча давало строку «undefined» и потому не замечалось.
const convFormula = convTable.length === 0 ? '' : entry.data.engine === 'temperature-converter'
  ? `${ep.fromUnitShort} × ${fmtNum(ep.scale)} ${ep.offset >= 0 ? '+' : '−'} ${fmtNum(Math.abs(ep.offset))} = ${ep.toUnitShort}`
  : `1 ${ep.fromUnitShort} = ${fmtNum(ep.factor)} ${ep.toUnitShort}`;
const convTableHeading = translate(entry.data.locale, 'convTableHeading');
const convFormulaHeading = translate(entry.data.locale, 'convFormulaHeading');

// Плитки «Попробуйте ещё». Раньше внизу каждой страницы висели все 39 инструментов категории --
// стена, которую никто не читает. Шесть штук читаются, но их надо выбрать.
//
// Первыми идут инструменты, на которые ссылается сам текст этой страницы: эти связи расставлены
// осмысленно, когда писался текст, и лучше любого автоматического подбора. Остаток добирается
// соседями по категории. Так на странице всегда есть куда пойти дальше -- до этой правки 108
// страниц из 264 не вели вообще никуда.
const siblings = kind === 'tool' ? await getCollection('tools') : await getCollection('mediaTools');
const sameLocale = siblings.filter(
  (x) => x.data.locale === entry.data.locale && x.data.toolSlug !== entry.data.toolSlug
);
// Сначала связи из служебной части файла -- это бывшая строка «Рядом: …», перенесённая туда,
// когда выяснилось, что она дублирует плитки слово в слово. Потом ссылки из самого текста.
const mentioned = [
  ...(entry.data.related || []),
  ...[...(entry.body || '').matchAll(/\]\(\/[a-z]{2}\/([a-z0-9-]+)\)/g)].map((m) => m[1]),
];
const pick = [];
const add = (x) => { if (x && !pick.some((p) => p.data.toolSlug === x.data.toolSlug)) pick.push(x); };
for (const slug of mentioned) add(sameLocale.find((x) => x.data.toolSlug === slug));
for (const x of sameLocale.filter((x) => x.data.category === entry.data.category)) add(x);
const tiles = pick.slice(0, 6).map((x) => ({
  href: `/${x.data.locale}/${x.data.toolSlug}`,
  name: x.data.navName || x.data.h1,
  icon: iconFor(x.data.toolSlug, x.data.category),
}));
const tryMoreLabel = translate(entry.data.locale, 'tryMoreLabel');

// Утверждённая вёрстка текста (вариант Д). Ширину получают только медиастраницы: у калькулятора
// инструмент узкий, и растянутый под ним текст даёт перекос -- края блоков перестают совпадать.
// Типографику получают все: крупнее, светлее, с заголовками разделов.
const wideLayout = kind === 'media';
---

<Layout
  locale={entry.data.locale}
  title={entry.data.title}
  description={entry.data.description}
  translations={translations}
  path={entry.data.toolSlug}
  breadcrumb={breadcrumb}
  footerContact={false}
>
  <div class={`main${kind === 'media' ? ' main-media' : ''}${wideLayout ? ' main-wide' : ''}${['keyboard-test', 'key-rollover', 'key-chatter'].includes(entry.data.tool) ? ' main-board' : ''}`}>
    <h1>{entry.data.h1}</h1>
    {kind === 'tool' && entry.data.engine === 'linear-converter' && (
      <LinearConverter
        {...entry.data.engineParams}
        toolSlug={entry.data.toolSlug}
        copyLabel={translate(entry.data.locale, 'copyLabel')}
        copiedLabel={translate(entry.data.locale, 'copiedLabel')}
        exactLabel={translate(entry.data.locale, 'exactLabel')}
        reverseHref={reverseTool ? `/${entry.data.locale}/${reverseTool.data.toolSlug}` : undefined}
        reverseAriaLabel={reverseAriaLabel}
      />
    )}
    {kind === 'tool' && entry.data.engine === 'temperature-converter' && (
      <TemperatureConverter
        {...entry.data.engineParams}
        reverseHref={reverseTool ? `/${entry.data.locale}/${reverseTool.data.toolSlug}` : undefined}
        reverseAriaLabel={reverseAriaLabel}
      />
    )}
    {kind === 'tool' && (
      <a class="universal-link" href={`/${entry.data.locale}/tools/${entry.data.category}`}>{categoryLabel}</a>
    )}
    {/* Audio-to-MIDI has its own component: its output is notes rather than a buffer, so none of
        AudioTool's render/export machinery applies to it. Keyed on the tool name rather than on a
        flag in the config, because it has no AUDIO_TOOLS entry at all. */}
    {kind === 'media' && entry.data.tool === 'audio-to-midi' && (
      <AudioToMidi locale={entry.data.locale} labels={audioLabels} />
    )}
    {/* Two pages, one component: transcribing a recording you have, and speaking one now. Same
        model and same code -- but they are different jobs, searched for in different words, and
        each page is simpler without the other one's controls. */}
    {kind === 'media' && entry.data.tool === 'audio-to-text' && (
      <SpeechToText locale={entry.data.locale} labels={audioLabels} mode="file" />
    )}
    {kind === 'media' && entry.data.tool === 'speech-to-text' && (
      <SpeechToText locale={entry.data.locale} labels={audioLabels} mode="voice" />
    )}
    {/* Единый редактор. Пока стоит на одном инструменте, а не на всех семи: он новый, а
        остальные 33 живут на AudioTool и не должны пострадать, если здесь что-то не так.
        Список расширяется по мере проверки -- см. память project-audio-editor. */}
    {kind === 'media' && EDITOR_TOOLS.includes(entry.data.tool) && (
      <AudioEditor tool={entry.data.tool} locale={entry.data.locale} labels={audioLabels} />
    )}
    {kind === 'media' && РАЗДЕЛЕНИЕ[entry.data.tool] && (
      <StemTool locale={entry.data.locale} режим={РАЗДЕЛЕНИЕ[entry.data.tool]} />
    )}
    {kind === 'media' && entry.data.tool === 'keyboard-test' && (
      <KeyboardTest locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'key-rollover' && (
      <RolloverTest locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'key-chatter' && (
      <ChatterTest locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'typing-speed' && (
      <TypingTest locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'mobile-typing-test' && (
      <MobileTypingTest locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'character-counter' && (
      <TextCounter locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'click-speed' && (
      <ClickSpeed locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'polling-rate' && (
      <PollingRate locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'refresh-rate' && (
      <RefreshRate locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'dead-pixel-test' && (
      <PixelTest locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'stuck-pixel-fixer' && (
      <StuckPixel locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'screen-burn-in-test' && (
      <BurnIn locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'monitor-color-test' && (
      <ColorTest locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'hdr-test' && (
      <HdrTest locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'projector-test' && (
      <ProjectorTest locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'speaker-cleaner' && (
      <SpeakerCleaner locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'subwoofer-test' && (
      <SubwooferTest locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'tone-generator' && (
      <ToneGenerator locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'hearing-test' && (
      <HearingTest locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'audio-delay-test' && (
      <AudioDelay locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'ultrasound-generator' && (
      <Ultrasound locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'mouse-test' && (
      <MouseTest locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'touchscreen-test' && (
      <TouchTest locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'multi-touch-test' && (
      <MultiTouch locale={entry.data.locale} />
    )}
    {kind === 'media' && entry.data.tool === 'stylus-test' && (
      <StylusTest locale={entry.data.locale} />
    )}
    {kind === 'media' && !['audio-to-midi', 'audio-to-text', 'speech-to-text', 'keyboard-test', 'key-rollover', 'key-chatter', 'typing-speed', 'mobile-typing-test', 'character-counter', 'click-speed', 'polling-rate', 'refresh-rate', 'dead-pixel-test', 'stuck-pixel-fixer', 'screen-burn-in-test', 'monitor-color-test', 'hdr-test', 'projector-test', 'speaker-cleaner', 'subwoofer-test', 'tone-generator', 'hearing-test', 'audio-delay-test', 'ultrasound-generator', 'mouse-test', 'touchscreen-test', 'multi-touch-test', 'stylus-test'].includes(entry.data.tool)
      && !РАЗДЕЛЕНИЕ[entry.data.tool] && !EDITOR_TOOLS.includes(entry.data.tool) && (
      <AudioTool tool={entry.data.tool} locale={entry.data.locale} labels={audioLabels} />
    )}
  </div>


  <AdSlot />

  <section class="seo v2 ve">
    <Content />
    {convTable.length > 0 && (
      <>
        <h2>{convFormulaHeading}</h2>
        <p class="conv-formula">{convFormula}</p>
        <h2>{convTableHeading}</h2>
        <div class="conv-wrap">
          <table class="conv-table">
            <thead>
              {/* Только полное название. Пара «Дюйми, дюйм» читалась коряво: множественное число
                  рядом с единственным. Символ единицы и так стоит в формуле над таблицей. */}
              <tr><th>{ep.fromUnit}</th><th>{ep.toUnit}</th></tr>
            </thead>
            <tbody>
              {/* В ячейках только числа. Подставлять единицу к каждому значению нельзя: в
                  русском и украинском она требует падежа, и получалось «2 фунт», «5 фунт».
                  Единица живёт в шапке столбца -- так устроены обычные таблицы пересчёта, и
                  это разом снимает вопрос склонения во всех четырёх языках. */}
              {convTable.map((r) => (
                <tr><td>{r.from}</td><td>{r.to}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}
    {tiles.length > 0 && (
      <>
        <h2>{tryMoreLabel}</h2>
        <ul class="chips">
          {tiles.map((x) => (
            <li>
              <a href={x.href}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={x.icon} />
                <span>{x.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
    <h2>{faqLabel}</h2>
    {entry.data.faq.map((item) => (
      <div style="margin-bottom:18px">
        <h3>{item.question}</h3>
        <p set:html={answerHtml(item.answer)} />
      </div>
    ))}

    {/* Плитка стоит в конце текста, а не под инструментом: там она попадала в полосу, отведённую
        под рекламу, и читалась как объявление. Здесь она на своём месте по смыслу -- человек
        дочитал вопросы, ответа не нашёл, и следующий разумный шаг именно этот. */}
  <a class="report-tile" href={`/${entry.data.locale}/contact?from=${entry.data.toolSlug}`}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4L3 21l1.1-3.3A8.4 8.4 0 1 1 21 11.5Z"/><path d="M12 8.2v4"/><path d="M12 15.6h.01"/>
    </svg>
    <span class="rt-text">{translate(entry.data.locale, 'contactToolLine')}</span>
    <b class="rt-link">{translate(entry.data.locale, 'contactToolLineLink')}</b>
  </a>
  </section>

  <AdSlot />

  {/* Нижний блок со всеми инструментами категории на образце убран: он давал 39 карточек
     подряд -- стену, которую никто не читает. Перелинковка от этого не страдает: страница
     по-прежнему ведёт в свою категорию через хлебные крошки и в шесть смежных инструментов
     плитками, а полный перечень живёт на странице категории, как и положено. */}
  {false && related.length > 0 && (
    <section class="all-tools">
      <h2 class="all-tools-title">{relatedLabel}</h2>
      <div class="all-tools-grid">
        {related.map((r) => (
          <a class="tool-card" href={`/${r.data.locale}/${r.data.toolSlug}`}>
            <span class="tc-name">{r.data.h1}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />


<style>
  /* Плитка, а не строчка текста: строку под инструментом взгляд проскакивает, а это ровно то
     место, где человек стоит в момент поломки. Оформлена как остальные плитки на сайте, но
     приглушённее -- она должна быть заметна, а не спорить с самим инструментом. */
  .report-tile{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;
    width:fit-content;max-width:100%;margin:30px auto 0;padding:13px 20px;
    background:var(--surface);border:1px solid var(--line);border-radius:13px;
    color:var(--muted);font-size:13.5px;text-decoration:none;
    transition:transform .12s,border-color .2s,background .2s,color .2s}
  .report-tile:hover{transform:translateY(-2px);border-color:rgba(74,222,158,0.4);
    background:rgba(74,222,158,0.05);color:var(--text)}
  .report-tile svg{width:18px;height:18px;flex:none;color:var(--accent);opacity:.85}
  .report-tile .rt-link{color:var(--accent);font-weight:600;white-space:nowrap}
  @media(max-width:480px){.report-tile{font-size:13px;padding:12px 16px}}
  /* Таблица пересчёта. Цифры моноширинные и прижаты вправо -- так столбцы читаются как столбцы,
     а не как список слов. Обёртка с прокруткой нужна на телефоне: длинные числа вроде
     «1 000 000» иначе распирают страницу вбок. */
  .conv-formula{font-size:15px;color:var(--text);font-variant-numeric:tabular-nums;margin-bottom:6px}
  .conv-wrap{overflow-x:auto;margin-bottom:8px}
  .conv-table{width:100%;border-collapse:collapse;font-size:14px;font-variant-numeric:tabular-nums}
  .conv-table th{text-align:right;font-size:10px;letter-spacing:.08em;text-transform:uppercase;
    color:var(--muted);font-weight:600;padding:0 0 8px;border-bottom:1px solid var(--line)}
  .conv-table th:first-child{text-align:left}
  .conv-table td{padding:7px 0;border-bottom:1px solid rgba(255,255,255,0.05);color:var(--text);text-align:right}
  .conv-table td:first-child{text-align:left;color:var(--muted)}
  .conv-table tr:last-child td{border-bottom:none}
  .universal-link{display:flex;align-items:center;justify-content:center;gap:6px;width:fit-content;margin:18px auto 0;padding:10px 18px;border-radius:11px;background:rgba(74,222,158,0.1);border:1px solid rgba(74,222,158,0.3);color:var(--accent);font-size:13px;font-weight:600;text-decoration:none;transition:background .15s,border-color .15s}
  .universal-link:hover{background:rgba(74,222,158,0.18);border-color:rgba(74,222,158,0.5)}
  /* Audio tools need more room for the waveform + controls than the narrower calculator
     width -- matches LeebTTS's own 760px content width for the same kind of editor UI. */
  .main-media{max-width:760px}
  /* Схеме клавиатуры нужна своя ширина: она 1148 пикселей и в текстовую колонку не влезает.
     Растягивать её приёмом «выйти за колонку» нельзя -- страница обрезает всё, что вылезло
     за края (overflow-x: hidden у html и body), и левый край схемы становится недостижим.
     Поэтому колонку расширяем честно, а на узком экране схема листается вбок внутри себя. */
  /* Тремя классами. Двух не хватило: у соседнего `.main-media.main-wide` их столько же, а стоит
     оно НИЖЕ по файлу -- при равной вескости побеждает последнее, и колонка оставалась в 1000
     пикселей. Схема тогда листалась даже на большом экране. Поймано замером computed-стиля. */
  .main.main-media.main-board{max-width:1240px}
  .main-media ~ section.seo{max-width:760px}
  /* Образец: инструменту ширина, тексту наоборот узкая колонка. Правила стоят здесь, а не в
     Layout.astro, потому что там у них ровно та же вескость, что у .main-media выше, и спор
     решался порядком файлов -- то есть не в нашу пользу. */
  .main-media.main-wide{max-width:1000px;padding-bottom:1.5rem}
  .main-media.main-wide ~ section.seo.v2{max-width:720px;margin-top:24px}
  /* Вариант Г занимает всю ширину контейнера -- строку внутри него ограничивает уже сам текст
     (max-width в ch), а заголовки, полосы и плитки идут во всю ширину. Правило стоит здесь же,
     иначе спорит с предыдущей строкой при равной вескости и проигрывает по порядку. */
  /* width:100% обязателен: <main> -- колоночный флексбокс, а у элемента с margin:auto по бокам
     растяжение по поперечной оси отключается, и ширина сжимается по содержимому. Ровно та же
     ловушка описана в AdSlot.astro. Без него max-width:1000px не делал ничего. */
  .main-media.main-wide ~ section.seo.ve{max-width:1000px;width:100%}
  /* Зона загрузки идёт во всю ширину контейнера: суженная, она вылезала из общей вертикали --
     её края не совпадали с краями текста и полос под заголовками, и страница выглядела съехавшей.
     Ровные края важнее, чем то, что пустая рамка кажется великоватой. */
</style>
