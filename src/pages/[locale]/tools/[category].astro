      { code: 'mm', label: 'Миллиметры (мм)', factor: 0.001 },
      { code: 'cm', label: 'Сантиметры (см)', factor: 0.01 },
      { code: 'dm', label: 'Дециметры (дм)', factor: 0.1 },
      { code: 'm', label: 'Метры (м)', factor: 1 },
      { code: 'km', label: 'Километры (км)', factor: 1000 },
      { code: 'in', label: 'Дюймы', factor: 0.0254 },
      { code: 'ft', label: 'Футы', factor: 0.3048 },
      { code: 'yd', label: 'Ярды', factor: 0.9144 },
      { code: 'mi', label: 'Мили', factor: 1609.344 },
      { code: 'nmi', label: 'Морские мили', factor: 1852 },
      { code: 'step', label: 'Шаги', factor: 0.762 },
    ],
    en: [
      { code: 'mm', label: 'Millimeters (mm)', factor: 0.001 },
      { code: 'cm', label: 'Centimeters (cm)', factor: 0.01 },
      { code: 'dm', label: 'Decimeters (dm)', factor: 0.1 },
      { code: 'm', label: 'Meters (m)', factor: 1 },
      { code: 'km', label: 'Kilometers (km)', factor: 1000 },
      { code: 'in', label: 'Inches', factor: 0.0254 },
      { code: 'ft', label: 'Feet', factor: 0.3048 },
      { code: 'yd', label: 'Yards', factor: 0.9144 },
      { code: 'mi', label: 'Miles', factor: 1609.344 },
      { code: 'nmi', label: 'Nautical miles', factor: 1852 },
      { code: 'step', label: 'Steps', factor: 0.762 },
    ],
    es: [
      { code: 'mm', label: 'Milímetros (mm)', factor: 0.001 },
      { code: 'cm', label: 'Centímetros (cm)', factor: 0.01 },
      { code: 'dm', label: 'Decímetros (dm)', factor: 0.1 },
      { code: 'm', label: 'Metros (m)', factor: 1 },
      { code: 'km', label: 'Kilómetros (km)', factor: 1000 },
      { code: 'in', label: 'Pulgadas', factor: 0.0254 },
      { code: 'ft', label: 'Pies', factor: 0.3048 },
      { code: 'yd', label: 'Yardas', factor: 0.9144 },
      { code: 'mi', label: 'Millas', factor: 1609.344 },
      { code: 'nmi', label: 'Millas náuticas', factor: 1852 },
      { code: 'step', label: 'Pasos', factor: 0.762 },
    ],
    uk: [
      { code: 'mm', label: 'Міліметри (мм)', factor: 0.001 },
      { code: 'cm', label: 'Сантиметри (см)', factor: 0.01 },
      { code: 'dm', label: 'Дециметри (дм)', factor: 0.1 },
      { code: 'm', label: 'Метри (м)', factor: 1 },
      { code: 'km', label: 'Кілометри (км)', factor: 1000 },
      { code: 'in', label: 'Дюйми', factor: 0.0254 },
      { code: 'ft', label: 'Фути', factor: 0.3048 },
      { code: 'yd', label: 'Ярди', factor: 0.9144 },
      { code: 'mi', label: 'Милі', factor: 1609.344 },
      { code: 'nmi', label: 'Морські милі', factor: 1852 },
      { code: 'step', label: 'Кроки', factor: 0.762 },
    ],
  },
  weight: {
    ru: [
      { code: 'mg', label: 'Миллиграммы (мг)', factor: 0.000001 },
      { code: 'g', label: 'Граммы (г)', factor: 0.001 },
      { code: 'kg', label: 'Килограммы (кг)', factor: 1 },
      { code: 'tonne', label: 'Тонны (т)', factor: 1000 },
      { code: 'oz', label: 'Унции', factor: 0.028349523 },
      { code: 'lb', label: 'Фунты', factor: 0.453592 },
      { code: 'stone', label: 'Стоуны', factor: 6.350293 },
    ],
    en: [
      { code: 'mg', label: 'Milligrams (mg)', factor: 0.000001 },
      { code: 'g', label: 'Grams (g)', factor: 0.001 },
      { code: 'kg', label: 'Kilograms (kg)', factor: 1 },
      { code: 'tonne', label: 'Tonnes (t)', factor: 1000 },
      { code: 'oz', label: 'Ounces', factor: 0.028349523 },
      { code: 'lb', label: 'Pounds', factor: 0.453592 },
      { code: 'stone', label: 'Stone', factor: 6.350293 },
    ],
    es: [
      { code: 'mg', label: 'Miligramos (mg)', factor: 0.000001 },
      { code: 'g', label: 'Gramos (g)', factor: 0.001 },
      { code: 'kg', label: 'Kilogramos (kg)', factor: 1 },
      { code: 'tonne', label: 'Toneladas (t)', factor: 1000 },
      { code: 'oz', label: 'Onzas', factor: 0.028349523 },
      { code: 'lb', label: 'Libras', factor: 0.453592 },
      { code: 'stone', label: 'Stone', factor: 6.350293 },
    ],
    uk: [
      { code: 'mg', label: 'Міліграми (мг)', factor: 0.000001 },
      { code: 'g', label: 'Грами (г)', factor: 0.001 },
      { code: 'kg', label: 'Кілограми (кг)', factor: 1 },
      { code: 'tonne', label: 'Тонни (т)', factor: 1000 },
      { code: 'oz', label: 'Унції', factor: 0.028349523 },
      { code: 'lb', label: 'Фунти', factor: 0.453592 },
      { code: 'stone', label: 'Стоуни', factor: 6.350293 },
    ],
  },
  volume: {
    ru: [
      { code: 'ml', label: 'Миллилитры (мл)', factor: 0.001 },
      { code: 'l', label: 'Литры (л)', factor: 1 },
      { code: 'm3', label: 'Кубометры (м³)', factor: 1000 },
      { code: 'gal', label: 'Галлоны (США)', factor: 3.785411784 },
      { code: 'cup', label: 'Чашки', factor: 0.236588236 },
      { code: 'floz', label: 'Жидкие унции', factor: 0.0295735296 },
      { code: 'tbsp', label: 'Столовые ложки', factor: 0.0147867648 },
    ],
    en: [
      { code: 'ml', label: 'Milliliters (ml)', factor: 0.001 },
      { code: 'l', label: 'Liters (L)', factor: 1 },
      { code: 'm3', label: 'Cubic meters (m³)', factor: 1000 },
      { code: 'gal', label: 'Gallons (US)', factor: 3.785411784 },
      { code: 'cup', label: 'Cups', factor: 0.236588236 },
      { code: 'floz', label: 'Fluid ounces', factor: 0.0295735296 },
      { code: 'tbsp', label: 'Tablespoons', factor: 0.0147867648 },
    ],
    es: [
      { code: 'ml', label: 'Mililitros (ml)', factor: 0.001 },
      { code: 'l', label: 'Litros (L)', factor: 1 },
      { code: 'm3', label: 'Metros cúbicos (m³)', factor: 1000 },
      { code: 'gal', label: 'Galones (EE. UU.)', factor: 3.785411784 },
      { code: 'cup', label: 'Tazas', factor: 0.236588236 },
      { code: 'floz', label: 'Onzas líquidas', factor: 0.0295735296 },
      { code: 'tbsp', label: 'Cucharadas', factor: 0.0147867648 },
    ],
    uk: [
      { code: 'ml', label: 'Мілілітри (мл)', factor: 0.001 },
      { code: 'l', label: 'Літри (л)', factor: 1 },
      { code: 'm3', label: 'Кубометри (м³)', factor: 1000 },
      { code: 'gal', label: 'Галони (США)', factor: 3.785411784 },
      { code: 'cup', label: 'Склянки', factor: 0.236588236 },
      { code: 'floz', label: 'Рідкі унції', factor: 0.0295735296 },
      { code: 'tbsp', label: 'Столові ложки', factor: 0.0147867648 },
    ],
  },
};

const TEMPERATURE_UNITS = {
  ru: [
    { code: 'c', label: 'Цельсий (°C)', scale: 1, offset: 0 },
    { code: 'f', label: 'Фаренгейт (°F)', scale: 5 / 9, offset: -160 / 9 },
    { code: 'k', label: 'Кельвин (K)', scale: 1, offset: -273.15 },
  ],
  en: [
    { code: 'c', label: 'Celsius (°C)', scale: 1, offset: 0 },
    { code: 'f', label: 'Fahrenheit (°F)', scale: 5 / 9, offset: -160 / 9 },
    { code: 'k', label: 'Kelvin (K)', scale: 1, offset: -273.15 },
  ],
  es: [
    { code: 'c', label: 'Celsius (°C)', scale: 1, offset: 0 },
    { code: 'f', label: 'Fahrenheit (°F)', scale: 5 / 9, offset: -160 / 9 },
    { code: 'k', label: 'Kelvin (K)', scale: 1, offset: -273.15 },
  ],
  uk: [
    { code: 'c', label: 'Цельсій (°C)', scale: 1, offset: 0 },
    { code: 'f', label: 'Фаренгейт (°F)', scale: 5 / 9, offset: -160 / 9 },
    { code: 'k', label: 'Кельвін (K)', scale: 1, offset: -273.15 },
  ],
};

const DEFAULTS_BY_CATEGORY = {
  length: { from: 'm', to: 'cm' },
  volume: { from: 'l', to: 'ml' },
  weight: { from: 'kg', to: 'lb' },
  temperature: { from: 'c', to: 'f' },
};

const units = UNITS_BY_CATEGORY[entry.data.catSlug]?.[entry.data.locale];
const temperatureUnits = entry.data.catSlug === 'temperature' ? TEMPERATURE_UNITS[entry.data.locale] : undefined;
const defaults = DEFAULTS_BY_CATEGORY[entry.data.catSlug] ?? { from: units?.[0]?.code, to: units?.[1]?.code };
const swapLabel = translate(entry.data.locale, 'swapUnitsLabel');
const valueLabel = translate(entry.data.locale, 'valueLabel');
const resultLabel = translate(entry.data.locale, 'resultLabel');
const fromLabel = translate(entry.data.locale, 'fromLabel');
const toLabel = translate(entry.data.locale, 'toLabel');
const faqLabel = translate(entry.data.locale, 'faqLabel');

const парные = ['length', 'volume', 'weight', 'temperature'].includes(entry.data.catSlug);
const pairsLabel = translate(entry.data.locale, парные ? 'pairsLabel' : 'toolsInCategoryLabel');

const полки = поПолкам(entry.data.catSlug, tools, entry.data.locale);

---

<Layout
  locale={entry.data.locale}
  title={entry.data.title}
  description={entry.data.description}
  translations={translations}
  path={`tools/${entry.data.catSlug}`}
  crumbName={entry.data.name}
>
  <div class="main">
    <h1>{entry.data.h1}</h1>
    <p class="subtitle">{entry.data.description}</p>
    {units && (
      <UniversalConverter
        units={units}
        defaultFrom={defaults.from}
        defaultTo={defaults.to}
        swapLabel={swapLabel}
        valueLabel={valueLabel}
        resultLabel={resultLabel}
        fromLabel={fromLabel}
        toLabel={toLabel}
      />
    )}
    {temperatureUnits && (
      <TemperatureUniversalConverter
        units={temperatureUnits}
        defaultFrom={defaults.from}
        defaultTo={defaults.to}
        swapLabel={swapLabel}
        valueLabel={valueLabel}
        resultLabel={resultLabel}
        fromLabel={fromLabel}
        toLabel={toLabel}
      />
    )}
  </div>

  {(units || temperatureUnits) && <AdSlot />}

  <section class="all-tools">
    <h2 class="all-tools-title">{pairsLabel}</h2>
    {полки.length > 0 ? (
      <>
        <nav class="shelf-jump">
          {полки.map((п) => (
            <a href={`#p-${п.ключ}`} style={`--shelf: ${п.цвет}`}>{п.имя}</a>
          ))}
        </nav>
        {полки.map((п) => (
          <>
            <h3 class="shelf-name" id={`p-${п.ключ}`} style={`--shelf: ${п.цвет}`}>{п.имя}<b>{п.инструменты.length}</b></h3>
            <div class="all-tools-grid" style={`--shelf: ${п.цвет}`}>
              {п.инструменты.map((t) => (
                <ToolCard данные={t.data} />
              ))}
            </div>
          </>
        ))}
      </>
    ) : (
      <div class="all-tools-grid">
        {tools.map((t) => (
          <ToolCard данные={t.data} />
        ))}
      </div>
    )}
  </section>

  <section class="seo v2">
    {cards.length === 0 && <Content />}
    {cards.length > 0 && introHtml && <div class="info-intro" set:html={introHtml} />}
    {cards.length > 0 && (
      <div class="info-grid">
        {cards.map((card) => <div class="info-card" set:html={card} />)}
      </div>
    )}
    {cards.length === 0 && entry.data.faq && entry.data.faq.length > 0 && (
      <>
        <h2>{faqLabel}</h2>
        {entry.data.faq.map((item) => (
          <div class="seo-вопрос">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </div>
        ))}
      </>
    )}
    {cards.length > 0 && entry.data.faq && entry.data.faq.length > 0 && (
      <div class="info-faq">
        <h2>{faqLabel}</h2>
        {entry.data.faq.map((item) => (
          <div class="seo-вопрос">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>

<style>
  :global(html:root){--text:#f0f0f0;--muted:#b6b6b6}
  :global(body .all-tools-title){color:#bcbcbc}
  :global(body .dd-link){color:#b6b6b6}
  :global(body footer),:global(body footer a){color:#a4a4a4}
  .main{text-align:center}

  .main{padding-bottom:10px;max-width:1360px}

  .main h1{max-width:900px;margin-left:auto;margin-right:auto}
  .main .subtitle{max-width:66ch;margin:0 auto 22px;font-size:15px;line-height:1.6;
    color:var(--text)}

  .all-tools{margin-top:26px}

  section.seo{max-width:1360px;width:100%;padding:0 2rem;margin:44px auto 0;text-align:left}
  section.seo.v2{color:#d4d4d4}
  section.seo :global(p){font-size:14px;line-height:1.75;margin-bottom:16px}
  section.seo :global(table){display:block;max-width:100%;overflow-x:auto;border-collapse:collapse;margin:0 0 18px;font-size:14px;font-variant-numeric:tabular-nums}
  section.seo :global(th),section.seo :global(td){padding:8px 14px;border-bottom:1px solid var(--line);text-align:right;white-space:nowrap}
  section.seo :global(th:first-child),section.seo :global(td:first-child){padding-left:0;text-align:left}
  section.seo :global(th){font-weight:500;color:#a6a6a6}

  section.seo::before{content:"";display:block;height:1px;margin-bottom:30px;
    background:linear-gradient(90deg,transparent,rgba(255,255,255,.12),transparent)}
  .seo-вопрос{margin-bottom:18px}
  section.seo.v2 > .info-intro,section.seo.v2 > .info-grid,section.seo.v2 > .info-faq{padding:0;border-top:0}
  .info-intro{max-width:760px;margin:0 auto 22px}
  .info-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;max-width:1040px;margin:0 auto}
  .info-card{min-width:0;padding:22px 24px;background:transparent;border:1px solid var(--line);border-radius:14px}
  .info-card:nth-child(4n+1){--rule:#4ade9e}
  .info-card:nth-child(4n+2){--rule:#e8b563}
  .info-card:nth-child(4n+3){--rule:#7fa8f0}
  .info-card:nth-child(4n+4){--rule:#f08a72}
  section.seo.v2 .info-card :global(h2){margin-top:0;font-size:18px}
  .info-card :global(> :last-child){margin-bottom:0}
  .info-card :global(table){display:table;width:100%}
  .info-card :global(th),.info-card :global(td){padding:8px 0 8px 12px}
  .info-card :global(th:first-child),.info-card :global(td:first-child){padding-left:0;white-space:normal}
  .info-faq{max-width:760px;margin:38px auto 0}
  .info-faq h2{--rule:#f08a72;margin-top:0}
  .info-faq .seo-вопрос{margin:0;padding:18px 0;border-top:1px solid rgba(255,255,255,0.07)}
  @media(max-width:760px){
    .info-grid{grid-template-columns:minmax(0,1fr)}
    .info-card{padding:18px 16px}
  }
  @media(max-width:760px){
    section.seo{padding:0 1rem;margin-top:34px}
    .main .subtitle{font-size:14px;margin-bottom:24px}
  }

  .shelf-jump{display:flex;flex-wrap:wrap;gap:7px;justify-content:center;margin:0 0 22px}

  .shelf-jump a{font-size:12.5px;color:var(--text);text-decoration:none;background:var(--surface-2);
    border:1px solid var(--line);border-radius:999px;padding:6px 12px;
    display:inline-flex;align-items:center;gap:7px;transition:border-color .15s,color .15s}
  .shelf-jump a::before{content:"";width:7px;height:7px;border-radius:50%;
    background:var(--shelf,var(--accent));flex:none}
  .shelf-jump a:hover{border-color:var(--shelf,var(--accent));color:var(--shelf,var(--accent))}
  .shelf-name{display:flex;align-items:center;gap:10px;font-size:11.5px;letter-spacing:.14em;
    text-transform:uppercase;font-weight:700;color:var(--shelf,var(--muted));margin:26px 0 10px;
    text-align:left;scroll-margin-top:20px}

  .shelf-name::after{content:"";flex:1;height:1px;
    background:linear-gradient(90deg,color-mix(in srgb,var(--shelf,var(--accent)) 38%,transparent),rgba(255,255,255,.06))}
  .shelf-name b{color:#767676;font-weight:400;letter-spacing:0;text-transform:none;font-size:12px}

  .all-tools-grid .tool-card{padding:12px 13px;gap:10px}
</style>
