---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const locales = ['ru', 'en'];
  const allCategories = await getCollection('categories');
  return allCategories
    .filter((entry) => locales.includes(entry.data.locale))
    .map((entry) => ({
      params: { locale: entry.data.locale, category: entry.data.catSlug },
      props: { entry },
    }));
}

const { entry } = Astro.props;

const allCategories = await getCollection('categories');
const translations = allCategories
  .filter((c) => c.data.catSlug === entry.data.catSlug)
  .map((c) => ({ locale: c.data.locale, slug: `tools/${c.data.catSlug}` }));

const allTools = await getCollection('tools');
const tools = allTools.filter(
  (t) => t.data.category === entry.data.catSlug && t.data.locale === entry.data.locale
);

// Categories with many units get one flexible any-to-any converter alongside the
// dedicated pair pages -- add more entries here as other categories get one too.
const UNIVERSAL_CONVERTERS = { length: 'length-converter' };
const universalSlug = UNIVERSAL_CONVERTERS[entry.data.catSlug];
const universalLabel =
  entry.data.locale === 'ru' ? 'Универсальный конвертер — любые единицы' : 'Universal converter — any unit';
---

<Layout
  locale={entry.data.locale}
  title={entry.data.title}
  description={entry.data.description}
  translations={translations}
  path={`tools/${entry.data.catSlug}`}
>
  <div class="main">
    <h1>{entry.data.title}</h1>
    <p class="subtitle">{entry.data.description}</p>
    {universalSlug && (
      <a class="universal-cta" href={`/${entry.data.locale}/${universalSlug}`}>{universalLabel} →</a>
    )}
  </div>
  <section class="all-tools">
    <div class="all-tools-grid">
      {tools.map((t) => (
        <a class="tool-card" href={`/${t.data.locale}/${t.data.toolSlug}`}>
          <span class="tc-name">{t.data.h1}</span>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  .main{text-align:center}
  .universal-cta{display:inline-flex;padding:10px 18px;border-radius:11px;background:rgba(74,222,158,0.1);border:1px solid rgba(74,222,158,0.3);color:var(--accent);font-size:13.5px;font-weight:600;text-decoration:none}
  .universal-cta:hover{background:rgba(74,222,158,0.16)}
</style>
