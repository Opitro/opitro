---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import UniversalConverter from '../../../components/UniversalConverter.astro';
import TemperatureUniversalConverter from '../../../components/TemperatureUniversalConverter.astro';
import AdSlot from '../../../components/AdSlot.astro';
import ToolCard from '../../../components/ToolCard.astro';
import { t as translate } from '../../../lib/ui-strings.js';
import { поПолкам } from '../../../lib/tool-groups.js';
import { iconFor, colorFor } from '../../../lib/tool-icons.js';

export async function getStaticPaths() {
  const locales = ['en', 'ru', 'es', 'uk'];
  const allCategories = await getCollection('categories');
  return allCategories
    .filter((entry) => locales.includes(entry.data.locale))
    .map((entry) => ({
      params: { locale: entry.data.locale, category: entry.data.catSlug },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const bodyParts = (entry.rendered?.html ?? '').split(/(?=<h2)/);
const introHtml = bodyParts[0].startsWith('<h2') ? '' : bodyParts[0].trim();
const cards = bodyParts.filter((part) => part.startsWith('<h2'));

const allCategories = await getCollection('categories');
const translations = allCategories
  .filter((c) => c.data.catSlug === entry.data.catSlug)
  .map((c) => ({ locale: c.data.locale, slug: `tools/${c.data.catSlug}` }));

const allTools = await getCollection('tools');
const allMedia = await getCollection('mediaTools');

const вРубрике = (t) => t.data.locale === entry.data.locale
  && (t.data.category === entry.data.catSlug
    || (t.data.alsoIn || []).includes(entry.data.catSlug));
const tools = [...allTools.filter(вРубрике), ...allMedia.filter(вРубрике)];

const UNITS_BY_CATEGORY = {
  length: {
