---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { t as translate } from '../../lib/ui-strings.js';
import { видРубрики } from '../../lib/category-look.js';

export function getStaticPaths() {
  const locales = ['en', 'ru', 'es', 'uk'];
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const allCategories = await getCollection('categories');
const categories = allCategories.filter((c) => c.data.locale === locale);

const allTools = await getCollection('tools');
const allMedia = await getCollection('mediaTools');
const toolsByCategory = Object.fromEntries(
  categories.map((c) => [
    c.data.catSlug,
    [
      ...allTools.filter((t) => t.data.category === c.data.catSlug && t.data.locale === locale),
      ...allMedia.filter((t) => t.data.category === c.data.catSlug && t.data.locale === locale),
    ],
  ])
);

// Скрытые ключи для поиска: название в меню, заголовок страницы, её title -- и английский
// адрес. В списке это не показывается, только участвует в поиске.
//
// ТОЛЬКО СВОЙ ЯЗЫК. Класть сюда ещё и переводы заманчиво, но список лежит внутри главной,
// и его вес умножается на число языков: при 500 страницах и 50 языках это 2,8 МБ на главной
// (измерено), а «только свой» -- 118 КБ независимо от числа переводов. Испанец качает
// испанские названия и не платит за русские. Ищущих чужой язык это не обделяет: английский
// адрес страницы один на все языки, поэтому «fade», «trim», «bpm» находятся откуда угодно.
function ключиДля(t) {
  return [t.data.navName, t.data.h1, t.data.title, t.data.toolSlug.replace(/-/g, ' ')]
    .filter(Boolean).join(' ').toLowerCase();
}

const searchIndex = categories.flatMap((c) => {
  const items = toolsByCategory[c.data.catSlug].map((t) => ({
    title: t.data.navName || t.data.h1,
    category: c.data.name,
    ключи: ключиДля(t),
    href: `/${locale}/${t.data.toolSlug}`,
  }));
  // The category page itself may double as a working calculator (see tools/[category].astro) --
  // index it too so searching e.g. "length" surfaces the calculator, not just its pairs.
  items.push({ title: c.data.h1, category: c.data.title, href: `/${locale}/tools/${c.data.catSlug}` });
  return items;
});

const totalTools = searchIndex.length;

const translations = ['en', 'ru', 'es', 'uk'].map((l) => ({ locale: l, slug: '' }));

const title = translate(locale, 'homeTitle');
const description = translate(locale, 'homeDescription');

const t = {
  tagline: translate(locale, 'tagline')(totalTools),
  searchPlaceholder: translate(locale, 'searchPlaceholder'),
  noResults: translate(locale, 'noResults'),
};
---

<Layout locale={locale} title={title} description={description} translations={translations} path="">
  <div class="main">
    <div class="hero">
      <img class="hero-icon" src="/favicon.svg" alt="" width="48" height="48">
      <h1>{title}</h1>
      <p class="subtitle">{description}</p>
      <p class="tagline">{t.tagline}</p>
      <div class="search-wrap">
        <svg class="search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="search" id="tool-search" placeholder={t.searchPlaceholder} autocomplete="off">
      </div>
      <div class="search-results" id="search-results" hidden></div>
    </div>

    {/* Рубрики -- строками со значком и цветной кромкой, в два столбца на большом экране.
        Раньше это были шесть одинаковых плашек с одним словом: «Аудио» с сорока двумя
        инструментами выглядела ровно как «Тесты» с четырьмя. */}
    {/* Рубрика -- ССЫЛКА на свою страницу, а не раскрывающийся список. Раньше нажатие
        раскрывало перечень прямо здесь и отодвигало всё вниз: в два столбца это ещё и дёргало
        соседнюю рубрику. Внутри рубрики список теперь разложен по полкам -- показывать его
        дважды незачем. */}
    <div class="accordion" id="accordion">
      {categories.map((c) => (
        <a class="acc-item" href={`/${locale}/tools/${c.data.catSlug}`} style={`--cat: ${видРубрики(c.data.catSlug).цвет}`}>
          {/* Размер задан АТРИБУТАМИ прямо в значке. Стиль `.acc-ico svg` сюда не достаёт:
              разметка вставлена через set:html, метки области видимости на ней нет, и правило
              не срабатывает -- значок раскрывался на всю плашку и лез в глаза. */}
          <span class="acc-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={видРубрики(c.data.catSlug).путь} /></span>
          <span class="acc-tx">
            <span class="acc-name">{c.data.name}</span>
            {c.data.blurb && <span class="acc-blurb">{c.data.blurb}</span>}
          </span>
          <span class="acc-count">{toolsByCategory[c.data.catSlug].length}</span>
        </a>
      ))}
    </div>
  </div>
</Layout>

<script type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />
<script define:vars={{ noResultsText: t.noResults }}>
  const index = JSON.parse(document.getElementById('search-index').textContent);
  const input = document.getElementById('tool-search');
  const results = document.getElementById('search-results');
  const accordion = document.getElementById('accordion');

  function render(query) {
    const q = query.trim().toLowerCase();
    if (!q) {
      results.hidden = true;
      accordion.hidden = false;
      return;
    }
    accordion.hidden = true;
    results.hidden = false;
    // Ищем и по названию, и по разделу: человек пишет «видео» и ждёт увидеть всё звуковое
    // из видео, а не только то, где это слово стоит в заголовке.
    const попал = (item) =>
      item.title.toLowerCase().includes(q) || (item.category || '').toLowerCase().includes(q)
      || (item.ключи || '').includes(q);
    // Сначала те, у кого совпадение в НАЧАЛЕ названия: «моно» должно давать «Моно в стерео»
    // первым, а не где-то в середине списка.
    const matches = index
      .filter(попал)
      .sort((a, b) => {
        // Совпало в видимом названии -- выше того, что нашлось только по скрытым ключам:
        // иначе на «звук» первым лезет страница, где это слово спрятано в описании.
        const va = a.title.toLowerCase().includes(q) ? 0 : 1;
        const vb = b.title.toLowerCase().includes(q) ? 0 : 1;
        if (va !== vb) return va - vb;
        const ai = a.title.toLowerCase().indexOf(q), bi = b.title.toLowerCase().indexOf(q);
        return (ai < 0 ? 99 : ai) - (bi < 0 ? 99 : bi) || a.title.localeCompare(b.title);
      })
      .slice(0, 12);
    // Подсвечиваем совпавшую часть -- глаз сразу видит, ПОЧЕМУ строка здесь.
    const экран = (t) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const подсветить = (t) => {
      const i = t.toLowerCase().indexOf(q);
      if (i < 0) return экран(t);
      return экран(t.slice(0, i)) + '<mark>' + экран(t.slice(i, i + q.length)) + '</mark>' + экран(t.slice(i + q.length));
    };
    results.innerHTML = matches.length
      ? matches
          .map(
            (item, n) =>
              `<a class="sr-link${n === 0 ? ' is-cur' : ''}" href="${item.href}"><span class="sr-title">${подсветить(item.title)}</span><span class="sr-cat">${экран(item.category)}</span></a>`
          )
          .join('')
      : `<div class="sr-empty">${noResultsText}</div>`;
  }

  input.addEventListener('input', () => render(input.value));

  // Стрелки и Enter: искать и уходить на страницу, не снимая рук с клавиатуры. Первая строка
  // отмечена сразу, поэтому Enter без стрелок открывает самое подходящее.
  input.addEventListener('keydown', (e) => {
    const строки = [...results.querySelectorAll('.sr-link')];
    if (!строки.length) return;
    const тек = строки.findIndex((a) => a.classList.contains('is-cur'));
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      const шаг = e.key === 'ArrowDown' ? 1 : -1;
      const след = (tек => (tек + шаг + строки.length) % строки.length)(тек < 0 ? 0 : тек);
      строки.forEach((a, i) => a.classList.toggle('is-cur', i === след));
      строки[след].scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'Enter') {
      const цель = строки[тек < 0 ? 0 : тек];
      if (цель) { e.preventDefault(); window.location.href = цель.getAttribute('href'); }
    }
  });
</script>

<style>
  .hero{text-align:center;margin-bottom:32px}
  .hero-icon{border-radius:11px;margin-bottom:14px;box-shadow:0 8px 24px -8px rgba(0,0,0,.5)}
  .tagline{font-size:12px;color:var(--muted);margin-top:-14px;margin-bottom:22px;opacity:.75}
  .search-wrap{position:relative;max-width:420px;margin:0 auto}
  .search-ico{position:absolute;left:14px;top:50%;transform:translateY(-50%);width:17px;height:17px;color:var(--muted);pointer-events:none}
  #tool-search{width:100%;height:48px;background:var(--surface-2);border:1px solid var(--line);border-radius:12px;color:var(--text);font-family:inherit;font-size:15px;padding:0 14px 0 42px}
  #tool-search:focus{outline:none;border-color:rgba(74,222,158,.5)}
  #tool-search::-webkit-search-cancel-button{filter:invert(.6)}
  .search-results{display:flex;flex-direction:column;gap:6px;margin-top:10px;text-align:left}
  /* ВАЖНО: :global. Astro привязывает стили к элементам ШАБЛОНА, помечая их особым признаком.
     Строки результатов создаёт код -- признака у них нет, и обычное правило до них не доходит:
     ссылки оставались синими по умолчанию браузера. Замер показал color: rgb(0,0,238).
     Цвет ссылке задан ЯВНО. Без него браузер подставляет свой -- тёмно-синий для непосещённых
     и лиловый для посещённых, -- и список выглядел чужеродным. Подсветку касания тоже гасим:
     на телефоне она давала синюю вспышку на всю строку. */
  .search-results{max-height:min(60vh,420px);overflow-y:auto;padding-right:2px}
  :global(.sr-link){display:flex;align-items:center;justify-content:space-between;gap:12px;
    background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:11px 14px;
    text-decoration:none;color:var(--text);-webkit-tap-highlight-color:transparent;
    transition:border-color .15s,background .15s}
  :global(.sr-link:hover),:global(.sr-link.is-cur){border-color:rgba(74,222,158,.55);background:rgba(74,222,158,.06)}
  :global(.sr-link:active){background:rgba(74,222,158,.12)}
  :global(.sr-title){font-size:13.5px;color:var(--text);font-weight:600;min-width:0}
  /* Совпавшая часть -- зелёным по прозрачному, без жёлтой заливки браузера. */
  :global(.sr-title mark){background:transparent;color:var(--accent);font-weight:700}
  /* Раздел -- тихой плашкой справа: он подсказывает, но не спорит с названием. */
  :global(.sr-cat){font-size:11px;color:var(--muted);background:var(--surface-2);border-radius:20px;
    padding:3px 9px;white-space:nowrap;flex:0 0 auto}
  :global(.sr-empty){color:var(--muted);font-size:13px;text-align:center;padding:14px 0}
  /* Два столбца на компьютере: шесть рубрик видны одним взглядом, без прокрутки. Ширина строки
     ограничена -- растянутая на весь экран строка с коротким словом слева и числом справа
     выглядит пустой, и глаз проходит по ней впустую. */
  /* Колонка главной шире общей: две колонки рубрик в 680 пикселей не помещаются. Заголовок и
     поиск при этом остаются узкими -- длинная строка поиска читается хуже. */
  .main{max-width:1000px}
  .hero,.search-wrap{max-width:680px;margin-left:auto;margin-right:auto}
  .accordion{display:grid;grid-template-columns:repeat(2,minmax(0,460px));justify-content:center;
    align-items:start;gap:12px;margin-top:8px}
  @media(max-width:900px){.accordion{grid-template-columns:minmax(0,460px)}}
  .acc-item{display:flex;align-items:center;gap:12px;padding:13px 15px;text-decoration:none;
    background:var(--surface);border:1px solid var(--line);border-left:3px solid var(--cat,var(--accent));
    border-radius:14px;transition:transform .14s,border-color .18s}
  .acc-item:hover{transform:translateY(-2px);border-color:var(--cat,var(--accent))}
  @media(prefers-reduced-motion:reduce){.acc-item:hover{transform:none}}
  /* Значок в приглушённой плашке своего цвета -- цвет ищется глазом раньше слова. */
  .acc-ico{flex:none;width:34px;height:34px;border-radius:10px;display:flex;align-items:center;
    justify-content:center;color:var(--cat,var(--accent));
    background:color-mix(in srgb,var(--cat,var(--accent)) 12%,transparent)}
  .acc-ico svg{display:block}
  .acc-tx{flex:1;min-width:0}
  .acc-name{display:block;color:var(--text);font-size:15.5px;font-weight:700;line-height:1.25}
  .acc-blurb{display:block;font-size:12.5px;font-weight:400;color:var(--muted);margin-top:2px;
    line-height:1.35}
  .acc-count{flex:none;font-size:12px;color:var(--muted);font-weight:400;background:var(--surface-2);padding:2px 9px;border-radius:20px}
</style>
