---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import UniversalConverter from '../../components/UniversalConverter.astro';
import AdSlot from '../../components/AdSlot.astro';

export function getStaticPaths() {
  const locales = ['ru', 'en'];
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;

const UNITS = {
  ru: [
    { code: 'mm', label: 'Миллиметры (мм)', factor: 0.001 },
    { code: 'cm', label: 'Сантиметры (см)', factor: 0.01 },
    { code: 'm', label: 'Метры (м)', factor: 1 },
    { code: 'km', label: 'Километры (км)', factor: 1000 },
    { code: 'in', label: 'Дюймы', factor: 0.0254 },
    { code: 'ft', label: 'Футы', factor: 0.3048 },
    { code: 'yd', label: 'Ярды', factor: 0.9144 },
    { code: 'mi', label: 'Мили', factor: 1609.344 },
    { code: 'nmi', label: 'Морские мили', factor: 1852 },
  ],
  en: [
    { code: 'mm', label: 'Millimeters (mm)', factor: 0.001 },
    { code: 'cm', label: 'Centimeters (cm)', factor: 0.01 },
    { code: 'm', label: 'Meters (m)', factor: 1 },
    { code: 'km', label: 'Kilometers (km)', factor: 1000 },
    { code: 'in', label: 'Inches', factor: 0.0254 },
    { code: 'ft', label: 'Feet', factor: 0.3048 },
    { code: 'yd', label: 'Yards', factor: 0.9144 },
    { code: 'mi', label: 'Miles', factor: 1609.344 },
    { code: 'nmi', label: 'Nautical miles', factor: 1852 },
  ],
};

const allCategories = await getCollection('categories');
const category = allCategories.find((c) => c.data.catSlug === 'length' && c.data.locale === locale);
const breadcrumb = category ? { label: category.data.title, href: `/${locale}/tools/length` } : undefined;

const translations = [
  { locale: 'ru', slug: 'length-converter' },
  { locale: 'en', slug: 'length-converter' },
];

const t =
  locale === 'ru'
    ? {
        title: 'Конвертер длины — любые единицы онлайн бесплатно, без регистрации',
        h1: 'Универсальный конвертер длины',
        subtitle: 'Мм, см, м, км, дюймы, футы, ярды, мили, морские мили — любая пара сразу',
        description:
          'Переведите между любыми единицами длины онлайн бесплатно: миллиметры, сантиметры, метры, километры, дюймы, футы, ярды, мили, морские мили. Выберите единицы и получите результат мгновенно.',
        swap: 'Поменять местами',
        faqTitle: 'Частые вопросы',
        faq: [
          {
            q: 'Чем этот конвертер отличается от отдельных калькуляторов км↔мили, м↔футы и см↔дюймы?',
            a: 'Те калькуляторы оптимизированы под самые частые запросы и дают более подробный разбор именно своей пары. Этот — для всех остальных сочетаний: ярды, морские мили, миллиметры и любые их комбинации в одном месте.',
          },
          {
            q: 'Насколько точны расчёты?',
            a: 'Используются точные международные коэффициенты (например, 1 дюйм = 2.54 см, 1 миля = 1609.344 м) — без бытовых округлений.',
          },
        ],
        introP1:
          'Если нужной пары единиц нет среди отдельных калькуляторов — например, ярды в морские мили или миллиметры в футы — этот конвертер считает между любыми двумя единицами длины сразу, без промежуточных пересчётов.',
        introP2: 'Введите число, выберите единицы слева и справа (или нажмите кнопку со стрелками, чтобы поменять их местами) — результат обновится мгновенно.',
      }
    : {
        title: 'Length Converter — Any Unit, Free and No Sign-Up',
        h1: 'Universal Length Converter',
        subtitle: 'mm, cm, m, km, inches, feet, yards, miles, nautical miles — any pair at once',
        description:
          'Convert between any length units online for free: millimeters, centimeters, meters, kilometers, inches, feet, yards, miles, nautical miles. Pick your units and get the result instantly.',
        swap: 'Swap units',
        faqTitle: 'FAQ',
        faq: [
          {
            q: 'How is this different from the dedicated km-to-miles, m-to-feet, and cm-to-inches calculators?',
            a: "Those are tuned for the most common searches and give a deeper breakdown for that specific pair. This one covers everything else — yards, nautical miles, millimeters, and any combination of them in one place.",
          },
          {
            q: 'How accurate are the results?',
            a: 'It uses exact international conversion factors (e.g. 1 inch = 2.54 cm, 1 mile = 1609.344 m) — no everyday rounding.',
          },
        ],
        introP1:
          "If the unit pair you need isn't covered by one of the dedicated calculators — say, yards to nautical miles, or millimeters to feet — this converter handles any two length units directly, no manual intermediate steps.",
        introP2: 'Enter a number, pick a unit on each side (or hit the swap button to flip them), and the result updates instantly.',
      };
---

<Layout
  locale={locale}
  title={t.title}
  description={t.description}
  translations={translations}
  path="length-converter"
  breadcrumb={breadcrumb}
>
  <div class="main">
    <h1>{t.h1}</h1>
    <p class="subtitle">{t.subtitle}</p>
    <UniversalConverter units={UNITS[locale]} defaultFrom="m" defaultTo="cm" swapLabel={t.swap} />
  </div>

  <AdSlot />

  <section class="seo">
    <p>{t.introP1}</p>
    <p>{t.introP2}</p>
    <h2>{t.faqTitle}</h2>
    {t.faq.map((item) => (
      <div style="margin-bottom:18px">
        <h3>{item.q}</h3>
        <p>{item.a}</p>
      </div>
    ))}
  </section>
</Layout>
