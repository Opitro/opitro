---
// ДЕКОДЕР JWT.
//
// Считает jwt.js, проверенный отдельно против OPENSSL: триста токенов, подписанных чужой
// программой на трёх длинах HMAC, -- верный ключ сошёлся у всех, изменённый не сошёлся ни у
// одного. Плюс известный токен с jwt.io собран openssl знак в знак.
//
// ГЛАВНОЕ, ЧТО ЭТА СТРАНИЦА ОБЯЗАНА СКАЗАТЬ: токен НЕ зашифрован. Заголовок и нагрузка лежат
// в нём открыто и читаются кем угодно без ключа -- в этом и смысл первого окна. Подпись
// защищает от подмены, но не от чтения.
//
// ЧЕГО В ЗАДАНИИ НЕ БЫЛО И ПОЧЕМУ ЭТО ЗДЕСЬ:
//   1. Отдельный ответ на alg: none. Это не «подпись неверна», а «подписи нет вовсе» --
//      разница между сломанным замком и его отсутствием.
//   2. Отдельный ответ на RS256/ES256. Их проверяют ОТКРЫТЫМ КЛЮЧОМ, и написать «подпись
//      неверна» человеку, который ввёл пароль, значит соврать.
//   3. Сроки разобраны в понятные даты. exp и nbf -- в секундах, и сравнение с Date.now()
//      в миллисекундах даёт разницу в тысячу раз.
//
// ОТСТУПЛЕНИЯ ПО ВИДУ: фон страницы не задаю, приглушённо-серых надписей нет; корзина стоит
// в полосе под полем, а не поверх текста.
import css from '../styles/jwt-decoder.css?inline';

const { locale = 'ru' } = Astro.props;

const СЛОВА = {
  ru: {
    place: 'Вставьте токен вида xxxxx.yyyyy.zzzzz…', label: 'JWT токен',
    clear: 'Очистить', copy: 'Копировать', copied: 'Скопировано',
    header: 'Заголовок', payload: 'Нагрузка', verify: 'Проверка подписи',
    secret: 'Секретный ключ (HMAC)', secretPlace: 'Ключ, которым подписан токен…',
    alg: 'Алгоритм', decoded: 'Расшифровано',
    ok: 'Подпись сошлась', bad: 'Подпись не сошлась',
    noSig: 'Подписи нет вовсе — alg: none', needPub: 'Нужен открытый ключ, а не пароль',
    noKey: 'Введите ключ, чтобы проверить', unknownAlg: 'Алгоритм неизвестен',
    noCrypto: 'Проверка подписи требует защищённого соединения (https).',
    active: 'Действует', expired: 'Срок истёк', notYet: 'Ещё не действует', noExp: 'Срока нет',
    issued: 'Выдан', expires: 'Истекает', notBefore: 'Действует с', left: 'осталось',
    e_empty: 'Вставьте токен — он разберётся сам',
    e_parts: 'В токене должно быть три части, разделённые точками',
    e_b64: 'Части токена записаны не по правилам base64url',
    e_header: 'Заголовок токена — не JSON',
    e_payload: 'Нагрузка токена — не JSON',
    n1: '<b>Токен не зашифрован — он всего лишь закодирован.</b> Заголовок и нагрузку читает кто угодно без всякого ключа: именно это и делает окно выше. Подпись защищает от <b>подмены</b>, а не от <b>чтения</b>. Класть в токен пароли, номера карт и прочее тайное нельзя — это самое частое заблуждение о JWT.',
    n2: '<b>alg: none — это не «подпись неверна», а «подписи нет».</b> Стандарт такое допускает, и когда-то целые библиотеки принимали такие токены как подлинные: достаточно было переписать нагрузку и стереть подпись. Мы показываем это отдельной строкой, а не наравне с прочими ответами.',
    n3: '<b>RS256 и ES256 паролем не проверяются.</b> У них подпись проверяется открытым ключом, а не общим секретом. Написать «подпись неверна» человеку, который ввёл пароль к такому токену, значит соврать: она не неверна — её просто нечем проверить здесь.',
    n4: '<b>exp и nbf — в секундах, а не в миллисекундах.</b> Ходовая ошибка: сравнить exp с <code>Date.now()</code> напрямую. Разница в тысячу раз, и живой токен то «истёк в 1970-м», то действует до пятьдесят восьмого тысячелетия. Мы переводим сроки в даты и говорим, сколько осталось.',
    n5: '<b>Про ключ — честно.</b> Эта страница не делает ни одного сетевого запроса, и это можно проверить самому: откройте в браузере вкладку «Сеть» и наберите ключ — запросов не появится. Но привычка вставлять рабочие ключи в веб-страницы опасна сама по себе, потому что большинство таких страниц устроены иначе. Для проверки чужого инструмента берите отдельный, тестовый ключ.',
    n6: 'Ничего никуда не отправляется. Токен и ключ остаются в памяти вкладки и исчезают вместе с ней.',
  },
  uk: {
    place: 'Вставте токен вигляду xxxxx.yyyyy.zzzzz…', label: 'JWT токен',
    clear: 'Очистити', copy: 'Копіювати', copied: 'Скопійовано',
    header: 'Заголовок', payload: 'Навантаження', verify: 'Перевірка підпису',
