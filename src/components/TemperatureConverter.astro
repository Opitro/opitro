---
interface Props {
  scale: number;
  offset: number;
  fromUnit: string;
  toUnit: string;
  fromUnitShort: string;
  toUnitShort: string;
  defaultValue?: number;
  reverseHref?: string;
  reverseAriaLabel?: string;
}

const {
  scale,
  offset,
  fromUnit,
  toUnit,
  fromUnitShort,
  toUnitShort,
  defaultValue = 20,
  reverseHref,
  reverseAriaLabel,
} = Astro.props;
---

<div class="lc-widget" data-scale={scale} data-offset={offset}>
  <div class="lc-pane lc-from">
    <label class="lc-cap" for="tc-input">{fromUnit}</label>
    <div class="lc-line">
      <input type="number" id="tc-input" value={defaultValue} step="any" inputmode="decimal">
      <span class="lc-unit">{fromUnitShort}</span>
    </div>
  </div>
  {reverseHref && (
    <a class="lc-swap" href={reverseHref} aria-label={reverseAriaLabel}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h15M18 8l-4-4M18 8l-4 4M21 16H6M6 16l4-4M6 16l4 4"/></svg>
    </a>
  )}
  <div class="lc-pane lc-to">
    <div class="lc-cap">{toUnit}</div>
    <div class="lc-line">
      <span class="lc-num" id="tc-result" aria-live="polite"></span>
      <span class="lc-unit">{toUnitShort}</span>
    </div>
  </div>
</div>

<script>
  import { convertAffine, formatNumber } from '../lib/affine-converter.js';

  const widget = document.querySelector('.lc-widget');
  const scale = parseFloat(widget.dataset.scale);
  const offset = parseFloat(widget.dataset.offset);
  const input = document.getElementById('tc-input');
  const result = document.getElementById('tc-result');

  function update() {
    const value = parseFloat(input.value) || 0;
    result.textContent = formatNumber(convertAffine(value, scale, offset));
  }

  input.addEventListener('input', () => {
    update();
    window.dispatchEvent(new Event('opitro:tool-interaction'));
  });
  input.addEventListener('focus', () => input.select());
  update();
</script>
