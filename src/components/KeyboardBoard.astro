---
// СХЕМА КЛАВИАТУРЫ -- общая разметка для клавиатурных страниц.
//
// Вынесена отдельно, чтобы «тест клавиатуры» и «сколько клавиш разом» рисовали ОДНУ И ТУ ЖЕ
// клавиатуру. Две копии одной схемы разъехались бы при первой же правке -- это уже было со
// стилями плеера, который жил в трёх экземплярах и отличался во всех трёх.
//
// Клавиша подписана дважды -- латиницей и кириллицей, как на настоящих клавишах. Вторую
// подпись показываем только там, где она есть у людей перед глазами.
import { БЛОКИ } from '../lib/keyboard-layout.js';

const { locale = 'ru' } = Astro.props;
const сКириллицей = locale === 'ru' || locale === 'uk';
---

{/* Схема шире экрана на телефоне -- её листают вбок: ряды обязаны сходиться край в край,
    поэтому ужимать их по ширине экрана нельзя. */}
<div class="kb-scroll">
  <div class="kb-board">
    {БЛОКИ.map((блок) => (
      <div class="kb-block">
        {блок.map((ряд) => (
          <div class="kb-row">
            {ряд.map((кл) => (
              кл.пусто
                ? <div class="kb-key gap" style={`--w:${кл.ш}`}></div>
                : (
                  <div class={`kb-key${(кл.лат || '').length > 3 ? ' small' : ''}`}
                       data-code={кл.код} style={`--w:${кл.ш}`}>
                    <span>{кл.лат}</span>
                    {сКириллицей && кл.кир && <span class="ru">{кл.кир}</span>}
                  </div>
                )
            ))}
          </div>
        ))}
      </div>
    ))}
  </div>
</div>
