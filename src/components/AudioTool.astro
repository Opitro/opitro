    if (config.controls === 'recorder') {
      panel.classList.add('on');
      const recBtn = root.querySelector('#rec-btn');
      const recPauseBtn = root.querySelector('#rec-pause');
      const recPauseIco = root.querySelector('#rec-pause-ico');
      const recPlayBtn = root.querySelector('#rec-play');
      const recPlayIco = root.querySelector('#rec-play-ico');
      const recTimeEl = root.querySelector('#rec-time');
      const recStateEl = root.querySelector('#rec-state');
      const meterEl = root.querySelector('#rec-meter');
      const meterFill = root.querySelector('#rec-meter-fill');
      let mediaStream = null;
      let recorder = null;
      let chunks = [];
      let tick = 0;

      let recordedMs = 0;
      let segmentStart = 0;
      let meterCtx = null;
      let meterRaf = 0;

      function stopTimer() { if (tick) { clearInterval(tick); tick = 0; } }
      function elapsedMs() {
        return recordedMs + (segmentStart ? Date.now() - segmentStart : 0);
      }
      function showTime() {
        const secs = Math.floor(elapsedMs() / 1000);
        recTimeEl.textContent = `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`;
      }
      function setRecording(on, paused) {

        const сцена = root.querySelector('.rec-stage');
        if (сцена) {
          сцена.classList.toggle('is-rec', !!on);
          if (on) сцена.classList.remove('is-done');
        }
        recBtn.classList.toggle('recording', on);
        recStateEl.textContent = on
          ? (paused ? labels.recPausedLabel : labels.recRecordingLabel)
          : labels.recIdleLabel;
        recBtn.setAttribute('aria-label', on ? labels.recStopLabel : labels.recStartLabel);
        recPauseBtn.disabled = !on;
        recPauseIco.innerHTML = paused ? ICO_PLAY : ICO_PAUSE_SOLID;
        recPauseBtn.setAttribute('aria-label', paused ? labels.recResumeLabel : labels.recPauseLabel);
        if (meterEl) meterEl.classList.toggle('on', on && !paused);

        panel.classList.toggle('is-recording', on);
      }

      const liveWave = waveCanvas ? createLiveWaveform(waveCanvas, { mode: 'wave' }) : null;
      function startLiveWave() {
        if (!liveWave) return;

        if (waveShell) { waveShell.style.display = ''; waveShell.classList.remove('is-empty'); }
        liveWave.start();
      }
      function stopLiveWave() { if (liveWave) liveWave.stop(); }

      function startMeter(stream) {
        stopMeter();
        try {
          meterCtx = new (window.AudioContext || window.webkitAudioContext)();

          const разбудить = () => {
            if (!meterCtx || meterCtx.state === 'running' || meterCtx.state === 'closed') return;
            try { const r = meterCtx.resume(); if (r && r.catch) r.catch(() => {}); } catch (e) {}
          };
          разбудить();
          setTimeout(разбудить, 300);
          setTimeout(разбудить, 1200);
          const src = meterCtx.createMediaStreamSource(stream);
          const an = meterCtx.createAnalyser();
          an.fftSize = 1024;
          src.connect(an);
          const buf = new Float32Array(an.fftSize);
          let shown = 0;
          const draw = () => {
            an.getFloatTimeDomainData(buf);

            if (liveWave && liveWave.feed) liveWave.feed(buf);
            let peak = 0;
            for (const v of buf) { const a = Math.abs(v); if (a > peak) peak = a; }

            shown = Math.max(peak, shown * 0.88);
            meterFill.style.width = Math.min(100, shown * 140) + '%';
            meterFill.classList.toggle('hot', shown > 0.92);

            if (liveWave) liveWave.push(Math.min(1, peak * 1.4));
            meterRaf = requestAnimationFrame(draw);
          };
          draw();
        } catch (e) {  }
      }
      function stopMeter() {
        cancelAnimationFrame(meterRaf);
        meterRaf = 0;
        if (meterFill) { meterFill.style.width = '0%'; meterFill.classList.remove('hot'); }
        if (meterCtx) { try { meterCtx.close(); } catch (e) {} meterCtx = null; }
      }

      recBtn.addEventListener('click', async () => {
        if (recorder && recorder.state !== 'inactive') { recorder.stop(); return; }
        clearError();

        openRecordSession();
        try {
          mediaStream = await navigator.mediaDevices.getUserMedia({

            audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: true },
          });
        } catch (e) {
          showError(labels.micDeniedLabel);
          return;
        }
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        chunks = [];
        recordedMs = 0;
        recorder = new MediaRecorder(mediaStream);
        recorder.ondataavailable = (e) => { if (e.data && e.data.size) chunks.push(e.data); };
        recorder.onstop = async () => {

          openAudioSession();
          stopTimer();
          stopMeter();
          stopLiveWave();
          segmentStart = 0;
          setRecording(false, false);
          mediaStream.getTracks().forEach((t) => t.stop());
          const blob = new Blob(chunks, { type: recorder.mimeType || 'audio/webm' });
          const ext = (recorder.mimeType || '').includes('ogg') ? 'ogg' : 'webm';

          await pickFile(new File([blob], `recording.${ext}`, { type: blob.type }));

          waveShell?.classList.remove('is-empty');

          if (waveShell) {
            waveShell.classList.remove('is-appearing');
            void waveShell.offsetWidth;
            waveShell.classList.add('is-appearing');
            setTimeout(() => waveShell.classList.remove('is-appearing'), 1000);
          }
          root.querySelector('#audio-panel')?.classList.remove('rec-empty');
          const сцена2 = root.querySelector('.rec-stage');
          if (сцена2) { сцена2.classList.remove('is-idle', 'is-rec'); сцена2.classList.add('is-done'); }

          if (sourceBuffer) {
            const gain = normalizeGain(peakOf(sourceBuffer));
            if (gain > 1.01) {
              sourceBuffer = scaleVolume(sourceBuffer, gain);
              scheduleWaveformDraw(sourceBuffer);
            }

            try {
              window.__opitroДатьЗапись && window.__opitroДатьЗапись(
                new Blob([encodeWAV(sourceBuffer)], { type: 'audio/wav' }));
            } catch (e) {}
          }
          if (recPlayBtn) recPlayBtn.disabled = !sourceBuffer;
        };
        recorder.start();
        segmentStart = Date.now();
        setRecording(true, false);
        startLiveWave();
        if (recPlayBtn) recPlayBtn.disabled = true;
        recTimeEl.textContent = '0:00';
        startMeter(mediaStream);
        tick = setInterval(showTime, 250);
      });

      recPauseBtn.addEventListener('click', () => {
        if (!recorder || recorder.state === 'inactive') return;
        if (recorder.state === 'recording') {
          recorder.pause();
          recordedMs += Date.now() - segmentStart;
          segmentStart = 0;
          stopMeter();

          stopLiveWave();
          setRecording(true, true);
        } else {
          recorder.resume();
          segmentStart = Date.now();
          startMeter(mediaStream);

          startLiveWave();
          setRecording(true, false);
        }
        showTime();
      });

      let элемент = null, ссылкаНаЗапись = null;
      function проигрыватель() {
        if (!элемент) {
          элемент = new Audio();
          элемент.preload = 'auto';

          let кадрЗ = 0;
          const вестиЗ = () => {
            if (!элемент || элемент.paused || !sourceBuffer) { кадрЗ = 0; return; }

            if (элемент.__до && элемент.currentTime >= элемент.__до) {
              элемент.pause();
              recPlayIco.innerHTML = ICO_PLAY;
              if (playhead) playhead.style.display = 'none';
              кадрЗ = 0;
              return;
            }
            setPlayheadTime(элемент.currentTime);
            кадрЗ = requestAnimationFrame(вестиЗ);
          };
          элемент.addEventListener('play', () => { cancelAnimationFrame(кадрЗ); кадрЗ = requestAnimationFrame(вестиЗ); });
          элемент.addEventListener('pause', () => { cancelAnimationFrame(кадрЗ); кадрЗ = 0; });
          элемент.addEventListener('ended', () => {
            recPlayIco.innerHTML = ICO_PLAY;
            if (playhead) playhead.style.display = 'none';
          });
        }
        return элемент;
      }

      function датьЗапись(blob) {
        if (ссылкаНаЗапись) { try { URL.revokeObjectURL(ссылкаНаЗапись); } catch (e) {} }
        ссылкаНаЗапись = URL.createObjectURL(blob);
        проигрыватель().src = ссылкаНаЗапись;
        window.__opitroЗаписьВПроигрывателе = true;
      }
      window.__opitroДатьЗапись = датьЗапись;

      recPlayBtn.addEventListener('click', () => {
        if (!sourceBuffer) return;

        if (элемент && элемент.src) {
          if (!элемент.paused) { элемент.pause(); recPlayIco.innerHTML = ICO_PLAY; return; }
          recPlayIco.innerHTML = ICO_PAUSE_SOLID;

          const от = Math.max(0, selStart);
          const до = selEnd > от + 0.05 ? selEnd : (элемент.duration || 0);
          if (Math.abs(элемент.currentTime - от) > 0.2 || элемент.currentTime >= до) элемент.currentTime = от;
          элемент.__до = до;
          const обещание = элемент.play();
          if (обещание && обещание.catch) обещание.catch(() => { recPlayIco.innerHTML = ICO_PLAY; });
          return;
        }
        player.unlock();
        if (player.isPlaying()) {
          player.pause();
          recPlayIco.innerHTML = ICO_PLAY;
          return;
        }
        recPlayIco.innerHTML = ICO_PAUSE_SOLID;
        const from = Math.max(0, selStart);
        const to = selEnd > from + 0.05 ? selEnd : sourceBuffer.duration;
        player.play(
          sliceBuffer(sourceBuffer, from, to),
          (frac) => setPlayheadTime(from + (to - from) * frac),
          () => { recPlayIco.innerHTML = ICO_PLAY; if (playhead) playhead.style.display = 'none'; player.reset(); }
        );
      });

    }

    if (drop) {
      drop.addEventListener('click', () => fileInput.click());
      drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
      drop.addEventListener('dragleave', () => drop.classList.remove('over'));
      drop.addEventListener('drop', (e) => {
