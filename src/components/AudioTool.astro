      if (vizPreviewBtn) vizPreviewBtn.addEventListener('click', renderVizPreview);
      const vizSizeEl = root.querySelector('#viz-size');
      // Re-preview on size change only if something has already been rendered -- otherwise
      // changing the dropdown before ever picking a style would kick off a render unasked.
      if (vizSizeEl) vizSizeEl.addEventListener('change', () => { if (file && vizVideoEl.src) renderVizPreview(); });
    }

    if (config.controls === 'rate1') {
      const rateSel = root.querySelector('#ctrl-select');
      const rateNote = root.querySelector('#rate-note');
      const fmtSelect = root.querySelector('#tool-format');
      function syncRateState() {
        const rate = Number(rateSel.value);
        // MP3 can't represent every rate. Rather than let someone export a file that is quietly
        // wrong, the option is disabled and the reason is stated.
        const mp3Ok = (config.mp3Rates || []).includes(rate);
        if (fmtSelect) {
          const mp3Opt = fmtSelect.querySelector('option[value="mp3"]');
          if (mp3Opt) {
            mp3Opt.disabled = !mp3Ok;
            if (!mp3Ok && fmtSelect.value === 'mp3') fmtSelect.value = 'wav';
          }
        }
        if (rateNote) {
          const same = sourceBuffer && rate === sourceBuffer.sampleRate;
          rateNote.textContent = !mp3Ok
            ? labels.rateNoMp3Label
            : same ? labels.rateSameLabel : '';
          rateNote.style.display = rateNote.textContent ? 'block' : 'none';
        }
        renderedBuffer = null;
        exportedClean = false;
        eqSyncState();
      }
      if (rateSel) {
        rateSel.addEventListener('change', () => {
          stopAB();
          syncRateState();
        });
      }
      // Re-run once a file is decoded, so the "same as the original" note and the disabled
      // download reflect the actual file rather than a guess.
      rateStateSync = syncRateState;
    }

    if (config.controls === 'volume1') {
      const volumeValEl = root.querySelector('#volume-val');
      function onVolumeInput() {
        const pct = volumeValue();
        const gain = pct / 100;
        // Percent alone doesn't tell you much about headroom; dB is the unit that does, and
        // showing both costs nothing and adds no extra control.
        const db = gain > 0 ? (20 * Math.log10(gain)) : -Infinity;
        if (volumeValEl) {
          volumeValEl.textContent = pct === 100
            ? '100% (0 dB)'
            : `${pct}% (${db > 0 ? '+' : ''}${db.toFixed(1)} dB)`;
        }
        // Live: write straight into the playing gain node, no re-render.
        if (volumeLiveGain) volumeLiveGain.gain.value = gain;
        exportedClean = false;
        eqSyncState();
        invalidateRender();
        if (abSelected !== 'result' && !abResultBtn?.disabled) selectAbSide('result');
      }
      if (volumeSliderEl) volumeSliderEl.addEventListener('input', onVolumeInput);
    }

    if (config.controls === 'speed1') {
      const speedSlider = root.querySelector('#ctrl-slider');
      const speedValEl = root.querySelector('#speed-val');
      const keepPitchEl = root.querySelector('#ctrl-keeppitch');
      const speedPresetsEl = root.querySelector('#speed-presets');
      let speedTimer = 0;
      function speedLabelText(pct) {
        const x = pct / 100;
        return `${x.toFixed(2).replace(/\.?0+$/, '')}x`;
      }
      async function applySpeed(immediate) {
        // Position is a FRACTION of the track: at a new speed the same musical moment sits at
        // a different number of seconds, so carrying raw seconds over would jump.
        const oldBuf = abPlayingBuffer;
        const posFrac = oldBuf && oldBuf.duration > 0
          ? Math.min(1, resumePosition() / oldBuf.duration) : 0;
        stopAB();
        renderedBuffer = null;
        exportedClean = false;
        eqSyncState();
        if (!sourceBuffer || !toolIsDirty()) return;
        if (abSelected !== 'result') { selectAbSide('result'); return; }
        if (!(await ensureAbResult())) return;
        const buf = currentAbBuffer();
        if (buf) playAB('result', buf, posFrac * buf.duration);
      }
      function onSpeedInput() {
        const pct = Number(speedSlider.value);
        if (speedValEl) speedValEl.textContent = speedLabelText(pct);
        if (speedPresetsEl) {
          speedPresetsEl.querySelectorAll('.preset-card').forEach((c) => {
            c.classList.toggle('active', Number(c.dataset.speed) === pct);
          });
        }
        clearTimeout(speedTimer);
        speedTimer = window.setTimeout(applySpeed, 500);
      }
      speedSlider.addEventListener('input', onSpeedInput);
      if (keepPitchEl) keepPitchEl.addEventListener('change', () => { clearTimeout(speedTimer); applySpeed(); });
      const speedResetBtn = root.querySelector('#speed-reset-btn');
      if (speedResetBtn) {
        speedResetBtn.addEventListener('click', () => {
          speedSlider.value = '100';
          if (keepPitchEl) keepPitchEl.checked = true;
          stopAB();
          renderedBuffer = null;
          onSpeedInput();
          clearTimeout(speedTimer);
          eqSyncState();
        });
      }
      if (speedPresetsEl) {
        speedPresetsEl.querySelectorAll('.preset-card').forEach((card) => {
          card.addEventListener('click', () => {
            speedSlider.value = card.dataset.speed;
            onSpeedInput();
          });
        });
      }
    }

    if (config.controls === 'voicefx') {
      const voiceFxEl = root.querySelector('#voice-fx');
      const voiceDescEl = root.querySelector('#voice-desc');
      const voiceIntensityWrap = root.querySelector('#voice-intensity-wrap');
      const voiceIntensity = root.querySelector('#voice-intensity');
      const voiceIntensityVal = root.querySelector('#voice-intensity-val');
      let voiceTimer = 0;
      async function applyVoiceSelection() {
        // Capture the position BEFORE stopping -- stopAB() resets it to zero, which is why
        // switching effects used to jump back to the start of the track instead of carrying on
        // from where you were listening.
        const resumeAt = resumePosition();
        stopAB();
        renderedBuffer = null;      // cached render belongs to the previous effect/intensity
        exportedClean = false;
        eqSyncState();
        if (!sourceBuffer) return;
        if (abSelected !== 'result') { selectAbSide('result'); return; }
        if (!(await ensureAbResult())) return;
        const buf = currentAbBuffer();
        if (buf) playAB('result', buf, resumeAt);
      }
      voiceFxEl.querySelectorAll('.preset-card').forEach((card) => {
        card.addEventListener('click', () => {
          voiceFxEl.querySelectorAll('.preset-card').forEach((c) => c.classList.remove('active'));
          card.classList.add('active');
          if (voiceDescEl) {
            voiceDescEl.textContent = card.dataset.desc || '';
            voiceDescEl.style.display = card.dataset.desc ? 'block' : 'none';
          }
          // The intensity slider only makes sense once there's an effect to scale, so it stays
          // hidden until one is picked rather than sitting there doing nothing.
          if (voiceIntensityWrap) voiceIntensityWrap.style.display = 'flex';
          applyVoiceSelection();
        });
      });
      if (voiceIntensity) {
        voiceIntensity.addEventListener('input', () => {
          if (voiceIntensityVal) voiceIntensityVal.textContent = voiceIntensity.value + '%';
          // Debounced, same reason as the pitch slider: each change is a full-file re-render.
          clearTimeout(voiceTimer);
          voiceTimer = window.setTimeout(applyVoiceSelection, 500);
        });
      }
    }

    if (config.controls === 'pitch1') {
      const pitchSlider = root.querySelector('#ctrl-slider');
      const centsSlider = root.querySelector('#ctrl-cents');
      const pitchValEl = root.querySelector('#pitch-val');
      const centsValEl = root.querySelector('#cents-val');
      let pitchTimer = 0;
      function onPitchInput() {
        const v = Number(pitchSlider.value);
        const c = centsSlider ? Number(centsSlider.value) : 0;
        if (pitchValEl) {
          pitchValEl.textContent = v === 0
            ? labels.pitchUnchangedLabel
            : `${v > 0 ? '+' : ''}${v} ${labels.semitonesShortLabel} (${v > 0 ? labels.pitchUpLabel : labels.pitchDownLabel})`;
        }
        if (centsValEl) centsValEl.textContent = `${c > 0 ? '+' : ''}${c} ${labels.centsShortLabel}`;
        // Same as the voice tool: remember where we were before stopAB() zeroes it, so changing
        // key carries on from the same spot rather than restarting the track.
        const resumeAt = resumePosition();
        stopAB();
        renderedBuffer = null;        // cached render is for the previous value
        exportedClean = false;
        eqSyncState();
        // Debounced: pitch-shifting is a full-file transform, so firing it on every pixel of
        // slider travel would queue up renders nobody asked for. Half a second after the slider
        // settles, render and play so there's no extra button to press.
        clearTimeout(pitchTimer);
        pitchTimer = window.setTimeout(async () => {
          if (!sourceBuffer || !toolIsDirty()) return;
          if (abSelected !== 'result') { selectAbSide('result'); return; }
          if (!(await ensureAbResult())) return;
          const buf = currentAbBuffer();
          if (buf) playAB('result', buf, resumeAt);
        }, 500);
      }
      [pitchSlider, centsSlider].forEach((el) => el && el.addEventListener('input', onPitchInput));
    }

    const rtVolumeEl = root.querySelector('#rt-volume');
    const rtVolumeVal = root.querySelector('#rt-volume-val');
    if (rtVolumeEl && rtVolumeVal) {
      rtVolumeEl.addEventListener('input', () => { rtVolumeVal.textContent = rtVolumeEl.value + '%'; });
    }
    if (config.controls === 'fade2') {
      const sec = labels.secShortLabel || 'sec';
      function onFadeInput() {
        if (fadeInEl) root.querySelector('#fadein-val').textContent = `${fadeInEl.value} ${sec}`;
        if (fadeOutEl) root.querySelector('#fadeout-val').textContent = `${fadeOutEl.value} ${sec}`;
        exportedClean = false;
        eqSyncState();
        updateFadeRegions();
        invalidateRender();
        fadeReschedule();
        // Adjusting a fade while listening to the untouched original would be silent -- flip to
        // the processed side so the change you just made is what you actually hear.
        if (abSelected !== 'result' && !abResultBtn?.disabled) selectAbSide('result');
      }
      [fadeInEl, fadeOutEl].forEach((el) => el && el.addEventListener('input', onFadeInput));
      const fadePresetsEl = root.querySelector('#fade-presets');
      if (fadePresetsEl) {
        fadePresetsEl.querySelectorAll('.preset-card').forEach((card) => {
          card.addEventListener('click', () => {
            const p = (config.fadePresets || []).find((x) => x.key === card.dataset.preset);
            if (!p) return;
            fadePresetsEl.querySelectorAll('.preset-card').forEach((c) => c.classList.remove('active'));
            card.classList.add('active');
            if (fadeInEl) fadeInEl.value = String(p.fadeIn);
            if (fadeOutEl) fadeOutEl.value = String(p.fadeOut);
            onFadeInput();
          });
        });
      }
    }
    if (config.controls === 'eq10') {
      (config.bands || []).forEach((b, i) => {
        const el = root.querySelector(`#eq-band-${b.id}`);
        const valEl = root.querySelector(`#eq-val-${b.id}`);
        if (!el) return;
        el.addEventListener('input', () => {
          if (valEl) valEl.textContent = Number(el.value) === 0 ? '0' : (Number(el.value) > 0 ? '+' : '') + el.value;
          // Live: push the new gain into the already-playing filter, no re-render needed.
          if (eqLiveFilters[i]) eqLiveFilters[i].gain.value = Number(el.value);
          eqSyncState();
          invalidateRender();
          // Moving a slider while listening to the untouched original would be silent -- flip
          // to the processed side so the change you just made is what you actually hear.
          if (abSelected !== 'result' && !abResultBtn?.disabled) selectAbSide('result');
        });
      });
      const eqPresetsEl = root.querySelector('#eq-presets');
      if (eqPresetsEl) {
        eqPresetsEl.querySelectorAll('.preset-card').forEach((card) => {
          card.addEventListener('click', () => {
            const preset = (config.eqPresets || []).find((p) => p.key === card.dataset.preset);
            if (!preset) return;
            eqPresetsEl.querySelectorAll('.preset-card').forEach((c) => c.classList.remove('active'));
            card.classList.add('active');
            applyEqGains(preset.gains);
          });
        });
      }
      const eqResetBtn = root.querySelector('#eq-reset-btn');
      if (eqResetBtn) {
        eqResetBtn.addEventListener('click', () => {
          if (eqPresetsEl) eqPresetsEl.querySelectorAll('.preset-card').forEach((c) => c.classList.remove('active'));
          applyEqGains((config.bands || []).map(() => 0));
        });
      }
    }
    function applyEqGains(gains) {
      (config.bands || []).forEach((b, i) => {
        const el = root.querySelector(`#eq-band-${b.id}`);
        const valEl = root.querySelector(`#eq-val-${b.id}`);
        if (!el) return;
        const v = gains[i] ?? 0;
        el.value = String(v);
        if (valEl) valEl.textContent = v === 0 ? '0' : (v > 0 ? '+' : '') + v;
        if (eqLiveFilters[i]) eqLiveFilters[i].gain.value = v;
      });
      eqSyncState();
      invalidateRender();
      if (abSelected !== 'result' && !abResultBtn?.disabled) selectAbSide('result');
    }
    // Picking a different setting while something is playing should swap to that setting and
    // carry on from the same spot -- which is what the voice changer already does with its
    // preset cards. Stopping dead and waiting for a second press loses your place in the track.
    async function onSettingChanged() {
      const wasPlaying = player.isPlaying();
      const resumeAt = resumePosition();
      invalidateRender();
      syncSourceNote();
      eqSyncState();
      if (!wasPlaying || !isRenderedAb || !sourceBuffer) return;
      if (abSelected !== 'result') return;
      if (!(await ensureAbResult())) return;
      const buf = currentAbBuffer();
      if (buf) playAB('result', buf, resumeAt);
    }
    ['#ctrl-fadein', '#ctrl-fadeout', '#ctrl-select', '#ctrl-duration', '#ctrl-cutout', '#ctrl-samplerate', '#ctrl-channels', '#ctrl-normalize', '#ctrl-silence-start', '#ctrl-silence-end'].forEach((sel) => {
      const el = root.querySelector(sel);
      if (el) el.addEventListener('input', onSettingChanged);
    });

    // Preset quick-pick buttons (compress bitrate targets, EQ genre presets, etc.) -- each
    // just writes into the same slider/eq inputs the user could set by hand, so no separate
    // render path is needed.
    const presetsRow = root.querySelector('#presets-row');
    if (presetsRow && config.presets) {
      presetsRow.querySelectorAll('.preset-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const preset = config.presets.find((p) => p.key === btn.dataset.preset);
          if (!preset) return;
          Object.entries(preset.set).forEach(([key, val]) => {
            const id = key === 'value' ? '#ctrl-slider' : `#eq-${key}`;
            const el = root.querySelector(id);
            const valEl = root.querySelector(id + '-val');
            if (!el) return;
            el.value = val;
            if (valEl) valEl.textContent = val + (key === 'value' ? (config.sliderUnit || '') : 'dB');
          });
          invalidateRender();
          syncSourceNote();
        });
      });
    }

    function readParams() {
      const params = {};
      const get = (id) => root.querySelector(id);
      if (get('#ctrl-format')) params.format = get('#ctrl-format').value;
      if (get('#ctrl-bitrate')) params.bitrate = get('#ctrl-bitrate').value;
      if (get('#ctrl-slider')) params.value = Number(get('#ctrl-slider').value);
      if (get('#ctrl-select')) params.value = get('#ctrl-select').value;
      if (config.controls === 'eq10') params.bands = eqBandGains();
      if (get('#ctrl-cents')) params.cents = Number(get('#ctrl-cents').value);
      if (get('#ctrl-keeppitch')) params.keepPitch = get('#ctrl-keeppitch').checked;
      if (config.controls === 'vizstyles') {
        const activeStyle = root.querySelector('#viz-styles .preset-card.active');
        params.value = activeStyle ? activeStyle.dataset.style : 'wave-green';
        if (get('#viz-size')) params.size = get('#viz-size').value;
      }
      if (config.controls === 'voicefx') {
        const active = root.querySelector('#voice-fx .preset-card.active');
        params.effect = active ? active.dataset.effect : null;
        const inten = get('#voice-intensity');
        params.intensity = inten ? Number(inten.value) : 60;
      }
      if (get('#ctrl-fadein')) params.fadeIn = get('#ctrl-fadein').value;
      if (get('#ctrl-fadeout')) params.fadeOut = get('#ctrl-fadeout').value;
      if (get('#chk-fadein')) params.fadeIn = get('#chk-fadein').checked;
      if (get('#chk-fadeout')) params.fadeOut = get('#chk-fadeout').checked;
      if (get('#ctrl-duration')) params.duration = Number(get('#ctrl-duration').value);
      if (get('#ctrl-samplerate')) params.sampleRate = get('#ctrl-samplerate').value;
      if (get('#ctrl-channels')) params.channels = get('#ctrl-channels').value;
      if (get('#ctrl-normalize')) params.normalize = get('#ctrl-normalize').checked;
      if (get('#ctrl-cutout')) params.cutOut = get('#ctrl-cutout').checked;
      if (get('#ctrl-bpm-from')) params.bpmFrom = Number(get('#ctrl-bpm-from').value) || 0;
      if (get('#ctrl-bpm-to')) params.bpmTo = Number(get('#ctrl-bpm-to').value) || 0;
      if (get('#ctrl-split-mode')) params.splitMode = get('#ctrl-split-mode').value;
      if (get('#ctrl-split-value')) params.splitValue = Number(get('#ctrl-split-value').value) || 0;
      if (get('#ctrl-silence-start')) params.silenceStart = Number(get('#ctrl-silence-start').value) || 0;
      if (get('#ctrl-silence-end')) params.silenceEnd = Number(get('#ctrl-silence-end').value) || 0;
      if (config.controls === 'trim' || config.controls === 'ringtone-targets' || config.trimSelection) { params.start = selStart; params.end = selEnd; }
      return params;
    }

    function animatePlayhead() {
      if (!player.isPlaying()) { playhead.style.display = 'none'; return; }
      requestAnimationFrame(animatePlayhead);
    }

    async function doRender() {
      const params = readParams();
      if (config.engine === 'webaudio-generator') {
        const sr = 44100;
        const length = Math.max(1, Math.round((params.duration || config.durationDefault) * sr));
        const out = new AudioBuffer({ numberOfChannels: 1, length, sampleRate: sr });
        const data = out.getChannelData(0);
        if (config.color === 'white') {
          for (let i = 0; i < length; i++) data[i] = Math.random() * 2 - 1;
        } else {
          let b0 = 0, b1 = 0, b2 = 0;
          for (let i = 0; i < length; i++) {
            const white = Math.random() * 2 - 1;
            b0 = 0.99886 * b0 + white * 0.0555179;
            b1 = 0.99332 * b1 + white * 0.0750759;
            b2 = 0.96900 * b2 + white * 0.1538520;
            data[i] = (b0 + b1 + b2 + white * 0.1848) * 0.2;
          }
        }
        // A short fade-out so the noise doesn't just cut off abruptly at the end -- there was
        // no shaping at all before, every generated clip ended in an audible hard stop.
        const foSamples = Math.min(length, Math.round(sr * 1.5));
        for (let i = 0; i < foSamples; i++) data[length - 1 - i] *= i / foSamples;
        revealResultWaveform(out);
        return out;
      }
      if (config.engine === 'webaudio-mix') {
        const buffers = await Promise.all(files.map((f) => decodeBuffered(f)));
        const sr = buffers[0].sampleRate;
        const ch = Math.max(...buffers.map((b) => b.numberOfChannels));
        // As long as the longest input: a short jingle under a long voice track shouldn't cut
        // the voice off, and a long bed under a short clip shouldn't be truncated either.
        const len = Math.max(...buffers.map((b) => b.length));
        const out = new AudioBuffer({ numberOfChannels: ch, length: len, sampleRate: sr });
        let peak = 0;
        for (let c = 0; c < ch; c++) {
          const dst = out.getChannelData(c);
          buffers.forEach((b, idx) => {
            const src = b.getChannelData(Math.min(c, b.numberOfChannels - 1));
            // Своя громкость у каждого файла -- со своего ползунка в списке.
            const g = gainFor(files[idx], idx) / 100;
            for (let i = 0; i < src.length; i++) dst[i] += src[i] * g;
          });
          for (let i = 0; i < len; i++) peak = Math.max(peak, Math.abs(dst[i]));
        }
        // Summing signals can exceed full scale, and clipping is the ugliest possible outcome.
        // Scale the whole mix down instead, only when it actually overflows.
        if (peak > 1) {
          const g = 0.99 / peak;
          for (let c = 0; c < ch; c++) {
            const dst = out.getChannelData(c);
            for (let i = 0; i < len; i++) dst[i] *= g;
          }
        }
        revealResultWaveform(out);
        return out;
      }
      if (config.engine === 'webaudio-merge') {
        const buffers = await Promise.all(files.map((f) => decodeBuffered(f)));
        const sr = buffers[0].sampleRate;
        const ch = Math.max(...buffers.map((b) => b.numberOfChannels));
        // 80ms crossfade at each join -- plain back-to-back concatenation (the old behavior)
        // has an audible click/edit at every seam.
        const xfade = Math.min(Math.round(sr * 0.08), ...buffers.map((b) => Math.floor(b.length / 4)));
        const totalLen = buffers.reduce((sum, b) => sum + b.length, 0) - xfade * Math.max(0, buffers.length - 1);
        const out = new AudioBuffer({ numberOfChannels: ch, length: Math.max(1, totalLen), sampleRate: sr });
        for (let c = 0; c < ch; c++) {
          const dst = out.getChannelData(c);
          let offset = 0;
          buffers.forEach((b, idx) => {
            const src = b.getChannelData(Math.min(c, b.numberOfChannels - 1));
            for (let i = 0; i < src.length; i++) {
              let w = 1;
              if (idx > 0 && i < xfade) w = i / xfade;
              if (idx < buffers.length - 1 && i >= src.length - xfade) w *= (src.length - i) / xfade;
              dst[offset + i] += src[i] * w;
            }
            offset += src.length - (idx < buffers.length - 1 ? xfade : 0);
          });
        }
        revealResultWaveform(out);
        return out;
      }
      return renderEffect(sourceBuffer, {
        render: config.render,
        directRender: config.directRender,
        params,
        outputSampleRate: config.outputSampleRate ? config.outputSampleRate(params) : undefined,
        outputChannels: config.outputChannels,
      });
    }

    // Generator/merge tools have no uploaded source to show a waveform of upfront -- draw one
    // of the RESULT the first time it's available (post-generate / post-merge), matching the
    // "listen before download" pattern the rest of the tools already have.
    function revealResultWaveform(buffer) {
      if (!waveShell || !waveCanvas) return;
      dur = buffer.duration;
      waveShell.style.display = '';
      scheduleWaveformDraw(buffer);
      // Появился результат -- значит есть что играть. Ряд управления под волной включается
      // здесь, а не в путях загрузки файла: у микшера отдельного исходного файла нет вовсе,
      // и все те пути его не касаются -- кнопка оставалась заблокированной при готовом миксе.
      if (wavePlayBtn) wavePlayBtn.disabled = false;
      if (transportDurEl) transportDurEl.textContent = fmtClock(buffer.duration);
      if (transportCurEl) transportCurEl.textContent = '0:00';
    }

    if (listenBtn) {
      listenBtn.addEventListener('click', async () => {
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        if (player.isPlaying()) {
          player.pause();
          listenIco.innerHTML = ICO_PLAY;
          return;
        }
        player.unlock();
        clearError();
        try {
          if (!renderedBuffer) {
            listenBtn.disabled = true;
            armProgress();
            progressText.textContent = labels.workingLabel;
            renderedBuffer = await doRender();
        syncResultWave();
            hideProgress();
            listenBtn.disabled = false;
            // The old two-button download strip only exists on tools without an export bar.
            // Merge grew one, so this went null there and threw -- inside the try, so it
            // surfaced as an error message instead of a console error, and the merged track
            // never started playing even though its waveform had already appeared.
            if (downloadRow) downloadRow.style.display = 'flex';
          }
          listenIco.innerHTML = ICO_PAUSE;
          player.play(
            renderedBuffer,
            (frac) => {
              if (!waveShell) return;
              // What plays back is the SELECTION, so the marker has to be mapped onto it.
              const trimmed = config.controls === 'trim' || config.trimSelection;
              const base = trimmed ? selStart : 0;
              const range = trimmed ? (selEnd - selStart) : renderedBuffer.duration;
              setPlayheadTime(base + range * frac);
            },
            () => { listenIco.innerHTML = ICO_PLAY; playhead.style.display = 'none'; player.reset(); },
            // Играть ОТ БЕГУНКА. Здесь место не передавалось вовсе, поэтому склейка всегда
            // начинала сначала, даже когда бегунок стоял в середине.
            (() => { const p = waveSeekPos; waveSeekPos = null; return p == null ? undefined : p; })()
          );
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
          hideProgress();
          listenBtn.disabled = false;
        }
      });
    }

    async function ensureRendered() {
      if (!renderedBuffer) renderedBuffer = await doRender();
        syncResultWave();
      return renderedBuffer;
    }

    // Click/tap anywhere on the waveform to start playback from that point (LeebTTS has this,
    // there was previously no way to do it here at all -- only the trim handles moved a
    // selection). Ignores clicks on the drag handles/selection overlay, which have their own
    // mousedown handlers above. Three playback sources depending on tool type: ringtone slices
    // the live selection on demand, plain ffmpeg tools (Convert etc.) preview the raw decoded
    // source since they have no Web-Audio "effect" to render, and every other tool reuses the
    // same lazily-rendered/cached `renderedBuffer` the Listen button already relies on.
    if (waveShell) {
      // Протаскивание бегунка: нажал, ведёшь -- бегунок идёт за мышью, отпустил -- плеер
      // ВСТАЛ НА ПАУЗУ на этом месте. Так во всём редакторе, и владелец просил единой логики
      // (16.08.2026): «черточка идёт за мышкой, переместил ползунок -- плеер стал на паузу».
      // Раньше здесь звук возобновлялся с нового места, и склейка вела себя иначе редактора.
      //
      // Сам щелчок остаётся щелчком: перемотка запускается только после того, как палец
      // сдвинулся хотя бы на 3 пикселя, иначе обычное нажатие превращалось бы в протаскивание
      // и мешало кнопкам и ручкам выделения внутри дорожки.
      if (waveArea) {
        let scrubbing = false;
        let startX = 0;
        const scrubTo = (clientX) => {
          if (dur <= 0) return;
          const r = waveArea.getBoundingClientRect();
          const frac = Math.max(0, Math.min(1, (clientX - r.left) / r.width));
          setPlayheadFrac(frac);
          if (transportCurEl) { transportCurEl.textContent = fmtClock(frac * dur); transportCurEl.hidden = false; }
          return frac * dur;
        };
        waveArea.addEventListener('pointerdown', (e) => {
          if (dur <= 0 || e.button !== 0) return;
          startX = e.clientX;
          scrubbing = false;
          const move = (ev) => {
            if (!scrubbing && Math.abs(ev.clientX - startX) < 3) return;
            if (!scrubbing) { scrubbing = true; player.stop(); waveArea.setPointerCapture?.(ev.pointerId); }
            scrubTo(ev.clientX);
          };
          const up = (ev) => {
            document.removeEventListener('pointermove', move);
            document.removeEventListener('pointerup', up);
            if (!scrubbing) {
              // ОБЫЧНОЕ НАЖАТИЕ тоже перемещает бегунок и ставит на паузу -- как в редакторе.
              // Раньше нажатие не делало ничего: перемотка включалась только после сдвига на
              // 3 точки, и человек, ткнув в волну, не получал отклика. Владелец это и увидел.
              // Ручки обрезки и кнопки внутри дорожки не трогаем -- у них свои обработчики,
              // и нажатие по ним сюда не должно приводить.
              const цель = e.target;
              if (цель && цель.closest && цель.closest('.sel-handle, .move-ico, .sel-overlay, button, .tp-btn, .handle')) return;
              const сек = scrubTo(ev.clientX);
              if (сек != null) waveSeekPos = сек; // играть дальше ОТСЮДА, а не с начала
              player.stop();
              if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PLAY; wavePlayIco.closest('.tp-btn')?.classList.remove('is-playing'); }
              return;
            }
            const сек2 = scrubTo(ev.clientX);
            if (сек2 != null) waveSeekPos = сек2; // играть дальше ОТСЮДА, а не с начала
            // НЕ возобновляем: положение выставлено, звук стоит. Дальше человек сам решает,
            // слушать ли отсюда, -- кнопкой.
            player.stop();
            if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PLAY; wavePlayIco.closest('.tp-btn')?.classList.remove('is-playing'); }
          };
          document.addEventListener('pointermove', move);
          document.addEventListener('pointerup', up);
        });
      }

      // Пробел -- плей и пауза, как в любой звуковой программе. Игнорируется, когда человек
      // печатает в поле или выбирает в списке: там пробел значит пробел.
      document.addEventListener('keydown', (e) => {
        if (e.code !== 'Space' && e.key !== ' ') return;
        const el = document.activeElement;
        if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT'
          || el.isContentEditable || el.tagName === 'BUTTON' || el.tagName === 'A')) return;
        const btn = wavePlayBtn;
        if (!btn || btn.disabled || dur <= 0) return;
        e.preventDefault();
        btn.click();
      });

      waveShell.addEventListener('click', async (e) => {
        // composedPath() is fixed when the event is dispatched, so it still names the button even
        // if a handler further down replaced the node that was clicked. target.closest() alone
        // silently stops answering once that happens -- see the note on the play button.
        const from = (sel) => (e.composedPath ? e.composedPath().some((n) => n.matches && n.matches(sel)) : false)
          || !!(e.target.closest && e.target.closest(sel));
        // Кнопки плеера перечислены ПО ВСЕМ приметам, какие у них есть. Раньше здесь стоял
        // только класс .wave-play-btn, а у кнопки в компактном плеере это ИМЯ (id), классы же
        // у неё tp-btn tp-play. Нажатие по «играть» всплывало сюда, и обработчик глушил звук
        // сразу после запуска -- владелец видел красное «браузер прервал воспроизведение,
        // нажмите ещё раз». На телефоне это ловилось особенно охотно.
        if (from('.handle') || from('.sel-overlay') || from('.wave-play-btn')
            || from('#wave-play-btn') || from('.tp-btn') || from('button')) return;
        if (dur <= 0) return;
        const t = px2t(e.clientX);
        player.unlock();
        player.stop();
        window.dispatchEvent(new Event('opitro:tool-interaction'));

        // ОБЩЕЕ ПРАВИЛО: нажатие по волне ставит бегунок и оставляет звук СТОЯТЬ.
        // Раньше отсюда воспроизведение запускалось заново с этого места -- и это перебивало
        // остановку из обработчика протаскивания: бегунок прыгал куда надо, а музыка ехала
        // дальше. Владелец видел именно это. Слушать или нет -- решает кнопка, не дорожка.
        if (dur > 0) {
          // ЗАПОМНИТЬ положение: следующее «играть» идёт отсюда, а не с начала файла.
          waveSeekPos = t;
          setPlayheadFrac(Math.max(0, Math.min(1, t / dur)));
          if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PLAY; wavePlayIco.closest('.tp-btn')?.classList.remove('is-playing'); }
          if (typeof listenIco !== 'undefined' && listenIco) listenIco.innerHTML = ICO_PLAY;
          return;
        }

        if (config.controls === 'ringtone-targets') {
          if (!sourceBuffer || selEnd - selStart < 0.05) return;
          const seekTo = Math.max(selStart, Math.min(selEnd, t)) - selStart;
          let slice = sliceBuffer(sourceBuffer, selStart, selEnd);
          const rtVolumeEl2 = root.querySelector('#rt-volume');
          if (rtVolumeEl2) slice = scaleVolume(slice, Number(rtVolumeEl2.value) / 100);
          const chkFadeIn = root.querySelector('#chk-fadein');
          const chkFadeOut = root.querySelector('#chk-fadeout');
          if (chkFadeIn && chkFadeOut && (chkFadeIn.checked || chkFadeOut.checked)) {
            slice = await applyFade(slice, chkFadeIn.checked ? 1 : 0, chkFadeOut.checked ? 2 : 0);
          }
          if (listenSelIco) listenSelIco.innerHTML = ICO_PAUSE;
          player.play(
            slice,
            (frac) => {
              setPlayheadTime(selStart + (selEnd - selStart) * frac);
            },
            () => { if (listenSelIco) listenSelIco.innerHTML = ICO_PLAY; playhead.style.display = 'none'; player.reset(); },
            seekTo
          );
          return;
        }

        // Any tool using the compact player -- with or without an A/B switch -- treats a tap on
        // the waveform as "move the marker", not "start playing": there's a dedicated play
        // button for that. Keyed off the player rather than off abCompare, because volume and
        // speed have no A/B switch and were falling through to the legacy render-and-play path,
        // which positioned the marker from a different origin (hence a playhead that appeared
        // sometimes before and sometimes after the play button).
        if (config.compactPreview || config.abCompare || LIVE_CHAIN_TOOLS[config.controls] || isRenderedAb) {
          if (!sourceBuffer) return;
          // Unconditional, NOT `if (player.isPlaying())` -- player.stop() already ran at the
          // top of this handler, so by here isPlaying() is always false and the guarded
          // version silently skipped resetting the play icon, leaving it stuck on "pause"
          // after a seek even though nothing was playing anymore.
          stopAB();
          waveSeekPos = t;
          setPlayheadTime(t);
          return;
        }

        if (config.engine === 'ffmpeg') {
          if (!sourceBuffer) return;
          const simpleIco = root.querySelector('.simple-preview-ico');
          if (simpleIco) simpleIco.innerHTML = ICO_PAUSE;
          player.play(
            sourceBuffer,
            (frac) => {
              setPlayheadTime(frac * dur);
            },
            () => {
              playhead.style.display = 'none';
              player.reset();
              if (simpleIco) simpleIco.innerHTML = ICO_PLAY;
            },
            t
          );
          return;
        }

        try {
          if (!renderedBuffer) {
            armProgress();
            progressText.textContent = labels.workingLabel;
            renderedBuffer = await doRender();
        syncResultWave();
            hideProgress();
            if (downloadRow) downloadRow.style.display = 'flex';
          }
        } catch (err) {
          hideProgress();
          return;
        }
        const base = config.controls === 'trim' ? selStart : 0;
        const range = config.controls === 'trim' ? (selEnd - selStart) : renderedBuffer.duration;
        const clamped = config.controls === 'trim' ? Math.max(selStart, Math.min(selEnd, t)) : t;
        const frac = range > 0 ? (clamped - base) / range : 0;
        const seekTo = Math.max(0, Math.min(renderedBuffer.duration, frac * renderedBuffer.duration));
        if (listenIco) listenIco.innerHTML = ICO_PAUSE;
        player.play(
          renderedBuffer,
          (frac2) => {
            setPlayheadTime(base + range * frac2);
          },
          () => { if (listenIco) listenIco.innerHTML = ICO_PLAY; playhead.style.display = 'none'; player.reset(); },
          seekTo
        );
      });
    }

    // Drag the position marker on the compact preview (enhance). The click handler above only
    // covers a single tap -- holding and moving did nothing, so the marker felt un-draggable.
    // Dragging stops playback immediately (you're choosing a new spot, not scrubbing audio) and
    // parks the marker there; pressing play afterwards resumes from exactly that point.
    if (waveShell && (config.compactPreview || config.abCompare || LIVE_CHAIN_TOOLS[config.controls] || isRenderedAb)) {
      let scrubbing = false;
      const scrubTo = (clientX) => {
        if (dur <= 0) return;
        const t = px2t(clientX);
        waveSeekPos = t;
        setPlayheadTime(t);
      };
      const onScrubMove = (e) => {
        if (!scrubbing) return;
        e.preventDefault();
        scrubTo(e.touches ? e.touches[0].clientX : e.clientX);
      };
      const endScrub = () => {
        scrubbing = false;
        document.removeEventListener('mousemove', onScrubMove);
        document.removeEventListener('touchmove', onScrubMove);
        document.removeEventListener('mouseup', endScrub);
        document.removeEventListener('touchend', endScrub);
      };
      const startScrub = (e) => {
        if (e.target.closest('.wave-play-btn') || dur <= 0) return;
        scrubbing = true;
        stopAB();
        scrubTo(e.touches ? e.touches[0].clientX : e.clientX);
        document.addEventListener('mousemove', onScrubMove);
        document.addEventListener('touchmove', onScrubMove, { passive: false });
        document.addEventListener('mouseup', endScrub);
        document.addEventListener('touchend', endScrub);
      };
      waveShell.addEventListener('mousedown', startScrub);
      waveShell.addEventListener('touchstart', startScrub, { passive: true });
    }

    if (dlMp3Btn) {
      dlMp3Btn.addEventListener('click', async () => {
        clearError();
        try {
          const buf = await ensureRendered();
          const bitrate = config.mp3Bitrate ? config.mp3Bitrate(readParams()) : 192;
          const blob = await encodeMP3(buf, bitrate);
          const base = config.controls === 'generator' ? tool : config.controls === 'multi-file' ? 'merged' : (file.name.replace(/\.[^.]+$/, '') || 'audio');
          downloadBlob(blob, `${base}.mp3`);
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
        }
      });
    }
    if (dlWavBtn) {
      dlWavBtn.addEventListener('click', async () => {
        clearError();
        try {
          const buf = await ensureRendered();
          const blob = encodeWAV(buf);
          const base = config.controls === 'generator' ? tool : config.controls === 'multi-file' ? 'merged' : (file.name.replace(/\.[^.]+$/, '') || 'audio');
          downloadBlob(blob, `${base}.wav`);
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
        }
      });
    }

    // ffmpeg-engine tools (convert, ringtone, video-to-audio, visualizer, denoise, enhance).
    // `download` is false for the "just preview this preset" path (preset-card clicks) --
    // separates trying a scenario (cheap, just listen) from actually exporting the file.
    // `ffmpegBusy` guards against overlapping exec calls -- ffmpeg.wasm is one shared instance,
    // not built for concurrent calls, and clicking through preset cards quickly (a very natural
    // thing to do while exploring) fired them on top of each other with no error, just a stuck
    // "Working..." state and nothing in the UI ever updating again.
    let ffmpegBusy = false;
    // `extraParams` is merged over readParams() -- used by the visualizer to render a
    // duration-capped preview through the exact same command as the real export.
    // Returns the produced blob (or undefined) so callers can preview it without re-running.
    // `opts.auto` -- прогон, которого человек не просил: он запускается сам, как только файл
    // прочитан, чтобы показанная в списке настройка была правдой. Такой прогон готовит результат
    // молча: не включает звук и не перекидывает переключатель на "Результат". Всё, что он делает
    // видимого, -- снимает блокировку с "Результата" и с кнопки скачивания.
    async function runFfmpegProcess(download, extraParams, opts) {
        const auto = !!(opts && opts.auto);
        if (ffmpegBusy) return;
        if (config.allowBatch ? !files.length : !file) return;
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        clearError();
        ffmpegBusy = true;
        runBtn.disabled = true;
        if (presetCardsEl) presetCardsEl.querySelectorAll('.preset-card').forEach((c) => { c.disabled = true; });
        armProgress();
        progressFill.style.width = '0%';
        progressText.textContent = labels.preparingLabel;

        const params = Object.assign(readParams(), extraParams || {});
        let producedBlob;

        if (config.allowBatch) {
          const results = [];
          for (let i = 0; i < files.length; i++) {
            const f = files[i];
            progressText.textContent = `${labels.batchProcessingLabel || 'Processing'} ${i + 1}/${files.length}: ${f.name}`;
            try {
              const { outputName, mimeType, ext } = config.output(params);
              const blob = await execFFmpeg({
                inputs: [{ name: 'in0', file: f }],
                buildArgs: (inputNames, out) => config.buildArgs(inputNames, out, params),
                outputName,
                mimeType,
                // Overall batch progress, not per-file: the caption that used to say "3/12" is
                // gone, so the bar has to carry that information itself -- otherwise it would
                // reset to zero on every file and tell you nothing about how much is left.
                onProgress: (pct) => {
                  progressFill.style.width = (((i + pct / 100) / files.length) * 100).toFixed(1) + '%';
                },
              });
              const base = f.name.replace(/\.[^.]+$/, '') || `file-${i + 1}`;
              results.push({ name: `${base}.${ext}`, blob });
            } catch (e) {
              showError(`${f.name}: ${e && e.message ? e.message : String(e)}`);
            }
            // Fresh ffmpeg instance between every file -- processing many files back-to-back on
            // the same instance is exactly the "crashes after a lot of conversions" pattern
            // documented in ffmpeg.wasm's own issue tracker (see the ringtone config comment).
            resetFFmpeg();
          }
          if (results.length) {
            if (results.length === 1) {
              downloadFfmpegBlob(results[0].blob, results[0].name);
            } else {
              progressText.textContent = labels.batchZippingLabel || 'Packing ZIP...';
              const { default: JSZip } = await import('jszip');
              const zip = new JSZip();
              results.forEach((r) => zip.file(r.name, r.blob));
              const zipBlob = await zip.generateAsync({ type: 'blob' });
              downloadFfmpegBlob(zipBlob, 'converted.zip');
            }
            finishProgress(labels.doneLabel);
            setRunLabel(labels[config.runLabel] || labels.processLabel);
          } else {
            hideProgress();
          }
          ffmpegBusy = false;
          runBtn.disabled = false;
          if (presetCardsEl) presetCardsEl.querySelectorAll('.preset-card').forEach((c) => { c.disabled = false; });
          return;
        }

        const { outputName, mimeType, ext } = config.output(params);
        try {
          const blob = await execFFmpeg({
            inputs: [{ name: 'in0', file }],
            buildArgs: (inputNames, out) => config.buildArgs(inputNames, out, params),
            outputName,
            mimeType,
            onProgress: (pct) => {
              progressFill.style.width = pct + '%';
              progressText.textContent = `${labels.workingLabel} ${pct}%`;
              if (progressHook) progressHook(pct);
            },
          });
          const base = file.name.replace(/\.[^.]+$/, '') || 'audio';
          finishProgress(download ? labels.doneLabel : (labels.previewDoneLabel || labels.doneLabel));
          setRunLabel(labels[config.runLabel] || labels.processLabel);
          runBtn.onclick = null;
          if (download) downloadFfmpegBlob(blob, `${base}.${ext}`);
          if (config.abCompare && abCompareEl) {
            lastResultBlob = blob;
            lastResultName = `${base}.${ext}`;
            lastResultPreset = params.value;
            try {
              lastResultBuffer = await decodeFile(new File([blob], 'result', { type: mimeType }));
              abCompareEl.style.display = 'flex';
              if (abResultBtn) abResultBtn.disabled = false;
              if (wavePlayBtn) wavePlayBtn.disabled = false;
              // Молчаливый прогон на всё это не претендует: человек только что выбрал файл и
              // ждёт тишины, а не внезапно заигравшего звука. Он остаётся на "Оригинале" --
              // просто теперь рядом есть живой "Результат", который и правда посчитан.
              if (!auto) {
                abSelected = 'result';
                if (abOriginalBtn) abOriginalBtn.classList.remove('active');
                if (abResultBtn) abResultBtn.classList.add('active');
                // Auto-play the result immediately -- previously you had to notice and tap the
                // "Result" A/B button yourself, which read as "nothing happened" after a click.
                // Starts from wherever the waveform was last tapped, if anywhere.
                const seek = waveSeekPos;
                waveSeekPos = null;
                playAB('result', lastResultBuffer, seek ?? undefined);
              }
            } catch (e) {}
          }
          producedBlob = blob;
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
          hideProgress();
        }
        ffmpegBusy = false;
        // Tools with abCompare start the download button disabled and only enable it once a
        // result actually exists -- a failed attempt shouldn't light it up either.
        runBtn.disabled = config.abCompare ? !lastResultBlob : false;
        if (presetCardsEl) presetCardsEl.querySelectorAll('.preset-card').forEach((c) => { c.disabled = false; });
        return producedBlob;
    }
    if (runBtn) {
      runBtn.addEventListener('click', () => {
        // If the currently-selected preset was already previewed (a preset-card tap runs it
        // for free), just download that cached result instead of processing the exact same
        // thing again -- one button, no confusing "which download button do I want" choice.
        // Reads the current setting whether it came from a card or a dropdown -- it was gated on
        // preset cards, so a dropdown-driven tool re-ran the identical ffmpeg job just to hand
        // back a file it had already made moments earlier.
        const currentPreset = root.querySelector('#ctrl-select')?.value ?? null;
        if (config.abCompare && lastResultBlob && currentPreset !== null && lastResultPreset === currentPreset) {
          downloadFfmpegBlob(lastResultBlob, lastResultName);
          return;
        }
        runFfmpegProcess(true);
      });
    }

    // OGG export for Telegram/WhatsApp: libopus at 24kHz first (avoids the specific internal
    // 48kHz resample path where ffmpeg.wasm crashes -- see the config comment), falling back to
    // libvorbis (already proven stable, used by the Convert tool) if libopus still crashes on
    // some device. `clip` should already be the small, trimmed selection, not the raw upload.
    async function encodeOgg(clip) {
      const resampled = await resampleBuffer(clip, config.oggSampleRate || 24000);
      const wavBlob = encodeWAV(resampled);
      const wavFile = new File([wavBlob], 'clip.wav', { type: 'audio/wav' });
      const runExport = (buildArgs) => execFFmpeg({
        inputs: [{ name: 'in0', file: wavFile }],
        buildArgs,
        outputName: 'out.ogg',
        mimeType: 'audio/ogg',
        onProgress: (pct) => {
          progressFill.style.width = pct + '%';
          progressText.textContent = `${labels.workingLabel} ${pct}%`;
        },
      });
      try {
        return await runExport(config.buildOpusArgs);
      } catch (e) {
        return await runExport(config.buildOggVorbisArgs);
      }
    }

    // Real M4R for iPhone (AAC in an MP4 container, .m4r extension) -- same aac codec the
    // Convert tool already relies on, so no libopus-style crash risk expected.
    async function encodeM4r(clip) {
      const wavBlob = encodeWAV(clip);
      const wavFile = new File([wavBlob], 'clip.wav', { type: 'audio/wav' });
      return execFFmpeg({
        inputs: [{ name: 'in0', file: wavFile }],
        buildArgs: (names, out) => config.buildAacArgs(names, out),
        outputName: 'out.m4a',
        mimeType: 'audio/mp4',
        onProgress: (pct) => {
          progressFill.style.width = pct + '%';
          progressText.textContent = `${labels.workingLabel} ${pct}%`;
        },
      });
    }

    // Ringtone target tiles -- each one runs its own ffmpeg recipe (format, max duration,
    // fades) against the current waveform selection, then shows a destination-specific guide.
    if (targetsEl) {
      targetsEl.querySelectorAll('.target').forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (!file) return;
          player.unlock();
          window.dispatchEvent(new Event('opitro:tool-interaction'));
          const target = config.targets.find((t) => t.key === btn.dataset.key);
          clearError();
          if (ringtoneGuide) ringtoneGuide.classList.remove('on');
          targetsEl.querySelectorAll('.target').forEach((b) => { b.disabled = true; });
          armProgress();
          progressFill.style.width = '0%';
          progressText.textContent = labels.preparingLabel;

          const chkFadeIn = root.querySelector('#chk-fadein');
          const chkFadeOut = root.querySelector('#chk-fadeout');
          const rtVolume = root.querySelector('#rt-volume');
          const fadeInOn = chkFadeIn ? chkFadeIn.checked : false;
          const fadeOutOn = chkFadeOut ? chkFadeOut.checked : false;
          const volPct = rtVolume ? Number(rtVolume.value) : 100;
          const vol = (volPct / 100) * (target.louder ? 1.4 : 1);

          try {
            let blob;
            if (sourceBuffer) {
              // Always process on the small in-memory buffer, entirely in Web Audio -- no
              // ffmpeg in this branch at all. See the engine comment on the ringtone config
              // entry for why (ffmpeg's OGG/libopus export crashes -- upstream bug, not ours).
              let duration = selEnd - selStart;
              if (target.max && duration > target.max) duration = target.max;
              let clip = sliceBuffer(sourceBuffer, selStart, selStart + duration);
              clip = scaleVolume(clip, vol);
              if (fadeInOn || fadeOutOn) clip = await applyFade(clip, fadeInOn ? 1 : 0, fadeOutOn ? 2 : 0);
              if (target.fmt === 'mp3') {
                progressText.textContent = labels.workingLabel;
                blob = await encodeMP3(clip, 192);
              } else if (target.fmt === 'ogg') {
                progressText.textContent = labels.workingLabel;
                blob = await encodeOgg(clip);
              } else if (target.fmt === 'm4r') {
                progressText.textContent = labels.workingLabel;
                blob = await encodeM4r(clip);
              } else {
                blob = encodeWAV(clip);
              }
            } else {
              // No decoded buffer -- the browser (and the ffmpeg decode fallback) both failed
              // to read this file for a waveform preview. Rather than blocking the whole tool
              // on that (a real gap found live: Convert never needed this step to succeed and
              // works fine on files this same decode step chokes on), run ffmpeg directly on
              // the original file instead, exactly like Convert does. No visual trim is
              // possible without a decoded duration, so this takes the first `target.max`
              // seconds (or a 30s default for targets with no cap).
              const duration = target.max || 30;
              progressText.textContent = labels.workingLabel;
              const af = [];
              if (vol !== 1) af.push(`volume=${vol.toFixed(2)}`);
              if (fadeInOn) af.push('afade=t=in:st=0:d=1');
              if (fadeOutOn && duration > 2) af.push(`afade=t=out:st=${Math.max(0, duration - 2).toFixed(2)}:d=2`);
              const runExport = (outputName, mimeType, tailArgs) => execFFmpeg({
                inputs: [{ name: 'in0', file }],
                buildArgs: (names, out) => {
                  const args = ['-i', names[0], '-t', String(duration), '-vn'];
                  if (af.length) args.push('-af', af.join(','));
                  return [...args, ...tailArgs, out];
                },
                outputName,
                mimeType,
                onProgress: (pct) => {
                  progressFill.style.width = pct + '%';
                  progressText.textContent = `${labels.workingLabel} ${pct}%`;
                },
              });
              if (target.fmt === 'mp3') {
                blob = await runExport('out.mp3', 'audio/mpeg', ['-b:a', '192k', '-f', 'mp3']);
              } else if (target.fmt === 'ogg') {
                // Same libopus-24kHz-first, libvorbis-fallback pattern as encodeOgg() above --
                // duplicated here (not routed through encodeOgg) because there's no decoded
                // buffer to pre-resample with Web Audio in this no-preview branch, so the
                // resample has to happen inside ffmpeg's own -ar flag instead.
                try {
                  blob = await runExport('out.ogg', 'audio/ogg', ['-ar', '24000', '-c:a', 'libopus', '-b:a', '48k']);
                } catch (e) {
                  blob = await runExport('out.ogg', 'audio/ogg', ['-c:a', 'libvorbis', '-b:a', '96k']);
                }
              } else if (target.fmt === 'm4r') {
                blob = await runExport('out.m4a', 'audio/mp4', ['-c:a', 'aac', '-b:a', '192k']);
              } else {
                blob = await runExport('out.wav', 'audio/wav', []);
              }
              // Every click here reprocesses the original (possibly large) file from scratch --
              // drop the instance afterward so a second target click starts memory-fresh too.
              resetFFmpeg();
            }

            const base = `${(file.name.replace(/\.[^.]+$/, '') || 'ringtone')}-${target.key}`;
            finishProgress(labels.doneLabel);
            downloadBlob(blob, `${base}.${target.fmt}`);
            const guideText = labels.targetGuides && labels.targetGuides[target.key];
            if (ringtoneGuide && guideText) {
              ringtoneGuide.textContent = guideText;
              ringtoneGuide.classList.add('on');
            }
          } catch (e) {
            showError(e && e.message ? e.message : String(e));
            hideProgress();
          }
          targetsEl.querySelectorAll('.target').forEach((b) => { b.disabled = false; });
        });
      });
    }
  }
</script>

<script>
  // Доля закраски дорожки. Держим её в --fill, а рисует её CSS (см. audio-tool.css).
  // Слушаем на документе, потому что ползунки создаются и пересоздаются по ходу работы
  // инструментов -- вешать обработчик на каждый пришлось бы в трёх десятках мест.
  (() => {
    const красить = (i) => {
      if (!i || i.type !== 'range' || i.classList.contains('eq-slider')) return;
      if ((i.getAttribute('style') || '').includes('vertical')) return;
      const min = Number(i.min || 0), max = Number(i.max || 100);
      const d = max - min;
      i.style.setProperty('--fill', (d > 0 ? ((Number(i.value) - min) / d) * 100 : 0) + '%');
    };
    const всё = () => document.querySelectorAll('.audio-tool input[type=range]').forEach(красить);
    document.addEventListener('input', (e) => красить(e.target), true);
    document.addEventListener('change', (e) => красить(e.target), true);
    // Первая покраска и повторная после появления новых ползунков.
    document.addEventListener('DOMContentLoaded', всё);
    всё();
    new MutationObserver(всё).observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>

<script>
  // Ряд кнопок вместо выпадающего списка. Спрятанный список остаётся хранилищем значения --
  // его читает вся остальная работа инструмента, поэтому здесь только ставим value и подаём
  // change, ровно как сделал бы человек мышью.
  (() => {
    const row = document.getElementById('ctrl-select');
    if (!row || !row.classList.contains('presets')) return;
    const кнопки = () => [...row.querySelectorAll('.preset-btn')];
    const отметить = (знач) => kнопкиОтметить(знач);
    function kнопкиОтметить(знач) {
      кнопки().forEach((x) => {
        const он = x.dataset.chip === знач;
        x.classList.toggle('active', он);
        x.setAttribute('aria-checked', он ? 'true' : 'false');
      });
      // Расшифровка под кнопками: выбранная строка ярче остальных.
      document.querySelectorAll('.chip-hint').forEach((h) => {
        h.classList.toggle('is-on', h.dataset.hint === знач);
      });
    }
    // Ряд кнопок ОТДАЁТ значение сам, как это делал список. Благодаря этому все места, где
    // сила читается (их восемь), остались нетронутыми -- они по-прежнему берут .value у
    // элемента с именем ctrl-select. Скрытого дубля в странице при этом нет.
    // Выбранной по умолчанию может быть НЕ первая кнопка: на «моно в стерео» порядок
    // кнопок повторяет расположение (левый -- оба -- правый), а по умолчанию нужен средний.
    // Берём ту, что помечена разметкой, и только если такой нет -- первую.
    const поумолч = кнопки().find((x) => x.classList.contains('active')) || кнопки()[0];
    let выбрано = поумолч && поумолч.dataset ? поумолч.dataset.chip : '';
    kнопкиОтметить(выбрано); // подсветить выбранное СРАЗУ, не дожидаясь первого нажатия
    Object.defineProperty(row, 'value', {
      get: () => выбрано,
      set: (v) => { выбрано = v == null ? '' : String(v); отметить(выбрано); },
      configurable: true,
    });
    row.addEventListener('click', (e) => {
      const b = e.target.closest('.preset-btn');
      if (!b) return;
      // Повторное нажатие на выбранную кнопку СНИМАЕТ выбор -- так просил владелец.
      выбрано = b.classList.contains('active') ? '' : b.dataset.chip;
      отметить(выбрано);
      // Оба события: одни места слушают input, другие change -- как у настоящего списка.
      row.dispatchEvent(new Event('input', { bubbles: true }));
      row.dispatchEvent(new Event('change', { bubbles: true }));
    });
  })();
</script>

