    ['#ctrl-fadein', '#ctrl-fadeout', '#ctrl-select', '#ctrl-duration', '#ctrl-cutout', '#ctrl-samplerate', '#ctrl-channels', '#ctrl-normalize', '#ctrl-silence-start', '#ctrl-silence-end'].forEach((sel) => {
