---
import playerCss from '../styles/player.css?inline';
import css from '../styles/audio-tool.css?inline';
// One component drives every audio tool. `AUDIO_TOOLS[tool].engine` picks the processing path:
// 'webaudio' (native Web Audio API, waveform + live preview, no ffmpeg download at all),
// 'webaudio-merge' / 'webaudio-generator' (variants without a single decoded source buffer),
// or 'ffmpeg' for the few things that genuinely need it (real format transcoding, video
// demux/mux, spectral denoise). See src/lib/audio-tools-config.js and project-architecture
// memory for why this split exists -- most tools moved off ffmpeg specifically so they could
// show a waveform and let the user listen to the result before downloading.
import { AUDIO_TOOLS } from '../lib/audio-tools-config.js';
import AdSlot from './AdSlot.astro';

interface Props {
  tool: string;
  locale: string;
  labels: Record<string, string>;
}

const { tool, locale, labels } = Astro.props;
const config = AUDIO_TOOLS[tool];
const controls = config.controls;
const isGenerator = controls === 'generator';
// Noise has no input file at all: no drop zone, no file chip, nothing to swap -- and no waveform,
// because what plays is a short loop repeating, not a track with a position in it.
const isNoise = controls === 'noise';
// The dictaphone has no file to drop either -- its input is the microphone. Everything after the
// recording exists (waveform, info strip, export bar) is identical to a loaded file, so it reuses
// the same path rather than growing a parallel one.
const isRecorder = controls === 'recorder';
// Generator/merge tools now also show a waveform, just of the RESULT (post-generate/post-merge)
// rather than an uploaded source -- the markup renders for them too, hidden by default until
// the first render (see the client script), instead of never existing at all.
// Batch mode (multiple files at once) has a file list instead -- a single preview bar/waveform
// doesn't map cleanly onto "several files queued for conversion".
const showWaveform = !config.allowBatch && !config.noWaveform && !isNoise;
// Trimming is a capability, not a kind of tool: the recorder wants the handles too, so it asks
// for them by config instead of being added to a growing list of control names here.
const showTrimHandles = controls === 'trim' || controls === 'ringtone-targets' || !!config.trimSelection;
const isFfmpeg = config.engine === 'ffmpeg';
const isRingtoneTargets = controls === 'ringtone-targets';
const accept = config.accept || 'audio/*';
const targetNames = isRingtoneTargets ? labels.targetNames || {} : {};

// Tools with their own transport + export bar (config.downloadFormats) don't want the old
// generic Process/Listen button -- keyed off that capability rather than a list of control
// names, which is what let it linger on three pages after only one was excluded by name.
// Generator and merge have nothing to export until they've produced something, so they keep an
// action button even though they now have an export bar. Every other tool renders on demand from
// a file that's already loaded, which leaves a "Process" step with no work of its own to do.
// Кнопка "сделай уже" нужна там, где до неё нечего показать и нечего играть. У микшера её
// больше нет: микс считается сам при загрузке файлов и пересчитывается при каждом движении
// ползунка громкости, а пуск/пауза/стоп живут в обычном ряду управления под волной.
const needsRenderAction = isGenerator || (controls === 'multi-file' && !config.perFileVolume);
const showListenBtn = !isFfmpeg && !isRingtoneTargets && !config.report && ((!config.downloadFormats && !config.splitFormats) || needsRenderAction);
// Формат и действие в один ряд -- то же правило, что у остальных инструментов (див. .deck ниже).
// Инструменты на ffmpeg с выпадающим списком до сих пор рисовали формат отдельной строкой во всю
// ширину, а кнопку -- следующей строкой под ней, с подписью "СОХРАНИТЬ КАК" над списком. Обе эти
// вещи владелец сайта просил убрать, и они были убраны -- но только у инструментов с exportDeck,
// а сюда правка не доехала: шумоподавление и улучшение звука остались со старым видом.
const deckFfmpeg = isFfmpeg && controls === 'select' && !!config.formats && !isRingtoneTargets;
const showRunBtn = isFfmpeg && !isRingtoneTargets && !deckFfmpeg;
const showAddBtn = controls === 'multi-file' || !!config.allowBatch;
const showControlsRow = showListenBtn || showRunBtn || showAddBtn;

// One icon family for the whole tool: 24x24 grid, no fill, 2px round-capped strokes -- the same
// language the drop-zone arrow was already drawn in. Before this the page mixed a colour emoji
// (the file chip), two text glyphs typed straight into the markup (x and the download arrow),
// a solid SVG triangle and two browser-drawn select chevrons, so five different visual systems
// shared one screen. Download and "another file" are deliberately mirror images of each other:
// same tray, arrow reversed, so the pair reads as in/out at a glance.
// The play/pause glyph stays solid on purpose -- it sits inside a filled green disc, where a
// hairline outline would disappear. Solid on solid, outlined on flat.
// Only the markup-rendered icon lives here; wave/close/upload are drawn into the file chip by
// the client script, which has its own copies (it can't reach this scope).
const ICO = {
  download: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5M12 15V3"/>',
};
---

{/* The component's stylesheet is imported as a string and written out here, rather
    than left as an Astro <style> block. Astro attaches a page's styles by walking what
    the page module imports, not what it renders, so one route file importing all the
    tool components put every component's CSS into every page -- an identical 47 KB
    everywhere, of which a calculator page used almost none. As a plain string it lands
    only on the page that renders this component. It goes first, before any markup, so
    nothing is ever painted unstyled. */}
<style is:inline set:html={playerCss + css}></style>

<div class="audio-tool" data-tool={tool} data-locale={locale} data-labels={JSON.stringify(labels)}>
  {!isGenerator && !isNoise && !isRecorder && (
    <>
      <div class="drop" id="audio-drop">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5M12 15V3"/></svg>
        <div class="big">{labels.dropLabel}</div>
        <div class="small">{accept.startsWith('video') ? labels.dropHintVideo : labels.dropHint}</div>
        {config.allowBatch && (
          <div class="small">
            {(labels.batchLimitLabel || 'Up to {n} files, {mb} MB combined.')
              .replace('{n}', config.maxBatchFiles).replace('{mb}', config.maxBatchMB)}
          </div>
        )}
        {/* Which files are actually accepted. Every audio tool here reads its input through
            ffmpeg (directly, or as a fallback when the browser's own decoder refuses), so the
            list is the same everywhere and video files work too -- their audio track is used. */}
        {!accept.startsWith('video') && <div class="small formats">{labels.dropFormatsLabel}</div>}
      </div>
      {accept.startsWith('video') ? (
        <input type="file" id="audio-file-input" accept={accept} multiple={controls === 'multi-file' || config.allowBatch}>
      ) : (
        // No `accept` for audio inputs -- with accept="audio/*", iOS Safari's file picker
        // sheet often hides audio files the OS doesn't recognize by that MIME filter, so
        // people genuinely can't select a file that's right there. Matches LeebTTS's own
        // audio-tool inputs (checked live), which drop `accept` entirely for this reason and
        // keep it only where it's not causing that problem (video-to-audio, above).
        <input type="file" id="audio-file-input" multiple={controls === 'multi-file' || config.allowBatch}>
      )}
    </>
  )}

  {/* Метка нужна разметке: у инструментов со сценариями переключатель "оригинал/результат"
      и кнопка "улучшить" стоят на десктопе В ОДНОЙ строке -- кнопка по центру страницы,
      переключатель у правого края. Обернуть их общим блоком нельзя: переключатель общий
      для нескольких инструментов и живёт выше по разметке. */}
  <div class={config.presetCards ? "panel has-presets" : "panel"} id="audio-panel">
    {(controls === 'multi-file' || config.allowBatch) && <div class="filelist" id="audio-filelist"></div>}
    {controls !== 'multi-file' && controls !== 'generator' && !isNoise && !config.allowBatch && !config.compactPreview && <div class="fileinfo" id="audio-fileinfo"></div>}

    {showWaveform && config.simplePreview && (
      <div class="wave-shell simple-preview" id="wave-shell">
        <svg class="simple-preview-ico" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        <span class="simple-preview-text">{labels.simplePreviewLabel}</span>
        <div class="playhead" id="playhead"></div>
      </div>
    )}
    {showWaveform && config.compactPreview && (
      <div class="wave-shell compact" id="wave-shell">
        {/* Имя файла -- верхняя строка ТОЙ ЖЕ панели, а не отдельная плашка над ней. Зелёная
            заливка убрана: она была самым громким пятном на странице, хотя несла наименее
            важное. Подтверждением загрузки служит сама волна -- она появилась, значит файл
            прочитан; это сигнал сильнее любого цвета. Размер оттуда убран, он есть ниже как
            SIZE, и в одних единицах, а не 0.4 MB против 366 KB. */}
        <div class="fileinfo" id="audio-fileinfo"></div>
        {/* Отдельная область под волну: бегунок и подсказка отсчитываются от неё, а не от всей
            панели. Пока они лежали прямо в панели, бегунок протыкал строку с именем файла --
            он растянут сверху донизу, а панель теперь начинается с этой строки. */}
        <div class="wave-area" id="wave-area">
          <canvas id="wave-canvas"></canvas>
          {config.fadeRegions && <div class="fade-region fade-region-in" id="fade-region-in"></div>}
          {config.fadeRegions && <div class="fade-region fade-region-out" id="fade-region-out"></div>}
          <div class="playhead" id="playhead"></div>
          {/* Подсказка при наведении: показывает, в какую секунду попадёт нажатие. Без неё по
              волне можно кликать, но человек об этом не догадывается и не видит, куда целится. */}
          <div class="wave-guide" id="wave-guide"></div>
          <div class="wave-tip" id="wave-tip"></div>
        </div>
      </div>
    )}
    {/* Управление вынесено из-под волны наружу. Внутри оболочки кнопка занимала левый край --
        на телефоне это была половина ширины волны, -- и мешала там, где волна рабочая
        поверхность: ровно на левом крае живёт ручка выделения. Общая длительность не
        дублируется: она уже написана в строке сведений о файле ниже. */}
    {/* Ряд управления был убран у микшера, когда играть было нечего: готового микса не
        существовало до нажатия кнопки, и кнопки стояли заблокированными. Теперь микс считается
        сразу при загрузке файлов, играть есть что с первой секунды -- и ряд вернулся. */}
    {showWaveform && config.compactPreview && (
      <div class="transport" id="transport">
        <button type="button" class="tp-btn tp-play" id="wave-play-btn" disabled aria-label={labels.playLabel}>
          <svg class="ico" id="wave-play-ico" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </button>
        <button type="button" class="tp-btn tp-stop" id="wave-stop-btn" disabled aria-label={labels.stopLabel}>
          <svg viewBox="0 0 24 24" fill="currentColor"><rect x="7" y="7" width="10" height="10" rx="2"/></svg>
        </button>
        {/* Время появляется только когда есть что показывать -- в покое у кнопок пусто. */}
        <span class="tp-time" id="transport-cur" hidden>0:00</span>
        <span class="tp-total" id="transport-dur" hidden>0:00</span>
        <span class="wave-duration" id="wave-duration" hidden>0:00</span>
        {/* Сведения о файле переехали в тот же ряд: на десктопе там свободно 848px при нужных
            620, и панель становится одним предметом вместо панели и отдельной строки под ней.
            На узком экране свободно 270px -- туда они не помещаются и переносятся на вторую
            строку ВНУТРИ той же панели, так что предмет остаётся один. */}
        <div class="file-meta" id="file-meta" style="display:none"></div>
      </div>
    )}
    {showWaveform && !config.simplePreview && !config.compactPreview && (
      <div class="wave-shell" id="wave-shell">
        <canvas id="wave-canvas"></canvas>
        {showTrimHandles && (
          <div class="sel-overlay" id="sel-overlay">
            <svg class="move-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8L22 12L18 16"/><path d="M6 8L2 12L6 16"/><path d="M2 12H22"/></svg>
          </div>
        )}
        {showTrimHandles && <div class="handle" id="h-start"></div>}
        {showTrimHandles && <div class="handle" id="h-end"></div>}
        <div class="playhead" id="playhead"></div>
        {/* Черта за мышью и время под курсором. У этого вида волны их не было вовсе -- поэтому
            на склейке не работали ни подсказка, ни нажатие по дорожке: обработчики цепляются
            за область волны, а её здесь не существовало. Владелец говорил об этом трижды. */}
        <div class="wave-guide" id="wave-guide"></div>
        <div class="wave-tip" id="wave-tip"></div>
      </div>
    )}
    {/* Progress sits directly under the waveform, where the thing it reports on is happening.
        It used to live at the very bottom of the page, far below the fold on every tool, which
        meant "reading the file…" and processing progress were effectively invisible. */}
    <div class="progress" id="audio-progress">
      <div class="progress-bar"><div class="progress-fill" id="audio-progress-fill"></div></div>
      <div class="progress-text" id="audio-progress-text"></div>
    </div>
    {config.abCompare && (
      <div class="ab-pill" id="ab-compare" style="display:none">
        <button type="button" class="ab-pill-seg active" id="ab-original-btn" data-which="original">{labels.abOriginalLabel}</button>
        <button type="button" class="ab-pill-seg" id="ab-result-btn" data-which="result" disabled>{labels.abResultLabel}</button>
      </div>
    )}
    {/* Gated on the compact player rather than on abCompare -- the file-info strip belongs to
        every tool using the new layout, and tying it to the A/B switch made it vanish from the
        speed tool the moment that switch was removed. */}
    {(config.noWaveform || controls === 'trim') && !config.compactPreview && (
      <div class="file-meta" id="file-meta" style="display:none"></div>
    )}
    {showTrimHandles && (
      /* The play button lives in the times row rather than in a button bar further down: it
         previews the selection the numbers describe, so it belongs beside them. Trim's preview
         is the exact thing that gets downloaded -- fades and cut-out included -- which is what
         made the old separate "Process" step redundant. */
      <div class="times" id="times">
        {controls === 'trim' && (
          <button type="button" class="wave-play-btn times-play" id="listen-sel-btn" aria-label={labels.listenSelectionLabel}>
            <svg class="ico" id="listen-sel-ico" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
        )}
        <span>{labels.startLabel}: <b id="t-start">0:00.0</b></span>
        <span id="t-len-wrap">{labels.durationLabel}: <b id="t-len">0:00.0</b></span>
        <span>{labels.endLabel}: <b id="t-end">0:00.0</b></span>
      </div>
    )}
    {showTrimHandles && controls !== 'recorder' && (
      <div class="row">
        <div class="field">
          <label for="in-start">{labels.startSecLabel}</label>
          <input type="number" id="in-start" min="0" step="0.1" value="0">
        </div>
        <div class="field">
          <label for="in-end">{labels.endSecLabel}</label>
          <input type="number" id="in-end" min="0" step="0.1" value="0">
        </div>
      </div>
    )}

    {controls === 'convert' && (
      <div class="row">
        <div class="field">
          <label for="ctrl-format">{labels.formatLabel}</label>
          <select id="ctrl-format">
            {(config.formats || ['mp3', 'm4a', 'm4r', 'wav', 'ogg', 'flac']).map((f) => (
              <option value={f}>{f.toUpperCase()}</option>
            ))}
          </select>
        </div>
        <div class="field" id="bitrate-field">
          <label for="ctrl-bitrate">{labels.bitrateLabel}</label>
          <select id="ctrl-bitrate">
            <option value="320">320 kbps</option>
            <option value="256">256 kbps</option>
            <option value="192" selected>192 kbps</option>
            <option value="128">128 kbps</option>
            <option value="96">96 kbps</option>
          </select>
        </div>
      </div>
    )}
    {controls === 'convert' && labels.formatHints && (
      <div class="format-hint" id="format-hint">{labels.formatHints[config.formats ? config.formats[0] : 'mp3']}</div>
    )}
    {controls === 'convert' && config.advancedConvert && (
      <div class="row">
        <div class="field">
          <label for="ctrl-samplerate">{labels.sampleRateLabel}</label>
          <select id="ctrl-samplerate">
            <option value="auto" selected>{labels.autoLabel}</option>
            <option value="22050">22,050 Hz</option>
            <option value="44100">44,100 Hz</option>
            <option value="48000">48,000 Hz</option>
            <option value="96000">96,000 Hz</option>
          </select>
        </div>
        <div class="field">
          <label for="ctrl-channels">{labels.channelsLabel}</label>
          <select id="ctrl-channels">
            <option value="auto" selected>{labels.autoLabel}</option>
            <option value="1">{labels.channelMonoLabel}</option>
            <option value="2">{labels.channelStereoLabel}</option>
          </select>
        </div>
      </div>
    )}
    {controls === 'convert' && config.showNormalize && (
      <div class="checks">
        <label class="check"><input type="checkbox" id="ctrl-normalize"> {labels.normalizeCheckLabel}</label>
      </div>
    )}

    {controls === 'slider' && (
      <div class="field slider-field">
        <label for="ctrl-slider">{labels[config.sliderLabel]}: <span id="ctrl-slider-val">{config.sliderDefault}{config.sliderUnit}</span></label>
        <input type="range" id="ctrl-slider" min={config.sliderMin} max={config.sliderMax} step={config.sliderStep || 1} value={config.sliderDefault}>
      </div>
    )}
    {controls === 'slider' && config.presets && (
      <div class="presets" id="presets-row">
        {config.presets.map((p) => <button type="button" class="preset-btn" data-preset={p.key}>{labels[p.label] || p.key}</button>)}
      </div>
    )}

    {controls === 'select' && !config.presetCards && !config.selectAsChips && (
      <div class="field">
        <label for="ctrl-select">{labels[config.selectLabel]}</label>
        <select id="ctrl-select">
          {config.selectOptions.map((o) => <option value={o.value}>{labels[o.label] || o.label}</option>)}
        </select>
      </div>
    )}
    {/* Тот же выбор рядом кнопок -- и БЕЗ спрятанного списка рядом. Скрытый дубль убран по
        требованию владельца: невидимого в странице быть не должно, его видят читалки экрана
        и сканеры. Ряд кнопок САМ носит имя ctrl-select и сам отдаёт значение (в коде ниже ему
        заведено свойство value), поэтому все восемь мест, где сила читается, не менялись.
        Для читалок это группа переключателей: role=radiogroup + role=radio + aria-checked. */}
    {controls === 'select' && !config.presetCards && config.selectAsChips && (
      <div class="field">
        <label id="ctrl-select-label">{labels[config.selectLabel]}</label>
        <div class="presets" id="ctrl-select" role="radiogroup" aria-labelledby="ctrl-select-label">
          {config.selectOptions.map((o, i) => (
            <button type="button" role="radio"
              aria-checked={o.value === (config.chipDefault || config.selectOptions[0].value) ? 'true' : 'false'}
              class={o.value === (config.chipDefault || config.selectOptions[0].value) ? 'preset-btn active' : 'preset-btn'}
              data-chip={o.value}
              aria-label={config.chipIcons ? (labels[o.label] || o.label) : undefined}
              title={config.chipIcons ? (labels[o.label] || o.label) : undefined}>
              {config.chipIcons && config.chipIcons[o.value]
                ? <Fragment set:html={config.chipIcons[o.value]} />
                : (labels[o.label] || o.label)}
            </button>
          ))}
        </div>
        {config.chipHints && (
          <dl class="chip-hints">
            {config.chipHints.map((h) => (
              <div class="chip-hint" data-hint={h.value}>
                <dt>{labels[h.label] || h.value}</dt>
                <dd>{labels[h.hint] || ''}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    )}
    {/* A tool that wants to say something about the file it was actually given -- "this is
        already mono", "this will throw away your right channel". Filled in after decode. */}
    {config.note && <div class="rate-note" id="tool-note" style="display:none"></div>}
    {controls === 'select' && config.presetCards && (
      <button type="button" class="act primary hero-btn" id="hero-auto-btn">
        ✨ <span class="hero-long">{labels.enhanceHeroLabel}</span><span class="hero-short">{labels.enhanceHeroShortLabel || labels.enhanceHeroLabel}</span>
      </button>
    )}
    {controls === 'select' && config.presetCards && (
      <div class="preset-or">{labels.enhanceOrPickLabel}</div>
    )}
    {controls === 'select' && config.presetCards && (
      <div class="preset-cards" id="preset-cards">
        {config.selectOptions.filter((o) => !o.hero).map((o) => (
          <button type="button" class="preset-card" data-value={o.value}>
            <span class="pc-emoji">{o.emoji}</span>
            <span class="pc-label">{labels[o.label] || o.label}</span>
          </button>
        ))}
        <input type="hidden" id="ctrl-select" value={config.selectOptions[0] ? config.selectOptions[0].value : ''}>
      </div>
    )}
    {controls === 'select' && config.presetCards && (
      <div class="preset-desc" id="preset-desc" style="display:none"></div>
    )}
    {/* No longer tied to preset cards: any select-driven ffmpeg tool that offers formats needs
        this, and gating it on cards is what kept denoise locked to MP3 -- so a WAV upload came
        back lossy for no reason anyone chose. */}
    {controls === 'select' && config.formats && (
      <div class={deckFfmpeg ? 'deck' : ''}>
        <div class={deckFfmpeg ? 'field field-fmt enhance-format-field' : 'field enhance-format-field'}>
          <label for="ctrl-format">{labels.enhanceFormatLabel}</label>
          <select id="ctrl-format">
            {config.formats.map((f) => <option value={f}>{f.toUpperCase()}</option>)}
          </select>
        </div>
        {deckFfmpeg && (
          <button type="button" class="act primary deck-act" id="audio-run-btn" disabled={config.abCompare ? true : undefined}>
            <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICO.download} />
