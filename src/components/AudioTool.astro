    async function ensureRendered() {
      if (!renderedBuffer) renderedBuffer = await doRender();
        syncResultWave();
      return renderedBuffer;
    }

    if (waveShell) {

      if (waveArea) {
        let scrubbing = false;
        let startX = 0;
        const scrubTo = (clientX) => {
          if (dur <= 0) return;
          const r = waveArea.getBoundingClientRect();
          const frac = Math.max(0, Math.min(1, (clientX - r.left) / r.width));
          setPlayheadFrac(frac);
          if (transportCurEl) { transportCurEl.textContent = fmtClock(frac * dur); transportCurEl.hidden = false; }
          return frac * dur;
        };
        waveArea.addEventListener('pointerdown', (e) => {
          if (dur <= 0 || e.button !== 0) return;
          startX = e.clientX;
          scrubbing = false;
          const move = (ev) => {
            if (!scrubbing && Math.abs(ev.clientX - startX) < 3) return;
            if (!scrubbing) { scrubbing = true; player.stop(); waveArea.setPointerCapture?.(ev.pointerId); }
            scrubTo(ev.clientX);
          };
          const up = (ev) => {
            document.removeEventListener('pointermove', move);
            document.removeEventListener('pointerup', up);
            if (!scrubbing) {

              const цель = e.target;
              if (цель && цель.closest && цель.closest('.sel-handle, .move-ico, .sel-overlay, button, .tp-btn, .handle')) return;
              const сек = scrubTo(ev.clientX);
              if (сек != null) waveSeekPos = сек;
              player.stop();
              if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PLAY; wavePlayIco.closest('.tp-btn')?.classList.remove('is-playing'); }
              return;
            }
            const сек2 = scrubTo(ev.clientX);
            if (сек2 != null) waveSeekPos = сек2;

            player.stop();
            if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PLAY; wavePlayIco.closest('.tp-btn')?.classList.remove('is-playing'); }
          };
          document.addEventListener('pointermove', move);
          document.addEventListener('pointerup', up);
        });
      }

      document.addEventListener('keydown', (e) => {
        if (e.code !== 'Space' && e.key !== ' ') return;
        const el = document.activeElement;
        if (el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT'
          || el.isContentEditable || el.tagName === 'BUTTON' || el.tagName === 'A')) return;
        const btn = wavePlayBtn;
        if (!btn || btn.disabled || dur <= 0) return;
        e.preventDefault();
        btn.click();
      });

      waveShell.addEventListener('click', async (e) => {

        const from = (sel) => (e.composedPath ? e.composedPath().some((n) => n.matches && n.matches(sel)) : false)
          || !!(e.target.closest && e.target.closest(sel));

        if (from('.handle') || from('.sel-overlay') || from('.wave-play-btn')
            || from('#wave-play-btn') || from('.tp-btn') || from('button')) return;
        if (dur <= 0) return;
        const t = px2t(e.clientX);
        player.unlock();
        player.stop();
        window.dispatchEvent(new Event('opitro:tool-interaction'));

        if (эл && эл.src && dur > 0) {
          try { эл.pause(); эл.currentTime = Math.max(0, Math.min(dur, t)); } catch (e) {}
          сброситьВид();
        }

        if (dur > 0) {

          waveSeekPos = t;
          setPlayheadFrac(Math.max(0, Math.min(1, t / dur)));
          if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PLAY; wavePlayIco.closest('.tp-btn')?.classList.remove('is-playing'); }
          if (typeof listenIco !== 'undefined' && listenIco) listenIco.innerHTML = ICO_PLAY;
          return;
        }

        if (config.controls === 'ringtone-targets') {
          if (!sourceBuffer || selEnd - selStart < 0.05) return;
          const seekTo = Math.max(selStart, Math.min(selEnd, t)) - selStart;
          let slice = sliceBuffer(sourceBuffer, selStart, selEnd);
          const rtVolumeEl2 = root.querySelector('#rt-volume');
          if (rtVolumeEl2) slice = scaleVolume(slice, Number(rtVolumeEl2.value) / 100);
          const chkFadeIn = root.querySelector('#chk-fadein');
          const chkFadeOut = root.querySelector('#chk-fadeout');
          if (chkFadeIn && chkFadeOut && (chkFadeIn.checked || chkFadeOut.checked)) {
            slice = await applyFade(slice, chkFadeIn.checked ? 1 : 0, chkFadeOut.checked ? 2 : 0);
          }
          if (listenSelIco) listenSelIco.innerHTML = ICO_PAUSE;
          player.play(
            slice,
            (frac) => {
              setPlayheadTime(selStart + (selEnd - selStart) * frac);
            },
            () => { if (listenSelIco) listenSelIco.innerHTML = ICO_PLAY; playhead.style.display = 'none'; player.reset(); },
            seekTo
          );
          return;
        }

        if (config.compactPreview || config.abCompare || LIVE_CHAIN_TOOLS[config.controls] || isRenderedAb) {
          if (!sourceBuffer) return;

          stopAB();
          waveSeekPos = t;
          setPlayheadTime(t);
          return;
        }

        if (config.engine === 'ffmpeg') {
          if (!sourceBuffer) return;
          const simpleIco = root.querySelector('.simple-preview-ico');
          if (simpleIco) simpleIco.innerHTML = ICO_PAUSE;
          player.play(
            sourceBuffer,
            (frac) => {
              setPlayheadTime(frac * dur);
            },
            () => {
              playhead.style.display = 'none';
              player.reset();
              if (simpleIco) simpleIco.innerHTML = ICO_PLAY;
            },
            t
          );
          return;
        }

        try {
          if (!renderedBuffer) {
            armProgress();
            progressText.textContent = labels.workingLabel;
            renderedBuffer = await doRender();
        syncResultWave();
            hideProgress();
            if (downloadRow) downloadRow.style.display = 'flex';
          }
        } catch (err) {
          hideProgress();
          return;
        }
        const base = config.controls === 'trim' ? selStart : 0;
        const range = config.controls === 'trim' ? (selEnd - selStart) : renderedBuffer.duration;
        const clamped = config.controls === 'trim' ? Math.max(selStart, Math.min(selEnd, t)) : t;
        const frac = range > 0 ? (clamped - base) / range : 0;
        const seekTo = Math.max(0, Math.min(renderedBuffer.duration, frac * renderedBuffer.duration));
        if (listenIco) listenIco.innerHTML = ICO_PAUSE;
        player.play(
          renderedBuffer,
          (frac2) => {
            setPlayheadTime(base + range * frac2);
          },
          () => { if (listenIco) listenIco.innerHTML = ICO_PLAY; playhead.style.display = 'none'; player.reset(); },
          seekTo
        );
      });
    }

    if (waveShell && (config.compactPreview || config.abCompare || LIVE_CHAIN_TOOLS[config.controls] || isRenderedAb)) {
      let scrubbing = false;
      const scrubTo = (clientX) => {
        if (dur <= 0) return;
        const t = px2t(clientX);
        waveSeekPos = t;
        setPlayheadTime(t);
      };
      const onScrubMove = (e) => {
        if (!scrubbing) return;
        e.preventDefault();
        scrubTo(e.touches ? e.touches[0].clientX : e.clientX);
      };
      const endScrub = () => {
        scrubbing = false;
        document.removeEventListener('mousemove', onScrubMove);
        document.removeEventListener('touchmove', onScrubMove);
        document.removeEventListener('mouseup', endScrub);
        document.removeEventListener('touchend', endScrub);
      };
      const startScrub = (e) => {
        if (e.target.closest('.wave-play-btn') || dur <= 0) return;
        scrubbing = true;
        stopAB();
        scrubTo(e.touches ? e.touches[0].clientX : e.clientX);
        document.addEventListener('mousemove', onScrubMove);
        document.addEventListener('touchmove', onScrubMove, { passive: false });
        document.addEventListener('mouseup', endScrub);
        document.addEventListener('touchend', endScrub);
      };
      waveShell.addEventListener('mousedown', startScrub);
      waveShell.addEventListener('touchstart', startScrub, { passive: true });
    }

    if (dlMp3Btn) {
      dlMp3Btn.addEventListener('click', async () => {
        clearError();
        try {
          const buf = await ensureRendered();
          const bitrate = config.mp3Bitrate ? config.mp3Bitrate(readParams()) : 192;
          const blob = await encodeMP3(buf, bitrate);
          const base = config.controls === 'generator' ? tool : config.controls === 'multi-file' ? 'merged' : (file.name.replace(/\.[^.]+$/, '') || 'audio');
          downloadBlob(blob, `${base}.mp3`);
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
        }
      });
    }
    if (dlWavBtn) {
      dlWavBtn.addEventListener('click', async () => {
        clearError();
        try {
          const buf = await ensureRendered();
          const blob = encodeWAV(buf);
          const base = config.controls === 'generator' ? tool : config.controls === 'multi-file' ? 'merged' : (file.name.replace(/\.[^.]+$/, '') || 'audio');
          downloadBlob(blob, `${base}.wav`);
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
        }
      });
    }

    let ffmpegBusy = false;

    async function runFfmpegProcess(download, extraParams, opts) {
        const auto = !!(opts && opts.auto);
        if (ffmpegBusy) return;
        if (config.allowBatch ? !files.length : !file) return;
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        clearError();
        ffmpegBusy = true;
        runBtn.disabled = true;
        if (presetCardsEl) presetCardsEl.querySelectorAll('.preset-card').forEach((c) => { c.disabled = true; });
        armProgress();
        progressFill.style.width = '0%';
        progressText.textContent = labels.preparingLabel;

        const params = Object.assign(readParams(), extraParams || {});
        let producedBlob;

        if (config.allowBatch) {
          const results = [];
          for (let i = 0; i < files.length; i++) {
            const f = files[i];
            progressText.textContent = `${labels.batchProcessingLabel || 'Processing'} ${i + 1}/${files.length}: ${f.name}`;
            try {
              const { outputName, mimeType, ext } = config.output(params);
              const blob = await execFFmpeg({
                inputs: [{ name: 'in0', file: f }],
                buildArgs: (inputNames, out) => config.buildArgs(inputNames, out, params),
                outputName,
                mimeType,

                onProgress: (pct) => {
                  progressFill.style.width = (((i + pct / 100) / files.length) * 100).toFixed(1) + '%';
                },
              });
              const base = f.name.replace(/\.[^.]+$/, '') || `file-${i + 1}`;
              results.push({ name: `${base}.${ext}`, blob });
            } catch (e) {
              showError(`${f.name}: ${e && e.message ? e.message : String(e)}`);
            }

            resetFFmpeg();
          }
          if (results.length) {
            if (results.length === 1) {
              downloadFfmpegBlob(results[0].blob, results[0].name);
            } else {
              progressText.textContent = labels.batchZippingLabel || 'Packing ZIP...';
              const { default: JSZip } = await import('jszip');
              const zip = new JSZip();
              results.forEach((r) => zip.file(r.name, r.blob));
              const zipBlob = await zip.generateAsync({ type: 'blob' });
              downloadFfmpegBlob(zipBlob, 'converted.zip');
            }
            finishProgress(labels.doneLabel);
            setRunLabel(labels[config.runLabel] || labels.processLabel);
          } else {
            hideProgress();
          }
          ffmpegBusy = false;
          runBtn.disabled = false;
          if (presetCardsEl) presetCardsEl.querySelectorAll('.preset-card').forEach((c) => { c.disabled = false; });
          return;
        }

        const { outputName, mimeType, ext } = config.output(params);
        try {
          const blob = await execFFmpeg({
            inputs: [{ name: 'in0', file }],
            buildArgs: (inputNames, out) => config.buildArgs(inputNames, out, params),
            outputName,
            mimeType,
            onProgress: (pct) => {
              progressFill.style.width = pct + '%';
              progressText.textContent = `${labels.workingLabel} ${pct}%`;
              if (progressHook) progressHook(pct);
            },
          });
          const base = file.name.replace(/\.[^.]+$/, '') || 'audio';
          finishProgress(download ? labels.doneLabel : (labels.previewDoneLabel || labels.doneLabel));
          setRunLabel(labels[config.runLabel] || labels.processLabel);
          runBtn.onclick = null;
          if (download) downloadFfmpegBlob(blob, `${base}.${ext}`);
          if (config.abCompare && abCompareEl) {
            lastResultBlob = blob;
            lastResultName = `${base}.${ext}`;
            lastResultPreset = params.value;
            try {
              lastResultBuffer = await decodeFile(new File([blob], 'result', { type: mimeType }));
              abCompareEl.style.display = 'flex';
              if (abResultBtn) abResultBtn.disabled = false;
              if (wavePlayBtn) wavePlayBtn.disabled = false;

              if (!auto) {
                abSelected = 'result';
                if (abOriginalBtn) abOriginalBtn.classList.remove('active');
                if (abResultBtn) abResultBtn.classList.add('active');

                продолжитьПослеПересчёта = null;
                waveSeekPos = null;
                playAB('result', lastResultBuffer);
              }
            } catch (e) {}
          }
          producedBlob = blob;
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
          hideProgress();
        }
        ffmpegBusy = false;

        runBtn.disabled = config.abCompare ? !lastResultBlob : false;
        if (presetCardsEl) presetCardsEl.querySelectorAll('.preset-card').forEach((c) => { c.disabled = false; });
        return producedBlob;
    }
    if (runBtn) {
      runBtn.addEventListener('click', () => {

        const currentPreset = root.querySelector('#ctrl-select')?.value ?? null;
        if (config.abCompare && lastResultBlob && currentPreset !== null && lastResultPreset === currentPreset) {
          downloadFfmpegBlob(lastResultBlob, lastResultName);
          return;
        }
        runFfmpegProcess(true);
      });
    }

    async function encodeOgg(clip) {
      const resampled = await resampleBuffer(clip, config.oggSampleRate || 24000);
      const wavBlob = encodeWAV(resampled);
      const wavFile = new File([wavBlob], 'clip.wav', { type: 'audio/wav' });
      const runExport = (buildArgs) => execFFmpeg({
        inputs: [{ name: 'in0', file: wavFile }],
        buildArgs,
        outputName: 'out.ogg',
        mimeType: 'audio/ogg',
        onProgress: (pct) => {
          progressFill.style.width = pct + '%';
          progressText.textContent = `${labels.workingLabel} ${pct}%`;
        },
      });
      try {
        return await runExport(config.buildOpusArgs);
      } catch (e) {
        return await runExport(config.buildOggVorbisArgs);
      }
    }

    async function encodeM4r(clip) {
      const wavBlob = encodeWAV(clip);
      const wavFile = new File([wavBlob], 'clip.wav', { type: 'audio/wav' });
      return execFFmpeg({
        inputs: [{ name: 'in0', file: wavFile }],
        buildArgs: (names, out) => config.buildAacArgs(names, out),
        outputName: 'out.m4a',
        mimeType: 'audio/mp4',
        onProgress: (pct) => {
          progressFill.style.width = pct + '%';
          progressText.textContent = `${labels.workingLabel} ${pct}%`;
        },
      });
    }

    if (targetsEl) {
      targetsEl.querySelectorAll('.target').forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (!file) return;
          player.unlock();
          window.dispatchEvent(new Event('opitro:tool-interaction'));
          const target = config.targets.find((t) => t.key === btn.dataset.key);
          clearError();
          if (ringtoneGuide) ringtoneGuide.classList.remove('on');
          targetsEl.querySelectorAll('.target').forEach((b) => { b.disabled = true; });
          armProgress();
          progressFill.style.width = '0%';
          progressText.textContent = labels.preparingLabel;

          const chkFadeIn = root.querySelector('#chk-fadein');
          const chkFadeOut = root.querySelector('#chk-fadeout');
          const rtVolume = root.querySelector('#rt-volume');
          const fadeInOn = chkFadeIn ? chkFadeIn.checked : false;
          const fadeOutOn = chkFadeOut ? chkFadeOut.checked : false;
          const volPct = rtVolume ? Number(rtVolume.value) : 100;
          const vol = (volPct / 100) * (target.louder ? 1.4 : 1);

          try {
            let blob;
            if (sourceBuffer) {

              let duration = selEnd - selStart;
              if (target.max && duration > target.max) duration = target.max;
              let clip = sliceBuffer(sourceBuffer, selStart, selStart + duration);
              clip = scaleVolume(clip, vol);
              if (fadeInOn || fadeOutOn) clip = await applyFade(clip, fadeInOn ? 1 : 0, fadeOutOn ? 2 : 0);
              if (target.fmt === 'mp3') {
                progressText.textContent = labels.workingLabel;
                blob = await encodeMP3(clip, 192);
              } else if (target.fmt === 'ogg') {
                progressText.textContent = labels.workingLabel;
                blob = await encodeOgg(clip);
              } else if (target.fmt === 'm4r') {
                progressText.textContent = labels.workingLabel;
                blob = await encodeM4r(clip);
              } else {
                blob = encodeWAV(clip);
              }
            } else {

              const duration = target.max || 30;
              progressText.textContent = labels.workingLabel;
              const af = [];
              if (vol !== 1) af.push(`volume=${vol.toFixed(2)}`);
              if (fadeInOn) af.push('afade=t=in:st=0:d=1');
              if (fadeOutOn && duration > 2) af.push(`afade=t=out:st=${Math.max(0, duration - 2).toFixed(2)}:d=2`);
              const runExport = (outputName, mimeType, tailArgs) => execFFmpeg({
                inputs: [{ name: 'in0', file }],
                buildArgs: (names, out) => {
                  const args = ['-i', names[0], '-t', String(duration), '-vn'];
                  if (af.length) args.push('-af', af.join(','));
                  return [...args, ...tailArgs, out];
                },
                outputName,
                mimeType,
                onProgress: (pct) => {
                  progressFill.style.width = pct + '%';
                  progressText.textContent = `${labels.workingLabel} ${pct}%`;
                },
              });
              if (target.fmt === 'mp3') {
                blob = await runExport('out.mp3', 'audio/mpeg', ['-b:a', '192k', '-f', 'mp3']);
              } else if (target.fmt === 'ogg') {

                try {
                  blob = await runExport('out.ogg', 'audio/ogg', ['-ar', '24000', '-c:a', 'libopus', '-b:a', '48k']);
                } catch (e) {
                  blob = await runExport('out.ogg', 'audio/ogg', ['-c:a', 'libvorbis', '-b:a', '96k']);
                }
              } else if (target.fmt === 'm4r') {
                blob = await runExport('out.m4a', 'audio/mp4', ['-c:a', 'aac', '-b:a', '192k']);
              } else {
                blob = await runExport('out.wav', 'audio/wav', []);
              }

              resetFFmpeg();
            }

            const base = `${(file.name.replace(/\.[^.]+$/, '') || 'ringtone')}-${target.key}`;
            finishProgress(labels.doneLabel);
            downloadBlob(blob, `${base}.${target.fmt}`);
            const guideText = labels.targetGuides && labels.targetGuides[target.key];
            if (ringtoneGuide && guideText) {
              ringtoneGuide.textContent = guideText;
              ringtoneGuide.classList.add('on');
            }
          } catch (e) {
            showError(e && e.message ? e.message : String(e));
            hideProgress();
          }
          targetsEl.querySelectorAll('.target').forEach((b) => { b.disabled = false; });
        });
      });
    }
  }
</script>

<script>

  (() => {
    const красить = (i) => {
      if (!i || i.type !== 'range' || i.classList.contains('eq-slider')) return;
      if ((i.getAttribute('style') || '').includes('vertical')) return;
      const min = Number(i.min || 0), max = Number(i.max || 100);
      const d = max - min;
      i.style.setProperty('--fill', (d > 0 ? ((Number(i.value) - min) / d) * 100 : 0) + '%');
    };
    const всё = () => document.querySelectorAll('.audio-tool input[type=range]').forEach(красить);
    document.addEventListener('input', (e) => красить(e.target), true);
    document.addEventListener('change', (e) => красить(e.target), true);

    document.addEventListener('DOMContentLoaded', всё);
    всё();
    new MutationObserver(всё).observe(document.documentElement, { childList: true, subtree: true });
  })();
</script>

<script>

  (() => {
    const row = document.getElementById('ctrl-select');
    if (!row || !row.classList.contains('presets')) return;
    const кнопки = () => [...row.querySelectorAll('.preset-btn')];
    const отметить = (знач) => kнопкиОтметить(знач);
    function kнопкиОтметить(знач) {
      кнопки().forEach((x) => {
        const он = x.dataset.chip === знач;
        x.classList.toggle('active', он);
        x.setAttribute('aria-checked', он ? 'true' : 'false');
      });

      document.querySelectorAll('.chip-hint').forEach((h) => {
        h.classList.toggle('is-on', h.dataset.hint === знач);
      });
    }

    const поумолч = кнопки().find((x) => x.classList.contains('active')) || кнопки()[0];
    let выбрано = поумолч && поумолч.dataset ? поумолч.dataset.chip : '';
    kнопкиОтметить(выбрано);
    Object.defineProperty(row, 'value', {
      get: () => выбрано,
      set: (v) => { выбрано = v == null ? '' : String(v); отметить(выбрано); },
      configurable: true,
    });
    row.addEventListener('click', (e) => {
      const b = e.target.closest('.preset-btn');
      if (!b) return;

      выбрано = b.classList.contains('active') ? '' : b.dataset.chip;
      отметить(выбрано);

      row.dispatchEvent(new Event('input', { bubbles: true }));
      row.dispatchEvent(new Event('change', { bubbles: true }));
    });
  })();
</script>
