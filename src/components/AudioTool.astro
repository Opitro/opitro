              const range = trimmed ? (selEnd - selStart) : renderedBuffer.duration;
              setPlayheadTime(base + range * frac);
            },
            () => { listenIco.innerHTML = ICO_PLAY; playhead.style.display = 'none'; player.reset(); },

            (() => { const p = waveSeekPos; waveSeekPos = null; return p == null ? undefined : p; })()
          );
