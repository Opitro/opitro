---
// One component drives every audio tool. `AUDIO_TOOLS[tool].engine` picks the processing path:
// 'webaudio' (native Web Audio API, waveform + live preview, no ffmpeg download at all),
// 'webaudio-merge' / 'webaudio-generator' (variants without a single decoded source buffer),
// or 'ffmpeg' for the few things that genuinely need it (real format transcoding, video
// demux/mux, spectral denoise). See src/lib/audio-tools-config.js and project-architecture
// memory for why this split exists -- most tools moved off ffmpeg specifically so they could
// show a waveform and let the user listen to the result before downloading.
import { AUDIO_TOOLS } from '../lib/audio-tools-config.js';
import AdSlot from './AdSlot.astro';

interface Props {
  tool: string;
  locale: string;
  labels: Record<string, string>;
}

const { tool, locale, labels } = Astro.props;
const config = AUDIO_TOOLS[tool];
const controls = config.controls;
const isGenerator = controls === 'generator';
// Generator/merge tools now also show a waveform, just of the RESULT (post-generate/post-merge)
// rather than an uploaded source -- the markup renders for them too, hidden by default until
// the first render (see the client script), instead of never existing at all.
// Batch mode (multiple files at once) has a file list instead -- a single preview bar/waveform
// doesn't map cleanly onto "several files queued for conversion".
const showWaveform = !config.allowBatch;
const showTrimHandles = controls === 'trim' || controls === 'ringtone-targets';
const isFfmpeg = config.engine === 'ffmpeg';
const isRingtoneTargets = controls === 'ringtone-targets';
const accept = config.accept || 'audio/*';
const targetNames = isRingtoneTargets ? labels.targetNames || {} : {};
---

<div class="audio-tool" data-tool={tool} data-locale={locale} data-labels={JSON.stringify(labels)}>
  {!isGenerator && (
    <>
      <div class="drop" id="audio-drop">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5M12 15V3"/></svg>
        <div class="big">{labels.dropLabel}</div>
        <div class="small">{accept.startsWith('video') ? labels.dropHintVideo : labels.dropHint}</div>
        {config.allowBatch && (
          <div class="small">
            {(labels.batchLimitLabel || 'Up to {n} files, {mb} MB combined.')
              .replace('{n}', config.maxBatchFiles).replace('{mb}', config.maxBatchMB)}
          </div>
        )}
      </div>
      {accept.startsWith('video') ? (
        <input type="file" id="audio-file-input" accept={accept} multiple={controls === 'multi-file' || config.allowBatch}>
      ) : (
        // No `accept` for audio inputs -- with accept="audio/*", iOS Safari's file picker
        // sheet often hides audio files the OS doesn't recognize by that MIME filter, so
        // people genuinely can't select a file that's right there. Matches LeebTTS's own
        // audio-tool inputs (checked live), which drop `accept` entirely for this reason and
        // keep it only where it's not causing that problem (video-to-audio, above).
        <input type="file" id="audio-file-input" multiple={controls === 'multi-file' || config.allowBatch}>
      )}
    </>
  )}

  <div class="panel" id="audio-panel">
    {(controls === 'multi-file' || config.allowBatch) && <div class="filelist" id="audio-filelist"></div>}
    {controls !== 'multi-file' && controls !== 'generator' && !config.allowBatch && <div class="fileinfo" id="audio-fileinfo"></div>}

    {showWaveform && config.simplePreview && (
      <div class="wave-shell simple-preview" id="wave-shell">
        <svg class="simple-preview-ico" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        <span class="simple-preview-text">{labels.simplePreviewLabel}</span>
        <div class="playhead" id="playhead"></div>
      </div>
    )}
    {showWaveform && !config.simplePreview && (
      <div class="wave-shell" id="wave-shell">
        <canvas id="wave-canvas"></canvas>
        {showTrimHandles && (
          <div class="sel-overlay" id="sel-overlay">
            <svg class="move-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8L22 12L18 16"/><path d="M6 8L2 12L6 16"/><path d="M2 12H22"/></svg>
          </div>
        )}
        {showTrimHandles && <div class="handle" id="h-start"></div>}
        {showTrimHandles && <div class="handle" id="h-end"></div>}
        <div class="playhead" id="playhead"></div>
      </div>
    )}
    {showTrimHandles && (
      <div class="times" id="times">
        <span>{labels.startLabel}: <b id="t-start">0:00.0</b></span>
        <span id="t-len-wrap">{labels.durationLabel}: <b id="t-len">0:00.0</b></span>
        <span>{labels.endLabel}: <b id="t-end">0:00.0</b></span>
      </div>
    )}
    {showTrimHandles && (
      <div class="row">
        <div class="field">
          <label for="in-start">{labels.startSecLabel}</label>
          <input type="number" id="in-start" min="0" step="0.1" value="0">
        </div>
        <div class="field">
          <label for="in-end">{labels.endSecLabel}</label>
          <input type="number" id="in-end" min="0" step="0.1" value="0">
        </div>
      </div>
    )}

    {controls === 'convert' && (
      <div class="row">
        <div class="field">
          <label for="ctrl-format">{labels.formatLabel}</label>
          <select id="ctrl-format">
            {(config.formats || ['mp3', 'm4a', 'm4r', 'wav', 'ogg', 'flac']).map((f) => (
              <option value={f}>{f.toUpperCase()}</option>
            ))}
          </select>
        </div>
        <div class="field" id="bitrate-field">
          <label for="ctrl-bitrate">{labels.bitrateLabel}</label>
          <select id="ctrl-bitrate">
            <option value="320">320 kbps</option>
            <option value="256">256 kbps</option>
            <option value="192" selected>192 kbps</option>
            <option value="128">128 kbps</option>
            <option value="96">96 kbps</option>
          </select>
        </div>
      </div>
    )}
    {controls === 'convert' && labels.formatHints && (
      <div class="format-hint" id="format-hint">{labels.formatHints[config.formats ? config.formats[0] : 'mp3']}</div>
    )}
    {controls === 'convert' && config.advancedConvert && (
      <div class="row">
        <div class="field">
          <label for="ctrl-samplerate">{labels.sampleRateLabel}</label>
          <select id="ctrl-samplerate">
            <option value="auto" selected>{labels.autoLabel}</option>
            <option value="22050">22,050 Hz</option>
            <option value="44100">44,100 Hz</option>
            <option value="48000">48,000 Hz</option>
            <option value="96000">96,000 Hz</option>
          </select>
        </div>
        <div class="field">
          <label for="ctrl-channels">{labels.channelsLabel}</label>
          <select id="ctrl-channels">
            <option value="auto" selected>{labels.autoLabel}</option>
            <option value="1">{labels.channelMonoLabel}</option>
            <option value="2">{labels.channelStereoLabel}</option>
          </select>
        </div>
      </div>
    )}
    {controls === 'convert' && config.showNormalize && (
      <div class="checks">
        <label class="check"><input type="checkbox" id="ctrl-normalize"> {labels.normalizeCheckLabel}</label>
      </div>
    )}

    {controls === 'slider' && (
      <div class="field slider-field">
        <label for="ctrl-slider">{labels[config.sliderLabel]}: <span id="ctrl-slider-val">{config.sliderDefault}{config.sliderUnit}</span></label>
        <input type="range" id="ctrl-slider" min={config.sliderMin} max={config.sliderMax} step={config.sliderStep || 1} value={config.sliderDefault}>
      </div>
    )}
    {controls === 'slider' && config.showMeter && (
      <>
        <div class="meter" id="peak-meter"><div class="meter-fill" id="peak-meter-fill"></div></div>
        <div class="times" id="peak-meter-label" style="display:none"><span id="peak-meter-text"></span></div>
      </>
    )}
    {(controls === 'slider' || controls === 'eq3') && config.presets && (
      <div class="presets" id="presets-row">
        {config.presets.map((p) => <button type="button" class="preset-btn" data-preset={p.key}>{labels[p.label] || p.key}</button>)}
      </div>
    )}

    {controls === 'select' && (
      <div class="field">
        <label for="ctrl-select">{labels[config.selectLabel]}</label>
        <select id="ctrl-select">
          {config.selectOptions.map((o) => <option value={o.value}>{labels[o.label] || o.label}</option>)}
        </select>
      </div>
    )}

    {controls === 'eq3' && (
      <div class="row eq-row">
        <div class="field slider-field">
          <label for="eq-bass">{labels.bassLabel}: <span id="eq-bass-val">0dB</span></label>
          <input type="range" id="eq-bass" min="-12" max="12" step="1" value="0">
        </div>
        <div class="field slider-field">
          <label for="eq-mid">{labels.midLabel}: <span id="eq-mid-val">0dB</span></label>
          <input type="range" id="eq-mid" min="-12" max="12" step="1" value="0">
        </div>
        <div class="field slider-field">
          <label for="eq-treble">{labels.trebleLabel}: <span id="eq-treble-val">0dB</span></label>
          <input type="range" id="eq-treble" min="-12" max="12" step="1" value="0">
        </div>
      </div>
    )}

    {(controls === 'fade' || controls === 'trim') && (
      <div class="row">
        <div class="field">
          <label for="ctrl-fadein">{labels.fadeInLabel}</label>
          <input type="number" id="ctrl-fadein" min="0" max="30" value={controls === 'trim' ? 0 : 2}>
        </div>
        <div class="field">
          <label for="ctrl-fadeout">{labels.fadeOutLabel}</label>
          <input type="number" id="ctrl-fadeout" min="0" max="30" value={controls === 'trim' ? 0 : 2}>
        </div>
      </div>
    )}
    {controls === 'trim' && (
      <div class="checks">
        <label class="check"><input type="checkbox" id="ctrl-cutout"> {labels.cutOutCheckLabel}</label>
      </div>
    )}

    {controls === 'generator' && (
      <div class="field">
        <label for="ctrl-duration">{labels.durationLabel}</label>
        <input type="number" id="ctrl-duration" min="1" max={config.durationMax || 3600} value={config.durationDefault || 60}>
      </div>
    )}

    {isRingtoneTargets && (
      <div class="field slider-field">
        <label for="rt-volume">{labels.volumeLabel}: <span id="rt-volume-val">100%</span></label>
        <input type="range" id="rt-volume" min="10" max="300" step="10" value="100">
      </div>
    )}
    {isRingtoneTargets && (
      <div class="checks">
        <label class="check"><input type="checkbox" id="chk-fadein"> {labels.fadeInCheckLabel}</label>
        <label class="check"><input type="checkbox" id="chk-fadeout"> {labels.fadeOutCheckLabel}</label>
      </div>
    )}
    {isRingtoneTargets && (
      <div class="controls" style="margin-bottom:16px">
        <button class="act" id="listen-sel-btn">
          <svg class="ico" id="listen-sel-ico" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          <span id="listen-sel-label">{labels.listenSelectionLabel}</span>
        </button>
        <button class="act" id="audio-new-btn">{labels.newFileLabel}</button>
      </div>
    )}
    {isRingtoneTargets && <AdSlot />}
    {isRingtoneTargets && (
      <>
        <div class="targets-title">{labels.targetsTitle}</div>
        <div class="targets" id="targets">
          {config.targets.map((t) => (
            <button class="target" data-key={t.key}>
              <span class="t-emoji">{t.emoji}</span>
              <span class="t-name">{targetNames[t.key] || t.name}</span>
              <span class="t-fmt">{t.fmt.toUpperCase()}</span>
            </button>
          ))}
        </div>
      </>
    )}

    <div class="controls">
      {!isFfmpeg && !isRingtoneTargets && (
        <button class="act" id="audio-listen-btn" disabled={!isGenerator}>
          <svg class="ico" id="listen-ico" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          <span id="listen-label">{isGenerator ? labels.generateLabel : labels.processLabel}</span>
        </button>
      )}
      {isFfmpeg && !isRingtoneTargets && <button class="act primary" id="audio-run-btn">{labels[config.runLabel] || labels.processLabel}</button>}
      {!isGenerator && !isRingtoneTargets && controls !== 'multi-file' && !config.allowBatch && <button class="act" id="audio-new-btn">{labels.newFileLabel}</button>}
      {(controls === 'multi-file' || config.allowBatch) && <button class="act" id="audio-add-btn">{labels.addFileLabel}</button>}
    </div>

    {!isRingtoneTargets && <AdSlot />}

    {!isFfmpeg && (
      <div class="controls" id="download-row" style="display:none">
        <button class="act primary" id="dl-mp3-btn">{labels.downloadMp3Label}</button>
        <button class="act" id="dl-wav-btn">{labels.downloadWavLabel}</button>
      </div>
    )}

    {isRingtoneTargets && <div class="guide" id="ringtone-guide"></div>}

    <div class="progress" id="audio-progress">
      <div class="progress-bar"><div class="progress-fill" id="audio-progress-fill"></div></div>
      <div class="progress-text" id="audio-progress-text"></div>
    </div>

    <div class="err" id="audio-err"></div>
  </div>
</div>

<script>
  import { AUDIO_TOOLS } from '../lib/audio-tools-config.js';
  import { execFFmpeg, downloadBlob as downloadFfmpegBlob, loadFFmpeg, resetFFmpeg } from '../lib/audio-engine.js';
  import {
    decodeFile, drawWaveform, renderEffect, encodeWAV, encodeMP3, downloadBlob, createPlayer, sliceBuffer, applyFade, scaleVolume, resampleBuffer,
  } from '../lib/web-audio-engine.js';

  const MAX_MB = 1024;
  const WARN_MB = 150;
  const MAX_RINGTONE_SEC = 40;
  const root = document.querySelector('.audio-tool');
  if (root) {
    const tool = root.dataset.tool;
    const config = AUDIO_TOOLS[tool];
    const labels = JSON.parse(root.dataset.labels);

    const drop = root.querySelector('#audio-drop');
    const fileInput = root.querySelector('#audio-file-input');
    const panel = root.querySelector('#audio-panel');
    const fileInfo = root.querySelector('#audio-fileinfo');
    const fileList = root.querySelector('#audio-filelist');
    const waveShell = root.querySelector('#wave-shell');
    const waveCanvas = root.querySelector('#wave-canvas');
    const inStart = root.querySelector('#in-start');
    const inEnd = root.querySelector('#in-end');
    const selOverlay = root.querySelector('#sel-overlay');
    const hStart = root.querySelector('#h-start');
    const hEnd = root.querySelector('#h-end');
    const playhead = root.querySelector('#playhead');
    const tStart = root.querySelector('#t-start');
    const tEnd = root.querySelector('#t-end');
    const tLen = root.querySelector('#t-len');
    const listenBtn = root.querySelector('#audio-listen-btn');
    const listenIco = root.querySelector('#listen-ico');
    const listenLabel = root.querySelector('#listen-label');
    const listenSelBtn = root.querySelector('#listen-sel-btn');
    const listenSelIco = root.querySelector('#listen-sel-ico');
    const targetsEl = root.querySelector('#targets');
    const ringtoneGuide = root.querySelector('#ringtone-guide');
    const runBtn = root.querySelector('#audio-run-btn');
    const newBtn = root.querySelector('#audio-new-btn');
    const addBtn = root.querySelector('#audio-add-btn');
    const downloadRow = root.querySelector('#download-row');
    const dlMp3Btn = root.querySelector('#dl-mp3-btn');
    const dlWavBtn = root.querySelector('#dl-wav-btn');
    const progress = root.querySelector('#audio-progress');
    const progressFill = root.querySelector('#audio-progress-fill');
    const progressText = root.querySelector('#audio-progress-text');
    const errBox = root.querySelector('#audio-err');

    let file = null;
    let files = [];
    let sourceBuffer = null;
    let renderedBuffer = null;
    let dur = 0;
    let selStart = 0;
    let selEnd = 0;
    const player = createPlayer();
    const ICO_PLAY = '<path d="M8 5v14l11-7z"/>';
    const ICO_PAUSE = '<rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/>';

    function showError(message) {
      errBox.textContent = message;
      errBox.classList.add('show');
    }
    function clearError() {
      errBox.classList.remove('show');
    }
    function fmtTime(s) {
      const m = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      const d = Math.floor((s * 10) % 10);
      return `${m}:${String(sec).padStart(2, '0')}.${d}`;
    }

    function invalidateRender() {
      renderedBuffer = null;
      if (downloadRow) downloadRow.style.display = 'none';
      player.reset();
      if (listenIco) listenIco.innerHTML = ICO_PLAY;
      if (listenLabel) listenLabel.textContent = isGeneratorLabel();
      if (playhead) playhead.style.display = 'none';
    }
    function isGeneratorLabel() {
      return config.controls === 'generator' ? labels.generateLabel : labels.processLabel;
    }

    function escapeHtml(s) {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    function renderFileList() {
      fileList.innerHTML = files.map((f, i) => `<div class="filelist-item"><button type="button" class="filelist-play" data-index="${i}" aria-label="${labels.listenSelectionLabel || 'Listen'}"><svg class="ico" viewBox="0 0 24 24" fill="currentColor">${ICO_PLAY}</svg></button><span>${i + 1}. <b>${escapeHtml(f.name)}</b> · ${(f.size / 1048576).toFixed(1)} MB</span><button type="button" class="filelist-remove" data-index="${i}" aria-label="${labels.removeFileLabel || 'Remove'}">×</button></div>`).join('');
    }
    // Per-file preview in the multi-file list (merge, batch convert) -- decodes only when
    // tapped, not up front for every file, since a batch can be up to 20 files at 1GB each.
    const fileBuffers = new Map();
    let filePlayingIndex = -1;
    function setFilePlayIcon(idx, playing) {
      const svg = fileList.querySelector(`.filelist-play[data-index="${idx}"] svg`);
      if (svg) svg.innerHTML = playing ? ICO_PAUSE : ICO_PLAY;
    }
    if (fileList) {
      fileList.addEventListener('click', async (e) => {
        const removeBtn = e.target.closest('.filelist-remove');
        if (removeBtn) {
          files.splice(Number(removeBtn.dataset.index), 1);
          renderFileList();
          invalidateRender();
          filePlayingIndex = -1;
          if (!files.length) {
            panel.classList.remove('on');
            if (drop) drop.style.display = '';
            if (listenBtn) listenBtn.disabled = true;
          }
          return;
        }
        const playBtn = e.target.closest('.filelist-play');
        if (!playBtn) return;
        const idx = Number(playBtn.dataset.index);
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        player.unlock();
        if (filePlayingIndex === idx && player.isPlaying()) {
          player.pause();
          setFilePlayIcon(idx, false);
          filePlayingIndex = -1;
          return;
        }
        player.stop();
        if (filePlayingIndex >= 0) setFilePlayIcon(filePlayingIndex, false);
        filePlayingIndex = idx;
        setFilePlayIcon(idx, true);
        try {
          const f = files[idx];
          let buf = fileBuffers.get(f);
          if (!buf) {
            buf = await decodeFile(f);
            fileBuffers.set(f, buf);
          }
          if (filePlayingIndex !== idx) return;
          player.play(buf, () => {}, () => {
            setFilePlayIcon(idx, false);
            if (filePlayingIndex === idx) filePlayingIndex = -1;
          });
        } catch (err) {
          setFilePlayIcon(idx, false);
          if (filePlayingIndex === idx) filePlayingIndex = -1;
          showError(labels.decodeErrorLabel);
        }
      });
    }

    function updateSel() {
      if (!waveShell) return;
      const W = waveShell.clientWidth;
      const x1 = (selStart / dur) * W;
      const x2 = (selEnd / dur) * W;
      if (selOverlay) { selOverlay.style.left = x1 + 'px'; selOverlay.style.width = (x2 - x1) + 'px'; }
      if (hStart) hStart.style.left = (x1 - 7) + 'px';
      if (hEnd) hEnd.style.left = (x2 - 7) + 'px';
      if (tStart) tStart.textContent = fmtTime(selStart);
      if (tEnd) tEnd.textContent = fmtTime(selEnd);
      if (tLen) tLen.textContent = fmtTime(selEnd - selStart);
      if (inStart) inStart.value = selStart.toFixed(1);
      if (inEnd) inEnd.value = selEnd.toFixed(1);
    }

    // Some containers (certain iPhone .MOV exports, some odd MP4 variants) fail the browser's
    // native decodeAudioData -- that used to fail silently on the ffmpeg-engine path and show
    // a generic error on the webaudio path, in both cases leaving the waveform/preview dead
    // even though the file itself was perfectly readable. Falling back to ffmpeg (which reads
    // raw bytes, not a browser codec) to transcode to WAV first makes decoding effectively
    // universal -- WAV always decodes cleanly afterwards.
    //
    // IMPORTANT: when the fallback runs, it REPLACES the module-level `file` with the small
    // decoded WAV (via the caller reassigning `file = ...` -- see pickFile below), so any
    // later ffmpeg export (e.g. clicking a ringtone target tile) processes that small WAV
    // instead of re-running ffmpeg on the original raw video a second time. Running ffmpeg.wasm
    // twice on a large video back-to-back is what caused a real "Out of bounds memory access"
    // crash on mobile Safari -- its WASM heap is tighter than desktop and didn't survive it.
    async function decodeFileRobust(f) {
      try {
        return { buffer: await decodeFile(f), replacementFile: null };
      } catch (e) {
        const blob = await execFFmpeg({
          inputs: [{ name: 'probe_in', file: f }],
          // Explicit codec/sample-rate/channel-count, not ffmpeg's implicit default -- if the
          // source's audio track happens to be something decodeAudioData can't handle (or
          // ffmpeg's default WAV muxing choice varies), leaving the format implicit meant the
          // SECOND decode (of ffmpeg's own output) could fail too. Forcing plain 16-bit PCM
          // stereo at 44.1kHz is about as universally decodable as a WAV can be.
          buildArgs: (names, out) => ['-i', names[0], '-vn', '-acodec', 'pcm_s16le', '-ar', '44100', '-ac', '2', out],
          outputName: 'probe_out.wav',
          mimeType: 'audio/wav',
        });
        // Done with ffmpeg for this large file -- drop the now memory-inflated instance so any
        // later export (e.g. an OGG ringtone target) starts from a fresh, right-sized one.
        resetFFmpeg();
        const wavFile = new File([blob], (f.name.replace(/\.[^.]+$/, '') || 'decoded') + '.wav', { type: 'audio/wav' });
        return { buffer: await decodeFile(wavFile), replacementFile: wavFile };
      }
    }

    async function pickFile(f) {
      clearError();
      if (f.size > MAX_MB * 1024 * 1024) {
        showError(`File is larger than ${MAX_MB} MB.`);
        return;
      }
      if (config.controls === 'multi-file' || config.allowBatch) {
        if (config.allowBatch) {
          const maxFiles = config.maxBatchFiles || 20;
          const maxBatchMB = config.maxBatchMB || 2048;
          if (files.length >= maxFiles) {
            showError((labels.batchTooManyLabel || 'Max {n} files per batch.').replace('{n}', maxFiles));
            return;
          }
          const totalMB = (files.reduce((s, x) => s + x.size, 0) + f.size) / 1048576;
          if (totalMB > maxBatchMB) {
            showError((labels.batchTooLargeLabel || 'Batch total exceeds {n} MB.').replace('{n}', maxBatchMB));
            return;
          }
        }
        files.push(f);
        renderFileList();
        invalidateRender();
        panel.classList.add('on');
        if (drop) drop.style.display = 'none';
        if (files.length >= 1 && listenBtn) listenBtn.disabled = false;
        return;
      }
      file = f;
      const sizeMB = f.size / 1048576;
      fileInfo.innerHTML = `<b>${f.name}</b> · ${sizeMB.toFixed(1)} MB`;
      if (sizeMB > WARN_MB) {
        fileInfo.innerHTML += `<br><span style="color:#ffb020;font-size:12px;">${labels.largeFileWarningLabel}</span>`;
      }
      panel.classList.add('on');
      if (drop) drop.style.display = 'none';

      if (config.engine === 'ffmpeg') {
        loadFFmpeg().catch(() => {});
        // Was gated on waveCanvas existing -- that broke the simple-preview tools entirely
        // (no canvas there, so this whole decode step, and with it sourceBuffer/dur, never ran
        // at all -- confirmed live: "Listen" did nothing). Gate on waveShell instead, which
        // exists for both the canvas and simple-preview variants; only the draw call itself
        // needs the canvas.
        if (waveShell) {
          try {
            const decoded = await decodeFileRobust(f);
            sourceBuffer = decoded.buffer;
            if (decoded.replacementFile) file = decoded.replacementFile;
            dur = sourceBuffer.duration;
            selStart = 0;
            selEnd = config.controls === 'ringtone-targets' ? Math.min(dur, MAX_RINGTONE_SEC) : dur;
            if (inStart) inStart.max = dur;
            if (inEnd) inEnd.max = dur;
            if (waveCanvas) drawWaveform(waveCanvas, sourceBuffer);
            updateSel();
          } catch (e) {
            // The waveform is a nice-to-have preview, not a requirement -- the Convert tool
            // never needed a successful browser decode to run ffmpeg directly on the raw file,
            // and it works fine even for files this same decode step can't handle. Ringtone
            // shouldn't be any more fragile than that: no waveform, but still make the file.
            sourceBuffer = null;
            dur = 0;
            if (waveShell) waveShell.style.display = 'none';
            const timesEl = root.querySelector('#times');
            if (timesEl) timesEl.style.display = 'none';
            const inputsRow = inStart ? inStart.closest('.row') : null;
            if (inputsRow) inputsRow.style.display = 'none';
            showError(labels.noPreviewLabel || labels.decodeErrorLabel);
          }
        }
        return;
      }

      try {
        const decoded = await decodeFileRobust(f);
        sourceBuffer = decoded.buffer;
        if (decoded.replacementFile) file = decoded.replacementFile;
        dur = sourceBuffer.duration;
        selStart = 0;
        selEnd = dur;
        if (inStart) inStart.max = dur;
        if (inEnd) inEnd.max = dur;
        drawWaveform(waveCanvas, sourceBuffer);
        updateSel();
        if (listenBtn) listenBtn.disabled = false;
        invalidateRender();
      } catch (e) {
        showError(labels.decodeErrorLabel);
      }
    }

    // Generator tools (white noise, pink noise) have no file to drop -- pickFile(), the only
    // place that reveals .panel, never runs for them. Confirmed live: the page was genuinely
    // blank (no duration field, no Generate button) until this.
    if (config.controls === 'generator') panel.classList.add('on');
    // No result yet to show a waveform of -- revealResultWaveform() un-hides this once
    // generate/merge actually produces a buffer.
    if ((config.controls === 'generator' || config.controls === 'multi-file') && waveShell) {
      waveShell.style.display = 'none';
    }

    if (drop) {
      drop.addEventListener('click', () => fileInput.click());
      drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
      drop.addEventListener('dragleave', () => drop.classList.remove('over'));
      drop.addEventListener('drop', (e) => {
        e.preventDefault();
        drop.classList.remove('over');
        Array.from(e.dataTransfer.files).forEach(pickFile);
      });
    }
    if (fileInput) {
      fileInput.addEventListener('change', (e) => {
        Array.from(e.target.files).forEach(pickFile);
        fileInput.value = '';
      });
    }
    if (newBtn) newBtn.addEventListener('click', () => fileInput.click());
    if (addBtn) addBtn.addEventListener('click', () => fileInput.click());

    window.addEventListener('resize', () => { if (sourceBuffer && waveCanvas) { drawWaveform(waveCanvas, sourceBuffer); updateSel(); } });

    // Drag handles for trim-style tools.
    let dragging = null;
    let moveStartT = 0;
    let moveSelStart = 0;
    let moveSelEnd = 0;
    function px2t(clientX) {
      const r = waveShell.getBoundingClientRect();
      const x = Math.max(0, Math.min(r.width, clientX - r.left));
      return (x / r.width) * dur;
    }
    function maxSelLen() {
      return config.controls === 'ringtone-targets' ? MAX_RINGTONE_SEC : Infinity;
    }
    function onDrag(e) {
      if (!dragging) return;
      const cx = e.touches ? e.touches[0].clientX : e.clientX;
      const t = px2t(cx);
      const maxLen = maxSelLen();
      if (dragging === 'move') {
        const delta = t - moveStartT;
        const len = moveSelEnd - moveSelStart;
        let newStart = moveSelStart + delta;
        newStart = Math.max(0, Math.min(dur - len, newStart));
        selStart = newStart;
        selEnd = newStart + len;
      } else {
        if (dragging === 'start') selStart = Math.min(t, selEnd - 0.1);
        else selEnd = Math.max(t, selStart + 0.1);
        selStart = Math.max(0, selStart);
        selEnd = Math.min(dur, selEnd);
        if (selEnd - selStart > maxLen) {
          if (dragging === 'start') selStart = selEnd - maxLen;
          else selEnd = selStart + maxLen;
        }
      }
      updateSel();
      invalidateRender();
    }
    function endDrag() {
      dragging = null;
      document.removeEventListener('mousemove', onDrag);
      document.removeEventListener('touchmove', onDrag);
      document.removeEventListener('mouseup', endDrag);
      document.removeEventListener('touchend', endDrag);
    }
    function startDrag(which) {
      return (e) => {
        e.preventDefault();
        dragging = which;
        if (which === 'move') {
          const cx = e.touches ? e.touches[0].clientX : e.clientX;
          moveStartT = px2t(cx);
          moveSelStart = selStart;
          moveSelEnd = selEnd;
        }
        document.addEventListener('mousemove', onDrag);
        document.addEventListener('touchmove', onDrag, { passive: false });
        document.addEventListener('mouseup', endDrag);
        document.addEventListener('touchend', endDrag);
      };
    }
    if (hStart) { hStart.addEventListener('mousedown', startDrag('start')); hStart.addEventListener('touchstart', startDrag('start'), { passive: false }); }
    if (hEnd) { hEnd.addEventListener('mousedown', startDrag('end')); hEnd.addEventListener('touchstart', startDrag('end'), { passive: false }); }
    if (selOverlay) {
      selOverlay.style.cursor = 'grab';
      selOverlay.style.pointerEvents = 'auto';
      selOverlay.addEventListener('mousedown', startDrag('move'));
      selOverlay.addEventListener('touchstart', startDrag('move'), { passive: false });
    }

    // Typed start/end (seconds) -- kept in sync both ways with the drag handles, matching
    // LeebTTS's editor exactly instead of leaving the selection drag-only.
    if (inStart) {
      inStart.addEventListener('input', () => {
        if (!dur) return;
        let v = parseFloat(inStart.value) || 0;
        v = Math.max(0, Math.min(v, selEnd - 0.1));
        v = Math.max(v, selEnd - maxSelLen());
        selStart = v;
        updateSel();
        invalidateRender();
      });
    }
    if (inEnd) {
      inEnd.addEventListener('input', () => {
        if (!dur) return;
        let v = parseFloat(inEnd.value) || 0;
        v = Math.max(selStart + 0.1, Math.min(v, dur));
        v = Math.min(v, selStart + maxSelLen());
        selEnd = v;
        updateSel();
        invalidateRender();
      });
    }

    // "Listen to selection" -- plays just the selected slice directly (no render step), with
    // click-anywhere-in-the-selection seeking, matching the ringtone/trim editor pattern.
    if (listenSelBtn) {
      listenSelBtn.addEventListener('click', async () => {
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        if (player.isPlaying()) {
          player.pause();
          listenSelIco.innerHTML = ICO_PLAY;
          return;
        }
        player.unlock();
        if (!sourceBuffer || selEnd - selStart < 0.05) return;
        listenSelIco.innerHTML = ICO_PAUSE;
        let slice = sliceBuffer(sourceBuffer, selStart, selEnd);
        const rtVolumeEl2 = root.querySelector('#rt-volume');
        if (rtVolumeEl2) slice = scaleVolume(slice, Number(rtVolumeEl2.value) / 100);
        const chkFadeIn = root.querySelector('#chk-fadein');
        const chkFadeOut = root.querySelector('#chk-fadeout');
        if (chkFadeIn && chkFadeOut && (chkFadeIn.checked || chkFadeOut.checked)) {
          slice = await applyFade(slice, chkFadeIn.checked ? 1 : 0, chkFadeOut.checked ? 2 : 0);
        }
        player.play(
          slice,
          (frac) => {
            const t = selStart + (selEnd - selStart) * frac;
            const W = waveShell.clientWidth;
            playhead.style.left = ((t / dur) * W) + 'px';
            playhead.style.display = 'block';
          },
          () => { listenSelIco.innerHTML = ICO_PLAY; playhead.style.display = 'none'; player.reset(); }
        );
      });
    }
    // format/bitrate: hide bitrate field for lossless formats
    const fmtSel = root.querySelector('#ctrl-format');
    const bitrateField = root.querySelector('#bitrate-field');
    const formatHint = root.querySelector('#format-hint');
    if (fmtSel && bitrateField) {
      fmtSel.addEventListener('change', () => {
        bitrateField.style.display = ['wav', 'flac', 'aiff'].includes(fmtSel.value) ? 'none' : '';
        if (formatHint && labels.formatHints) formatHint.textContent = labels.formatHints[fmtSel.value] || '';
      });
    }

    const slider = root.querySelector('#ctrl-slider');
    const sliderVal = root.querySelector('#ctrl-slider-val');
    if (slider && sliderVal) {
      slider.addEventListener('input', () => {
        sliderVal.textContent = slider.value + (config.sliderUnit || '');
        invalidateRender();
      });
    }
    const rtVolumeEl = root.querySelector('#rt-volume');
    const rtVolumeVal = root.querySelector('#rt-volume-val');
    if (rtVolumeEl && rtVolumeVal) {
      rtVolumeEl.addEventListener('input', () => { rtVolumeVal.textContent = rtVolumeEl.value + '%'; });
    }
    ['bass', 'mid', 'treble'].forEach((band) => {
      const el = root.querySelector(`#eq-${band}`);
      const valEl = root.querySelector(`#eq-${band}-val`);
      if (el && valEl) el.addEventListener('input', () => { valEl.textContent = el.value + 'dB'; invalidateRender(); });
    });
    ['#ctrl-fadein', '#ctrl-fadeout', '#ctrl-select', '#ctrl-duration', '#ctrl-cutout', '#ctrl-samplerate', '#ctrl-channels', '#ctrl-normalize'].forEach((sel) => {
      const el = root.querySelector(sel);
      if (el) el.addEventListener('input', invalidateRender);
    });

    // Preset quick-pick buttons (compress bitrate targets, EQ genre presets, etc.) -- each
    // just writes into the same slider/eq inputs the user could set by hand, so no separate
    // render path is needed.
    const presetsRow = root.querySelector('#presets-row');
    if (presetsRow && config.presets) {
      presetsRow.querySelectorAll('.preset-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const preset = config.presets.find((p) => p.key === btn.dataset.preset);
          if (!preset) return;
          Object.entries(preset.set).forEach(([key, val]) => {
            const id = key === 'value' ? '#ctrl-slider' : `#eq-${key}`;
            const el = root.querySelector(id);
            const valEl = root.querySelector(id + '-val');
            if (!el) return;
            el.value = val;
            if (valEl) valEl.textContent = val + (key === 'value' ? (config.sliderUnit || '') : 'dB');
          });
          invalidateRender();
        });
      });
    }

    function readParams() {
      const params = {};
      const get = (id) => root.querySelector(id);
      if (get('#ctrl-format')) params.format = get('#ctrl-format').value;
      if (get('#ctrl-bitrate')) params.bitrate = get('#ctrl-bitrate').value;
      if (get('#ctrl-slider')) params.value = Number(get('#ctrl-slider').value);
      if (get('#ctrl-select')) params.value = get('#ctrl-select').value;
      if (get('#eq-bass')) params.bass = Number(get('#eq-bass').value);
      if (get('#eq-mid')) params.mid = Number(get('#eq-mid').value);
      if (get('#eq-treble')) params.treble = Number(get('#eq-treble').value);
      if (get('#ctrl-fadein')) params.fadeIn = get('#ctrl-fadein').value;
      if (get('#ctrl-fadeout')) params.fadeOut = get('#ctrl-fadeout').value;
      if (get('#chk-fadein')) params.fadeIn = get('#chk-fadein').checked;
      if (get('#chk-fadeout')) params.fadeOut = get('#chk-fadeout').checked;
      if (get('#ctrl-duration')) params.duration = Number(get('#ctrl-duration').value);
      if (get('#ctrl-samplerate')) params.sampleRate = get('#ctrl-samplerate').value;
      if (get('#ctrl-channels')) params.channels = get('#ctrl-channels').value;
      if (get('#ctrl-normalize')) params.normalize = get('#ctrl-normalize').checked;
      if (get('#ctrl-cutout')) params.cutOut = get('#ctrl-cutout').checked;
      if (config.controls === 'trim' || config.controls === 'ringtone-targets') { params.start = selStart; params.end = selEnd; }
      return params;
    }

    function animatePlayhead() {
      if (!player.isPlaying()) { playhead.style.display = 'none'; return; }
      requestAnimationFrame(animatePlayhead);
    }

    // Peak/clip meter (volume tool only) -- there was no feedback before about how close (or
    // past) the boosted signal gets to clipping.
    const peakMeter = root.querySelector('#peak-meter');
    const peakMeterFill = root.querySelector('#peak-meter-fill');
    const peakMeterLabel = root.querySelector('#peak-meter-label');
    const peakMeterText = root.querySelector('#peak-meter-text');
    function updateMeter(buffer) {
      if (!config.showMeter || !peakMeter || !buffer) return;
      let peak = 0;
      for (let c = 0; c < buffer.numberOfChannels; c++) {
        const d = buffer.getChannelData(c);
        for (let i = 0; i < d.length; i += 8) peak = Math.max(peak, Math.abs(d[i]));
      }
      peakMeter.classList.add('on');
      if (peakMeterLabel) peakMeterLabel.style.display = '';
      const pct = Math.min(100, peak * 100);
      peakMeterFill.style.width = pct + '%';
      const clipping = peak >= 0.999;
      peakMeterFill.classList.toggle('clip', clipping);
      if (peakMeterText) {
        const db = peak > 0 ? (20 * Math.log10(peak)).toFixed(1) : '-inf';
        peakMeterText.textContent = clipping
          ? (labels.peakClippingLabel || 'Clipping!')
          : `${labels.peakLabel || 'Peak'}: ${db} dB`;
      }
    }

    async function doRender() {
      const params = readParams();
      if (config.engine === 'webaudio-generator') {
        const sr = 44100;
        const length = Math.max(1, Math.round((params.duration || config.durationDefault) * sr));
        const out = new AudioBuffer({ numberOfChannels: 1, length, sampleRate: sr });
        const data = out.getChannelData(0);
        if (config.color === 'white') {
          for (let i = 0; i < length; i++) data[i] = Math.random() * 2 - 1;
        } else {
          let b0 = 0, b1 = 0, b2 = 0;
          for (let i = 0; i < length; i++) {
            const white = Math.random() * 2 - 1;
            b0 = 0.99886 * b0 + white * 0.0555179;
            b1 = 0.99332 * b1 + white * 0.0750759;
            b2 = 0.96900 * b2 + white * 0.1538520;
            data[i] = (b0 + b1 + b2 + white * 0.1848) * 0.2;
          }
        }
        // A short fade-out so the noise doesn't just cut off abruptly at the end -- there was
        // no shaping at all before, every generated clip ended in an audible hard stop.
        const foSamples = Math.min(length, Math.round(sr * 1.5));
        for (let i = 0; i < foSamples; i++) data[length - 1 - i] *= i / foSamples;
        revealResultWaveform(out);
        return out;
      }
      if (config.engine === 'webaudio-merge') {
        const buffers = await Promise.all(files.map((f) => decodeFile(f)));
        const sr = buffers[0].sampleRate;
        const ch = Math.max(...buffers.map((b) => b.numberOfChannels));
        // 80ms crossfade at each join -- plain back-to-back concatenation (the old behavior)
        // has an audible click/edit at every seam.
        const xfade = Math.min(Math.round(sr * 0.08), ...buffers.map((b) => Math.floor(b.length / 4)));
        const totalLen = buffers.reduce((sum, b) => sum + b.length, 0) - xfade * Math.max(0, buffers.length - 1);
        const out = new AudioBuffer({ numberOfChannels: ch, length: Math.max(1, totalLen), sampleRate: sr });
        for (let c = 0; c < ch; c++) {
          const dst = out.getChannelData(c);
          let offset = 0;
          buffers.forEach((b, idx) => {
            const src = b.getChannelData(Math.min(c, b.numberOfChannels - 1));
            for (let i = 0; i < src.length; i++) {
              let w = 1;
              if (idx > 0 && i < xfade) w = i / xfade;
              if (idx < buffers.length - 1 && i >= src.length - xfade) w *= (src.length - i) / xfade;
              dst[offset + i] += src[i] * w;
            }
            offset += src.length - (idx < buffers.length - 1 ? xfade : 0);
          });
        }
        revealResultWaveform(out);
        return out;
      }
      return renderEffect(sourceBuffer, {
        render: config.render,
        directRender: config.directRender,
        params,
        outputSampleRate: config.outputSampleRate ? config.outputSampleRate(params) : undefined,
        outputChannels: config.outputChannels,
      });
    }

    // Generator/merge tools have no uploaded source to show a waveform of upfront -- draw one
    // of the RESULT the first time it's available (post-generate / post-merge), matching the
    // "listen before download" pattern the rest of the tools already have.
    function revealResultWaveform(buffer) {
      if (!waveShell || !waveCanvas) return;
      dur = buffer.duration;
      waveShell.style.display = '';
      drawWaveform(waveCanvas, buffer);
    }

    if (listenBtn) {
      listenBtn.addEventListener('click', async () => {
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        if (player.isPlaying()) {
          player.pause();
          listenIco.innerHTML = ICO_PLAY;
          return;
        }
        player.unlock();
        clearError();
        try {
          if (!renderedBuffer) {
            listenBtn.disabled = true;
            progress.classList.add('on');
            progressText.textContent = labels.workingLabel;
            renderedBuffer = await doRender();
            updateMeter(renderedBuffer);
            progress.classList.remove('on');
            listenBtn.disabled = false;
            downloadRow.style.display = 'flex';
          }
          listenIco.innerHTML = ICO_PAUSE;
          player.play(
            renderedBuffer,
            (frac) => {
              if (!waveShell) return;
              const base = config.controls === 'trim' ? selStart : 0;
              const range = config.controls === 'trim' ? (selEnd - selStart) : renderedBuffer.duration;
              const t = base + range * frac;
              const W = waveShell.clientWidth;
              playhead.style.left = ((t / dur) * W) + 'px';
              playhead.style.display = 'block';
            },
            () => { listenIco.innerHTML = ICO_PLAY; playhead.style.display = 'none'; player.reset(); }
          );
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
          progress.classList.remove('on');
          listenBtn.disabled = false;
        }
      });
    }

    async function ensureRendered() {
      if (!renderedBuffer) { renderedBuffer = await doRender(); updateMeter(renderedBuffer); }
      return renderedBuffer;
    }

    // Click/tap anywhere on the waveform to start playback from that point (LeebTTS has this,
    // there was previously no way to do it here at all -- only the trim handles moved a
    // selection). Ignores clicks on the drag handles/selection overlay, which have their own
    // mousedown handlers above. Three playback sources depending on tool type: ringtone slices
    // the live selection on demand, plain ffmpeg tools (Convert etc.) preview the raw decoded
    // source since they have no Web-Audio "effect" to render, and every other tool reuses the
    // same lazily-rendered/cached `renderedBuffer` the Listen button already relies on.
    if (waveShell) {
      waveShell.addEventListener('click', async (e) => {
        if (e.target.closest('.handle') || e.target.closest('.sel-overlay')) return;
        if (dur <= 0) return;
        const t = px2t(e.clientX);
        player.unlock();
        player.stop();
        window.dispatchEvent(new Event('opitro:tool-interaction'));

        if (config.controls === 'ringtone-targets') {
          if (!sourceBuffer || selEnd - selStart < 0.05) return;
          const seekTo = Math.max(selStart, Math.min(selEnd, t)) - selStart;
          let slice = sliceBuffer(sourceBuffer, selStart, selEnd);
          const rtVolumeEl2 = root.querySelector('#rt-volume');
          if (rtVolumeEl2) slice = scaleVolume(slice, Number(rtVolumeEl2.value) / 100);
          const chkFadeIn = root.querySelector('#chk-fadein');
          const chkFadeOut = root.querySelector('#chk-fadeout');
          if (chkFadeIn && chkFadeOut && (chkFadeIn.checked || chkFadeOut.checked)) {
            slice = await applyFade(slice, chkFadeIn.checked ? 1 : 0, chkFadeOut.checked ? 2 : 0);
          }
          if (listenSelIco) listenSelIco.innerHTML = ICO_PAUSE;
          player.play(
            slice,
            (frac) => {
              const tt = selStart + (selEnd - selStart) * frac;
              const W = waveShell.clientWidth;
              playhead.style.left = ((tt / dur) * W) + 'px';
              playhead.style.display = 'block';
            },
            () => { if (listenSelIco) listenSelIco.innerHTML = ICO_PLAY; playhead.style.display = 'none'; player.reset(); },
            seekTo
          );
          return;
        }

        if (config.engine === 'ffmpeg') {
          if (!sourceBuffer) return;
          const simpleIco = root.querySelector('.simple-preview-ico');
          if (simpleIco) simpleIco.innerHTML = ICO_PAUSE;
          player.play(
            sourceBuffer,
            (frac) => {
              const tt = frac * dur;
              const W = waveShell.clientWidth;
              playhead.style.left = ((tt / dur) * W) + 'px';
              playhead.style.display = 'block';
            },
            () => {
              playhead.style.display = 'none';
              player.reset();
              if (simpleIco) simpleIco.innerHTML = ICO_PLAY;
            },
            t
          );
          return;
        }

        try {
          if (!renderedBuffer) {
            progress.classList.add('on');
            progressText.textContent = labels.workingLabel;
            renderedBuffer = await doRender();
            updateMeter(renderedBuffer);
            progress.classList.remove('on');
            if (downloadRow) downloadRow.style.display = 'flex';
          }
        } catch (err) {
          progress.classList.remove('on');
          return;
        }
        const base = config.controls === 'trim' ? selStart : 0;
        const range = config.controls === 'trim' ? (selEnd - selStart) : renderedBuffer.duration;
        const clamped = config.controls === 'trim' ? Math.max(selStart, Math.min(selEnd, t)) : t;
        const frac = range > 0 ? (clamped - base) / range : 0;
        const seekTo = Math.max(0, Math.min(renderedBuffer.duration, frac * renderedBuffer.duration));
        if (listenIco) listenIco.innerHTML = ICO_PAUSE;
        player.play(
          renderedBuffer,
          (frac2) => {
            const tt = base + range * frac2;
            const W = waveShell.clientWidth;
            playhead.style.left = ((tt / dur) * W) + 'px';
            playhead.style.display = 'block';
          },
          () => { if (listenIco) listenIco.innerHTML = ICO_PLAY; playhead.style.display = 'none'; player.reset(); },
          seekTo
        );
      });
    }

    if (dlMp3Btn) {
      dlMp3Btn.addEventListener('click', async () => {
        clearError();
        try {
          const buf = await ensureRendered();
          const bitrate = config.mp3Bitrate ? config.mp3Bitrate(readParams()) : 192;
          const blob = await encodeMP3(buf, bitrate);
          const base = config.controls === 'generator' ? tool : config.controls === 'multi-file' ? 'merged' : (file.name.replace(/\.[^.]+$/, '') || 'audio');
          downloadBlob(blob, `${base}.mp3`);
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
        }
      });
    }
    if (dlWavBtn) {
      dlWavBtn.addEventListener('click', async () => {
        clearError();
        try {
          const buf = await ensureRendered();
          const blob = encodeWAV(buf);
          const base = config.controls === 'generator' ? tool : config.controls === 'multi-file' ? 'merged' : (file.name.replace(/\.[^.]+$/, '') || 'audio');
          downloadBlob(blob, `${base}.wav`);
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
        }
      });
    }

    // ffmpeg-engine tools (convert, ringtone, video-to-audio, visualizer, denoise, enhance)
    if (runBtn) {
      runBtn.addEventListener('click', async () => {
        if (config.allowBatch ? !files.length : !file) return;
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        clearError();
        runBtn.disabled = true;
        progress.classList.add('on');
        progressFill.style.width = '0%';
        progressText.textContent = labels.preparingLabel;

        const params = readParams();

        if (config.allowBatch) {
          const results = [];
          for (let i = 0; i < files.length; i++) {
            const f = files[i];
            progressFill.style.width = '0%';
            progressText.textContent = `${labels.batchProcessingLabel || 'Processing'} ${i + 1}/${files.length}: ${f.name}`;
            try {
              const { outputName, mimeType, ext } = config.output(params);
              const blob = await execFFmpeg({
                inputs: [{ name: 'in0', file: f }],
                buildArgs: (inputNames, out) => config.buildArgs(inputNames, out, params),
                outputName,
                mimeType,
                onProgress: (pct) => { progressFill.style.width = pct + '%'; },
              });
              const base = f.name.replace(/\.[^.]+$/, '') || `file-${i + 1}`;
              results.push({ name: `${base}.${ext}`, blob });
            } catch (e) {
              showError(`${f.name}: ${e && e.message ? e.message : String(e)}`);
            }
            // Fresh ffmpeg instance between every file -- processing many files back-to-back on
            // the same instance is exactly the "crashes after a lot of conversions" pattern
            // documented in ffmpeg.wasm's own issue tracker (see the ringtone config comment).
            resetFFmpeg();
          }
          if (results.length) {
            if (results.length === 1) {
              downloadFfmpegBlob(results[0].blob, results[0].name);
            } else {
              progressText.textContent = labels.batchZippingLabel || 'Packing ZIP...';
              const { default: JSZip } = await import('jszip');
              const zip = new JSZip();
              results.forEach((r) => zip.file(r.name, r.blob));
              const zipBlob = await zip.generateAsync({ type: 'blob' });
              downloadFfmpegBlob(zipBlob, 'converted.zip');
            }
            progressFill.style.width = '100%';
            progressText.textContent = labels.doneLabel;
            runBtn.textContent = labels[config.runLabel] || labels.processLabel;
          } else {
            progress.classList.remove('on');
          }
          runBtn.disabled = false;
          return;
        }

        const { outputName, mimeType, ext } = config.output(params);
        try {
          const blob = await execFFmpeg({
            inputs: [{ name: 'in0', file }],
            buildArgs: (inputNames, out) => config.buildArgs(inputNames, out, params),
            outputName,
            mimeType,
            onProgress: (pct) => {
              progressFill.style.width = pct + '%';
              progressText.textContent = `${labels.workingLabel} ${pct}%`;
            },
          });
          const base = file.name.replace(/\.[^.]+$/, '') || 'audio';
          progressFill.style.width = '100%';
          progressText.textContent = labels.doneLabel;
          runBtn.textContent = labels[config.runLabel] || labels.processLabel;
          runBtn.onclick = null;
          downloadFfmpegBlob(blob, `${base}.${ext}`);
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
          progress.classList.remove('on');
        }
        runBtn.disabled = false;
      });
    }

    // OGG export for Telegram/WhatsApp: libopus at 24kHz first (avoids the specific internal
    // 48kHz resample path where ffmpeg.wasm crashes -- see the config comment), falling back to
    // libvorbis (already proven stable, used by the Convert tool) if libopus still crashes on
    // some device. `clip` should already be the small, trimmed selection, not the raw upload.
    async function encodeOgg(clip) {
      const resampled = await resampleBuffer(clip, config.oggSampleRate || 24000);
      const wavBlob = encodeWAV(resampled);
      const wavFile = new File([wavBlob], 'clip.wav', { type: 'audio/wav' });
      const runExport = (buildArgs) => execFFmpeg({
        inputs: [{ name: 'in0', file: wavFile }],
        buildArgs,
        outputName: 'out.ogg',
        mimeType: 'audio/ogg',
        onProgress: (pct) => {
          progressFill.style.width = pct + '%';
          progressText.textContent = `${labels.workingLabel} ${pct}%`;
        },
      });
      try {
        return await runExport(config.buildOpusArgs);
      } catch (e) {
        return await runExport(config.buildOggVorbisArgs);
      }
    }

    // Real M4R for iPhone (AAC in an MP4 container, .m4r extension) -- same aac codec the
    // Convert tool already relies on, so no libopus-style crash risk expected.
    async function encodeM4r(clip) {
      const wavBlob = encodeWAV(clip);
      const wavFile = new File([wavBlob], 'clip.wav', { type: 'audio/wav' });
      return execFFmpeg({
        inputs: [{ name: 'in0', file: wavFile }],
        buildArgs: (names, out) => config.buildAacArgs(names, out),
        outputName: 'out.m4a',
        mimeType: 'audio/mp4',
        onProgress: (pct) => {
          progressFill.style.width = pct + '%';
          progressText.textContent = `${labels.workingLabel} ${pct}%`;
        },
      });
    }

    // Ringtone target tiles -- each one runs its own ffmpeg recipe (format, max duration,
    // fades) against the current waveform selection, then shows a destination-specific guide.
    if (targetsEl) {
      targetsEl.querySelectorAll('.target').forEach((btn) => {
        btn.addEventListener('click', async () => {
          if (!file) return;
          player.unlock();
          window.dispatchEvent(new Event('opitro:tool-interaction'));
          const target = config.targets.find((t) => t.key === btn.dataset.key);
          clearError();
          if (ringtoneGuide) ringtoneGuide.classList.remove('on');
          targetsEl.querySelectorAll('.target').forEach((b) => { b.disabled = true; });
          progress.classList.add('on');
          progressFill.style.width = '0%';
          progressText.textContent = labels.preparingLabel;

          const chkFadeIn = root.querySelector('#chk-fadein');
          const chkFadeOut = root.querySelector('#chk-fadeout');
          const rtVolume = root.querySelector('#rt-volume');
          const fadeInOn = chkFadeIn ? chkFadeIn.checked : false;
          const fadeOutOn = chkFadeOut ? chkFadeOut.checked : false;
          const volPct = rtVolume ? Number(rtVolume.value) : 100;
          const vol = (volPct / 100) * (target.louder ? 1.4 : 1);

          try {
            let blob;
            if (sourceBuffer) {
              // Always process on the small in-memory buffer, entirely in Web Audio -- no
              // ffmpeg in this branch at all. See the engine comment on the ringtone config
              // entry for why (ffmpeg's OGG/libopus export crashes -- upstream bug, not ours).
              let duration = selEnd - selStart;
              if (target.max && duration > target.max) duration = target.max;
              let clip = sliceBuffer(sourceBuffer, selStart, selStart + duration);
              clip = scaleVolume(clip, vol);
              if (fadeInOn || fadeOutOn) clip = await applyFade(clip, fadeInOn ? 1 : 0, fadeOutOn ? 2 : 0);
              if (target.fmt === 'mp3') {
                progressText.textContent = labels.workingLabel;
                blob = await encodeMP3(clip, 192);
              } else if (target.fmt === 'ogg') {
                progressText.textContent = labels.workingLabel;
                blob = await encodeOgg(clip);
              } else if (target.fmt === 'm4r') {
                progressText.textContent = labels.workingLabel;
                blob = await encodeM4r(clip);
              } else {
                blob = encodeWAV(clip);
              }
            } else {
              // No decoded buffer -- the browser (and the ffmpeg decode fallback) both failed
              // to read this file for a waveform preview. Rather than blocking the whole tool
              // on that (a real gap found live: Convert never needed this step to succeed and
              // works fine on files this same decode step chokes on), run ffmpeg directly on
              // the original file instead, exactly like Convert does. No visual trim is
              // possible without a decoded duration, so this takes the first `target.max`
              // seconds (or a 30s default for targets with no cap).
              const duration = target.max || 30;
              progressText.textContent = labels.workingLabel;
              const af = [];
              if (vol !== 1) af.push(`volume=${vol.toFixed(2)}`);
              if (fadeInOn) af.push('afade=t=in:st=0:d=1');
              if (fadeOutOn && duration > 2) af.push(`afade=t=out:st=${Math.max(0, duration - 2).toFixed(2)}:d=2`);
              const runExport = (outputName, mimeType, tailArgs) => execFFmpeg({
                inputs: [{ name: 'in0', file }],
                buildArgs: (names, out) => {
                  const args = ['-i', names[0], '-t', String(duration), '-vn'];
                  if (af.length) args.push('-af', af.join(','));
                  return [...args, ...tailArgs, out];
                },
                outputName,
                mimeType,
                onProgress: (pct) => {
                  progressFill.style.width = pct + '%';
                  progressText.textContent = `${labels.workingLabel} ${pct}%`;
                },
              });
              if (target.fmt === 'mp3') {
                blob = await runExport('out.mp3', 'audio/mpeg', ['-b:a', '192k', '-f', 'mp3']);
              } else if (target.fmt === 'ogg') {
                // Same libopus-24kHz-first, libvorbis-fallback pattern as encodeOgg() above --
                // duplicated here (not routed through encodeOgg) because there's no decoded
                // buffer to pre-resample with Web Audio in this no-preview branch, so the
                // resample has to happen inside ffmpeg's own -ar flag instead.
                try {
                  blob = await runExport('out.ogg', 'audio/ogg', ['-ar', '24000', '-c:a', 'libopus', '-b:a', '48k']);
                } catch (e) {
                  blob = await runExport('out.ogg', 'audio/ogg', ['-c:a', 'libvorbis', '-b:a', '96k']);
                }
              } else if (target.fmt === 'm4r') {
                blob = await runExport('out.m4a', 'audio/mp4', ['-c:a', 'aac', '-b:a', '192k']);
              } else {
                blob = await runExport('out.wav', 'audio/wav', []);
              }
              // Every click here reprocesses the original (possibly large) file from scratch --
              // drop the instance afterward so a second target click starts memory-fresh too.
              resetFFmpeg();
            }

            const base = `${(file.name.replace(/\.[^.]+$/, '') || 'ringtone')}-${target.key}`;
            progressFill.style.width = '100%';
            progressText.textContent = labels.doneLabel;
            downloadBlob(blob, `${base}.${target.fmt}`);
            const guideText = labels.targetGuides && labels.targetGuides[target.key];
            if (ringtoneGuide && guideText) {
              ringtoneGuide.textContent = guideText;
              ringtoneGuide.classList.add('on');
            }
          } catch (e) {
            showError(e && e.message ? e.message : String(e));
            progress.classList.remove('on');
          }
          targetsEl.querySelectorAll('.target').forEach((b) => { b.disabled = false; });
        });
      });
    }
  }
</script>

