        </div>
        <div class="preset-desc" id="voice-desc" style="display:none"></div>
        <div class="fade-card pitch-card" id="voice-intensity-wrap" style="display:none">
          <label class="fade-card-title" for="voice-intensity">{labels.voiceIntensityLabel}</label>
