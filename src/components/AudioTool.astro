        </div>
      </>
    )}
    {controls === 'rate1' && (
      <>
        {/* The whole tool is one line of cause and effect, so it's laid out as one: what the
            audio becomes, what it's saved as, then the action. Splitting those across two
            stacked bars with a button between them made three unrelated-looking blocks out of
            a single decision. Every cell is the same 48px tall on the same 12px radius, and the
            row wraps by its own min-width rather than at a guessed breakpoint -- which matters
            because these labels are far longer in Russian than in English. */}
        <div class="deck">
          <div class="field">
            <label for="ctrl-select">{labels.sampleRateLabel}</label>
            <select id="ctrl-select">
              {config.rateOptions.map((o) => (
                <option value={o.value} selected={o.value === 44100 ? true : undefined}>{o.label}</option>
              ))}
            </select>
          </div>
          <div class="field field-fmt">
            <label for="tool-format">{labels.enhanceFormatLabel}</label>
            <select id="tool-format">
              {config.downloadFormats.map((f) => <option value={f}>{f.toUpperCase()}</option>)}
            </select>
          </div>
          <button type="button" class="act primary deck-act" id="tool-download-btn" disabled>
            <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICO.download} />
            <span>{labels.downloadResultLabel}</span>
          </button>
        </div>
        <div class="rate-note" id="rate-note" style="display:none"></div>
        {/* No "upload a different file" button down here: it sits on the file chip instead,
            next to the remove button (config.fileChipActions). */}
      </>
    )}
    {controls === 'volume1' && (
      <>
        <div class="fade-card pitch-card">
          <label class="fade-card-title" for="ctrl-slider">{labels.volumeLabel}</label>
          <input type="range" id="ctrl-slider" min={config.volumeMin} max={config.volumeMax} step="5" value="100">
          <span class="fade-card-val" id="volume-val">100%</span>
        </div>
      </>
    )}
    {controls === 'pitch1' && (
      <div class="fade-cards">
        <div class="fade-card">
          <label class="fade-card-title" for="ctrl-slider">{labels.pitchSemitonesLabel}</label>
          <input type="range" id="ctrl-slider" min={config.semitoneMin} max={config.semitoneMax} step="1" value="0">
          <span class="fade-card-val" id="pitch-val">{labels.pitchUnchangedLabel}</span>
        </div>
        <div class="fade-card">
          <label class="fade-card-title" for="ctrl-cents">{labels.pitchCentsLabel}</label>
          <input type="range" id="ctrl-cents" min={config.centsMin} max={config.centsMax} step="1" value="0">
          <span class="fade-card-val" id="cents-val">0 {labels.centsShortLabel}</span>
        </div>
      </div>
    )}
    {controls === 'fade2' && (
      <div class="fade-cards">
        <div class="fade-card">
          <label class="fade-card-title" for="ctrl-fadein">{labels.fadeInCardLabel}</label>
          <input type="range" id="ctrl-fadein" min="0" max={config.fadeMax} step="0.5" value="0">
          <span class="fade-card-val" id="fadein-val">0 {labels.secShortLabel}</span>
        </div>
        <div class="fade-card">
          <label class="fade-card-title" for="ctrl-fadeout">{labels.fadeOutCardLabel}</label>
          <input type="range" id="ctrl-fadeout" min="0" max={config.fadeMax} step="0.5" value="0">
          <span class="fade-card-val" id="fadeout-val">0 {labels.secShortLabel}</span>
        </div>
      </div>
    )}
    {controls === 'fade2' && (
      <div class="preset-cards" id="fade-presets">
        {config.fadePresets.map((p) => (
          <button type="button" class="preset-card" data-preset={p.key}>
            <span class="pc-emoji">{p.emoji}</span>
            <span class="pc-label">{labels[p.label] || p.key}</span>
          </button>
        ))}
      </div>
    )}
    {controls === 'trim' && (
      <div class="checks">
        <label class="check"><input type="checkbox" id="ctrl-cutout"> {labels.cutOutCheckLabel}</label>
      </div>
    )}

    {controls === 'generator' && (
      <div class="field">
        <label for="ctrl-duration">{labels.durationLabel}</label>
        <input type="number" id="ctrl-duration" min="1" max={config.durationMax || 3600} value={config.durationDefault || 60}>
      </div>
    )}

    {controls === 'recorder' && (
      <div class="rec-stage">
        {/* Listen on the left, record in the middle, pause on the right: the red button is the
            one thing you came here to press, so it sits in the centre and the other two flank it. */}
        <div class="rec-row">
          <button type="button" class="rec-side" id="rec-play" disabled aria-label={labels.recPlayLabel}>
            <svg class="ico" id="rec-play-ico" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
          <button type="button" class="rec-btn" id="rec-btn" aria-label={labels.recStartLabel}>
            <span class="rec-dot" id="rec-dot"></span>
          </button>
          <button type="button" class="rec-side" id="rec-pause" disabled aria-label={labels.recPauseLabel}>
            <svg class="ico" id="rec-pause-ico" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/></svg>
          </button>
        </div>
        <div class="rec-time" id="rec-time">0:00</div>
        {/* A live level bar. The classic disaster is recording twenty minutes into a muted or
            wrong microphone and only finding out at the end; a bar that moves proves it hears you. */}
        <div class="rec-meter" id="rec-meter"><div class="rec-meter-fill" id="rec-meter-fill"></div></div>
        <div class="rec-state" id="rec-state">{labels.recIdleLabel}</div>
      </div>
    )}

    {/* Noise: play is the primary action and starts instantly, because what people come here for
        is to listen -- for hours, usually. Downloading a file is secondary and lives below. */}
    {controls === 'noise' && (
      <>
        <div class="noise-stage">
          <button type="button" class="noise-play" id="noise-play-btn" aria-label={labels.noisePlayLabel}>
            <svg class="ico" id="noise-play-ico" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
          <div class="noise-state" id="noise-state">{labels.noiseIdleLabel}</div>
        </div>
        <div class="fade-card pitch-card">
          <label class="fade-card-title" for="noise-volume">{labels.volumeLabel}</label>
          <input type="range" id="noise-volume" min="0" max="100" step="1" value="60">
          <span class="fade-card-val" id="noise-volume-val">60%</span>
        </div>
        <div class="field">
          <div class="field-cap" id="noise-timer-cap">{labels.noiseTimerLabel}</div>
          <div class="presets-row" id="noise-timer" role="group" aria-labelledby="noise-timer-cap">
            {[0, 15, 30, 60].map((m) => (
              <button type="button" class={`preset-btn${m === 0 ? ' active' : ''}`} data-min={m}>
                {m === 0 ? labels.noiseTimerOffLabel : `${m} ${labels.minutesShortLabel}`}
              </button>
            ))}
          </div>
        </div>
        <div class="noise-dl-title">{labels.noiseDownloadTitle}</div>
        <div class="field">
          <div class="presets-row" id="noise-lengths">
            {config.downloadLengths.map((sec, i) => (
              <button type="button" class={`preset-btn${i === 1 ? ' active' : ''}`} data-sec={sec}>
                {sec < 60 ? `${sec} ${labels.secondsShortLabel}` : `${sec / 60} ${labels.minutesShortLabel}`}
              </button>
            ))}
          </div>
        </div>
        <div class="deck">
          <div class="field field-fmt">
            <label for="tool-format">{labels.enhanceFormatLabel}</label>
            <select id="tool-format">
              {config.downloadFormats.map((f) => <option value={f}>{f.toUpperCase()}</option>)}
            </select>
          </div>
          <button type="button" class="act primary deck-act" id="noise-download-btn">
            <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICO.download} />
            <span>{labels.downloadResultLabel}</span>
          </button>
        </div>
        <div class="rate-note" id="noise-size-note"></div>
      </>
    )}

    {isRingtoneTargets && (
      <div class="field slider-field">
        <label for="rt-volume">{labels.volumeLabel}: <span id="rt-volume-val">100%</span></label>
        <input type="range" id="rt-volume" min="10" max="300" step="10" value="100">
      </div>
    )}
    {isRingtoneTargets && (
      <div class="checks">
        <label class="check"><input type="checkbox" id="chk-fadein"> {labels.fadeInCheckLabel}</label>
        <label class="check"><input type="checkbox" id="chk-fadeout"> {labels.fadeOutCheckLabel}</label>
      </div>
    )}
    {isRingtoneTargets && (
      <div class="controls" style="margin-bottom:16px">
        <button class="act" id="listen-sel-btn">
          <svg class="ico" id="listen-sel-ico" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          <span id="listen-sel-label">{labels.listenSelectionLabel}</span>
        </button>
      </div>
    )}
    {/* Рекламное место ВНУТРИ инструмента убрано. Оно стояло между настройками и кнопкой
        скачивания -- то есть разрывало единственное действие, ради которого человек пришёл,
        ровно в тот момент, когда цель уже видна. Два оставшихся места (между инструментом и
        текстом и после текста) стоят на естественных границах и работе не мешают. */}
    {isRingtoneTargets && (
      <>
        <div class="targets-title">{labels.targetsTitle}</div>
        <div class="targets" id="targets">
          {config.targets.map((t) => (
            <button class="target" data-key={t.key}>
              <span class="t-emoji">{t.emoji}</span>
              <span class="t-name">{targetNames[t.key] || t.name}</span>
              <span class="t-fmt">{t.fmt.toUpperCase()}</span>
            </button>
          ))}
        </div>
      </>
    )}

    {/* Rendered only when it actually has a button in it. "Upload a different file" used to be
        the sole occupant on most tools; now that it lives on the file chip, an unconditional bar
        left an empty flex row with its own margin on every one of those pages. */}
    {showControlsRow && (
      <div class="controls">
        {showListenBtn && (
          <button class="act" id="audio-listen-btn" disabled={!isGenerator}>
            <svg class="ico" id="listen-ico" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            <span id="listen-label">{isGenerator ? labels.generateLabel : (labels[config.runLabel] || labels.processLabel)}</span>
          </button>
        )}
        {showRunBtn && <button class="act primary" id="audio-run-btn" disabled={config.abCompare ? true : undefined}>{labels[config.runLabel] || labels.processLabel}</button>}
        {showAddBtn && <button class="act" id="audio-add-btn">{labels.addFileLabel}</button>}
      </div>
    )}



    {!isFfmpeg && !config.downloadFormats && (
      <div class="controls" id="download-row" style="display:none">
        <button class="act primary" id="dl-mp3-btn">{labels.downloadMp3Label}</button>
        <button class="act" id="dl-wav-btn">{labels.downloadWavLabel}</button>
      </div>
    )}
    {/* Export bar, one row: format then action. Every tool with a format choice uses this now;
        sample-rate is the one exception and builds its own, because its setting belongs on that
        same row. The older stacked version (a full-width select over a full-width button) is
        gone -- two rows made one decision look like two. */}
    {config.exportDeck && (
      <div class="deck">
        {/* A dropdown holding a single option is a control that can't be used. The compressor
            only ever writes MP3 -- choosing a bitrate is the entire point -- so it gets the
            action alone, and a hidden input keeps the export path's format lookup working. */}
        {config.downloadFormats.length > 1 ? (
          <div class="field field-fmt">
            <label for="tool-format">{labels.enhanceFormatLabel}</label>
            <select id="tool-format">
              {config.downloadFormats.map((f) => <option value={f}>{f.toUpperCase()}</option>)}
            </select>
          </div>
        ) : (
          <input type="hidden" id="tool-format" value={config.downloadFormats[0]}>
        )}
        <button type="button" class="act primary deck-act" id="tool-download-btn" disabled>
          <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICO.download} />
          <span>{labels.downloadResultLabel}</span>
        </button>
      </div>
    )}
    {/* Sits under the row rather than in it -- it's a status line, not a control. */}
    {config.exportDeck && config.readyNote && <div class="ready-note" id="ready-note" style="display:none">{labels.fadeReadyLabel}</div>}

    {isRingtoneTargets && <div class="guide" id="ringtone-guide"></div>}

    <div class="err" id="audio-err"></div>
  </div>
</div>

<script>
  import { AUDIO_TOOLS, splitPlan } from '../lib/audio-tools-config.js';
  import { execFFmpeg, downloadBlob as downloadFfmpegBlob, loadFFmpeg, resetFFmpeg } from '../lib/audio-engine.js';
  import {
    decodeFile, drawWaveform, createLiveWaveform, renderEffect, encodeWAV, encodeMP3, downloadBlob, createPlayer, sliceBuffer, applyFade, scaleVolume, peakOf, normalizeGain, resampleBuffer,
    makeNoiseLoop, encodeLoopedWAV, encodeLoopedMP3,
    analyzeVocalRange, detectKey, analyzeAudiobook, detectBpm,
  } from '../lib/web-audio-engine.js';

  const MAX_MB = 1024;
  const WARN_MB = 150;
  const MAX_RINGTONE_SEC = 40;
  const root = document.querySelector('.audio-tool');
  if (root) {
    const tool = root.dataset.tool;
    const config = AUDIO_TOOLS[tool];
    const labels = JSON.parse(root.dataset.labels);

    const drop = root.querySelector('#audio-drop');
    const fileInput = root.querySelector('#audio-file-input');
    const panel = root.querySelector('#audio-panel');
    const fileInfo = root.querySelector('#audio-fileinfo');
    const fileList = root.querySelector('#audio-filelist');
    const waveShell = root.querySelector('#wave-shell');
    const waveCanvas = root.querySelector('#wave-canvas');
    const inStart = root.querySelector('#in-start');
    const inEnd = root.querySelector('#in-end');
    const selOverlay = root.querySelector('#sel-overlay');
    const hStart = root.querySelector('#h-start');
    const hEnd = root.querySelector('#h-end');
    const playhead = root.querySelector('#playhead');
    const tStart = root.querySelector('#t-start');
    const tEnd = root.querySelector('#t-end');
    const tLen = root.querySelector('#t-len');
    const listenBtn = root.querySelector('#audio-listen-btn');
    const listenIco = root.querySelector('#listen-ico');
    const listenLabel = root.querySelector('#listen-label');
    const listenSelBtn = root.querySelector('#listen-sel-btn');
    const listenSelIco = root.querySelector('#listen-sel-ico');
    const targetsEl = root.querySelector('#targets');
    const ringtoneGuide = root.querySelector('#ringtone-guide');
    const runBtn = root.querySelector('#audio-run-btn');
    // На инструментах с рядом "формат + действие" у кнопки есть значок, и запись подписи через
    // textContent стёрла бы его вместе с текстом -- поэтому подпись меняется только в <span>,
    // если он есть. Раньше кнопка была голым текстом, и обращение к ней было прямым.
    const runBtnLabelEl = runBtn ? (runBtn.querySelector('span') || runBtn) : null;
    const setRunLabel = (text) => { if (runBtnLabelEl) runBtnLabelEl.textContent = text; };
    const addBtn = root.querySelector('#audio-add-btn');
    const downloadRow = root.querySelector('#download-row');
    const dlMp3Btn = root.querySelector('#dl-mp3-btn');
    const dlWavBtn = root.querySelector('#dl-wav-btn');
    const progress = root.querySelector('#audio-progress');
    const progressFill = root.querySelector('#audio-progress-fill');
    const progressText = root.querySelector('#audio-progress-text');
    const errBox = root.querySelector('#audio-err');

    // The progress strip is feedback, not a permanent status line -- leaving "Done!" sitting at
    // the bottom of the page forever told nobody anything (and lived below the fold anyway).
    // finishProgress() shows the result briefly and then clears it.
    // Lets a tool mirror ffmpeg's real progress into its own UI. Set by the visualizer so the
    // overlay on the video can show a percentage instead of an indefinite spinner.
    let progressHook = null;
    let progressHideTimer = 0;
    // Полоса выполнения появляется с задержкой: если работа уложилась примерно в 400 мс, человек
    // её вообще не увидит. На маленьком файле она раньше мелькала и исчезала -- мельканье читается
    // как мусор и обесценивает саму полосу. Зато на стоминутном подкасте распаковка идёт секунды,
    // а шумоподавление и смена тональности -- десятки секунд, и там без неё экран выглядит
    // замершим: работа идёт, а человек об этом не знает и уходит.
    let progressShowTimer = 0;
    function armProgress() {
      clearTimeout(progressShowTimer);
      progressShowTimer = window.setTimeout(() => progress.classList.add("on"), 400);
    }
    function hideProgress() {
      clearTimeout(progressShowTimer);
      progress.classList.remove('on');
    }
    function showProgress(text, pct) {
      clearTimeout(progressHideTimer);
      armProgress();
      progressFill.style.width = (pct == null ? 0 : pct) + '%';
      progressText.textContent = text;
    }

    function finishProgress(text) {
      clearTimeout(progressHideTimer);
      clearTimeout(progressShowTimer);
      progressFill.style.width = '100%';
      progressText.textContent = text;
      // Итог показываем только если полоса уже была видна. Иначе быстрая операция всё равно
      // мигнёт -- ровно то, от чего задержка и защищает.
      if (progress.classList.contains('on')) {
        progressHideTimer = window.setTimeout(() => progress.classList.remove('on'), 2500);
      }
    }

    let file = null;
    let files = [];
    let sourceBuffer = null;
    // Per-tool hook: "a file exists now, refresh whatever depends on it".
    let rateStateSync = null;
    let renderedBuffer = null;
    let dur = 0;
    let selStart = 0;
    let selEnd = 0;
    const player = createPlayer();
    // Сторож молчания: если браузер прервал звук (Safari делает это, когда вкладка уходит
    // в фон), нажатие на пуск не даёт НИЧЕГО -- ни звука, ни ошибки. Теперь страница
    // говорит, что случилось, вместо того чтобы молча притворяться рабочей.
    player.onStuck(() => showError(labels.audioStuckLabel));
    // Solid glyphs -- these two live inside the filled green disc (see the ICO note in the
    // component frontmatter for why the outlined set stops there).
    const ICO_PLAY = '<path d="M8 5v14l11-7z"/>';
    const ICO_PAUSE = '<rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/>';
    const ICO_PAUSE_SOLID = ICO_PAUSE;
    // Outlined set, duplicated from the frontmatter ICO object because this runs client-side and
    // has no access to it. Keep the two in step.
    const ICO_WAVE = '<path d="M4 10v4"/><path d="M8 6v12"/><path d="M12 9v6"/><path d="M16 4v16"/><path d="M20 10v4"/>';
    const ICO_CLOSE = '<path d="M6 6l12 12"/><path d="M18 6L6 18"/>';
    const ICO_UPLOAD = '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 8l5-5 5 5M12 3v12"/>';
    const ICO_ARROW_UP = '<path d="M12 19V5"/><path d="M6 11l6-6 6 6"/>';
    const ICO_ARROW_DOWN = '<path d="M12 5v14"/><path d="M18 13l-6 6-6-6"/>';
    const svgIco = (paths, cls) => `<svg class="${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;

    function showError(message) {
      errBox.textContent = message;
      errBox.classList.add('show');
    }
    function clearError() {
      errBox.classList.remove('show');
    }
    function fmtTime(s) {
      const m = Math.floor(s / 60);
      const sec = Math.floor(s % 60);
      const d = Math.floor((s * 10) % 10);
      return `${m}:${String(sec).padStart(2, '0')}.${d}`;
    }
    // Whole seconds only -- for a transport readout, tenths just flicker distractingly.
    function fmtClock(s) {
      const m = Math.floor(s / 60);
      return `${m}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    }
    // Drawing the waveform needs the canvas to already have a real width -- it reads its own
    // layout box to size itself. A single requestAnimationFrame usually gets there, but not
    // always: in the compact player the canvas is a flex child, and on the very first paint
    // after the panel is revealed it can still measure 0, which silently produced a blank
    // waveform that only appeared after a manual page reload (reported live). Retry across a
    // few frames until the box is real, and keep a ResizeObserver on it afterwards so any later
    // relayout (orientation change, font swap, container resize) redraws instead of stretching
    // a stale bitmap.
    let waveDrawBuffer = null;
    let waveObserver = null;
    function scheduleWaveformDraw(buffer, attempt = 0) {
      if (!waveCanvas || !buffer) return;
      waveDrawBuffer = buffer;
      requestAnimationFrame(() => {
        if (waveDrawBuffer !== buffer) return;
        if (waveCanvas.getBoundingClientRect().width < 1) {
          if (attempt < 20) scheduleWaveformDraw(buffer, attempt + 1);
          return;
        }
        drawWaveform(waveCanvas, buffer, undefined, fadeDrawOpts());
        updateSel();
        if (!waveObserver && typeof ResizeObserver !== 'undefined') {
          waveObserver = new ResizeObserver(() => {
            if (waveDrawBuffer && waveCanvas.getBoundingClientRect().width >= 1) {
              drawWaveform(waveCanvas, waveDrawBuffer, undefined, fadeDrawOpts());
              updateSel();
            }
          });
          waveObserver.observe(waveCanvas);
        }
      });
    }

    // Duration straight from the file's own metadata -- no decoding. decodeAudioData has to
    // expand the entire track into memory, which for an hour-long podcast is seconds of waiting
    // and hundreds of megabytes, and the visualizer only needs the number to estimate render
    // time. A media element reports duration as soon as it has read the header.
    function probeDuration(f) {
      return new Promise((resolve) => {
        const url = URL.createObjectURL(f);
        const el = new Audio();
        let settled = false;
        const done = (v) => {
          if (settled) return;
          settled = true;
          clearTimeout(guard);
          el.onloadedmetadata = el.ondurationchange = el.onerror = null;
          el.src = '';
          URL.revokeObjectURL(url);
          resolve(v > 0 && isFinite(v) ? v : 0);
        };
        // Nothing downstream may hang on this. If neither event ever fires -- and browsers do
        // occasionally stay silent on odd files -- the tool still has to become usable.
        const guard = setTimeout(() => done(0), 8000);

        el.preload = 'metadata';
        el.onloadedmetadata = () => {
          if (isFinite(el.duration) && el.duration > 0) return done(el.duration);
          // MP3s written without a Xing/Info header -- very common for VBR encodes -- report
          // Infinity here until the browser has actually scanned the file. Seeking far past
          // the end forces it to work the real length out and fire durationchange. This was
          // the actual reason the render estimate never appeared: Infinity failed the finite
          // check, fell through as 0, and the estimate silently skipped itself.
          el.ondurationchange = () => {
            if (isFinite(el.duration) && el.duration > 0) done(el.duration);
          };
          try { el.currentTime = 1e101; } catch (e) { done(0); }
        };
        el.onerror = () => done(0);
        el.src = url;
      });
    }

    // Plain "format / size / duration / rate / channels" strip, shown by any tool that opts in
    // via a #file-meta element. Reads sourceBuffer, so only call it after a successful decode.
    function renderFileMeta(f) {
      const fileMetaEl = root.querySelector('#file-meta');
      if (!fileMetaEl) return;
      const ext = (f.name.split('.').pop() || '').toUpperCase();
      // A 3-second recording is about 30 KB, which this rendered as "0.0 MB" -- true, useless.
      const sizeText = f.size >= 1048576
        ? `${(f.size / 1048576).toFixed(1)} MB`
        : `${Math.max(1, Math.round(f.size / 1024))} KB`;
      // Подписи и единицы намеренно английские и НЕ переводятся. Причины три: они вдвое-втрое
      // короче ("TIME" против "ДЛИТЕЛЬНОСТЬ" -- 4 знака против 13, и именно длина этих слов
      // ломала строку на телефоне); значения тут и так английские (WAV, MP3, Hz), и половинчатый
      // перевод читается хуже обоих вариантов; и это язык, на котором говорит любая звуковая
      // программа, так что слова узнаются без чтения.
      const rows = [
        ['FORMAT', ext],
        ['SIZE', sizeText],
        ['TIME', fmtTime(dur)],
      ];
      // Sample rate and channel count are only known from a decoded buffer. Tools that skip the
      // decode on purpose (visualizer) show the rest rather than nothing.
      if (sourceBuffer) {
        // Thin-space grouping, so the strip reads "48 000 Hz" exactly like the dropdown right
        // below it does -- "48000 Hz" next to "44 100 Hz (CD)" looked like two different units.
        rows.push(['RATE', `${String(sourceBuffer.sampleRate).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')} Hz`]);
        // CHAN, а не CHANNELS: так подписан вход на любом микшере и звуковой карте, узнаваемость
        // та же, а слово вдвое короче -- на телефоне именно оно оставалось самым длинным.
        rows.push(['CHAN', sourceBuffer.numberOfChannels >= 2 ? 'Stereo' : 'Mono']);
      }
      fileMetaEl.innerHTML = rows
        .map(([k, v]) => `<div class="fm-item"><span class="fm-key">${escapeHtml(k)}</span><span class="fm-val">${escapeHtml(String(v))}</span></div>`).join('');
      fileMetaEl.style.display = 'flex';
    }

    function invalidateRender() {
      renderedBuffer = null;
      // Волна пересчитывается сразу при смене настроек, а не при первом нажатии плей. Иначе
      // человек ставит восемь секунд тишины, видит прежнюю форму и не понимает, случилось ли
      // что-нибудь; а бегунок потом едет по звуку, которого уже нет. Пересчёт отложен на
      // четверть секунды: у ползунков события идут потоком, и считать на каждое движение
      // означало бы считать сто раз вместо одного.
      if (config.abWaveform) scheduleWaveSync();
      if (downloadRow) downloadRow.style.display = 'none';
      // Tools that adjust a LIVE graph (EQ, fade) must not have playback interrupted by a
      // settings change -- stopping here silently killed the audio on every slider move (and
      // left the play icon showing "pause", since that icon isn't the one this function resets).
      // Only the cached export render is invalidated for them; everything else still stops,
      // because for those tools the playing buffer really is the now-stale result.
      if (LIVE_CHAIN_TOOLS[config.controls]) return;
      player.reset();
      if (listenIco) listenIco.innerHTML = ICO_PLAY;
      // The round button ON the waveform has its own icon, and this only ever reset the old
      // Process button's. Changing a setting mid-playback stopped the audio but left the pause
      // glyph sitting there, so it read as "something is loading" -- you wait for an icon that
      // is never going to change. abPlayingWhich has to go too, or the next press pauses
      // nothing instead of playing.
      if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PLAY; wavePlayIco.closest('.tp-btn')?.classList.remove('is-playing'); }
      abPlayingWhich = null;
      if (listenLabel) listenLabel.textContent = isGeneratorLabel();
      if (playhead) playhead.style.display = 'none';
    }
    function isGeneratorLabel() {
      if (config.controls === 'generator') return labels.generateLabel;
      // config.runLabel used to be read only by the ffmpeg Run button, so merge's own wording
      // was reset to the generic "Process" the first time this ran.
      return labels[config.runLabel] || labels.processLabel;
    }

    function escapeHtml(s) {
      return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    // Order is the whole point for merge -- the files play back in list order -- and the only way
    // to change it used to be removing everything and re-adding it in sequence, which is what the
    // page's own FAQ had to tell people to do. Reorder arrows instead of drag-and-drop because
    // they work identically with a finger, a mouse and a keyboard.
    const canReorder = config.controls === 'multi-file';
    // Громкость каждого файла в микшере -- своя. Общий ползунок "громкость подложки" делал
    // одинаково тихими ВСЕ файлы кроме первого, а на деле приглушить нужно обычно один: музыку
    // под голосом, а не второй голос вместе с ней.
    //
    // Ключ -- сам объект File, а не номер в списке. Номера здесь меняются: строки переставляют
    // стрелками и удаляют крестиком, и при ключе по номеру громкость после перестановки уехала
    // бы к соседнему файлу.
    const fileGains = new Map();
    const gainFor = (f, i) => {
      if (!fileGains.has(f)) fileGains.set(f, i === 0 ? 100 : 35);
      return fileGains.get(f);
    };

    function renderFileList() {
      const last = files.length - 1;
      fileList.innerHTML = files.map((f, i) => {
        const move = canReorder && files.length > 1
          ? `<button type="button" class="filelist-move" data-move="up" data-index="${i}" aria-label="${escapeHtml(labels.moveUpLabel || 'Move up')}" title="${escapeHtml(labels.moveUpLabel || 'Move up')}"${i === 0 ? ' disabled' : ''}>${svgIco(ICO_ARROW_UP, 'i')}</button>`
            + `<button type="button" class="filelist-move" data-move="down" data-index="${i}" aria-label="${escapeHtml(labels.moveDownLabel || 'Move down')}" title="${escapeHtml(labels.moveDownLabel || 'Move down')}"${i === last ? ' disabled' : ''}>${svgIco(ICO_ARROW_DOWN, 'i')}</button>`
          : '';
        return `<div class="filelist-item"><button type="button" class="filelist-play" data-index="${i}" aria-label="${escapeHtml(labels.listenSelectionLabel || 'Listen')}"><svg class="ico" viewBox="0 0 24 24" fill="currentColor">${ICO_PLAY}</svg></button>`
          + `<span>${i + 1}. <b>${escapeHtml(f.name)}</b> · ${(f.size / 1048576).toFixed(1)} MB</span>`
          + move
          + `<button type="button" class="filelist-remove" data-index="${i}" aria-label="${escapeHtml(labels.removeFileLabel || 'Remove')}" title="${escapeHtml(labels.removeFileLabel || 'Remove')}">${svgIco(ICO_CLOSE, 'i')}</button>`
          // Ползунок -- второй строкой той же карточки, а не в один ряд с именем: имя файла на
          // телефоне и так занимает три строки, и ползунку рядом с ним осталось бы сорок точек.
          + (config.perFileVolume
            ? `<div class="filelist-vol"><input type="range" class="fl-vol" data-index="${i}" min="0" max="150" step="5" value="${gainFor(f, i)}" aria-label="${escapeHtml(labels.mixVolumeLabel || 'Volume')}"><span class="fl-vol-val">${gainFor(f, i)}%</span></div>`
            : '')
          + `</div>`;
      }).join('');
    }
    // Per-file preview in the multi-file list (merge, batch convert) -- decodes only when
    // tapped, not up front for every file, since a batch can be up to 20 files at 1GB each.
    const fileBuffers = new Map();
    let filePlayingIndex = -1;
    // Расшифровка файла с запоминанием. Тот же кеш, что у кнопки прослушивания отдельного
    // файла: пересчёт микса теперь идёт при каждом движении ползунка громкости, и расшифровывать
    // те же файлы заново по десять раз подряд было бы чистой тратой -- расшифровка занимает
    // куда больше времени, чем само сложение дорожек.
    async function decodeBuffered(f) {
      let b = fileBuffers.get(f);
      if (!b) { b = await decodeFile(f); fileBuffers.set(f, b); }
      return b;
    }
    function setFilePlayIcon(idx, playing) {
      const svg = fileList.querySelector(`.filelist-play[data-index="${idx}"] svg`);
      if (svg) svg.innerHTML = playing ? ICO_PAUSE : ICO_PLAY;
    }
    // Пересчёт микса после того, как палец отпустил ползунок. Без него на экране оставалась бы
    // волна от прежних громкостей, а цифры на ползунках говорили бы другое -- ровно то
    // враньё, которое чинилось на этой неделе в шумоподавлении. Четверть секунды -- чтобы не
    // считать сто раз, пока ползунок едет.
    let mixReRenderTimer = 0;
    let mixRendering = false;
    function scheduleReMix(delay = 250) {
      clearTimeout(mixReRenderTimer);
      mixReRenderTimer = window.setTimeout(async () => {
        if (!files.length || mixRendering) return;
        // Играет ли прямо сейчас сам микс. Если человек слушает ОТДЕЛЬНЫЙ файл (кнопкой в
        // строке списка), перехватывать воспроизведение нельзя -- он слушает не это.
        const wasPlaying = player.isPlaying() && filePlayingIndex < 0;
        const at = wasPlaying ? player.getPosition() : null;
        mixRendering = true;
        renderedBuffer = null;
        try {
          renderedBuffer = await doRender();
        } catch (e) {
          mixRendering = false;
          return;
        }
        mixRendering = false;
        // Играло -- продолжаем с того же места, уже с новыми громкостями: так слышно, что
        // именно изменилось, а не "стоп, нажми снова, послушай сначала".
        if (wasPlaying && renderedBuffer) playAB('result', renderedBuffer, at ?? undefined);
      }, delay);
    }

    if (fileList) {
      fileList.addEventListener('input', (e) => {
        const vol = e.target.closest('.fl-vol');
        if (!vol) return;
        const f = files[Number(vol.dataset.index)];
        if (!f) return;
        fileGains.set(f, Number(vol.value));
        const out = vol.parentElement.querySelector('.fl-vol-val');
        if (out) out.textContent = vol.value + '%';
        scheduleReMix();
      });
      fileList.addEventListener('click', async (e) => {
        const moveBtn = e.target.closest('.filelist-move');
        if (moveBtn) {
          const from = Number(moveBtn.dataset.index);
          const to = moveBtn.dataset.move === 'up' ? from - 1 : from + 1;
          if (to < 0 || to >= files.length) return;
          [files[from], files[to]] = [files[to], files[from]];
          // Stop whatever was playing: after a swap the highlighted row is a different file.
          player.stop();
          filePlayingIndex = -1;
          renderFileList();
          invalidateRender();
          if (config.perFileVolume) scheduleReMix(0);
          eqSyncState();
          return;
        }
        const removeBtn = e.target.closest('.filelist-remove');
        if (removeBtn) {
          files.splice(Number(removeBtn.dataset.index), 1);
          renderFileList();
          invalidateRender();
          if (config.perFileVolume && files.length) scheduleReMix(0);
          eqSyncState();
          filePlayingIndex = -1;
          if (!files.length) {
            panel.classList.remove('on');
            if (drop) drop.style.display = '';
            if (listenBtn) listenBtn.disabled = true;
          }
          return;
        }
        const playBtn = e.target.closest('.filelist-play');
        if (!playBtn) return;
        const idx = Number(playBtn.dataset.index);
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        player.unlock();
        if (filePlayingIndex === idx && player.isPlaying()) {
          player.pause();
          setFilePlayIcon(idx, false);
          filePlayingIndex = -1;
          return;
        }
        player.stop();
        if (filePlayingIndex >= 0) setFilePlayIcon(filePlayingIndex, false);
        filePlayingIndex = idx;
        setFilePlayIcon(idx, true);
        try {
          const f = files[idx];
          let buf = fileBuffers.get(f);
          if (!buf) {
            buf = await decodeFile(f);
            fileBuffers.set(f, buf);
          }
          if (filePlayingIndex !== idx) return;
          // Файл звучит на той громкости, которая выставлена его ползунком, а не на исходной.
          // Иначе прослушивание отдельной дорожки отвечало на вопрос "что это за файл", но не
          // на вопрос "не задавил ли я его" -- а ползунок стоит ровно ради второго. Громкость
          // вставляется живым узлом в цепочку, без пересчёта самого буфера.
          const lvl = config.perFileVolume ? gainFor(f, idx) / 100 : 1;
          const chain = lvl === 1 ? undefined : (ctx, srcNode) => {
            const g = ctx.createGain();
            g.gain.value = lvl;
            srcNode.connect(g);
            return g;
          };
          player.play(buf, () => {}, () => {
            setFilePlayIcon(idx, false);
            if (filePlayingIndex === idx) filePlayingIndex = -1;
          }, undefined, chain);
        } catch (err) {
          setFilePlayIcon(idx, false);
          if (filePlayingIndex === idx) filePlayingIndex = -1;
          showError(labels.decodeErrorLabel);
        }
      });
    }

    function updateSel() {
      if (!waveShell) return;
      // Against the CANVAS, not the shell -- px2t already measures that way, and in the compact
      // player the canvas is inset by the play button and the time readout. Measured off the
      // shell the handles would sit a button's width away from the sound they point at, which is
      // the same mistake the playhead made before it was moved onto the canvas.
      const base = waveCanvas ? waveCanvas.offsetLeft : 0;
      const W = waveCanvas ? waveCanvas.clientWidth : waveShell.clientWidth;
      const x1 = base + (selStart / dur) * W;
      const x2 = base + (selEnd / dur) * W;
      if (selOverlay) { selOverlay.style.left = x1 + 'px'; selOverlay.style.width = (x2 - x1) + 'px'; }
      // Kept fully inside the shell, which clips its overflow. Centred on the edge, a handle at
      // 0:00 or at the very end lost half its width to the clip and could not be grabbed at all --
      // and the end of a recording is exactly the edge people drag in.
      const HW = 14;
      const shellW = waveShell.clientWidth;
      const clamp = (x) => Math.max(0, Math.min(shellW - HW, x - HW / 2));
      if (hStart) hStart.style.left = clamp(x1) + 'px';
      if (hEnd) hEnd.style.left = clamp(x2) + 'px';
      if (tStart) tStart.textContent = fmtTime(selStart);
      if (tEnd) tEnd.textContent = fmtTime(selEnd);
      if (tLen) tLen.textContent = fmtTime(selEnd - selStart);
      if (inStart) inStart.value = selStart.toFixed(1);
      if (inEnd) inEnd.value = selEnd.toFixed(1);
      // Every selection change -- drag, handle, typed number -- lands here, so this is the one
      // place that has to tell the export button whether there's anything to export yet.
      eqSyncState();
    }

    // Some containers (certain iPhone .MOV exports, some odd MP4 variants) fail the browser's
    // native decodeAudioData -- that used to fail silently on the ffmpeg-engine path and show
    // a generic error on the webaudio path, in both cases leaving the waveform/preview dead
    // even though the file itself was perfectly readable. Falling back to ffmpeg (which reads
    // raw bytes, not a browser codec) to transcode to WAV first makes decoding effectively
    // universal -- WAV always decodes cleanly afterwards.
    //
    // IMPORTANT: when the fallback runs, it REPLACES the module-level `file` with the small
    // decoded WAV (via the caller reassigning `file = ...` -- see pickFile below), so any
    // later ffmpeg export (e.g. clicking a ringtone target tile) processes that small WAV
    // instead of re-running ffmpeg on the original raw video a second time. Running ffmpeg.wasm
    // twice on a large video back-to-back is what caused a real "Out of bounds memory access"
    // crash on mobile Safari -- its WASM heap is tighter than desktop and didn't survive it.
    async function decodeFileRobust(f) {
      try {
        return { buffer: await decodeFile(f), replacementFile: null };
      } catch (e) {
        const blob = await execFFmpeg({
          inputs: [{ name: 'probe_in', file: f }],
          // Explicit codec/sample-rate/channel-count, not ffmpeg's implicit default -- if the
          // source's audio track happens to be something decodeAudioData can't handle (or
          // ffmpeg's default WAV muxing choice varies), leaving the format implicit meant the
          // SECOND decode (of ffmpeg's own output) could fail too. Forcing plain 16-bit PCM
          // stereo at 44.1kHz is about as universally decodable as a WAV can be.
          buildArgs: (names, out) => ['-i', names[0], '-vn', '-acodec', 'pcm_s16le', '-ar', '44100', '-ac', '2', out],
          outputName: 'probe_out.wav',
          mimeType: 'audio/wav',
        });
        // Done with ffmpeg for this large file -- drop the now memory-inflated instance so any
        // later export (e.g. an OGG ringtone target) starts from a fresh, right-sized one.
        resetFFmpeg();
        const wavFile = new File([blob], (f.name.replace(/\.[^.]+$/, '') || 'decoded') + '.wav', { type: 'audio/wav' });
        return { buffer: await decodeFile(wavFile), replacementFile: wavFile };
      }
    }

    // Explicit "remove this file" (the × on the file-info card) -- previously the only way to
    // change your mind was picking a replacement file; there was no way to just clear it.
    function resetFile() {
      file = null;
      resetPlaybackState();
      if (runBtn && config.abCompare) runBtn.disabled = true;
      if (presetCardsEl) presetCardsEl.querySelectorAll('.preset-card').forEach((c) => c.classList.remove('active'));
      if (presetDescEl) presetDescEl.style.display = 'none';
      fileInfo.innerHTML = '';
      // A tool whose input is a file falls back to the drop zone when the file goes. The
      // dictaphone has no drop zone -- its input is the microphone -- so hiding the panel took
      // the record button with it and left an empty page with no way to start again.
      if (config.controls === 'recorder') {
        const recTime = root.querySelector('#rec-time');
        const recState = root.querySelector('#rec-state');
        if (recTime) recTime.textContent = '0:00';
        if (recState) recState.textContent = labels.recIdleLabel;
        // Крестик = возврат в начало: место плеера снова пустует, формат и «Скачать» уходят,
        // красная кнопка возвращается. Место при этом НЕ освобождается -- высота та же.
        waveShell?.classList.add('is-empty');
        panel.classList.add('rec-empty');
        const сцена3 = root.querySelector('.rec-stage');
        if (сцена3) { сцена3.classList.remove('is-done', 'is-rec'); сцена3.classList.add('is-idle'); }
      } else {
        panel.classList.remove('on');
      }
      if (drop) drop.style.display = '';
      // У диктофона место плеера НЕ выключаем: оно остаётся занятым и пустым, иначе кнопка
      // записи прыгнет вверх, а именно это владелец и просил убрать.
      if (waveShell && config.controls !== 'recorder') waveShell.style.display = 'none';
      const fileMetaEl = root.querySelector('#file-meta');
      if (fileMetaEl) fileMetaEl.style.display = 'none';
      if (abCompareEl) abCompareEl.style.display = 'none';
      const vizPlayer = root.querySelector('#viz-player');
      if (vizPlayer) vizPlayer.style.display = 'none';
      if (abOriginalBtn) abOriginalBtn.classList.add('active');
      if (abResultBtn) { abResultBtn.disabled = true; abResultBtn.classList.remove('active'); }
      if (wavePlayBtn) wavePlayBtn.disabled = true;
      if (waveDurationEl) waveDurationEl.textContent = '0:00';
      if (listenBtn) listenBtn.disabled = true;
      clearError();
    }

    // Everything derived from the PREVIOUS file. Loading a new one has to run this or the
    // player keeps happily playing audio the user just replaced (or deleted): invalidateRender()
    // returns early for live-chain tools before it ever reaches player.reset(), and the ffmpeg
    // path never called it at all, so nothing was stopping playback on a new upload.
    function resetPlaybackState() {
      stopAB();
      player.reset();
      sourceBuffer = null;
      renderedBuffer = null;
      abPlayingBuffer = null;
      lastResultBuffer = null;
      lastResultBlob = null;
      lastResultPreset = null;
      waveSeekPos = null;
      dur = 0;
      if (wavePlayBtn) wavePlayBtn.disabled = true;
      if (abResultBtn) { abResultBtn.disabled = true; abResultBtn.classList.remove('active'); }
      if (abOriginalBtn) abOriginalBtn.classList.add('active');
      abSelected = config.abCompare ? 'original' : abSelected;
      if (transportCurEl) transportCurEl.textContent = '0:00';
      if (transportDurEl) transportDurEl.textContent = '0:00';
      // A rendered preview belongs to the file it was made from -- keeping it on screen after a
      // new upload would show one file's video next to another file's name.
      const vizVid = root.querySelector('#viz-video');
      if (vizVid) {
        vizVid.pause();
        vizVid.removeAttribute('src');
        vizVid.load();
        const stage = vizVid.closest('.viz-stage');
        if (stage) stage.classList.remove('has-video');
        const ph = root.querySelector('#viz-placeholder');
        if (ph) ph.style.display = 'flex';
        const note = root.querySelector('#viz-note');
        if (note) note.style.display = 'none';
        const est = root.querySelector('#viz-estimate');
        if (est) est.style.display = 'none';
        root.querySelectorAll('#viz-styles .preset-card').forEach((c) => c.classList.remove('active'));
      }
      // The export button is only ever enabled/disabled from here, and nothing re-ran it after a
      // file was removed -- so it stayed clickable with no source buffer behind it. Same CDP run
      // that caught the missing waveform caught this.
      eqSyncState();
    }

    async function pickFile(f) {
      clearError();
      resetPlaybackState();
      if (f.size > MAX_MB * 1024 * 1024) {
        showError(`File is larger than ${MAX_MB} MB.`);
        return;
      }
      if (config.controls === 'multi-file' || config.allowBatch) {
        if (config.allowBatch) {
          const maxFiles = config.maxBatchFiles || 20;
          const maxBatchMB = config.maxBatchMB || 2048;
          if (files.length >= maxFiles) {
            showError((labels.batchTooManyLabel || 'Max {n} files per batch.').replace('{n}', maxFiles));
            return;
          }
          const totalMB = (files.reduce((s, x) => s + x.size, 0) + f.size) / 1048576;
          if (totalMB > maxBatchMB) {
            showError((labels.batchTooLargeLabel || 'Batch total exceeds {n} MB.').replace('{n}', maxBatchMB));
            return;
          }
        }
        files.push(f);
        renderFileList();
        invalidateRender();
        // Микс считается сразу, а не по кнопке. Иначе под списком файлов пусто, ползунки
        // громкости двигаются вхолостую (менять нечего -- микса ещё нет), и понять, что вообще
        // происходит, можно только нажав кнопку, о необходимости которой ничто не говорит.
        if (config.perFileVolume) scheduleReMix(0);
        eqSyncState();
        panel.classList.add('on');
        if (drop) drop.style.display = 'none';
        if (files.length >= 1 && listenBtn) listenBtn.disabled = false;
        return;
      }
      file = f;
      const sizeMB = f.size / 1048576;
      // Actions on the file live on the file: swap and remove, two identical round targets.
      // A full-width "upload a different file" button lower down claimed an importance the
      // action doesn't have -- it's a correction, not a step. This branch only ever runs for
      // single-file tools (batch and merge have a per-item list with its own controls), so both
      // buttons belong here unconditionally.
      const canSwap = !!fileInput;
      const swapLabel = escapeHtml(labels.newFileLabel || 'Upload a different file');
      const removeLabel = escapeHtml(labels.removeFileLabel || 'Remove');
      fileInfo.innerHTML = `<div class="fi-row">${svgIco(ICO_WAVE, 'fi-ico')}<span class="fi-name">${escapeHtml(f.name)}</span>${canSwap ? `<button type="button" class="fi-act fi-swap" id="fi-swap-btn" aria-label="${swapLabel}" title="${swapLabel}">${svgIco(ICO_UPLOAD, 'i')}</button>` : ''}<button type="button" class="fi-act fi-remove" id="fi-remove-btn" aria-label="${removeLabel}" title="${removeLabel}">${svgIco(ICO_CLOSE, 'i')}</button></div>`;
      if (sizeMB > WARN_MB) {
        fileInfo.innerHTML += `<br><span style="color:#ffb020;font-size:12px;">${labels.largeFileWarningLabel}</span>`;
      }
      const fiRemoveBtn = root.querySelector('#fi-remove-btn');
      if (fiRemoveBtn) fiRemoveBtn.addEventListener('click', resetFile);
      const fiSwapBtn = root.querySelector('#fi-swap-btn');
      if (fiSwapBtn && fileInput) fiSwapBtn.addEventListener('click', () => fileInput.click());
      panel.classList.add('on');
      if (drop) drop.style.display = 'none';
      // resetFile() hides the player; nothing ever brought it back, so removing a file and then
      // loading another one left a tool with no waveform, no play button and no seek bar until
      // the page was reloaded. Confirmed in a real browser over CDP: after remove-then-add the
      // shell stayed display:none with the previous file's pixels still on the canvas. Restoring
      // it here, where the panel is revealed, keeps hide and show symmetric. Tools whose decode
      // fails hide it again a few lines below, which is the one case it should stay hidden.
      if (waveShell) waveShell.style.display = '';

      if (config.engine === 'ffmpeg') {
        loadFFmpeg().catch(() => {});
        // No waveform on this tool -> no decode at all. Read the duration from the file header
        // (instant), fill the info strip, and show the "pick a style" hint.
        if (config.noWaveform) {
          dur = await probeDuration(f);
          renderFileMeta(f);
          const playerEl = root.querySelector('#viz-player');
          if (playerEl) playerEl.style.display = 'block';
          return;
        }
        // Was gated on waveCanvas existing -- that broke the simple-preview tools entirely
        // (no canvas there, so this whole decode step, and with it sourceBuffer/dur, never ran
        // at all -- confirmed live: "Listen" did nothing). Gate on waveShell instead, which
        // exists for both the canvas and simple-preview variants; only the draw call itself
        // needs the canvas.
        if (waveShell) {
          showProgress(labels.decodingLabel || labels.preparingLabel, 25);
          try {
            const decoded = await decodeFileRobust(f);
            hideProgress();
            sourceBuffer = decoded.buffer;
            if (decoded.replacementFile) file = decoded.replacementFile;
            dur = sourceBuffer.duration;
            selStart = 0;
            selEnd = config.controls === 'ringtone-targets' ? Math.min(dur, MAX_RINGTONE_SEC) : dur;
            if (inStart) inStart.max = dur;
            if (inEnd) inEnd.max = dur;
            scheduleWaveformDraw(sourceBuffer);
            updateSel();
            // Show the A/B row as soon as there's something to listen to, not only after a
            // first successful process -- "Original" is a real, obvious play button from the
            // start; "Result" just starts disabled until something has actually been produced.
            if (config.abCompare && abCompareEl) {
              abCompareEl.style.display = 'flex';
              if (abResultBtn) { abResultBtn.disabled = true; abResultBtn.classList.remove('active'); }
              if (abOriginalBtn) abOriginalBtn.classList.add('active');
              if (wavePlayBtn) wavePlayBtn.disabled = false;
              if (waveDurationEl) waveDurationEl.textContent = fmtTime(dur).split('.')[0];
              if (runBtn) runBtn.disabled = true;
              if (presetCardsEl) presetCardsEl.querySelectorAll('.preset-card').forEach((c) => c.classList.remove('active'));
              if (presetDescEl) presetDescEl.style.display = 'none';
              abSelected = 'original';
              lastResultBuffer = null;
              lastResultBlob = null;
              lastResultPreset = null;
              waveSeekPos = null;
            }
            // Same for an ffmpeg tool with the compact player but no A/B switch: it has a decoded
            // buffer, so it can play it. video-to-audio was drawing a play button that could
            // never be pressed and a duration frozen at 0:00, because enabling both lived inside
            // the A/B branch above.
            if (config.compactPreview && !config.abCompare) {
              if (wavePlayBtn) wavePlayBtn.disabled = false;
              if (transportDurEl) transportDurEl.textContent = fmtClock(dur);
              if (transportCurEl) transportCurEl.textContent = '0:00';
            }
            renderFileMeta(f);
            // Список силы показывает "Лёгкая" с первой секунды -- значит лёгкая и должна быть
            // сделана. До этого не делалось ничего: событие change бывает только когда значение
            // МЕНЯЮТ, а показанное изначально его не вызывает. Получалось, что страница называет
            // силу, которую не применила, "Результат" не нажимается, а кнопка скачивания мертва,
            // и оживить всё это можно было только потрогав список -- о чём догадаться нельзя.
            //
            // Инструментов с карточками это не касается: там ни одна карточка не подсвечена, и
            // страница честно показывает, что выбор ещё не сделан.
            //
            // По времени это дёшево: очистка трёх минут звука занимает около двух секунд, и файл
            // ffmpeg всё равно уже качается на этом же шаге.
            if (config.abCompare && !config.presetCards && root.querySelector('#ctrl-select')) {
              runFfmpegProcess(false, null, { auto: true });
            }
          } catch (e) {
            // The waveform is a nice-to-have preview, not a requirement -- the Convert tool
            // never needed a successful browser decode to run ffmpeg directly on the raw file,
            // and it works fine even for files this same decode step can't handle. Ringtone
            // shouldn't be any more fragile than that: no waveform, but still make the file.
            sourceBuffer = null;
            dur = 0;
            if (waveShell) waveShell.style.display = 'none';
            const timesEl = root.querySelector('#times');
            if (timesEl) timesEl.style.display = 'none';
            const inputsRow = inStart ? inStart.closest('.row') : null;
            if (inputsRow) inputsRow.style.display = 'none';
            hideProgress();
            showError(labels.noPreviewLabel || labels.decodeErrorLabel);
          }
        }
        return;
      }

      // Only the decode itself is guarded. This used to wrap the UI setup below too, so ANY
      // scripting bug in that setup was reported to the user as "couldn't read this file" on a
      // perfectly valid MP3 -- which is exactly how a load-order bug in the EQ wiring disguised
      // itself. A real decode failure still gets the real message; a code bug now surfaces as a
      // code bug instead of blaming the user's file.
      let decoded;
      // Decoding a longer file takes a few seconds, during which the play button is necessarily
      // disabled -- with no feedback that read as a dead button rather than as "still loading".
      showProgress(labels.decodingLabel || labels.preparingLabel, 25);
      try {
        decoded = await decodeFileRobust(f);
      } catch (e) {
        hideProgress();
        showError(labels.decodeErrorLabel);
        return;
      }
      hideProgress();
      {
        sourceBuffer = decoded.buffer;
        if (decoded.replacementFile) file = decoded.replacementFile;
        dur = sourceBuffer.duration;
        selStart = 0;
        selEnd = dur;
        if (inStart) inStart.max = dur;
        if (inEnd) inEnd.max = dur;
        scheduleWaveformDraw(sourceBuffer);
        if (listenBtn) listenBtn.disabled = false;
        invalidateRender();
        // Live-graph tools (EQ, fade) and render-on-demand tools (pitch, voice) both have their
        // A/B halves and transport usable the moment a file decodes -- the latter just render
        // lazily the first time the processed side is actually asked for.
        // True of any decoded file, whatever the tool does with it. These used to sit inside the
        // A/B branch below, so trim -- which is neither a live-chain nor an A/B tool -- decoded a
        // file and then showed no info strip and never re-evaluated its export button.
        exportedClean = false;
        renderFileMeta(f);
        eqSyncState();
        syncSourceNote();
        // Anything with the compact player can play the file it just decoded, whether or not the
        // tool has a processed side yet. Enabling this only for A/B tools left video-to-audio
        // drawing a play button that could never be pressed and a duration stuck at 0:00.
        if (config.compactPreview) {
          if (wavePlayBtn) wavePlayBtn.disabled = false;
          if (transportDurEl) transportDurEl.textContent = fmtClock(dur);
          if (transportCurEl) transportCurEl.textContent = '0:00';
        }
        if (rateStateSync) rateStateSync();
        if (LIVE_CHAIN_TOOLS[config.controls] || isRenderedAb) {
          if (abCompareEl) abCompareEl.style.display = 'flex';
          if (abResultBtn) abResultBtn.disabled = false;
          if (rateStateSync) rateStateSync();
          updateFadeRegions();
        }
      }
    }

    // Generator tools (white noise, pink noise) have no file to drop -- pickFile(), the only
    // place that reveals .panel, never runs for them. Confirmed live: the page was genuinely
    // blank (no duration field, no Generate button) until this.
    if (config.controls === 'generator') panel.classList.add('on');

    // ---- Noise generators ---------------------------------------------------------------------
    if (config.controls === 'noise') {
      panel.classList.add('on');
      const noisePlayBtn = root.querySelector('#noise-play-btn');
      const noisePlayIco = root.querySelector('#noise-play-ico');
      const noiseState = root.querySelector('#noise-state');
      const noiseVolume = root.querySelector('#noise-volume');
      const noiseVolumeVal = root.querySelector('#noise-volume-val');
      const noiseTimerRow = root.querySelector('#noise-timer');
      const noiseLengthsRow = root.querySelector('#noise-lengths');
      const noiseDownloadBtn = root.querySelector('#noise-download-btn');
      const noiseSizeNote = root.querySelector('#noise-size-note');
      const noiseFormat = root.querySelector('#tool-format');

      let loopBuffer = null;
      let noiseGain = null;
      let timerHandle = 0;
      let timerMinutes = 0;

      const vol = () => Number(noiseVolume.value) / 100;
      // Generated once and reused: it is the same loop whether you listen for a minute or all
      // night, and the same loop the downloaded file is built from.
      const getLoop = () => (loopBuffer || (loopBuffer = makeNoiseLoop(config.color, 10, 44100, 2)));

      function clearTimer() {
        if (timerHandle) { clearTimeout(timerHandle); timerHandle = 0; }
      }
      function stopNoise(fading) {
        clearTimer();
        player.stop();
        noiseGain = null;
        noisePlayIco.innerHTML = ICO_PLAY;
        noiseState.textContent = fading ? labels.noiseTimerDoneLabel : labels.noiseIdleLabel;
      }
      function armTimer() {
        clearTimer();
        if (!timerMinutes) return;
        const total = timerMinutes * 60 * 1000;
        const fadeMs = 15000;
        timerHandle = setTimeout(() => {
          // Fade out rather than cut: the point of a sleep timer is not to wake anyone up.
          if (noiseGain) {
            const now = noiseGain.context.currentTime;
            noiseGain.gain.cancelScheduledValues(now);
            noiseGain.gain.setValueAtTime(noiseGain.gain.value, now);
            noiseGain.gain.linearRampToValueAtTime(0.0001, now + fadeMs / 1000);
          }
          timerHandle = setTimeout(() => stopNoise(true), fadeMs);
        }, Math.max(0, total - fadeMs));
      }
      function startNoise() {
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        player.unlock();
        const buf = getLoop();
        noisePlayIco.innerHTML = ICO_PAUSE;
        noiseState.textContent = timerMinutes
          ? (labels.noisePlayingTimerLabel || '').replace('{n}', String(timerMinutes))
          : labels.noisePlayingLabel;
        player.play(
          buf,
          null,
          () => { noisePlayIco.innerHTML = ICO_PLAY; noiseState.textContent = labels.noiseIdleLabel; },
          0,
          (ctx, src) => {
            noiseGain = ctx.createGain();
            noiseGain.gain.value = vol();
            src.connect(noiseGain);
            return noiseGain;
          },
          { loop: true }
        );
        armTimer();
      }
      noisePlayBtn.addEventListener('click', () => {
        if (player.isPlaying()) stopNoise(false);
        else startNoise();
      });
      noiseVolume.addEventListener('input', () => {
        noiseVolumeVal.textContent = noiseVolume.value + '%';
        // Applied live, no restart -- adjusting the level of something already playing is the
        // whole point of a volume control here.
        if (noiseGain) noiseGain.gain.value = vol();
      });
      noiseTimerRow.addEventListener('click', (e) => {
        const btn = e.target.closest('.preset-btn');
        if (!btn) return;
        noiseTimerRow.querySelectorAll('.preset-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        timerMinutes = Number(btn.dataset.min) || 0;
        if (player.isPlaying()) {
          noiseState.textContent = timerMinutes
            ? (labels.noisePlayingTimerLabel || '').replace('{n}', String(timerMinutes))
            : labels.noisePlayingLabel;
          armTimer();
        }
      });

      const selectedSeconds = () => {
        const active = noiseLengthsRow.querySelector('.preset-btn.active');
        return Number(active ? active.dataset.sec : config.downloadLengths[0]);
      };
      function updateSizeNote() {
        const secs = selectedSeconds();
        const fmt = noiseFormat ? noiseFormat.value : 'mp3';
        // Stereo 16-bit at 44.1 kHz for WAV; 128 kbps for MP3. Both are exact, not guesses.
        const bytes = fmt === 'wav' ? secs * 44100 * 2 * 2 : (128000 / 8) * secs;
        const mb = bytes / 1048576;
        const size = mb >= 1 ? mb.toFixed(0) + ' ' + (labels.unitMB || 'MB')
          : Math.max(1, Math.round(bytes / 1024)) + ' ' + (labels.unitKB || 'KB');
        noiseSizeNote.textContent = (labels.noiseSizeNote || '').replace('{size}', size);
      }
      noiseLengthsRow.addEventListener('click', (e) => {
        const btn = e.target.closest('.preset-btn');
        if (!btn) return;
        noiseLengthsRow.querySelectorAll('.preset-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        updateSizeNote();
      });
      if (noiseFormat) noiseFormat.addEventListener('change', updateSizeNote);
      updateSizeNote();

      noiseDownloadBtn.addEventListener('click', async () => {
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        clearError();
        noiseDownloadBtn.disabled = true;
        showProgress(labels.workingLabel, 30);
        try {
          const secs = selectedSeconds();
          const fmt = noiseFormat ? noiseFormat.value : 'mp3';
          const loop = getLoop();
          const total = Math.round(secs * loop.sampleRate);
          const blob = fmt === 'wav'
            ? encodeLoopedWAV(loop, total)
            : await encodeLoopedMP3(loop, total, 128);
          finishProgress(labels.doneLabel);
          downloadBlob(blob, `${tool}-${secs >= 60 ? secs / 60 + 'min' : secs + 's'}.${fmt}`);
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
          hideProgress();
        }
        noiseDownloadBtn.disabled = false;
      });
    }
    // No result yet to show a waveform of -- revealResultWaveform() un-hides this once
    // generate/merge actually produces a buffer.
    if ((config.controls === 'generator' || config.controls === 'multi-file') && waveShell) {
      waveShell.style.display = 'none';
    }
    // ДИКТОФОН: место плеера занято С САМОГО НАЧАЛА и пустует, а не выключается из разметки.
    // Раньше здесь стоял display:none, и появление плеера расталкивало всё вокруг -- владелец
    // 16.08.2026: «у нас в плеере всё прыгает, смещается, просто ужас». Высота остаётся
    // постоянной на всех трёх состояниях: пусто -> волна во время записи -> запись готова.
    if (config.controls === 'recorder' && waveShell) {
      waveShell.classList.add('is-empty');
      root.classList.add('is-recorder');
      root.querySelector('.rec-stage')?.classList.add('is-idle');
      // Строка «Начало / Длительность / Конец» лежит не рядом с волной, соседним правилом её
      // не достать -- помечаем саму панель. Прячем ВИДИМОСТЬЮ: место остаётся занятым,
      // высота не меняется, ничего не сдвинется, когда строка появится.
      root.querySelector('#audio-panel')?.classList.add('rec-empty');
    }

    // ---- Report-only tools -------------------------------------------------------------------
    if (config.controls === 'analyze') {
      const analysisEl = root.querySelector('#analysis');
      rateStateSync = () => {
        if (!analysisEl) return;
        if (!sourceBuffer) { analysisEl.innerHTML = ''; return; }
        showProgress(labels.workingLabel, 40);
        // A frame, so the progress line actually paints before a second of analysis blocks it.
        requestAnimationFrame(() => {
          let report;
          try {
            report = config.report({ buffer: sourceBuffer, labels, tools: { analyzeVocalRange, detectKey, analyzeAudiobook } });
          } catch (err) {
            hideProgress();
            showError(err && err.message ? err.message : String(err));
            return;
          }
          hideProgress();
          if (!report) { analysisEl.innerHTML = `<div class="an-empty">${escapeHtml(labels.analysisEmptyLabel || '')}</div>`; return; }
          const rows = (report.rows || []).map((r) => {
            const state = r.state ? ` an-${r.state}` : '';
            return `<div class="an-row${state}"><span class="an-label">${escapeHtml(r.label)}</span><span class="an-value">${escapeHtml(String(r.value))}</span></div>`;
          }).join('');
          analysisEl.innerHTML = (report.headline ? `<div class="an-headline">${escapeHtml(report.headline)}</div>` : '')
            + `<div class="an-rows">${rows}</div>`
            + (report.hint ? `<div class="an-hint">${escapeHtml(report.hint)}</div>` : '');
        });
      };
    }

    // ---- Tempo -----------------------------------------------------------------------------
    if (config.controls === 'tempo') {
      // Обработчик регистрируется в ТОМ ЖЕ движке, где играет плеер: в чужом он не считается.
      player.unlock();
      player.context().audioWorklet.addModule('/audio-stretch-worklet.js')
        .then(() => { tempoCtxLoaded = true; }).catch(() => {});
      const fromEl = root.querySelector('#ctrl-bpm-from');
      const toEl = root.querySelector('#ctrl-bpm-to');
      // Пересчёт не на каждое нажатие плюсика, а когда человек перестал тыкать. Раньше
      // каждый шаг помечал результат устаревшим и запускал тяжёлый расчёт -- отсюда
      // ощущение, что инструмент думает после каждого нажатия.
      let bpmTimer = 0;
      const onChange = () => {
        // Звучащий обработчик подхватывает новое значение сразу -- звук не рвётся.
        if (tempoNode) { try { tempoNode.parameters.get('speed').value = tempoRatio(); } catch (e) {} }
        clearTimeout(bpmTimer);
        bpmTimer = setTimeout(() => { invalidateRender(); syncSourceNote(); eqSyncState(); }, 350);
      };
      toEl.addEventListener('input', onChange);
      // Темп определяется САМ при загрузке файла и подставляется в поле показа. Прежде там
      // всегда стояло 120, и это выглядело как темп загруженной песни.
      rateStateSync = () => {
        if (sourceBuffer && !fromEl.dataset.done) {
          fromEl.dataset.done = '1';
          const bpm = detectBpm(sourceBuffer);
          if (bpm) {
            fromEl.value = String(bpm);
            if (Number(toEl.value) === 120) toEl.value = String(bpm);
          }
        }
        if (!sourceBuffer) delete fromEl.dataset.done;
        syncSourceNote(); eqSyncState();
      };
    }

    // ---- Split into parts --------------------------------------------------------------------
    if (config.controls === 'split') {
      const modeSel = root.querySelector('#ctrl-split-mode');
      const valueEl = root.querySelector('#ctrl-split-value');
      const valueLabel = root.querySelector('#ctrl-split-value-label');
      const splitFmt = root.querySelector('#split-format');
      const splitBtn = root.querySelector('#split-download-btn');

      function syncSplitUi() {
        const byDuration = modeSel.value === 'duration';
        valueLabel.textContent = byDuration ? labels.splitMinutesLabel : labels.splitPartsCountLabel;
        valueEl.min = byDuration ? '1' : '2';
        valueEl.max = byDuration ? '120' : '50';
        if (byDuration && Number(valueEl.value) < 1) valueEl.value = '5';
        if (!byDuration && Number(valueEl.value) < 2) valueEl.value = '2';
        splitBtn.disabled = !sourceBuffer;
        syncSourceNote();
      }
      modeSel.addEventListener('change', syncSplitUi);
      valueEl.addEventListener('input', syncSplitUi);
      // Re-run once a file has decoded, so the plan describes the real duration.
      rateStateSync = syncSplitUi;

      splitBtn.addEventListener('click', async () => {
        if (!sourceBuffer) return;
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        clearError();
        splitBtn.disabled = true;
        showProgress(labels.workingLabel, 5);
        try {
          const parts = splitPlan(sourceBuffer.duration, readParams());
          const fmt = splitFmt.value;
          const base = (file && file.name.replace(/\.[^.]+$/, '')) || 'audio';
          const { default: JSZip } = await import('jszip');
          const zip = new JSZip();
          const pad = String(parts.length).length;
          for (let i = 0; i < parts.length; i++) {
            const clip = sliceBuffer(sourceBuffer, parts[i].start, parts[i].end);
            const blob = fmt === 'mp3' ? await encodeMP3(clip, 192) : encodeWAV(clip);
            zip.file(`${base}-${String(i + 1).padStart(pad, '0')}.${fmt}`, blob);
            progressFill.style.width = Math.round(5 + (i + 1) / parts.length * 85) + '%';
            progressText.textContent = `${labels.workingLabel} ${i + 1}/${parts.length}`;
            // Yield, so a long file doesn't freeze the page while it encodes.
            await new Promise((res) => setTimeout(res, 0));
          }
          progressText.textContent = labels.batchZippingLabel || 'ZIP…';
          const zipBlob = await zip.generateAsync({ type: 'blob' });
          finishProgress(labels.doneLabel);
          downloadBlob(zipBlob, `${base}-parts.zip`);
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
          hideProgress();
        }
        splitBtn.disabled = !sourceBuffer;
      });
    }

    // ---- Dictaphone -------------------------------------------------------------------------
    if (config.controls === 'recorder') {
      panel.classList.add('on');
      const recBtn = root.querySelector('#rec-btn');
      const recPauseBtn = root.querySelector('#rec-pause');
      const recPauseIco = root.querySelector('#rec-pause-ico');
      const recPlayBtn = root.querySelector('#rec-play');
      const recPlayIco = root.querySelector('#rec-play-ico');
      const recTimeEl = root.querySelector('#rec-time');
      const recStateEl = root.querySelector('#rec-state');
      const meterEl = root.querySelector('#rec-meter');
      const meterFill = root.querySelector('#rec-meter-fill');
      let mediaStream = null;
      let recorder = null;
      let chunks = [];
      let tick = 0;
      // Elapsed time has to exclude the pauses, so it is accumulated per segment rather than
      // measured from a single start stamp -- otherwise a two-minute pause would be counted as
      // two minutes of recording and the timer would disagree with the file.
      let recordedMs = 0;
      let segmentStart = 0;
      let meterCtx = null;
      let meterRaf = 0;

      function stopTimer() { if (tick) { clearInterval(tick); tick = 0; } }
      function elapsedMs() {
        return recordedMs + (segmentStart ? Date.now() - segmentStart : 0);
      }
      function showTime() {
        const secs = Math.floor(elapsedMs() / 1000);
        recTimeEl.textContent = `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`;
      }
      function setRecording(on, paused) {
        // Три состояния диктофона, и в каждом свой набор кнопок. Прячем ВИДИМОСТЬЮ:
        // высота ряда и всей панели одна и та же, ничего не сдвигается (правило владельца).
        //   покой  -- только красная;
        //   запись -- красная (теперь «стоп») и пауза;
        //   готово -- красной нет, есть плей и пауза плеера, формат и «Скачать».
        const сцена = root.querySelector('.rec-stage');
        if (сцена) {
          сцена.classList.toggle('is-rec', !!on);
          if (on) сцена.classList.remove('is-done');
        }
        recBtn.classList.toggle('recording', on);
        recStateEl.textContent = on
          ? (paused ? labels.recPausedLabel : labels.recRecordingLabel)
          : labels.recIdleLabel;
        recBtn.setAttribute('aria-label', on ? labels.recStopLabel : labels.recStartLabel);
        recPauseBtn.disabled = !on;
        recPauseIco.innerHTML = paused ? ICO_PLAY : ICO_PAUSE_SOLID;
        recPauseBtn.setAttribute('aria-label', paused ? labels.recResumeLabel : labels.recPauseLabel);
        if (meterEl) meterEl.classList.toggle('on', on && !paused);
        // Инструменты обрезки на этой же панели: ручки выделения и строка "начало / длительность
        // / конец". Пока запись идёт, обрезать нечего -- длительность ещё не известна, -- и они
        // показывали ручку прямо на живой волне и три нуля под ней. Прячутся до остановки.
        panel.classList.toggle('is-recording', on);
      }
      // Волна во время записи. Пока её не было, единственным признаком, что микрофон слышит,
      // оставалась тонкая полоска уровня -- по ней не видно ни того, что уже записано, ни где
      // были паузы. Панель с волной прячется до появления файла, поэтому на время записи её
      // приходится показать самим; когда запись остановится, pickFile нарисует поверх волну
      // готового файла на том же месте.
      const liveWave = waveCanvas ? createLiveWaveform(waveCanvas) : null;
      function startLiveWave() {
        if (!liveWave) return;
        // Место уже занято и видно -- снимаем только «пустой» вид, ничего не показываем
        // заново. Именно поэтому при начале записи ничего не сдвигается.
        if (waveShell) { waveShell.style.display = ''; waveShell.classList.remove('is-empty'); }
        liveWave.start();
      }
      function stopLiveWave() { if (liveWave) liveWave.stop(); }

      function startMeter(stream) {
        stopMeter();
        try {
          meterCtx = new (window.AudioContext || window.webkitAudioContext)();
          const src = meterCtx.createMediaStreamSource(stream);
          const an = meterCtx.createAnalyser();
          an.fftSize = 1024;
          src.connect(an);
          const buf = new Float32Array(an.fftSize);
          let shown = 0;
          const draw = () => {
            an.getFloatTimeDomainData(buf);
            let peak = 0;
            for (const v of buf) { const a = Math.abs(v); if (a > peak) peak = a; }
            // Falls back gently rather than snapping to zero between syllables, so the bar reads
            // as a level and not as a strobe.
            shown = Math.max(peak, shown * 0.88);
            meterFill.style.width = Math.min(100, shown * 140) + '%';
            meterFill.classList.toggle('hot', shown > 0.92);
            // Тот же замер идёт и в живую волну. В неё кладётся сырой пик, а не сглаженный:
            // сглаживание нужно полоске, чтобы она не мигала между слогами, а волне наоборот --
            // по ней читают, где были слова, а где паузы.
            if (liveWave) liveWave.push(Math.min(1, peak * 1.4));
            meterRaf = requestAnimationFrame(draw);
          };
          draw();
        } catch (e) { /* a level bar is a nicety; never let it stop a recording */ }
      }
      function stopMeter() {
        cancelAnimationFrame(meterRaf);
        meterRaf = 0;
        if (meterFill) { meterFill.style.width = '0%'; meterFill.classList.remove('hot'); }
        if (meterCtx) { try { meterCtx.close(); } catch (e) {} meterCtx = null; }
      }

      recBtn.addEventListener('click', async () => {
        if (recorder && recorder.state !== 'inactive') { recorder.stop(); return; }
        clearError();
        // Asked for on the click, so the browser attributes the permission prompt to a gesture.
        try {
          mediaStream = await navigator.mediaDevices.getUserMedia({
            // Automatic gain stays ON. It was off here, on the reasoning that the browser's
            // levelling is tuned for calls and pumps a recording you mean to edit. That reasoning
            // is right for capturing music and wrong for this tool: a dictaphone records voice --
            // memos, lectures, interviews -- and every phone recorder levels it. Off, the same
            // microphone at the same system volume produced a file audibly quieter than other
            // sites, which is what the owner reported after comparing them side by side.
            //
            // Echo cancellation stays off: nothing is playing back, and it costs high frequencies.
            // Noise suppression stays off: there is a dedicated tool for that, and it can't be undone.
            audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: true },
          });
        } catch (e) {
          showError(labels.micDeniedLabel);
          return;
        }
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        chunks = [];
        recordedMs = 0;
        recorder = new MediaRecorder(mediaStream);
        recorder.ondataavailable = (e) => { if (e.data && e.data.size) chunks.push(e.data); };
        recorder.onstop = async () => {
          stopTimer();
          stopMeter();
          stopLiveWave();
          segmentStart = 0;
          setRecording(false, false);
          mediaStream.getTracks().forEach((t) => t.stop());
          const blob = new Blob(chunks, { type: recorder.mimeType || 'audio/webm' });
          const ext = (recorder.mimeType || '').includes('ogg') ? 'ogg' : 'webm';
          // From here it is just a file: pickFile draws the waveform, fills the info strip and
          // enables the export bar exactly as it would for an upload.
          await pickFile(new File([blob], `recording.${ext}`, { type: blob.type }));
          // Запись готова: место плеера перестаёт быть пустым, появляются формат и «Скачать»,
          // красная кнопка уходит, её сменяют плей и пауза. Высота при этом та же -- меняется
          // только видимость, поэтому страница не дёргается.
          waveShell?.classList.remove('is-empty');
          root.querySelector('#audio-panel')?.classList.remove('rec-empty');
          const сцена2 = root.querySelector('.rec-stage');
          if (сцена2) { сцена2.classList.remove('is-idle', 'is-rec'); сцена2.classList.add('is-done'); }
          // Second line of defence for the level. autoGainControl above covers desktop, but Safari
          // on iPhone ignores that constraint entirely, so a phone recording would still arrive
          // quiet. Here the finished take is measured and lifted to just under the ceiling.
          // Everything downstream reads sourceBuffer -- playback, the handles, the export -- so
          // lifting it here is enough; only the drawn waveform has to be told to redraw.
          if (sourceBuffer) {
            const gain = normalizeGain(peakOf(sourceBuffer));
            if (gain > 1.01) {
              sourceBuffer = scaleVolume(sourceBuffer, gain);
              scheduleWaveformDraw(sourceBuffer);
            }
          }
          if (recPlayBtn) recPlayBtn.disabled = !sourceBuffer;
        };
        recorder.start();
        segmentStart = Date.now();
        setRecording(true, false);
        startLiveWave();
        if (recPlayBtn) recPlayBtn.disabled = true;
        recTimeEl.textContent = '0:00';
        startMeter(mediaStream);
        tick = setInterval(showTime, 250);
      });

      // Pause and carry on. MediaRecorder keeps the same output, so the parts join seamlessly --
      // there is no second file and nothing to stitch afterwards.
      recPauseBtn.addEventListener('click', () => {
        if (!recorder || recorder.state === 'inactive') return;
        if (recorder.state === 'recording') {
          recorder.pause();
          recordedMs += Date.now() - segmentStart;
          segmentStart = 0;
          stopMeter();
          // Волна замирает на паузе, но не стирается: то, что уже записано, остаётся на экране.
          stopLiveWave();
          setRecording(true, true);
        } else {
          recorder.resume();
          segmentStart = Date.now();
          startMeter(mediaStream);
          // Волна оживает снова. start() чистит историю -- на паузе она и так уже замерла, а
          // склеивать две части в одной картинке было бы враньём: между ними пропуск.
          startLiveWave();
          setRecording(true, false);
        }
        showTime();
      });

      // Plays the part between the handles, so what you hear is what will be saved.
      recPlayBtn.addEventListener('click', () => {
        if (!sourceBuffer) return;
        player.unlock();
        if (player.isPlaying()) {
          player.pause();
          recPlayIco.innerHTML = ICO_PLAY;
          return;
        }
        recPlayIco.innerHTML = ICO_PAUSE_SOLID;
        const from = Math.max(0, selStart);
        const to = selEnd > from + 0.05 ? selEnd : sourceBuffer.duration;
        player.play(
          sliceBuffer(sourceBuffer, from, to),
          (frac) => setPlayheadTime(from + (to - from) * frac),
          () => { recPlayIco.innerHTML = ICO_PLAY; if (playhead) playhead.style.display = 'none'; player.reset(); }
        );
      });

    }

    if (drop) {
      drop.addEventListener('click', () => fileInput.click());
      drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
      drop.addEventListener('dragleave', () => drop.classList.remove('over'));
      drop.addEventListener('drop', (e) => {
        e.preventDefault();
        drop.classList.remove('over');
        Array.from(e.dataTransfer.files).forEach(pickFile);
      });
    }
    if (fileInput) {
      fileInput.addEventListener('change', (e) => {
        Array.from(e.target.files).forEach(pickFile);
        fileInput.value = '';
      });
    }
    // "Upload a different file" is the swap button on the file chip now, wired up in pickFile
    // where the chip is built. Batch tools keep their own Add button.
    if (addBtn) addBtn.addEventListener('click', () => fileInput.click());


    // Drag handles for trim-style tools.
    let dragging = null;
    let moveStartT = 0;
    let moveSelStart = 0;
    let moveSelEnd = 0;
    // Uses waveCanvas's own box, not waveShell's -- the compact preview (enhance) has a play
    // button sitting inside wave-shell before the canvas, so wave-shell's box no longer matches
    // where the waveform actually starts. Falls back to waveShell for simple-preview tools
    // (convert etc.), which have no canvas at all -- that surface has no other siblings anyway.
    function px2t(clientX) {
      const el = waveCanvas || waveShell;
      const r = el.getBoundingClientRect();
      const x = Math.max(0, Math.min(r.width, clientX - r.left));
      return (x / r.width) * dur;
    }
    // Moves the playhead marker to time `t`. The marker is positioned absolute inside
    // wave-shell (its nearest positioned ancestor), so its `left` has to be measured from
    // wave-shell's edge even though the fraction itself is computed against the canvas --
    // waveCanvas.offsetLeft bridges the two (0 for every non-compact tool, since the canvas
    // there fills wave-shell with nothing before it).
    function setPlayheadTime(t) {
      if (dur <= 0) return;
      setPlayheadFrac(t / dur);
    }
    // Fraction of the way through whatever is playing, NOT seconds against the original's
    // duration. The speed tool's processed side is a different length from the original, so
    // a seconds-based position would drift -- at 2x the marker would only reach halfway.
    function setPlayheadFrac(frac) {
      if (!playhead || !waveShell) return;
      const base = waveCanvas ? waveCanvas.offsetLeft : 0;
      const W = waveCanvas ? waveCanvas.clientWidth : waveShell.clientWidth;
      playhead.style.left = (base + Math.max(0, Math.min(1, frac)) * W) + 'px';
      playhead.style.display = 'block';
    }
    function maxSelLen() {
      return config.controls === 'ringtone-targets' ? MAX_RINGTONE_SEC : Infinity;
    }
    function onDrag(e) {
      if (!dragging) return;
      const cx = e.touches ? e.touches[0].clientX : e.clientX;
      const t = px2t(cx);
      const maxLen = maxSelLen();
      if (dragging === 'move') {
        const delta = t - moveStartT;
        const len = moveSelEnd - moveSelStart;
        let newStart = moveSelStart + delta;
        newStart = Math.max(0, Math.min(dur - len, newStart));
        selStart = newStart;
        selEnd = newStart + len;
      } else {
        if (dragging === 'start') selStart = Math.min(t, selEnd - 0.1);
        else selEnd = Math.max(t, selStart + 0.1);
        selStart = Math.max(0, selStart);
        selEnd = Math.min(dur, selEnd);
        if (selEnd - selStart > maxLen) {
          if (dragging === 'start') selStart = selEnd - maxLen;
          else selEnd = selStart + maxLen;
        }
      }
      updateSel();
      invalidateRender();
    }
    function endDrag() {
      dragging = null;
      document.removeEventListener('mousemove', onDrag);
      document.removeEventListener('touchmove', onDrag);
      document.removeEventListener('mouseup', endDrag);
      document.removeEventListener('touchend', endDrag);
    }
    function startDrag(which) {
      return (e) => {
        e.preventDefault();
        dragging = which;
        if (which === 'move') {
          const cx = e.touches ? e.touches[0].clientX : e.clientX;
          moveStartT = px2t(cx);
          moveSelStart = selStart;
          moveSelEnd = selEnd;
        }
        document.addEventListener('mousemove', onDrag);
        document.addEventListener('touchmove', onDrag, { passive: false });
        document.addEventListener('mouseup', endDrag);
        document.addEventListener('touchend', endDrag);
      };
    }
    if (hStart) { hStart.addEventListener('mousedown', startDrag('start')); hStart.addEventListener('touchstart', startDrag('start'), { passive: false }); }
    if (hEnd) { hEnd.addEventListener('mousedown', startDrag('end')); hEnd.addEventListener('touchstart', startDrag('end'), { passive: false }); }
    if (selOverlay) {
      selOverlay.style.cursor = 'grab';
      selOverlay.style.pointerEvents = 'auto';
      selOverlay.addEventListener('mousedown', startDrag('move'));
      selOverlay.addEventListener('touchstart', startDrag('move'), { passive: false });
    }

    // Typed start/end (seconds) -- kept in sync both ways with the drag handles, matching
    // LeebTTS's editor exactly instead of leaving the selection drag-only.
    if (inStart) {
      inStart.addEventListener('input', () => {
        if (!dur) return;
        let v = parseFloat(inStart.value) || 0;
        v = Math.max(0, Math.min(v, selEnd - 0.1));
        v = Math.max(v, selEnd - maxSelLen());
        selStart = v;
        updateSel();
        invalidateRender();
      });
    }
    if (inEnd) {
      inEnd.addEventListener('input', () => {
        if (!dur) return;
        let v = parseFloat(inEnd.value) || 0;
        v = Math.max(selStart + 0.1, Math.min(v, dur));
        v = Math.min(v, selStart + maxSelLen());
        selEnd = v;
        updateSel();
        invalidateRender();
      });
    }

    // "Listen to selection" -- plays just the selected slice directly (no render step), with
    // click-anywhere-in-the-selection seeking, matching the ringtone/trim editor pattern.
    if (listenSelBtn) {
      listenSelBtn.addEventListener('click', async () => {
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        if (player.isPlaying()) {
          player.pause();
          listenSelIco.innerHTML = ICO_PLAY;
          return;
        }
        player.unlock();
        if (!sourceBuffer || selEnd - selStart < 0.05) return;
        // Trim previews the actual export -- the same directRender the download runs -- so fades
        // and cut-out are audible before committing. With cut-out on, the selection is the part
        // being thrown away, so previewing the selection would play exactly the wrong audio.
        if (config.controls === 'trim') {
          listenSelIco.innerHTML = ICO_PAUSE;
          let result;
          try {
            result = await doRender();
          } catch (err) {
            listenSelIco.innerHTML = ICO_PLAY;
            showError(err && err.message ? err.message : String(err));
            return;
          }
          const cutting = !!(root.querySelector('#ctrl-cutout') || {}).checked;
          const resultDur = result.duration;
          player.play(
            result,
            (frac) => {
              const t = frac * resultDur;
              // Map result time back onto the source waveform. When cutting out, the result is
              // the two surviving halves joined, so past the cut point the playhead jumps the
              // removed region -- which shows what "cut out" means better than any label.
              setPlayheadTime(cutting ? (t < selStart ? t : selEnd + (t - selStart)) : selStart + t);
            },
            () => { listenSelIco.innerHTML = ICO_PLAY; playhead.style.display = 'none'; player.reset(); }
          );
          return;
        }
        listenSelIco.innerHTML = ICO_PAUSE;
        let slice = sliceBuffer(sourceBuffer, selStart, selEnd);
        const rtVolumeEl2 = root.querySelector('#rt-volume');
        if (rtVolumeEl2) slice = scaleVolume(slice, Number(rtVolumeEl2.value) / 100);
        const chkFadeIn = root.querySelector('#chk-fadein');
        const chkFadeOut = root.querySelector('#chk-fadeout');
        if (chkFadeIn && chkFadeOut && (chkFadeIn.checked || chkFadeOut.checked)) {
          slice = await applyFade(slice, chkFadeIn.checked ? 1 : 0, chkFadeOut.checked ? 2 : 0);
        }
        player.play(
          slice,
          (frac) => {
            setPlayheadTime(selStart + (selEnd - selStart) * frac);
          },
          () => { listenSelIco.innerHTML = ICO_PLAY; playhead.style.display = 'none'; player.reset(); }
        );
      });
    }
    // format/bitrate: hide bitrate field for lossless formats
    const fmtSel = root.querySelector('#ctrl-format');
    const bitrateField = root.querySelector('#bitrate-field');
    const formatHint = root.querySelector('#format-hint');
    if (fmtSel && bitrateField) {
      fmtSel.addEventListener('change', () => {
        bitrateField.style.display = ['wav', 'flac', 'aiff'].includes(fmtSel.value) ? 'none' : '';
        if (formatHint && labels.formatHints) formatHint.textContent = labels.formatHints[fmtSel.value] || '';
      });
    }

    const presetCardsEl = root.querySelector('#preset-cards');
    const presetDescEl = root.querySelector('#preset-desc');
    const heroAutoBtn = root.querySelector('#hero-auto-btn');
    function updatePresetDesc(value) {
      if (!presetDescEl || !config.selectOptions) return;
      const opt = config.selectOptions.find((o) => o.value === value);
      const text = opt && opt.desc ? labels[opt.desc] : null;
      if (text) { presetDescEl.textContent = text; presetDescEl.style.display = 'block'; }
      else presetDescEl.style.display = 'none';
    }
    if (presetCardsEl) {
      const hiddenSelect = root.querySelector('#ctrl-select');
      presetCardsEl.querySelectorAll('.preset-card').forEach((card) => {
        card.addEventListener('click', () => {
          presetCardsEl.querySelectorAll('.preset-card').forEach((c) => c.classList.remove('active'));
          card.classList.add('active');
          if (hiddenSelect) hiddenSelect.value = card.dataset.value;
          updatePresetDesc(card.dataset.value);
          // Stop whatever's currently playing right away -- switching presets used to leave
          // stale audio playing until the new result was ready, seconds later.
          stopAB();
          // Tapping a card previews it immediately (processes + auto-plays, no download) --
          // picking a scenario and hearing nothing happen was the exact complaint this fixes.
          if (file) runFfmpegProcess(false);
        });
      });
    }
    // Same "picking a setting previews it" behaviour the preset cards have, for A/B tools whose
    // setting is a plain dropdown. Without it the Download button -- which A/B tools deliberately
    // keep disabled until a result exists -- could never be enabled at all, because nothing else
    // on the page would ever produce that first result.
    if (config.abCompare && !config.presetCards) {
      const abSelect = root.querySelector('#ctrl-select');
      if (abSelect) {
        abSelect.addEventListener('change', () => {
          stopAB();
          if (file) runFfmpegProcess(false);
        });
      }
    }
    if (heroAutoBtn) {
      heroAutoBtn.addEventListener('click', () => {
        const hiddenSelect = root.querySelector('#ctrl-select');
        if (hiddenSelect) hiddenSelect.value = 'auto';
        if (presetCardsEl) presetCardsEl.querySelectorAll('.preset-card').forEach((c) => c.classList.remove('active'));
        updatePresetDesc('auto');
        stopAB();
        // Same as any preset card -- preview only (process + auto-play, no download). The
        // separate Download button is the only thing that ever downloads a file.
        if (file) runFfmpegProcess(false);
      });
    }
    const enhanceFormatSel = root.querySelector('.enhance-format-field #ctrl-format');
    if (enhanceFormatSel) {
      enhanceFormatSel.addEventListener('change', () => {
        // The cached result is now the wrong format to just hand out -- clear it so Download
        // is disabled again until a fresh preview runs in the newly-picked format.
        lastResultBlob = null;
        lastResultBuffer = null;
        lastResultPreset = null;
        if (runBtn) runBtn.disabled = true;
        if (abResultBtn) { abResultBtn.disabled = true; abResultBtn.classList.remove('active'); }
        if (abOriginalBtn) abOriginalBtn.classList.add('active');
        abSelected = 'original';
        if (wavePlayBtn) wavePlayBtn.disabled = !currentAbBuffer();
        // И сразу пересчитать в новом формате. Без этого смена формата возвращала ровно то
        // состояние, из-за которого всё и чинилось: список называет силу, а кнопка не нажимается.
        // Карточкам это не нужно -- там выбор виден, и его делают руками.
        if (file && !config.presetCards) runFfmpegProcess(false, null, { auto: true });
      });
    }

    // A/B compare (enhance): the pill (Original/Result) only SELECTS which buffer is "loaded"
    // -- matches timbrica's Before/After switch -- and the one round play button transports
    // whichever is selected. Previously each side had its own independent play control, which
    // is why switching used to restart from 0 and pause/stop got confused about which side
    // "playing" even meant.
    const abCompareEl = root.querySelector('#ab-compare');
    const abOriginalBtn = root.querySelector('#ab-original-btn');
    const abResultBtn = root.querySelector('#ab-result-btn');
    const wavePlayBtn = root.querySelector('#wave-play-btn');
    const wavePlayIco = root.querySelector('#wave-play-ico');
    const waveDurationEl = root.querySelector('#wave-duration');
    const waveStopBtn = root.querySelector('#wave-stop-btn');

    // Плюс и минус к числовым полям. Клавиатурные стрелки у числового поля есть и так, но на
    // телефоне их нет вовсе, а мышью попасть в стрелку высотой в семь пикселей трудно. Шаг берётся
    // из самого поля: секунды ходят по 0.5, удары в минуту по одному -- это свойство величины, и
    // задавать его дважды означало бы дать им разойтись.
    //
    // Кнопки добавляются скриптом, а не в разметке: полей шесть в разных инструментах, и
    // шесть одинаковых кусков разметки -- это шесть мест, где правка ляжет в одно.
    ['ctrl-silence-start', 'ctrl-silence-end', 'ctrl-bpm-to', 'ctrl-fadein', 'ctrl-fadeout']
      .forEach((id) => {
        const el = root.querySelector('#' + id);
        if (!el || el.type !== 'number' || el.closest('.stepper')) return;
        const step = parseFloat(el.step) || 1;
        const wrap = document.createElement('div');
        wrap.className = 'stepper';
        el.parentNode.insertBefore(wrap, el);
        const mk = (sign, label) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'st-btn';
          b.textContent = sign > 0 ? '+' : '−';
          b.setAttribute('aria-label', label);
          b.addEventListener('click', () => {
            const min = el.min === '' ? -Infinity : parseFloat(el.min);
            const max = el.max === '' ? Infinity : parseFloat(el.max);
            const now = parseFloat(el.value);
            const base = Number.isFinite(now) ? now : 0;
            // Округление до шага: иначе после 0.5 + 0.5 получается 0.9999999999999999.
            const next = Math.min(max, Math.max(min, Math.round((base + sign * step) / step) * step));
            el.value = String(Number(next.toFixed(6)));
            el.dispatchEvent(new Event('input', { bubbles: true }));
            el.dispatchEvent(new Event('change', { bubbles: true }));
          });
          return b;
        };
        // Строке с полями помечаем, что в ней есть такие блоки: подписи бывают разной длины
        // («Тишина в начале (секунд)» переносится на две строки, «в конце» умещается в одну),
        // и без выравнивания по нижнему краю кнопки расходятся по высоте. Замерено на 430
        // пикселях -- ровно та ширина, где перенос случается только у одной подписи.
        const row = wrap.closest('.row');
        if (row) row.classList.add('has-stepper');
        wrap.appendChild(mk(-1, '−' + step));
        wrap.appendChild(el);
        wrap.appendChild(mk(1, '+' + step));
      });
    // Подсказка со временем под курсором. Живёт только на компактной панели -- там волна
    // не рабочая поверхность, и ничто не спорит с ней за движения мыши.
    // У широкой волны (склейка, генераторы) отдельной области нет -- считаем от самой волны.
    // Иначе вся логика бегунка и подсказки молча не включалась: querySelector отдавал null.
    const waveArea = root.querySelector('#wave-area') || root.querySelector('#wave-shell');
    const waveGuide = root.querySelector('#wave-guide');
    const waveTip = root.querySelector('#wave-tip');
    if (waveArea && waveGuide && waveTip) {
      waveArea.addEventListener('mousemove', (e) => {
        if (!dur) return;
        const r = waveArea.getBoundingClientRect();
        const x = Math.max(0, Math.min(r.width, e.clientX - r.left));
        const t = (x / r.width) * dur;
        waveGuide.style.left = x + 'px';
        waveGuide.style.display = 'block';
        waveTip.textContent = fmtClock(t);
        waveTip.style.display = 'block';
        // Подсказка не должна вылезать за края области -- у самого начала и конца дорожки
        // она иначе обрезается рамкой панели.
        const half = waveTip.offsetWidth / 2;
        waveTip.style.left = Math.max(half + 2, Math.min(r.width - half - 2, x)) + 'px';
      });
      waveArea.addEventListener('mouseleave', () => {
        waveGuide.style.display = 'none';
        waveTip.style.display = 'none';
      });
    }
    const transportCurEl = root.querySelector('#transport-cur');
    const transportDurEl = root.querySelector('#transport-dur');

    // ---- 10-band graphic EQ state ------------------------------------------------------------
    // Declared up here, ahead of every consumer (currentAbChain, the download handler, pickFile).
    // These were originally further down the file and, being const/let rather than hoisted
    // function declarations, the download handler referenced them before initialization -- which
    // threw at page-load, aborted the rest of the script, and surfaced later as a bogus
    // "couldn't read this file" decode error on a perfectly good MP3.
    // Preview runs through a LIVE filter chain (eqChainBuilder): moving a slider writes straight
    // into the playing filters' gain, audible instantly with no re-render. The identical band
    // values feed an OfflineAudioContext render only when exporting.
    let eqLiveFilters = [];
    const eqDownloadBtn = root.querySelector('#tool-download-btn');
    const eqFormatSel = root.querySelector('#tool-format');
    const readyNoteEl = root.querySelector('#ready-note');
    let exportedClean = false;
    function eqBandGains() {
      const gains = {};
      (config.bands || []).forEach((b) => {
        const el = root.querySelector(`#eq-band-${b.id}`);
        gains[b.id] = el ? Number(el.value) : 0;
      });
      return gains;
    }
    function eqIsFlat() {
      return Object.values(eqBandGains()).every((v) => v === 0);
    }
    function eqChainBuilder(ctx, srcNode) {
      const built = config.buildLiveChain(ctx, srcNode, eqBandGains());
      eqLiveFilters = built.filters;
      return built.output;
    }

    // ---- Volume state --------------------------------------------------------------------------
    // A single GainNode. Cheap enough to run live, so dragging the slider is heard immediately
    // and the peak readout follows without touching the file.
    let volumeLiveGain = null;
    const volumeSliderEl = root.querySelector('#ctrl-slider');
    function volumeValue() {
      return config.controls === 'volume1' && volumeSliderEl ? Number(volumeSliderEl.value) || 100 : 100;
    }
    function volumeChainBuilder(ctx, srcNode) {
      const built = config.buildLiveChain(ctx, srcNode, volumeValue());
      volumeLiveGain = built.filters[0];
      return built.output;
    }

    // ---- Fade in / fade out state ------------------------------------------------------------
    // One GainNode whose automation is re-scheduled from the CURRENT playback position whenever a
    // slider moves, so the change is heard immediately rather than after re-rendering the file.
    let fadeLiveGain = null;
    let fadeLiveCtx = null;
    const fadeInEl = root.querySelector('#ctrl-fadein');
    const fadeOutEl = root.querySelector('#ctrl-fadeout');
    function fadeValues() {
      return {
        fadeIn: fadeInEl ? Number(fadeInEl.value) || 0 : 0,
        fadeOut: fadeOutEl ? Number(fadeOutEl.value) || 0 : 0,
      };
    }
    function fadeChainBuilder(ctx, srcNode, startOffset) {
      const g = ctx.createGain();
      const { fadeIn, fadeOut } = fadeValues();
      config.scheduleFade(g.gain, startOffset, dur, fadeIn, fadeOut, ctx.currentTime);
      srcNode.connect(g);
      fadeLiveGain = g;
      fadeLiveCtx = ctx;
      return g;
    }
    function fadeReschedule() {
      if (!fadeLiveGain || !fadeLiveCtx || !player.isPlaying()) return;
      const { fadeIn, fadeOut } = fadeValues();
      config.scheduleFade(fadeLiveGain.gain, player.getPosition(), dur, fadeIn, fadeOut, fadeLiveCtx.currentTime);
    }
    // Green gradient bands drawn over the start/end of the waveform, sized to the fade lengths.
    // Positioned against the canvas (not the shell) because the compact player puts a play
    // button before it, so the shell's left edge isn't where the waveform starts.
    let fadeDrawTimer = null;
    // Огибающая фейдов для рисования волны. Живёт ОДНОЙ функцией и подмешивается в каждую
    // отрисовку -- иначе любая перерисовка (изменение размера окна, пересчёт, переключение
    // «было/стало») стирала прогиб, и оставалась только зелёная заливка. Владелец видел
    // ровные столбики именно поэтому: я рисовал прогиб поверх, а не внутри.
    function fadeDrawOpts() {
      if (!config.fadeRegions || dur <= 0) return undefined;
      const { fadeIn, fadeOut } = fadeValues();
      if (!fadeIn && !fadeOut) return undefined;
      // ДОЛИ дорожки, не секунды: движок сравнивает с c/n, то есть с положением столбика
      // от 0 до 1. С секундами условие никогда не выполнялось, и волна оставалась ровной --
      // ровно та ловушка, что уже записана в памяти, и я в неё наступил снова.
      return {
        fade: {
          selStart: 0, selEnd: 1,
          inStart: 0, inEnd: Math.min(fadeIn, dur) / dur,
          outStart: Math.max(0, dur - Math.min(fadeOut, dur)) / dur, outEnd: 1,
        },
      };
    }
    function updateFadeRegions() {
      const inEl = root.querySelector('#fade-region-in');
      const outEl = root.querySelector('#fade-region-out');
      if (!inEl || !outEl || !waveCanvas) return;
      const { fadeIn, fadeOut } = fadeValues();
      const base = waveCanvas.offsetLeft;
      const W = waveCanvas.clientWidth;
      if (dur <= 0 || W < 1) { inEl.style.display = 'none'; outEl.style.display = 'none'; return; }
      const inW = Math.min(W, (Math.min(fadeIn, dur) / dur) * W);
      const outW = Math.min(W - inW, (Math.min(fadeOut, dur) / dur) * W);
      inEl.style.display = inW > 0 ? 'block' : 'none';
      inEl.style.left = base + 'px';
      inEl.style.width = inW + 'px';
      outEl.style.display = outW > 0 ? 'block' : 'none';
      outEl.style.left = (base + W - outW) + 'px';
      outEl.style.width = outW + 'px';
      // Сама ВОЛНА тоже прогибается в зонах фейда -- как на обрезке. Одной зелёной заливки
      // мало: она показывает, ГДЕ фейд, но не показывает, ЧТО он делает со звуком.
      // Опора уже есть в движке: drawWaveform умеет пригибать столбики по огибающей.
      //
      // Рисуем в СЛЕДУЮЩЕМ кадре: в этом же кадре следом идут syncResultWave и пересчёт,
      // и они перерисовывают волну без огибающей -- моя отрисовка ложилась первой и
      // затиралась. Владелец видел зелёные зоны при ровных столбиках именно поэтому.
      // Берём ТОТ ЖЕ буфер, что рисует основная отрисовка (waveDrawBuffer). sourceBuffer
      // на этой странице может быть пуст, и тогда мой вызов молча не срабатывал -- замер
      // показывал одинаковую высоту столбиков при фейде 0 и 3 секунды.
      const буф = (typeof waveDrawBuffer !== 'undefined' && waveDrawBuffer) || sourceBuffer;
      if (буф && waveCanvas && dur > 0) {
        const огиб = {
          selStart: 0, selEnd: 1,
          inStart: 0, inEnd: Math.min(fadeIn, dur) / dur,
          outStart: Math.max(0, dur - Math.min(fadeOut, dur)) / dur, outEnd: 1,
        };
        if (fadeDrawTimer) cancelAnimationFrame(fadeDrawTimer);
        fadeDrawTimer = requestAnimationFrame(() => {
          fadeDrawTimer = null;
          drawWaveform(waveCanvas, буф, undefined, { fade: огиб });
        });
      }
    }

    // Whether the user has actually changed anything -- drives the shared Download button.
    function toolIsDirty() {
      if (config.controls === 'eq10') return !eqIsFlat();
      if (config.controls === 'fade2') { const v = fadeValues(); return v.fadeIn > 0 || v.fadeOut > 0; }
      if (config.controls === 'pitch1') {
        const st = root.querySelector('#ctrl-slider'), ct = root.querySelector('#ctrl-cents');
        return (!!st && Number(st.value) !== 0) || (!!ct && Number(ct.value) !== 0);
      }
      if (config.controls === 'voicefx') return !!root.querySelector('#voice-fx .preset-card.active');
      if (config.controls === 'volume1') return volumeValue() !== 100;
      // Only "dirty" when the target rate actually differs from the file's own -- converting
      // 44.1 kHz to 44.1 kHz produces a copy and nothing else.
      if (config.controls === 'rate1') {
        const el = root.querySelector('#ctrl-select');
        return !!el && !!sourceBuffer && Number(el.value) !== sourceBuffer.sampleRate;
      }
if (config.controls === 'speed1') {
        const el = root.querySelector('#ctrl-slider'), kp = root.querySelector('#ctrl-keeppitch');
        return (!!el && Number(el.value) !== 100) || (!!kp && !kp.checked);
      }
      // Exporting the whole file unchanged isn't trimming -- that's what the converter is for.
      // Fades and cut-out count as changes on their own, since either one alters the audio even
      // when the selection still covers the entire track.
      if (config.controls === 'trim') {
        if (!sourceBuffer) return false;
        const fi = Number((root.querySelector('#ctrl-fadein') || {}).value) || 0;
        const fo = Number((root.querySelector('#ctrl-fadeout') || {}).value) || 0;
        const cut = !!(root.querySelector('#ctrl-cutout') || {}).checked;
        return selStart > 0.01 || selEnd < dur - 0.01 || fi > 0 || fo > 0 || cut;
      }
      if (config.controls === 'silence2') {
        const a = Number((root.querySelector('#ctrl-silence-start') || {}).value) || 0;
        const b = Number((root.querySelector('#ctrl-silence-end') || {}).value) || 0;
        return !!sourceBuffer && (a > 0 || b > 0);
      }
      // One file joined to nothing is just that file.
      if (config.controls === 'tempo') {
        const f = Number((root.querySelector('#ctrl-bpm-from') || {}).value) || 0;
        const t = Number((root.querySelector('#ctrl-bpm-to') || {}).value) || 0;
        return !!sourceBuffer && f > 0 && t > 0 && Math.abs(f - t) >= 1;
      }
      if (config.controls === 'multi-file') return files.length >= 2;
      // Nothing has been recorded yet -- the export bar must not look ready.
      if (config.controls === 'recorder') return !!sourceBuffer;
      return true;
    }

    // One line of plain truth about this particular file and these particular settings: that it
    // is already mono, what the compressed file will weigh, how long the loop comes out. Returns
    // '' when there is nothing worth saying, which hides the line entirely.
    function syncSourceNote() {
      const el = root.querySelector('#tool-note');
      if (!el || !config.note) return;
      const text = config.note({
        buffer: sourceBuffer,
        rendered: renderedBuffer,
        fileSize: file ? file.size : 0,
        params: readParams(),
        labels,
        fmtTime: fmtClock,
        // Adaptive unit: "0.0 MB" for a short clip is a true number that tells you nothing.
        size: (bytes) => (bytes >= 1048576
          ? (bytes / 1048576).toFixed(1) + ' ' + (labels.unitMB || 'MB')
          : Math.max(1, Math.round(bytes / 1024)) + ' ' + (labels.unitKB || 'KB')),
      }) || '';
      el.textContent = text;
      // Место под строку занимается сразу, как только файл прочитан, даже если сказать пока
      // нечего. Иначе строка возникает в тот момент, когда человек впервые двигает настройку, и
      // толкает вниз всё, что под ней -- кнопку скачивания в том числе, прямо под курсором.
      // До загрузки файла строка скрыта совсем: там ничего не сдвинется, панель ещё пустая.
      el.style.display = (text || sourceBuffer) ? 'block' : 'none';
      el.classList.toggle('is-empty', !text);
    }
    // Merge has no single decoded source -- its input is the file list -- so "is there anything
    // to work with" can't just be `sourceBuffer`. Keying the export button off sourceBuffer left
    // it permanently disabled there.
    function hasWorkableInput() {
      return config.controls === 'multi-file' ? files.length >= 2 : !!sourceBuffer;
    }
    function eqSyncState() {
      const touched = toolIsDirty();
      const ready = hasWorkableInput();
      if (eqDownloadBtn) eqDownloadBtn.disabled = !touched || !ready;
      if (readyNoteEl) readyNoteEl.style.display = touched && !exportedClean && ready ? 'block' : 'none';
    }

    let lastResultBuffer = null;
    let lastResultBlob = null;
    let lastResultName = 'result';
    let lastResultPreset = null;
    let abSelected = 'original';
    let abPlayingWhich = null;
    // Which buffer is currently loaded in the player -- needed to convert a position between
    // the original and a processed side of a different length (see playAB).
    let abPlayingBuffer = null;
    // Set by tapping the waveform (position only, no play) -- consumed once by the next play,
    // then cleared so later presses go back to normal toggle/resume behavior instead of
    // jumping back to this spot forever.
    let waveSeekPos = null;
    // Three different ways a tool can produce its "processed" side:
    //  - LIVE_CHAIN_TOOLS (EQ, fade): same buffer, a processing graph inserted while it plays.
    //    Nothing rendered up front, so A/B and sliders are instant.
    //  - RENDERED_AB_TOOLS (pitch, voice): the transform is far too heavy for a live graph
    //    (pitch-shifting rewrites every sample), so the processed side is an offline render,
    //    computed on demand and cached by settings so re-selecting it is instant.
    //  - everything else (ffmpeg enhance): a separately decoded processed buffer.
    const LIVE_CHAIN_TOOLS = { eq10: () => eqChainBuilder, fade2: () => fadeChainBuilder, volume1: () => volumeChainBuilder,
      // Темп меняется ПРЯМО ВО ВРЕМЯ ЗВУЧАНИЯ: звук идёт через обработчик в звуковом потоке,
      // и смена ударов в минуту -- одно число в нём, а не пересборка файла. Вид не меняется.
      tempo: () => null };

    let tempoNode = null, tempoCtxLoaded = false, tempoPos = 0;
    function tempoRatio() {
      const f = Number((root.querySelector('#ctrl-bpm-from') || {}).value) || 0;
      const t2 = Number((root.querySelector('#ctrl-bpm-to') || {}).value) || 0;
      return (f > 0 && t2 > 0) ? t2 / f : 1;
    }
    function makeTempoSource(ctx, buffer, offset) {
      // Прежний обработчик обязательно выключить. Иначе при перемотке рядом остаётся
      // работающий: он продолжает звучать и слать СВОЁ положение, отчего бегунок мечется
      // между двумя источниками, а звук не останавливается. На телефоне это особенно
      // заметно -- там перемотка пальцем даёт поток событий.
      if (tempoNode) {
        try { tempoNode.port.onmessage = null; tempoNode.port.postMessage({ type: 'stop' }); tempoNode.disconnect(); } catch (e) {}
        tempoNode = null;
      }
      if (!tempoCtxLoaded) {
        // Обработчик ещё не загрузился -- играем обычным узлом. Лучше звук без живой смены
        // темпа, чем тишина.
        const s2 = ctx.createBufferSource();
        s2.buffer = buffer;
        return s2;
      }
      const node = new AudioWorkletNode(ctx, 'audio-stretch', { outputChannelCount: [2] });
      const chans = [];
      for (let c = 0; c < Math.max(1, buffer.numberOfChannels); c++) {
        chans.push(buffer.getChannelData(Math.min(c, buffer.numberOfChannels - 1)).slice().buffer);
      }
      tempoPos = offset || 0;
      // Обработчик сообщает СВОЁ положение в исходнике. Считать его по прошедшему времени
      // нельзя: при смене темпа на ходу пришлось бы умножать на новый темп и то время,
      // которое отыграло на старом -- бегунок прыгал вперёд и добегал до конца раньше звука.
      node.port.onmessage = (e) => {
        if (e.data && e.data.type === 'pos') tempoPos = e.data.seconds;
      };
      node.port.postMessage({ type: 'load', channels: chans, offset: offset || 0 }, chans);
      node.port.postMessage({ type: 'play' });
      node.parameters.get('speed').value = tempoRatio();
      node.parameters.get('pitchRatio').value = 1;
      tempoNode = node;
      return node;
    }
    // Declared per tool rather than by control type. A hardcoded list of `controls` names can't
    // express this any more: six different tools share controls:'select', and only some of them
    // want the play button to play the processed result.
    const isRenderedAb = !!config.renderedAb;
    // A tool WITHOUT an Original/Result switch (speed, volume) has only one thing to play: the
    // processed version. Without this it would sit on 'original' forever and the play button
    // would keep playing the untouched file no matter what the slider said.
    if ((isRenderedAb || LIVE_CHAIN_TOOLS[config.controls]) && !config.abCompare) abSelected = 'result';
    function currentAbBuffer() {
      if (LIVE_CHAIN_TOOLS[config.controls]) return sourceBuffer;
      if (isRenderedAb) return abSelected === 'result' ? renderedBuffer : sourceBuffer;
      return abSelected === 'result' ? lastResultBuffer : sourceBuffer;
    }
    // Renders the processed side if it isn't cached yet, showing progress -- pitch-shifting a
    // long file takes a moment and silently doing nothing would read as a broken button.
    // Волна должна показывать то, что играет. У инструментов, которые меняют ДЛИТЕЛЬНОСТЬ --
    // добавить и удалить тишину, зацикливание, скорость, темп -- она показывала исходник, а играл
    // результат: бегунок ехал по форме, которой в звуке уже нет, и попадал не туда, куда целились.
    // У инструментов, не меняющих длительность (тональность, эквалайзер, шумоподавление), волна
    // остаётся исходной намеренно: там разница на глаз незаметна, и мигание читалось бы как сбой.
    let waveSyncTimer = 0;
    function scheduleWaveSync() {
      clearTimeout(waveSyncTimer);
      waveSyncTimer = window.setTimeout(async () => {
        if (!sourceBuffer) return;
        try {
          if (!renderedBuffer) renderedBuffer = await doRender();
          syncResultWave();
          // И обновить строку под настройками. Она рассказывает о РЕЗУЛЬТАТЕ ("убрано 4,2 с
          // тишины, было 0:30, стало 0:26"), поэтому до пересчёта ей нечего сказать -- а
          // пересчёт тут и произошёл. Без этой строки ползунок чувствительности в "удалить
          // тишину" двигался молча: ни числа, ни отклика, только догадка.
          syncSourceNote();
        } catch {
          // Не получилось посчитать -- оставляем прежнюю волну. Показать ошибку здесь нечестно:
          // человек ничего не запрашивал, он всего лишь двинул ползунок.
        }
      }, 250);
    }
    function syncResultWave() {
      if (!config.abWaveform || !waveCanvas) return;
      const buf = currentAbBuffer();
      if (buf) drawWaveform(waveCanvas, buf, undefined, fadeDrawOpts());
    }

    async function ensureAbResult() {
      if (!isRenderedAb || abSelected !== 'result' || renderedBuffer) return true;
      armProgress();
      progressFill.style.width = '40%';
      progressText.textContent = labels.workingLabel;
      try {
        renderedBuffer = await doRender();
        syncResultWave();
        // A note that reports on the result (how much silence came out) can only be filled in
        // once there IS a result.
        syncSourceNote();
        finishProgress(labels.previewDoneLabel || labels.doneLabel);
        return true;
      } catch (e) {
        showError(e && e.message ? e.message : String(e));
        hideProgress();
        return false;
      }
    }
    function currentAbChain() {
      const get = LIVE_CHAIN_TOOLS[config.controls];
      return get && abSelected === 'result' ? get() : null;
    }
    // Position to resume from after a settings change. Must be read BEFORE stopAB(), which
    // zeroes it. If the track had already finished, resuming at the very end would play
    // nothing at all, so that case restarts from the beginning instead.
    function resumePosition() {
      const p = player.getPosition();
      return (dur > 0 && p >= dur - 0.1) ? 0 : p;
    }
    function stopAB() {
      player.stop();
      if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PLAY; wavePlayIco.closest('.tp-btn')?.classList.remove('is-playing'); }
      if (playhead) playhead.style.display = 'none';
      abPlayingWhich = null;
    }
    // `seekTo` present (waveform click) always seeks+plays from that point -- toggle/pause
    // only applies to a plain play-button press (no seek position) on the playing side.
    function playAB(which, buf, seekTo) {
      if (seekTo == null && abPlayingWhich === which && player.isPlaying()) {
        player.pause();
        if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PLAY; wavePlayIco.closest('.tp-btn')?.classList.remove('is-playing'); }
        abPlayingWhich = null;
        return;
      }
      // CONTRACT: `seekTo`, when given, is already expressed in `buf`'s own timeline. Callers
      // that hold a position from a different-length buffer (the speed tool's processed side)
      // convert it before calling -- doing it in both places would scale it twice.
      //
      // The one conversion that belongs here is switching sides mid-playback: the position
      // comes from the buffer that was playing, so it's translated through a fraction of the
      // track. 0:30 into a 60s original is the same moment as 0:15 into its 2x version.
      let resumeAt = seekTo;
      if (resumeAt == null && abPlayingWhich && abPlayingWhich !== which && player.isPlaying()) {
        const from = player.getPosition();
        resumeAt = abPlayingBuffer && abPlayingBuffer.duration > 0
          ? (from / abPlayingBuffer.duration) * buf.duration
          : from;
      }
      player.unlock();
      // Позицию надо забрать ДО остановки: stop() обнуляет запомненное на паузе место, а вызван
      // он здесь же, строкой ниже. Из-за этого пауза честно сохраняла момент, а следующее
      // нажатие стирало его за миг до старта, и запись начиналась сначала.
      if (resumeAt == null) {
        const held = player.getPosition();
        if (held > 0.05 && held < buf.duration - 0.05) resumeAt = held;
      }
      player.stop();
      if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PAUSE; wavePlayIco.closest('.tp-btn')?.classList.add('is-playing'); }
      abPlayingWhich = which;
      abPlayingBuffer = buf;
      if (transportDurEl) transportDurEl.textContent = fmtClock(buf.duration);
      player.play(
        buf,
        (frac) => {
          // При смене темпа звук идёт быстрее или медленнее исходника, а движок считает
          // положение по ИСХОДНОЙ длительности. Без поправки на темп музыка кончалась, а
          // бегунок ещё полз -- владелец это и увидел. Умножаем на отношение темпов.
          // У темпа положение берём у обработчика: он один знает, сколько исходника уже
          // проглотил. Часы при этом показывают время в НОВОЙ длительности.
          const isTempo = config.controls === 'tempo';
          const f = isTempo ? Math.min(1, buf.duration ? tempoPos / buf.duration : 0) : frac;
          if (transportCurEl) {
            transportCurEl.textContent = fmtClock(isTempo ? (tempoPos / tempoRatio()) : f * buf.duration);
            transportCurEl.hidden = false;
          }
          if (waveStopBtn) waveStopBtn.disabled = false;
          setPlayheadFrac(f);
        },
        () => {
          if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PLAY; wavePlayIco.closest('.tp-btn')?.classList.remove('is-playing'); }
          if (playhead) playhead.style.display = 'none';
          if (transportCurEl) transportCurEl.textContent = '0:00';
          abPlayingWhich = null;
          eqLiveFilters = [];
        },
        resumeAt,
        currentAbChain(),
        config.controls === 'tempo' ? { makeSource: makeTempoSource } : {}
      );
    }
    function selectAbSide(which) {
      // Re-tapping the side that's already selected is a no-op, not a transport command --
      // without this it fell through to playAB(), which saw the same side already playing and
      // treated it as a play/pause toggle, so tapping the lit-up half of the pill paused the
      // audio. The pill selects; the round play button transports.
      if (abSelected === which) return;
      const wasPlaying = player.isPlaying();
      const resumeFrom = wasPlaying ? player.getPosition() : null;
      abSelected = which;
      if (abOriginalBtn) abOriginalBtn.classList.toggle('active', which === 'original');
      if (abResultBtn) abResultBtn.classList.toggle('active', which === 'result');
      // Switching selection while something's playing continues on the new buffer instead of
      // going silent. For render-on-demand tools the buffer may not exist yet, so the render
      // has to finish first -- the position is captured up front so the await doesn't lose it.
      (async () => {
        const ok = await ensureAbResult();
        if (!ok || abSelected !== which) return;
        const buf = currentAbBuffer();
        if (wavePlayBtn) wavePlayBtn.disabled = !buf;
        // Перерисовка волны под выбранную сторону. Включена только там, где сама форма волны и
        // есть результат -- у реверса зеркальная волна это единственное наглядное доказательство,
        // что переворот случился. Остальным инструментам не включаю: у сдвига тональности или
        // шумоподавления форма меняется еле заметно, и мигание волны при переключении будет
        // выглядеть сбоем, а не сообщением.
        if (config.abWaveform && buf && waveCanvas) drawWaveform(waveCanvas, buf);
        if (buf && wasPlaying) playAB(which, buf, resumeFrom ?? undefined);
      })();
    }
    // Стоп: остановить и вернуть бегунок к НАЧАЛУ ВЫДЕЛЕНИЯ, а не к нулю файла. Правило общее для
    // всех инструментов с выделением: человек слушает свой отрезок и хочет переслушать его же,
    // а не улетать в начало часовой записи. Там, где выделения нет, начало выделения и есть ноль.
    if (waveStopBtn) {
      waveStopBtn.addEventListener('click', () => {
        stopAB();
        player.reset();
        const back = (typeof selStart === 'number' && selStart > 0) ? selStart : 0;
        if (dur > 0) setPlayheadFrac(back / dur);
        if (playhead) playhead.style.display = back > 0 ? 'block' : 'none';
        if (transportCurEl) { transportCurEl.textContent = fmtClock(back); transportCurEl.hidden = true; }
        waveStopBtn.disabled = true;
      });
    }
    if (abOriginalBtn) abOriginalBtn.addEventListener('click', () => selectAbSide('original'));
    if (abResultBtn) abResultBtn.addEventListener('click', () => { if (!abResultBtn.disabled) selectAbSide('result'); });
    if (wavePlayBtn) {
      wavePlayBtn.addEventListener('click', async (e) => {
        // The waveform around this button treats a click as "move the marker", and starts by
        // stopping playback. Its guard asks whether the click came from the play button --
        // but this handler swaps the play glyph for the pause glyph, which DETACHES the <path>
        // that was the event target. By the time the event bubbles one level up, target.closest()
        // walks a node that is no longer in the document and answers null, so the waveform
        // happily stopped the playback this handler had just started, ~10ms earlier.
        // Confirmed over CDP: source started with a valid 3s buffer, 'ended' fired at 0.01s, and
        // the stack pointed straight at the waveform's click listener. It affected every tool
        // with the in-waveform play button, not just the one it was noticed on.
        e.stopPropagation();
        // unlock() first and synchronously -- iOS only grants an AudioContext inside the
        // original gesture call stack, and ensureAbResult() below may await.
        player.unlock();
        const seek = waveSeekPos;
        waveSeekPos = null;
        if (!(await ensureAbResult())) return;
        const buf = currentAbBuffer();
        if (!buf) return;
        // waveSeekPos is measured against the ORIGINAL waveform on screen; scale it if the
        // buffer about to play is a different length (speed tool).
        const seekIn = seek == null ? undefined
          : (dur > 0 ? (seek / dur) * buf.duration : seek);
        playAB(abSelected, buf, seekIn);
      });
    }

    // EQ export: the live preview chain is only a preview -- writing a file still needs a real
    // OfflineAudioContext render through the same band values (config.render), then an encode.
    // WAV/MP3 are native; OGG borrows ffmpeg's libvorbis, same path the Convert tool uses.
    if (eqDownloadBtn) {
      eqDownloadBtn.addEventListener('click', async () => {
        if (!hasWorkableInput()) return;
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        clearError();
        eqDownloadBtn.disabled = true;
        armProgress();
        progressFill.style.width = '30%';
        progressText.textContent = labels.workingLabel;
        try {
          const rendered = await doRender();
          const fmt = eqFormatSel ? eqFormatSel.value : 'wav';
          // Merge has no single input file to name the result after.
          const base = config.controls === 'multi-file'
            ? (tool === 'mix' ? 'mixed' : 'merged')
            : (file && file.name.replace(/\.[^.]+$/, '')) || 'audio';
          progressFill.style.width = '70%';
          let blob;
          // config.mp3Bitrate was only honoured by the old download strip, so a tool whose whole
          // purpose is choosing a bitrate would have exported at a fixed 192 kbps here and its
          // slider would have done nothing at all.
          if (fmt === 'mp3') blob = await encodeMP3(rendered, config.mp3Bitrate ? config.mp3Bitrate(readParams()) : 192);
          else if (fmt === 'ogg') {
            const wavFile = new File([encodeWAV(rendered)], 'eq.wav', { type: 'audio/wav' });
            blob = await execFFmpeg({
              inputs: [{ name: 'in0', file: wavFile }],
              buildArgs: (names, out) => ['-i', names[0], '-c:a', 'libvorbis', '-b:a', '192k', out],
              outputName: 'out.ogg',
              mimeType: 'audio/ogg',
            });
          } else blob = encodeWAV(rendered);
          finishProgress(labels.doneLabel);
          // Every tool sharing this export path was writing "-eq" (or "-fade") into the
          // filename, so a trimmed file came out as "song-eq.mp3". Named after what was done.
          // Keyed on the tool, not on the control type: six tools share controls:'select', so
          // keying on that gave four of them the same meaningless "-result".
          const suffix = {
            equalizer: 'eq', fade: 'fade', trim: 'trim', pitch: 'pitch', voice: 'voice',
            speed: 'speed', volume: 'volume', 'sample-rate': 'resampled', reverse: 'reversed',
            normalize: 'normalized', 'stereo-to-mono': 'mono', 'mono-to-stereo': 'stereo',
            compress: 'compressed', loop: 'loop', 'remove-silence': 'trimmed',
            'reverb-echo': 'reverb', chiptune: 'chiptune', 'add-silence': 'padded',
            tempo: 'bpm',
            'dynamic-compressor': 'leveled', 'vocal-remover': 'karaoke',
          }[tool] || 'result';
          // Merge has no source name to qualify, so it's just "merged" -- pairing the fallback
          // base with a suffix produced "merged-merged.wav".
          // The dictaphone already names its file "recording"; "-result" on the end helps nobody.
          const outName = tool === 'mix' ? `mixed.${fmt}`
            : config.controls === 'multi-file' ? `merged.${fmt}`
            : tool === 'dictaphone' ? `${base}.${fmt}`
            : `${base}-${suffix}.${fmt}`;
          downloadBlob(blob, outName);
          exportedClean = true;
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
          hideProgress();
        }
        eqSyncState();
      });
    }

    const mixVolumeEl = root.querySelector('#mix-volume');
    if (mixVolumeEl) {
      const mixVal = root.querySelector('#mix-volume-val');
      mixVolumeEl.addEventListener('input', () => {
        if (mixVal) mixVal.textContent = mixVolumeEl.value + '%';
        invalidateRender();
        eqSyncState();
      });
    }
    const slider = root.querySelector('#ctrl-slider');
    const sliderVal = root.querySelector('#ctrl-slider-val');
    if (slider && sliderVal) {
      // Some scales aren't continuous -- MP3 bitrates come from a fixed ladder. Snapping here
      // means the number on screen is the number that gets used, rather than one the encoder
      // silently rounds somewhere else.
      const snapSlider = () => {
        if (!config.snapValues) return;
        const v = Number(slider.value);
        slider.value = config.snapValues.reduce((best, n) => (Math.abs(n - v) < Math.abs(best - v) ? n : best), config.snapValues[0]);
      };
      snapSlider();
      sliderVal.textContent = slider.value + (config.sliderUnit || '');
      slider.addEventListener('input', () => {
        snapSlider();
        sliderVal.textContent = slider.value + (config.sliderUnit || '');
        invalidateRender();
        syncSourceNote();
      });
    }
    // ---- Visualizer -------------------------------------------------------------------------
    // Rendering video in WebAssembly is slow, so the point of this block is to let people judge
    // a style from a few seconds instead of committing to a full render. The preview goes
    // through runFfmpegProcess with previewSeconds set, i.e. the identical command with a
    // duration cap, so it cannot end up looking different from the downloaded file.
    if (config.controls === 'vizstyles') {
      const vizStylesEl = root.querySelector('#viz-styles');
      const vizPreviewBtn = root.querySelector('#viz-preview-btn');
      const vizPlaceholderEl = root.querySelector('#viz-placeholder');
      const vizNoteEl = root.querySelector('#viz-note');
      const vizVideoEl = root.querySelector('#viz-video');
      let vizPreviewUrl = null;

      const vizEstimateEl = root.querySelector('#viz-estimate');

      // Estimate the full render from how long the preview actually took ON THIS DEVICE with
      // THESE settings, rather than quoting a made-up number. Encoding time scales roughly with
      // duration at a fixed resolution, so preview-time x (track / preview) is a fair guide.
      function showRenderEstimate(previewMs) {
        if (!vizEstimateEl) return;
        const perSec = previewMs / 1000 / config.previewSeconds;
        let text;
        if (dur > 0) {
          const secs = perSec * dur;
          text = secs < 60
            ? labels.vizEstUnderMinuteLabel
            : (labels.vizEstMinutesLabel || '~{n} min').replace('{n}', String(Math.max(1, Math.round(secs / 60))));
        } else {
          // Some files don't expose a usable duration. Rather than silently showing nothing --
          // which just looks like the feature is missing -- report the measured rate instead,
          // which is still enough to judge whether to drop the resolution.
          text = (labels.vizEstPerMinuteLabel || '~{n}s per minute of audio')
            .replace('{n}', String(Math.max(1, Math.round(perSec * 60))));
        }
        vizEstimateEl.textContent = `${labels.vizEstPrefixLabel} ${text}`;
        vizEstimateEl.style.display = 'block';
      }

      function setVizBusy(on, slow) {
        const busy = root.querySelector('#viz-busy');
        const busyText = root.querySelector('#viz-busy-text');
        const baseText = slow ? labels.vizRenderingSlowLabel : labels.vizRenderingLabel;
        if (busyText) busyText.textContent = baseText;
        // Real percentage from ffmpeg rather than an open-ended spinner -- "how long is this
        // going to take" is the actual question during a wait.
        progressHook = on && busyText ? (pct) => { busyText.textContent = `${baseText} ${pct}%`; } : null;
        if (busy) busy.style.display = on ? 'flex' : 'none';
        vizPreviewBtn.disabled = on;
        vizStylesEl.querySelectorAll('.preset-card').forEach((c) => { c.disabled = on; });
        const sizeEl = root.querySelector('#viz-size');
        if (sizeEl) sizeEl.disabled = on;
      }

      async function renderVizPreview() {
        if (!file) return;
        // Whatever style is about to be rendered -- the active card if there is one, otherwise
        // the first, which is what readParams falls back to for the plain Preview button.
        const styleCard = root.querySelector('#viz-styles .preset-card.active')
          || vizStylesEl.querySelector('.preset-card');
        const styleKey = styleCard.dataset.style;
        setVizBusy(true, styleCard.dataset.slow === '1');
        const startedAt = performance.now();
        const blob = await runFfmpegProcess(false, { previewSeconds: config.previewSeconds });
        const tookMs = performance.now() - startedAt;
        setVizBusy(false);
        if (!blob) return;
        vizStylesEl.querySelectorAll('.preset-card').forEach((c) => {
          c.classList.toggle('active', c.dataset.style === styleKey);
        });
        if (vizPlaceholderEl) vizPlaceholderEl.style.display = 'none';
        // Reveals the <video>; it is kept hidden until now so its built-in play button can't
        // sit on top of the placeholder text.
        const stageEl = vizVideoEl.closest('.viz-stage');
        if (stageEl) stageEl.classList.add('has-video');
        if (vizNoteEl) vizNoteEl.style.display = 'block';
        showRenderEstimate(tookMs);
        // Revoke the previous object URL -- each preview is a fresh multi-megabyte blob, and
        // holding onto them would pin that memory for the life of the page.
        if (vizPreviewUrl) URL.revokeObjectURL(vizPreviewUrl);
        vizPreviewUrl = URL.createObjectURL(blob);
        vizVideoEl.src = vizPreviewUrl;
        vizVideoEl.play().catch(() => {});
      }

      vizStylesEl.querySelectorAll('.preset-card').forEach((card) => {
        card.addEventListener('click', () => {
