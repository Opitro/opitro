          const fmt = splitFmt.value;
          const base = (file && file.name.replace(/\.[^.]+$/, '')) || 'audio';
          const { default: JSZip } = await import('jszip');
          const zip = new JSZip();
          const pad = String(parts.length).length;
          for (let i = 0; i < parts.length; i++) {
            const clip = sliceBuffer(sourceBuffer, parts[i].start, parts[i].end);
            const blob = fmt === 'mp3' ? await encodeMP3(clip, 192) : encodeWAV(clip);
            zip.file(`${base}-${String(i + 1).padStart(pad, '0')}.${fmt}`, blob);
            progressFill.style.width = Math.round(5 + (i + 1) / parts.length * 85) + '%';
            progressText.textContent = `${labels.workingLabel} ${i + 1}/${parts.length}`;

            await new Promise((res) => setTimeout(res, 0));
          }
          progressText.textContent = labels.batchZippingLabel || 'ZIP…';
          const zipBlob = await zip.generateAsync({ type: 'blob' });
          finishProgress(labels.doneLabel);
          downloadBlob(zipBlob, `${base}-parts.zip`);
        } catch (e) {
