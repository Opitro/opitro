        if (свежий && waveCanvas) { dur = свежий.duration; scheduleWaveformDraw(свежий); }
      }
      if (!config.abWaveform || !waveCanvas) return;
      const buf = currentAbBuffer();
      if (buf) drawWaveform(waveCanvas, buf, undefined, fadeDrawOpts());
    }

    async function ensureAbResult() {
      if (!isRenderedAb || abSelected !== 'result' || renderedBuffer) return true;
      armProgress();
      progressFill.style.width = '40%';
      progressText.textContent = labels.workingLabel;
      try {
        renderedBuffer = await doRender();
        syncResultWave();

        syncSourceNote();
        finishProgress(labels.previewDoneLabel || labels.doneLabel);
        return true;
      } catch (e) {
        showError(e && e.message ? e.message : String(e));
        hideProgress();
        return false;
      }
    }

    let rtGainNode = null;
    function rtChainBuilder(ctx, source) {
      const g = ctx.createGain();
      const эл = root.querySelector('#rt-volume');
      g.gain.value = эл ? Number(эл.value) / 100 : 1;
      source.connect(g);
      rtGainNode = g;
      return g;
    }
    function currentAbChain() {
      if (config.controls === 'ringtone-targets') return rtChainBuilder;
      const get = LIVE_CHAIN_TOOLS[config.controls];
      return get && abSelected === 'result' ? get() : null;
    }

    function resumePosition() {
      const p = player.getPosition();
      return (dur > 0 && p >= dur - 0.1) ? 0 : p;
    }

    setInterval(() => {
      if (!wavePlayIco) return;
      const кнопка = wavePlayIco.closest('.tp-btn');
      const выглядитИграющей = !!кнопка && кнопка.classList.contains('is-playing');

      const элИграет = !!(эл && эл.src && !эл.paused);
      if (выглядитИграющей && !player.isPlaying() && !элИграет) {
        wavePlayIco.innerHTML = ICO_PLAY;
        кнопка.classList.remove('is-playing');
      }
    }, 500);

    function stopAB() {
      player.stop();
      if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PLAY; wavePlayIco.closest('.tp-btn')?.classList.remove('is-playing'); }
      if (playhead) playhead.style.display = 'none';
      abPlayingWhich = null;
    }

    function playAB(which, buf, seekTo) {

      if (config.elementPlayback) {
        if (эл && эл.src) {
          if (seekTo != null) { try { эл.currentTime = seekTo; } catch (e) {} }
          if (эл.paused) {
            const о = эл.play();

            if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PAUSE; wavePlayIco.closest('.tp-btn')?.classList.add('is-playing'); }
            if (waveStopBtn) waveStopBtn.disabled = false;
            if (о && о.catch) о.catch(() => сброситьВид());
          }
        }
        return;
      }
      if (seekTo == null && abPlayingWhich === which && player.isPlaying()) {
        player.pause();
        if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PLAY; wavePlayIco.closest('.tp-btn')?.classList.remove('is-playing'); }
        abPlayingWhich = null;
        return;
      }

      let resumeAt = seekTo;
      if (resumeAt == null && abPlayingWhich && abPlayingWhich !== which && player.isPlaying()) {
        const from = player.getPosition();
        resumeAt = abPlayingBuffer && abPlayingBuffer.duration > 0
          ? (from / abPlayingBuffer.duration) * buf.duration
          : from;
      }
      player.unlock();

      if (resumeAt == null) {
        const held = player.getPosition();
        if (held > 0.05 && held < buf.duration - 0.05) resumeAt = held;
      }
      player.stop();
      if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PAUSE; wavePlayIco.closest('.tp-btn')?.classList.add('is-playing'); }
      abPlayingWhich = which;
      abPlayingBuffer = buf;
      if (transportDurEl) { transportDurEl.textContent = fmtClock(buf.duration); transportDurEl.hidden = false; }
      player.play(
        buf,
        (frac) => {

          const isTempo = config.controls === 'tempo' && tempoCtxLoaded;
          const f = isTempo ? Math.min(1, buf.duration ? tempoPos / buf.duration : 0) : frac;
          if (transportCurEl) {
            transportCurEl.textContent = fmtClock(isTempo ? (tempoPos / tempoRatio()) : f * buf.duration);
            transportCurEl.hidden = false;
          }
          if (waveStopBtn) waveStopBtn.disabled = false;
          setPlayheadFrac(f);
        },
        () => {
          if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PLAY; wavePlayIco.closest('.tp-btn')?.classList.remove('is-playing'); }
          if (playhead) playhead.style.display = 'none';
          if (transportCurEl) transportCurEl.textContent = '0:00';
          abPlayingWhich = null;
          eqLiveFilters = [];
        },
        resumeAt,
        currentAbChain(),
        config.controls === 'tempo' ? { makeSource: makeTempoSource } : {}
      );
    }
    function selectAbSide(which) {

      if (abSelected === which) return;
      const wasPlaying = player.isPlaying() || !!(эл && эл.src && !эл.paused);
      const resumeFrom = wasPlaying ? (эл && эл.src && !эл.paused ? эл.currentTime : player.getPosition()) : null;
      abSelected = which;

      if (config.elementPlayback) {
        const былоИграет = !!(эл && эл.src && !эл.paused);
        if (эл) { try { эл.pause(); } catch (e) {} }
        setTimeout(() => {
          const буф = currentAbBuffer();
          if (!буф) return;
          отдатьВПроигрыватель(буф);
          if (эл) {
            эл.currentTime = Math.max(0, Math.min(буф.duration - 0.05, resumeFrom || 0));
            if (былоИграет) { const о = эл.play(); if (о && о.catch) о.catch(() => сброситьВид()); }
          }
        }, 0);
      }
      if (abOriginalBtn) abOriginalBtn.classList.toggle('active', which === 'original');
      if (abResultBtn) abResultBtn.classList.toggle('active', which === 'result');

      if (config.elementPlayback) return;

      (async () => {
        const ok = await ensureAbResult();
        if (!ok || abSelected !== which) return;
        const buf = currentAbBuffer();
        if (wavePlayBtn) wavePlayBtn.disabled = !buf;

        if (config.abWaveform && buf && waveCanvas) drawWaveform(waveCanvas, buf);
        if (buf && wasPlaying) playAB(which, buf, resumeFrom ?? undefined);
      })();
    }

    if (waveStopBtn) {
      waveStopBtn.addEventListener('click', () => {

        if (эл) { try { эл.pause(); эл.currentTime = Math.max(0, selStart || 0); } catch (e) {} }
        stopAB();
        player.reset();
        const back = (typeof selStart === 'number' && selStart > 0) ? selStart : 0;
        if (dur > 0) setPlayheadFrac(back / dur);
        if (playhead) playhead.style.display = back > 0 ? 'block' : 'none';
        if (transportCurEl) { transportCurEl.textContent = fmtClock(back); transportCurEl.hidden = true; }
        waveStopBtn.disabled = true;
      });
    }
    if (abOriginalBtn) abOriginalBtn.addEventListener('click', () => selectAbSide('original'));
    if (abResultBtn) abResultBtn.addEventListener('click', () => { if (!abResultBtn.disabled) selectAbSide('result'); });
    if (wavePlayBtn) {

      wavePlayBtn.addEventListener('click', async (e) => {

        if (config.elementPlayback) {
          e.stopPropagation();
          player.unlock();
          if (!(await ensureAbResult())) return;

          let буф = currentAbBuffer();
          if (!буф && sourceBuffer && config.controls === 'ringtone-targets') {
            const от = Math.max(0, selStart);
            const до = selEnd > от + 0.05 ? selEnd : sourceBuffer.duration;
            буф = sliceBuffer(sourceBuffer, от, до);
          }
          if (буф && (!эл || !эл.src)) отдатьВПроигрыватель(буф);
          const пл = элПлеер();
          if (пл.src) {
            if (!пл.paused) { пл.pause(); сброситьВид(); return; }
            if (wavePlayIco) { wavePlayIco.innerHTML = ICO_PAUSE; wavePlayIco.closest('.tp-btn')?.classList.add('is-playing'); }

            if (waveStopBtn) waveStopBtn.disabled = false;
            if (waveSeekPos != null) { пл.currentTime = waveSeekPos; waveSeekPos = null; }
            const об = пл.play();
            if (об && об.catch) об.catch(() => сброситьВид());
            return;
          }
        }

        e.stopPropagation();

        player.unlock();
        const seek = waveSeekPos;
        waveSeekPos = null;
        if (!(await ensureAbResult())) return;
        const buf = currentAbBuffer();
        if (!buf) return;

        const seekIn = seek == null ? undefined
          : (dur > 0 ? (seek / dur) * buf.duration : seek);
        playAB(abSelected, buf, seekIn);
      });
    }

    if (eqDownloadBtn) {
      eqDownloadBtn.addEventListener('click', async () => {
        if (!hasWorkableInput()) return;
        window.dispatchEvent(new Event('opitro:tool-interaction'));
        clearError();
        eqDownloadBtn.disabled = true;
        armProgress();
        progressFill.style.width = '30%';
        progressText.textContent = labels.workingLabel;
        try {
          const rendered = await doRender();
          const fmt = eqFormatSel ? eqFormatSel.value : 'wav';

          const base = config.controls === 'multi-file'
            ? (tool === 'mix' ? 'mixed' : 'merged')
            : (file && file.name.replace(/\.[^.]+$/, '')) || 'audio';
          progressFill.style.width = '70%';
          let blob;

          if (fmt === 'mp3') blob = await encodeMP3(rendered, config.mp3Bitrate ? config.mp3Bitrate(readParams()) : 192);
          else if (fmt === 'ogg') {
            const wavFile = new File([encodeWAV(rendered)], 'eq.wav', { type: 'audio/wav' });
            blob = await execFFmpeg({
              inputs: [{ name: 'in0', file: wavFile }],
              buildArgs: (names, out) => ['-i', names[0], '-c:a', 'libvorbis', '-b:a', '192k', out],
              outputName: 'out.ogg',
              mimeType: 'audio/ogg',
            });
          } else blob = encodeWAV(rendered);
          finishProgress(labels.doneLabel);

          const suffix = {
            equalizer: 'eq', fade: 'fade', trim: 'trim', pitch: 'pitch', voice: 'voice',
            speed: 'speed', volume: 'volume', 'sample-rate': 'resampled', reverse: 'reversed',
            normalize: 'normalized', 'stereo-to-mono': 'mono', 'mono-to-stereo': 'stereo',
            compress: 'compressed', loop: 'loop', 'remove-silence': 'trimmed',
            'reverb-echo': 'reverb', chiptune: 'chiptune', 'add-silence': 'padded',
            tempo: 'bpm',
            'dynamic-compressor': 'leveled', 'vocal-remover': 'karaoke',
          }[tool] || 'result';

          const outName = tool === 'mix' ? `mixed.${fmt}`
            : config.controls === 'multi-file' ? `merged.${fmt}`
            : tool === 'dictaphone' ? `${base}.${fmt}`
            : `${base}-${suffix}.${fmt}`;
          downloadBlob(blob, outName);
          exportedClean = true;
        } catch (e) {
          showError(e && e.message ? e.message : String(e));
          hideProgress();
        }
        eqSyncState();
      });
    }

    const mixVolumeEl = root.querySelector('#mix-volume');
    if (mixVolumeEl) {
      const mixVal = root.querySelector('#mix-volume-val');
      mixVolumeEl.addEventListener('input', () => {
        if (mixVal) mixVal.textContent = mixVolumeEl.value + '%';
        invalidateRender();
        eqSyncState();
      });
    }
    const slider = root.querySelector('#ctrl-slider');
    const sliderVal = root.querySelector('#ctrl-slider-val');
    if (slider && sliderVal) {

      const snapSlider = () => {
        if (!config.snapValues) return;
        const v = Number(slider.value);
        slider.value = config.snapValues.reduce((best, n) => (Math.abs(n - v) < Math.abs(best - v) ? n : best), config.snapValues[0]);
      };
      snapSlider();
      sliderVal.textContent = slider.value + (config.sliderUnit || '');
      slider.addEventListener('input', () => {
        snapSlider();
        sliderVal.textContent = slider.value + (config.sliderUnit || '');
        invalidateRender();
        syncSourceNote();
      });
    }

    if (config.controls === 'vizstyles') {
      const vizStylesEl = root.querySelector('#viz-styles');
      const vizPreviewBtn = root.querySelector('#viz-preview-btn');
      const vizPlaceholderEl = root.querySelector('#viz-placeholder');
      const vizNoteEl = root.querySelector('#viz-note');
      const vizVideoEl = root.querySelector('#viz-video');
      let vizPreviewUrl = null;

      const vizEstimateEl = root.querySelector('#viz-estimate');

      function showRenderEstimate(previewMs) {
        if (!vizEstimateEl) return;
        const perSec = previewMs / 1000 / config.previewSeconds;
        let text;
        if (dur > 0) {
          const secs = perSec * dur;
          text = secs < 60
            ? labels.vizEstUnderMinuteLabel
            : (labels.vizEstMinutesLabel || '~{n} min').replace('{n}', String(Math.max(1, Math.round(secs / 60))));
        } else {

          text = (labels.vizEstPerMinuteLabel || '~{n}s per minute of audio')
            .replace('{n}', String(Math.max(1, Math.round(perSec * 60))));
        }
        vizEstimateEl.textContent = `${labels.vizEstPrefixLabel} ${text}`;
        vizEstimateEl.style.display = 'block';
      }

      function setVizBusy(on, slow) {
        const busy = root.querySelector('#viz-busy');
        const busyText = root.querySelector('#viz-busy-text');
        const baseText = slow ? labels.vizRenderingSlowLabel : labels.vizRenderingLabel;
        if (busyText) busyText.textContent = baseText;

        progressHook = on && busyText ? (pct) => { busyText.textContent = `${baseText} ${pct}%`; } : null;
        if (busy) busy.style.display = on ? 'flex' : 'none';
        vizPreviewBtn.disabled = on;
        vizStylesEl.querySelectorAll('.preset-card').forEach((c) => { c.disabled = on; });
        const sizeEl = root.querySelector('#viz-size');
        if (sizeEl) sizeEl.disabled = on;
      }

      async function renderVizPreview() {
        if (!file) return;

        const styleCard = root.querySelector('#viz-styles .preset-card.active')
          || vizStylesEl.querySelector('.preset-card');
        const styleKey = styleCard.dataset.style;
        setVizBusy(true, styleCard.dataset.slow === '1');
        const startedAt = performance.now();
        const blob = await runFfmpegProcess(false, { previewSeconds: config.previewSeconds });
        const tookMs = performance.now() - startedAt;
        setVizBusy(false);
        if (!blob) return;
        vizStylesEl.querySelectorAll('.preset-card').forEach((c) => {
          c.classList.toggle('active', c.dataset.style === styleKey);
        });
        if (vizPlaceholderEl) vizPlaceholderEl.style.display = 'none';

        const stageEl = vizVideoEl.closest('.viz-stage');
        if (stageEl) stageEl.classList.add('has-video');
        if (vizNoteEl) vizNoteEl.style.display = 'block';
        showRenderEstimate(tookMs);

        if (vizPreviewUrl) URL.revokeObjectURL(vizPreviewUrl);
        vizPreviewUrl = URL.createObjectURL(blob);
        vizVideoEl.src = vizPreviewUrl;
        vizVideoEl.play().catch(() => {});
      }

      vizStylesEl.querySelectorAll('.preset-card').forEach((card) => {
        card.addEventListener('click', () => {
          vizStylesEl.querySelectorAll('.preset-card').forEach((c) => c.classList.remove('active'));
          card.classList.add('active');
          if (file) renderVizPreview();
        });
      });

      if (vizPreviewBtn) vizPreviewBtn.addEventListener('click', renderVizPreview);
      const vizSizeEl = root.querySelector('#viz-size');

      if (vizSizeEl) vizSizeEl.addEventListener('change', () => { if (file && vizVideoEl.src) renderVizPreview(); });
    }

    if (config.controls === 'rate1') {
      const rateSel = root.querySelector('#ctrl-select');
      const rateNote = root.querySelector('#rate-note');
      const fmtSelect = root.querySelector('#tool-format');
      function syncRateState() {
        const rate = Number(rateSel.value);

        const mp3Ok = (config.mp3Rates || []).includes(rate);
        if (fmtSelect) {
          const mp3Opt = fmtSelect.querySelector('option[value="mp3"]');
          if (mp3Opt) {
            mp3Opt.disabled = !mp3Ok;
            if (!mp3Ok && fmtSelect.value === 'mp3') fmtSelect.value = 'wav';
          }
        }
        if (rateNote) {
          const same = sourceBuffer && rate === sourceBuffer.sampleRate;
          rateNote.textContent = !mp3Ok
            ? labels.rateNoMp3Label
            : same ? labels.rateSameLabel : '';
          rateNote.style.display = rateNote.textContent ? 'block' : 'none';
        }
        renderedBuffer = null;
        exportedClean = false;
        eqSyncState();
      }
      if (rateSel) {
        rateSel.addEventListener('change', () => {
          stopAB();
          syncRateState();
        });
      }

      rateStateSync = syncRateState;
    }

    if (config.controls === 'volume1') {
      const volumeValEl = root.querySelector('#volume-val');
      function onVolumeInput() {
        const pct = volumeValue();
        const gain = pct / 100;

        const db = gain > 0 ? (20 * Math.log10(gain)) : -Infinity;
        if (volumeValEl) {
          volumeValEl.textContent = pct === 100
            ? '100% (0 dB)'
            : `${pct}% (${db > 0 ? '+' : ''}${db.toFixed(1)} dB)`;
        }

        if (volumeLiveGain) volumeLiveGain.gain.value = gain;
        exportedClean = false;
        eqSyncState();
        invalidateRender();
        if (abSelected !== 'result' && !abResultBtn?.disabled) selectAbSide('result');
      }
      if (volumeSliderEl) volumeSliderEl.addEventListener('input', onVolumeInput);
    }

    if (config.controls === 'speed1') {
      const speedSlider = root.querySelector('#ctrl-slider');
      const speedValEl = root.querySelector('#speed-val');
      const keepPitchEl = root.querySelector('#ctrl-keeppitch');
      const speedPresetsEl = root.querySelector('#speed-presets');
      let speedTimer = 0;
      function speedLabelText(pct) {
        const x = pct / 100;
        return `${x.toFixed(2).replace(/\.?0+$/, '')}x`;
      }
      async function applySpeed(immediate) {

        const oldBuf = abPlayingBuffer;
        const posFrac = oldBuf && oldBuf.duration > 0
          ? Math.min(1, resumePosition() / oldBuf.duration) : 0;
        stopAB();
        renderedBuffer = null;
        exportedClean = false;
        eqSyncState();
        if (!sourceBuffer || !toolIsDirty()) return;

        if (abSelected !== 'result') {
          abSelected = 'result';
          if (abOriginalBtn) abOriginalBtn.classList.remove('active');
          if (abResultBtn) { abResultBtn.disabled = false; abResultBtn.classList.add('active'); }
        }
        if (!(await ensureAbResult())) return;
        const buf = currentAbBuffer();
        if (buf) playAB('result', buf, posFrac * buf.duration);
      }
      function onSpeedInput() {
        const pct = Number(speedSlider.value);
        if (speedValEl) speedValEl.textContent = speedLabelText(pct);
        if (speedPresetsEl) {
          speedPresetsEl.querySelectorAll('.preset-card').forEach((c) => {
            c.classList.toggle('active', Number(c.dataset.speed) === pct);
          });
        }
        clearTimeout(speedTimer);
        speedTimer = window.setTimeout(applySpeed, 500);
      }
      speedSlider.addEventListener('input', onSpeedInput);
      if (keepPitchEl) keepPitchEl.addEventListener('change', () => { clearTimeout(speedTimer); applySpeed(); });
      const speedResetBtn = root.querySelector('#speed-reset-btn');
      if (speedResetBtn) {
        speedResetBtn.addEventListener('click', () => {
          speedSlider.value = '100';
          if (keepPitchEl) keepPitchEl.checked = true;
          stopAB();
          renderedBuffer = null;
          onSpeedInput();
          clearTimeout(speedTimer);
          eqSyncState();
        });
      }
      if (speedPresetsEl) {
        speedPresetsEl.querySelectorAll('.preset-card').forEach((card) => {
          card.addEventListener('click', () => {
            speedSlider.value = card.dataset.speed;
            onSpeedInput();
          });
        });
      }
    }

    if (config.controls === 'voicefx') {
      const voiceFxEl = root.querySelector('#voice-fx');
      const voiceDescEl = root.querySelector('#voice-desc');
      const voiceIntensityWrap = root.querySelector('#voice-intensity-wrap');
      const voiceIntensity = root.querySelector('#voice-intensity');
      const voiceIntensityVal = root.querySelector('#voice-intensity-val');
      let voiceTimer = 0;

      let игратьПослеПересчёта = false;
      async function applyVoiceSelection() {

        const игралоЭл = !!(эл && эл.src && !эл.paused);
        const resumeAt = игралоЭл ? эл.currentTime : resumePosition();
        if (config.elementPlayback) {

          продолжитьПослеПересчёта = игратьПослеПересчёта ? 0 : (игралоЭл ? resumeAt : null);
          местоДоПересчёта = эл && эл.src ? эл.currentTime : null;
          игратьПослеПересчёта = false;
        }
        stopAB();
        renderedBuffer = null;
        exportedClean = false;
        eqSyncState();
        if (!sourceBuffer) return;

        if (abSelected !== 'result') {
          abSelected = 'result';
          if (abOriginalBtn) abOriginalBtn.classList.remove('active');
          if (abResultBtn) { abResultBtn.disabled = false; abResultBtn.classList.add('active'); }
        }
        if (!(await ensureAbResult())) return;
        const buf = currentAbBuffer();
        if (!buf) return;

        if (config.elementPlayback) { отдатьВПроигрыватель(buf); return; }
        playAB('result', buf, resumeAt);
      }

      function вернутьОригинал() {
        voiceFxEl.querySelectorAll('.preset-card').forEach((c) => c.classList.remove('active'));
        if (voiceDescEl) voiceDescEl.textContent = '';
        if (voiceIntensityWrap) voiceIntensityWrap.classList.remove('on');
        renderedBuffer = null;
        exportedClean = false;
        eqSyncState();
        if (!sourceBuffer) return;
        abSelected = 'original';
        if (config.elementPlayback) {
          продолжитьПослеПересчёта = 0;
          местоДоПересчёта = null;
          отдатьВПроигрыватель(sourceBuffer);
        } else {
          playAB('original', sourceBuffer, 0);
        }
      }
      voiceFxEl.querySelectorAll('.preset-card').forEach((card) => {
        card.addEventListener('click', () => {

          if (card.classList.contains('active')) { вернутьОригинал(); return; }
          voiceFxEl.querySelectorAll('.preset-card').forEach((c) => c.classList.remove('active'));
          card.classList.add('active');
          if (voiceDescEl) voiceDescEl.textContent = card.dataset.desc || '';

          if (voiceIntensityWrap) {
            voiceIntensityWrap.classList.add('on');
            const имя = root.querySelector('#voice-intensity-name');
            if (имя) имя.textContent = card.querySelector('.pc-label')?.textContent || labels.voiceIntensityLabel;
          }
          игратьПослеПересчёта = true;
          applyVoiceSelection();
        });
      });
      if (voiceIntensity) {
        voiceIntensity.addEventListener('input', () => {
          if (voiceIntensityVal) voiceIntensityVal.textContent = voiceIntensity.value + '%';

          clearTimeout(voiceTimer);
          voiceTimer = window.setTimeout(applyVoiceSelection, 500);
        });
      }
    }

    if (config.controls === 'pitch1') {
      const pitchSlider = root.querySelector('#ctrl-slider');
      const centsSlider = root.querySelector('#ctrl-cents');
      const pitchValEl = root.querySelector('#pitch-val');
      const centsValEl = root.querySelector('#cents-val');
      let pitchTimer = 0;
      function onPitchInput() {
        const v = Number(pitchSlider.value);
        const c = centsSlider ? Number(centsSlider.value) : 0;
        if (pitchValEl) {
          pitchValEl.textContent = v === 0
            ? labels.pitchUnchangedLabel
            : `${v > 0 ? '+' : ''}${v} ${labels.semitonesShortLabel} (${v > 0 ? labels.pitchUpLabel : labels.pitchDownLabel})`;
        }
        if (centsValEl) centsValEl.textContent = `${c > 0 ? '+' : ''}${c} ${labels.centsShortLabel}`;

        const resumeAt = resumePosition();
        stopAB();
        renderedBuffer = null;
        exportedClean = false;
        eqSyncState();

        clearTimeout(pitchTimer);
        pitchTimer = window.setTimeout(async () => {
          if (!sourceBuffer || !toolIsDirty()) return;

        if (abSelected !== 'result') {
          abSelected = 'result';
          if (abOriginalBtn) abOriginalBtn.classList.remove('active');
          if (abResultBtn) { abResultBtn.disabled = false; abResultBtn.classList.add('active'); }
        }
          if (!(await ensureAbResult())) return;
          const buf = currentAbBuffer();
          if (buf) playAB('result', buf, resumeAt);
        }, 500);
      }
      [pitchSlider, centsSlider].forEach((el) => el && el.addEventListener('input', onPitchInput));
    }

    const rtVolumeEl = root.querySelector('#rt-volume');
    const rtVolumeVal = root.querySelector('#rt-volume-val');
