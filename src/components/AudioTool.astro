      const splitBtn = root.querySelector('#split-download-btn');

      function syncSplitUi() {
        const byDuration = modeSel.value === 'duration';
        valueLabel.textContent = byDuration ? labels.splitMinutesLabel : labels.splitPartsCountLabel;
        valueEl.min = byDuration ? '1' : '2';
        valueEl.max = byDuration ? '120' : '50';
        if (byDuration && Number(valueEl.value) < 1) valueEl.value = '5';
