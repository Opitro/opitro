    )}
    {controls === 'voicefx' && (
      <>
        <div class="preset-cards" id="voice-fx">
          {config.voiceEffects.map((e) => (
            <button type="button" class="preset-card" data-effect={e.key} data-desc={labels[e.desc] || ''}>
