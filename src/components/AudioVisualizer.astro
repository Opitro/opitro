    recHint: 'Іде запис. Натисніть «Зупинити», і запис відкриється як звичайний трек.',
    noRec: 'Не вдалося записати звук. Спробуйте ще раз.',
    error: 'Не вийшло. Спробуйте ще раз або виберіть 720p.',
    done: 'Готово', remove: 'Прибрати цей файл', undo: 'Скасувати', mb: 'МБ',
    realtime: 'Браузер не вміє швидко збирати відео, тому запис іде в реальному часі.',
    dropBig: 'Виберіть аудіофайл', dropRest: 'або перетягніть його сюди', or: 'або',
    color: 'Колір', cover: 'Обкладинка', coverAdd: 'Додати обкладинку — стане фоном і в центр', coverRemove: 'Прибрати обкладинку', styleGroup: 'Стиль', format: 'Формат', cancel: 'Скасувати', seek: 'Позиція',
    frame: 'Поточний кадр', wave: 'Хвиля', spectroImg: 'Спектрограма',
    styles: { sphere: 'Сфера', neon: 'Неон', space: 'Космос', mandala: 'Мандала', vu: 'Стрілки', vhs: 'VHS', bars: 'Стовпчики', mirror: 'Дзеркало', circle: 'Коло', blob: 'Крапля', hills: 'Гори', scope: 'Осцилограф', line: 'Лінія', led: 'Еквалайзер', pulse: 'Пульс', spectro: 'Спектрограма', ring: 'Кільце', sparks: 'Іскри', retro: 'Ретро', tunnel: 'Тунель', dots: 'Крапки', waves: 'Хвилі', vinyl: 'Платівка', ridges: 'Хребти' },
    palettes: { night: 'Ніч', sunset: 'Захід', mint: "М'ята", fire: 'Вогонь', mono: 'Білий' },
