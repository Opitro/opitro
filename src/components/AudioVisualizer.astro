    dropBig: 'Выберите аудиофайл', dropRest: 'или перетащите его сюда', or: 'или',
    color: 'Цвет', custom: 'Свой цвет', hue: 'Цвет', intensity: 'Фон', yourText: 'Ваш текст', length: 'Длина', whole: 'Весь трек', sec: 'с', fps60: '60 кадров', clipHint: 'Отрезок начинается с места бегунка.', effects: 'Эффекты', fx: { shake: 'Тряска', glow: 'Свечение', grain: 'Зерно', particles: 'Частицы', progress: 'Прогресс' }, cover: 'Обложка', artist: 'Исполнитель', title: 'Название', coverAdd: 'Добавить обложку — встанет фоном и в центр', coverRemove: 'Убрать обложку', styleGroup: 'Стиль', format: 'Формат', cancel: 'Отмена', seek: 'Позиция',
    frame: 'Текущий кадр', wave: 'Волна', spectroImg: 'Спектрограмма',
    styles: { sphere: 'Сфера', text: 'Текст', neon: 'Неон', space: 'Космос', mandala: 'Мандала', vu: 'Стрелки', vhs: 'VHS', bars: 'Столбики', mirror: 'Зеркало', circle: 'Круг', blob: 'Капля', hills: 'Горы', scope: 'Осциллограф', line: 'Линия', led: 'Эквалайзер', pulse: 'Пульс', spectro: 'Спектрограмма', ring: 'Кольцо', sparks: 'Искры', retro: 'Ретро', tunnel: 'Тоннель', dots: 'Точки', waves: 'Волны', vinyl: 'Пластинка', ridges: 'Хребты' },
    palettes: { night: 'Ночь', sunset: 'Закат', mint: 'Мята', fire: 'Огонь', mono: 'Белый' },
  },
  uk: {
    play: 'Слухати', pause: 'Пауза', video: 'Завантажити відео', image: 'Завантажити картинку', videoShort: 'Відео', imageShort: 'Картинка',
    making: 'Збирання відео…', recording: 'Запис відео…', decoding: 'Читання файлу…',
    badImage: 'Не вдалося відкрити картинку. Підійдуть JPG, PNG, WebP.', converting: 'Рідкісний формат — відкриваю трохи довше…', badFile: 'Не вдалося прочитати файл. Підійдуть MP3, M4A, M4R, WAV, OGG, FLAC, AIFF, WMA.',
    tooLong: 'Файл довший за 15 хвилин. Виберіть трек коротший.',
    tooLongVid: 'Відео можна зібрати з треку до 10 хвилин.',
    noMic: 'Немає доступу до мікрофона. Дозвольте його в налаштуваннях браузера.',
    micMode: 'Запис з мікрофона', mic: 'Мікрофон', micOff: 'Зупинити',
    pick: 'Вибрати файл', other: 'Інший файл', recName: 'Запис',
    recHint: 'Іде запис. Натисніть «Зупинити», і запис відкриється як звичайний трек.',
    noRec: 'Не вдалося записати звук. Спробуйте ще раз.',
    error: 'Не вийшло. Спробуйте ще раз або виберіть 720p.',
    done: 'Готово', remove: 'Прибрати цей файл', undo: 'Скасувати', mb: 'МБ',
    realtime: 'Браузер не вміє швидко збирати відео, тому запис іде в реальному часі.',
    dropBig: 'Виберіть аудіофайл', dropRest: 'або перетягніть його сюди', or: 'або',
    color: 'Колір', custom: 'Свій колір', hue: 'Колір', intensity: 'Фон', yourText: 'Ваш текст', length: 'Довжина', whole: 'Весь трек', sec: 'с', fps60: '60 кадрів', clipHint: 'Відрізок починається з місця бігунка.', effects: 'Ефекти', fx: { shake: 'Трясіння', glow: 'Сяйво', grain: 'Зерно', particles: 'Частинки', progress: 'Прогрес' }, cover: 'Обкладинка', artist: 'Виконавець', title: 'Назва', coverAdd: 'Додати обкладинку — стане фоном і в центр', coverRemove: 'Прибрати обкладинку', styleGroup: 'Стиль', format: 'Формат', cancel: 'Скасувати', seek: 'Позиція',
    frame: 'Поточний кадр', wave: 'Хвиля', spectroImg: 'Спектрограма',
    styles: { sphere: 'Сфера', text: 'Текст', neon: 'Неон', space: 'Космос', mandala: 'Мандала', vu: 'Стрілки', vhs: 'VHS', bars: 'Стовпчики', mirror: 'Дзеркало', circle: 'Коло', blob: 'Крапля', hills: 'Гори', scope: 'Осцилограф', line: 'Лінія', led: 'Еквалайзер', pulse: 'Пульс', spectro: 'Спектрограма', ring: 'Кільце', sparks: 'Іскри', retro: 'Ретро', tunnel: 'Тунель', dots: 'Крапки', waves: 'Хвилі', vinyl: 'Платівка', ridges: 'Хребти' },
    palettes: { night: 'Ніч', sunset: 'Захід', mint: "М'ята", fire: 'Вогонь', mono: 'Білий' },
  },
  en: {
    play: 'Listen', pause: 'Pause', video: 'Download video', image: 'Download image', videoShort: 'Video', imageShort: 'Image',
    making: 'Building video…', recording: 'Recording video…', decoding: 'Reading file…',
    badImage: 'Could not open the image. JPG, PNG and WebP work.', converting: 'Rare format — opening takes a little longer…', badFile: 'Could not read the file. MP3, M4A, M4R, WAV, OGG, FLAC, AIFF and WMA work.',
    tooLong: 'The file is longer than 15 minutes. Pick a shorter track.',
    tooLongVid: 'Video can be built from tracks up to 10 minutes.',
    noMic: 'No microphone access. Allow it in your browser settings.',
    micMode: 'Microphone recording', mic: 'Microphone', micOff: 'Stop',
    pick: 'Choose file', other: 'Another file', recName: 'Recording',
    recHint: 'Recording. Press “Stop” and the recording opens as a normal track.',
    noRec: 'Could not record sound. Try again.',
    error: 'That did not work. Try again or pick 720p.',
    done: 'Done', remove: 'Remove this file', undo: 'Undo', mb: 'MB',
    realtime: 'This browser cannot build video quickly, so it records in real time.',
    dropBig: 'Choose an audio file', dropRest: 'or drop it here', or: 'or',
    color: 'Colour', custom: 'Your colour', hue: 'Colour', intensity: 'Background', yourText: 'Your text', length: 'Length', whole: 'Whole track', sec: 's', fps60: '60 fps', clipHint: 'The clip starts at the playhead.', effects: 'Effects', fx: { shake: 'Shake', glow: 'Glow', grain: 'Grain', particles: 'Particles', progress: 'Progress' }, cover: 'Cover', artist: 'Artist', title: 'Title', coverAdd: 'Add a cover — it goes into the background and the centre', coverRemove: 'Remove cover', styleGroup: 'Style', format: 'Format', cancel: 'Cancel', seek: 'Position',
    frame: 'Current frame', wave: 'Waveform', spectroImg: 'Spectrogram',
    styles: { sphere: 'Sphere', text: 'Text', neon: 'Neon', space: 'Space', mandala: 'Mandala', vu: 'VU meters', vhs: 'VHS', bars: 'Bars', mirror: 'Mirror', circle: 'Circle', blob: 'Blob', hills: 'Hills', scope: 'Oscilloscope', line: 'Line', led: 'Equalizer', pulse: 'Pulse', spectro: 'Spectrogram', ring: 'Ring', sparks: 'Sparks', retro: 'Retro', tunnel: 'Tunnel', dots: 'Dots', waves: 'Waves', vinyl: 'Vinyl', ridges: 'Ridges' },
    palettes: { night: 'Night', sunset: 'Sunset', mint: 'Mint', fire: 'Fire', mono: 'White' },
  },
  es: {
    play: 'Escuchar', pause: 'Pausa', video: 'Descargar vídeo', image: 'Descargar imagen', videoShort: 'Vídeo', imageShort: 'Imagen',
    making: 'Creando vídeo…', recording: 'Grabando vídeo…', decoding: 'Leyendo archivo…',
    badImage: 'No se pudo abrir la imagen. Sirven JPG, PNG y WebP.', converting: 'Formato poco común — tarda un poco más…', badFile: 'No se pudo leer el archivo. Sirven MP3, M4A, M4R, WAV, OGG, FLAC, AIFF y WMA.',
    tooLong: 'El archivo dura más de 15 minutos. Elige una pista más corta.',
    tooLongVid: 'El vídeo se puede crear con pistas de hasta 10 minutos.',
    noMic: 'Sin acceso al micrófono. Permítelo en los ajustes del navegador.',
    micMode: 'Grabación del micrófono', mic: 'Micrófono', micOff: 'Parar',
    pick: 'Elegir archivo', other: 'Otro archivo', recName: 'Grabación',
    recHint: 'Grabando. Pulsa «Parar» y la grabación se abrirá como una pista normal.',
    noRec: 'No se pudo grabar el sonido. Inténtalo de nuevo.',
    error: 'No salió. Inténtalo de nuevo o elige 720p.',
    done: 'Listo', remove: 'Quitar este archivo', undo: 'Deshacer', mb: 'MB',
    realtime: 'Este navegador no crea vídeo rápido, así que graba en tiempo real.',
    dropBig: 'Elige un archivo de audio', dropRest: 'o arrástralo aquí', or: 'o',
    color: 'Color', custom: 'Tu color', hue: 'Color', intensity: 'Fondo', yourText: 'Tu texto', length: 'Duración', whole: 'Todo el tema', sec: 's', fps60: '60 fps', clipHint: 'El fragmento empieza en el cursor.', effects: 'Efectos', fx: { shake: 'Temblor', glow: 'Resplandor', grain: 'Grano', particles: 'Partículas', progress: 'Progreso' }, cover: 'Portada', artist: 'Artista', title: 'Título', coverAdd: 'Añadir portada — va al fondo y al centro', coverRemove: 'Quitar portada', styleGroup: 'Estilo', format: 'Formato', cancel: 'Cancelar', seek: 'Posición',
    frame: 'Fotograma actual', wave: 'Onda', spectroImg: 'Espectrograma',
    styles: { sphere: 'Esfera', text: 'Texto', neon: 'Neón', space: 'Espacio', mandala: 'Mandala', vu: 'Vúmetros', vhs: 'VHS', bars: 'Barras', mirror: 'Espejo', circle: 'Círculo', blob: 'Gota', hills: 'Colinas', scope: 'Osciloscopio', line: 'Línea', led: 'Ecualizador', pulse: 'Pulso', spectro: 'Espectrograma', ring: 'Anillo', sparks: 'Chispas', retro: 'Retro', tunnel: 'Túnel', dots: 'Puntos', waves: 'Ondas', vinyl: 'Vinilo', ridges: 'Crestas' },
    palettes: { night: 'Noche', sunset: 'Atardecer', mint: 'Menta', fire: 'Fuego', mono: 'Blanco' },
  },
};
const w = WORDS[locale] || WORDS.ru;
const { styles, palettes, fx: fxNames, ...runtime } = w;

const PALETTE_COLORS = {
  night: ['#38bdf8', '#818cf8'], sunset: ['#f472b6', '#fbbf24'], mint: ['#34d399', '#22d3ee'],
  fire: ['#fde047', '#ef4444'], mono: ['#ffffff', '#94a3b8'],
};
const fxIcon = (d) => '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + d + '</svg>';
const FX = [
  ['shake', fxIcon('<path d="M3 12l3-4 3 8 3-10 3 12 3-8 3 2"/>')],
  ['glow', fxIcon('<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>')],
  ['grain', fxIcon('<circle cx="6" cy="6" r="1"/><circle cx="12" cy="8" r="1"/><circle cx="18" cy="5" r="1"/><circle cx="8" cy="13" r="1"/><circle cx="15" cy="14" r="1"/><circle cx="5" cy="19" r="1"/><circle cx="11" cy="18" r="1"/><circle cx="18" cy="19" r="1"/>')],
  ['particles', fxIcon('<path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/>')],
  ['progress', fxIcon('<rect x="3" y="10" width="18" height="4" rx="2"/><path d="M5 12h8" stroke-width="3"/>')],
];
const FORMATS = [['16x9', '16:9'], ['9x16', '9:16'], ['1x1', '1:1']];

const ICON_PLAY = '<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>';
const ICON_CARET = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';
const ICON_DL = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"/></svg>';
const ICON_NOTE = '<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>';
const ICON_CLOSE = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"/><path d="M18 6L6 18"/></svg>';
const ICON_UNDO = '<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11"/></svg>';
const ICON_IMAGE = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="14" height="14" rx="2.5"/><path d="M3 15l4-4 4 4 2-2 4 4"/><path d="M19 2v6M16 5h6"/></svg>';
const ICON_X_SMALL = '<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12"/><path d="M18 6L6 18"/></svg>';
const ICON_MIC = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>';
---

<style is:inline set:html={css}></style>

<div class="viz" data-words={JSON.stringify(runtime)}>
  <input type="file" class="zv-input" hidden />
  <div class="zv-head">
    <div class="zv-drop" role="button" tabindex="0">
      <span class="zv-drop-ico" set:html={ICON_NOTE} />
      <span class="zv-drop-text"><b>{w.dropBig}</b> {w.dropRest}</span>
      <span class="zv-drop-or">{w.or}</span>
      <button type="button" class="zv-btn zv-mic"><Fragment set:html={ICON_MIC} /><span>{w.mic}</span></button>
    </div>
    <div class="zv-file" hidden>
      <span class="zv-file-ico" set:html={ICON_NOTE} />
      <span class="zv-name"></span>
      <button type="button" class="zv-btn zv-other">{w.other}</button>
      <button type="button" class="zv-btn zv-mic"><Fragment set:html={ICON_MIC} /><span>{w.mic}</span></button>
    </div>
  </div>

  <div class="zv-stage">
    <canvas></canvas>
    <button type="button" class="zv-corner zv-remove" aria-label={w.remove} title={w.remove} hidden><Fragment set:html={ICON_CLOSE} /></button>
    <input type="text" class="zv-stage-text" placeholder={w.yourText} aria-label={w.yourText} maxlength="40" autocomplete="off" hidden />
    <button type="button" class="zv-corner zv-undo" aria-label={w.undo} title={w.undo} hidden><Fragment set:html={ICON_UNDO} /></button>
  </div>
  <div class="zv-seek is-off">
    <canvas></canvas>
    <input type="range" min="0" max="1000" step="1" value="0" aria-label={w.seek} />
  </div>
  <div class="zv-time is-off"><span class="zv-cur">0:00</span><span class="zv-dur">0:00</span></div>

  <div class="zv-row zv-main">
    <button type="button" class="zv-btn zv-play" disabled><span class="zv-play-ico" set:html={ICON_PLAY} /><span class="zv-play-label">{w.play}</span></button>
    <span class="zv-label zv-color-label">{w.color}</span>
    <div class="zv-swatches" role="group" aria-label={w.color}>
      {Object.entries(PALETTE_COLORS).map(([key, [a, b]]) => (
        <button type="button" data-palette={key} aria-label={palettes[key]} title={palettes[key]}
                aria-pressed={key === 'night' ? 'true' : 'false'}
                style={`background:linear-gradient(135deg,${a},${b})`}></button>
      ))}
      <button type="button" class="zv-custom" data-palette="custom" aria-label={w.custom} title={w.custom}
              aria-pressed="false" aria-expanded="false"></button>
    </div>
    <div class="zv-pop" hidden>
      <label class="zv-pop-row"><span>{w.hue}</span><input type="color" class="zv-color-input" value="#a855f7" /></label>
      <label class="zv-pop-row"><span>{w.intensity}</span><input type="range" class="zv-intensity" min="0" max="100" step="1" value="100" /><em class="zv-int-val">100%</em></label>
    </div>
    <div class="zv-art-group">
    <span class="zv-label">{w.cover}</span>
    <div class="zv-art-box">
      <button type="button" class="zv-art" aria-label={w.coverAdd} title={w.coverAdd}>
        <span class="zv-art-plus" set:html={ICON_IMAGE} />
        <canvas width="72" height="72"></canvas>
      </button>
      <button type="button" class="zv-art-x" aria-label={w.coverRemove} title={w.coverRemove} hidden><Fragment set:html={ICON_X_SMALL} /></button>
    </div>
    </div>
    <input type="file" class="zv-art-input" accept="image/*" hidden />
  </div>

  <div class="zv-captions">
    <input type="text" class="zv-artist" placeholder={w.artist} aria-label={w.artist} maxlength="80" autocomplete="off" />
    <input type="text" class="zv-title" placeholder={w.title} aria-label={w.title} maxlength="120" autocomplete="off" />
  </div>

  <div class="zv-styles" role="group" aria-label={w.styleGroup}>
    {Object.entries(styles).map(([key, label]) => (
      <button type="button" data-style={key} aria-pressed={key === 'sphere' ? 'true' : 'false'}>
        <canvas width="192" height="108"></canvas><span>{label}</span>
      </button>
    ))}
  </div>

  <div class="zv-row zv-format">
    <span class="zv-label">{w.format}</span>
    <div class="zv-seg" role="group" aria-label={w.format}>
      {FORMATS.map(([key, label]) => (
        <button type="button" data-format={key} aria-pressed={key === '16x9' ? 'true' : 'false'}>{label}</button>
      ))}
    </div>
  </div>

  <div class="zv-row zv-format zv-clip">
    <span class="zv-label">{w.length}</span>
    <div class="zv-seg" role="group" aria-label={w.length}>
      {[0, 15, 30, 60].map((len) => (
        <button type="button" data-clip={len} aria-pressed={len === 0 ? 'true' : 'false'}>{len ? `${len} ${w.sec}` : w.whole}</button>
      ))}
    </div>
  </div>

  <div class="zv-row zv-fx">
    <span class="zv-label">{w.effects}</span>
    <div class="zv-chips" role="group" aria-label={w.effects}>
      {FX.map(([key, icon]) => (
        <button type="button" class="zv-chip" data-fx={key} aria-pressed="false"><Fragment set:html={icon} /><span>{w.fx[key]}</span></button>
      ))}
    </div>
  </div>

  <div class="zv-row zv-actions">
    <div class="zv-dl">
      <button type="button" class="zv-btn zv-video" aria-haspopup="menu" aria-expanded="false" disabled>
        <Fragment set:html={ICON_DL} /><span class="zv-video-label"><span class="zv-long">{w.video}</span><span class="zv-short">{w.videoShort}</span></span><Fragment set:html={ICON_CARET} />
      </button>
      <div class="zv-menu" role="menu" hidden>
        <button type="button" role="menuitem" data-quality="720" data-fps="30"><span>720p</span><span class="zv-size" data-q="720" data-fps="30"></span></button>
        <button type="button" role="menuitem" data-quality="720" data-fps="60"><span>720p · {w.fps60}</span><span class="zv-size" data-q="720" data-fps="60"></span></button>
        <button type="button" role="menuitem" data-quality="1080" data-fps="30"><span>1080p</span><span class="zv-size" data-q="1080" data-fps="30"></span></button>
        <button type="button" role="menuitem" data-quality="1080" data-fps="60"><span>1080p · {w.fps60}</span><span class="zv-size" data-q="1080" data-fps="60"></span></button>
        <button type="button" role="menuitem" data-quality="2160" data-fps="30" hidden><span>4K</span><span class="zv-size" data-q="2160" data-fps="30"></span></button>
      </div>
    </div>
    <button type="button" class="zv-btn zv-cancel" aria-label={w.cancel} title={w.cancel} hidden><Fragment set:html={ICON_CLOSE} /><span class="zv-long">{w.cancel}</span></button>
    <div class="zv-dl zv-dl-img">
      <button type="button" class="zv-btn zv-image" aria-haspopup="menu" aria-expanded="false" disabled>
        <Fragment set:html={ICON_DL} /><span class="zv-long">{w.image}</span><span class="zv-short">{w.imageShort}</span><Fragment set:html={ICON_CARET} />
      </button>
      <div class="zv-menu" role="menu" hidden>
        <button type="button" role="menuitem" data-image="frame-png"><span>{w.frame}</span><span class="zv-size">PNG</span></button>
        <button type="button" role="menuitem" data-image="wave-png"><span>{w.wave}</span><span class="zv-size">PNG</span></button>
        <button type="button" role="menuitem" data-image="wave-svg"><span>{w.wave}</span><span class="zv-size">SVG</span></button>
        <button type="button" role="menuitem" data-image="spectro-png"><span>{w.spectroImg}</span><span class="zv-size">PNG</span></button>
      </div>
    </div>
  </div>
  <p class="zv-status" aria-live="polite"></p>
</div>

