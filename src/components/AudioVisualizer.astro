---
import css from '../styles/audio-visualizer.css?inline';

const { locale = 'ru' } = Astro.props;

const WORDS = {
  ru: {
    play: 'Слушать', pause: 'Пауза', video: 'Скачать видео', image: 'Скачать картинку', videoShort: 'Видео', imageShort: 'Картинка',
    making: 'Сборка видео…', recording: 'Запись видео…', decoding: 'Чтение файла…',
    badImage: 'Не удалось открыть картинку. Подойдут JPG, PNG, WebP.', converting: 'Редкий формат — открываю чуть дольше…', badFile: 'Не удалось прочитать файл. Подойдут MP3, M4A, M4R, WAV, OGG, FLAC, AIFF, WMA.',
