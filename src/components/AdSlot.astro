<div class="ad-slot" data-ad-slot>
  <div class="ad-slot-box"></div>
</div>

<style is:global>
  .ad-slot{

    width:100%;max-width:680px;margin:0 auto;padding:0 2rem;
  }
  .ad-slot-box{

    min-height:0;border-radius:10px;
    opacity:0;transition:opacity .35s ease;pointer-events:none;
  }

  .ad-slot.visible .ad-slot-box{opacity:1;pointer-events:auto}
  @media(max-width:640px){.ad-slot{padding:0 1rem}}
</style>

<script>

  window.addEventListener(
    'opitro:tool-interaction',
    () => {
      document.querySelectorAll('[data-ad-slot]').forEach((el) => el.classList.add('visible'));
    },
    { once: true }
  );
</script>
