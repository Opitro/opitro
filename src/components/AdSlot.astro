<div class="ad-slot" data-ad-slot>
  <div class="ad-slot-box"></div>
</div>

<style is:global>
  .ad-slot{
    /* width:100% is required, not decorative -- Layout's <main> is a column flexbox, and a
       flex item with horizontal auto margins (used here to center it) does NOT stretch to
       fill the cross axis by default. Without this, the box shrinks to its (empty) content
       size -- a near-zero-width sliver that still reserves its min-height, which read as a
       thin vertical line before the ad is revealed. Caught live via a user screenshot. */
    width:100%;max-width:680px;margin:0 auto;padding:0 2rem;
  }
  .ad-slot-box{
    /* Резерв высоты снят до подключения рекламной сети. Он держался ради того, чтобы появление
       объявления не сдвигало текст, -- решение верное, но сети пока нет, и в это место ничего не
       приходит: два пустых просвета по 82 пикселя на каждой странице отдавались под то, чего не
       существует. Когда сеть подключат, вернуть min-height и поля -- и именно с первой отрисовки,
       иначе сдвиг вернётся. */
    min-height:0;border-radius:10px;
    opacity:0;transition:opacity .35s ease;pointer-events:none;
  }
  /* No border reveal -- there's no real ad network wired up yet, so a bordered empty box
     after interaction just reads as a broken/placeholder rectangle. Once real ad content
     renders into this box, style it then; until that exists, only reserve the space. */
  .ad-slot.visible .ad-slot-box{opacity:1;pointer-events:auto}
  @media(max-width:640px){.ad-slot{padding:0 1rem}}
</style>

<script>
  // Space for the ad is reserved from the first paint (fixed min-height, always in the
  // layout) so revealing it never shifts content below — only opacity toggles. It fades
  // in only after the visitor has actually used a calculator on this page, never shown
  // to someone who just landed and bounced. See project_ads memory for why.
  window.addEventListener(
    'opitro:tool-interaction',
    () => {
      document.querySelectorAll('[data-ad-slot]').forEach((el) => el.classList.add('visible'));
    },
    { once: true }
  );
</script>
