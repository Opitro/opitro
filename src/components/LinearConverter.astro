---
interface Props {
  factor: number;
  fromUnit: string;
  toUnit: string;
  fromUnitShort: string;
  toUnitShort: string;
  defaultValue?: number;

  reverseHref?: string;
  reverseAriaLabel?: string;

  toolSlug?: string;

  copyLabel?: string;
  copiedLabel?: string;
  exactLabel?: string;
}

const {
  factor,
  fromUnit,
  toUnit,
  fromUnitShort,
  toUnitShort,
  defaultValue = 10,
  reverseHref,
  reverseAriaLabel,
  toolSlug,
  copyLabel,
  copiedLabel,
  exactLabel,
} = Astro.props;
---

<div class="lc-widget lc-has-foot" data-factor={factor} data-slug={toolSlug}>
  <div class="lc-pane lc-from">
    <label class="lc-cap" for="lc-input">{fromUnit}</label>
    <div class="lc-line">
      <input type="text" id="lc-input" value={defaultValue} inputmode="decimal" autocomplete="off"
        spellcheck="false" enterkeyhint="done">
      <span class="lc-unit">{fromUnitShort}</span>
    </div>
    <div class="lc-foot"></div>
  </div>
  {reverseHref && (
    <a class="lc-swap" href={reverseHref} aria-label={reverseAriaLabel}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h15M18 8l-4-4M18 8l-4 4M21 16H6M6 16l4-4M6 16l4 4"/></svg>
    </a>
  )}
  <div class="lc-pane lc-to">
    <div class="lc-cap">{toUnit}</div>
    <div class="lc-line">
      <span class="lc-num" id="lc-result" aria-live="polite"></span>
      <span class="lc-unit ru-unit">{toUnitShort}</span>
    </div>
    <div class="lc-foot">
      <span class="result-exact" id="lc-exact" data-label={exactLabel} hidden></span>
      <button type="button" class="lc-copy" id="lc-copy" title={copyLabel} aria-label={copyLabel} data-done={copiedLabel} hidden>
        <svg class="copy-sheet" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"/></svg>
        <svg class="copy-done" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
      </button>
    </div>
  </div>
</div>

<script>
  import { convertLinear } from '../lib/linear-converter.js';
  import { parseQuantity, COMPOUND } from '../lib/parse-quantity.js';

  const widget = document.querySelector('.lc-widget');
  const factor = parseFloat(widget.dataset.factor);
  const compound = COMPOUND[widget.dataset.slug] || null;
  const input = document.getElementById('lc-input');
  const result = document.getElementById('lc-result');
  const exactEl = document.getElementById('lc-exact');
  const copyBtn = document.getElementById('lc-copy');
  const unitEl = document.querySelector('.ru-unit');

  function group(str) {
    const [int, frac] = String(str).split('.');
    const g = int.replace(/\B(?=(\d{3})+(?!\d))/g, '\u2009');
    return frac ? g + '.' + frac : g;
  }

  function round(n) {
    const abs = Math.abs(n);
    if (abs === 0) return '0';
    const digits = abs >= 1000 ? 1 : abs >= 100 ? 2 : abs >= 1 ? 2 : abs >= 0.01 ? 4 : 6;
    return String(Number(n.toFixed(digits)));
  }
  function exact(n) {

    return String(Number(n.toFixed(6)));
  }

  function update() {
    const value = parseQuantity(input.value, compound);

    if (value == null) {
      result.textContent = '';
      if (unitEl) unitEl.hidden = true;
      exactEl.hidden = true;
      copyBtn.hidden = true;
      return;
    }
    const out = convertLinear(value, factor);
    const short = round(out);
    const full = exact(out);
    if (unitEl) unitEl.hidden = false;
    result.textContent = group(short);

    if (full !== short) {
      exactEl.textContent = (exactEl.dataset.label || '') + ' ' + group(full);
      exactEl.hidden = false;
    } else {
      exactEl.hidden = true;
    }
    copyBtn.hidden = false;
    copyBtn.dataset.value = full;
  }

  input.addEventListener('input', () => {
    update();
    writeUrl();
    window.dispatchEvent(new Event('opitro:tool-interaction'));
  });

  let urlTimer = 0;
  function writeUrl() {
    clearTimeout(urlTimer);
    urlTimer = window.setTimeout(() => {
      const u = new URL(location.href);
      if (input.value.trim()) u.searchParams.set('v', input.value.trim());
      else u.searchParams.delete('v');
      history.replaceState(null, '', u);
    }, 400);
  }
  const fromUrl = new URLSearchParams(location.search).get('v');
  if (fromUrl && parseQuantity(fromUrl, compound) != null) input.value = fromUrl;

  copyBtn.addEventListener('click', async () => {
    const text = copyBtn.dataset.value || result.textContent;
    try {
      await navigator.clipboard.writeText(text);
    } catch {

      const r = document.createRange();
      r.selectNodeContents(result);
      const sel = getSelection();
      sel.removeAllRanges();
      sel.addRange(r);
      return;
    }
    const label = copyBtn.getAttribute('aria-label');
    copyBtn.classList.add('done');
    copyBtn.setAttribute('aria-label', copyBtn.dataset.done || label);
    setTimeout(() => {
      copyBtn.classList.remove('done');
      copyBtn.setAttribute('aria-label', label);
    }, 1400);
  });

  input.addEventListener('focus', () => input.select());
  update();
</script>

<style>
  .result-exact{color:var(--muted);font-variant-numeric:tabular-nums;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .lc-copy{flex:none;margin-left:auto;display:flex;align-items:center;justify-content:center;width:30px;height:26px;padding:0;
    background:none;border:1px solid var(--line);border-radius:9px;color:var(--muted);cursor:pointer;
    transition:border-color .18s,color .18s}
  .lc-copy[hidden]{display:none}
  .lc-copy svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  .lc-copy .copy-done{display:none}
  .lc-copy.done .copy-sheet{display:none}
  .lc-copy.done .copy-done{display:block}
  .lc-copy.done{border-color:rgba(74,222,158,0.5);color:var(--accent)}
  .lc-copy:hover{border-color:rgba(255,255,255,0.22);color:var(--text)}
</style>
