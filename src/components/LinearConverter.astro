---
interface Props {
  factor: number;
  fromUnit: string;
  toUnit: string;
  fromUnitShort: string;
  toUnitShort: string;
  defaultValue?: number;

  reverseHref?: string;
  reverseAriaLabel?: string;

  toolSlug?: string;

  copyLabel?: string;
  copiedLabel?: string;
  exactLabel?: string;
}

const {
  factor,
  fromUnit,
  toUnit,
  fromUnitShort,
  toUnitShort,
  defaultValue = 10,
  reverseHref,
  reverseAriaLabel,
  toolSlug,
  copyLabel,
  copiedLabel,
  exactLabel,
} = Astro.props;
---

<div class="lc-widget" data-factor={factor} data-slug={toolSlug}>
  <div class="field">
    <label for="lc-input">{fromUnit} ({fromUnitShort})</label>

    <input type="text" id="lc-input" value={defaultValue} inputmode="decimal" autocomplete="off"
      spellcheck="false" enterkeyhint="done">
  </div>
  {reverseHref && (
    <a class="lc-swap" href={reverseHref} aria-label={reverseAriaLabel}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8h15M18 8l-4-4M18 8l-4 4M21 16H6M6 16l4-4M6 16l4 4"/></svg>
    </a>
  )}
  <div class="result-box">
    <div class="result-value"><span id="lc-result"></span> <span class="ru-unit">{toUnitShort}</span></div>

    <div class="result-exact" id="lc-exact" data-label={exactLabel} hidden></div>
    <div class="result-row">
      <span class="result-label">{toUnit}</span>
      <button type="button" class="lc-copy" id="lc-copy" data-done={copiedLabel} hidden>{copyLabel}</button>
    </div>
  </div>
</div>

<script>
  import { convertLinear } from '../lib/linear-converter.js';
  import { parseQuantity, COMPOUND } from '../lib/parse-quantity.js';

  const widget = document.querySelector('.lc-widget');
  const factor = parseFloat(widget.dataset.factor);
  const compound = COMPOUND[widget.dataset.slug] || null;
  const input = document.getElementById('lc-input');
  const result = document.getElementById('lc-result');
  const exactEl = document.getElementById('lc-exact');
  const copyBtn = document.getElementById('lc-copy');
  const unitEl = document.querySelector('.ru-unit');

  function group(str) {
    const [int, frac] = String(str).split('.');
    const g = int.replace(/\B(?=(\d{3})+(?!\d))/g, '\u2009');
    return frac ? g + '.' + frac : g;
  }

  function round(n) {
    const abs = Math.abs(n);
    if (abs === 0) return '0';
    const digits = abs >= 1000 ? 1 : abs >= 100 ? 2 : abs >= 1 ? 2 : abs >= 0.01 ? 4 : 6;
    return String(Number(n.toFixed(digits)));
  }
  function exact(n) {

    return String(Number(n.toFixed(6)));
  }

  function update() {
    const value = parseQuantity(input.value, compound);

    if (value == null) {
      result.textContent = '';
      if (unitEl) unitEl.hidden = true;
      exactEl.hidden = true;
      copyBtn.hidden = true;
      return;
    }
    const out = convertLinear(value, factor);
    const short = round(out);
    const full = exact(out);
    if (unitEl) unitEl.hidden = false;
    result.textContent = group(short);

    if (full !== short) {
      exactEl.textContent = (exactEl.dataset.label || '') + ' ' + group(full);
      exactEl.hidden = false;
    } else {
      exactEl.hidden = true;
    }
    copyBtn.hidden = false;
    copyBtn.dataset.value = full;
  }

  input.addEventListener('input', () => {
    update();
    writeUrl();
    window.dispatchEvent(new Event('opitro:tool-interaction'));
  });

  let urlTimer = 0;
  function writeUrl() {
    clearTimeout(urlTimer);
    urlTimer = window.setTimeout(() => {
      const u = new URL(location.href);
      if (input.value.trim()) u.searchParams.set('v', input.value.trim());
      else u.searchParams.delete('v');
      history.replaceState(null, '', u);
    }, 400);
  }
  const fromUrl = new URLSearchParams(location.search).get('v');
  if (fromUrl && parseQuantity(fromUrl, compound) != null) input.value = fromUrl;

  copyBtn.addEventListener('click', async () => {
    const text = copyBtn.dataset.value || result.textContent;
    try {
      await navigator.clipboard.writeText(text);
    } catch {

      const r = document.createRange();
      r.selectNodeContents(result);
      const sel = getSelection();
      sel.removeAllRanges();
      sel.addRange(r);
      return;
    }
    const was = copyBtn.textContent;
    copyBtn.textContent = copyBtn.dataset.done || was;
    setTimeout(() => { copyBtn.textContent = was; }, 1400);
  });

  update();
</script>

<style>
  .result-exact{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums;margin-top:2px}
  .result-row{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:4px}
  .lc-copy{background:none;border:1px solid var(--line);border-radius:9px;color:var(--muted);
    font-family:inherit;font-size:12px;padding:4px 10px;cursor:pointer;
    transition:border-color .18s,color .18s}
  .lc-copy:hover{border-color:rgba(255,255,255,0.22);color:var(--text)}
  .lc-copy:active{border-color:rgba(74,222,158,0.5);color:var(--accent)}
</style>
