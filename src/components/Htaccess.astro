    https: 'Принудительный HTTPS', proxy: 'Сайт за посредником (Cloudflare и подобные)',
    mirrors: 'Зеркала', mNone: 'не трогать', mBare: 'на без-www', mWww: 'на www',
    indexes: 'Запретить показ содержимого папок', hotlink: 'Защита от хотлинка',
    ips: 'Блокировка адресов (по одному в строке)', ipsHint: '192.168.1.1\n2001:db8::1\n10.0.0.0/8',
    gzip: 'Сжатие ответа (mod_deflate)', cache: 'Сроки хранения в браузере (mod_expires)',
