// Свои слова у каждого вида: три заметки под инструментом о том, где такой код встречается
// и чего от него ждать. Это единственное, чем страницы отличаются друг от друга.
const ПО_ВИДАМ = {
  datamatrix: {
    ru: ['<b>Квадратик из точек.</b> Им метят лекарства и товары в «Честном знаке», мелкие детали и платы — там, где места мало, а записать надо много.',
