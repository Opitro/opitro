    ru: ['<b>Квадрат с мишенью посередине.</b> По нему узнают билеты на поезд и самолёт в Европе, а также электронные проездные.',
         '<b>Внутри — строка перевозчика.</b> Часто это набор служебных полей, а не человеческий текст; мы показываем его как есть, не переставляя знаки.',
         '<b>Билет остаётся при вас.</b> Ни снимок, ни прочитанное никуда не отправляются — а на билете обычно стоит и ваша фамилия.'],
    uk: ['<b>Квадрат із мішенню посередині.</b> За ним упізнають квитки на потяг і літак у Європі, а також електронні проїзні.',
         '<b>Усередині — рядок перевізника.</b> Часто це набір службових полів, а не людський текст; ми показуємо його як є, нічого не переставляючи.',
         '<b>Квиток лишається при вас.</b> Ні знімок, ні прочитане нікуди не надсилаються — а на квитку зазвичай стоїть і ваше прізвище.'],
    en: ['<b>A square with a bullseye in the middle.</b> It identifies train and plane tickets in Europe, as well as electronic travel passes.',
         '<b>Inside is the carrier’s own string.</b> Often a set of service fields rather than human text; we show it as it is, rearranging nothing.',
         '<b>The ticket stays with you.</b> Neither the picture nor the result is sent anywhere — and a ticket usually carries your name too.'],
    es: ['<b>Un cuadrado con una diana en el centro.</b> Identifica billetes de tren y de avión en Europa, y también abonos electrónicos.',
         '<b>Dentro está la cadena del transportista.</b> A menudo son campos de servicio, no texto humano; lo mostramos tal cual, sin reordenar nada.',
         '<b>El billete se queda con usted.</b> Ni la imagen ni el resultado se envían a ninguna parte, y un billete suele llevar también su nombre.'],
  },
};

// Имена полей GS1 по-человечески. Ключи приходит из gs1.js (gtin, партия, годенДо...);
// незнакомый ключ показываем как есть -- лучше непривычное слово, чем потерянное поле.
const ПОЛЯ_GS1 = {
  ru: { gtin: 'Номер товара', gtinВнутри: 'Номер товара внутри', sscc: 'Грузовое место',
    артикул: 'Артикул', артикулПоставщика: 'Артикул поставщика', вариант: 'Вариант',
    годенДо: 'Годен до', заказ: 'Заказ', изготовлено: 'Изготовлено', количество: 'Количество',
    кудаGLN: 'Куда', лучшеДо: 'Лучше до', местоGLN: 'Место', оплатитьДо: 'Оплатить до',
    партия: 'Партия', платёж: 'Платёж', продатьДо: 'Продать до', сайт: 'Ссылка',
    серийный: 'Серийный номер', серийныйВнутри: 'Серийный номер внутри', упаковано: 'Упаковано',
    мера: 'Мера', иное: 'Другое поле' },
  uk: { gtin: 'Номер товару', gtinВнутри: 'Номер товару всередині', sscc: 'Вантажне місце',
    артикул: 'Артикул', артикулПоставщика: 'Артикул постачальника', вариант: 'Варіант',
    годенДо: 'Придатний до', заказ: 'Замовлення', изготовлено: 'Виготовлено', количество: 'Кількість',
    кудаGLN: 'Куди', лучшеДо: 'Краще до', местоGLN: 'Місце', оплатитьДо: 'Сплатити до',
    партия: 'Партія', платёж: 'Платіж', продатьДо: 'Продати до', сайт: 'Посилання',
    серийный: 'Серійний номер', серийныйВнутри: 'Серійний номер усередині', упаковано: 'Запаковано',
    мера: 'Міра', иное: 'Інше поле' },
  en: { gtin: 'Item number', gtinВнутри: 'Inner item number', sscc: 'Logistic unit',
    артикул: 'Part number', артикулПоставщика: 'Supplier part number', вариант: 'Variant',
    годенДо: 'Use by', заказ: 'Order', изготовлено: 'Made on', количество: 'Quantity',
    кудаGLN: 'Ship to', лучшеДо: 'Best before', местоGLN: 'Location', оплатитьДо: 'Due date',
    партия: 'Batch', платёж: 'Payment', продатьДо: 'Sell by', сайт: 'Link',
    серийный: 'Serial number', серийныйВнутри: 'Inner serial number', упаковано: 'Packed on',
    мера: 'Measure', иное: 'Other field' },
  es: { gtin: 'Número de artículo', gtinВнутри: 'Número interior', sscc: 'Unidad logística',
    артикул: 'Referencia', артикулПоставщика: 'Referencia del proveedor', вариант: 'Variante',
    годенДо: 'Consumir antes de', заказ: 'Pedido', изготовлено: 'Fabricado', количество: 'Cantidad',
    кудаGLN: 'Destino', лучшеДо: 'Consumir preferentemente', местоGLN: 'Ubicación',
    оплатитьДо: 'Pagar antes de', партия: 'Lote', платёж: 'Pago', продатьДо: 'Vender antes de',
    сайт: 'Enlace', серийный: 'Número de serie', серийныйВнутри: 'Número de serie interior',
    упаковано: 'Envasado', мера: 'Medida', иное: 'Otro campo' },
};

const с = ОБЩЕЕ[locale] || ОБЩЕЕ.ru;
const заметки = (ПО_ВИДАМ[вид] || ПО_ВИДАМ.datamatrix)[locale]
  || (ПО_ВИДАМ[вид] || ПО_ВИДАМ.datamatrix).ru;
---

<style is:inline set:html={css}></style>

<div class="кс" data-words={JSON.stringify(с)} data-fields={JSON.stringify(ПОЛЯ_GS1[locale] || ПОЛЯ_GS1.ru)} data-вид={вид} data-locale={locale}>
  <div class="кс-режим" role="group">
    <button type="button" class="кс-реж выбран" id="кс-реж-камера">{с.camera}</button>
    <button type="button" class="кс-реж" id="кс-реж-файл">{с.photo}</button>
  </div>

  <div class="кс-окно" id="кс-окно">
    <video id="кс-видео" playsinline muted hidden></video>
    <img id="кс-снимок" alt="" hidden />
    <span class="кс-пусто" id="кс-пусто">{с.idle}</span>
    <span class="кс-прицел" id="кс-прицел" hidden></span>
  </div>

  <div class="кс-ряд">
    <button type="button" class="кс-кнопка" id="кс-пуск">{с.start}</button>
    <button type="button" class="кс-простая" id="кс-снять" hidden>{с.shot}</button>
    <button type="button" class="кс-простая" id="кс-стоп" hidden>{с.stop}</button>
    <button type="button" class="кс-кнопка" id="кс-выбрать" hidden>{с.choose}</button>
    <span class="кс-сказ" id="кс-сказ"></span>
  </div>
  <input type="file" class="кс-файл" id="кс-файл" accept="image/*" />

  <div class="кс-ответ" id="кс-ответ"></div>

  <div class="кс-заметки">
    {заметки.map((з) => <div class="кс-заметка" set:html={з}></div>)}
  </div>
</div>

<script>
  import { прочитатьСнимок, умеетВид } from '../lib/code-read.js';
  import { разобратьGS1 } from '../lib/gs1.js';

  const корень = document.querySelector('.кс');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const вид = корень.dataset['вид'] || 'datamatrix';
    const ИМЕНА = JSON.parse(корень.dataset.fields || '{}');
    const язык = корень.dataset.locale || 'ru';
    const $ = (и) => document.getElementById(и);

    const окно = $('кс-окно');
    const видео = $('кс-видео');
    const снимок = $('кс-снимок');
    const пусто = $('кс-пусто');
    const прицел = $('кс-прицел');
    const кнПуск = $('кс-пуск');
    const кнСнять = $('кс-снять');
    const кнСтоп = $('кс-стоп');
    const кнВыбрать = $('кс-выбрать');
    const поле = $('кс-файл');
    const ответ = $('кс-ответ');

    let поток = null;
    let режим = 'камера';

    function сказать(текст) {
      const э = $('кс-сказ');
      э.textContent = текст;
      э.classList.add('видно');
      clearTimeout(э._т);
      э._т = setTimeout(() => э.classList.remove('видно'), 2200);
    }

    function беда(текст) {
      ответ.innerHTML = `<div class="кс-беда">${текст}</div>`;
    }

    // Содержимое кода -- всегда текстом и целиком. Ничего не открываем сами: код мог быть
    // подменён, и решать, идти ли по нему, человеку, а не нам.
    function показать(найдено) {
      const поля = вид === 'datamatrix' ? разобратьGS1(найдено.текст) : null;
      const строки = (поля && поля.length)
        ? `<div class="кс-заголовок">${с.fields}</div><div class="кс-поля">`
          + поля.map((п) => {
            const имя = ИМЕНА[п.имя] || п.имя;
            // Дату показываем словами на языке страницы: «30 сентября 2026» человеку
            // говорит больше, чем «260930», и уж точно больше машинной записи со временем
            // и часовым поясом. Так же она показана на странице штрихкодов.
            const знач = (п.разбор && п.разбор.дата)
              ? п.разбор.дата.toLocaleDateString(язык, { year: 'numeric', month: 'long', day: 'numeric' })
              : п.значение;
            return `<div class="кс-поле"><span>${имя}</span><b>${знач}</b></div>`;
          }).join('')
          + '</div>'
        : '';
      ответ.innerHTML = `<div class="кс-заголовок">${с.found}</div>`
        + `<div class="кс-текст" id="кс-текст"></div>${строки}`
        + `<div class="кс-ряд"><button type="button" class="кс-простая" id="кс-копи">${с.copy}</button></div>`;
      // Через textContent, а не в разметку: в коде может лежать что угодно, вплоть до
      // куска чужой вёрстки, и вставлять его как разметку нельзя.
      $('кс-текст').textContent = найдено.текст;
      $('кс-копи').addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(найдено.текст); сказать(с.copied); } catch (е) {}
      });
    }

    async function разобрать(картинка) {
      ответ.innerHTML = '';
      сказать(с.looking);
      let найдено = null;
      try { найдено = await прочитатьСнимок({ картинка, нужно: вид }); } catch (е) { найдено = null; }
      if (найдено && найдено.текст) показать(найдено);
      else беда(с.notFound);
    }

    // ---- Камера ------------------------------------------------------------------------------
    // Снимаем по нажатию, а не перебором кадров: этих видов кодов встроенный распознаватель
    // ищет дольше, чем QR, и на слабом телефоне поток кадров только греет его впустую.
    async function включить() {
      if (!(await умеетВид(вид))) { беда(с.noSupport); return; }
      try {
        поток = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { ideal: 'environment' }, width: { ideal: 1920 } }, audio: false,
        });
      } catch (е) {
        беда(е && е.name === 'NotAllowedError' ? с.denied : с.noCam);
        return;
      }
      видео.srcObject = поток;
      видео.hidden = false;
      снимок.hidden = true;
      пусто.hidden = true;
      прицел.hidden = false;
      await видео.play().catch(() => {});
      кнПуск.hidden = true;
      кнСнять.hidden = false;
      кнСтоп.hidden = false;
    }

    function выключить() {
      if (поток) { поток.getTracks().forEach((д) => д.stop()); поток = null; }
      видео.srcObject = null;
      видео.hidden = true;
      прицел.hidden = true;
      пусто.hidden = false;
      кнПуск.hidden = false;
      кнСнять.hidden = true;
      кнСтоп.hidden = true;
    }

    async function снятьКадр() {
      if (!видео.videoWidth) return;
      const х = document.createElement('canvas');
      х.width = видео.videoWidth;
      х.height = видео.videoHeight;
      х.getContext('2d').drawImage(видео, 0, 0);
      await разобрать(х);
    }

    кнПуск.addEventListener('click', включить);
    кнСтоп.addEventListener('click', выключить);
    кнСнять.addEventListener('click', снятьКадр);
    window.addEventListener('pagehide', выключить);

    // ---- Снимок ------------------------------------------------------------------------------
    function показатьСнимок(файл) {
      const адрес = URL.createObjectURL(файл);
      снимок.onload = async () => { URL.revokeObjectURL(адрес); await разобрать(снимок); };
      снимок.src = адрес;
      снимок.hidden = false;
      пусто.hidden = true;
      кнВыбрать.textContent = с.again;
    }

    кнВыбрать.addEventListener('click', () => поле.click());
    поле.addEventListener('change', () => { if (поле.files && поле.files[0]) показатьСнимок(поле.files[0]); });
    окно.addEventListener('dragover', (е) => е.preventDefault());
    окно.addEventListener('drop', (е) => {
      е.preventDefault();
      const ф = е.dataTransfer && е.dataTransfer.files && е.dataTransfer.files[0];
      if (ф && ф.type.startsWith('image/')) { режимНа('файл'); показатьСнимок(ф); }
    });

    // ---- Переключение способа ------------------------------------------------------------------
    function режимНа(новый) {
      режим = новый;
      $('кс-реж-камера').classList.toggle('выбран', новый === 'камера');
      $('кс-реж-файл').classList.toggle('выбран', новый === 'файл');
      ответ.innerHTML = '';
      if (новый === 'камера') {
        снимок.hidden = true;
        кнВыбрать.hidden = true;
        кнПуск.hidden = false;
        пусто.textContent = с.idle;
        пусто.hidden = false;
      } else {
        выключить();
        кнПуск.hidden = true;
        кнВыбрать.hidden = false;
        пусто.textContent = с.idlePhoto;
        пусто.hidden = !!снимок.src;
        снимок.hidden = !снимок.src;
      }
    }
    $('кс-реж-камера').addEventListener('click', () => режимНа('камера'));
    $('кс-реж-файл').addEventListener('click', () => режимНа('файл'));

    // Умеет ли браузер читать этот вид -- говорим СРАЗУ, до разрешения на камеру.
    умеетВид(вид).then((умеет) => { if (!умеет) беда(с.noSupport); });

    window.__ксСостояние = () => ({
      вид,
      режим,
      камераИдёт: !!поток,
      ответ: ответ.textContent.trim().slice(0, 200),
      естьТекст: !!document.getElementById('кс-текст'),
    });
  })();
</script>
