const заметки = (ПО_ВИДАМ[вид] || ПО_ВИДАМ.datamatrix)[locale]
  || (ПО_ВИДАМ[вид] || ПО_ВИДАМ.datamatrix).ru;
---

<style is:inline set:html={css}></style>

<div class="кс" data-words={JSON.stringify(с)} data-fields={JSON.stringify(ПОЛЯ_GS1[locale] || ПОЛЯ_GS1.ru)} data-вид={вид} data-locale={locale}>
  <!-- ОДНО ОКНО И ОДНА ТОЧКА НАЖАТИЯ. Нажали значок -- поднялась камера и заняла всё окно;
       нажали ссылку под ним -- открылся выбор файла. Ряда кнопок нет нигде: включение и
       выключение -- это одно состояние. -->
  <div class="кс-окно" id="кс-окно">
    <video id="кс-видео" playsinline muted hidden></video>
    <img id="кс-снимок" alt="" hidden />
    <span class="кс-центр" id="кс-центр">
      <button type="button" class="кс-пуск" id="кс-пуск">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8.5A2.5 2.5 0 0 1 6.5 6h1.2l1-1.6A1 1 0 0 1 9.6 4h4.8a1 1 0 0 1 .9.4l1 1.6h1.2A2.5 2.5 0 0 1 20 8.5v8A2.5 2.5 0 0 1 17.5 19h-11A2.5 2.5 0 0 1 4 16.5v-8z"/><circle cx="12" cy="12.5" r="3.2"/></svg>
        {с.start}
      </button>
      <button type="button" class="кс-ссылка" id="кс-загрузить">{с.upload}</button>
    </span>
    <!-- Рамка прицела: показывает, куда класть код. Видна только при работающей камере. -->
    <span class="кс-прицел" id="кс-прицел" hidden></span>
    <button type="button" class="кс-крест" id="кс-крест" hidden
            title={с.clear} aria-label={с.clear}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg>
    </button>
    <span class="кс-намёк" id="кс-намёк" hidden></span>
    <span class="кс-луч" id="кс-луч"></span>
    <span class="кс-затвор-ряд">
      <button type="button" class="кс-затвор" id="кс-затвор" hidden
              title={с.shot} aria-label={с.shot}><i></i></button>
      <!-- Предложение переснять: и когда код не нашёлся, и когда нашёлся -- второй товар
           сканируют сразу за первым, и искать для этого крестик не надо. -->
      <button type="button" class="кс-переснять" id="кс-переснять" hidden>{с.retry}</button>
    </span>
    <span class="кс-ход" id="кс-ход"></span>
  </div>
  <input type="file" class="кс-файл" id="кс-файл" accept="image/*" />

  <div class="кс-ответ" id="кс-ответ"></div>
  <div class="кс-беда" id="кс-беда"></div>

  <div class="кс-заметки">
    {заметки.map((з) => <div class="кс-заметка" set:html={з}></div>)}
  </div>
</div>

<script>
  import { прочитатьКадр, прочитатьСнимок, умеетВид } from '../lib/code-read.js';
  import { разобратьGS1 } from '../lib/gs1.js';
  import { пикнуть, подготовитьЗвук, состояниеЗвука } from '../lib/beep.js';

  const корень = document.querySelector('.кс');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const ИМЕНА = JSON.parse(корень.dataset.fields || '{}');
    const вид = корень.dataset['вид'] || 'datamatrix';
    const язык = корень.dataset.locale || 'ru';
    const $ = (и) => document.getElementById(и);

    const окно = $('кс-окно');
    const видео = $('кс-видео');
    const снимок = $('кс-снимок');
    const центр = $('кс-центр');
    const ход = $('кс-ход');
    const прицел = $('кс-прицел');
    const крест = $('кс-крест');
    const затвор = $('кс-затвор');
    const намёк = $('кс-намёк');
    const переснять = $('кс-переснять');
    const поле = $('кс-файл');
    const ответ = $('кс-ответ');
    const бедаЭ = $('кс-беда');

    let поток = null;
    let родной = true;        // умеет ли сам браузер читать этот вид кодов
    let часы = 0;

    const ЗН_КОПИ = '<svg viewBox="0 0 24 24" aria-hidden="true">'
      + '<rect x="9" y="9" width="11" height="11" rx="2"/>'
      + '<path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"/></svg>';

    function беда(текст) { бедаЭ.innerHTML = текст || ''; }

    // Линия хода: пока поднимается камера или разбирается снимок. Доля выдуманная -- честного
    // числа тут нет вовсе, зато видно, что работа идёт и страница не повисла.
    // Линия хода убрана: при включении камеры она бежала по низу окна, и человек принимал её
    // за начало съёмки. Теперь работу показывает только луч -- и ровно тогда, когда идёт разбор.
    function пуститьХод() { return;
      ход.classList.add('идёт');
      let доля = 4;
      clearInterval(часы);
      часы = setInterval(() => {
        доля = Math.min(92, доля + (92 - доля) * 0.18);
        ход.style.width = `${доля}%`;
      }, 120);
    }
    function убратьХод(успех) {
      clearInterval(часы);
      ход.style.width = успех ? '100%' : '0%';
      setTimeout(() => { ход.classList.remove('идёт'); ход.style.width = '0%'; }, 260);
    }

    function мигнуть() {
      окно.classList.add('прочитано');
      setTimeout(() => окно.classList.remove('прочитано'), 900);
    }

    // Ответ -- одна строка: подпись, прочитанное, знак копирования. У Data Matrix под ней
    // такими же строками идут поля GS1, если код записан по их правилам.
    function показать(текст) {
      const поля = вид === 'datamatrix' ? разобратьGS1(текст) : [];
      const строки = (поля || []).map((п) => {
        const имя = ИМЕНА[п.имя] || п.имя;
        const знач = (п.разбор && п.разбор.дата)
          ? п.разбор.дата.toLocaleDateString(язык, { year: 'numeric', month: 'long', day: 'numeric' })
          : п.значение;
        return `<div class="кс-строка"><span class="кс-имя">${имя}</span><span class="кс-знач">${знач}</span></div>`;
      }).join('');
      ответ.innerHTML = `<div class="кс-строка"><span class="кс-имя">${с.result}</span>`
        + `<span class="кс-знач" id="кс-текст"></span>`
        + `<button type="button" class="кс-копи" id="кс-копи" title="${с.copy}" aria-label="${с.copy}">${ЗН_КОПИ}</button></div>`
        + строки;
      // Через textContent: в коде может лежать что угодно, вплоть до куска чужой вёрстки.
      $('кс-текст').textContent = текст;
      const номер = (поля || []).find((п) => п.имя === 'gtin');
      if (номер) добавитьБазу(номер.значение);
      $('кс-копи').addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(текст); беда(с.copied); setTimeout(() => беда(''), 1600); } catch (е) {}
      });
      мигнуть();
      // Звук обязателен, а не украшение: со сканером человек смотрит НА КОРОБКУ, а не на
      // экран, и понять, что код прочитан, ему больше нечем.
      пикнуть();
    }


    // ---- Открытая база товаров -----------------------------------------------------------------
    // ЗАПРОС ИДЁТ ТОЛЬКО ПО НАЖАТИЮ, И ЭТО НЕ ПРИДИРКА. Вся страница обещает, что снимок и
    // прочитанное остаются на устройстве. Молчаливый запрос наружу сделал бы это обещание
    // ложью, даже если наружу уходит один только номер товара. Кнопка возвращает решение
    // человеку: нажал -- значит согласился, и видит, откуда взялось название.
    //
    // База -- Open Food Facts: открытая, без ключей и регистрации, собирается людьми. Оттого
    // в ней в основном еда, и о промахе мы говорим прямо, а не подставляем случайное название
    // из поиска. Названия товара в самом коде нет -- ни у кого.
    function добавитьБазу(номер) {
      const ряд = document.createElement('div');
      ряд.className = 'кс-строка';
      ряд.innerHTML = `<span class="кс-имя">${с.product}</span>`
        + `<span class="кс-знач" id="кс-база-место">`
        + `<button type="button" class="кс-ссылка" id="кс-база">${с.base}</button></span>`;
      ответ.appendChild(ряд);
      $('кс-база').addEventListener('click', () => спроситьБазу(номер));
    }

    async function спроситьБазу(номер) {
      const место = $('кс-база-место');
      место.textContent = с.baseWait;
      let товар = null;                      // null -- связи нет, false -- нет в базе
      try {
        const поля = ['product_name', 'product_name_' + язык, 'brands', 'quantity'].join(',');
        const ответСети = await fetch(
          `https://world.openfoodfacts.org/api/v2/product/${encodeURIComponent(номер)}.json?fields=${поля}`);
        const данные = await ответСети.json();
        товар = данные && данные.status === 1 ? данные.product : false;
      } catch (е) { товар = null; }

      const ссылка = `<a class="кс-ссылка" href="https://www.google.com/search?q=${encodeURIComponent(номер)}"`
        + ` target="_blank" rel="noopener nofollow">${с.search}</a>`;
      if (товар === null) {
        место.innerHTML = `${с.baseFail} `
          + `<button type="button" class="кс-ссылка" id="кс-база">${с.base}</button>`;
        $('кс-база').addEventListener('click', () => спроситьБазу(номер));
        return;
      }
      if (товар === false) { место.innerHTML = `${с.baseNone} ${ссылка}`; return; }
      const имя = товар['product_name_' + язык] || товар.product_name || '';
      const хвост = [товар.brands, товар.quantity].filter(Boolean).join(', ');
      место.textContent = '';
      const строка = document.createElement('span');
      строка.textContent = [имя, хвост].filter(Boolean).join(' · ') || с.baseNone;
      место.appendChild(строка);
      место.insertAdjacentHTML('beforeend', ' ' + ссылка);
    }

    /**
     * Кадр из камеры -- РОВНО ТО, ЧТО ВИДНО В ОКНЕ, а не весь кадр камеры.
     *
     * Владелец: «я снимаю на весь выделенный экран, а снимок показывает всё фото целиком».
     * Так и было: живую картинку окно показывает обрезанной по себе (object-fit: cover), а
     * снимок брался полным кадром камеры -- шире и с полями. Человек наводил по одному, а
     * получал другое, и разбор шёл по тому, чего он не видел.
     *
     * Поэтому вырезаем из кадра ту самую часть, что попала в окно: считаем её по соотношению
     * сторон окна и кадра -- точно так же, как это делает браузер при cover.
     */

    // ЕСЛИ КОД НЕ НАШ -- СКАЗАТЬ, КАКОЙ ЭТО, И КУДА ИДТИ.
    // Владелец: «я фоткаю штрихкод, а он не сообщает мне, что это не тот код». Так и было:
    // мы искали ровно свой вид и молчали «кода не видно», хотя код на снимке есть. Человек
    // при этом уверен, что снимает правильно, и винит страницу. Теперь после промаха смотрим
    // кадр ещё раз, уже на ВСЕ виды, и если что-то нашлось -- называем вид и даём ссылку на
    // нужный сканер.
    const СТРАНИЦЫ = { qr: 'qr-scan', bar: 'barcode-scan', datamatrix: 'datamatrix-scan',
      pdf417: 'pdf417-scan', aztec: 'aztec-scan' };

    function видПоФормату(формат) {
      const ф = String(формат || '').toLowerCase();
      if (ф === 'qr_code') return 'qr';
      if (ф === 'data_matrix') return 'datamatrix';
      if (ф === 'pdf417' || ф === 'pdf_417') return 'pdf417';
      if (ф === 'aztec') return 'aztec';
      return 'bar';
    }

    /** Показать «это другой код» со ссылкой. Возвращает true, если чужой код нашёлся. */
    async function чужойКод(картинка, точки) {
      let найдено = null;
      try {
        найдено = точки
          ? await прочитатьКадр({ источник: картинка, точки, нужно: 'оба', снимок: true })
          : await прочитатьСнимок({ картинка, нужно: 'оба' });
      } catch (е) { найдено = null; }
      if (!найдено || !найдено.текст) return false;
      const чужой = видПоФормату(найдено.формат);
      if (чужой === вид) return false;               // тот же вид -- значит просто не дочитали
      const имяЧужого = с.kinds[чужой] || чужой;
      const имяНашего = с.kinds[вид] || вид;
      const адрес = `/${язык}/${СТРАНИЦЫ[чужой]}`;
      беда(с.notOurs.replace('{а}', имяЧужого).replace('{б}', имяНашего)
        + ` <a class="кс-ссылка" href="${адрес}">`
        + с.openOther.replace('{а}', имяЧужого) + '</a>');
      return true;
    }

    function кадрВКартинку() {
      const кВ = видео.videoWidth, кВыс = видео.videoHeight;
      const р = окно.getBoundingClientRect();
      const к_окна = р.width / р.height;
      const к_кадра = кВ / кВыс;
      let ш = кВ, в = кВыс, сдвигХ = 0, сдвигY = 0;
      if (к_кадра > к_окна) {           // кадр шире окна -- режем по бокам
        ш = Math.round(кВыс * к_окна);
        сдвигХ = Math.round((кВ - ш) / 2);
      } else {                           // кадр выше окна -- режем сверху и снизу
        в = Math.round(кВ / к_окна);
        сдвигY = Math.round((кВыс - в) / 2);
      }
      const х = document.createElement('canvas');
      х.width = ш;
      х.height = в;
      const к = х.getContext('2d', { willReadFrequently: true });
      к.drawImage(видео, сдвигХ, сдвигY, ш, в, 0, 0, ш, в);
      return { холст: х, точки: к.getImageData(0, 0, ш, в) };
    }

    // ---- Камера ------------------------------------------------------------------------------
    // Ищем код прямо в потоке, четыре раза в секунду: чаще -- только греет телефон, а эти
    // виды кодов распознаватель ищет дольше, чем QR.
    async function включить() {
      беда('');
      // Перед включением убираем прошлый кадр: иначе застывшая картинка лежит поверх
      // камеры, и человек видит старый снимок вместо живого кадра. Именно на это владелец
      // и жаловался: «второй раз камера вообще не запускается».
      снимок.hidden = true;
      переснять.hidden = true;
      // КАМЕРУ ВКЛЮЧАЕМ ВСЕГДА. Раньше здесь стоял отказ: нет своего распознавателя у браузера
      // (Safari, Firefox) -- и кнопка просто ничего не делала, только писала серую строку под
      // окном. Владелец так и сказал: «с телефона камера не включается». Теперь читаем
      // запаской: она тяжелее и медленнее, но работает везде, а отказ не работает нигде.
      родной = await умеетВид(вид);
      if (!родной) беда(с.slowCam);
      пуститьХод();
      // ПОДСКАЗКА О РАЗРЕШЕНИИ. Браузер показывает свой запрос вверху окна, и человек, впервые
      // попавший на страницу, часто его не замечает: он смотрит в центр, на окно сканера.
      // Пишем прямо под окном, чего от него ждут -- и только если разрешение ещё не дано.
      let спрашивали = false;
      try {
        const с2 = navigator.permissions && await navigator.permissions.query({ name: 'camera' });
        if (!с2 || с2.state !== 'granted') { беда(с.askCam); спрашивали = true; }
      } catch (е) { беда(с.askCam); спрашивали = true; }
      try {
        поток = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { ideal: 'environment' }, width: { ideal: 1920 } }, audio: false,
        });
      } catch (е) {
        убратьХод(false);
        беда(е && е.name === 'NotAllowedError' ? с.denied : с.noCam);
        return;
      }
      if (спрашивали) беда('');
      видео.srcObject = поток;
      видео.hidden = false;
      снимок.hidden = true;
      центр.hidden = true;
      прицел.hidden = false;
      крест.hidden = false;
      await видео.play().catch(() => {});
      убратьХод(true);
      // САМИ НЕ ИЩЕМ. Порядок тот же, что на сканере штрихкодов: навёл, нажал затвор, пошёл
      // луч, получил ответ. Непрерывный поиск без затвора был моей выдумкой и давал третье
      // поведение на четырёх сканерах одного сайта.
      затвор.hidden = false;
      намёк.hidden = false;
      намёк.textContent = с.liveHint;
    }

    /**
     * Снять кадр. Порядок ровно тот, что назвал владелец: снял -- КАДР ЗАСТЫЛ в окне --
     * по нему пошёл луч -- ответ ниже окна.
     *
     * Кадр именно застывает, а не продолжает шевелиться: человек видит, ЧТО он снял, и
     * понимает, по чему сейчас идёт разбор. Живая картинка под лучом выглядела бы так,
     * будто луч ничего не сканирует.
     */
    async function снятьКадр() {
      if (!поток || !видео.videoWidth) return;
      затвор.hidden = true;
      прицел.hidden = true;
      намёк.textContent = с.looking;

      const { холст, точки } = кадрВКартинку();
      // Застывший кадр показываем той же картинкой, что и загруженный файл: одно место --
      // одно поведение.
      if (снимок.src && снимок.src.startsWith('blob:')) URL.revokeObjectURL(снимок.src);
      снимок.src = холст.toDataURL('image/jpeg', 0.92);
      // Кадр уже обрезан по окну, поэтому показываем его во всю площадь -- ровно так же, как
      // он выглядел живым. Загруженный файл, наоборот, вписывается целиком: его мы не
      // наводили и обрезать не вправе.
      снимок.classList.add('снят');
      снимок.hidden = false;
      видео.hidden = true;
      // Камеру гасим сразу: кадр уже снят, держать её включённой незачем -- и лампочка
      // рядом с камерой не горит зря.
      if (поток) { поток.getTracks().forEach((д) => д.stop()); поток = null; }
      видео.srcObject = null;

      // Секунда до луча: человек должен успеть увидеть, ЧТО он снял, прежде чем по кадру
      // побежит линия. Без паузы кадр и луч появляются одновременно, и кадр не читается.
      await new Promise((г) => setTimeout(г, 1000));
      окно.classList.add('ищет');
      const разбор = (async () => {
        try {
          // Снимок разрешает тяжёлую запаску и повороты -- один кадр это выдержит.
          return await прочитатьКадр({ источник: холст, точки, нужно: вид, снимок: true });
        } catch (е) { return null; }
      })();
      // Даём лучу пройти хотя бы один полный проход: разбор кадра занимает десятки
      // миллисекунд, и без этой выдержки человек увидит вспышку вместо сканирования.
      const [найдено] = await Promise.all([разбор, new Promise((г) => setTimeout(г, 1300))]);
      окно.classList.remove('ищет');
      намёк.hidden = true;
      if (найдено && найдено.текст) {
        показать(найдено.текст);
        переснять.hidden = false;      // второй код сканируют сразу за первым
        return;
      }
      // Не нашлось -- говорим об этом и предлагаем переснять. Камеру сами не возвращаем:
      // кадр остаётся на виду, и человеку видно, ЧТО именно не прочиталось.
      намёк.hidden = true;
      переснять.hidden = false;
      // Сначала выясняем, не чужой ли это код: «снимите ровнее» человеку бесполезно, если
      // он снял правильно, просто не тот вид.
      if (!(await чужойКод(холст, точки))) {
        намёк.hidden = false;
        намёк.textContent = с.notShot;
      }
    }

    function выключить() {
      if (поток) { поток.getTracks().forEach((д) => д.stop()); поток = null; }
      видео.srcObject = null;
      видео.hidden = true;
      прицел.hidden = true;
      затвор.hidden = true;
      намёк.hidden = true;
      окно.classList.remove('ищет');
      // Точку нажатия возвращаем только если в окне ничего не осталось: поверх снимка она
      // просвечивала бы и мешала смотреть на то, что прочитано.
      центр.hidden = !снимок.hidden;
      крест.hidden = снимок.hidden;
    }

    /** Убрать всё: камеру погасить, снимок и ответ убрать, окно вернуть в исходное. */
    function очистить() {
      if (поток) { поток.getTracks().forEach((д) => д.stop()); поток = null; }
      видео.srcObject = null;
      видео.hidden = true;
      if (снимок.src && снимок.src.startsWith('blob:')) URL.revokeObjectURL(снимок.src);
      снимок.removeAttribute('src');
      снимок.hidden = true;
      прицел.hidden = true;
      затвор.hidden = true;
      намёк.hidden = true;
      переснять.hidden = true;
      окно.classList.remove('ищет');
      крест.hidden = true;
      центр.hidden = false;
      ответ.innerHTML = '';
      беда('');
      поле.value = '';
    }

    // Нажатие по окну, когда камера работает, её выключает: отдельной кнопки для этого нет.
    // Звук заводим ИМЕННО В ЖЕСТЕ: контекст, созданный позже, остаётся спящим и играет
    // молча -- отчего сигнала и не было слышно.
    $('кс-пуск').addEventListener('click', (е) => { е.stopPropagation(); подготовитьЗвук(); включить(); });
    крест.addEventListener('click', (е) => { е.stopPropagation(); очистить(); });
    затвор.addEventListener('click', (е) => { е.stopPropagation(); подготовитьЗвук(); снятьКадр(); });
    переснять.addEventListener('click', (е) => {
      е.stopPropagation();
      ответ.innerHTML = '';
      переснять.hidden = true;
      включить();
    });
    window.addEventListener('pagehide', выключить);

    // ---- Снимок ------------------------------------------------------------------------------
    $('кс-загрузить').addEventListener('click', (е) => { е.stopPropagation(); подготовитьЗвук(); поле.click(); });
    поле.addEventListener('change', () => { if (поле.files && поле.files[0]) взятьФайл(поле.files[0]); });
    окно.addEventListener('dragover', (е) => е.preventDefault());
    окно.addEventListener('drop', (е) => {
      е.preventDefault();
      const ф = е.dataTransfer && е.dataTransfer.files && е.dataTransfer.files[0];
      if (ф && ф.type.startsWith('image/')) взятьФайл(ф);
    });

    function взятьФайл(файл) {
      выключить();
      беда('');
      ответ.innerHTML = '';
      // АДРЕС КАРТИНКИ НЕ ОСВОБОЖДАЕМ СРАЗУ. Раньше я звал revokeObjectURL прямо в обработчике
      // загрузки -- и снимок пропадал из окна: первый раз он уже нарисован, а при следующей
      // перерисовке (смена класса, прокрутка) браузеру нужен тот же адрес, а его уже нет.
      // Владелец так и сказал: «загрузил -- результат выдало, а датаматрикс пропал».
      // Освобождаем прежний адрес при выборе НОВОГО файла и по крестику.
      if (снимок.src && снимок.src.startsWith('blob:')) URL.revokeObjectURL(снимок.src);
      const адрес = URL.createObjectURL(файл);
      снимок.onload = async () => {
        // Луч идёт и по загруженному снимку: то же движение, что при съёмке камерой.
        // Секунда до него -- чтобы человек успел увидеть саму картинку.
        await new Promise((г) => setTimeout(г, 1000));
        окно.classList.add('ищет');
        let найдено = null;
        try { найдено = await прочитатьСнимок({ картинка: снимок, нужно: вид }); } catch (е) {}
        окно.classList.remove('ищет');
        убратьХод(!!(найдено && найдено.текст));
        if (найдено && найдено.текст) показать(найдено.текст);
        else if (!(await чужойКод(снимок))) беда(с.notFound);
      };
      снимок.onerror = () => { окно.classList.remove('ищет'); убратьХод(false); беда(с.notFound); };
      снимок.classList.remove('снят');
      снимок.src = адрес;
      снимок.hidden = false;
      центр.hidden = true;
      прицел.hidden = true;
      крест.hidden = false;
      пуститьХод();
    }

    // Умеет ли браузер читать этот вид -- говорим СРАЗУ, до разрешения на камеру.
    умеетВид(вид).then((умеет) => { родной = умеет; if (!умеет) беда(с.slowCam); });

    window.__ксСостояние = () => ({
      вид,
      камераИдёт: !!поток,
      затворВиден: !затвор.hidden,
      переснятьВиден: !переснять.hidden,
      звук: состояниеЗвука(),
      ответ: ответ.textContent.trim().slice(0, 200),
      беда: бедаЭ.textContent.trim().slice(0, 120),
      естьТекст: !!document.getElementById('кс-текст'),
      центрВиден: !центр.hidden,
      крестВиден: !крест.hidden,
    });
  })();
</script>
