---
// ЧИСЛО ПРОПИСЬЮ И ОБРАТНО.
//
// РАБОТАЕМ СО СТРОКОЙ ЦИФР, А НЕ С ЧИСЛОМ. Обычное число в браузере точно хранит целые
// примерно до девяти квадриллионов, а дальше начинает округлять: 9007199254740993
// превращается в 9007199254740992, и сумма в документе оказывается чужой. Строку же можно
// резать на тройки любой длины, поэтому здесь никаких Number для самой суммы.
//
// ГРАММАТИКА -- не украшение, а суть страницы:
//   -- «одна тысяча», но «один миллион»: тысяча женского рода, миллион мужского;
//   -- «двадцать один рубль», «двадцать одна гривна», «двадцать две копейки» -- числительное
//      согласуется с родом валюты;
//   -- «одиннадцать рублей», а не «одиннадцать рубля»: с одиннадцати по четырнадцать форма
//      всегда третья, и это отдельное правило, а не остаток от деления;
//   -- евро не склоняется вовсе: «два евро», а не «два евра»;
//   -- по-испански сто ровно -- «cien», сто один -- «ciento uno», а «un mil» не говорят.
//
// НАПРАВЛЕНИЕ УГАДЫВАЕМ, и здесь это честно: цифры и буквы не спутать. На Base64 мы от
// угадывания отказались, потому что слово «test» -- одновременно и слово, и правильный код;
// тут же двусмысленности нет вовсе.
//
// Ничего никуда не уходит: суммы считаются в браузере.
import css from '../styles/number-to-words.css?inline';

const { locale = 'ru' } = Astro.props;

const СЛОВА = {
  ru: {
    format: 'Формат', plain: 'Простой текст',
    rub: 'Российский рубль', uah: 'Украинская гривна', usd: 'Доллар США', eur: 'Евро',
    gender: 'Род', male: 'Мужской', female: 'Женский', neuter: 'Средний',
    accounting: 'Копейки цифрами',
    place: 'Введите число (например, 2500) или текст прописью…',
    result: 'Результат появится здесь…',
    len: 'Длина', mode: 'Режим', toWords: 'число → пропись', toNumber: 'пропись → число',
    errWord: 'Не понял слово «{w}». Проверьте написание — числительные должны идти словами.',
    errEmpty: 'Здесь нет ни числа, ни числительного.',
    errBig: 'Слишком большое число: словами считаем до квадриллионов.',
    copyBig: 'Копировать результат', copiedBig: 'Скопировано!', clearAll: 'Очистить всё',
    nothing: 'Поле пустое', copyFail: 'Браузер не дал скопировать — текст выделен, нажмите Ctrl+C',
    n1: '<b>Сумма считается по строке цифр, а не по числу.</b> Обычное число в браузере точно хранит целые примерно до девяти квадриллионов, а дальше округляет — и сумма в документе оказалась бы чужой. Здесь такого не случится ни при какой длине.',
    n2: '<b>Числительное согласуется с родом валюты.</b> «Двадцать один рубль», но «двадцать одна гривна»; «две копейки», но «два цента». Это не мелочь: именно на таких местах видно, что сумму писал не человек.',
    n3: '<b>Одиннадцать рублей, а не одиннадцать рубля.</b> С одиннадцати по четырнадцать форма слова всегда третья, хотя число и оканчивается на единицу. Правило отдельное, и без него ошибается почти каждый самодельный переводчик.',
    n4: '<b>Евро не склоняется.</b> «Два евро», а не «два евра» — это заимствование, которое в русском осталось неизменяемым. Гривна, рубль и доллар склоняются как обычные слова.',
    n5: '<b>Направление угадывается — и здесь это безопасно.</b> Цифры и буквы не спутать, поэтому страница сама понимает, что вы ввели. Там, где угадывание опасно, мы от него отказываемся: на странице Base64 кнопки направления стоят вручную.',
    n6: 'Всё считается в вашем браузере. Ни суммы, ни договорные строки никуда не отправляются и нигде не сохраняются.',
  },
  uk: {
    format: 'Формат', plain: 'Простий текст',
    rub: 'Російський рубль', uah: 'Українська гривня', usd: 'Долар США', eur: 'Євро',
    gender: 'Рід', male: 'Чоловічий', female: 'Жіночий', neuter: 'Середній',
    accounting: 'Копійки цифрами',
    place: 'Введіть число (наприклад, 2500) або текст прописом…',
    result: 'Результат з’явиться тут…',
    len: 'Довжина', mode: 'Режим', toWords: 'число → пропис', toNumber: 'пропис → число',
    errWord: 'Не зрозумів слово «{w}». Перевірте написання — числівники мають іти словами.',
    errEmpty: 'Тут немає ні числа, ні числівника.',
    errBig: 'Завелике число: словами рахуємо до квадрильйонів.',
    copyBig: 'Копіювати результат', copiedBig: 'Скопійовано!', clearAll: 'Очистити все',
    nothing: 'Поле порожнє', copyFail: 'Браузер не дав скопіювати — текст виділено, натисніть Ctrl+C',
    n1: '<b>Сума рахується за рядком цифр, а не за числом.</b> Звичайне число в браузері точно зберігає цілі приблизно до дев’яти квадрильйонів, а далі округлює — і сума в документі виявилася б чужою. Тут такого не станеться за жодної довжини.',
    n2: '<b>Числівник узгоджується з родом валюти.</b> «Двадцять один рубль», але «двадцять одна гривня»; «дві копійки», але «два центи». Це не дрібниця: саме на таких місцях видно, що суму писала не людина.',
    n3: '<b>Одинадцять гривень, а не одинадцять гривні.</b> З одинадцяти по чотирнадцять форма слова завжди третя, хоча число й закінчується на одиницю. Правило окреме, і без нього помиляється майже кожен саморобний перекладач.',
    n4: '<b>Євро не відмінюється.</b> «Два євро», а не «два євра» — це запозичення, яке лишилося незмінним. Гривня, рубль і долар відмінюються як звичайні слова.',
    n5: '<b>Напрямок вгадується — і тут це безпечно.</b> Цифри й літери не сплутати, тому сторінка сама розуміє, що ви ввели. Там, де вгадування небезпечне, ми від нього відмовляємось: на сторінці Base64 кнопки напрямку стоять вручну.',
    n6: 'Усе рахується у вашому браузері. Ні суми, ні договірні рядки нікуди не надсилаються і ніде не зберігаються.',
  },
  en: {
    format: 'Format', plain: 'Plain text',
    rub: 'Russian rouble', uah: 'Ukrainian hryvnia', usd: 'US dollar', eur: 'Euro',
    gender: 'Gender', male: 'Masculine', female: 'Feminine', neuter: 'Neuter',
    accounting: 'Cents as digits',
    place: 'Enter a number (2500, say) or a number written out in words…',
    result: 'The result will appear here…',
    len: 'Length', mode: 'Mode', toWords: 'number → words', toNumber: 'words → number',
    errWord: 'I do not know the word “{w}”. Check the spelling — numerals must be spelled out.',
    errEmpty: 'There is neither a number nor a numeral here.',
    errBig: 'Too large: we spell out up to quadrillions.',
    copyBig: 'Copy the result', copiedBig: 'Copied!', clearAll: 'Clear everything',
    nothing: 'The field is empty', copyFail: 'The browser refused to copy — the text is selected, press Ctrl+C',
    n1: '<b>The amount is built from a string of digits, not from a number.</b> An ordinary number in a browser holds integers exactly up to about nine quadrillion and rounds beyond that — and the sum in your document would come out wrong. That cannot happen here at any length.',
    n2: '<b>The numeral agrees with the gender of the currency.</b> In Russian it is “twenty-one rouble” but “twenty-one hryvnia” in the feminine, and the ending changes. It is not a detail: those are exactly the places where a machine-written sum gives itself away.',
    n3: '<b>Eleven roubles, not eleven rouble.</b> From eleven to fourteen the Slavic word form is always the third one even though the number ends in a one. It is a separate rule, and almost every home-made converter gets it wrong.',
    n4: '<b>The euro does not decline.</b> In Russian and Ukrainian it stays “евро” in every form, while rouble, hryvnia and dollar behave like ordinary nouns.',
    n5: '<b>The direction is detected — and here that is safe.</b> Digits and letters cannot be confused, so the page works out what you typed. Where detection is dangerous we refuse it: on the Base64 page the direction buttons are set by hand.',
    n6: 'Everything is computed in your browser. Neither amounts nor contract wording is sent anywhere or stored.',
  },
  es: {
    format: 'Formato', plain: 'Texto simple',
    rub: 'Rublo ruso', uah: 'Grivna ucraniana', usd: 'Dólar estadounidense', eur: 'Euro',
    gender: 'Género', male: 'Masculino', female: 'Femenino', neuter: 'Neutro',
    accounting: 'Céntimos en cifras',
    place: 'Escribe un número (2500, por ejemplo) o una cantidad en letras…',
    result: 'El resultado aparecerá aquí…',
    len: 'Longitud', mode: 'Modo', toWords: 'número → letras', toNumber: 'letras → número',
    errWord: 'No conozco la palabra «{w}». Revisa la escritura: los numerales deben ir en letra.',
    errEmpty: 'Aquí no hay ni un número ni un numeral.',
    errBig: 'Demasiado grande: escribimos en letras hasta los cuatrillones.',
    copyBig: 'Copiar el resultado', copiedBig: '¡Copiado!', clearAll: 'Limpiar todo',
    nothing: 'El campo está vacío', copyFail: 'El navegador no dejó copiar: el texto está seleccionado, pulsa Ctrl+C',
    n1: '<b>La cantidad se construye con una cadena de cifras, no con un número.</b> Un número corriente en el navegador guarda enteros exactos hasta unos nueve cuatrillones y a partir de ahí redondea: la suma del documento saldría equivocada. Aquí eso no pasa con ninguna longitud.',
    n2: '<b>El numeral concuerda con el género de la moneda.</b> «Veintiún euros» pero «veintiuna grivnas»; «un céntimo» pero «una grivna». No es un detalle: son justo los puntos donde se nota que la cantidad la escribió una máquina.',
    n3: '<b>Cien a secas, ciento uno con algo detrás.</b> El español cambia la palabra según lo que venga después, y «un mil» no se dice nunca: se dice «mil». Son reglas aparte que casi ningún conversor casero respeta.',
    n4: '<b>Los cientos no se forman sumando.</b> Quinientos, setecientos y novecientos son palabras propias, no «cinco cientos». Y en femenino cambian: «doscientas grivnas».',
    n5: '<b>La dirección se detecta, y aquí eso es seguro.</b> Cifras y letras no se confunden, así que la página sabe qué has escrito. Donde detectar es peligroso lo evitamos: en la página de Base64 los botones de dirección se ponen a mano.',
    n6: 'Todo se calcula en tu navegador. Ni las cantidades ni el texto de los contratos se envían a ninguna parte ni se guardan.',
  },
};
const с = СЛОВА[locale] || СЛОВА.ru;
---

<style is:inline set:html={css}></style>

<div class="чп" data-words={JSON.stringify(с)} data-locale={locale}>
  <div class="чп-верх">
    <span class="чп-подпись">{с.format}:</span>
    <select class="чп-список" id="чп-формат">
      <option value="">{с.plain}</option>
      <option value="RUB">{с.rub} (RUB)</option>
      <option value="UAH">{с.uah} (UAH)</option>
      <option value="USD">{с.usd} (USD)</option>
      <option value="EUR">{с.eur} (EUR)</option>
    </select>
    <span class="чп-слот">
    <span class="чп-если" id="чп-род-обёртка">
      <span class="чп-подпись">{с.gender}:</span>
      <div class="чп-кнопки" role="group">
        <button type="button" class="чп-выбор выбран" id="чп-м">{с.male}</button>
        <button type="button" class="чп-выбор" id="чп-ж">{с.female}</button>
        <button type="button" class="чп-выбор" id="чп-с">{с.neuter}</button>
      </div>
    </span>
    <span class="чп-если скрыт" id="чп-бух-обёртка">
      <label class="чп-галка"><input type="checkbox" id="чп-бух"><i></i>{с.accounting}</label>
    </span>
    </span>
  </div>

  <div class="чп-пара-полей">
    <div class="чп-поле">
      <textarea class="чп-ввод" id="чп-ввод" placeholder={с.place} spellcheck="false"></textarea>
    </div>
    <div class="чп-поле чп-вывод" id="чп-обёртка">
      <textarea class="чп-ввод" id="чп-вывод" placeholder={с.result} readonly></textarea>
    </div>
    <div class="чп-счётчики">
      <span>{с.mode}: <b id="чп-режим">{с.toWords}</b></span>
      <span>{с.len}: <b id="чп-длина">0</b></span>
      <span class="чп-сказ" id="чп-сказ"></span>
    </div>
  </div>

  <div class="чп-низ">
    <button type="button" class="чп-кнопка" id="чп-копировать">{с.copyBig}</button>
    <button type="button" class="чп-простая" id="чп-очистить">{с.clearAll}</button>
  </div>

  <div class="чп-заметки">
    <div class="чп-заметка" set:html={с.n1}></div>
    <div class="чп-заметка" set:html={с.n2}></div>
    <div class="чп-заметка" set:html={с.n3}></div>
    <div class="чп-заметка" set:html={с.n4}></div>
    <div class="чп-заметка" set:html={с.n5}></div>
    <div class="чп-заметка">{с.n6}</div>
  </div>
</div>

<script>
  const корень = document.querySelector('.чп');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const язык = корень.dataset.locale || 'ru';
    const $ = (и) => document.getElementById(и);
    const ввод = $('чп-ввод');
    const вывод = $('чп-вывод');
    const обёртка = $('чп-обёртка');
    let род = 'м';

    /* ЧИСЛО ПРОПИСЬЮ. Работаем СО СТРОКОЙ ЦИФР, а не с числом: выше девяти квадриллионов
       обычное число в браузере начинает округлять, и «одна тысяча» превратилась бы в чужую
       сумму. Строку же можно разрезать на тройки любой длины. */

    const СЛАВЯНСКИЕ = {
      ru: {
        единицы: {
          м: ['', 'один', 'два', 'три', 'четыре', 'пять', 'шесть', 'семь', 'восемь', 'девять'],
          ж: ['', 'одна', 'две', 'три', 'четыре', 'пять', 'шесть', 'семь', 'восемь', 'девять'],
          с: ['', 'одно', 'два', 'три', 'четыре', 'пять', 'шесть', 'семь', 'восемь', 'девять'],
        },
        подростки: ['десять', 'одиннадцать', 'двенадцать', 'тринадцать', 'четырнадцать',
          'пятнадцать', 'шестнадцать', 'семнадцать', 'восемнадцать', 'девятнадцать'],
        десятки: ['', '', 'двадцать', 'тридцать', 'сорок', 'пятьдесят', 'шестьдесят',
          'семьдесят', 'восемьдесят', 'девяносто'],
        сотни: ['', 'сто', 'двести', 'триста', 'четыреста', 'пятьсот', 'шестьсот', 'семьсот',
          'восемьсот', 'девятьсот'],
        ноль: 'ноль',
        разряды: [
          null,
          { род: 'ж', формы: ['тысяча', 'тысячи', 'тысяч'] },
          { род: 'м', формы: ['миллион', 'миллиона', 'миллионов'] },
          { род: 'м', формы: ['миллиард', 'миллиарда', 'миллиардов'] },
          { род: 'м', формы: ['триллион', 'триллиона', 'триллионов'] },
          { род: 'м', формы: ['квадриллион', 'квадриллиона', 'квадриллионов'] },
        ],
        целых: ['целая', 'целых', 'целых'],
        дроби: {
          1: ['десятая', 'десятых', 'десятых'],
          2: ['сотая', 'сотых', 'сотых'],
          3: ['тысячная', 'тысячных', 'тысячных'],
        },
      },
      uk: {
        единицы: {
          м: ['', 'один', 'два', 'три', 'чотири', "п'ять", 'шість', 'сім', 'вісім', "дев'ять"],
          ж: ['', 'одна', 'дві', 'три', 'чотири', "п'ять", 'шість', 'сім', 'вісім', "дев'ять"],
          с: ['', 'одне', 'два', 'три', 'чотири', "п'ять", 'шість', 'сім', 'вісім', "дев'ять"],
        },
        подростки: ['десять', 'одинадцять', 'дванадцять', 'тринадцять', 'чотирнадцять',
          "п'ятнадцять", 'шістнадцять', 'сімнадцять', 'вісімнадцять', "дев'ятнадцять"],
        десятки: ['', '', 'двадцять', 'тридцять', 'сорок', "п'ятдесят", 'шістдесят',
          'сімдесят', 'вісімдесят', "дев'яносто"],
        сотни: ['', 'сто', 'двісті', 'триста', 'чотириста', "п'ятсот", 'шістсот', 'сімсот',
          'вісімсот', "дев'ятсот"],
        ноль: 'нуль',
        разряды: [
          null,
          { род: 'ж', формы: ['тисяча', 'тисячі', 'тисяч'] },
          { род: 'м', формы: ['мільйон', 'мільйони', 'мільйонів'] },
          { род: 'м', формы: ['мільярд', 'мільярди', 'мільярдів'] },
          { род: 'м', формы: ['трильйон', 'трильйони', 'трильйонів'] },
          { род: 'м', формы: ['квадрильйон', 'квадрильйони', 'квадрильйонів'] },
        ],
        целых: ['ціла', 'цілих', 'цілих'],
        дроби: {
          1: ['десята', 'десятих', 'десятих'],
          2: ['сота', 'сотих', 'сотих'],
          3: ['тисячна', 'тисячних', 'тисячних'],
        },
      },
    };

    // Форма слова при числе: 1 -- первая, 2-4 -- вторая, 5 и дальше -- третья.
    // С одиннадцати по четырнадцать всегда третья, иначе вышло бы «одиннадцать рубля».
    function славянскаяФорма(число, формы) {
      const сотня = Math.abs(число) % 100;
      const десяток = сотня % 10;
      if (сотня >= 11 && сотня <= 14) return формы[2];
      if (десяток === 1) return формы[0];
      if (десяток >= 2 && десяток <= 4) return формы[1];
      return формы[2];
    }

    function славянскаяТройка(тройка, род, язык) {
      const с = СЛАВЯНСКИЕ[язык];
      const слова = [];
      const сотен = Math.floor(тройка / 100);
      const остаток = тройка % 100;
      if (сотен) слова.push(с.сотни[сотен]);
      if (остаток >= 10 && остаток < 20) {
        слова.push(с.подростки[остаток - 10]);
      } else {
        const десятков = Math.floor(остаток / 10);
        const единиц = остаток % 10;
        if (десятков) слова.push(с.десятки[десятков]);
        if (единиц) слова.push(с.единицы[род][единиц]);
      }
      return слова;
    }

    /** Целое число прописью. цифры -- строка без знака. род -- род последнего разряда. */
    function славянскоеЦелое(цифры, род, язык) {
      const с = СЛАВЯНСКИЕ[язык];
      const чистые = цифры.replace(/^0+(?=\d)/, '');
      if (чистые === '0') return [с.ноль];

      const тройки = [];
      for (let к = чистые.length; к > 0; к -= 3) тройки.unshift(чистые.slice(Math.max(0, к - 3), к));

      const слова = [];
      тройки.forEach((кусок, и) => {
        const значение = parseInt(кусок, 10);
        if (!значение) return;
        const разряд = тройки.length - 1 - и;          // 0 -- единицы, 1 -- тысячи, дальше больше
        const описание = с.разряды[разряд];
        // Тысячи женского рода: «две тысячи», а не «два тысячи». Род единиц берётся от разряда.
        const родТройки = разряд === 0 ? род : (описание ? описание.род : 'м');
        слова.push(...славянскаяТройка(значение, родТройки, язык));
        if (описание) слова.push(славянскаяФорма(значение, описание.формы));
      });
      return слова;
    }

    /* ---- Английский и испанский --------------------------------------------------------------- */

    const EN_ЕД = ['', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
    const EN_ПОДР = ['ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen',
      'seventeen', 'eighteen', 'nineteen'];
    const EN_ДЕС = ['', '', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'];
    const EN_РАЗРЯДЫ = ['', 'thousand', 'million', 'billion', 'trillion', 'quadrillion'];

    function английскаяТройка(тройка) {
      const слова = [];
      const сотен = Math.floor(тройка / 100);
      const остаток = тройка % 100;
      if (сотен) слова.push(EN_ЕД[сотен], 'hundred');
      if (остаток >= 10 && остаток < 20) слова.push(EN_ПОДР[остаток - 10]);
      else {
        const д = Math.floor(остаток / 10), е = остаток % 10;
        // Английский пишет двузначные через дефис: forty-five, а не forty five.
        if (д && е) слова.push(`${EN_ДЕС[д]}-${EN_ЕД[е]}`);
        else if (д) слова.push(EN_ДЕС[д]);
        else if (е) слова.push(EN_ЕД[е]);
      }
      return слова;
    }

    function английскоеЦелое(цифры) {
      const чистые = цифры.replace(/^0+(?=\d)/, '');
      if (чистые === '0') return ['zero'];
      const тройки = [];
      for (let к = чистые.length; к > 0; к -= 3) тройки.unshift(чистые.slice(Math.max(0, к - 3), к));
      const слова = [];
      тройки.forEach((кусок, и) => {
        const значение = parseInt(кусок, 10);
        if (!значение) return;
        const разряд = тройки.length - 1 - и;
        слова.push(...английскаяТройка(значение));
        if (разряд) слова.push(EN_РАЗРЯДЫ[разряд]);
      });
      return слова;
    }

    const ES_ЕД = ['', 'uno', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve'];
    const ES_ПОДР = ['diez', 'once', 'doce', 'trece', 'catorce', 'quince', 'dieciséis',
      'diecisiete', 'dieciocho', 'diecinueve'];
    const ES_ДВАДЦАТЬ = ['veinte', 'veintiuno', 'veintidós', 'veintitrés', 'veinticuatro',
      'veinticinco', 'veintiséis', 'veintisiete', 'veintiocho', 'veintinueve'];
    const ES_ДЕС = ['', '', 'veinte', 'treinta', 'cuarenta', 'cincuenta', 'sesenta', 'setenta',
      'ochenta', 'noventa'];
    // Сотни в испанском не складываются из «пять» и «сто»: пятьсот, семьсот и девятьсот -- свои слова.
    const ES_СОТНИ = ['', 'ciento', 'doscientos', 'trescientos', 'cuatrocientos', 'quinientos',
      'seiscientos', 'setecientos', 'ochocientos', 'novecientos'];

    /** Испанская тройка. род нужен для «una», «doscientas»; конец -- стоит ли слово перед
     *  существительным (тогда «un» вместо «uno»). */
    function испанскаяТройка(тройка, род, передСловом) {
      const слова = [];
      const сотен = Math.floor(тройка / 100);
      const остаток = тройка % 100;
      if (сотен === 1 && остаток === 0) слова.push('cien');       // ровно сто -- «cien», не «ciento»
      else if (сотен) {
        let сотня = ES_СОТНИ[сотен];
        if (род === 'ж' && сотен > 1) сотня = сотня.replace(/os$/, 'as');
        слова.push(сотня);
      }
      const единица = (значение) => {
        if (значение !== 1) return ES_ЕД[значение];
        if (род === 'ж') return 'una';
        return передСловом ? 'un' : 'uno';
      };
      if (остаток >= 10 && остаток < 20) слова.push(ES_ПОДР[остаток - 10]);
      else if (остаток >= 20 && остаток < 30) {
        if (остаток === 21) слова.push(род === 'ж' ? 'veintiuna' : (передСловом ? 'veintiún' : 'veintiuno'));
        else слова.push(ES_ДВАДЦАТЬ[остаток - 20]);
      } else {
        const д = Math.floor(остаток / 10), е = остаток % 10;
        if (д && е) слова.push(ES_ДЕС[д], 'y', единица(е));
        else if (д) слова.push(ES_ДЕС[д]);
        else if (е) слова.push(единица(е));
      }
      return слова;
    }

    function испанскоеЦелое(цифры, род, передСловом) {
      const чистые = цифры.replace(/^0+(?=\d)/, '');
      if (чистые === '0') return ['cero'];
      const тройки = [];
      for (let к = чистые.length; к > 0; к -= 3) тройки.unshift(чистые.slice(Math.max(0, к - 3), к));
      const слова = [];
      const РАЗРЯДЫ = ['', 'mil', 'millón', 'billón', 'trillón', 'cuatrillón'];
      тройки.forEach((кусок, и) => {
        const значение = parseInt(кусок, 10);
        if (!значение) return;
        const разряд = тройки.length - 1 - и;
        if (разряд === 1) {
          // «Тысяча» по-испански без «una»: mil, dos mil. «Un mil» не говорят.
          if (значение !== 1) слова.push(...испанскаяТройка(значение, 'ж', true));
          слова.push('mil');
        } else if (разряд >= 2) {
          слова.push(...испанскаяТройка(значение, 'м', true));
          // Миллион склоняется как существительное: un millón, dos millones.
          слова.push(значение === 1 ? РАЗРЯДЫ[разряд] : РАЗРЯДЫ[разряд].replace(/ón$/, 'ones'));
        } else {
          слова.push(...испанскаяТройка(значение, род, передСловом));
        }
      });
      return слова;
    }

    /* ---- Валюты ---------------------------------------------------------------------------------
       Для каждой валюты нужны РОД (от него зависит «один рубль» и «одна гривна») и три формы,
       потому что «два рубля» и «пять рублей» -- разные слова. У евро форм нет вовсе: оно не
       склоняется, и «два евро» -- единственно верно. */

    const ВАЛЮТЫ = {
      ru: {
        RUB: { целое: { род: 'м', формы: ['рубль', 'рубля', 'рублей'] },
               дробь: { род: 'ж', формы: ['копейка', 'копейки', 'копеек'] }, сокр: 'коп.' },
        UAH: { целое: { род: 'ж', формы: ['гривна', 'гривны', 'гривен'] },
               дробь: { род: 'ж', формы: ['копейка', 'копейки', 'копеек'] }, сокр: 'коп.' },
        USD: { целое: { род: 'м', формы: ['доллар', 'доллара', 'долларов'] },
               дробь: { род: 'м', формы: ['цент', 'цента', 'центов'] }, сокр: 'ц.' },
        EUR: { целое: { род: 'м', формы: ['евро', 'евро', 'евро'] },
               дробь: { род: 'м', формы: ['цент', 'цента', 'центов'] }, сокр: 'ц.' },
      },
      uk: {
        RUB: { целое: { род: 'м', формы: ['рубль', 'рублі', 'рублів'] },
               дробь: { род: 'ж', формы: ['копійка', 'копійки', 'копійок'] }, сокр: 'коп.' },
        UAH: { целое: { род: 'ж', формы: ['гривня', 'гривні', 'гривень'] },
               дробь: { род: 'ж', формы: ['копійка', 'копійки', 'копійок'] }, сокр: 'коп.' },
        USD: { целое: { род: 'м', формы: ['долар', 'долари', 'доларів'] },
               дробь: { род: 'м', формы: ['цент', 'центи', 'центів'] }, сокр: 'ц.' },
        EUR: { целое: { род: 'м', формы: ['євро', 'євро', 'євро'] },
               дробь: { род: 'м', формы: ['цент', 'центи', 'центів'] }, сокр: 'ц.' },
      },
      en: {
        RUB: { целое: ['rouble', 'roubles'], дробь: ['kopeck', 'kopecks'], сокр: 'kop.' },
        UAH: { целое: ['hryvnia', 'hryvnias'], дробь: ['kopiyka', 'kopiykas'], сокр: 'kop.' },
        USD: { целое: ['dollar', 'dollars'], дробь: ['cent', 'cents'], сокр: 'cents' },
        EUR: { целое: ['euro', 'euros'], дробь: ['cent', 'cents'], сокр: 'cents' },
      },
      es: {
        RUB: { целое: { род: 'м', формы: ['rublo', 'rublos'] },
               дробь: { род: 'м', формы: ['kopek', 'kopeks'] }, сокр: 'kop.' },
        UAH: { целое: { род: 'ж', формы: ['grivna', 'grivnas'] },
               дробь: { род: 'м', формы: ['kopek', 'kopeks'] }, сокр: 'kop.' },
        USD: { целое: { род: 'м', формы: ['dólar', 'dólares'] },
               дробь: { род: 'м', формы: ['centavo', 'centavos'] }, сокр: 'ctvs.' },
        EUR: { целое: { род: 'м', формы: ['euro', 'euros'] },
               дробь: { род: 'м', формы: ['céntimo', 'céntimos'] }, сокр: 'cts.' },
      },
    };

    const с_большой = (строка) => строка.charAt(0).toUpperCase() + строка.slice(1);

    /** Целое прописью на нужном языке, согласованное с родом и с тем, идёт ли дальше слово. */
    function целоеНаЯзыке(цифры, язык, род, передСловом) {
      if (язык === 'en') return английскоеЦелое(цифры);
      if (язык === 'es') return испанскоеЦелое(цифры, род, передСловом);
      return славянскоеЦелое(цифры, род, язык);
    }

    /** Последняя тройка числа -- по ней выбирается форма слова при числе. */
    const хвост = (цифры) => parseInt(цифры.slice(-9) || '0', 10) % 1000000;

    /**
     * Сумма прописью.
     *   цифры    -- целая часть строкой, дробь -- две цифры строкой (или '')
     *   валюта   -- ключ из ВАЛЮТЫ или null для простого текста
     *   род      -- род числительного в простом тексте
     *   бухгалтерский -- дробную часть писать цифрами
     */
    function прописью({ цифры, дробь = '', язык, валюта = null, род = 'м',
                               бухгалтерский = false, минус = false }) {
      const слова = [];
      if (минус) слова.push({ ru: 'минус', uk: 'мінус', en: 'minus', es: 'menos' }[язык]);

      if (!валюта) {
        // Простой текст. Дробь читается как «целых» и «сотых» в славянских языках и цифра
        // за цифрой -- в английском и испанском: так в этих языках и говорят.
        if (!дробь) {
          слова.push(...целоеНаЯзыке(цифры, язык, род, false));
          return с_большой(слова.join(' ').trim());
        }
        if (язык === 'en' || язык === 'es') {
          слова.push(...целоеНаЯзыке(цифры, язык, род, false));
          слова.push(язык === 'en' ? 'point' : 'coma');
          const цифра = язык === 'en'
            ? ['zero', ...EN_ЕД.slice(1)] : ['cero', ...ES_ЕД.slice(1)];
          for (const з of дробь) слова.push(цифра[Number(з)]);
          return с_большой(слова.join(' ').trim());
        }
        const с = СЛАВЯНСКИЕ[язык];
        слова.push(...целоеНаЯзыке(цифры, язык, 'ж', false));
        слова.push(славянскаяФорма(хвост(цифры), с.целых));
        слова.push(...целоеНаЯзыке(дробь, язык, 'ж', false));
        слова.push(славянскаяФорма(parseInt(дробь, 10), с.дроби[дробь.length] || с.дроби[2]));
        return с_большой(слова.join(' ').trim());
      }

      const в = ВАЛЮТЫ[язык][валюта];
      const дробныеЦифры = (дробь || '00').padEnd(2, '0').slice(0, 2);

      if (язык === 'en') {
        слова.push(...английскоеЦелое(цифры));
        слова.push(хвост(цифры) === 1 ? в.целое[0] : в.целое[1]);
        if (бухгалтерский) {
          слова.push(дробныеЦифры, в.сокр);
        } else {
          слова.push(...английскоеЦелое(дробныеЦифры));
          слова.push(parseInt(дробныеЦифры, 10) === 1 ? в.дробь[0] : в.дробь[1]);
        }
        return с_большой(слова.join(' ').trim());
      }

      const целоеОпис = в.целое;
      const дробьОпис = в.дробь;
      const формаЦелого = язык === 'es'
        ? (хвост(цифры) === 1 ? целоеОпис.формы[0] : целоеОпис.формы[1])
        : славянскаяФорма(хвост(цифры), целоеОпис.формы);

      слова.push(...целоеНаЯзыке(цифры, язык, целоеОпис.род, true));
      слова.push(формаЦелого);

      if (бухгалтерский) {
        слова.push(дробныеЦифры, в.сокр);
      } else {
        const дробноеЧисло = parseInt(дробныеЦифры, 10);
        слова.push(...целоеНаЯзыке(дробныеЦифры, язык, дробьОпис.род, true));
        слова.push(язык === 'es'
          ? (дробноеЧисло === 1 ? дробьОпис.формы[0] : дробьОпис.формы[1])
          : славянскаяФорма(дробноеЧисло, дробьОпис.формы));
      }
      return с_большой(слова.join(' ').trim());
    }

    /* ---- Обратный разбор: из слов в число ------------------------------------------------------
       Собираем словарь из ТЕХ ЖЕ таблиц, по которым пишем прописью: если где-то ошибка, она
       вылезет сразу в обе стороны, а не спрячется в отдельном списке. */

    const ровно = (слово) => слово.replace(/[’ʼ`´]/g, "'");

    function словарьЯзыка(язык) {
      const малые = new Map();     // слово -> значение до 999
      const множители = new Map(); // слово -> 1000, 1000000, ...
      const валютаЦелая = new Set();
      const валютаДробная = new Set();
      const дробные = new Map();   // «десятых» -> 10, «сотых» -> 100

      // Апостроф в украинском пишут четырьмя разными знаками. Приводим к одному и в
      // словаре, и во входной строке -- иначе прямой и кудрявый не совпадут.
      const добавить = (карта, слово, значение) => {
        if (слово) карта.set(ровно(слово), значение);
      };

      if (язык === 'ru' || язык === 'uk') {
        const с = СЛАВЯНСКИЕ[язык];
        for (const род of ['м', 'ж', 'с']) {
          с.единицы[род].forEach((слово, и) => добавить(малые, слово, и));
        }
        с.подростки.forEach((слово, и) => добавить(малые, слово, 10 + и));
        с.десятки.forEach((слово, и) => добавить(малые, слово, 10 * и));
        с.сотни.forEach((слово, и) => добавить(малые, слово, 100 * и));
        добавить(малые, с.ноль, 0);
        с.разряды.forEach((разряд, и) => {
          if (!разряд) return;
          for (const форма of разряд.формы) добавить(множители, форма, Math.pow(1000, и));
        });
        for (const форма of с.целых) добавить(дробные, форма, 1);   // «целых» -- метка дроби
        for (const [знаков, формы] of Object.entries(с.дроби)) {
          for (const форма of формы) добавить(дробные, форма, Math.pow(10, Number(знаков)));
        }
      } else if (язык === 'en') {
        EN_ЕД.forEach((слово, и) => добавить(малые, слово, и));
        добавить(малые, 'zero', 0);
        EN_ПОДР.forEach((слово, и) => добавить(малые, слово, 10 + и));
        EN_ДЕС.forEach((слово, и) => добавить(малые, слово, 10 * и));
        EN_РАЗРЯДЫ.forEach((слово, и) => { if (и) добавить(множители, слово, Math.pow(1000, и)); });
      } else {
        ES_ЕД.forEach((слово, и) => добавить(малые, слово, и));
        добавить(малые, 'cero', 0);
        добавить(малые, 'un', 1); добавить(малые, 'una', 1);
        ES_ПОДР.forEach((слово, и) => добавить(малые, слово, 10 + и));
        ES_ДВАДЦАТЬ.forEach((слово, и) => добавить(малые, слово, 20 + и));
        добавить(малые, 'veintiún', 21); добавить(малые, 'veintiuna', 21);
        ES_ДЕС.forEach((слово, и) => добавить(малые, слово, 10 * и));
        ES_СОТНИ.forEach((слово, и) => { добавить(малые, слово, 100 * и);
          добавить(малые, слово.replace(/os$/, 'as'), 100 * и); });
        добавить(малые, 'cien', 100);
        добавить(множители, 'mil', 1000);
        for (const [слово, значение] of [['millón', 1e6], ['millones', 1e6], ['billón', 1e9],
          ['billones', 1e9], ['trillón', 1e12], ['trillones', 1e12]]) добавить(множители, слово, значение);
      }

      for (const валюта of Object.values(ВАЛЮТЫ[язык])) {
        const целые = Array.isArray(валюта.целое) ? валюта.целое : валюта.целое.формы;
        const дробные2 = Array.isArray(валюта.дробь) ? валюта.дробь : валюта.дробь.формы;
        for (const слово of целые) валютаЦелая.add(ровно(слово));
        for (const слово of дробные2) валютаДробная.add(ровно(слово));
        валютаДробная.add(ровно(валюта.сокр.replace(/\.$/, '')));
      }
      return { малые, множители, валютаЦелая, валютаДробная, дробные };
    }

    /** Из слов в число. Возвращает строку вида «1450.50» либо бросает {слово} на непонятном. */
    function изСлов(текст, язык) {
      const с = словарьЯзыка(язык);
      const слова = ровно(текст.toLowerCase())
        .replace(/[,;]/g, ' ')
        .split(/[\s-]+/)              // английское «forty-five» режем по дефису
        .filter((к) => к !== '' && к !== 'y' && к !== 'and' && к !== 'і' && к !== 'и' && к !== 'та');

      let минус = false;
      let целое = 0, текущее = 0;
      let дробьЧисло = 0, дробьТекущее = 0, дробьДелитель = 0;
      let вДроби = false;
      let былоЧисло = false;
      let послеТочки = '';     // для английского «point» и испанского «coma»

      const МИНУСЫ = { ru: 'минус', uk: 'мінус', en: 'minus', es: 'menos' };
      const ТОЧКИ = { en: 'point', es: 'coma' };

      for (const слово of слова) {
        if (слово === МИНУСЫ[язык]) { минус = true; continue; }
        if (ТОЧКИ[язык] && слово === ТОЧКИ[язык]) { вДроби = true; послеТочки = ''; continue; }

        if (/^\d+$/.test(слово)) {          // цифры в бухгалтерской записи: «100 рублей 00 коп.»
          if (вДроби) { дробьТекущее = Number(слово); дробьДелитель = Math.pow(10, слово.length); }
          else текущее += Number(слово);
          былоЧисло = true;
          continue;
        }

        if (с.валютаЦелая.has(слово)) {
          целое += текущее; текущее = 0; вДроби = true; дробьДелитель = 100;
          continue;
        }
        if (с.валютаДробная.has(слово)) { дробьЧисло += дробьТекущее; дробьТекущее = 0; continue; }

        if (с.дробные.has(слово)) {
          const значение = с.дробные.get(слово);
          if (значение === 1) {           // «целых» -- дальше пойдёт дробная часть
            целое += текущее; текущее = 0; вДроби = true;
          } else {                        // «сотых», «десятых» -- знаменатель дроби
            дробьЧисло += дробьТекущее; дробьТекущее = 0; дробьДелитель = значение;
          }
          continue;
        }

        if (с.малые.has(слово)) {
          const значение = с.малые.get(слово);
          if (вДроби && ТОЧКИ[язык] && послеТочки !== null && дробьДелитель === 0) {
            послеТочки += String(значение);   // после «point» цифры читаются по одной
          } else if (вДроби) дробьТекущее += значение;
          else текущее += значение;
          былоЧисло = true;
          continue;
        }

        if (слово === 'hundred') {          // в английском сотня -- множитель, а не слагаемое
          if (вДроби) дробьТекущее = (дробьТекущее || 1) * 100;
          else текущее = (текущее || 1) * 100;
          былоЧисло = true;
          continue;
        }

        if (с.множители.has(слово)) {
          const множитель = с.множители.get(слово);
          if (вДроби) { дробьЧисло += (дробьТекущее || 1) * множитель; дробьТекущее = 0; }
          else { целое += (текущее || 1) * множитель; текущее = 0; }
          былоЧисло = true;
          continue;
        }

        throw { слово };
      }

      if (!былоЧисло) throw { слово: null };
      целое += текущее;
      дробьЧисло += дробьТекущее;

      let дробь = '';
      if (послеТочки) дробь = послеТочки;
      else if (дробьЧисло) {
        const знаков = дробьДелитель ? String(дробьДелитель).length - 1 : 2;
        дробь = String(дробьЧисло).padStart(знаков, '0');
      } else if (вДроби && дробьДелитель === 100) дробь = '00';

      return (минус ? '-' : '') + String(целое) + (дробь ? '.' + дробь : '');
    }

    /* ---- Работа ---------------------------------------------------------------------------- */

    const ПРЕДЕЛ = 18;   // до квадриллионов: дальше слов для разрядов у нас просто нет

    function перевести() {
      const исходный = ввод.value.trim();
      const валюта = $('чп-формат').value || null;
      обёртка.classList.remove('беда');
      $('чп-длина').textContent = String([...ввод.value].length);

      if (!исходный) {
        вывод.value = '';
        $('чп-режим').textContent = с.toWords;
        return;
      }

      // Направление: есть цифры -- значит, число; иначе разбираем слова. Цифры и буквы
      // не спутать, поэтому угадывание тут безопасно.
      const этоЧисло = /\d/.test(исходный);
      $('чп-режим').textContent = этоЧисло ? с.toWords : с.toNumber;

      if (этоЧисло) {
        const минус = /^\s*[-−]/.test(исходный);
        // Пробелы и неразрывные пробелы внутри числа -- обычное дело: «1 450,50».
        const чистое = исходный.replace(/[\s\u00A0\u202F]/g, '');
        const части = чистое.replace(/^[-−+]/, '').split(/[.,]/);
        const цифры = (части[0] || '').replace(/\D/g, '');
        const дробь = (части[1] || '').replace(/\D/g, '');
        if (!цифры && !дробь) { беда(с.errEmpty); return; }
        if (цифры.replace(/^0+(?=\d)/, '').length > ПРЕДЕЛ) { беда(с.errBig); return; }
        вывод.value = прописью({
          цифры: цифры || '0',
          дробь: валюта ? (дробь || '00') : дробь,
          язык, валюта, род,
          бухгалтерский: $('чп-бух').checked,
          минус,
        });
        return;
      }

      try {
        вывод.value = изСлов(исходный, язык);
      } catch (е) {
        беда(е.слово ? с.errWord.replace('{w}', е.слово) : с.errEmpty);
      }
    }

    function беда(текст) {
      обёртка.classList.add('беда');
      вывод.value = текст;
    }

    function поставитьРод(имя, кнопка) {
      род = имя;
      for (const и of ['чп-м', 'чп-ж', 'чп-с']) $(и).classList.toggle('выбран', и === кнопка);
      перевести();
    }

    function обновитьНастройки() {
      const валюта = Boolean($('чп-формат').value);
      // Род нужен простому тексту, бухгалтерская запись -- валюте. Ненужное прячется, но
      // место остаётся занятым: иначе строка настроек прыгала бы при смене формата.
      $('чп-род-обёртка').classList.toggle('скрыт', валюта);
      $('чп-бух-обёртка').classList.toggle('скрыт', !валюта);
      перевести();
    }

    function сказать(текст) {
      const э = $('чп-сказ');
      э.textContent = текст;
      э.classList.add('видно');
      clearTimeout(э._т);
      э._т = setTimeout(() => э.classList.remove('видно'), 1800);
    }

    ввод.addEventListener('input', перевести);
    $('чп-формат').addEventListener('change', обновитьНастройки);
    $('чп-бух').addEventListener('change', перевести);
    $('чп-м').addEventListener('click', () => поставитьРод('м', 'чп-м'));
    $('чп-ж').addEventListener('click', () => поставитьРод('ж', 'чп-ж'));
    $('чп-с').addEventListener('click', () => поставитьРод('с', 'чп-с'));

    $('чп-копировать').addEventListener('click', async () => {
      const кнопка = $('чп-копировать');
      if (!вывод.value || обёртка.classList.contains('беда')) { сказать(с.nothing); return; }
      let вышло = false;
      try { await navigator.clipboard.writeText(вывод.value); вышло = true; }
      catch (ошибка) {
        вывод.select();
        try { вышло = document.execCommand('copy'); } catch (е) { вышло = false; }
      }
      if (!вышло) { сказать(с.copyFail); return; }
      кнопка.textContent = с.copiedBig;
      clearTimeout(кнопка._т);
      кнопка._т = setTimeout(() => { кнопка.textContent = с.copyBig; }, 1500);
    });

    $('чп-очистить').addEventListener('click', () => {
      ввод.value = '';
      перевести();
      ввод.focus();
    });

    обновитьНастройки();

    window.__чпСостояние = () => ({
      ввод: ввод.value, вывод: вывод.value, род,
      формат: $('чп-формат').value, бух: $('чп-бух').checked,
      режим: $('чп-режим').textContent, длина: $('чп-длина').textContent,
      беда: обёртка.classList.contains('беда'),
      родВиден: !$('чп-род-обёртка').classList.contains('скрыт'),
      бухВиден: !$('чп-бух-обёртка').classList.contains('скрыт'),
    });
    window.__чпПрописью = (о) => прописью({ язык, ...о });
    window.__чпИзСлов = (т) => изСлов(т, язык);
  })();
</script>
