      документ: 'Tipo de documento', выдан: 'Expedido por', номер: 'Número de documento',
      фамилия: 'Apellidos', имена: 'Nombre', гражданство: 'Nacionalidad',
      рождение: 'Fecha de nacimiento', пол: 'Sexo', срок: 'Válido hasta', личный: 'Número personal',
    },
    sexes: { 'м': 'varón', 'ж': 'mujer' }, unknown: 'sin indicar',
