    names: {
      black: 'negro', darkgrey: 'gris oscuro', grey: 'gris', lightgrey: 'gris claro',
      white: 'blanco', red: 'rojo', darkred: 'rojo oscuro', pink: 'rosa',
      orange: 'naranja', brown: 'marrón', beige: 'beige', gold: 'dorado',
      yellow: 'amarillo', olive: 'oliva', lightgreen: 'verde claro', green: 'verde',
      darkgreen: 'verde oscuro', teal: 'verde azulado', cyan: 'turquesa', skyblue: 'celeste',
      blue: 'azul', darkblue: 'azul oscuro', navy: 'azul marino, casi negro',
      violet: 'violeta', purple: 'púrpura', magenta: 'magenta', coral: 'coral',
      salmon: 'salmón', cream: 'crema', sand: 'arena',
    },
  },
