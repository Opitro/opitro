const ЗАМЕТКИ = {
  ru: ['<b>Кадр никуда не уходит.</b> Камера открывается прямо в браузере, цвет считается на вашем устройстве, и ни кадр, ни значения мы не храним и не отправляем.',
       '<b>Цвет берётся средним по пятну, а не одной точкой.</b> Камера шумит, и соседние точки одного листа бумаги отличаются на десяток единиц. Среднее по маленькому кружку держится ровно.',
       '<b>Это цвет с камеры, а не из банки с краской.</b> Камера сама правит баланс белого, а лампа над столом добавляет свой оттенок. Для подбора «похоже» этого достаточно, для точного совпадения краски — нет.'],
  uk: ['<b>Кадр нікуди не йде.</b> Камера відкривається просто у браузері, колір рахується на вашому пристрої, і ні кадр, ні значення ми не зберігаємо й не надсилаємо.',
       '<b>Колір береться середнім по плямі, а не однією точкою.</b> Камера шумить, і сусідні точки одного аркуша паперу відрізняються на десяток одиниць. Середнє по маленькому кружку тримається рівно.',
       '<b>Це колір з камери, а не з банки з фарбою.</b> Камера сама виправляє баланс білого, а лампа над столом додає свій відтінок. Для добору «схоже» цього досить, для точного збігу фарби — ні.'],
  en: ['<b>The frame goes nowhere.</b> The camera opens right here in the browser, the colour is measured on your device, and neither the frame nor the values are stored or sent.',
       '<b>The colour is averaged over a small spot, not read from one pixel.</b> Cameras are noisy: neighbouring points of the same sheet of paper differ by a dozen units. An average over a small circle holds steady.',
       '<b>This is the colour from a camera, not from a paint tin.</b> The camera adjusts white balance on its own, and the lamp above the table adds its own tint. Good enough for “something like this”, not for matching paint exactly.'],
  es: ['<b>La imagen no sale de aquí.</b> La cámara se abre en el propio navegador, el color se calcula en su dispositivo y no guardamos ni enviamos ni la imagen ni los valores.',
       '<b>El color se promedia en una manchita, no se lee de un solo píxel.</b> La cámara tiene ruido: puntos vecinos de la misma hoja de papel se diferencian en una decena de unidades. El promedio de un círculo pequeño se mantiene estable.',
       '<b>Es el color de una cámara, no el de un bote de pintura.</b> La cámara corrige el balance de blancos por su cuenta y la lámpara de la mesa añade su tono. Sirve para «algo así», no para igualar una pintura con exactitud.'],
};

const с = СЛОВА[locale] || СЛОВА.ru;
const заметки = ЗАМЕТКИ[locale] || ЗАМЕТКИ.ru;
---

<div class="цв" data-words={JSON.stringify(с)} data-locale={locale}>

  <div class="цв-старт" id="цв-старт">
    <svg class="цв-старт-знак" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17.8 3.9a2.4 2.4 0 0 1 3.4 3.4l-2.3 2.3-3.4-3.4 2.3-2.3z"/>
      <path d="M15.5 6.2 6.8 14.9a2 2 0 0 0-.5.9l-.8 3.1a.6.6 0 0 0 .7.7l3.1-.8a2 2 0 0 0 .9-.5l8.7-8.7"/>
    </svg>
    <p class="цв-старт-зов">{с.invite}</p>
    <p class="цв-старт-или">{с.or}</p>
    <span class="цв-старт-ряд">
      <button type="button" class="цв-выбор" id="цв-пуск-два" title={с.camera} aria-label={с.camera}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.7a1 1 0 0 0 .8-.4l1-1.3a1 1 0 0 1 .8-.4h4.4a1 1 0 0 1 .8.4l1 1.3a1 1 0 0 0 .8.4h1.7A2.5 2.5 0 0 1 21 8.5v8A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5Z"/>
          <circle cx="12" cy="12.5" r="3.6"/>
        </svg>
        <span>{с.camera}</span>
      </button>
      <button type="button" class="цв-выбор" id="цв-загрузить-два" title={с.file} aria-label={с.file}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2"/>
          <circle cx="8.5" cy="10" r="1.6"/>
          <path d="M21 16l-5-5-5 5-2-2-5 5"/>
        </svg>
        <span>{с.file}</span>
      </button>
    </span>
  </div>

  <div class="цв-окно" id="цв-окно" hidden>
    <video id="цв-видео" playsinline muted hidden></video>
    <img id="цв-кадр" hidden alt="" />

    <span class="цв-прицел" id="цв-прицел" hidden></span>
    <span class="цв-намёк" id="цв-намёк" hidden></span>

    <span class="цв-затвор-ряд" id="цв-затвор-ряд" hidden>
      <button type="button" class="цв-затвор" id="цв-затвор" title={с.shot} aria-label={с.shot}><i></i></button>
    </span>

    <button type="button" class="цв-крест" id="цв-крест" hidden title={с.clear} aria-label={с.clear}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <div class="цв-ответ" id="цв-ответ"></div>
  <div class="цв-набор" id="цв-набор"></div>
  <div class="цв-беда" id="цв-беда"></div>

  <div class="цв-заметки">
    {заметки.map((т) => <p class="цв-заметка" set:html={т} />)}
  </div>
</div>

<style is:inline set:html={css}></style>

<script>
  import { вHex, вHsl, ближайшийЦвет } from '../lib/color-convert.js';
  import { выбратьФайл } from '../lib/pick-file.js';

  (() => {
    const корень = document.querySelector('.цв');
    if (!корень) return;
    const с = JSON.parse(корень.dataset.words || '{}');
    const язык = корень.dataset.locale || 'ru';
    const $ = (и) => document.getElementById(и);

    const окно = $('цв-окно');
    const видео = $('цв-видео');
    const кадр = $('цв-кадр');
    const старт = $('цв-старт');

    if (window.matchMedia && window.matchMedia('(hover: none)').matches) {
      const зов = старт.querySelector('.цв-старт-зов');
      const или = старт.querySelector('.цв-старт-или');
      if (зов && с.inviteTouch) зов.textContent = с.inviteTouch;
      if (или) или.hidden = true;
    }

    function показатьОкно(да) {
      окно.hidden = !да;
      старт.hidden = да;
    }
    const прицел = $('цв-прицел');
    const намёк = $('цв-намёк');
    const крест = $('цв-крест');
    const затворРяд = $('цв-затвор-ряд');
    const затвор = $('цв-затвор');
    const ответ = $('цв-ответ');
    const набор = $('цв-набор');
    const бедаЭ = $('цв-беда');

    const ЗН_КОПИ = '<svg class="лист" viewBox="0 0 24 24" aria-hidden="true">'
      + '<rect x="9" y="9" width="11" height="11" rx="2"/>'
      + '<path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"/></svg>'
      + '<svg class="галка" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>';

    let поток = null;
    let холст = null;

    let снимокВОкне = { х: 0, у: 0, ш: 1, в: 1 };
    let часыКадра = 0;
    let взятые = [];

    function беда(текст) { бедаЭ.textContent = текст || ''; }

    function цветВТочке(рисунок, х, у, радиус) {
      const кон = рисунок.getContext('2d', { willReadFrequently: true });
      const л = Math.max(0, Math.round(х - радиус));
      const в = Math.max(0, Math.round(у - радиус));
      const ш = Math.min(рисунок.width - л, радиус * 2);
      const выс = Math.min(рисунок.height - в, радиус * 2);
      if (ш <= 0 || выс <= 0) return null;
      const точки = кон.getImageData(л, в, ш, выс).data;
      let r = 0, g = 0, b = 0, сколько = 0;
      for (let i = 0; i < точки.length; i += 4) {
        r += точки[i]; g += точки[i + 1]; b += точки[i + 2]; сколько++;
      }
      if (!сколько) return null;
      return { r: Math.round(r / сколько), g: Math.round(g / сколько), b: Math.round(b / сколько) };
    }

    function кадрВХолст() {
      const кВ = видео.videoWidth, кВыс = видео.videoHeight;
      if (!кВ || !кВыс) return null;
      const р = окно.getBoundingClientRect();
      const к_окна = р.width / р.height;
      const к_кадра = кВ / кВыс;
      let ш = кВ, в = кВыс, сдвигХ = 0, сдвигY = 0;
      if (к_кадра > к_окна) { ш = Math.round(кВыс * к_окна); сдвигХ = Math.round((кВ - ш) / 2); }
      else { в = Math.round(кВ / к_окна); сдвигY = Math.round((кВыс - в) / 2); }
      const х = document.createElement('canvas');
      х.width = ш; х.height = в;
      х.getContext('2d', { willReadFrequently: true })
        .drawImage(видео, сдвигХ, сдвигY, ш, в, 0, 0, ш, в);
      return х;
    }

    function поставитьПрицел(долиХ, долиУ, цвет) {
      прицел.hidden = false;
      прицел.style.left = `${долиХ * 100}%`;
      прицел.style.top = `${долиУ * 100}%`;
      if (цвет) прицел.style.background = `rgb(${цвет.r}, ${цвет.g}, ${цвет.b})`;
    }

    function строкаRgb(ц) { return `rgb(${ц.r}, ${ц.g}, ${ц.b})`; }
    function строкаHsl(ц) {
      const h = вHsl({ ...ц, a: 1 });
      return `hsl(${Math.round(h.h)}, ${Math.round(h.s)}%, ${Math.round(h.l)}%)`;
    }

    function строка(dl, подпись, значение) {
      const dt = document.createElement('dt');
      dt.textContent = подпись;
      const dd = document.createElement('dd');
      dd.textContent = значение;
      const кнопка = document.createElement('button');
      кнопка.type = 'button';
      кнопка.className = 'цв-копи';
      кнопка.title = с.copy;
      кнопка.setAttribute('aria-label', с.copy);
      кнопка.innerHTML = ЗН_КОПИ;
      кнопка.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(значение);

          кнопка.classList.add('готово');
          кнопка.setAttribute('aria-label', с.copied);
          clearTimeout(кнопка._часы);
          кнопка._часы = setTimeout(() => {
            кнопка.classList.remove('готово');
            кнопка.setAttribute('aria-label', с.copy);
          }, 1500);
        } catch (е) {  }
      });
      dl.append(dt, dd, кнопка);

      return (новое) => { значение = новое; dd.textContent = новое; };
    }

    let карточка = null;
    function собратьКарточку() {
      const ящик = document.createElement('div');
      ящик.className = 'цв-итог';
      const пятно = document.createElement('div');
      пятно.className = 'цв-пятно';
      const строки = document.createElement('div');
      строки.className = 'цв-строки';
      const имя = document.createElement('div');
      имя.className = 'цв-имя';
      const dl = document.createElement('dl');
      dl.className = 'цв-пары';
      const поля = {};
      for (const ключ of ['HEX', 'RGB', 'HSL']) поля[ключ] = строка(dl, ключ, '');
      строки.append(имя, dl);
      ящик.append(пятно, строки);
      ответ.appendChild(ящик);
      return { ящик, пятно, имя, поля };
    }

    function кольцом(hex) {
      let эхо = окно.querySelector('.цв-эхо');
      if (!эхо) {
        эхо = document.createElement('span');
        эхо.className = 'цв-эхо';
        окно.appendChild(эхо);
      }
      эхо.style.left = прицел.style.left || '50%';
      эхо.style.top = прицел.style.top || '50%';
      эхо.style.borderColor = hex;

      эхо.classList.remove('идёт');
      void эхо.offsetWidth;
      эхо.classList.add('идёт');
    }

    function показать(цвет) {
      const hex = вHex({ ...цвет, a: 1 });
      if (!карточка || !карточка.ящик.isConnected) карточка = собратьКарточку();
      карточка.пятно.style.background = hex;
      карточка.имя.textContent = `${с.picked} · ${с.names[ближайшийЦвет(цвет)] || ''}`;
      карточка.поля.HEX(hex.toUpperCase());
      карточка.поля.RGB(строкаRgb(цвет));
      карточка.поля.HSL(строкаHsl(цвет));

      кольцом(hex);

      взятые = [hex, ...взятые.filter((ц) => ц !== hex)].slice(0, 8);
      набор.innerHTML = '';
      for (const ц of взятые) {
        const к = document.createElement('button');
        к.type = 'button';
        к.className = 'цв-кроха';
        к.style.background = ц;
        к.title = ц.toUpperCase();
        к.setAttribute('aria-label', ц.toUpperCase());
        к.addEventListener('click', () => {
          const б = ц.replace('#', '');
          показать({ r: parseInt(б.slice(0, 2), 16), g: parseInt(б.slice(2, 4), 16),
            b: parseInt(б.slice(4, 6), 16) });
        });
        набор.appendChild(к);
      }
    }

    function следить() {
      clearInterval(часыКадра);

      часыКадра = setInterval(() => {
        if (!поток || !видео.videoWidth) return;
        const х = кадрВХолст();
        if (!х) return;
        const ц = цветВТочке(х, х.width / 2, х.height / 2, Math.max(4, Math.round(х.width / 100)));
        if (ц) поставитьПрицел(0.5, 0.5, ц);
      }, 100);
    }

    async function включить() {
      беда('');
      кадр.hidden = true;
      холст = null;

      окно.style.height = '';
      окно.style.width = '';
      окно.style.marginLeft = '';
      окно.style.marginRight = '';
      снимокВОкне = { х: 0, у: 0, ш: 1, в: 1 };
      let спрашивали = false;
      try {
        const п = navigator.permissions && await navigator.permissions.query({ name: 'camera' });
        if (!п || п.state !== 'granted') { беда(с.askCam); спрашивали = true; }
      } catch (е) { беда(с.askCam); спрашивали = true; }
      try {
        поток = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { ideal: 'environment' }, width: { ideal: 1920 } }, audio: false,
        });
      } catch (е) {
        беда(е && е.name === 'NotAllowedError' ? с.denied : с.noCam);
        return;
      }
      if (спрашивали) беда('');
      видео.srcObject = поток;
      видео.hidden = false;
      показатьОкно(true);
      крест.hidden = false;
      затворРяд.hidden = false;
      намёк.hidden = false;
      намёк.textContent = с.liveHint;
      await видео.play().catch(() => {});
      поставитьПрицел(0.5, 0.5, null);
      следить();
    }

    function погасить() {
      clearInterval(часыКадра);
      if (поток) { поток.getTracks().forEach((д) => д.stop()); поток = null; }
      видео.srcObject = null;
      видео.hidden = true;
    }

    function остановить() {
      const х = кадрВХолст();
      if (!х) return;
      холст = х;
      кадр.src = х.toDataURL('image/jpeg', 0.92);
      кадр.hidden = false;
      погасить();
      затворРяд.hidden = true;
      намёк.textContent = с.frozenHint;
      намёк.hidden = false;

      const ц = цветВТочке(х, х.width / 2, х.height / 2, Math.max(4, Math.round(х.width / 100)));
      поставитьПрицел(0.5, 0.5, ц);
      if (ц) показать(ц);
    }

    function ткнули(е) {
      if (!холст || кадр.hidden) return;
      const р = окно.getBoundingClientRect();
      const вОкнеХ = (е.clientX - р.left) / р.width;
      const вОкнеУ = (е.clientY - р.top) / р.height;

      const о = снимокВОкне;
      if (вОкнеХ < о.х || вОкнеХ > о.х + о.ш || вОкнеУ < о.у || вОкнеУ > о.в + о.у) return;
      const долиХ = Math.min(1, Math.max(0, вОкнеХ));
      const долиУ = Math.min(1, Math.max(0, вОкнеУ));
      const ц = цветВТочке(холст, долиХ * холст.width, долиУ * холст.height,
        Math.max(4, Math.round(холст.width / 100)));
      if (!ц) return;
      поставитьПрицел(долиХ, долиУ, ц);
      показать(ц);
    }

    async function взятьФайл(файл) {
      беда('');
      погасить();
      let к = null;
      try {
        к = window.createImageBitmap
          ? await createImageBitmap(файл, { imageOrientation: 'from-image' })
          : await новаяКартинка(файл);
      } catch (е) { беда(с.notImage); return; }
      const ш = к.width || к.naturalWidth, в = к.height || к.naturalHeight;
      if (!ш || !в) { беда(с.notImage); return; }

      показатьОкно(true);

      const доступно = окно.parentElement
        ? окно.parentElement.getBoundingClientRect().width
        : окно.getBoundingClientRect().width;
      const потолок = Math.max(320, Math.min(620, Math.round(window.innerHeight * 0.66)));
      const высота = Math.round(Math.max(240, Math.min(потолок, доступно * (в / ш))));

      const нужнаШирина = Math.round(Math.min(доступно, высота * (ш / в)));
      окно.style.height = высота + 'px';
      окно.style.width = нужнаШирина + 'px';
      окно.style.marginLeft = 'auto';
      окно.style.marginRight = 'auto';

      const р = окно.getBoundingClientRect();
      const плотность = Math.min(2, window.devicePixelRatio || 1);
      const пш = Math.max(1, Math.round(р.width * плотность));
      const пв = Math.max(1, Math.round(р.height * плотность));
      const х = document.createElement('canvas');
      х.width = пш; х.height = пв;
      const кон = х.getContext('2d', { willReadFrequently: true });

      const доля = Math.min(пш / ш, пв / в);
      const дш = Math.round(ш * доля), дв = Math.round(в * доля);
      const дх = Math.round((пш - дш) / 2), ду = Math.round((пв - дв) / 2);

      кон.fillStyle = '#09090b';
      кон.fillRect(0, 0, пш, пв);
      кон.fillStyle = '#fff';
      кон.fillRect(дх, ду, дш, дв);
      кон.drawImage(к, дх, ду, дш, дв);
      if (к.close) { try { к.close(); } catch (е) {} }

      снимокВОкне = { х: дх / пш, у: ду / пв, ш: дш / пш, в: дв / пв };
      холст = х;
      кадр.src = х.toDataURL('image/jpeg', 0.92);
      кадр.hidden = false;
      показатьОкно(true);
      крест.hidden = false;
      затворРяд.hidden = true;
      намёк.hidden = false;
      намёк.textContent = с.frozenHint;
      const ц = цветВТочке(х, х.width / 2, х.height / 2, Math.max(4, Math.round(х.width / 100)));
      поставитьПрицел(0.5, 0.5, ц);
      if (ц) показать(ц);
    }

    function новаяКартинка(файл) {
      const адрес = URL.createObjectURL(файл);
      return new Promise((готово, мимо) => {
        const и = new Image();
        и.onload = () => { готово(и); setTimeout(() => URL.revokeObjectURL(адрес), 1000); };
        и.onerror = () => { URL.revokeObjectURL(адрес); мимо(new Error('не картинка')); };
        и.src = адрес;
      });
    }

    function очистить() {
      погасить();
      холст = null;

      окно.style.height = '';
      окно.style.width = '';
      окно.style.marginLeft = '';
      окно.style.marginRight = '';
      снимокВОкне = { х: 0, у: 0, ш: 1, в: 1 };
      кадр.removeAttribute('src');
      кадр.hidden = true;
      показатьОкно(false);
      крест.hidden = true;
      затворРяд.hidden = true;
      прицел.hidden = true;
      намёк.hidden = true;
      ответ.innerHTML = '';
      беда('');
    }

    $('цв-пуск-два').addEventListener('click', (е) => { е.stopPropagation(); включить(); });

    $('цв-загрузить-два').addEventListener('click', async (е) => {
      е.stopPropagation();
      const файл = await выбратьФайл({ берём: 'image/*' });
      if (файл) взятьФайл(файл);
    });
    затвор.addEventListener('click', (е) => { е.stopPropagation(); остановить(); });
    крест.addEventListener('click', (е) => { е.stopPropagation(); очистить(); });
    кадр.addEventListener('click', ткнули);
    окно.addEventListener('dragover', (е) => е.preventDefault());
    окно.addEventListener('drop', (е) => {
      е.preventDefault();
      const ф = е.dataTransfer && е.dataTransfer.files && е.dataTransfer.files[0];
      if (ф && ф.type.startsWith('image/')) взятьФайл(ф);
    });

    for (const имя of ['dragenter', 'dragover']) {
      старт.addEventListener(имя, (е) => { е.preventDefault(); старт.classList.add('держат'); });
    }
    for (const имя of ['dragleave', 'dragend']) {
      старт.addEventListener(имя, () => старт.classList.remove('держат'));
    }
    старт.addEventListener('drop', (е) => {
      е.preventDefault();
      старт.classList.remove('держат');
      const файл = е.dataTransfer && е.dataTransfer.files && е.dataTransfer.files[0];
      if (файл) взятьФайл(файл);
    });

    window.addEventListener('pagehide', погасить);

    window.__цвСостояние = () => ({
      камераИдёт: !!поток,
      кадрЗастыл: !кадр.hidden,
      прицелВиден: !прицел.hidden,
      ответ: ответ.textContent.replace(/\s+/g, ' ').trim().slice(0, 200),
      взятых: взятые.length,
      беда: бедаЭ.textContent.trim().slice(0, 120),
    });
  })();
</script>
