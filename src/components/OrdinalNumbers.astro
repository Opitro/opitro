---
// ПОРЯДКОВЫЕ ЧИСЛИТЕЛЬНЫЕ.
//
// ПРАВИЛО ПОСЛЕДНЕГО СЛОВА: в составном порядковом меняется только последнее слово, всё
// остальное остаётся количественным: 135 -- «сто тридцать пятый».
//
// ИСКЛЮЧЕНИЕ, О КОТОРОМ ЧАЩЕ ВСЕГО ЗАБЫВАЮТ: круглые тысячи и миллионы пишутся ОДНИМ
// словом из основ, а не раздельно. 5000 -- «пятитысячный», 25000 --
// «двадцатипятитысячный», 500000 -- «пятисоттысячный». Раздельное «пять тысячный» --
// ошибка, и её делают почти все самодельные переводчики.
//
// В английском и испанском порядковые есть, а рода в английском нет -- переключатель там
// не показывается вовсе, вместо него короткая запись 1st, 2nd, 3rd.
//
// Ничего никуда не уходит: всё считается в браузере.
import css from '../styles/ordinal-numbers.css?inline';

const { locale = 'ru' } = Astro.props;
const сРодом = locale !== 'en';

const СЛОВА = {
  ru: {
    gender: 'Род и число', male: 'Мужской', female: 'Женский', neuter: 'Средний',
    plural: 'Множественное',
    place: 'Введите число, например 123',
    head: 'Результат преобразования',
    empty: 'Введите число — порядковая форма появится здесь.',
    errBig: 'Слишком большое число: считаем до триллионов.',
    copy: 'Копировать', copied: 'Готово', clearAll: 'Очистить всё',
    ряды: [['Прописью', ''], ['Наращение', 'цифрами с буквой']],
    n1: '<b>Меняется только последнее слово.</b> 135 — «сто тридцать пятый»: «сто» и «тридцать» остаются количественными. Это и есть главное правило, и оно же чаще всего нарушается в списках и оглавлениях.',
    n2: '<b>Круглые тысячи пишутся одним словом.</b> 5000 — «пятитысячный», 25000 — «двадцатипятитысячный», 500000 — «пятисоттысячный». Раздельное «пять тысячный» — ошибка, а именно так пишет большинство самодельных переводчиков.',
    n3: '<b>Тысяча в такой записи идёт без «одна».</b> 1500 — «тысяча пятисотый», а не «одна тысяча пятисотый». Ровно как в дате: «тысяча девятьсот девяносто первого года».',
    n4: '<b>«Третий» склоняется не как остальные.</b> Третья, третье, третьи — с мягкой основой, а не «третяя». Это единственное порядковое с таким набором окончаний, и его приходится знать отдельно.',
    n5: '<b>Наращение в именительном падеже — одна буква.</b> 1-й, 25-я, 300-е. Две буквы нужны в косвенных падежах: 5-го, 5-му. Правило простое: смотрят на букву перед окончанием. Количественные числительные наращения не имеют вовсе — «в объёме 5 литров», без букв.',
    n6: 'Всё считается в вашем браузере. Числа никуда не отправляются и нигде не сохраняются.',
  },
  uk: {
    gender: 'Рід і число', male: 'Чоловічий', female: 'Жіночий', neuter: 'Середній',
    plural: 'Множина',
    place: 'Введіть число, наприклад 123',
    head: 'Результат перетворення',
    empty: 'Введіть число — порядкова форма з’явиться тут.',
    errBig: 'Завелике число: рахуємо до трильйонів.',
    copy: 'Копіювати', copied: 'Готово', clearAll: 'Очистити все',
    ряды: [['Прописом', ''], ['Нарощення', 'цифрами з літерою']],
    n1: '<b>Змінюється лише останнє слово.</b> 135 — «сто тридцять п’ятий»: «сто» і «тридцять» лишаються кількісними. Це головне правило, і воно ж найчастіше порушується в списках і змістах.',
    n2: '<b>Круглі тисячі пишуться одним словом.</b> 5000 — «п’ятитисячний», 25000 — «двадцятип’ятитисячний», 500000 — «п’ятисоттисячний». Роздільне «п’ять тисячний» — помилка.',
    n3: '<b>Тисяча в такому записі йде без «одна».</b> 1500 — «тисяча п’ятисотий», а не «одна тисяча п’ятисотий». Так само, як у даті.',
    n4: '<b>«Третій» відмінюється не як решта.</b> Третя, третє, треті — з м’якою основою. Це єдиний порядковий із таким набором закінчень.',
    n5: '<b>Нарощення в називному відмінку — одна літера.</b> 1-й, 25-а, 300-е. Кількісні числівники нарощення не мають зовсім — «в обсязі 5 літрів», без літер.',
    n6: 'Усе рахується у вашому браузері. Числа нікуди не надсилаються і ніде не зберігаються.',
  },
  en: {
    place: 'Enter a number, 123 for example',
    head: 'Ordinal forms',
    empty: 'Enter a number — the ordinal appears here.',
    errBig: 'Too large: we spell out up to trillions.',
    copy: 'Copy', copied: 'Done', clearAll: 'Clear everything',
    ряды: [['In words', ''], ['Short form', 'digits with a suffix']],
    n1: '<b>Only the last word changes.</b> 123 becomes “one hundred twenty-third”: the hundred and the twenty stay as they were. The same rule holds in every language on this site, and it is the one most often broken.',
    n2: '<b>Most ordinal words are irregular.</b> Five becomes fifth, nine becomes ninth, twelve becomes twelfth, forty becomes fortieth. Adding “th” to everything gets several of them wrong, and those are the common ones.',
    n3: '<b>The suffix is not always “th”.</b> It is 1st, 2nd, 3rd — but 11th, 12th and 13th, because the teens break the pattern. That is why 21st is right and 11st is not, and why a simple “last digit” rule fails.',
    n4: '<b>English has no gender for ordinals.</b> So there is no gender switch on this page. In Russian, Ukrainian and Spanish there is one, because the ending changes with the noun.',
    n5: 'Everything is computed in your browser. Numbers are never sent anywhere and never stored.',
    n6: '',
  },
  es: {
    gender: 'Género y número', male: 'Masculino', female: 'Femenino', neuter: 'Plural masc.',
    plural: 'Plural fem.',
    place: 'Escribe un número, por ejemplo 123',
    head: 'Formas ordinales',
    empty: 'Escribe un número: la forma ordinal aparecerá aquí.',
    errBig: 'Demasiado grande: los ordinales llegan hasta el 9999.',
    copy: 'Copiar', copied: 'Hecho', clearAll: 'Limpiar todo',
    ряды: [['En letras', ''], ['Forma abreviada', 'cifra con volada']],
    n1: '<b>Los ordinales grandes no se deducen del cardinal.</b> Quinientos da quingentésimo, novecientos da noningentésimo: la raíz cambia entera. No hay regla que los produzca, y por eso casi nadie los escribe de memoria.',
    n2: '<b>El género y el número cambian la terminación.</b> Primero, primera, primeros, primeras. Al hablar de páginas, casas o ediciones hace falta el femenino, y es el fallo más frecuente.',
    n3: '<b>La abreviatura lleva punto y letra volada.</b> 1.º, 1.ª, 1.os, 1.as, según recomienda la Academia. Escribir «1o» o «1ro» es incorrecto, aunque se vea a menudo.',
    n4: '<b>Hasta el 9999 y no más.</b> Más allá las formas existen en los tratados pero son librescas y discutidas; preferimos no dar nada antes que dar una palabra inventada.',
    n5: 'Todo se calcula en tu navegador. Los números no se envían a ninguna parte ni se guardan.',
    n6: '',
  },
};
const с = СЛОВА[locale] || СЛОВА.ru;
const заметки = [с.n1, с.n2, с.n3, с.n4, с.n5, с.n6].filter(Boolean);
---

<style is:inline set:html={css}></style>

<div class="пор" data-words={JSON.stringify(с)} data-locale={locale}>
  {сРодом && (
    <div class="пор-верх">
      <span class="пор-подпись">{с.gender}:</span>
      <div class="пор-кнопки" role="group">
        <button type="button" class="пор-выбор выбран" id="пор-м">{с.male}</button>
        <button type="button" class="пор-выбор" id="пор-ж">{с.female}</button>
        <button type="button" class="пор-выбор" id="пор-с">{с.neuter}</button>
        <button type="button" class="пор-выбор" id="пор-мн">{с.plural}</button>
      </div>
    </div>
  )}

  <input class="пор-число" id="пор-ввод" type="text" inputmode="numeric" placeholder={с.place}
    spellcheck="false">

  <div class="пор-таблица" id="пор-таблица">
    <div class="пор-пусто">{с.empty}</div>
  </div>

  <div class="пор-низ">
    <button type="button" class="пор-простая" id="пор-очистить">{с.clearAll}</button>
  </div>

  <div class="пор-заметки">
    {заметки.map((з) => <div class="пор-заметка" set:html={з}></div>)}
  </div>
</div>

<script>
  const корень = document.querySelector('.пор');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const язык = корень.dataset.locale || 'ru';
    const сРодом = язык !== 'en';
    const славянский = язык === 'ru' || язык === 'uk';
    const $ = (и) => document.getElementById(и);
    const ввод = $('пор-ввод');
    const окно = $('пор-таблица');
    let род = 'м';

    /* ПОРЯДКОВЫЕ ЧИСЛИТЕЛЬНЫЕ.
     *
     * ПРАВИЛО ПОСЛЕДНЕГО СЛОВА: в составном порядковом меняется только последнее слово, всё
     * остальное остаётся количественным: 135 -- «сто тридцать пятый».
     *
     * ИСКЛЮЧЕНИЕ -- КРУГЛЫЕ ТЫСЯЧИ И МИЛЛИОНЫ: они пишутся ОДНИМ словом из основ, а не
     * раздельно. 5000 -- «пятитысячный», 25000 -- «двадцатипятитысячный», 2000000 --
     * «двухмиллионный». Раздельная запись «пять тысячный» -- ошибка.
     */

    const РУ = {
      единицы: ['', 'первый', 'второй', 'третий', 'четвёртый', 'пятый', 'шестой', 'седьмой',
        'восьмой', 'девятый'],
      подростки: ['десятый', 'одиннадцатый', 'двенадцатый', 'тринадцатый', 'четырнадцатый',
        'пятнадцатый', 'шестнадцатый', 'семнадцатый', 'восемнадцатый', 'девятнадцатый'],
      десятки: ['', '', 'двадцатый', 'тридцатый', 'сороковой', 'пятидесятый', 'шестидесятый',
        'семидесятый', 'восьмидесятый', 'девяностый'],
      сотни: ['', 'сотый', 'двухсотый', 'трёхсотый', 'четырёхсотый', 'пятисотый', 'шестисотый',
        'семисотый', 'восьмисотый', 'девятисотый'],
      колЕд: ['', 'один', 'два', 'три', 'четыре', 'пять', 'шесть', 'семь', 'восемь', 'девять'],
      колПодр: ['десять', 'одиннадцать', 'двенадцать', 'тринадцать', 'четырнадцать', 'пятнадцать',
        'шестнадцать', 'семнадцать', 'восемнадцать', 'девятнадцать'],
      колДес: ['', '', 'двадцать', 'тридцать', 'сорок', 'пятьдесят', 'шестьдесят', 'семьдесят',
        'восемьдесят', 'девяносто'],
      колСот: ['', 'сто', 'двести', 'триста', 'четыреста', 'пятьсот', 'шестьсот', 'семьсот',
        'восемьсот', 'девятьсот'],
      // Основы для слитных слов: «двадцатипятитысячный» складывается из «двадцати» и «пяти».
      оснЕд: ['', 'одно', 'двух', 'трёх', 'четырёх', 'пяти', 'шести', 'семи', 'восьми', 'девяти'],
      оснПодр: ['десяти', 'одиннадцати', 'двенадцати', 'тринадцати', 'четырнадцати',
        'пятнадцати', 'шестнадцати', 'семнадцати', 'восемнадцати', 'девятнадцати'],
      оснДес: ['', '', 'двадцати', 'тридцати', 'сорока', 'пятидесяти', 'шестидесяти',
        'семидесяти', 'восьмидесяти', 'девяносто'],
      оснСот: ['', 'сто', 'двухсот', 'трёхсот', 'четырёхсот', 'пятисот', 'шестисот', 'семисот',
        'восьмисот', 'девятисот'],
      разрядыКол: [null, 'тысяча', 'миллион', 'миллиард', 'триллион'],
      разрядыПоряд: [null, 'тысячный', 'миллионный', 'миллиардный', 'триллионный'],
      тысячаФормы: ['', 'тысяча', 'две тысячи', 'три тысячи', 'четыре тысячи', 'пять тысяч',
        'шесть тысяч', 'семь тысяч', 'восемь тысяч', 'девять тысяч'],
      ноль: 'нулевой',
    };

    const УК = {
      единицы: ['', 'перший', 'другий', 'третій', 'четвертий', "п'ятий", 'шостий', 'сьомий',
        'восьмий', "дев'ятий"],
      подростки: ['десятий', 'одинадцятий', 'дванадцятий', 'тринадцятий', 'чотирнадцятий',
        "п'ятнадцятий", 'шістнадцятий', 'сімнадцятий', 'вісімнадцятий', "дев'ятнадцятий"],
      десятки: ['', '', 'двадцятий', 'тридцятий', 'сороковий', "п'ятдесятий", 'шістдесятий',
        'сімдесятий', 'вісімдесятий', "дев'яностий"],
      сотни: ['', 'сотий', 'двохсотий', 'трьохсотий', 'чотирьохсотий', "п'ятисотий",
        'шестисотий', 'семисотий', 'восьмисотий', "дев'ятисотий"],
      колЕд: ['', 'один', 'два', 'три', 'чотири', "п'ять", 'шість', 'сім', 'вісім', "дев'ять"],
      колПодр: ['десять', 'одинадцять', 'дванадцять', 'тринадцять', 'чотирнадцять', "п'ятнадцять",
        'шістнадцять', 'сімнадцять', 'вісімнадцять', "дев'ятнадцять"],
      колДес: ['', '', 'двадцять', 'тридцять', 'сорок', "п'ятдесят", 'шістдесят', 'сімдесят',
        'вісімдесят', "дев'яносто"],
      колСот: ['', 'сто', 'двісті', 'триста', 'чотириста', "п'ятсот", 'шістсот', 'сімсот',
        'вісімсот', "дев'ятсот"],
      оснЕд: ['', 'одно', 'двох', 'трьох', 'чотирьох', "п'яти", 'шести', 'семи', 'восьми', "дев'яти"],
      оснПодр: ['десяти', 'одинадцяти', 'дванадцяти', 'тринадцяти', 'чотирнадцяти',
        "п'ятнадцяти", 'шістнадцяти', 'сімнадцяти', 'вісімнадцяти', "дев'ятнадцяти"],
      оснДес: ['', '', 'двадцяти', 'тридцяти', 'сорока', "п'ятдесяти", 'шістдесяти',
        'сімдесяти', 'вісімдесяти', "дев'яносто"],
      оснСот: ['', 'сто', 'двохсот', 'трьохсот', 'чотирьохсот', "п'ятисот", 'шестисот', 'семисот',
        'восьмисот', "дев'ятисот"],
      разрядыКол: [null, 'тисяча', 'мільйон', 'мільярд', 'трильйон'],
      разрядыПоряд: [null, 'тисячний', 'мільйонний', 'мільярдний', 'трильйонний'],
      тысячаФормы: ['', 'тисяча', 'дві тисячі', 'три тисячі', 'чотири тисячі', "п'ять тисяч",
        'шість тисяч', 'сім тисяч', 'вісім тисяч', "дев'ять тисяч"],
      ноль: 'нульовий',
    };

    const ТАБЛИЦЫ = { ru: РУ, uk: УК };

    /** Окончание по роду и числу. Порядковые склоняются как прилагательные. */
    function поРоду(мужское, род, язык) {
      if (род === 'м') return мужское;
      // «Третий» -- единственное с мягкой основой: третья, третье, третьи.
      const мягкое = язык === 'ru' ? 'третий' : 'третій';
      if (мужское.endsWith(мягкое)) {
        const начало = мужское.slice(0, -мягкое.length);
        const формы = язык === 'ru'
          ? { ж: 'третья', с: 'третье', мн: 'третьи' }
          : { ж: 'третя', с: 'третє', мн: 'треті' };
        return начало + формы[род];
      }
      const осн = мужское.slice(0, -2);            // отрезаем -ый, -ой, -ий
      if (язык === 'uk') return осн + { ж: 'а', с: 'е', мн: 'і' }[род];
      return осн + { ж: 'ая', с: 'ое', мн: 'ые' }[род];
    }

    /** Основа трёхзначной группы для слитного слова: 25 -> «двадцатипяти». */
    function основаГруппы(значение, т) {
      const части = [];
      const сот = Math.floor(значение / 100);
      const ост = значение % 100;
      if (сот) части.push(т.оснСот[сот]);
      if (ост >= 10 && ост < 20) части.push(т.оснПодр[ост - 10]);
      else {
        const д = Math.floor(ост / 10), е = ост % 10;
        if (д) части.push(т.оснДес[д]);
        if (е) части.push(т.оснЕд[е]);
      }
      return части.join('');
    }

    /** Количественная запись группы. */
    function количественнаяГруппа(значение, т) {
      const слова = [];
      const сот = Math.floor(значение / 100);
      const ост = значение % 100;
      if (сот) слова.push(т.колСот[сот]);
      if (ост >= 10 && ост < 20) слова.push(т.колПодр[ост - 10]);
      else {
        const д = Math.floor(ост / 10), е = ост % 10;
        if (д) слова.push(т.колДес[д]);
        if (е) слова.push(т.колЕд[е]);
      }
      return слова;
    }

    /** Порядковая форма группы: меняется только последнее слово. */
    function порядковаяГруппа(значение, т) {
      const слова = [];
      const сот = Math.floor(значение / 100);
      const ост = значение % 100;
      if (!ост) { слова.push(т.сотни[сот]); return слова; }
      if (сот) слова.push(т.колСот[сот]);
      if (ост >= 10 && ост < 20) { слова.push(т.подростки[ост - 10]); return слова; }
      const д = Math.floor(ост / 10), е = ост % 10;
      if (!е) { слова.push(т.десятки[д]); return слова; }
      if (д) слова.push(т.колДес[д]);
      слова.push(т.единицы[е]);
      return слова;
    }

    /** Порядковое числительное прописью. */
    function порядковое(цифры, род = 'м', язык = 'ru') {
      const т = ТАБЛИЦЫ[язык];
      const чистые = String(цифры).replace(/^0+(?=\d)/, '');
      if (чистые === '0') return поРоду(т.ноль, род, язык);

      const тройки = [];
      for (let к = чистые.length; к > 0; к -= 3) тройки.unshift(чистые.slice(Math.max(0, к - 3), к));
      const значения = тройки.map((к) => parseInt(к, 10));

      // Ищем последнюю ненулевую группу: она и станет порядковой.
      let последняя = -1;
      for (let и = значения.length - 1; и >= 0; и--) if (значения[и]) { последняя = и; break; }
      if (последняя < 0) return поРоду(т.ноль, род, язык);

      const слова = [];
      for (let и = 0; и < последняя; и++) {
        if (!значения[и]) continue;
        const разряд = значения.length - 1 - и;
        слова.push(...количественнаяГруппа(значения[и], т));
        // Тысяча в такой записи идёт без «одна»: «тысяча пятисотый».
        if (разряд === 1) {
          слова.splice(слова.length - количественнаяГруппа(значения[и], т).length,
            количественнаяГруппа(значения[и], т).length, т.тысячаФормы[значения[и]] || '');
        } else слова.push(т.разрядыКол[разряд]);
      }

      const разряд = значения.length - 1 - последняя;
      if (разряд === 0) {
        слова.push(...порядковаяГруппа(значения[последняя], т));
      } else {
        // Круглые тысячи и миллионы -- ОДНО слово из основ: «двадцатипятитысячный».
        const основа = значения[последняя] === 1 ? '' : основаГруппы(значения[последняя], т);
        слова.push(основа + т.разрядыПоряд[разряд]);
      }

      const строка = слова.filter(Boolean).join(' ');
      const части = строка.split(' ');
      части[части.length - 1] = поРоду(части[части.length - 1], род, язык);
      return части.join(' ');
    }

    /** Наращение: 1-й, 25-я, 300-е. В именительном падеже буква всегда одна. */
    function наращение(цифры, род, язык) {
      const чистые = String(цифры).replace(/^0+(?=\d)/, '');
      const слово = порядковое(чистые, род, язык);
      const последняя = слово.slice(-1);
      return `${чистые}-${последняя}`;
    }

    /* ---- Английский ------------------------------------------------------------------------- */

    const EN_ЕД = ['', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
    const EN_ПОДР = ['ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen',
      'seventeen', 'eighteen', 'nineteen'];
    const EN_ДЕС = ['', '', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'];
    const EN_РАЗРЯДЫ = ['', 'thousand', 'million', 'billion', 'trillion'];
    const EN_ПОРЯДКОВЫЕ = {
      one: 'first', two: 'second', three: 'third', four: 'fourth', five: 'fifth', six: 'sixth',
      seven: 'seventh', eight: 'eighth', nine: 'ninth', ten: 'tenth', eleven: 'eleventh',
      twelve: 'twelfth', thirteen: 'thirteenth', fourteen: 'fourteenth', fifteen: 'fifteenth',
      sixteen: 'sixteenth', seventeen: 'seventeenth', eighteen: 'eighteenth',
      nineteen: 'nineteenth', twenty: 'twentieth', thirty: 'thirtieth', forty: 'fortieth',
      fifty: 'fiftieth', sixty: 'sixtieth', seventy: 'seventieth', eighty: 'eightieth',
      ninety: 'ninetieth', hundred: 'hundredth', thousand: 'thousandth', million: 'millionth',
      billion: 'billionth', trillion: 'trillionth',
    };

    function englishTriple(значение) {
      const слова = [];
      const сот = Math.floor(значение / 100), ост = значение % 100;
      if (сот) слова.push(EN_ЕД[сот], 'hundred');
      if (ост >= 10 && ост < 20) слова.push(EN_ПОДР[ост - 10]);
      else {
        const д = Math.floor(ост / 10), е = ост % 10;
        if (д && е) слова.push(`${EN_ДЕС[д]}-${EN_ЕД[е]}`);
        else if (д) слова.push(EN_ДЕС[д]);
        else if (е) слова.push(EN_ЕД[е]);
      }
      return слова;
    }

    function английскоеКоличественное(цифры) {
      const чистые = String(цифры).replace(/^0+(?=\d)/, '');
      if (чистые === '0') return 'zero';
      const тройки = [];
      for (let к = чистые.length; к > 0; к -= 3) тройки.unshift(чистые.slice(Math.max(0, к - 3), к));
      const слова = [];
      тройки.forEach((кусок, и) => {
        const з = parseInt(кусок, 10);
        if (!з) return;
        const разряд = тройки.length - 1 - и;
        слова.push(...englishTriple(з));
        if (разряд) слова.push(EN_РАЗРЯДЫ[разряд]);
      });
      return слова.join(' ');
    }

    function английскоеПорядковое(цифры) {
      const строка = английскоеКоличественное(цифры);
      if (строка === 'zero') return 'zeroth';
      const слова = строка.split(' ');
      const последнее = слова.pop();
      const части = последнее.split('-');
      const хвост = части.pop();
      части.push(EN_ПОРЯДКОВЫЕ[хвост] || хвост + 'th');
      слова.push(части.join('-'));
      return слова.join(' ');
    }

    /** Короткая запись: 1st, 2nd, 3rd, 4th. С одиннадцати по тринадцать всегда «th». */
    function английскоеСокращение(цифры) {
      const чистые = String(цифры).replace(/^0+(?=\d)/, '');
      const сотня = Number(чистые.slice(-2));
      const десяток = Number(чистые.slice(-1));
      let хвост = 'th';
      if (сотня < 11 || сотня > 13) {
        if (десяток === 1) хвост = 'st';
        else if (десяток === 2) хвост = 'nd';
        else if (десяток === 3) хвост = 'rd';
      }
      return чистые + хвост;
    }

    /* ---- Испанский ------------------------------------------------------------------------- */

    const ES_ЕД = ['', 'primero', 'segundo', 'tercero', 'cuarto', 'quinto', 'sexto', 'séptimo',
      'octavo', 'noveno'];
    const ES_ДЕС = ['', 'décimo', 'vigésimo', 'trigésimo', 'cuadragésimo', 'quincuagésimo',
      'sexagésimo', 'septuagésimo', 'octogésimo', 'nonagésimo'];
    const ES_ПОДР = ['décimo', 'undécimo', 'duodécimo', 'decimotercero', 'decimocuarto',
      'decimoquinto', 'decimosexto', 'decimoséptimo', 'decimoctavo', 'decimonoveno'];
    const ES_СОТ = ['', 'centésimo', 'ducentésimo', 'tricentésimo', 'cuadringentésimo',
      'quingentésimo', 'sexcentésimo', 'septingentésimo', 'octingentésimo', 'noningentésimo'];
    const ES_ТЫС = ['', 'milésimo', 'dosmilésimo', 'tresmilésimo', 'cuatromilésimo',
      'cincomilésimo', 'seismilésimo', 'sietemilésimo', 'ochomilésimo', 'nuevemilésimo'];

    function испанскоеПорядковое(цифры, род = 'м') {
      const число = Number(String(цифры).replace(/^0+(?=\d)/, ''));
      if (!число) return null;
      if (число > 9999) return null;    // дальше формы книжные и спорные -- выдумывать не станем
      const тыс = Math.floor(число / 1000);
      const сот = Math.floor((число % 1000) / 100);
      const ост = число % 100;
      const части = [];
      if (тыс) части.push(ES_ТЫС[тыс]);
      if (сот) части.push(ES_СОТ[сот]);
      if (ост >= 10 && ост < 20) части.push(ES_ПОДР[ост - 10]);
      else {
        const д = Math.floor(ост / 10), е = ост % 10;
        if (д) части.push(ES_ДЕС[д]);
        if (е) части.push(ES_ЕД[е]);
      }
      let строка = части.join(' ');
      if (род === 'ж' || род === 'жмн') строка = строка.replace(/o(\b)/g, 'a$1');
      if (род === 'мн') строка = строка.replace(/o(\b)/g, 'os$1');
      if (род === 'жмн') строка = строка.replace(/a(\b)/g, 'as$1');
      return строка;
    }

    /** Короткая запись по правилам испанской академии: 1.º, 1.ª, 1.os, 1.as. */
    function испанскоеСокращение(цифры, род = 'м') {
      const чистые = String(цифры).replace(/^0+(?=\d)/, '');
      const хвост = { 'м': '.º', 'ж': '.ª', 'мн': '.os', 'жмн': '.as' }[род] || '.º';
      return чистые + хвост;
    }

    /* ---- Показ ------------------------------------------------------------------------------ */

    const ПРЕДЕЛ = 15;

    function пусто(текст) {
      const э = document.createElement('div');
      э.className = 'пор-пусто';
      э.textContent = текст;
      окно.replaceChildren(э);
    }

    function ряд(имя, вопрос, форма) {
      const строка = document.createElement('div');
      строка.className = 'пор-ряд';
      const подпись = document.createElement('span');
      подпись.className = 'пор-имя';
      подпись.textContent = имя;
      if (вопрос) {
        const в = document.createElement('i');
        в.textContent = вопрос;
        подпись.append(в);
      }
      const значение = document.createElement('span');
      значение.className = 'пор-форма';
      значение.textContent = форма;
      const кнопка = document.createElement('button');
      кнопка.type = 'button';
      кнопка.className = 'пор-копия';
      кнопка.textContent = с.copy;
      кнопка.addEventListener('click', async () => {
        let вышло = false;
        try { await navigator.clipboard.writeText(форма); вышло = true; }
        catch (ошибка) { вышло = false; }
        if (!вышло) return;
        кнопка.textContent = с.copied;
        кнопка.classList.add('готово');
        clearTimeout(кнопка._т);
        кнопка._т = setTimeout(() => {
          кнопка.textContent = с.copy;
          кнопка.classList.remove('готово');
        }, 1000);
      });
      строка.append(подпись, значение, кнопка);
      return строка;
    }

    function показать(формы) {
      const куски = document.createDocumentFragment();
      const шапка = document.createElement('div');
      шапка.className = 'пор-шапка';
      шапка.textContent = с.head;
      куски.append(шапка);
      формы.forEach((форма, и) => {
        if (форма === null) return;
        const [имя, вопрос] = с.ряды[и];
        куски.append(ряд(имя, вопрос, форма));
      });
      окно.replaceChildren(куски);
    }

    function пересчитать() {
      const цифры = ввод.value.replace(/\D/g, '');
      if (!цифры) { пусто(с.empty); return; }
      if (цифры.replace(/^0+(?=\d)/, '').length > ПРЕДЕЛ) { пусто(с.errBig); return; }

      if (славянский) {
        показать([порядковое(цифры, род, язык), наращение(цифры, род, язык)]);
        return;
      }
      if (язык === 'en') {
        показать([английскоеПорядковое(цифры), английскоеСокращение(цифры)]);
        return;
      }
      const словами = испанскоеПорядковое(цифры, род);
      if (словами === null) { пусто(с.errBig); return; }
      показать([словами, испанскоеСокращение(цифры, род)]);
    }

    if (сРодом) {
      const все = ['пор-м', 'пор-ж', 'пор-с', 'пор-мн'];
      // В испанском четвёртая кнопка -- женское множественное, в славянских -- просто
      // множественное: у них множественное число одно на все роды.
      const значения = язык === 'es'
        ? { 'пор-м': 'м', 'пор-ж': 'ж', 'пор-с': 'мн', 'пор-мн': 'жмн' }
        : { 'пор-м': 'м', 'пор-ж': 'ж', 'пор-с': 'с', 'пор-мн': 'мн' };
      for (const и of все) {
        $(и).addEventListener('click', () => {
          род = значения[и];
          for (const д of все) $(д).classList.toggle('выбран', д === и);
          пересчитать();
        });
      }
    }

    ввод.addEventListener('input', пересчитать);
    $('пор-очистить').addEventListener('click', () => {
      ввод.value = '';
      пересчитать();
      ввод.focus();
    });

    пересчитать();

    window.__порСостояние = () => ({
      род,
      формы: [...окно.querySelectorAll('.пор-форма')].map((э) => э.textContent),
      пусто: Boolean(окно.querySelector('.пор-пусто')),
      пустоТекст: (окно.querySelector('.пор-пусто') || {}).textContent || '',
      родВиден: Boolean($('пор-м')),
    });
  })();
</script>
