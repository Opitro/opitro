    lines: ['рядок', 'рядки', 'рядків'], words: ['слово', 'слова', 'слів'],
    swap: 'Поміняти місцями', clearAll: 'Очистити все',
    copyBig: 'Копіювати відмінності', copiedBig: 'Скопійовано!',
    nothing: 'Відмінностей немає', copyFail: 'Браузер не дав скопіювати',
    n1: '<b>Порівняння йде на льоту.</b> Кнопки «знайти відмінності» немає: спосіб Маєрса шукає найкоротший ланцюжок правок за час, пропорційний числу самих правок, і чотири тисячі рядків розбирає менш ніж за мілісекунду.',
    n2: '<b>За рядками чи за словами — різні задачі.</b> За рядками дивляться код, списки й налаштування: видно, який рядок замінено цілком. За словами дивляться статті й договори: видно точкову правку всередині довгого абзацу, а не «увесь рядок змінився».',
    n3: '<b>Підсвітка йде фоном, а літери лишаються білими.</b> Кольорові літери на темному читаються гірше й втомлюють на довгому тексті. Збіжні шматки ми теж не гасимо до сірості: людина часто читає не самі правки, а текст навколо них.',
    n4: 'Перемикачі <b>«не зважати»</b> прибирають шум. Зайві пробіли в кінці рядків і різний регістр — найчастіша причина, через яку порівняння показує відмінності там, де для людини їх немає.',
    n5: '<b>Тексти не покидають пристрій.</b> Договір, листування чи чужий код розбираються просто в браузері: нічого не надсилається на сервер, не зберігається і після закриття вкладки не лишається.',
  },
  en: {
    mode: 'Compare', byLines: 'By lines', byWords: 'By words', byChars: 'By characters',
    chars: ['character', 'characters'],
    countLines: 'Lines', countChars: 'Characters',
    copy: 'Copy', copied: 'Copied', clearOne: 'Clear this box',
    coarse: 'Too many differences — shown coarsely: everything removed, everything added. That happens when the two texts are barely related; try comparing smaller pieces.',
    n6: '<b>By characters is for a small edit inside a word.</b> A typo, an ending, one different digit in a number: by words you only see “this word was replaced”, by characters you see what changed inside it. Over long texts this view breaks everything into crumbs, which is why it comes third rather than first.',
    view: 'Show', two: 'Two columns', one: 'One flow',
    ignoreCase: 'Ignore letter case', ignoreSpaces: 'Ignore extra spaces',
    nameA: 'Before', nameB: 'After',
    placeA: 'Paste the original text…', placeB: 'Paste the changed text…',
    empty: 'Paste both texts — the differences appear here at once, with no button to press.',
    same: 'The texts are identical.',
    sameButCase: 'The texts match — allowing for what you told it to ignore.',
    removed: 'Removed', added: 'Added', match: 'Match',
    lines: ['line', 'lines'], words: ['word', 'words'],
    swap: 'Swap sides', clearAll: 'Clear everything',
    copyBig: 'Copy the differences', copiedBig: 'Copied!',
    nothing: 'There are no differences', copyFail: 'The browser refused to copy',
    n1: '<b>The comparison runs as you type.</b> There is no “find differences” button: the Myers algorithm finds the shortest chain of edits in time proportional to the number of edits themselves, and gets through four thousand lines in under a millisecond.',
    n2: '<b>By lines and by words are different jobs.</b> By lines is how you look at code, lists and configuration: you see which line was replaced whole. By words is for articles and contracts: you see the one word that changed inside a long paragraph instead of “this entire line changed”.',
    n3: '<b>Highlighting uses the background, and the letters stay white.</b> Coloured letters on a dark ground read worse and tire the eye over a long text. Matching parts are not dimmed into greyness either: people often read the text around the edits rather than the edits themselves.',
    n4: 'The <b>ignore</b> switches remove noise. Trailing spaces at the ends of lines and a difference in letter case are the most common reason a comparison reports differences where a human sees none.',
    n5: '<b>The texts never leave your device.</b> A contract, a private exchange or someone else source code is compared inside your browser: nothing is sent to a server, nothing is stored, and nothing survives closing the tab.',
  },
  es: {
    mode: 'Comparar', byLines: 'Por líneas', byWords: 'Por palabras', byChars: 'Por letras',
    chars: ['carácter', 'caracteres'],
    countLines: 'Líneas', countChars: 'Caracteres',
    copy: 'Copiar', copied: 'Copiado', clearOne: 'Limpiar este cuadro',
    coarse: 'Hay demasiadas diferencias: se muestra de forma tosca, todo quitado y todo añadido. Ocurre cuando los dos textos apenas guardan relación; pruebe con fragmentos más pequeños.',
    n6: '<b>Por letras sirve para un cambio pequeño dentro de una palabra.</b> Una errata, una terminación, un dígito distinto en un número: por palabras solo se ve «esta palabra se sustituyó», por letras se ve qué cambió dentro. En textos largos esta vista lo desmenuza todo, por eso va la tercera y no la primera.',
    view: 'Mostrar', two: 'En dos columnas', one: 'En un solo flujo',
    ignoreCase: 'Ignorar mayúsculas y minúsculas', ignoreSpaces: 'Ignorar espacios de más',
    nameA: 'Antes', nameB: 'Después',
    placeA: 'Pega el texto original…', placeB: 'Pega el texto modificado…',
    empty: 'Pega los dos textos: las diferencias aparecen aquí al instante, sin pulsar ningún botón.',
    same: 'Los textos son idénticos.',
    sameButCase: 'Los textos coinciden, salvo por lo que has pedido ignorar.',
    removed: 'Quitado', added: 'Añadido', match: 'Coincidencia',
    lines: ['línea', 'líneas'], words: ['palabra', 'palabras'],
    swap: 'Intercambiar', clearAll: 'Limpiar todo',
    copyBig: 'Copiar las diferencias', copiedBig: '¡Copiado!',
    nothing: 'No hay diferencias', copyFail: 'El navegador no dejó copiar',
    n1: '<b>La comparación va sobre la marcha.</b> No hay botón de «buscar diferencias»: el algoritmo de Myers encuentra la cadena de cambios más corta en un tiempo proporcional al número de cambios, y despacha cuatro mil líneas en menos de un milisegundo.',
    n2: '<b>Por líneas y por palabras son trabajos distintos.</b> Por líneas se mira el código, las listas y la configuración: se ve qué línea se ha sustituido entera. Por palabras se miran artículos y contratos: se ve la palabra concreta que cambió dentro de un párrafo largo en lugar de «esta línea entera cambió».',
    n3: '<b>El resaltado va en el fondo y las letras siguen blancas.</b> Las letras de color sobre fondo oscuro se leen peor y cansan en un texto largo. Las partes que coinciden tampoco se apagan hasta el gris: a menudo uno lee el texto de alrededor y no solo los cambios.',
    n4: 'Los interruptores de <b>ignorar</b> quitan ruido. Los espacios sobrantes al final de las líneas y una diferencia de mayúsculas son el motivo más habitual de que una comparación marque diferencias donde una persona no ve ninguna.',
    n5: '<b>Los textos no salen de tu dispositivo.</b> Un contrato, una conversación privada o código ajeno se comparan dentro de tu navegador: no se envía nada a ningún servidor, no se guarda nada y no queda nada al cerrar la pestaña.',
  },
};
const с = СЛОВА[locale] || СЛОВА.ru;

const КОРЗИНА = `<svg viewBox="0 0 24 24" aria-hidden="true">
  <path d="M4 7h16"></path>
  <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
  <path d="M6.5 7l.9 12.6a1.5 1.5 0 0 0 1.5 1.4h6.2a1.5 1.5 0 0 0 1.5-1.4L17.5 7"></path>
  <path d="M10 11v6M14 11v6"></path>
</svg>`;
const ЛИСТ = `<svg class="лист" viewBox="0 0 24 24" aria-hidden="true">
  <rect x="9" y="9" width="11" height="12" rx="2"></rect>
  <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
</svg><svg class="галка" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5.5 5.5L20 7"></path></svg>`;
---

<style is:inline set:html={css}></style>

<div class="дф" data-words={JSON.stringify(с)}>
  <div class="дф-верх">
    <span class="дф-подпись">{с.mode}:</span>
    <div class="дф-кнопки" role="group">
      <button type="button" class="дф-выбор выбран" id="дф-строки">{с.byLines}</button>
      <button type="button" class="дф-выбор" id="дф-слова">{с.byWords}</button>
      <button type="button" class="дф-выбор" id="дф-буквы">{с.byChars}</button>
    </div>
    <span class="дф-подпись">{с.view}:</span>
    <div class="дф-кнопки" role="group">
      <button type="button" class="дф-выбор выбран" id="дф-две">{с.two}</button>
      <button type="button" class="дф-выбор" id="дф-одна">{с.one}</button>
    </div>
  </div>

  <div class="дф-верх">
    <label class="дф-галка"><input type="checkbox" id="дф-регистр"><i></i>{с.ignoreCase}</label>
    <label class="дф-галка"><input type="checkbox" id="дф-пробелы" checked><i></i>{с.ignoreSpaces}</label>
  </div>

  <div class="дф-пара">
    <div class="дф-поле">
      <span class="дф-имя">{с.nameA}</span>
      <textarea class="дф-ввод" id="дф-а" placeholder={с.placeA} spellcheck="false"></textarea>
      <div class="дф-полоса">
        <span class="дф-счёт" id="дф-счёт-а"></span>
        <button type="button" class="дф-значок" id="дф-корзина-а" disabled
                aria-label={с.clearOne} title={с.clearOne} set:html={КОРЗИНА}></button>
      </div>
    </div>
    <div class="дф-поле">
      <span class="дф-имя">{с.nameB}</span>
      <textarea class="дф-ввод" id="дф-б" placeholder={с.placeB} spellcheck="false"></textarea>
      <div class="дф-полоса">
        <span class="дф-счёт" id="дф-счёт-б"></span>
        <button type="button" class="дф-значок" id="дф-корзина-б" disabled
                aria-label={с.clearOne} title={с.clearOne} set:html={КОРЗИНА}></button>
      </div>
    </div>
  </div>

  <div class="дф-окно">
    <div class="дф-итог" id="дф-итог">
      <div class="дф-пусто">{с.empty}</div>
    </div>
    <div class="дф-полоса">
      <span class="дф-счётчики">
        <span class="убрано">{с.removed}: <b id="дф-убрано">0</b></span>
        <span class="добавлено">{с.added}: <b id="дф-добавлено">0</b></span>
        <span>{с.match}: <b id="дф-совпадение">—</b></span>
        <span class="дф-сказ" id="дф-сказ"></span>
      </span>
      <button type="button" class="дф-значок дф-копи" id="дф-копировать" disabled
              aria-label={с.copy} title={с.copy} set:html={ЛИСТ}></button>
    </div>
  </div>

  <div class="дф-низ">
    <button type="button" class="дф-простая" id="дф-поменять">{с.swap}</button>
    <button type="button" class="дф-простая" id="дф-очистить">{с.clearAll}</button>
  </div>

  <div class="дф-заметки">
    <div class="дф-заметка" set:html={с.n1}></div>
    <div class="дф-заметка" set:html={с.n2}></div>
    <div class="дф-заметка" set:html={с.n3}></div>
    <div class="дф-заметка" set:html={с.n4}></div>
    <div class="дф-заметка" set:html={с.n6}></div>
    <div class="дф-заметка" set:html={с.n5}></div>
  </div>
</div>

<script>
  import { сравнить as сличить, наСтроки, наСлова, наБуквы } from '../lib/diff.js';

  const корень = document.querySelector('.дф');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const $ = (и) => document.getElementById(и);
    const полеА = $('дф-а');
    const полеБ = $('дф-б');
    const итог = $('дф-итог');
    let режим = 'строки';   // 'строки' | 'слова' | 'буквы'
    const поСтрокам = () => режим === 'строки';

    // «1 строк» -- так по-русски не говорят. Формы: 1 строка, 2-4 строки, 5 строк, и снова
    // с одиннадцати по четырнадцать -- «строк». В английском и испанском форм всего две.
    function форма(число, формы) {
      if (формы.length === 2) return формы[число === 1 ? 0 : 1];
      const сотня = Math.abs(число) % 100;
      const десяток = сотня % 10;
      if (сотня >= 11 && сотня <= 14) return формы[2];
      if (десяток === 1) return формы[0];
      if (десяток >= 2 && десяток <= 4) return формы[1];
      return формы[2];
    }
    let двеКолонки = true;

    /* ---- Подготовка ---------------------------------------------------------------------- */

    const РЕЗКА = { строки: наСтроки, слова: наСлова, буквы: наБуквы };

    function сравнитель() {
      const регистр = $('дф-регистр').checked;
      const пробелы = $('дф-пробелы').checked;
      return (x, y) => {
        let а = x, б = y;
        if (пробелы) { а = а.replace(/\s+/g, ' ').trim(); б = б.replace(/\s+/g, ' ').trim(); }
        if (регистр) { а = а.toLowerCase(); б = б.toLowerCase(); }
        return а === б;
      };
    }

    /* ---- Показ ---------------------------------------------------------------------------- */

    const простой = (класс, текст) => {
      const э = document.createElement('span');
      if (класс) э.className = класс;
      э.textContent = текст;
      return э;
    };

    function строкаУзел(вид, текст) {
      const строка = document.createElement('div');
      строка.className = 'дф-строка' + (вид === 'равно' ? '' : ' ' + вид)
        + (текст === '' ? ' пустая' : '');
      const знак = document.createElement('span');
      знак.className = 'знак';
      знак.textContent = вид === 'удалено' ? '−' : (вид === 'добавлено' ? '+' : '');
      const тело = document.createElement('span');
      тело.className = 'тело';
      тело.textContent = текст;
      строка.append(знак, тело);
      return строка;
    }

    function шапка(текст) {
      const э = document.createElement('div');
      э.className = 'дф-шапка';
      э.textContent = текст;
      return э;
    }

    function показать(куски) {
      итог.replaceChildren();

      if (двеКолонки) {
        const обёртка = document.createElement('div');
        обёртка.className = 'дф-колонки';
        const левая = document.createElement('div');
        const правая = document.createElement('div');
        левая.className = 'дф-колонка';
        правая.className = 'дф-колонка';

        if (поСтрокам()) {
          // Строки идут парами: где правки нет -- одинаковые, где есть -- напротив пустая.
          for (const к of куски) {
            if (к.вид === 'равно') {
              левая.append(строкаУзел('равно', к.а));
              правая.append(строкаУзел('равно', к.б));
            } else if (к.вид === 'удалено') {
              левая.append(строкаУзел('удалено', к.а));
              правая.append(строкаУзел('равно', ''));
            } else {
              левая.append(строкаУзел('равно', ''));
              правая.append(строкаУзел('добавлено', к.б));
            }
          }
        } else {
          for (const к of куски) {
            if (к.вид === 'равно') {
              левая.append(простой('', к.а));
              правая.append(простой('', к.б));
            } else if (к.вид === 'удалено') {
              левая.append(простой('дф-убрано', к.а));
            } else {
              правая.append(простой('дф-добавлено', к.б));
            }
          }
        }
        обёртка.append(левая, правая);
        итог.append(шапка(`${с.nameA}   ·   ${с.nameB}`), обёртка);
        return;
      }

      // Один поток: убранное идёт сразу перед добавленным, как в истории правок.
      const поток = document.createElement('div');
      поток.className = поСтрокам() ? '' : 'дф-поток';
      if (поСтрокам()) {
        поток.style.padding = '6px 0';
        for (const к of куски) {
          поток.append(строкаУзел(к.вид, к.вид === 'добавлено' ? к.б : к.а));
        }
      } else {
        for (const к of куски) {
          if (к.вид === 'равно') поток.append(простой('', к.а));
          else if (к.вид === 'удалено') поток.append(простой('дф-убрано', к.а));
          else поток.append(простой('дф-добавлено', к.б));
        }
      }
      итог.append(поток);
    }

    function пусто(текст) {
      const э = document.createElement('div');
      э.className = 'дф-пусто';
      э.textContent = текст;
      итог.replaceChildren(э);
    }

    /* ---- Работа --------------------------------------------------------------------------- */

    let последние = null;
    let огрубили = false;

    /** Строк и знаков в каждом окне. Место под счёт отведено сразу -- макет не дёргается. */
    function пересчитатьОкна() {
      for (const [поле, счёт, корзина] of [[полеА, 'дф-счёт-а', 'дф-корзина-а'],
                                           [полеБ, 'дф-счёт-б', 'дф-корзина-б']]) {
        const текст = поле.value;
        $(счёт).textContent = текст
          ? `${с.countLines}: ${наСтроки(текст).length} · ${с.countChars}: ${[...текст].length}`
          : '';
        $(корзина).disabled = !текст;
      }
    }

    function сравнить() {
      const текстА = полеА.value;
      const текстБ = полеБ.value;
      пересчитатьОкна();

      if (!текстА && !текстБ) {
        последние = null;
        пусто(с.empty);
        $('дф-убрано').textContent = '0';
        $('дф-добавлено').textContent = '0';
        $('дф-совпадение').textContent = '—';
        $('дф-копировать').disabled = true;
        состояниеСказа();
        return;
      }

      const разрезать = РЕЗКА[режим];
      const итогСличения = сличить(разрезать(текстА), разрезать(текстБ), сравнитель());
      const куски = итогСличения.куски;
      огрубили = итогСличения.огрублено;
      последние = куски;

      // Пробелы между словами в счёт правок не идут: человек считает слова, а не отступы.
      const значимый = (к) => поСтрокам() || /\S/.test(к.вид === 'добавлено' ? к.б : к.а);
      const убрано = куски.filter((к) => к.вид === 'удалено' && значимый(к)).length;
      const добавлено = куски.filter((к) => к.вид === 'добавлено' && значимый(к)).length;
      const равно = куски.filter((к) => к.вид === 'равно' && значимый(к)).length;
      const всего = убрано + добавлено + равно;

      const формы = режим === 'строки' ? с.lines : (режим === 'слова' ? с.words : с.chars);
      $('дф-убрано').textContent = `${убрано} ${форма(убрано, формы)}`;
      $('дф-добавлено').textContent = `${добавлено} ${форма(добавлено, формы)}`;
      $('дф-совпадение').textContent = всего ? `${Math.round((равно / всего) * 100)}%` : '—';

      $('дф-копировать').disabled = !(убрано || добавлено);

      // Говорим об огрублении, а не выдаём грубое за точное. Надпись держится, пока держится
      // грубый ответ.
      состояниеСказа();

      if (!убрано && !добавлено) {
        const точно = текстА === текстБ;
        пусто(точно ? с.same : с.sameButCase);
        return;
      }
      показать(куски);
    }

    function поставитьРежим(новый) {
      режим = новый;
      $('дф-строки').classList.toggle('выбран', новый === 'строки');
      $('дф-слова').classList.toggle('выбран', новый === 'слова');
      $('дф-буквы').classList.toggle('выбран', новый === 'буквы');
      сравнить();
    }
    function поставитьВид(две) {
      двеКолонки = две;
      $('дф-две').classList.toggle('выбран', две);
      $('дф-одна').classList.toggle('выбран', !две);
      сравнить();
    }

    /* Предупреждение об огрублении -- НЕ всплывающая подсказка, а состояние: пока на экране
       грубый ответ, надпись обязана висеть. Иначе через несколько секунд человек смотрит на
       грубый разбор и считает его точным. Мигают тут только мимолётные сообщения -- про
       неудавшееся копирование, -- и после них надпись возвращается к состоянию. */
    function состояниеСказа() {
      const э = $('дф-сказ');
      э.textContent = огрубили ? с.coarse : '';
      э.classList.toggle('видно', огрубили);
    }

    function сказать(текст, сколько = 1800) {
      const э = $('дф-сказ');
      э.textContent = текст;
      э.classList.add('видно');
      clearTimeout(э._т);
      э._т = setTimeout(состояниеСказа, сколько);
    }

    for (const поле of [полеА, полеБ]) поле.addEventListener('input', сравнить);
    for (const и of ['дф-регистр', 'дф-пробелы']) $(и).addEventListener('change', сравнить);
    $('дф-строки').addEventListener('click', () => поставитьРежим('строки'));
    $('дф-слова').addEventListener('click', () => поставитьРежим('слова'));
    $('дф-буквы').addEventListener('click', () => поставитьРежим('буквы'));
    $('дф-две').addEventListener('click', () => поставитьВид(true));
    $('дф-одна').addEventListener('click', () => поставитьВид(false));

    for (const [поле, корзина] of [[полеА, 'дф-корзина-а'], [полеБ, 'дф-корзина-б']]) {
      $(корзина).addEventListener('click', () => { поле.value = ''; сравнить(); поле.focus(); });
    }

    $('дф-поменять').addEventListener('click', () => {
      const было = полеА.value;
      полеА.value = полеБ.value;
      полеБ.value = было;
      сравнить();
    });

    $('дф-очистить').addEventListener('click', () => {
      полеА.value = '';
      полеБ.value = '';
      сравнить();
      полеА.focus();
    });

    $('дф-копировать').addEventListener('click', async () => {
      const кнопка = $('дф-копировать');
      if (!последние || !последние.some((к) => к.вид !== 'равно')) { сказать(с.nothing); return; }
      // Копируем в привычном виде истории правок: минус и плюс в начале строки.
      const текст = поСтрокам()
        ? последние.map((к) => (к.вид === 'удалено' ? '- ' + к.а
            : к.вид === 'добавлено' ? '+ ' + к.б : '  ' + к.а)).join('\n')
        : последние.map((к) => (к.вид === 'удалено' ? `[-${к.а}]`
            : к.вид === 'добавлено' ? `{+${к.б}}` : к.а)).join('');
      let вышло = false;
      try { await navigator.clipboard.writeText(текст); вышло = true; }
      catch (ошибка) { вышло = false; }
      if (!вышло) { сказать(с.copyFail); return; }
      кнопка.classList.add('готово');
      кнопка.setAttribute('aria-label', с.copied);
      clearTimeout(кнопка._т);
      кнопка._т = setTimeout(() => {
        кнопка.classList.remove('готово');
        кнопка.setAttribute('aria-label', с.copy);
      }, 1500);
    });

    сравнить();

    window.__дфСостояние = () => ({
      режим, поСтрокам: поСтрокам(), двеКолонки, огрубили,
      счётА: $('дф-счёт-а').textContent, счётБ: $('дф-счёт-б').textContent,
      корзинаАЖива: !$('дф-корзина-а').disabled, корзинаБЖива: !$('дф-корзина-б').disabled,
      копиЖива: !$('дф-копировать').disabled,
      сказ: $('дф-сказ').textContent,
      убрано: $('дф-убрано').textContent, добавлено: $('дф-добавлено').textContent,
      совпадение: $('дф-совпадение').textContent,
      пусто: Boolean(итог.querySelector('.дф-пусто')),
      пустоТекст: (итог.querySelector('.дф-пусто') || {}).textContent || '',
      колонок: итог.querySelectorAll('.дф-колонка').length,
      убранных: итог.querySelectorAll('.дф-строка.удалено, .дф-убрано').length,
      добавленных: итог.querySelectorAll('.дф-строка.добавлено, .дф-добавлено').length,
    });
    window.__дфРазличия = (а, б) => сличить(а, б).куски;
    window.__дфВвод = (а, б, новый) => {
      const н = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, 'value').set;
      if (а !== undefined) н.call(полеА, а);
      if (б !== undefined) н.call(полеБ, б);
      if (новый) поставитьРежим(новый); else сравнить();
      return window.__дфСостояние();
    };
  })();
</script>
