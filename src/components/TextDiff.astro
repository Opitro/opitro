---
// СРАВНЕНИЕ ДВУХ ТЕКСТОВ.
//
// Алгоритм лежит в src/lib/diff.js -- он общий с страницей сравнения кода. Там же разобрано,
// почему без внешней библиотеки и зачем понадобился потолок числа правок.
//
// ЭТА страница -- для прозы: слова, буквы, регистр, лишние пробелы. Всё, что нужно только
// коду (номера строк, сворачивание одинаковых кусков, поиск невидимых причин расхождения,
// копирование патчем), живёт на /code-diff и сюда не тащится.
//
// Тексты никуда не уходят: всё делается в браузере.
import css from '../styles/text-diff.css?inline';

const { locale = 'ru' } = Astro.props;

const СЛОВА = {
  ru: {
    mode: 'Сравнивать', byLines: 'По строкам', byWords: 'По словам', byChars: 'По буквам',
