      '<b>Aquí trabaja un analizador de verdad, no un juego de sustituciones.</b> Para el marcado y los estilos escribimos el nuestro: allí el coste de un error se ve a simple vista. Para JavaScript eso no sirve: acortar nombres exige conocer el <b>ámbito</b> de cada variable. Sin un árbol no se distingue el nombre propio del ajeno, y renombrar rompe el código en silencio.',
      '<b>El analizador pesa 170 KB y se carga solo al pulsar el botón.</b> Hasta entonces la página se mantiene ligera. De ahí sale también la protección de sintaxis: ante un paréntesis sin cerrar la herramienta indica la línea y la columna en vez de estropear la salida.',
      '<b>El acortado de nombres solo toca los propios.</b> <code>window.algo</code>, <code>document.title</code> y todo lo que llega de fuera se queda igual; de lo contrario el código dejaría de encontrar lo que necesita. Solo se renombran variables y funciones dentro de su propio ámbito.',
      '<b>Cuándo el acortado de nombres estorba.</b> Si el código consulta el nombre de una función por su cuenta —mediante <code>fn.name</code>, <code>eval</code> o buscando un nombre como cadena—, el acortado lo desbaratará. Desmarque la casilla: el resultado pesa más, pero el comportamiento no cambia.',
    ],
  },
};

const с = ОБЩЕЕ[locale] || ОБЩЕЕ.ru;
const наладки = (НАЛАДКИ[kind][locale] || НАЛАДКИ[kind].ru);
const место = МЕСТО[kind][locale] || МЕСТО[kind].ru;
const заметки = ЗАМЕТКИ[kind][locale] || ЗАМЕТКИ[kind].ru;
---

<div class="мн" data-words={JSON.stringify(с)} data-kind={kind}>

  <!-- Ряд соседей. Не вкладки на месте, а ссылки: у каждого вида свой адрес и свой поиск.
       Нарочно НЕ <nav>: в общем макете сайта есть правило nav{...} для шапки, и оно бьёт по
       любому такому тегу -- растаскивает кнопки по краям, навешивает высоту 56px и рамку
       снизу. Править общее правило нельзя, оно на всех страницах, поэтому здесь обычный
       блок с указанием роли. -->
  <div class="мн-соседи" role="navigation" aria-label="HTML / CSS / JS">
    {Object.entries(ВИДЫ).map(([код, в]) => (
      код === kind
        ? <span class="мн-сосед мн-тут" aria-current="page">{в.имя}</span>
        : <a class="мн-сосед" href={`/${locale}/${в.slug}`}>{в.имя}</a>
    ))}
  </div>

  <div class="мн-галки">
    {/* Все наладки включены по умолчанию. В макете задания две из них сняты, но там же
        стоят и примеры вывода, которые без них не получаются: «margin: 0px» превращается
        в «margin:0» только при включённых нулях. Примеры вернее макета. */}
    {наладки.map(([код, имя]) => (
      <label class="мн-галка">
        <input type="checkbox" data-наладка={код} checked />
        <i></i>{имя}
      </label>
    ))}
  </div>

  <textarea class="мн-ввод" id="мн-ввод" spellcheck="false" autocomplete="off"
            autocapitalize="off" autocorrect="off" placeholder={место}></textarea>

  <div class="мн-ряд-пуска">
    <button type="button" class="мн-кнопка мн-пуск" id="мн-пуск">{с.run}</button>
  </div>

  <div class="мн-окно">
    <textarea class="мн-вывод" id="мн-вывод" readonly spellcheck="false"
              placeholder={с.empty}></textarea>
    <!-- Строка счётчиков стоит всегда: появись она после первого сжатия, кнопки внизу
         подпрыгнули бы. -->
    <div class="мн-счёт" id="мн-счёт">
      <span class="мн-беда" id="мн-беда" hidden></span>
      <span class="мн-числа" id="мн-числа"></span>
      <!-- Кнопки встроены в ту же полосу, где счётчики: место там уже было, а отдельный ряд
           под окном заставлял искать, к какому полю он относится. -->
      <span class="мн-знаки">
        <button type="button" class="мн-копи" id="мн-копировать" aria-label={с.copy}
                title={с.copy} disabled>
          <svg class="лист" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="9" y="9" width="11" height="12" rx="2"></rect>
            <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
          </svg>
          <svg class="галка" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5.5 5.5L20 7"></path></svg>
        </button>
        <button type="button" class="мн-корзина" id="мн-очистить" aria-label={с.clear} title={с.clear}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16"></path>
            <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
            <path d="M6.5 7l.9 12.6a1.5 1.5 0 0 0 1.5 1.4h6.2a1.5 1.5 0 0 0 1.5-1.4L17.5 7"></path>
            <path d="M10 11v6M14 11v6"></path>
          </svg>
        </button>
      </span>
    </div>
  </div>

  <div class="мн-заметки">
    {заметки.map((з) => <div class="мн-заметка" set:html={з}></div>)}
    <div class="мн-заметка">{с.privacy}</div>
  </div>
</div>

<style is:inline set:html={css}></style>

<script>
  const корень = document.querySelector('.мн');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const вид = корень.dataset.kind || 'html';
    const $ = (и) => document.getElementById(и);
    const вес = (т) => new TextEncoder().encode(т || '').length;

    const наладки = () => {
      const н = {};
      for (const г of корень.querySelectorAll('[data-наладка]')) н[г.dataset.наладка] = г.checked;
      return н;
    };

    const сказать = (текст) => {
      $('мн-беда').textContent = текст || '';
      $('мн-беда').hidden = !текст;
    };

    function числа(до, после) {
      if (!до) { $('мн-числа').textContent = ''; return; }
      const доля = до > 0 ? (1 - после / до) * 100 : 0;
      // Каждая частица -- свой узел, без голого текста между ними: строка выложена флексом,
      // и голый текст стал бы в ней отдельной безымянной частью с чужими отступами.
      $('мн-числа').innerHTML =
        `<span class="мн-имя">${с.before}</span><span>${до} ${с.bytes}</span>`
        + `<span class="мн-имя">${с.after}</span><span>${после} ${с.bytes}</span>`
        + `<span class="мн-имя">${с.saved}</span><b>${доля.toFixed(1)}%</b>`;
    }

    let работаю = false;
    async function сжать() {
      if (работаю) return;
      const исходник = $('мн-ввод').value;
      сказать('');
      if (!исходник.trim()) {
        $('мн-вывод').value = '';
        числа(0, 0);
        $('мн-копировать').disabled = true;
        return;
      }
      работаю = true;
      const кнопка = $('мн-пуск');
      const было = кнопка.textContent;
      кнопка.disabled = true;
      кнопка.textContent = вид === 'js' ? с.loading : с.working;

      try {
        const н = наладки();
        let итог = '', беда = null, строка = null, столбец = null;

        if (вид === 'css') {
          const { сжатьCSS } = await import('../lib/minify-css.js');
          const р = сжатьCSS(исходник, н);
          итог = р.код; беда = р.беда;
        } else if (вид === 'html') {
          const { сжатьHTML } = await import('../lib/minify-html.js');
          let жатьJS = null;
          if (н.встроенные) {
            const { сжатьJS } = await import('../lib/minify-js.js');
            жатьJS = async (к) => {
              const р = await сжатьJS(к, { имена: false, комментарии: н.комментарии });
              if (р.беда) throw new Error(р.беда);
              return р.код;
            };
          }
          const р = await сжатьHTML(исходник, { ...н, сжатьJS: жатьJS });
          итог = р.код; беда = р.беда;
        } else {
          const { сжатьJS } = await import('../lib/minify-js.js');
          const р = await сжатьJS(исходник, н);
          итог = р.код; беда = р.беда; строка = р.строка; столбец = р.столбец;
        }

        if (беда) {
          $('мн-вывод').value = '';
          числа(0, 0);
          $('мн-копировать').disabled = true;
          const где = строка !== null
            ? ` (${с.line} ${строка}${столбец !== null ? `, ${с.col} ${столбец}` : ''})`
            : '';
          сказать(`${с.err}: ${беда}${где}`);
        } else {
          $('мн-вывод').value = итог;
          числа(вес(исходник), вес(итог));
          $('мн-копировать').disabled = !итог;
        }
      } catch (е) {
        $('мн-вывод').value = '';
        числа(0, 0);
        $('мн-копировать').disabled = true;
        сказать(`${с.err}: ${е && е.message ? е.message : String(е)}`);
      } finally {
        кнопка.disabled = false;
        кнопка.textContent = было;
        работаю = false;
      }
    }

    $('мн-пуск').addEventListener('click', сжать);
    // Перещёлкнув галочку, человек ждёт нового ответа, а не старого.
    for (const г of корень.querySelectorAll('[data-наладка]')) {
      г.addEventListener('change', () => { if ($('мн-вывод').value || !$('мн-беда').hidden) сжать(); });
    }

    $('мн-копировать').addEventListener('click', async () => {
      const кнопка = $('мн-копировать');
      if (!$('мн-вывод').value) return;
      try { await navigator.clipboard.writeText($('мн-вывод').value); } catch (е) { return; }
      // Лист сменяется галочкой -- то же, что раньше говорила надпись «Скопировано».
      кнопка.classList.add('готово');
      кнопка.setAttribute('aria-label', с.copied);
      clearTimeout(кнопка._т);
      кнопка._т = setTimeout(() => {
        кнопка.classList.remove('готово');
        кнопка.setAttribute('aria-label', с.copy);
      }, 1500);
    });

    $('мн-очистить').addEventListener('click', () => {
      $('мн-ввод').value = '';
      $('мн-вывод').value = '';
      числа(0, 0);
      сказать('');
      $('мн-копировать').disabled = true;
      $('мн-ввод').focus();
    });

    window.__мнСостояние = () => ({
      вид,
      ввод: $('мн-ввод').value,
      вывод: $('мн-вывод').value,
      числа: $('мн-числа').textContent,
      беда: $('мн-беда').hidden ? '' : $('мн-беда').textContent,
      наладки: наладки(),
      копироватьЖива: !$('мн-копировать').disabled,
    });
    window.__мнСжать = async (текст, н) => {
      Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, 'value').set
        .call($('мн-ввод'), текст);
      if (н) for (const г of корень.querySelectorAll('[data-наладка]')) {
        if (г.dataset.наладка in н) г.checked = н[г.dataset.наладка];
      }
      await сжать();
      return window.__мнСостояние();
    };
  })();
</script>
