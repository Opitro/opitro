---
interface Unit {
  code: string;
  label: string;
  factor: number;
}

interface Props {
  units: Unit[];
  defaultFrom: string;
  defaultTo: string;
  swapLabel: string;
  valueLabel: string;
  resultLabel: string;
  fromLabel: string;
  toLabel: string;
}

const { units, defaultFrom, defaultTo, swapLabel, valueLabel, resultLabel, fromLabel, toLabel } = Astro.props;
---

<div class="uc-widget" data-units={JSON.stringify(units)}>
  <div class="uc-row">
    <div class="field">
      <input type="number" id="uc-input" value="1" step="any" inputmode="decimal" aria-label={valueLabel}>
      <select id="uc-from" aria-label={fromLabel}>
        <button type="button"><selectedcontent></selectedcontent></button>
        {units.map((u) => <option value={u.code} selected={u.code === defaultFrom}>{u.label}</option>)}
      </select>
    </div>
    <button class="uc-swap" id="uc-swap" type="button" aria-label={swapLabel} title={swapLabel}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5-5 5 5M7 14l5 5 5-5"/></svg>
    </button>
    <div class="field">
      <input type="text" id="uc-output" readonly aria-label={resultLabel}>
      <select id="uc-to" aria-label={toLabel}>
        <button type="button"><selectedcontent></selectedcontent></button>
        {units.map((u) => <option value={u.code} selected={u.code === defaultTo}>{u.label}</option>)}
      </select>
    </div>
  </div>
</div>

<style is:global>
  .uc-row{display:flex;align-items:center;gap:10px}
  .uc-row .field{flex:1;display:flex;flex-direction:column;gap:8px;margin-bottom:0}
  .uc-row input,.uc-row select{height:46px;border-radius:10px;background:var(--surface-2);border:1px solid var(--line);color:var(--text);font-family:inherit;font-size:15px;padding:0 12px;width:100%}
  .uc-row input#uc-output{color:var(--accent);font-weight:700}
  .uc-swap{flex:none;width:38px;height:38px;margin-top:26px;border-radius:10px;background:var(--surface-2);border:1px solid var(--line);color:var(--text);cursor:pointer;display:flex;align-items:center;justify-content:center}
  .uc-swap:hover{border-color:var(--accent)}
  .uc-swap svg{width:17px;height:17px}
  @media(max-width:480px){.uc-row{flex-direction:column;align-items:stretch}.uc-swap{align-self:center;margin-top:0;transform:rotate(90deg)}}

  @supports (appearance: base-select) {
    .uc-row select{appearance:base-select;cursor:pointer;display:flex;align-items:center}
    .uc-row select::picker(select){appearance:base-select;border:1px solid rgba(255,255,255,0.09);border-radius:12px;background:#1c1e24;box-shadow:0 12px 36px rgba(0,0,0,0.5);padding:6px;margin-top:6px;position-try-fallbacks:none}
    .uc-row select::picker-icon{color:var(--muted)}
    .uc-row option{padding:9px 12px;border-radius:8px;color:var(--text);background:transparent}
    .uc-row option:hover,.uc-row option:focus,.uc-row option:focus-visible{background:rgba(74,222,158,0.12) !important;color:var(--text) !important}
    .uc-row option:checked{color:var(--accent)}
    .uc-row select::checkmark{display:none}
  }
</style>

<script>
  import { convertMultiUnit, formatNumber } from '../lib/multi-unit-converter.js';

  const widget = document.querySelector('.uc-widget');
  const units = JSON.parse(widget.dataset.units);
  const factorByCode = Object.fromEntries(units.map((u) => [u.code, u.factor]));

  const input = document.getElementById('uc-input');
  const output = document.getElementById('uc-output');
  const fromSel = document.getElementById('uc-from');
  const toSel = document.getElementById('uc-to');
  const swapBtn = document.getElementById('uc-swap');

  function update() {
    const value = parseFloat(input.value) || 0;
    const result = convertMultiUnit(value, factorByCode[fromSel.value], factorByCode[toSel.value]);
    output.value = formatNumber(result);
  }

  input.addEventListener('input', () => {
    update();
    window.dispatchEvent(new Event('opitro:tool-interaction'));
  });
  fromSel.addEventListener('change', () => {
    update();
    window.dispatchEvent(new Event('opitro:tool-interaction'));
  });
  toSel.addEventListener('change', () => {
    update();
    window.dispatchEvent(new Event('opitro:tool-interaction'));
  });
  swapBtn.addEventListener('click', () => {
    const a = fromSel.value;
    fromSel.value = toSel.value;
    toSel.value = a;
    update();
    window.dispatchEvent(new Event('opitro:tool-interaction'));
  });

  update();
</script>
