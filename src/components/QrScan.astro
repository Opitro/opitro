  },
  es: {
    otherShort: "Barras",
    goOther: "Analizar este código",
    stop: "Apagar la cámara", other: "Escáner de códigos de barras",
    kindBar: "Código de barras", barHint: "Esto es un código de barras, no un código QR. El país, el dígito de control y el resto del análisis están en la página vecina.",
    mode: 'Origen', camera: 'Cámara', photo: "Archivo",
    camIdle: 'Pulse el icono de la cámara: el navegador pedirá permiso.',
    camDenied: 'La cámara no está disponible. No se dio permiso o no hay dispositivo. Puedes descifrar una imagen: cambia a «Archivo o captura».',
    camLooking: 'Apunta el código al marco…',
    drop: 'Arrastra una imagen aquí, elige un archivo o pega una captura con Ctrl+V',
    pick: 'Elegir archivo', again: 'Otro archivo',
    waiting: 'Aquí aparecerá lo que contiene el código',
    notFound: 'No se ha encontrado ningún código en la imagen. Prueba con una foto más grande y nítida.',
    kindUrl: 'Enlace', kindText: 'Texto', kindWifi: 'Red Wi-Fi', kindCard: 'Tarjeta',
    kindTel: 'Teléfono', kindMail: 'Correo',
    goesTo: 'El navegador irá a', copy: 'Copiar', copied: '¡Copiado!', open: 'Abrir el enlace',
    ssid: 'Nombre de la red', pass: 'Contraseña', prot: 'Seguridad', hidden: 'Oculta', yes: 'sí',
    name: 'Nombre', org: 'Organización', job: 'Puesto', phone: 'Teléfono', mail: 'Correo', site: 'Sitio',
    warnAt: '<b>Cuidado: la dirección engaña.</b> Todo lo que va antes de la «@» no es el sitio. El navegador irá a',
    warnPuny: '<b>Cuidado: el nombre del sitio usa caracteres especiales.</b> Así se imitan nombres conocidos: las letras se ven iguales pero el sitio es otro. El nombre real:',
    warnScheme: '<b>Cuidado: esquema de enlace poco habitual.</b> No ofrecemos seguir un enlace así:',
    noOpen: 'Solo se pueden abrir enlaces http y https normales.',
    n1: '<b>El escáner no abre nada por su cuenta.</b> Lo leído se muestra como texto y la decisión de seguirlo es tuya. Un código QR no se puede leer a simple vista, y sobre eso se montan estafas: una pegatina ajena encima de la auténtica en un parquímetro, en un bar, en una factura.',
    n2: '<b>Decimos adónde lleva realmente el enlace.</b> En <code>https://bank.example@evil.example</code> el navegador va a <code>evil.example</code>: todo lo anterior a la «@» no es el sitio.',
    n3: '<b>Los nombres con letras parecidas también se señalan.</b> Hay nombres escritos con caracteres idénticos a la vista a los latinos. El navegador los muestra en la forma técnica <code>xn--…</code> y nosotros avisamos.',
    n4: '<b>La contraseña del Wi-Fi se muestra correcta.</b> En la cadena de red los caracteres especiales van escapados con barra invertida; un escáner que no la quita muestra la contraseña con barras de más. Nosotros la quitamos.',
    n5: 'No se envía nada a ninguna parte. La imagen y el flujo de la cámara se descifran en el propio navegador.',
  },
};
const с = СЛОВА[locale] || СЛОВА.ru;
---

<style is:inline set:html={css}></style>

<div class="ск2" data-words={JSON.stringify(с)} data-locale={locale}>
  <div class="ск2-пульт">
    <span class="ск2-отступ">
      <span class="ск2-подпись">{с.mode}:</span>
      <span class="ск2-набор">
        <!-- Значок фотоаппарата САМ включает камеру: нажал на камеру -- получил камеру.
             Пока она работает, значок перечёркнут -- нажатие выключит. -->
        <button type="button" class="ск2-выбор ск2-глаз" data-р="camera"
                id="ск2-глаз" aria-label={с.camera} title={с.camera}>
          <svg class="идёт-нет" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 7.5h3.4L8.2 5h7.6l1.8 2.5H21a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V8.5a1 1 0 0 1 1-1Z"/>
            <circle cx="12" cy="13.3" r="3.5"/>
          </svg>
          <svg class="стоп" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 7.5h3.4L8.2 5h7.6l1.8 2.5H21a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V8.5a1 1 0 0 1 1-1Z"/>
            <circle cx="12" cy="13.3" r="3.5"/>
            <path d="M3.5 3.5l17 17"/>
          </svg>
        </button>
        <button type="button" class="ск2-выбор" data-р="photo">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M13.5 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5L13.5 3Z"/>
            <path d="M13.5 3v5.5H19"/>
          </svg>
          {с.photo}
        </button>
      </span>
    </span>
    <a class="ск2-сосед" href={`/${locale}/barcode-scan`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h2v14H3zM6.5 5h1v14h-1zM9 5h2v14H9zM12.5 5h1v14h-1zM15 5h2v14h-2zM18.5 5h1v14h-1zM21 5h1v14h-1z"/></svg>
      <span class="ск2-полно">{с.other}</span>
      <span class="ск2-кратко">{с.otherShort}</span>
    </a>
  </div>

  <div class="ск2-пара">
    <div>
      <div class="ск2-глазок" id="ск2-глазок">
        <video id="ск2-видео" playsinline muted></video>
        <canvas id="ск2-холст"></canvas>
        <div class="ск2-прицел"><i></i><i></i><i></i><i></i></div>
        <div class="ск2-заслон" id="ск2-заслон">
          <button type="button" class="ск2-крупный" id="ск2-крупный" aria-label={с.camera}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 7.5h3.4L8.2 5h7.6l1.8 2.5H21a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V8.5a1 1 0 0 1 1-1Z"/>
              <circle cx="12" cy="13.3" r="3.5"/>
            </svg>
          </button>
          <span id="ск2-слово">{с.camIdle}</span>
        </div>
      </div>

      <label class="ск2-зона" id="ск2-зона" hidden>
        <p id="ск2-подсказка">{с.drop}</p>
        <span class="ск2-взять" id="ск2-выбрать">{с.pick}</span>
        <input type="file" id="ск2-файл" accept="image/*" />
      </label>
    </div>

    <div class="ск2-итог" id="ск2-итог">
      <span class="ск2-ждём" id="ск2-ждём">{с.waiting}</span>
    </div>
  </div>

  <div class="ск2-ряд" id="ск2-ряд" hidden>
    <button type="button" class="ск2-кнопка" id="ск2-копировать">{с.copy}</button>
    <a class="ск2-обводка" id="ск2-перейти" target="_blank" rel="noopener noreferrer nofollow"
       style="display:none;line-height:44px;text-decoration:none">{с.open}</a>
  </div>

  <div class="ск2-заметки">
    <div class="ск2-заметка" set:html={с.n1}></div>
    <div class="ск2-заметка" set:html={с.n2}></div>
    <div class="ск2-заметка" set:html={с.n3}></div>
    <div class="ск2-заметка" set:html={с.n4}></div>
    <div class="ск2-заметка">{с.n5}</div>
  </div>
</div>

<script>
  import { разобратьСодержимое } from '../lib/qr-read.js';
  import { прочитатьКадр } from '../lib/code-read.js';

  const корень = document.querySelector('.ск2');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const $ = (и) => document.getElementById(и);
    const видео = $('ск2-видео');
    const холст = $('ск2-холст');
    const итог = $('ск2-итог');

    let режим = 'camera';
    let поток = null;
    let ищем = false;
    let найдено = '';

    /** Короткий тихий сигнал. Громкость намеренно мала: это подсказка, а не сирена. */
    function пикнуть() {
      try {
        const ак = new (window.AudioContext || window.webkitAudioContext)();
        const ген = ак.createOscillator();
        const гром = ак.createGain();
        ген.type = 'sine';
        ген.frequency.value = 1320;
        гром.gain.setValueAtTime(0.0001, ак.currentTime);
        гром.gain.exponentialRampToValueAtTime(0.08, ак.currentTime + 0.01);
        гром.gain.exponentialRampToValueAtTime(0.0001, ак.currentTime + 0.12);
        ген.connect(гром); гром.connect(ак.destination);
        ген.start(); ген.stop(ак.currentTime + 0.13);
        setTimeout(() => ак.close(), 400);
      } catch (е) { /* звук -- приятная мелочь, без него всё работает */ }
    }

    const узел = (тег, класс, текст) => {
      const э = document.createElement(тег);
      if (класс) э.className = класс;
      if (текст !== undefined) э.textContent = текст;
      return э;
    };

    function пары(список) {
      const дл = document.createElement('dl');
      дл.className = 'ск2-пары';
      for (const [имя, значение] of список) {
        if (!значение) continue;
        дл.append(узел('dt', '', имя), узел('dd', '', значение));
      }
      return дл;
    }

    function показать(находка) {
      // С камеры и из файла теперь приходят оба вида кодов. Полоски эта страница не
      // разбирает -- это работа соседней, -- но молчать о них нельзя: человек навёл камеру
      // и должен получить ответ, а не «не найдено».
      const текст = находка.текст;
      найдено = текст;
      if (находка.вид === 'штрих') { показатьШтрих(текст); return; }
      const разбор = разобратьСодержимое(текст);
      итог.replaceChildren();
      $('ск2-ряд').hidden = false;
      const переход = $('ск2-перейти');
      переход.style.display = 'none';

      const виды = { url: с.kindUrl, text: с.kindText, wifi: с.kindWifi,
        card: с.kindCard, tel: с.kindTel, mail: с.kindMail };
      итог.appendChild(узел('span', 'ск2-вид', виды[разбор.вид] || с.kindText));

      if (разбор.вид === 'url') {
        const л = разбор.ссылка;
        // Полный адрес -- текстом. Его можно прочитать и выделить ДО всякого перехода.
        итог.appendChild(узел('div', 'ск2-значение', разбор.текст));
        итог.appendChild(узел('div', 'ск2-узел', `${с.goesTo}: ${л.узел}`));
        for (const т of л.тревоги) {
          const э = узел('div', 'ск2-тревога');
          const слова = т.вид === 'punycode' ? с.warnPuny
            : т.вид === 'схема' ? с.warnScheme : с.warnAt;
          э.innerHTML = `${слова} <b>${т.что}</b>`;
          итог.appendChild(э);
        }
        if (л.переходить) {
          переход.href = л.адрес;
          переход.style.display = 'inline-block';
        } else {
          итог.appendChild(узел('div', 'ск2-ждём', с.noOpen));
        }
      } else if (разбор.вид === 'wifi') {
        итог.appendChild(пары([
          [с.ssid, разбор.сеть.имя],
          [с.pass, разбор.сеть.пароль],
          [с.prot, разбор.сеть.защита],
          [с.hidden, разбор.сеть.скрытая ? с.yes : ''],
        ]));
      } else if (разбор.вид === 'card') {
        const в = разбор.визитка;
        итог.appendChild(пары([
          [с.name, в.имя], [с.org, в.организация], [с.job, в.должность],
          [с.phone, в.телефон], [с.mail, в.почта], [с.site, в.сайт],
        ]));
      } else {
        итог.appendChild(узел('div', 'ск2-значение', разбор.текст));
      }
      пикнуть();
      $('ск2-глазок').classList.add('нашёл');
      setTimeout(() => $('ск2-глазок').classList.remove('нашёл'), 900);
    }

    /** Полоски: цифры и дорога на соседнюю страницу, где их разбирают полностью. */
    function показатьШтрих(цифры) {
      итог.replaceChildren();
      $('ск2-ряд').hidden = false;
      $('ск2-перейти').style.display = 'none';
      итог.appendChild(узел('span', 'ск2-вид', с.kindBar));
      итог.appendChild(узел('div', 'ск2-значение', цифры));
      итог.appendChild(узел('div', 'ск2-ждём', с.barHint));
      const ссылка = узел('a', 'ск2-обводка', с.goOther);
      ссылка.href = `/${корень.dataset.locale}/barcode-scan`;
      итог.appendChild(ссылка);
      пикнуть();
      $('ск2-глазок').classList.add('нашёл');
      setTimeout(() => $('ск2-глазок').classList.remove('нашёл'), 900);
    }

    function сказатьВИтог(текст) {
      итог.replaceChildren(узел('span', 'ск2-ждём', текст));
      $('ск2-ряд').hidden = true;
      найдено = '';
    }

    /** Один проход по картинке. Возвращает находку или null. */
    async function разобратьКадр(источник, ширина, высота, рисовать, снимок) {
      if (!ширина || !высота) return null;
      холст.width = ширина;
      холст.height = высота;
      const рис = холст.getContext('2d', { willReadFrequently: true });
      рисовать(рис);
      const точки = рис.getImageData(0, 0, ширина, высота);
      return прочитатьКадр({ источник, точки, нужно: 'оба', снимок });
    }

    async function круг() {
      if (!ищем || режим !== 'camera') return;
      if (видео.readyState >= 2) {
        try {
          const н = await разобратьКадр(видео, видео.videoWidth, видео.videoHeight,
            (рис) => рис.drawImage(видео, 0, 0), false);
          if (н && н.текст !== найдено) показать(н);
        } catch (е) { /* один неудачный кадр -- не беда, ждём следующий */ }
      }
      // Раз в четверть секунды: чаще незачем, а батарею телефона бережём.
      if (ищем) setTimeout(() => requestAnimationFrame(круг), 250);
    }

    async function включить() {
      if (поток) { выключить(); return; }
      try {
        поток = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: 'environment', width: { ideal: 1280 } }, audio: false,
        });
      } catch (е) {
        $('ск2-заслон').hidden = false;
        $('ск2-слово').textContent = с.camDenied;
        return;
      }
      видео.srcObject = поток;
      await видео.play().catch(() => {});
      $('ск2-заслон').hidden = true;
      значокКамеры(true);
      ищем = true;
      круг();
    }

    function выключить() {
      ищем = false;
      if (поток) { поток.getTracks().forEach((д) => д.stop()); поток = null; }
      видео.srcObject = null;
      $('ск2-заслон').hidden = false;
      $('ск2-слово').textContent = с.camIdle;
      значокКамеры(false);
    }

    /** Перечёркнутый фотоаппарат = «выключить». Подпись меняется вместе со значком:
        кнопка без букв должна называть себя хотя бы голосовому чтению. */
    function значокКамеры(идёт) {
      const к = $('ск2-глаз');
      к.classList.toggle('идёт', идёт);
      к.setAttribute('aria-label', идёт ? с.stop : с.camera);
      к.setAttribute('title', идёт ? с.stop : с.camera);
    }

    async function взятьКартинку(файл) {
      if (!файл) return;
      const адрес = URL.createObjectURL(файл);
      const карт = new Image();
      карт.onload = async () => {
        let н = null;
        try {
          н = await разобратьКадр(карт, карт.naturalWidth, карт.naturalHeight,
            (рис) => рис.drawImage(карт, 0, 0), true);
        } catch (е) { н = null; }
        // Показываем сам снимок: сразу видно, тот ли файл разбирали.
        // Поле файла надо забрать ДО замены содержимого: replaceChildren вынимает его
        // из страницы, и getElementById после этого возвращает пусто. Из-за этого «Выбрать
        // другой» падал с ошибкой, и второй файл выбрать было уже нельзя.
        const поле = $('ск2-файл');
        const ещё = узел('span', 'ск2-взять', с.again);
        ещё.addEventListener('click', (е) => { е.preventDefault(); поле.click(); });
        $('ск2-зона').replaceChildren(карт, ещё, поле);
        if (н) показать(н); else сказатьВИтог(с.notFound);
        URL.revokeObjectURL(адрес);
      };
      карт.onerror = () => { сказатьВИтог(с.notFound); URL.revokeObjectURL(адрес); };
      карт.src = адрес;
    }

    function выбратьРежим(новый) {
      режим = новый;
      корень.querySelector('.ск2-выбор[data-р="photo"]')
        .classList.toggle('выбран', новый === 'photo');
      const камера = новый === 'camera';
      $('ск2-глазок').hidden = !камера;
      $('ск2-зона').hidden = камера;
      if (!камера) выключить();
    }

    // Нажатие на фотоаппарат: из режима снимка -- переключиться и сразу включить камеру;
    // в режиме камеры -- включить или выключить её.
    $('ск2-крупный').addEventListener('click', () => {
      if (режим !== 'camera') выбратьРежим('camera');
      включить();
    });

    $('ск2-глаз').addEventListener('click', () => {
      if (режим !== 'camera') { выбратьРежим('camera'); включить(); return; }
      if (поток) выключить(); else включить();
    });
    корень.querySelector('.ск2-выбор[data-р="photo"]')
      .addEventListener('click', () => выбратьРежим('photo'));
    $('ск2-файл').addEventListener('change', (е) => взятьКартинку(е.target.files && е.target.files[0]));
    $('ск2-выбрать').addEventListener('click', (е) => { е.preventDefault(); $('ск2-файл').click(); });

    for (const событие of ['dragenter', 'dragover']) {
      $('ск2-зона').addEventListener(событие, (е) => { е.preventDefault(); $('ск2-зона').classList.add('держат'); });
    }
    $('ск2-зона').addEventListener('dragleave', () => $('ск2-зона').classList.remove('держат'));
    $('ск2-зона').addEventListener('drop', (е) => {
      е.preventDefault();
      $('ск2-зона').classList.remove('держат');
      взятьКартинку(е.dataTransfer && е.dataTransfer.files && е.dataTransfer.files[0]);
    });

    // Вставка снимка из буфера: самый частый способ на компьютере -- сделать снимок экрана
    // и нажать Ctrl+V, не сохраняя файл.
    document.addEventListener('paste', (е) => {
      const вещи = е.clipboardData && е.clipboardData.items;
      if (!вещи) return;
      for (const в of вещи) {
        if (в.type && в.type.startsWith('image/')) {
          const файл = в.getAsFile();
          if (файл) {
            // Переключаемся на снимок сами: человек уже показал, чего хочет.
            корень.querySelector('.ск2-выбор[data-р="photo"]').click();
            взятьКартинку(файл);
          }
          break;
        }
      }
    });

    $('ск2-копировать').addEventListener('click', async () => {
      const кнопка = $('ск2-копировать');
      if (!найдено) return;
      try { await navigator.clipboard.writeText(найдено); }
      catch (е) { return; }
      кнопка.textContent = с.copied;
      clearTimeout(кнопка._т);
      кнопка._т = setTimeout(() => { кнопка.textContent = с.copy; }, 1500);
    });

    window.addEventListener('pagehide', выключить);

    window.__ск2Состояние = () => ({
      режим,
      найдено,
      итог: итог.textContent.trim(),
      тревог: итог.querySelectorAll('.ск2-тревога').length,
      узел: (итог.querySelector('.ск2-узел') || {}).textContent || '',
      переходВиден: $('ск2-перейти').style.display !== 'none',
      кнопкиВидны: !$('ск2-ряд').hidden,
    });
    window.__ск2Показать = показать;
  })();
</script>
