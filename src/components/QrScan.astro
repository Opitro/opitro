  en: {
    mode: 'Source', camera: 'Camera', photo: 'File or screenshot',
    start: 'Turn the camera on', stop: 'Turn off',
    camIdle: 'The camera is off. Press the button — the browser will ask for permission.',
    camDenied: 'The camera is not available. Permission was refused or there is no device. You can still decode a picture: switch to “File or screenshot”.',
