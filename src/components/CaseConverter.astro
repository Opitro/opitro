---
// ПЕРЕВОД СТИЛЕЙ ИМЕНОВАНИЯ: camelCase, PascalCase, snake_case, kebab-case, UPPER_CASE.
//
// ВСЯ РАБОТА -- В РАЗБИЕНИИ НА СЛОВА, и наивное правило «заглавная начинает слово» ломается
// на трёх местах, каждое из которых встречается в живом коде:
//   1. Аббревиатуры: parseHTTPResponse -- это parse + HTTP + Response.
//   2. Цифры: user2Name -- это user2 + Name, цифра прилипает к слову слева.
//   3. Подчёркивания по краям: __init__ в Python -- не то же самое, что init.
//
// Одно имя в строке: разбирать целые строки кода мы не беремся -- ключевые слова и строковые
// значения при этом портятся, а молча испортить чужой код хуже, чем не тронуть его.
//
// Ничего никуда не уходит: всё делается в браузере.
import css from '../styles/case-converter.css?inline';

const { locale = 'ru' } = Astro.props;

const СЛОВА = {
  ru: {
    target: 'Во что перевести',
    place: 'Вставьте список имён — по одному в строке…', result: 'Результат появится здесь…',
