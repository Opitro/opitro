---
interface Unit {
  code: string;
  label: string;
  scale: number;
  offset: number;
}

interface Props {
  units: Unit[];
  defaultFrom: string;
  defaultTo: string;
  swapLabel: string;
  valueLabel: string;
  resultLabel: string;
  fromLabel: string;
  toLabel: string;
}

const { units, defaultFrom, defaultTo, swapLabel, valueLabel, resultLabel, fromLabel, toLabel } = Astro.props;
---

<div class="uc-widget" data-units={JSON.stringify(units)}>
  <div class="uc-row">
    <div class="field">
      <input type="number" id="uc-input" value="20" step="any" inputmode="decimal" aria-label={valueLabel}>
      <select id="uc-from" aria-label={fromLabel}>
        <button type="button"><selectedcontent></selectedcontent></button>
        {units.map((u) => <option value={u.code} selected={u.code === defaultFrom}>{u.label}</option>)}
      </select>
    </div>
    <button class="uc-swap" id="uc-swap" type="button" aria-label={swapLabel} title={swapLabel}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 10l5-5 5 5M7 14l5 5 5-5"/></svg>
    </button>
    <div class="field">
      <input type="text" id="uc-output" readonly aria-label={resultLabel}>
      <select id="uc-to" aria-label={toLabel}>
        <button type="button"><selectedcontent></selectedcontent></button>
        {units.map((u) => <option value={u.code} selected={u.code === defaultTo}>{u.label}</option>)}
      </select>
    </div>
  </div>
</div>

<script>
  import { convertTemperature, formatNumber } from '../lib/temperature-multi.js';

  const widget = document.querySelector('.uc-widget');
  const units = JSON.parse(widget.dataset.units);
  const unitByCode = Object.fromEntries(units.map((u) => [u.code, u]));

  const input = document.getElementById('uc-input');
  const output = document.getElementById('uc-output');
  const fromSel = document.getElementById('uc-from');
  const toSel = document.getElementById('uc-to');
  const swapBtn = document.getElementById('uc-swap');

  function update() {
    const value = parseFloat(input.value) || 0;
    const from = unitByCode[fromSel.value];
    const to = unitByCode[toSel.value];
    const result = convertTemperature(value, from.scale, from.offset, to.scale, to.offset);
    output.value = formatNumber(result);
  }

  input.addEventListener('input', () => {
    update();
    window.dispatchEvent(new Event('opitro:tool-interaction'));
  });
  fromSel.addEventListener('change', () => {
    update();
    window.dispatchEvent(new Event('opitro:tool-interaction'));
  });
  toSel.addEventListener('change', () => {
    update();
    window.dispatchEvent(new Event('opitro:tool-interaction'));
  });
  swapBtn.addEventListener('click', () => {
    const a = fromSel.value;
    fromSel.value = toSel.value;
    toSel.value = a;
    update();
    window.dispatchEvent(new Event('opitro:tool-interaction'));
  });

  update();
</script>
