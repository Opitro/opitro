---

<style is:inline set:html={css}></style>

<div class="tp" data-words={JSON.stringify(с)} data-locale={locale} data-stock={JSON.stringify(запас)}
     data-cpm={знакиГлавное ? '1' : ''}>
  {/* Настройки отдельно от чисел. Раньше уровень, время и живой счёт стояли в одной строке, и
      было не разобрать, где то, что ты выбираешь, а где то, что тебе показывают. Теперь наверху
      только выбор, а счёт живёт внутри поля -- там, куда и так смотрят. */}
  <div class="tp-bar">
    {/* Уровень. Связный текст набирают быстрее всего -- смысл подсказывает следующее слово,
        поэтому слова без связи стоят не в начале ряда, а в конце, как самое трудное. */}
    <div class="tp-set" id="tp-set-kind">
      <span class="tp-set-k">{с.setLevel}</span>
      <div class="tp-keys" id="tp-kind" role="group" aria-label={с.setLevel}>
        <button type="button" class="tp-key on" data-kind="easy">{с.lvEasy}</button>
        <button type="button" class="tp-key" data-kind="medium">{с.lvMid}</button>
        <button type="button" class="tp-key" data-kind="hard">{с.lvHard}</button>
      </div>
    </div>
    <div class="tp-set" id="tp-set-time">
      <span class="tp-set-k">{с.setTime}</span>
      <div class="tp-keys" id="tp-modes" role="group" aria-label={с.setTime}>
        <button type="button" class="tp-key" data-sec="30">30 {с.sec}</button>
        <button type="button" class="tp-key on" data-sec="60">60 {с.sec}</button>
        <button type="button" class="tp-key" data-sec="120">120 {с.sec}</button>
      </div>
    </div>
    <button type="button" class="tp-own" id="tp-own" aria-expanded="false">{с.own}</button>
  </div>

  {/* Свой текст. Панель раскрывается по нажатию и ничего не двигает, пока её не открыли. */}
  <div class="tp-panel" id="tp-panel" hidden>
    <label class="tp-panel-k" for="tp-paste">{с.ownTitle}</label>
    <textarea id="tp-paste" class="tp-paste" rows="4" placeholder={с.ownPlace}
              spellcheck="false"></textarea>
    <div class="tp-panel-under">
      <span class="tp-panel-note" id="tp-count">0 {с.ownChars}</span>
      <span class="tp-panel-note tp-panel-priv">{с.ownPrivacy}</span>
      <button type="button" class="tp-cancel" id="tp-drop">{с.ownCancel}</button>
      <button type="button" class="tp-go" id="tp-take">{с.ownGo}</button>
    </div>
  </div>

  {/* Слова видны с самого начала и ничем не закрыты: человек должен видеть, что печатать,
      прежде чем решит начать. Накладка появляется только когда поле теряет фокус. */}
  <div class="tp-field ждёт" id="tp-field">
    {/* Полоса времени по верхнему краю: она уходит, и это видно краем глаза, не отрывая
        взгляда от слов. В последние секунды меняет цвет -- это и есть весь азарт. */}
    <div class="tp-time" aria-hidden="true"><i id="tp-time-fill"></i></div>

    <div class="tp-scores">
      <span class="s time"><b id="tp-left">60</b><i id="tp-left-k">{с.time}</i></span>
      <span class="s"><b id="tp-wpm">0</b><i>{знакиГлавное ? с.cpmShort : с.wpmShort}</i></span>
      <span class="s"><b id="tp-acc">100%</b><i>{с.acc}</i></span>
      {/* Рекорд стоит всегда, даже пустой: если бы ячейка появлялась после первого захода,
          строка бы каждый раз прыгала. */}
      <span class="s rec"><b id="tp-rec">—</b><i>{с.rec}</i></span>
    </div>

    <div class="tp-view" id="tp-viewport">
      <div class="tp-lines" id="tp-text"></div>
      <div class="tp-caret" id="tp-caret"></div>
    </div>
    <textarea class="tp-input" id="tp-input" autocomplete="off" autocorrect="off"
              autocapitalize="off" spellcheck="false" aria-label={с.speed}></textarea>
    <div class="tp-blur" id="tp-blur">{с.focus}</div>

    {/* Итог занимает место текста: набор кончился -- слова больше не нужны, нужен ответ. */}
    <div class="tp-result" id="tp-result">
      <div class="tp-res-row">
        <div class="tp-res-main">
          <span class="tp-rank" id="tp-rank"></span>
          <span class="v" id="tp-res-wpm">0</span>
          <span class="k">{знакиГлавное ? с.cpmSub : с.wpmSub}</span>
        </div>
        <div class="tp-res-sub">
          <div><span class="v" id="tp-res-alt">0</span><span class="k">{знакиГлавное ? с.wpmShort : с.cpmShort}</span></div>
          <div><span class="v" id="tp-res-acc">100%</span><span class="k">{с.acc}</span></div>
          <div><span class="v" id="tp-res-err">0</span><span class="k">{с.errors}</span></div>
        </div>
      </div>

      {/* Лестница разрядов. Показывает не только «сколько», но и «где это среди людей» --
          ради этого сюда и приходят. Отметка стоит на вашем результате. */}
      <div class="tp-scale" id="tp-scale">
        <div class="tp-scale-line"><i class="tp-scale-you" id="tp-you"></i></div>
        <div class="tp-scale-steps">
          {с.ranks.map((имя, i) => <span class="tp-step" data-i={i}>{имя}</span>)}
        </div>
      </div>

      {/* Слово о том, как прошло именно у вас: сравнение с прошлой попыткой, а не общая
          похвала. Пустых «отлично!» тут нет -- каждая строка проверяема. */}
      <div class="tp-praise" id="tp-praise"></div>

      <div class="tp-verdict" id="tp-verdict"></div>

      {/* Последние десять попыток, от лучшей к худшей. Всё в этом браузере: никуда не уходит,
          ни с кем не сравнивается. Появляется только в итоге, поэтому ничего не сдвигает. */}
      <div class="tp-log" id="tp-log" hidden>
        <div class="tp-log-top">
          <span class="tp-log-k" id="tp-log-title"></span>
          <button type="button" class="tp-log-clear" id="tp-log-clear"></button>
        </div>
        <ol class="tp-log-list" id="tp-log-list"></ol>
        <div class="tp-log-note" id="tp-log-note"></div>
      </div>
    </div>
  </div>

  <div class="tp-under">
    <span class="tp-hint" id="tp-hint">{с.ready}</span>
    <button type="button" class="tp-again" id="tp-again">{с.restart}</button>
  </div>

  <div class="tp-notes">
    <div class="tp-note">{с.n1}</div>
    <div class="tp-note">{с.n2}</div>
    <div class="tp-note">{с.n3}</div>
    <div class="tp-note">{с.n4}</div>
  </div>
</div>

<script>
  const корень = document.querySelector('.tp');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const язык = корень.dataset.locale || 'ru';
    const знакиГлавное = корень.dataset.cpm === '1';
    // Материал собирается заново на каждую попытку -- см. lib/typing-words.js.
    let слова = [];
    let уровень = 'easy';
    let собрать = null;   // приедет вместе с модулем слов
    let свой = null;      // слова своего текста, если человек его вставил
    const поле = document.getElementById('tp-field');
    const окно = document.getElementById('tp-viewport');
    const текст = document.getElementById('tp-text');
    const ввод = document.getElementById('tp-input');
    const курсор = document.getElementById('tp-caret');
    const подсказка = document.getElementById('tp-hint');
    const полеОсталось = document.getElementById('tp-left');
    const подписьВремени = document.getElementById('tp-left-k');
    const полеСкорость = document.getElementById('tp-wpm');
    const полеТочность = document.getElementById('tp-acc');
    const полеРекорд = document.getElementById('tp-rec');
    const полоса = document.getElementById('tp-time-fill');
    const итогСкорость = document.getElementById('tp-res-wpm');
    const итогВторая = document.getElementById('tp-res-alt');
    const итогТочность = document.getElementById('tp-res-acc');
    const итогОшибки = document.getElementById('tp-res-err');
    const итогСлова = document.getElementById('tp-verdict');
    const итогРазряд = document.getElementById('tp-rank');
    const полеПохвалы = document.getElementById('tp-praise');
    const блокЖурнала = document.getElementById('tp-log');
    const списокЖурнала = document.getElementById('tp-log-list');
    const отметка = document.getElementById('tp-you');
    const ступени = [...document.querySelectorAll('.tp-step')];
    const кнопкаЗаново = document.getElementById('tp-again');
    const рядРежимов = document.getElementById('tp-modes');
    const рядВида = document.getElementById('tp-kind');
    const кнопкаСвой = document.getElementById('tp-own');
    const панель = document.getElementById('tp-panel');
    const вставка = document.getElementById('tp-paste');
    const счётЗнаков = document.getElementById('tp-count');

    let длительность = 60;
    let начало = 0, таймер = 0, идёт = false, кончено = false;
    let верныхВсего = 0, неверныхВсего = 0;

    // РАЗРЯДЫ. Границы в словах в минуту -- мера международная, по ней разряд один и тот же
    // на всех языках. Знаки получаются умножением на пять: 30 слов это 150 знаков.
    const ГРАНИЦЫ = [30, 50, 70, 90];
    const разряд = (сл) => ГРАНИЦЫ.filter((г) => сл >= г).length;
    // Место отметки на ленте: каждый разряд занимает свою пятую часть, внутри -- пропорция.
    // Так лента остаётся ровной, а отметка честной.
    function местоНаЛенте(сл) {
      const края = [0, ...ГРАНИЦЫ, 130];
      const i = разряд(сл);
      const доля = Math.min(1, Math.max(0, (сл - края[i]) / (края[i + 1] - края[i])));
      return Math.min(99, (i + доля) * 20);
    }

    // ПРОЗВИЩЕ. Две оси: зверь растёт со скоростью, определение говорит о манере. Человек с
    // одной и той же скоростью, но разной точностью получает разные прозвища -- и это честно:
    // манера у них правда разная.
    const мера = (точность) => (точность < 93 ? 0 : (точность < 98 ? 1 : 2));
    const прозвище = (разр, точность) => с.names[разр][мера(точность)];

    // ПОХВАЛА. Только проверяемые утверждения: сравнение с прошлой попыткой и совет по делу.
    // Пустое «отлично!» после 90 знаков с 70 % точности человек не купит, и правильно сделает.
    function похвала(главное, точность, разр, прошлая) {
      const части = [];
      if (!прошлая) части.push(с.pFirst);
      else {
        const д = главное - прошлая.главное;
        const т = точность - прошлая.точность;
        if (д > 0) части.push(с.pFaster.replace('{n}', д));
        else if (д === 0) части.push(с.pSame);
        else if (т > 0) части.push(с.pSlowerAcc.replace('{n}', -д).replace('{m}', т));
        else части.push(с.pSlower.replace('{n}', -д));
        if (точность === 100) части.push(с.pClean);
        else if (т > 0 && д >= 0) части.push(с.pAccUp.replace('{m}', т));
      }
      части.push(точность < 93 ? с.pTipAcc : (разр < 2 ? с.pTipKeep : с.pTipGood));
      return части.join(' ');
    }

    // ЖУРНАЛ. Последние десять попыток, только в этом браузере: никуда не уходит и ни с кем
    // не сравнивается. Свой текст сюда не пишется -- в нём свои знаки, сравнение было бы кривым.
    const ключЖурнала = 'opitro-tp-log-' + язык;
    function взятьЖурнал() {
      try { const j = JSON.parse(localStorage.getItem(ключЖурнала) || '[]'); return Array.isArray(j) ? j : []; }
      catch { return []; }
    }
    function записатьВЖурнал(запись) {
      const ж = взятьЖурнал();
      ж.unshift(запись);
      try { localStorage.setItem(ключЖурнала, JSON.stringify(ж.slice(0, 10))); } catch {}
    }
    // «5 минут назад» на языке страницы -- Intl умеет это сам, свои таблицы склонений не нужны.
    const когдаТо = (() => {
      try { return new Intl.RelativeTimeFormat(язык, { numeric: 'auto' }); } catch { return null; }
    })();
    function давноЛи(когда) {
      const сек = Math.round((Date.now() - когда) / 1000);
      if (!когдаТо || сек < 60) return с.logNow;
      if (сек < 3600) return когдаТо.format(-Math.round(сек / 60), 'minute');
      if (сек < 86400) return когдаТо.format(-Math.round(сек / 3600), 'hour');
      return когдаТо.format(-Math.round(сек / 86400), 'day');
    }
    function показатьЖурнал() {
      const ж = взятьЖурнал();
      блокЖурнала.hidden = !ж.length;
      if (!ж.length) return;
      const лучшие = [...ж].sort((a, b) => b.главное - a.главное);
      const куски = document.createDocumentFragment();
      for (const з2 of лучшие) {
        const строка = document.createElement('li');
        строка.className = 'tp-log-row' + (з2.свежая ? ' эта' : '');
        строка.innerHTML =
          '<span class="ч"></span><span class="п"></span><span class="д"></span><span class="к"></span>';
        строка.querySelector('.ч').textContent = з2.главное;
        строка.querySelector('.п').textContent = з2.прозвище;
        строка.querySelector('.д').textContent = з2.точность + '% · ' + з2.уровень + ' · ' + з2.секунд + ' ' + с.sec;
        строка.querySelector('.к').textContent = давноЛи(з2.когда);
        куски.appendChild(строка);
      }
      списокЖурнала.replaceChildren(куски);
    }

    // ЛИЧНЫЙ РЕКОРД. Свой на каждое сочетание «уровень + время»: сравнивать минуту лёгкого
    // текста с половиной минуты сложного было бы бессмысленно. Лежит только в этом браузере.
    const ключРекорда = () => 'opitro-tp-' + язык + '-' + уровень + '-' + длительность;
    function взятьРекорд() {
      try { return Number(localStorage.getItem(ключРекорда())) || 0; } catch { return 0; }
    }
    function показатьРекорд() {
      const р = свой ? 0 : взятьРекорд();
      полеРекорд.textContent = р ? String(р) : '—';
    }

    // Рисуем слова буквами: каждая буква своим узлом, иначе не показать, где именно ошибка.
    // Делается один раз на попытку -- перерисовывать тысячу узлов на каждое нажатие значило бы
    // тормозить под пальцами.
    const узлыСлов = [];
    function нарисовать() {
      const куски = document.createDocumentFragment();
      узлыСлов.length = 0;
      for (const слово of слова) {
        const у = document.createElement('span');
        у.className = 'tp-word';
        for (const б of слово) {
          const с2 = document.createElement('span');
          с2.className = 'tp-ch';
          с2.textContent = б;
          у.appendChild(с2);
        }
        куски.appendChild(у);
        узлыСлов.push(у);
      }
      текст.replaceChildren(куски);
    }

    // Курсор ставим перед той буквой, которую предстоит набрать. По нему глаз держит место в
    // строке -- вернее, чем по подсветке слова.
    function поставитьКурсор() {
      const набрано = ввод.value.split(' ');
      const i = Math.min(набрано.length - 1, узлыСлов.length - 1);
      const узел = узлыСлов[i];
      if (!узел) return;
      const буквы = узел.children;
      const j = (набрано[i] || '').length;
      const цель = буквы[Math.min(j, буквы.length - 1)];
      if (!цель) return;
      const рб = цель.getBoundingClientRect();
      const ро = окно.getBoundingClientRect();
      const справа = j >= буквы.length;      // слово добрано -- курсор за последней буквой
      курсор.style.left = (рб.left - ро.left + (справа ? рб.width : 0)) + 'px';
      курсор.style.top = (рб.top - ро.top) + 'px';
      курсор.style.height = рб.height + 'px';
    }

    // Текст едет вверх, чтобы строка с курсором стояла второй. Считаем по положению слова,
    // а не по числу набранных: слова разной длины, строки получаются неодинаковыми.
    let верхПрошлый = -1;
    function подвинуть(узел) {
      if (!узел) return;
      const строка = узел.offsetTop;
      if (строка === верхПрошлый) return;
      верхПрошлый = строка;
      текст.style.transform = 'translateY(' + (-Math.max(0, строка - узел.offsetHeight)) + 'px)';
    }

    function разобрать() {
      const набрано = ввод.value.split(' ');
      let верных = 0, неверных = 0;
      for (let i = 0; i < узлыСлов.length; i++) {
        const узел = узлыСлов[i];
        const образец = слова[i];
        const было = набрано[i];
        if (i === набрано.length - 1) подвинуть(узел);
        [...узел.querySelectorAll('.tp-ch.extra')].forEach((э) => э.remove());
        const буквы = узел.children;
        if (было == null) {
          for (const б of буквы) б.className = 'tp-ch';
          continue;
        }
        for (let j = 0; j < буквы.length; j++) {
          const набран = было[j];
          if (набран == null) { буквы[j].className = 'tp-ch'; continue; }
          const верно = набран === образец[j];
          буквы[j].className = 'tp-ch ' + (верно ? 'ok' : 'bad');
          if (верно) верных++; else неверных++;
        }
        if (было.length > образец.length) {
          for (let j = образец.length; j < было.length; j++) {
            const л = document.createElement('span');
            л.className = 'tp-ch extra';
            л.textContent = было[j];
            узел.appendChild(л);
            неверных++;
          }
        }
        if (i < набрано.length - 1) верных++;   // пробел между словами тоже знак
      }
      верныхВсего = верных; неверныхВсего = неверных;
      const всего = верных + неверных;
      полеТочность.textContent = (всего ? Math.round((верных / всего) * 100) : 100) + '%';
      // Первые три секунды скорость не показываем: на одной секунде выходит бессмыслица.
      const секунд = идёт ? (Date.now() - начало) / 1000 : 0;
      полеСкорость.textContent = (идёт && секунд >= 3)
        ? String(Math.round((верных / (знакиГлавное ? 1 : 5)) / (секунд / 60))) : '0';
      // Свой текст кончается сам, поэтому полоса показывает не время, а сколько осталось слов.
      if (свой) полоса.style.transform = 'scaleX(' + (1 - Math.min(1, (набрано.length - 1) / слова.length)) + ')';
      поставитьКурсор();
      if (набрано.length >= слова.length) закончить();
    }

    function тик() {
      const прошло = (Date.now() - начало) / 1000;
      if (свой) {
        полеОсталось.textContent = String(Math.floor(прошло));
        разобрать();
        return;
      }
      const осталось = Math.max(0, Math.ceil(длительность - прошло));
      полеОсталось.textContent = String(осталось);
      полоса.style.transform = 'scaleX(' + Math.max(0, 1 - прошло / длительность) + ')';
      корень.classList.toggle('мало', осталось <= 10 && осталось > 5);
      корень.classList.toggle('совсем-мало', осталось <= 5);
      if (осталось <= 0) { закончить(); return; }
      разобрать();
    }
    function начать() {
      if (идёт || кончено) return;
      идёт = true;
      корень.classList.add('идёт');
      поле.classList.remove('ждёт');
      подсказка.textContent = с.typing;
      начало = Date.now();
      таймер = window.setInterval(тик, 200);
    }
    function оценка(разр, точность) {
      const части = [[с.vSlow], [с.vMid], [с.vFast], [с.vPro], [с.vPro]][разр].slice();
      if (точность < 95) части.push(с.vAcc);
      if (свой) части.push(с.ownNote);
      return части.join(' ');
    }
    function закончить() {
      if (!идёт) return;
      идёт = false; кончено = true;
      clearInterval(таймер);
      const секунд = Math.max(1, (Date.now() - начало) / 1000);
      const скорость = Math.round((верныхВсего / 5) / (секунд / 60));   // слов в минуту
      const знаков = Math.round(верныхВсего / (секунд / 60));            // знаков в минуту
      const всего = верныхВсего + неверныхВсего;
      const точность = всего ? Math.round((верныхВсего / всего) * 100) : 100;
      const главное = знакиГлавное ? знаков : скорость;
      итогСкорость.textContent = String(главное);
      итогВторая.textContent = String(знакиГлавное ? скорость : знаков);
      итогТочность.textContent = точность + '%';
      итогОшибки.textContent = String(неверныхВсего);

      const разр = разряд(скорость);
      ступени.forEach((ш, i) => ш.classList.toggle('on', i === разр));
      отметка.style.left = местоНаЛенте(скорость) + '%';
      итогСлова.textContent = оценка(разр, точность);

      // Рекорд. Свой текст в него не идёт: там свои знаки препинания, и сравнение было бы
      // нечестным по отношению к обычным заходам.
      const прежний = свой ? 0 : взятьРекорд();
      const побит = !свой && главное > прежний;
      if (побит) { try { localStorage.setItem(ключРекорда(), String(главное)); } catch {} }
      // Разряд человек читает первым -- он и стоит первым. Рекорд приписывается рядом, но
      // только настоящий: самый первый заход бить нечего, а «рекорд» на пустом месте -- обман.
      const настоящийРекорд = побит && прежний > 0;
      const имя = прозвище(разр, точность);
      итогРазряд.textContent = свой ? с.ownBadge
        : имя + (настоящийРекорд ? ' · ' + с.recNew + ' ' + с.recWas + ' ' + прежний : '');
      итогРазряд.classList.toggle('рекорд', настоящийРекорд);
      показатьРекорд();

      // Журнал ведём только по обычным заходам: свой текст с ними несравним.
      if (!свой) {
        const прошлая = взятьЖурнал()[0] || null;
        полеПохвалы.textContent = похвала(главное, точность, разр, прошлая);
        const жур = взятьЖурнал();
        жур.forEach((з2) => { delete з2.свежая; });
        try { localStorage.setItem(ключЖурнала, JSON.stringify(жур)); } catch {}
        записатьВЖурнал({
          главное, точность, прозвище: имя, уровень: с[({ easy: 'lvEasy', medium: 'lvMid', hard: 'lvHard' })[уровень]],
          секунд: длительность, когда: Date.now(), свежая: true,
        });
      } else {
        полеПохвалы.textContent = '';
      }
      показатьЖурнал();

      полеСкорость.textContent = String(главное);
      полеТочность.textContent = точность + '%';
      полеОсталось.textContent = свой ? String(Math.round(секунд)) : '0';
      корень.classList.remove('идёт', 'мало', 'совсем-мало');
      корень.classList.add('конец');
      подсказка.textContent = с.after;
      ввод.readOnly = true;    // добить текст после гонга нельзя -- счёт был бы нечестным
      ввод.blur();
    }
    function заново() {
      clearInterval(таймер);
      идёт = false; кончено = false;
      верныхВсего = 0; неверныхВсего = 0; верхПрошлый = -1;
      корень.classList.remove('идёт', 'конец', 'мало', 'совсем-мало');
      поле.classList.add('ждёт');
      ввод.readOnly = false;
      ввод.value = '';
      текст.style.transform = '';
      полоса.style.transform = 'scaleX(1)';
      подписьВремени.textContent = свой ? с.elapsed : с.time;
      полеОсталось.textContent = свой ? '0' : String(длительность);
      полеСкорость.textContent = '0';
      полеТочность.textContent = '100%';
      подсказка.textContent = с.ready;
      показатьРекорд();
      if (свой) слова = свой.slice();
      else if (собрать) слова = собрать(уровень);   // каждый заход -- новый текст
      нарисовать();
      поставитьКурсор();
      ввод.focus();
    }

    ввод.addEventListener('input', () => { начать(); разобрать(); });
    ввод.addEventListener('keydown', (e) => { if (e.key === 'Enter') e.preventDefault(); });
    // Потеря фокуса на середине попытки: время останавливаем и говорим об этом. Продолжать
    // отсчёт, пока человек ушёл в другое окно, было бы враньём.
    ввод.addEventListener('focus', () => корень.classList.remove('не-в-фокусе'));
    ввод.addEventListener('blur', () => { if (!кончено) корень.classList.add('не-в-фокусе'); });
    поле.addEventListener('click', () => { if (!кончено) ввод.focus(); });
    кнопкаЗаново.addEventListener('click', () => { заново(); кнопкаЗаново.blur(); });
    рядРежимов.addEventListener('click', (e) => {
      const б = e.target.closest('.tp-key');
      if (!б || свой) return;
      [...рядРежимов.children].forEach((x) => x.classList.toggle('on', x === б));
      длительность = Number(б.dataset.sec) || 60;
      заново();
      б.blur();
    });
    рядВида.addEventListener('click', (e) => {
      const б = e.target.closest('.tp-key');
      if (!б || свой) return;
      [...рядВида.children].forEach((x) => x.classList.toggle('on', x === б));
      уровень = б.dataset.kind || 'easy';
      заново();
      б.blur();
    });
    // Ширина изменилась -- строки перебились, и курсор с прокруткой должны встать заново.
    window.addEventListener('resize', () => { верхПрошлый = -1; поставитьКурсор(); });

    // СВОЙ ТЕКСТ. Никуда не уходит и нигде не сохраняется: живёт только в этой вкладке, пока
    // она открыта. Люди вставляют сюда рабочие письма, и это должно быть правдой.
    function почистить(t) {
      return String(t || '').replace(/ /g, ' ').replace(/\s+/g, ' ').trim();
    }
    function открытьПанель(да) {
      панель.hidden = !да;
      кнопкаСвой.setAttribute('aria-expanded', да ? 'true' : 'false');
      кнопкаСвой.classList.toggle('on', да);
      if (да) вставка.focus();
    }
    кнопкаСвой.addEventListener('click', () => {
      if (свой) { снятьСвой(); return; }        // второе нажатие возвращает обычный текст
      открытьПанель(панель.hidden);
    });
    вставка.addEventListener('input', () => {
      const n = почистить(вставка.value).length;
      счётЗнаков.textContent = n + ' ' + с.ownChars;
      счётЗнаков.classList.toggle('мало', n > 0 && n < 20);
    });
    document.getElementById('tp-drop').addEventListener('click', () => открытьПанель(false));
    document.getElementById('tp-take').addEventListener('click', () => {
      const чистый = почистить(вставка.value);
      if (чистый.length < 20) {
        счётЗнаков.textContent = с.ownShort;
        счётЗнаков.classList.add('мало');
        вставка.focus();
        return;
      }
      let части = чистый.split(' ');
      const длинно = части.length > 500;
      if (длинно) части = части.slice(0, 500);
      свой = части;
      корень.classList.add('свой');
      кнопкаСвой.classList.add('on');
      кнопкаСвой.textContent = с.ownCancel;
      [...рядРежимов.children, ...рядВида.children].forEach((б) => { б.disabled = true; });
      полеРекорд.textContent = '—';
      открытьПанель(false);
      заново();
      подсказка.textContent = длинно ? с.ownLong : с.ready;
    });
    function снятьСвой() {
      свой = null;
      корень.classList.remove('свой');
      кнопкаСвой.classList.remove('on');
      кнопкаСвой.textContent = с.own;
      [...рядРежимов.children, ...рядВида.children].forEach((б) => { б.disabled = false; });
      заново();
    }

    document.getElementById('tp-log-title').textContent = с.logTitle;
    document.getElementById('tp-log-note').textContent = с.logNote;
    const кнопкаСтереть = document.getElementById('tp-log-clear');
    кнопкаСтереть.textContent = с.logClear;
    кнопкаСтереть.addEventListener('click', () => {
      try { localStorage.removeItem(ключЖурнала); } catch {}
      показатьЖурнал();
      кнопкаСтереть.blur();
    });

    // Слова живут в отдельном файле: он весит килобайты и грузится сразу, но отдельно от
    // страницы -- разметка успевает показаться раньше.
    import('../lib/typing-words.js').then((м) => {
      собрать = (какой) => м.текстДляТеста(язык, какой, 140);
      заново();
    });

    window.__tpСостояние = () => ({
      идёт, кончено, длительность, уровень,
      свой: !!свой,
      первыеСлова: слова.slice(0, 5).join(' '),
      скорость: Number(полеСкорость.textContent),
      точность: полеТочность.textContent,
      итог: итогСкорость.textContent,
      разряд: итогРазряд.textContent,
      похвала: полеПохвалы.textContent,
      вЖурнале: взятьЖурнал().length,
      рекорд: полеРекорд.textContent,
      верных: корень.querySelectorAll('.tp-ch.ok').length,
      неверных: корень.querySelectorAll('.tp-ch.bad, .tp-ch.extra').length,
      наЭкранеИтог: корень.classList.contains('конец'),
      накладка: корень.classList.contains('не-в-фокусе'),
    });
  })();
</script>
