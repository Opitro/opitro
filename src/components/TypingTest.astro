---
// СКОРОСТЬ ПЕЧАТИ -- своя страница со своим кодом и стилями.
//
// Меряем так же, как принято везде: за слово считаются пять напечатанных знаков, поэтому
// длина слов в языке на результат не влияет и цифры сравнимы между людьми и языками.
// В зачёт идут только ВЕРНЫЕ знаки: иначе «скорость» набивается опечатками.
//
// Слова -- случайные частые слова языка, а не связный текст: связный можно угадывать по
// смыслу, и тогда меряется знакомство с отрывком, а не набор. Подробности в lib/typing-words.js.
import css from '../styles/typing-test.css?inline';
import { размерЗапаса } from '../lib/typing-words.js';

const { locale = 'ru' } = Astro.props;
// Текст собирает БРАУЗЕР на каждую попытку, а не сборка. Раньше он печатался в страницу
// один раз и был одинаковым у всех, а «Заново» его не менял -- второй заход шёл уже по
// знакомому тексту, и замер получался нечестным.
const запас = размерЗапаса(locale);

const СЛОВА = {
  ru: {
    lvEasy: 'Лёгкий', lvMid: 'Средний', lvHard: 'Сложный',
    wpmShort: 'сл/мин',
    after: 'Нажмите «Заново», чтобы пройти ещё раз',
    focus: 'Нажмите, чтобы продолжить',
    ready: 'Нажмите на текст — время пойдёт с первой буквы',
    typing: 'Время идёт. Ошибку можно стереть и набрать заново',
    result: 'Результат', restart: 'Заново', time: 'Время',
    vSlow: 'Это скорость набора двумя пальцами. Обычная для тех, кто печатает нечасто.',
    vMid: 'Уверенный набор. Столько печатает большинство тех, кто много пишет.',
    vFast: 'Слепая печать. Так набирают те, для кого текст — работа.',
    vPro: 'Профессиональный уровень: быстрее печатают немногие.',
    vAcc: 'При точности ниже 95 % скорость обманчива: время уходит на исправления.',
    start: 'Начните печатать — время пойдёт с первой буквы',
    left: 'Осталось', sec: 'с', speed: 'Скорость', wpm: 'слов в минуту',
    acc: 'Точность', errors: 'Ошибок', again: 'Заново',
    wpmSub: 'Слово — это пять знаков, как принято при замере',
    accSub: 'Доля верных знаков',
    errSub: 'Знаков набрано неверно',
    n1: 'В зачёт идут только верно набранные знаки: скорость, набитая опечатками, ничего не значит.',
    n2: 'Каждый заход — новый текст. Лёгкий уровень — связный текст простыми словами, средний — он же длинными и трудными, сложный — слова без связи со знаками препинания.',
    n3: 'Ошибку можно исправить: сотрите неверную букву и наберите заново, точность это учтёт.',
    n4: 'Средняя скорость взрослого — 30-40 слов в минуту, уверенная печать вслепую — от 60.',
  },
  en: {
    lvEasy: 'Easy', lvMid: 'Medium', lvHard: 'Hard',
    wpmShort: 'wpm',
    after: 'Press “Again” to have another go',
    focus: 'Click to carry on',
    ready: 'Click the text — the clock starts with your first letter',
    typing: 'The clock is running. A mistake can be deleted and retyped',
    result: 'Result', restart: 'Again', time: 'Time',
    vSlow: 'That is two-finger speed. Normal for people who type rarely.',
    vMid: 'Confident typing. Most people who write a lot land here.',
    vFast: 'Touch typing. This is the speed of people who write for a living.',
    vPro: 'Professional level: not many type faster.',
    vAcc: 'Below 95 % accuracy the speed is misleading: the time goes into corrections.',
    start: 'Just start typing — the clock starts with your first letter',
    left: 'Left', sec: 's', speed: 'Speed', wpm: 'words per minute',
    acc: 'Accuracy', errors: 'Mistakes', again: 'Again',
    wpmSub: 'A word counts as five characters, the usual measure',
    accSub: 'Share of correct characters',
    errSub: 'Characters typed wrong',
    n1: 'Only correctly typed characters count: speed made of typos means nothing.',
    n2: 'Every attempt gets a new text. Easy is plain connected text, medium is the same with long difficult words, hard is unconnected words with punctuation.',
    n3: 'You can fix a mistake: delete the wrong letter and type it again, accuracy takes that into account.',
    n4: 'An average adult types 30–40 words per minute; confident touch typing starts around 60.',
  },
  es: {
    lvEasy: 'Fácil', lvMid: 'Medio', lvHard: 'Difícil',
    wpmShort: 'ppm',
    after: 'Pulsa «Otra vez» para repetir',
    focus: 'Pulsa para continuar',
    ready: 'Pulsa el texto: el tiempo corre desde la primera letra',
    typing: 'El tiempo corre. Un error se puede borrar y escribir de nuevo',
    result: 'Resultado', restart: 'Otra vez', time: 'Tiempo',
    vSlow: 'Es la velocidad de escribir con dos dedos. Normal si escribes poco.',
    vMid: 'Escritura segura. Ahí está la mayoría de quienes escriben mucho.',
    vFast: 'Mecanografía. Es la velocidad de quien escribe para vivir.',
    vPro: 'Nivel profesional: pocos escriben más rápido.',
    vAcc: 'Por debajo del 95 % de precisión la velocidad engaña: el tiempo se va en correcciones.',
    start: 'Empieza a escribir: el tiempo corre desde la primera letra',
    left: 'Queda', sec: 's', speed: 'Velocidad', wpm: 'palabras por minuto',
    acc: 'Precisión', errors: 'Errores', again: 'Otra vez',
    wpmSub: 'Una palabra son cinco caracteres, la medida habitual',
    accSub: 'Proporción de caracteres correctos',
    errSub: 'Caracteres escritos mal',
    n1: 'Solo cuentan los caracteres correctos: una velocidad hecha de erratas no significa nada.',
    n2: 'Cada intento trae un texto nuevo. Fácil es texto sencillo con sentido, medio es el mismo con palabras largas y difíciles, difícil son palabras sueltas con signos de puntuación.',
    n3: 'Puedes corregir: borra la letra equivocada y escríbela de nuevo, la precisión lo tendrá en cuenta.',
    n4: 'Un adulto medio escribe 30-40 palabras por minuto; la mecanografía segura empieza en torno a 60.',
  },
  uk: {
    lvEasy: 'Легкий', lvMid: 'Середній', lvHard: 'Складний',
    wpmShort: 'сл/хв',
    after: 'Натисніть «Заново», щоб пройти ще раз',
    focus: 'Натисніть, щоб продовжити',
    ready: 'Натисніть на текст — час піде з першої літери',
    typing: 'Час іде. Помилку можна стерти й набрати заново',
    result: 'Результат', restart: 'Заново', time: 'Час',
    vSlow: 'Це швидкість набору двома пальцями. Звична для тих, хто друкує нечасто.',
    vMid: 'Впевнений набір. Стільки друкує більшість тих, хто багато пише.',
    vFast: 'Сліпий друк. Так набирають ті, для кого текст — робота.',
    vPro: 'Професійний рівень: швидше друкують небагато хто.',
    vAcc: 'При точності нижче 95 % швидкість оманлива: час іде на виправлення.',
    start: 'Починайте друкувати — час піде з першої літери',
    left: 'Залишилось', sec: 'с', speed: 'Швидкість', wpm: 'слів за хвилину',
    acc: 'Точність', errors: 'Помилок', again: 'Заново',
    wpmSub: 'Слово — це п\'ять знаків, як заведено при замірі',
    accSub: 'Частка вірних знаків',
    errSub: 'Знаків набрано неправильно',
    n1: 'У залік ідуть лише правильно набрані знаки: швидкість, набита одруківками, нічого не варта.',
    n2: 'Кожен захід — новий текст. Легкий рівень — зв\'язний текст простими словами, середній — він же довгими й важкими, складний — слова без зв\'язку зі знаками пунктуації.',
    n3: 'Помилку можна виправити: зітріть невірну літеру й наберіть заново, точність це врахує.',
    n4: 'Середня швидкість дорослого — 30-40 слів за хвилину, впевнений сліпий друк — від 60.',
  },
};
const с = СЛОВА[locale] || СЛОВА.ru;
---

<style is:inline set:html={css}></style>

<div class="tp" data-words={JSON.stringify(с)} data-locale={locale} data-stock={JSON.stringify(запас)}>
  {/* Длительность слева, живые числа справа. Пока набор не начался, время показывает выбранную
      длительность -- человек видит, на что подписывается. */}
  <div class="tp-top">
    {/* Уровень. Связный текст набирают быстрее всего -- смысл подсказывает следующее слово,
        поэтому слова без связи стоят не в начале ряда, а в конце, как самое трудное. */}
    <div class="tp-modes" id="tp-kind" role="group">
      <button type="button" class="tp-mode on" data-kind="easy">{с.lvEasy}</button>
      <button type="button" class="tp-mode" data-kind="medium">{с.lvMid}</button>
      <button type="button" class="tp-mode" data-kind="hard">{с.lvHard}</button>
    </div>
    <div class="tp-modes" id="tp-modes" role="group">
      <button type="button" class="tp-mode" data-sec="30">30 {с.sec}</button>
      <button type="button" class="tp-mode on" data-sec="60">60 {с.sec}</button>
      <button type="button" class="tp-mode" data-sec="180">180 {с.sec}</button>
    </div>
    <div class="tp-live">
      <span><span class="v time" id="tp-left">60</span><span class="k">{с.time}</span></span>
      {/* Две подписи, длинная и короткая: на телефоне «слов в минуту» переносится на вторую
          строку и разваливает ряд. Выбирает нужную стиль, а не код. */}
      <span><span class="v" id="tp-wpm">0</span><span class="k"><i class="дл">{с.wpm}</i><i class="кр">{с.wpmShort}</i></span></span>
      <span><span class="v" id="tp-acc">100%</span><span class="k">{с.acc}</span></span>
    </div>
  </div>

  {/* Слова видны с самого начала и ничем не закрыты: человек должен видеть, что печатать,
      прежде чем решит начать. Накладка появляется только когда поле теряет фокус. */}
  <div class="tp-field ждёт" id="tp-field">
    <div class="tp-view" id="tp-viewport">
      <div class="tp-lines" id="tp-text"></div>
      <div class="tp-caret" id="tp-caret"></div>
    </div>
    <textarea class="tp-input" id="tp-input" autocomplete="off" autocorrect="off"
              autocapitalize="off" spellcheck="false" aria-label={с.speed}></textarea>
    <div class="tp-blur" id="tp-blur">{с.focus}</div>

    {/* Итог занимает место текста: набор кончился -- слова больше не нужны, нужен ответ. */}
    <div class="tp-result" id="tp-result">
      <div class="tp-res-row">
        <div class="tp-res-main">
          <span class="v" id="tp-res-wpm">0</span>
          <span class="k">{с.wpmSub}</span>
        </div>
        <div class="tp-res-sub">
          <div><span class="v" id="tp-res-acc">100%</span><span class="k">{с.acc}</span></div>
          <div><span class="v" id="tp-res-err">0</span><span class="k">{с.errors}</span></div>
        </div>
      </div>
      <div class="tp-verdict" id="tp-verdict"></div>
    </div>
  </div>

  <div class="tp-under">
    <span class="tp-hint" id="tp-hint">{с.ready}</span>
    <button type="button" class="tp-again" id="tp-again">{с.restart}</button>
  </div>

  <div class="tp-notes">
    <div class="tp-note">{с.n1}</div>
    <div class="tp-note">{с.n2}</div>
    <div class="tp-note">{с.n3}</div>
    <div class="tp-note">{с.n4}</div>
  </div>
</div>

<script>
  const корень = document.querySelector('.tp');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const язык = корень.dataset.locale || 'ru';
    // Материал собирается заново на каждую попытку -- см. lib/typing-words.js.
    let слова = [];
    let уровень = 'easy';
    let собрать = null;   // приедет вместе с модулем слов
    const поле = document.getElementById('tp-field');
    const окно = document.getElementById('tp-viewport');
    const текст = document.getElementById('tp-text');
    const ввод = document.getElementById('tp-input');
    const курсор = document.getElementById('tp-caret');
    const подсказка = document.getElementById('tp-hint');
    const полеОсталось = document.getElementById('tp-left');
    const полеСкорость = document.getElementById('tp-wpm');
    const полеТочность = document.getElementById('tp-acc');
    const итогСкорость = document.getElementById('tp-res-wpm');
    const итогТочность = document.getElementById('tp-res-acc');
    const итогОшибки = document.getElementById('tp-res-err');
    const итогСлова = document.getElementById('tp-verdict');
    const кнопкаЗаново = document.getElementById('tp-again');
    const рядРежимов = document.getElementById('tp-modes');
    const рядВида = document.getElementById('tp-kind');

    let длительность = 60;
    let начало = 0, таймер = 0, идёт = false, кончено = false;
    let верныхВсего = 0, неверныхВсего = 0;

    // Рисуем слова буквами: каждая буква своим узлом, иначе не показать, где именно ошибка.
    // Делается один раз на попытку -- перерисовывать тысячу узлов на каждое нажатие значило бы
    // тормозить под пальцами.
    const узлыСлов = [];
    function нарисовать() {
      const куски = document.createDocumentFragment();
      узлыСлов.length = 0;
      for (const слово of слова) {
        const у = document.createElement('span');
        у.className = 'tp-word';
        for (const б of слово) {
          const с2 = document.createElement('span');
          с2.className = 'tp-ch';
          с2.textContent = б;
          у.appendChild(с2);
        }
        куски.appendChild(у);
        узлыСлов.push(у);
      }
      текст.replaceChildren(куски);
    }

    // Курсор ставим перед той буквой, которую предстоит набрать. По нему глаз держит место в
    // строке -- вернее, чем по подсветке слова.
    function поставитьКурсор() {
      const набрано = ввод.value.split(' ');
      const i = Math.min(набрано.length - 1, узлыСлов.length - 1);
      const узел = узлыСлов[i];
      if (!узел) return;
      const буквы = узел.children;
      const j = (набрано[i] || '').length;
      const цель = буквы[Math.min(j, буквы.length - 1)];
      if (!цель) return;
      const рб = цель.getBoundingClientRect();
      const ро = окно.getBoundingClientRect();
      const справа = j >= буквы.length;      // слово добрано -- курсор за последней буквой
      курсор.style.left = (рб.left - ро.left + (справа ? рб.width : 0)) + 'px';
      курсор.style.top = (рб.top - ро.top) + 'px';
      курсор.style.height = рб.height + 'px';
    }

    // Текст едет вверх, чтобы строка с курсором стояла второй. Считаем по положению слова,
    // а не по числу набранных: слова разной длины, строки получаются неодинаковыми.
    let верхПрошлый = -1;
    function подвинуть(узел) {
      if (!узел) return;
      const строка = узел.offsetTop;
      if (строка === верхПрошлый) return;
      верхПрошлый = строка;
      текст.style.transform = 'translateY(' + (-Math.max(0, строка - узел.offsetHeight)) + 'px)';
    }

    function разобрать() {
      const набрано = ввод.value.split(' ');
      let верных = 0, неверных = 0;
      for (let i = 0; i < узлыСлов.length; i++) {
        const узел = узлыСлов[i];
        const образец = слова[i];
        const было = набрано[i];
        if (i === набрано.length - 1) подвинуть(узел);
        [...узел.querySelectorAll('.tp-ch.extra')].forEach((э) => э.remove());
        const буквы = узел.children;
        if (было == null) {
          for (const б of буквы) б.className = 'tp-ch';
          continue;
        }
        for (let j = 0; j < буквы.length; j++) {
          const набран = было[j];
          if (набран == null) { буквы[j].className = 'tp-ch'; continue; }
          const верно = набран === образец[j];
          буквы[j].className = 'tp-ch ' + (верно ? 'ok' : 'bad');
          if (верно) верных++; else неверных++;
        }
        if (было.length > образец.length) {
          for (let j = образец.length; j < было.length; j++) {
            const л = document.createElement('span');
            л.className = 'tp-ch extra';
            л.textContent = было[j];
            узел.appendChild(л);
            неверных++;
          }
        }
        if (i < набрано.length - 1) верных++;   // пробел между словами тоже знак
      }
      верныхВсего = верных; неверныхВсего = неверных;
      const всего = верных + неверных;
      полеТочность.textContent = (всего ? Math.round((верных / всего) * 100) : 100) + '%';
      // Первые три секунды скорость не показываем: на одной секунде выходит бессмыслица.
      const секунд = идёт ? (Date.now() - начало) / 1000 : 0;
      полеСкорость.textContent = (идёт && секунд >= 3)
        ? String(Math.round((верных / 5) / (секунд / 60))) : '0';
      поставитьКурсор();
      if (набрано.length >= слова.length) закончить();
    }

    function тик() {
      const осталось = Math.max(0, Math.ceil(длительность - (Date.now() - начало) / 1000));
      полеОсталось.textContent = String(осталось);
      if (осталось <= 0) { закончить(); return; }
      разобрать();
    }
    function начать() {
      if (идёт || кончено) return;
      идёт = true;
      корень.classList.add('идёт');
      поле.classList.remove('ждёт');
      подсказка.textContent = с.typing;
      начало = Date.now();
      таймер = window.setInterval(тик, 200);
    }
    function оценка(скорость, точность) {
      const части = [];
      if (скорость < 30) части.push(с.vSlow);
      else if (скорость < 60) части.push(с.vMid);
      else if (скорость < 85) части.push(с.vFast);
      else части.push(с.vPro);
      if (точность < 95) части.push(с.vAcc);
      return части.join(' ');
    }
    function закончить() {
      if (!идёт) return;
      идёт = false; кончено = true;
      clearInterval(таймер);
      const секунд = Math.max(1, (Date.now() - начало) / 1000);
      const скорость = Math.round((верныхВсего / 5) / (секунд / 60));
      const всего = верныхВсего + неверныхВсего;
      const точность = всего ? Math.round((верныхВсего / всего) * 100) : 100;
      итогСкорость.textContent = String(скорость);
      итогТочность.textContent = точность + '%';
      итогОшибки.textContent = String(неверныхВсего);
      итогСлова.textContent = оценка(скорость, точность);
      полеСкорость.textContent = String(скорость);
      полеТочность.textContent = точность + '%';
      полеОсталось.textContent = '0';
      корень.classList.remove('идёт');
      корень.classList.add('конец');
      подсказка.textContent = с.after;
      ввод.readOnly = true;    // добить текст после гонга нельзя -- счёт был бы нечестным
      ввод.blur();
    }
    function заново() {
      clearInterval(таймер);
      идёт = false; кончено = false;
      верныхВсего = 0; неверныхВсего = 0; верхПрошлый = -1;
      корень.classList.remove('идёт', 'конец');
      поле.classList.add('ждёт');
      ввод.readOnly = false;
      ввод.value = '';
      текст.style.transform = '';
      полеОсталось.textContent = String(длительность);
      полеСкорость.textContent = '0';
      полеТочность.textContent = '100%';
      подсказка.textContent = с.ready;
      if (собрать) слова = собрать(уровень);   // каждый заход -- новый текст
      нарисовать();
      поставитьКурсор();
      ввод.focus();
    }

    ввод.addEventListener('input', () => { начать(); разобрать(); });
    ввод.addEventListener('keydown', (e) => { if (e.key === 'Enter') e.preventDefault(); });
    // Потеря фокуса на середине попытки: время останавливаем и говорим об этом. Продолжать
    // отсчёт, пока человек ушёл в другое окно, было бы враньём.
    ввод.addEventListener('focus', () => корень.classList.remove('не-в-фокусе'));
    ввод.addEventListener('blur', () => { if (!кончено) корень.classList.add('не-в-фокусе'); });
    поле.addEventListener('click', () => { if (!кончено) ввод.focus(); });
    кнопкаЗаново.addEventListener('click', () => { заново(); кнопкаЗаново.blur(); });
    рядРежимов.addEventListener('click', (e) => {
      const б = e.target.closest('.tp-mode');
      if (!б) return;
      [...рядРежимов.children].forEach((x) => x.classList.toggle('on', x === б));
      длительность = Number(б.dataset.sec) || 60;
      заново();
      б.blur();
    });
    // Ширина изменилась -- строки перебились, и курсор с прокруткой должны встать заново.
    window.addEventListener('resize', () => { верхПрошлый = -1; поставитьКурсор(); });

    // Слова живут в отдельном файле: он весит килобайты и грузится сразу, но отдельно от
    // страницы -- разметка успевает показаться раньше.
    import('../lib/typing-words.js').then((м) => {
      собрать = (какой) => м.текстДляТеста(язык, какой, 140);
      заново();
    });

    рядВида.addEventListener('click', (e) => {
      const б = e.target.closest('.tp-mode');
      if (!б) return;
      [...рядВида.children].forEach((x) => x.classList.toggle('on', x === б));
      уровень = б.dataset.kind || 'easy';
      заново();
      б.blur();
    });

    window.__tpСостояние = () => ({
      идёт, кончено, длительность, уровень,
      первыеСлова: слова.slice(0, 5).join(' '),
      скорость: Number(полеСкорость.textContent),
      точность: полеТочность.textContent,
      итог: итогСкорость.textContent,
      верных: корень.querySelectorAll('.tp-ch.ok').length,
      неверных: корень.querySelectorAll('.tp-ch.bad, .tp-ch.extra').length,
      наЭкранеИтог: корень.classList.contains('конец'),
      накладка: корень.classList.contains('не-в-фокусе'),
    });
  })();
</script>
