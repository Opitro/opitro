// СКОРОСТЬ ПЕЧАТИ -- своя страница со своим кодом и стилями.
//
// Меряем так же, как принято везде: за слово считаются пять напечатанных знаков, поэтому
// длина слов в языке на результат не влияет и цифры сравнимы между людьми и языками.
// В зачёт идут только ВЕРНЫЕ знаки: иначе «скорость» набивается опечатками.
//
// Кроме самого замера страница отвечает на вопрос «а что мне с этим делать»: показывает
// график по секундам, карту промахнутых клавиш, пальцы и РОВНОСТЬ -- насколько похожи
// промежутки между нажатиями. Ровность и есть то, что отличает слепую печать от быстрого
// тыканья, и её никто из соседей не считает.
import css from '../styles/typing-test.css?inline';
import { размерЗапаса } from '../lib/typing-words.js';

const { locale = 'ru' } = Astro.props;
const запас = размерЗапаса(locale);
