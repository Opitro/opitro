---
// КОДИРОВАНИЕ И ДЕКОДИРОВАНИЕ URL (percent-encoding).
//
// ЧЕТЫРЕ МЕСТА, ГДЕ ПРОСТОЕ РЕШЕНИЕ ВРЁТ, и все четыре здесь учтены:
//
//   1. Два разных кодирования решают разные задачи, и путать их нельзя. encodeURI бережёт
//      служебные знаки адреса (: / ? & = #) -- им кодируют ссылку целиком. encodeURIComponent
//      кодирует всё -- им кодируют ОДНО значение, которое кладут внутрь чужого адреса.
//      Отсюда переключатель охвата, а не один невнятный флажок.
//
//   2. Разбираем всегда decodeURIComponent, даже если кодировали целую ссылку: decodeURI
//      намеренно не разворачивает %2F и %3F, и «обратный ход» вышел бы неполным.
//
//   3. Битая %-последовательность роняет разбор с ошибкой. Ловим и говорим по-человечески,
//      а не оставляем пустое поле.
//
//   4. encodeURIComponent НЕ кодирует ! ' ( ) * -- по нынешнему стандарту адресов эти знаки
//      служебные. Там, где это важно, нужен строгий вид; про это сказано прямо в заметках.
//
// Ничего никуда не уходит: всё делается в браузере, страница не отправляет и не хранит строк.
import css from '../styles/url-encode.css?inline';

const { locale = 'ru' } = Astro.props;

const СЛОВА = {
  ru: {
    toUrl: 'Текст → URL', toText: 'URL → текст',
    scope: 'Что кодируем:', whole: 'Ссылку целиком', part: 'Одно значение',
    placeEnc: 'Введите ссылку или текст…',
    placeDec: 'Вставьте закодированную ссылку — она развернётся…',
    resEnc: 'Закодированная строка появится здесь…', resDec: 'Читаемый текст появится здесь…',
    chars: 'Знаков', bytes: 'Байтов', out: 'На выходе',
    mode: 'Режим',
    modeEncWhole: 'текст → URL, ссылка целиком',
    modeEncPart: 'текст → URL, одно значение',
    modeDec: 'URL → текст',
    hintDec: 'Похоже на закодированную ссылку — развернуть?',
    hintEnc: 'Похоже на обычный текст — закодировать?',
    errBroken: 'Ошибка: в строке оборванная %-последовательность. После знака % должны идти ровно две шестнадцатеричные цифры — например %20 или %D0.',
    copyBig: 'Копировать результат', copiedBig: 'Скопировано!', clearAll: 'Очистить всё',
    nothing: 'Поле пустое', copyFail: 'Браузер не дал скопировать — текст выделен, нажмите Ctrl+C',
    n1: '<b>Ссылку целиком</b> — служебные знаки адреса остаются на месте: <code>: / ? &amp; = #</code>. Кириллица и пробелы кодируются, ссылка остаётся рабочей и кликабельной. Так готовят адрес к отправке в письме или сообщении.',
    n2: '<b>Одно значение</b> — кодируется всё подряд, включая <code>://</code> и <code>&amp;</code>. Это нужно, когда один адрес кладут внутрь другого: <code>?next=https%3A%2F%2Fopitro.com</code>. Без этого чужой знак <code>&amp;</code> разорвал бы запрос пополам.',
    n3: 'Разбор всегда полный. Обратный ход делается тем способом, который разворачивает и <code>%2F</code>, и <code>%3F</code> — иначе «раскодированная» ссылка осталась бы наполовину в кодах.',
    n4: 'Русская буква занимает <b>два байта</b>, поэтому в адресе превращается в две пары: «я» → <code>%D1%8F</code>. Оттого адреса с кириллицей и выглядят такими длинными.',
    n5: 'Знаки <code>! \' ( ) *</code> при кодировании значения остаются как есть: по нынешнему стандарту адресов они служебные и в кодировании не нуждаются. Некоторые старые системы всё же просят их закодировать — тогда это делают отдельно.',
    n6: 'Всё считается в вашем браузере. Ссылки, токены и параметры запросов никуда не отправляются и нигде не сохраняются.',
