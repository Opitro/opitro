---
// СКАНЕР ТЕКСТА С ФОТО.
//
// Что человек получает сверх «текста строкой»: он видит, ЧТО именно прочитано (найденные
// строки обведены прямо на снимке), где движок не уверен (слово подчёркнуто волной), может
// прочитать только нужный кусок (обвёл рамкой), повернуть снимок, читать двумя азбуками
// разом (кириллица вперемешку с латиницей -- обычное дело), забрать результат текстом,
// файлом .txt или текстовым PDF (документ с буквами, а не снимок в оболочке).
//
// Всё считается в браузере: движок и азбуки лежат у нас в /tess/ и приезжают только после
// выбора снимка. Чужое письмо, договор, рецепт -- ничего из этого никуда не уходит.
import css from '../styles/text-scan.css?inline';

export interface Props { locale?: string }
const { locale = 'ru' } = Astro.props;

const СЛОВА = {
  ru: {
    camera: 'Камера', file: 'Файл', invite: 'Перетащите снимок сюда',
    inviteTouch: 'Снимите или выберите снимок', or: 'или выберите',
    loadingWord: 'Загрузка…', reading: 'Сканирую…', nothing: 'Текста не видно',
    nothingWhy: 'На снимке не нашлось букв. Снимите ближе и ровнее, чтобы строки шли горизонтально и не были смазаны. Если буквы светлые на тёмном — включите значок с луной.',
    copy: 'Скопировать текст', copied: 'Скопировано', txt: 'Скачать .txt',
    onPaper: 'Показать текст на снимке', onPhoto: 'Показать фотографию',
    pdf: 'Скачать PDF с текстом', rotate: 'Повернуть', invert: 'Светлые буквы на тёмном',
    pdfBusy: 'Собираю PDF…', pdfFail: 'PDF не собрался. Попробуйте ещё раз или скачайте .txt.',
    pdfScript: 'В PDF такое письмо не ляжет — в шрифте есть латиница, кириллица и греческий. Скачайте .txt.',
    crop: 'Прочитать только кусок', cropOn: 'Обведите кусок на снимке', cropOff: 'Читать весь снимок',
    again: 'Другой снимок', shaky: 'Проверьте {н} слов: движок в них не уверен',
    counted: '{з} · {с}', charForms: ['знак', 'знака', 'знаков'], wordForms: ['слово', 'слова', 'слов'],
    shakyOne: 'Проверьте {н} {ф} — движок в нём сомневается', langTooMany: 'Больше двух азбук разом — читается дольше, а точнее не станет',
    noCam: 'Камера недоступна. Проверьте, что она не занята другой программой.',
    denied: 'Доступ к камере не дан. Разрешение спрашивает сам браузер.',
    heavy: 'Не получилось принести распознаватель. Похоже, оборвалась связь — попробуйте ещё раз.',
    notImage: 'Это не картинка. Выберите снимок: JPEG, PNG, WebP или HEIC.',
    shot: 'Снять кадр',
  },
  uk: {
    camera: 'Камера', file: 'Файл', invite: 'Перетягніть знімок сюди',
    inviteTouch: 'Зніміть або виберіть знімок', or: 'або виберіть',
    loadingWord: 'Завантаження…', reading: 'Сканую…', nothing: 'Тексту не видно',
    nothingWhy: 'На знімку не знайшлося літер. Зніміть ближче й рівніше, щоб рядки йшли горизонтально й не були змазані. Якщо літери світлі на темному — увімкніть значок із місяцем.',
    copy: 'Скопіювати текст', copied: 'Скопійовано', txt: 'Завантажити .txt',
    onPaper: 'Показати текст на знімку', onPhoto: 'Показати фотографію',
    pdf: 'Завантажити PDF із текстом', rotate: 'Повернути', invert: 'Світлі літери на темному',
    pdfBusy: 'Збираю PDF…', pdfFail: 'PDF не зібрався. Спробуйте ще раз або завантажте .txt.',
    pdfScript: 'У PDF таке письмо не ляже — у шрифті є латиниця, кирилиця й грецька. Завантажте .txt.',
    crop: 'Прочитати лише шматок', cropOn: 'Обведіть шматок на знімку', cropOff: 'Читати весь знімок',
    again: 'Інший знімок', shaky: 'Перевірте {н} слів: розпізнавач у них не впевнений',
    counted: '{з} · {с}', charForms: ['знак', 'знаки', 'знаків'], wordForms: ['слово', 'слова', 'слів'],
    shakyOne: 'Перевірте {н} {ф} — розпізнавач сумнівається', langTooMany: 'Більше двох абеток разом — читається довше, а точніше не стане',
    noCam: 'Камера недоступна. Перевірте, чи не зайнята вона іншою програмою.',
    denied: 'Доступ до камери не надано. Дозвіл питає сам браузер.',
    heavy: 'Не вийшло принести розпізнавач. Схоже, обірвався звʼязок — спробуйте ще раз.',
    notImage: 'Це не картинка. Виберіть знімок: JPEG, PNG, WebP або HEIC.',
    shot: 'Зняти кадр',
  },
  en: {
    camera: 'Camera', file: 'File', invite: 'Drop a photo here',
    inviteTouch: 'Take or choose a photo', or: 'or choose',
    loadingWord: 'Loading…', reading: 'Scanning…', nothing: 'No text in sight',
    nothingWhy: 'No letters were found in the photo. Move closer and keep it straight so the lines run horizontally and stay sharp. If the letters are light on a dark background, switch on the moon.',
    copy: 'Copy the text', copied: 'Copied', txt: 'Download .txt',
    onPaper: 'Show the text on the photo', onPhoto: 'Show the photo',
    pdf: 'Download PDF with the text', rotate: 'Rotate', invert: 'Light letters on dark',
    pdfBusy: 'Building the PDF…', pdfFail: 'The PDF could not be built. Try again or download the .txt.',
    pdfScript: 'This script will not fit in the PDF — the font covers Latin, Cyrillic and Greek. Download the .txt.',
    crop: 'Read one part only', cropOn: 'Draw a box on the photo', cropOff: 'Read the whole photo',
    again: 'Another photo', shaky: 'Check {н} words: the reader is unsure about them',
    counted: '{з} · {с}', charForms: ['character', 'characters', 'characters'], wordForms: ['word', 'words', 'words'],
    shakyOne: 'Check {н} {ф} — the reader is unsure', langTooMany: 'More than two alphabets at once is slower and no more accurate',
    noCam: 'The camera is not available. Check that another program is not holding it.',
    denied: 'Camera access was not granted. The browser itself asks for it.',
    heavy: 'The reader could not be fetched. The connection seems to have dropped — please try again.',
    notImage: 'That is not a picture. Choose a photo: JPEG, PNG, WebP or HEIC.',
    shot: 'Take the frame',
  },
  es: {
    camera: 'Cámara', file: 'Archivo', invite: 'Suelte una foto aquí',
    inviteTouch: 'Haga o elija una foto', or: 'o elija',
    loadingWord: 'Cargando…', reading: 'Escaneando…', nothing: 'No se ve texto',
    nothingWhy: 'No se han encontrado letras en la foto. Acérquese y mantenga la hoja recta para que las líneas queden horizontales y nítidas. Si las letras son claras sobre fondo oscuro, active la luna.',
    copy: 'Copiar el texto', copied: 'Copiado', txt: 'Descargar .txt',
    onPaper: 'Mostrar el texto sobre la foto', onPhoto: 'Mostrar la foto',
    pdf: 'Descargar PDF con el texto', rotate: 'Girar', invert: 'Letras claras sobre oscuro',
    pdfBusy: 'Montando el PDF…', pdfFail: 'No se pudo montar el PDF. Inténtelo otra vez o descargue el .txt.',
    pdfScript: 'Esa escritura no cabe en el PDF: la fuente cubre latín, cirílico y griego. Descargue el .txt.',
    crop: 'Leer solo un trozo', cropOn: 'Dibuje un recuadro en la foto', cropOff: 'Leer la foto entera',
    again: 'Otra foto', shaky: 'Revise {н} palabras: el lector no está seguro de ellas',
    counted: '{з} · {с}', charForms: ['carácter', 'caracteres', 'caracteres'], wordForms: ['palabra', 'palabras', 'palabras'],
    shakyOne: 'Revise {н} {ф} — el lector no está seguro', langTooMany: 'Más de dos alfabetos a la vez tarda más y no acierta más',
    noCam: 'La cámara no está disponible. Compruebe que no la tenga ocupada otro programa.',
    denied: 'No se dio acceso a la cámara. El permiso lo pide el propio navegador.',
    heavy: 'No se pudo traer el lector. Parece que se cortó la conexión: inténtelo otra vez.',
    notImage: 'Eso no es una imagen. Elija una foto: JPEG, PNG, WebP o HEIC.',
    shot: 'Tomar el fotograma',
  },
};

const с = СЛОВА[locale] || СЛОВА.ru;
// Азбука по умолчанию -- языка страницы: чаще всего читают на своём.
const ПО_ЯЗЫКУ = { ru: 'rus', uk: 'ukr', en: 'eng', es: 'spa' };
const своя = ПО_ЯЗЫКУ[locale] || 'rus';
---

<style is:inline set:html={css}></style>

<div class="тс" data-words={JSON.stringify(с)} data-locale={locale} data-lang={своя}>
  <!-- ВХОД -- ПРИГЛАШЕНИЕ. Пустого окна до выбора нет: смотреть в нём нечего. -->
  <div class="тс-старт" id="тс-старт">
    <svg class="тс-старт-знак" viewBox="0 0 24 24" aria-hidden="true">
      <rect x="3" y="4.5" width="18" height="15" rx="2.5"/>
      <path d="M7 9.5h10M7 13h7"/>
    </svg>
    <p class="тс-зов" id="тс-зов">{с.invite}</p>
    <p class="тс-или" id="тс-или">{с.or}</p>
    <span class="тс-ряд">
      <button type="button" class="тс-выбор" id="тс-камера" title={с.camera} aria-label={с.camera}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 8.5A2.5 2.5 0 0 1 5.5 6h1.7a1 1 0 0 0 .8-.4l1-1.3a1 1 0 0 1 .8-.4h4.4a1 1 0 0 1 .8.4l1 1.3a1 1 0 0 0 .8.4h1.7A2.5 2.5 0 0 1 21 8.5v8A2.5 2.5 0 0 1 18.5 19h-13A2.5 2.5 0 0 1 3 16.5Z"/><circle cx="12" cy="12.5" r="3.6"/></svg>
        <span>{с.camera}</span>
      </button>
      <button type="button" class="тс-выбор" id="тс-файл" title={с.file} aria-label={с.file}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="8.5" cy="10" r="1.6"/><path d="M21 16l-5-5-5 5-2-2-5 5"/></svg>
        <span>{с.file}</span>
      </button>
    </span>
    <!-- Полоса стоит прямо под плитками и всегда занимает своё место: пока она невидима,
         ничего не сдвигается, а появившись -- показывает, что файл пошёл в работу. -->
    <div class="тс-грузим" id="тс-грузим">
      <div class="тс-полоса"><i id="тс-полоса"></i></div>
      <div class="тс-грузим-шаг" id="тс-грузим-шаг"></div>
    </div>
  </div>


  <div class="тс-окно" id="тс-окно" hidden>
    <!-- Кадр обёрнут отдельно и ровно по картинке: рамки найденных строк кладутся на него, и
         при любом размере снимка они остаются на своих местах. Снимок с телефона -- это три
         тысячи точек по длинной стороне, и без ограничения высоты он занимал всю страницу. -->
    <span class="тс-кадр" id="тс-кадр">
      <video id="тс-видео" playsinline muted hidden></video>
      <img id="тс-снимок" alt="" />
      <span class="тс-слой" id="тс-слой"></span>
      <span class="тс-выдел" id="тс-выдел" hidden></span>
      <span class="тс-луч" id="тс-луч"></span>
    </span>
    <!-- ЛИСТ С ТЕКСТОМ на месте фотографии. Лежит в самом окне, а не в кадре: текст должен
         занимать всю ширину, а не жаться по ширине снимка. -->
    <span class="тс-лист" id="тс-лист" hidden></span>
  </div>

  <div class="тс-дела" id="тс-дела" hidden>
    <button type="button" class="тс-кнопка" id="тс-копи" title={с.copy} aria-label={с.copy}>
      <svg class="лист" viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M15 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h3"/></svg>
      <svg class="галка" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
    </button>
    <button type="button" class="тс-кнопка" id="тс-txt" title={с.txt} aria-label={с.txt}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11"/><path d="M7 11l5 5 5-5"/><path d="M5 19h14"/></svg>
    </button>
    <button type="button" class="тс-кнопка" id="тс-pdf" title={с.pdf} aria-label={с.pdf}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l5 5v13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 16.5h4"/></svg>
    </button>
    <button type="button" class="тс-кнопка" id="тс-поворот" title={с.rotate} aria-label={с.rotate}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.6-6.4"/><path d="M21 4v5h-5"/></svg>
    </button>
    <button type="button" class="тс-кнопка" id="тс-луна" title={с.invert} aria-label={с.invert}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z"/></svg>
    </button>
    <button type="button" class="тс-кнопка" id="тс-налисте" title={с.onPaper} aria-label={с.onPaper}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
    </button>
    <button type="button" class="тс-кнопка" id="тс-кусок" title={с.crop} aria-label={с.crop}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2v16h16"/><path d="M2 6h16v16"/></svg>
    </button>
    <button type="button" class="тс-кнопка" id="тс-ещё" title={с.again} aria-label={с.again}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg>
    </button>
    <span class="тс-счёт" id="тс-счёт"></span>
  </div>

  <div class="тс-ждём" id="тс-ждём" hidden></div>
  <div class="тс-текст" id="тс-текст" hidden></div>
  <div class="тс-беда" id="тс-беда"></div>
</div>

<script>
  import { подготовить, разобратьЧтение, сомнительных, прочитатьСамо } from '../lib/ocr.js';
  import { выбратьФайл } from '../lib/pick-file.js';

  const корень = document.querySelector('.тс');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const $ = (и) => document.getElementById(и);
    const старт = $('тс-старт'), окно = $('тс-окно'), снимок = $('тс-снимок'), слой = $('тс-слой');
    const выдел = $('тс-выдел'), дела = $('тс-дела'), текстЭ = $('тс-текст');
    const бедаЭ = $('тс-беда'), ждёмЭ = $('тс-ждём'), счёт = $('тс-счёт'), видео = $('тс-видео');
    const грузим = $('тс-грузим'), полоса = $('тс-полоса'), грузимШаг = $('тс-грузим-шаг');

    /**
     * АЗБУКУ ЧЕЛОВЕК НЕ ВЫБИРАЕТ -- это дело страницы, а не его.
     *
     * Берём азбуку языка страницы и добавляем латиницу: в русском и украинском тексте
     * латиница попадается постоянно -- названия, адреса, марки. Кириллические страницы берут
     * обе кириллические азбуки разом: «и» с «і» путают даже люди, а движку это стоит копейки.
     *
     * Так же это будет работать и на пятнадцатом языке: правило одно, списка выбора нет.
     */
    const НАБОРЫ = { ru: 'rus+ukr+eng', uk: 'ukr+rus+eng', en: 'eng', es: 'spa+eng' };
    // Каким языком просить официальный движок читать латиницу: берём язык страницы, а для
    // кириллических страниц -- английский, он же покрывает общую латиницу.
    const ЯЗЫК_ДВИЖКА = { ru: 'en', uk: 'en', en: 'en', es: 'es' }[корень.dataset.locale] || 'en';
    const языки = НАБОРЫ[корень.dataset.locale] || 'rus+eng';
    let картинка = null;          // готовый холст со снимком (уже повёрнутый)
    let поворот = 0;              // сколько раз повернули на 90°
    let исходник = null;          // то, что выбрал человек, до поворота
    let светлыйНаТёмном = false;
    let кусок = null;             // доля кадра, если обвели рамкой
    let выделяем = false;
    let читаем = false;
    let последнее = null;         // разбор последнего чтения
    let поток = null;

    const беда = (т) => { бедаЭ.textContent = т || ''; };

    /**
     * ПОЛОСА ЗАГРУЗКИ -- то, что человек видит сразу после выбора снимка.
     *
     * Под неё приезжают движок и азбука (несколько мегабайт в первый раз) и идёт само чтение.
     * Снимок показываем уже готовым, с обведёнными строками: так делают хорошие загрузчики --
     * сперва ход работы, потом результат, а не пустой экран с картинкой и неизвестностью.
     *
     * Доля честная: ход движка приходит от него самого, а шаги разложены по своим долям.
     */
    // Когда снимок открыт, полоса под плитками больше не её дело: работу показывает луч.
    // Без этого запасная азбука, приехавшая следом, снова зажигала полосу на уже открытом
    // снимке -- два показа работы разом.
    let полосаОтработала = false;
    function ползёт(доля, шаг) {
      if (полосаОтработала) return;
      грузим.classList.add('идёт');
      полоса.style.width = Math.max(0, Math.min(100, Math.round(доля * 100))) + '%';
      if (шаг) грузимШаг.textContent = шаг;
    }
    function полосуУбрать() {
      полосаОтработала = true;
      // Доводим до конца и гасим: рывок от середины сразу к исчезновению выглядит обрывом
      // работы, а не её завершением.
      ползёт(1, '');
      setTimeout(() => { грузим.classList.remove('идёт'); полоса.style.width = '0%'; грузимШаг.textContent = ''; }, 260);
    }
    const ждём = (т) => { ждёмЭ.textContent = т || ''; ждёмЭ.hidden = !т; };

    // Пальцем не перетаскивают: там, где нет мыши, зовём иначе.
    if (window.matchMedia && window.matchMedia('(hover: none)').matches) {
      $('тс-зов').textContent = с.inviteTouch;
      $('тс-или').hidden = true;
    }


    /* ---- Снимок ------------------------------------------------------------------------- */
    function показатьОкно(да) {
      окно.hidden = !да;
      старт.hidden = да;
      дела.hidden = !да;
    }

    /** Повернуть исходник на нужный угол и показать. Поворот нужен чаще, чем кажется: снятый
     *  боком лист движок читает как набор палок. */
    function перерисовать() {
      if (!исходник) return;
      const ш = исходник.width || исходник.naturalWidth;
      const в = исходник.height || исходник.naturalHeight;
      const боком = поворот % 2 === 1;
      const х = document.createElement('canvas');
      х.width = боком ? в : ш;
      х.height = боком ? ш : в;
      const к = х.getContext('2d');
      к.translate(х.width / 2, х.height / 2);
      к.rotate((поворот % 4) * Math.PI / 2);
      к.drawImage(исходник, -ш / 2, -в / 2);
      картинка = х;
      снимок.src = х.toDataURL('image/jpeg', 0.92);
      слой.replaceChildren();
    }

    async function взятьФайлВнутрь(файл) {
      if (!файл) return;
      беда('');
      // Полоса идёт ПОД ПЛИТКАМИ, а плитки остаются на месте: файл пошёл в работу, но
      // страница ещё не перестроилась. Перестроится она разом -- когда откроется снимок.
      полосаОтработала = false;
      ползёт(0.08, с.loadingWord);
      try {
        исходник = window.createImageBitmap
          ? await createImageBitmap(файл, { imageOrientation: 'from-image' })
          : await новаяКартинка(файл);
      } catch (е) {
        // HEIC -- то, чем снимает айфон по умолчанию. Браузер его не открывает (кроме Safari),
        // и без этой ветки человек просто возвращался на первый экран без объяснений.
        // Раскрыватель тот же, что на странице метаданных, и приезжает только сюда и сейчас.
        try {
          ползёт(0.2, с.loadingWord);
          const { раскрытьHeic, этоHeic } = await import('../lib/exif.js');
          const байты = await файл.arrayBuffer();
          if (!этоHeic(байты)) throw е;
          const точки = await раскрытьHeic(байты);
          const х = document.createElement('canvas');
          х.width = точки.width; х.height = точки.height;
          х.getContext('2d').putImageData(точки, 0, 0);
          исходник = х;
        } catch (е2) {
          полосуУбрать();
          беда(с.notImage);
          return;
        }
      }
      поворот = 0; кусок = null; выдел.hidden = true;
      перерисовать();
      await прочитать({ сНачала: true });
    }

    function новаяКартинка(файл) {
      const адрес = URL.createObjectURL(файл);
      return new Promise((готово, мимо) => {
        const и = new Image();
        и.onload = () => { готово(и); setTimeout(() => URL.revokeObjectURL(адрес), 1000); };
        и.onerror = () => { URL.revokeObjectURL(адрес); мимо(new Error('не картинка')); };
        и.src = адрес;
      });
    }

    /* ---- Чтение ------------------------------------------------------------------------- */
    /**
     * ЧТЕНИЕ -- ЭТО СКАНИРОВАНИЕ, И ВЫГЛЯДЕТЬ ОНО ДОЛЖНО ТАК ЖЕ.
     *
     * Порядок: полоса под плитками, пока едут файл и движок; потом на экране открывается
     * снимок, и по нему идёт луч -- ровно как у сканеров кодов; потом луч гаснет, строки
     * проявляются рамками, а текст печатается. Человек пришёл на сканер и должен видеть
     * сканирование, а не полосу загрузчика файлов.
     */
    async function прочитать({ сНачала = false } = {}) {
      if (!картинка || читаем) return;
      читаем = true;
      беда('');
      слой.replaceChildren();
      текстЭ.hidden = true;
      try {
        // Пока едут файлы -- полоса под плитками. Ни слова про движки и азбуки: человек
        // пришёл сканировать, внутренности его не касаются.
        let окноОткрыто = !сНачала;
        const открытьИПустьИдёт = () => {
          if (окноОткрыто) return;
          окноОткрыто = true;
          полосуУбрать();
          показатьОкно(true);
          окно.classList.add('сканирует');
          ждём(с.reading);
        };
        const начало = Date.now();
        if (!сНачала) { окно.classList.add('сканирует'); ждём(с.reading); }
        // СНАЧАЛА НЕЙРОСЕТЬ. Она находит куски текста на снимке и читает каждый отдельно --
        // потому и берёт фотографии товаров, вывесок и упаковок, где разбор строк бессилен.
        // Замер на фотографии пакета молока: нейросеть за две секунды вытащила «Partenariats
        // durables», «Rémunération garantie», «Issu de vaches nourries», а старый движок на
        // том же снимке выдал арабскую вязь.
        // ВСЯ ТЯЖЁЛАЯ РАБОТА -- В ОТДЕЛЬНОМ ПОТОКЕ. Раньше первый проход считался прямо здесь,
        // и страница подвисала: луч дёргался, кнопки отвечали с задержкой. Теперь читает
        // только официальный движок, а он работает в своём потоке.
        //
        // Азбуку определяем по итогу, а не заранее: читаем латиницей, смотрим, много ли вышло
        // настоящих букв, и если нет -- перечитываем кириллицей. Человеку выбирать нечего.
        //
        // КУСОК И ЛУНА ДЕЙСТВУЮТ И ЗДЕСЬ. Раньше нейросети уходил целый снимок как есть, а
        // обрезка с обращением цветов жили только в подготовке для запасного движка -- и обе
        // кнопки молчали, потому что до запасного дело почти не доходит.
        const кадрСети = кадрДляСети(картинка, { часть: кусок, светлыйНаТёмном });
        let черезСеть = null;
        try {
          const { прочитатьОфициальным } = await import('../lib/pp-ocr.js');
          открытьИПустьИдёт();
          // ПОРЯДОК ПО ЯЗЫКУ СТРАНИЦЫ: на русской странице снимок скорее русский, на
          // испанской -- латинский. Так первое же чтение обычно и оказывается верным, а
          // второго не случается вовсе.
          const своя = (корень.dataset.locale === 'ru' || корень.dataset.locale === 'uk')
            ? 'cyrillic' : 'latin';
          const чужая = своя === 'cyrillic' ? 'latin' : 'cyrillic';
          const словами = (и, какие) => (и && и.текст
            ? (и.текст.match(какие === 'cyrillic' ? /[А-Яа-яЁёЇїІіЄєҐґ]{3,}/g : /[A-Za-zÀ-ÿ]{3,}/g) || []).length
            : 0);

          const первое = await прочитатьОфициальным(кадрСети, своя);
          черезСеть = первое;
          // Слова чужой азбуки в чтении превращаются в обрывки. Перечитываем, только если
          // своих слов почти не набралось -- значит снимок не на нашем языке.
          if (словами(первое, своя) < 4) {
            const второе = await прочитатьОфициальным(кадрСети, чужая);
            if (словами(второе, чужая) > словами(первое, своя)) черезСеть = второе;
          }
        } catch (е) {
          window.__офицОшибка = String((е && е.message) || е);
          черезСеть = null;
        }

        const сетьСправилась = черезСеть && черезСеть.строки.length
          && (черезСеть.текст.match(/\p{L}/gu) || []).length >= 8
          && черезСеть.строки.reduce((н, с) => н + с.уверенность, 0) / черезСеть.строки.length >= 55;

        if (сетьСправилась) {
          открытьИПустьИдёт();
          const прошлоСеть = Date.now() - начало;
          if (прошлоСеть < 1100) await new Promise((г) => setTimeout(г, 1100 - прошлоСеть));
          // ЛУЧ ГАСИМ ПЕРЕД ПОКАЗОМ. Иначе выходит нелепость: текст уже внизу, а по снимку
          // всё ещё бежит полоса, будто работа идёт. Владелец это и увидел.
          окно.classList.remove('сканирует');
          последнее = отСети(черезСеть, кадрСети);
          window.__тс = { движок: 'сеть', азбука: черезСеть.азбука, строк: черезСеть.строки.length };
          показатьТекст(последнее);
          ждём('');
          читаем = false;
          return;
        }

        // ПОДГОТОВКА СНИМКА -- ТОЛЬКО ЗДЕСЬ. Выравнивание наклона и местные пороги считаются
        // в главном потоке и на снимке с телефона занимают его на секунды: луч дёргался,
        // кнопки отвечали с задержкой. Нейросети эта работа не нужна вовсе, поэтому делаем
        // её лишь тогда, когда до запасного движка действительно дошло.
        const холст = подготовить(картинка, {
          ш: картинка.width, в: картинка.height, часть: кусок, светлыйНаТёмном,
        });
        // Азбуку подбираем САМИ: сперва своя с латиницей, а не вышло -- перебираем другие
        // письменности. Человек ничего не выбирает и об этом не читает.
        const { data, набор: чем, подбирали, канал: каналВыбран, холст: чемЧитали } = await прочитатьСамо(холст, {
          база: языки,
          // Отдаём исходную картинку: подбор может пересобрать кадр по другому цветовому
          // каналу -- на пёстрой упаковке это решает больше, чем выбор языка.
          картинка,
          видКадра: { ш: картинка.width, в: картинка.height, часть: кусок, светлыйНаТёмном },
          ход: ({ доля, что }) => {
            if (!сНачала) return;
            if (/load|init/i.test(что || '')) ползёт(0.1 + (доля || 0) * 0.6, с.loadingWord);
            else открытьИПустьИдёт();
          },
        });
        открытьИПустьИдёт();
        // Даём лучу пройти хотя бы раз: чтение бывает быстрее взгляда, и без этой паузы
        // сканирование мелькнуло бы и исчезло, будто ничего и не было.
        const прошло = Date.now() - начало;
        if (прошло < 1100) await new Promise((г) => setTimeout(г, 1100 - прошло));
        const читанный = чемЧитали || холст;
        последнее = разобратьЧтение(data, { ш: читанный.width, в: читанный.height, часть: кусок });
        // Крючок для живых проверок: каким набором прочитано и подбирали ли его. Человеку это
        // не показывается -- ему всё равно, чем именно прочитано.
        window.__тс = { набор: чем, подбирали, канал: каналВыбран || 'серый', уверенность: последнее.уверенность };
        окно.classList.remove('сканирует');
        ждём('');
        показатьТекст(последнее);
      } catch (е) {
        окно.classList.remove('сканирует');
        if (сНачала) { полосуУбрать(); показатьОкно(true); }
        ждём('');
        беда(с.heavy);
      }
      читаем = false;
    }

    /**
     * «1 слово», «2 слова», «5 слов». Машинное «21 слов» в счётчике сразу выдаёт поделку, а
     * правило простое и одинаковое для русского с украинским; в английском и испанском формы
     * совпадают, и таблица просто отдаёт то же слово.
     */
    function склонить(н, формы) {
      if (!формы) return '';
      const с100 = Math.abs(н) % 100, с10 = с100 % 10;
      if (с100 > 10 && с100 < 20) return формы[2];
      if (с10 === 1) return формы[0];
      if (с10 >= 2 && с10 <= 4) return формы[1];
      return формы[2];
    }

    /**
     * Ответ нейросети в общий вид. Она отдаёт готовые строки с рамками -- слова внутри строки
     * делим сами: подсветка и пометки неуверенных слов устроены одинаково для обоих движков.
     */
    function отСети(итог, кадр) {
      const абзацы = [{ строки: итог.строки.map((с) => ({
        текст: с.текст,
        уверенность: с.уверенность,
        место: местоРамки(с.рамка, кадр),
        слова: с.текст.split(/(\s+)/).filter((ч) => ч.trim()).map((сл) => ({
          текст: сл, уверенность: с.уверенность, место: местоРамки(с.рамка, кадр),
        })),
      })) }];
      const текст = итог.строки.map((с) => с.текст).join('\n');
      return { абзацы, текст, уверенность: Math.round(
        итог.строки.reduce((н, с) => н + с.уверенность, 0) / Math.max(1, итог.строки.length)) };
    }

    /**
     * Рамка сети -- четыре угла в точках ТОГО кадра, который читали. А рисуются рамки поверх
     * всего снимка, поэтому доли пересчитываем обратно в его координаты: когда выделен кусок,
     * без этого подсветка строк уезжала бы в левый верхний угол.
     */
    function местоРамки(рамка, кадр) {
      const хс = рамка.углы.map((т) => т[0]), ус = рамка.углы.map((т) => т[1]);
      const ш = (кадр && кадр.width) || картинка.width || 1;
      const в = (кадр && кадр.height) || картинка.height || 1;
      const к = кусок || { х: 0, у: 0, ш: 1, в: 1 };
      const х = Math.min(...хс) / ш, у = Math.min(...ус) / в;
      return {
        х: к.х + х * к.ш,
        у: к.у + у * к.в,
        ш: (Math.max(...хс) - Math.min(...хс)) / ш * к.ш,
        в: (Math.max(...ус) - Math.min(...ус)) / в * к.в,
      };
    }

    /**
     * КАДР ДЛЯ НЕЙРОСЕТИ: только обрезка и обращение цветов, больше ничего.
     *
     * Тяжёлая подготовка (серое, местный порог, выравнивание наклона) сети не нужна и даже
     * вредна -- её учили на обычных цветных фотографиях. Но две вещи человек выбирает сам, и
     * они должны доходить и сюда: выделенный кусок и «светлые буквы на тёмном».
     */
    function кадрДляСети(источник, { часть = null, светлыйНаТёмном: наТёмном = false } = {}) {
      if (!часть && !наТёмном) return источник;     // делать нечего -- отдаём снимок как есть
      const ш = источник.width, в = источник.height;
      const кх = часть ? Math.round(часть.х * ш) : 0;
      const ку = часть ? Math.round(часть.у * в) : 0;
      const кш = часть ? Math.max(8, Math.round(часть.ш * ш)) : ш;
      const кв = часть ? Math.max(8, Math.round(часть.в * в)) : в;
      const холст = document.createElement('canvas');
      холст.width = кш; холст.height = кв;
      const кон = холст.getContext('2d', { willReadFrequently: наТёмном });
      кон.drawImage(источник, кх, ку, кш, кв, 0, 0, кш, кв);
      if (наТёмном) {
        // Обращаем цвета, а не яркость: на тёмном снимке экрана буквы становятся тёмными на
        // светлом, и сеть видит привычную ей картину.
        const точки = кон.getImageData(0, 0, кш, кв);
        const д = точки.data;
        for (let и = 0; и < д.length; и += 4) {
          д[и] = 255 - д[и]; д[и + 1] = 255 - д[и + 1]; д[и + 2] = 255 - д[и + 2];
        }
        кон.putImageData(точки, 0, 0);
      }
      return холст;
    }

    function показатьТекст(разбор) {
      текстЭ.hidden = false;
      // Перерисовать лист поверх снимка: он включён по умолчанию, значит должен появиться
      // вместе с текстом, а не по второму нажатию.
      setTimeout(() => {
        if (!наЛисте) return;
        нарисоватьЛист();
        $('тс-лист').hidden = false;
        слой.hidden = true;
        текстЭ.hidden = true;          // текст уже на снимке -- внизу он был бы вторым разом
        $('тс-налисте').classList.add('взята');
        $('тс-налисте').title = с.onPhoto;
      }, 0);
      текстЭ.replaceChildren();
      слой.replaceChildren();
      if (!разбор.абзацы.length) {
        const п = document.createElement('p');
        п.className = 'тс-пусто';
        п.textContent = с.nothing + '. ' + с.nothingWhy;
        текстЭ.appendChild(п);
        счёт.textContent = '';
        return;
      }
      // Строки выходят одна за другой, и вместе с каждой зажигается её рамка на снимке:
      // текст будто снимается с фотографии. Весь показ укладываем в полсекунды, сколько бы
      // строк ни было, -- украшение не должно превращаться в ожидание.
      const всегоСтрок = разбор.абзацы.reduce((н, а) => н + а.строки.length, 0);
      const шаг = Math.min(45, Math.max(8, Math.round(500 / Math.max(1, всегоСтрок))));
      let номерСтроки = 0;
      for (const абзац of разбор.абзацы) {
        const п = document.createElement('p');
        п.className = 'тс-абзац';
        for (const строка of абзац.строки) {
          const э = document.createElement('span');
          э.className = 'тс-стр';
          // Слова с низкой уверенностью подчёркиваем волной: человек сразу видит, что
          // проверить, вместо того чтобы перечитывать всё подряд.
          for (const слово of строка.слова) {
            const сл = document.createElement('span');
            сл.textContent = слово.текст + ' ';
            if (слово.уверенность < 70) сл.className = 'тс-шатко';
            э.appendChild(сл);
          }
          э.appendChild(document.createTextNode('\n'));
          // Рамка этой же строки поверх снимка -- и связь между ними по наведению.
          э.style.animationDelay = (номерСтроки * шаг) + 'ms';
          const рамка = document.createElement('span');
          рамка.className = 'тс-строка-рамка';
          рамка.style.animationDelay = (номерСтроки * шаг) + 'ms';
          номерСтроки++;
          рамка.style.left = (строка.место.х * 100) + '%';
          рамка.style.top = (строка.место.у * 100) + '%';
          рамка.style.width = (строка.место.ш * 100) + '%';
          рамка.style.height = (строка.место.в * 100) + '%';
          слой.appendChild(рамка);
          э.addEventListener('mouseenter', () => рамка.classList.add('горит'));
          э.addEventListener('mouseleave', () => рамка.classList.remove('горит'));
          п.appendChild(э);
        }
        текстЭ.appendChild(п);
      }
      const знаков = разбор.текст.length;
      const слов = разбор.текст.split(/\s+/).filter(Boolean).length;
      const { плохих } = сомнительных(разбор.абзацы);
      счёт.textContent = с.counted
          .replace('{з}', знаков + ' ' + склонить(знаков, с.charForms))
          .replace('{с}', слов + ' ' + склонить(слов, с.wordForms))
        + (плохих ? ' · ' + с.shakyOne.replace('{н}', плохих)
            .replace('{ф}', склонить(плохих, с.wordForms)) : '');
    }

    /* ---- Выделение куска ---------------------------------------------------------------- */
    let началоВыдел = null;
    окно.addEventListener('pointerdown', (е) => {
      if (!выделяем || !картинка) return;
      const р = снимок.getBoundingClientRect();
      началоВыдел = { х: (е.clientX - р.left) / р.width, у: (е.clientY - р.top) / р.height };
      выдел.hidden = false;
      обновитьВыдел(началоВыдел, началоВыдел);
      окно.setPointerCapture(е.pointerId);
    });
    окно.addEventListener('pointermove', (е) => {
      if (!началоВыдел) return;
      const р = снимок.getBoundingClientRect();
      обновитьВыдел(началоВыдел, {
        х: Math.min(1, Math.max(0, (е.clientX - р.left) / р.width)),
        у: Math.min(1, Math.max(0, (е.clientY - р.top) / р.height)),
      });
    });
    окно.addEventListener('pointerup', () => {
      if (!началоВыдел || !кусок) { началоВыдел = null; return; }
      началоВыдел = null;
      // Слишком маленькую рамку считаем промахом пальца, а не выбором.
      if (кусок.ш < 0.04 || кусок.в < 0.02) { кусок = null; выдел.hidden = true; return; }
      выделяем = false;
      $('тс-кусок').classList.remove('взята');
      $('тс-кусок').title = с.crop;
      окно.classList.remove('выделяем');
      ждём('');
      прочитать();
    });
    function обновитьВыдел(а, б) {
      const х = Math.min(а.х, б.х), у = Math.min(а.у, б.у);
      const ш = Math.abs(б.х - а.х), в = Math.abs(б.у - а.у);
      кусок = { х, у, ш, в };
      выдел.style.left = (х * 100) + '%';
      выдел.style.top = (у * 100) + '%';
      выдел.style.width = (ш * 100) + '%';
      выдел.style.height = (в * 100) + '%';
    }

    /* ---- Действия ------------------------------------------------------------------------ */
    const отдать = (капля, имя) => {
      const а = document.createElement('a');
      а.href = URL.createObjectURL(капля);
      а.download = имя;
      document.body.appendChild(а);
      а.click();
      setTimeout(() => { URL.revokeObjectURL(а.href); а.remove(); }, 1000);
    };

    $('тс-копи').addEventListener('click', async () => {
      if (!последнее) return;
      try { await navigator.clipboard.writeText(последнее.текст); } catch (е) {}
      const к = $('тс-копи');
      к.classList.add('готово');
      setTimeout(() => к.classList.remove('готово'), 1400);
    });
    $('тс-txt').addEventListener('click', () => {
      if (!последнее) return;
      отдать(new Blob([последнее.текст], { type: 'text/plain;charset=utf-8' }), 'text.txt');
    });
    // PDF -- ТЕКСТОВЫЙ ДОКУМЕНТ, А НЕ СНИМОК В ОБОЛОЧКЕ. Раньше файл отдавал Tesseract
    // (картинка плюс невидимый слой букв), и с переходом на официальный движок кнопка
    // замолчала совсем: до Tesseract дело больше не доходит. Теперь собираем сами -- из тех
    // же строк, что человек видит на странице, поэтому работает при любом движке.
    let собираемPdf = false;
    $('тс-pdf').addEventListener('click', async () => {
      if (!последнее || !последнее.абзацы.length || собираемPdf) return;
      собираемPdf = true;
      const кнопка = $('тс-pdf');
      кнопка.classList.add('ждёт');
      ждём(с.pdfBusy);
      try {
        const { собратьPdf, долянеЗнакомых } = await import('../lib/pdf-text.js');
        // Шрифт в файле -- подмножество: латиница, кириллица, греческий. Иврит, арабский и
        // иероглифы Tesseract прочитать может, а положить их в PDF нечем. Молча отдать лист
        // вопросительных знаков хуже, чем сказать прямо.
        if (await долянеЗнакомых(последнее.текст) > 0.2) { ждём(с.pdfScript); return; }
        отдать(new Blob([await собратьPdf(последнее.абзацы, { заголовок: document.title })],
          { type: 'application/pdf' }), 'text.pdf');
        ждём('');
      } catch (е) {
        ждём(с.pdfFail);
      } finally {
        кнопка.classList.remove('ждёт');
        собираемPdf = false;
      }
    });
    $('тс-поворот').addEventListener('click', () => {
      if (!исходник) return;
      поворот = (поворот + 1) % 4;
      кусок = null; выдел.hidden = true;
      перерисовать();
      прочитать();
    });
    $('тс-луна').addEventListener('click', () => {
      светлыйНаТёмном = !светлыйНаТёмном;
      $('тс-луна').classList.toggle('взята', светлыйНаТёмном);
      прочитать();
    });
    $('тс-кусок').addEventListener('click', () => {
      if (кусок) {         // кусок уже выбран -- вторым нажатием возвращаем весь снимок
        кусок = null; выдел.hidden = true; выделяем = false;
        $('тс-кусок').classList.remove('взята');
        $('тс-кусок').title = с.crop;
        окно.classList.remove('выделяем');
        прочитать();
        return;
      }
      выделяем = !выделяем;
      $('тс-кусок').classList.toggle('взята', выделяем);
      окно.classList.toggle('выделяем', выделяем);
      ждём(выделяем ? с.cropOn : '');
    });
    // ТЕКСТ НА МЕСТЕ ФОТОГРАФИИ. Строки ставим по их же рамкам и подгоняем кегль под высоту
    // строки: получается «перепечатанный» лист, с которого удобно читать и сверять.
    // Текст на месте фотографии показываем СРАЗУ: человек пришёл за текстом, а снимок он и
    // так только что видел. Кнопка переключает обратно -- сверить, если нужно.
    let наЛисте = true;
    function нарисоватьЛист() {
      const лист = $('тс-лист');
      лист.replaceChildren();
      if (!последнее) return;
      // Строки идут потоком, а не по местам со снимка: это текст, и выглядеть он должен
      // текстом. Где что было на фотографии -- показывает переключение на снимок.
      for (const абзац of последнее.абзацы) for (const строка of абзац.строки) {
        const э = document.createElement('span');
        э.className = 'тс-лист-строка';
        э.textContent = строка.текст;
        лист.appendChild(э);
      }
    }
    $('тс-налисте').addEventListener('click', () => {
      наЛисте = !наЛисте;
      $('тс-налисте').classList.toggle('взята', наЛисте);
      $('тс-налисте').title = наЛисте ? с.onPhoto : с.onPaper;
      if (наЛисте) нарисоватьЛист();
      $('тс-лист').hidden = !наЛисте;
      слой.hidden = наЛисте;
      // Один и тот же текст дважды на экране -- лишнее: он либо на снимке, либо под ним.
      текстЭ.hidden = наЛисте;
    });

    $('тс-ещё').addEventListener('click', () => {
      картинка = null; исходник = null; последнее = null; кусок = null; поворот = 0;
      выдел.hidden = true; слой.replaceChildren();
      снимок.removeAttribute('src');
      наЛисте = true; $('тс-лист').hidden = true; $('тс-лист').replaceChildren();
      $('тс-налисте').classList.add('взята'); слой.hidden = false;
      текстЭ.hidden = true; текстЭ.replaceChildren();
      счёт.textContent = '';
      показатьОкно(false);
      грузим.hidden = true;
      беда(''); ждём('');
      выключитьКамеру();
    });

    /* ---- Откуда берём снимок -------------------------------------------------------------- */
    $('тс-файл').addEventListener('click', async () => {
      const файл = await выбратьФайл({ берём: 'image/*' });
      if (файл) взятьФайлВнутрь(файл);
    });

    function выключитьКамеру() {
      if (поток) { for (const д of поток.getTracks()) д.stop(); поток = null; }
      видео.srcObject = null; видео.hidden = true;
      снимок.hidden = false;
    }

    $('тс-камера').addEventListener('click', async () => {
      // На телефоне проще снять родной камерой: кадр приходит настоящим снимком, а не
      // кадром из потока -- он резче, и текст читается лучше.
      if (window.matchMedia && window.matchMedia('(hover: none)').matches) {
        const файл = await выбратьФайл({ берём: 'image/*', съёмка: 'environment' });
        if (файл) взятьФайлВнутрь(файл);
        return;
      }
      try {
        поток = await navigator.mediaDevices.getUserMedia({
          video: { facingMode: { ideal: 'environment' }, width: { ideal: 1920 }, height: { ideal: 1080 } },
          audio: false,
        });
      } catch (е) {
        беда(е && е.name === 'NotAllowedError' ? с.denied : с.noCam);
        return;
      }
      видео.srcObject = поток;
      видео.hidden = false;
      снимок.hidden = true;
      показатьОкно(true);
      await видео.play().catch(() => {});
      ждём(с.shot);
      // Кадр берём по нажатию на окно: держать снимок в руке и целиться удобнее, чем искать
      // отдельную кнопку.
      const снять = () => {
        if (!поток || !видео.videoWidth) return;
        const х = document.createElement('canvas');
        х.width = видео.videoWidth; х.height = видео.videoHeight;
        х.getContext('2d').drawImage(видео, 0, 0);
        исходник = х;
        выключитьКамеру();
        поворот = 0; кусок = null; выдел.hidden = true;
        перерисовать();
        ждём('');
        прочитать();
        окно.removeEventListener('click', снять);
      };
      окно.addEventListener('click', снять);
    });

    // Крючок для живых проверок: прочитать нынешний снимок названной азбукой и вернуть, что
    // вышло. Человеку он не виден и ничего не меняет -- но без него проверка не может
    // спросить «а китайской азбукой читается?», не переписывая половину страницы.
    // Крючок для опыта с нейросетью PP-OCR: пока держим рядом со старым движком, чтобы
    // сравнить их на одних и тех же снимках -- числами, а не на глаз.
    // Опыт с официальным SDK PaddleOCR: сравниваем его постобработку с нашей на одних снимках.
    window.__паддл = async (язык, версия) => {
      const т0 = Date.now();
      const { PaddleOCR } = await import('@paddleocr/paddleocr-js');
      const ocr = await PaddleOCR.create({ lang: язык || 'fr', ocrVersion: версия || 'PP-OCRv6' });
      const холст = document.createElement('canvas');
      холст.width = картинка.width; холст.height = картинка.height;
      холст.getContext('2d').drawImage(картинка, 0, 0);
      const капля = await new Promise((г) => холст.toBlob(г, 'image/jpeg', 0.92));
      const [итог] = await ocr.predict(капля);
      return {
        текст: (итог.items || []).map((и) => и.text).join(' '),
        строк: (итог.items || []).length,
        мс: Date.now() - т0,
      };
    };

    window.__офиц = async (азбука) => {
      const { прочитатьОфициальным } = await import('../lib/pp-ocr.js');
      const т0 = Date.now();
      const и = await прочитатьОфициальным(картинка, азбука || 'latin');
      return { текст: и.текст, строк: и.строки.length, мс: Date.now() - т0,
        рамка: JSON.stringify(и.строки[0] && и.строки[0].рамка || null).slice(0, 200) };
    };

    window.__ппOCR = async (настройки) => {
      const { прочитатьСнимок } = await import('../lib/pp-ocr.js');
      if (!картинка) return { беда: 'снимка нет' };
      const т0 = Date.now();
      const итог = await прочитатьСнимок(картинка, настройки || {});
      return { текст: итог.текст, строк: итог.строки.length, азбука: итог.азбука, мс: Date.now() - т0 };
    };

    // Крючок для опытов: даёт пробе поднять чтеца и прочитать ЛЮБОЙ холст. Нужен, чтобы
    // подбирать обработку на настоящих снимках, а не на рисованных.
    window.__тсДвижок = async () => {
      const м = await import('../lib/ocr.js');
      return { поднятьЧтеца: м.поднятьЧтеца, подготовить: м.подготовить, разобратьЧтение: м.разобратьЧтение };
    };

    window.__тсПрочитать = async (набор, какЕсть) => {
      if (!картинка) return { беда: 'снимка нет' };
      const холст = какЕсть === true ? картинка : подготовить(картинка, {
        ш: картинка.width, в: картинка.height, часть: кусок, светлыйНаТёмном,
        ...(какЕсть && typeof какЕсть === 'object' ? какЕсть : {}),
      });
      try {
        const { поднятьЧтеца } = await import('../lib/ocr.js');
        const чтец = await поднятьЧтеца(набор);
        const { data } = await чтец.recognize(холст, {}, { text: true, blocks: true });
        // Разбираем через blocks: data.text в браузере приходит пустым всегда.
        const р = разобратьЧтение(data, { ш: холст.width, в: холст.height });
        return { текст: р.текст.trim().slice(0, 80), уверенность: р.уверенность, строк: р.абзацы.length };
      } catch (е) { return { беда: String(е && е.message || е) }; }
    };

    /* ---- Перетаскивание -------------------------------------------------------------------- */
    for (const имя of ['dragenter', 'dragover']) {
      старт.addEventListener(имя, (е) => { е.preventDefault(); старт.classList.add('держат'); });
    }
    for (const имя of ['dragleave', 'dragend']) {
      старт.addEventListener(имя, () => старт.classList.remove('держат'));
    }
    старт.addEventListener('drop', (е) => {
      е.preventDefault();
      старт.classList.remove('держат');
      const файл = е.dataTransfer && е.dataTransfer.files && е.dataTransfer.files[0];
      if (файл) взятьФайлВнутрь(файл);
    });
    // Снимок экрана вставляют из буфера -- это самый частый способ принести текст с экрана.
    window.addEventListener('paste', (е) => {
      const части = е.clipboardData && е.clipboardData.items;
      if (!части) return;
      for (const ч of части) {
        if (ч.type && ч.type.startsWith('image/')) { взятьФайлВнутрь(ч.getAsFile()); break; }
      }
    });
    window.addEventListener('pagehide', выключитьКамеру);
  })();
</script>
