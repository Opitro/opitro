---
// ЧТО ФОТОАППАРАТ ЗАПИСАЛ ВНУТРЬ СНИМКА.
//
// Страница читает файл целиком на устройстве: разбор свой (src/lib/exif.js), ничего не
// скачивается и никуда не отправляется. Для этого инструмента обещание про браузер весомее,
// чем где-либо ещё: он показывает человеку координаты места, где тот стоял с телефоном в
// руках, -- и отправлять такой файл куда-то было бы прямым предательством.
//
// Что показываем: снимок (размер, вес), камеру, съёмку, место. Ниже -- кнопка «показать все
// поля»: там лежит то, что мы не назвали по-человечески, но что в файле есть. Скрывать это
// нельзя -- человек пришёл смотреть, что внутри, а не читать нашу выборку.
import css from '../styles/exif-view.css?inline';

export interface Props { locale?: string }
const { locale = 'ru' } = Astro.props;

