        общие: {
          3: ['три', 'трёх', 'трём', 'три', 'тремя', 'трёх'],
          4: ['четыре', 'четырёх', 'четырём', 'четыре', 'четырьмя', 'четырёх'],
          5: ['пять', 'пяти', 'пяти', 'пять', 'пятью', 'пяти'],
          6: ['шесть', 'шести', 'шести', 'шесть', 'шестью', 'шести'],
          7: ['семь', 'семи', 'семи', 'семь', 'семью', 'семи'],
