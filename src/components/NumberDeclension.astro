---
// СКЛОНЕНИЕ ЧИСЛИТЕЛЬНЫХ -- и формы числительных там, где падежей нет.
//
// В английском и испанском падежей у числительных НЕТ вовсе, и таблица из шести падежей
// была бы выдумкой. Поэтому на этих языках страница показывает три формы, в которых
// действительно ошибаются: количественное, порядковое и третью -- чековую запись для
// английского, женский род для испанского.
//
// ГЛАВНОЕ ПРАВИЛО СЛАВЯНСКИХ: в составном числительном склоняется КАЖДОЕ слово, а внутри
// сотен и десятков -- ещё и оба корня: «пятьюстами сорока двумя». Поэтому формы заданы
// таблицами целиком, а не собраны из окончаний: собрать их правилом нельзя.
//
// ОДУШЕВЛЁННОСТЬ меняет винительный только у ПРОСТЫХ один, два, три, четыре. У составных
// норма требует формы именительного: «принять двадцать два студента», а не «двадцать двух».
// В задании пример был обратный и неверный -- мы делаем по норме.
//
// Ничего никуда не уходит: всё считается в браузере.
import css from '../styles/number-declension.css?inline';

const { locale = 'ru' } = Astro.props;
const падежный = locale === 'ru' || locale === 'uk';

const СЛОВА = {
  ru: {
    gender: 'Род', male: 'Мужской', female: 'Женский', neuter: 'Средний',
