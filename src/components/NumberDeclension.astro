    empty: 'Введите число — таблица падежей появится здесь.',
    errBig: 'Слишком большое число: склоняем до триллионов.',
    copy: 'Копировать', copied: 'Готово',
    clearAll: 'Очистить всё',
    ряды: [
      ['Именительный', 'кто? что?'], ['Родительный', 'кого? чего?'],
