    n5: 'Everything is computed in your browser. Numbers are never sent anywhere and never stored.',
    n6: '',
  },
  es: {
    place: 'Escribe un número, por ejemplo 542',
    head: 'Formas del número',
    empty: 'Escribe un número: las formas aparecerán aquí.',
    errBig: 'Demasiado grande: escribimos en letras hasta los billones.',
    copy: 'Copiar', copied: 'Hecho',
    clearAll: 'Limpiar todo',
    ряды: [
      ['Cardinal', '¿cuántos?'], ['Ordinal', '¿en qué orden?'],
      ['Femenino', 'concordancia de género'],
    ],
    n1: '<b>El español no tiene casos gramaticales.</b> El número no cambia según su función en la frase, así que una tabla de seis casos sería un invento. Lo que sí cambia son las formas: cardinal, ordinal y la concordancia de género.',
    n2: '<b>Los ordinales grandes no los recuerda nadie.</b> Quinientos se convierte en quingentésimo, novecientos en noningentésimo: la raíz cambia por completo. Por eso en la práctica se escriben en cifras, y cuando hace falta la palabra, hay que consultarla.',
    n3: '<b>El femenino afecta a los cientos y al uno.</b> «Quinientas cuarenta y dos páginas», «veintiuna casas», «doscientas grivnas». Es el error más frecuente al escribir cantidades de cosas en femenino.',
    n4: '<b>Ordinales solo hasta el 9999.</b> Más allá las formas existen pero son librescas y discutidas entre gramáticos; preferimos no darlas antes que dar una inventada.',
    n5: 'Todo se calcula en tu navegador. Los números no se envían a ninguna parte ni se guardan.',
    n6: '',
  },
};
const с = СЛОВА[locale] || СЛОВА.ru;
const заметки = [с.n1, с.n2, с.n3, с.n4, с.n5, с.n6].filter(Boolean);
---

<style is:inline set:html={css}></style>

<div class="скл" data-words={JSON.stringify(с)} data-locale={locale}>
  {падежный && (
    <div class="скл-верх">
      <span class="скл-подпись">{с.gender}:</span>
      <div class="скл-кнопки" role="group">
        <button type="button" class="скл-выбор выбран" id="скл-м">{с.male}</button>
        <button type="button" class="скл-выбор" id="скл-ж">{с.female}</button>
        <button type="button" class="скл-выбор" id="скл-с">{с.neuter}</button>
      </div>
      <span class="скл-подпись">{с.obj}:</span>
      <div class="скл-кнопки" role="group">
        <button type="button" class="скл-выбор выбран" id="скл-вещи">{с.things}</button>
        <button type="button" class="скл-выбор" id="скл-люди">{с.people}</button>
      </div>
    </div>
  )}

  <input class="скл-число" id="скл-ввод" type="text" inputmode="numeric" placeholder={с.place}
    spellcheck="false">

  <div class="скл-таблица" id="скл-таблица">
    <div class="скл-пусто">{с.empty}</div>
  </div>

  <div class="скл-низ">
    <button type="button" class="скл-простая" id="скл-очистить">{с.clearAll}</button>
  </div>

  <div class="скл-заметки">
    {заметки.map((з) => <div class="скл-заметка" set:html={з}></div>)}
  </div>
</div>

<script>
  const корень = document.querySelector('.скл');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const язык = корень.dataset.locale || 'ru';
    const падежный = язык === 'ru' || язык === 'uk';
    const $ = (и) => document.getElementById(и);
    const ввод = $('скл-ввод');
    const окно = $('скл-таблица');
    let род = 'м';
    let одушевлённое = false;

    /* СКЛОНЕНИЕ ЧИСЛИТЕЛЬНЫХ ПО ПАДЕЖАМ.
     *
     * Порядок падежей: именительный, родительный, дательный, винительный, творительный,
     * предложный (в украинском -- місцевий).
     *
     * В составном числительном склоняется КАЖДОЕ слово, а внутри сотен и десятков -- ещё и
     * оба корня: «пятьюстами сорока двумя». Поэтому таблицы заданы целиком, а не собраны
     * из окончаний.
     */

    const И = 0, Р = 1, Д = 2, В = 3, Т = 4, П = 5;

    /* ---- Русский --------------------------------------------------------------------------- */

    const РУ = {
      единицы: {
        м: {
          1: ['один', 'одного', 'одному', 'один', 'одним', 'одном'],
          2: ['два', 'двух', 'двум', 'два', 'двумя', 'двух'],
        },
        ж: {
          1: ['одна', 'одной', 'одной', 'одну', 'одной', 'одной'],
          2: ['две', 'двух', 'двум', 'две', 'двумя', 'двух'],
        },
        с: {
          1: ['одно', 'одного', 'одному', 'одно', 'одним', 'одном'],
          2: ['два', 'двух', 'двум', 'два', 'двумя', 'двух'],
