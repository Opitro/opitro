        9: ["дев'яносто", "дев'яноста", "дев'яноста", "дев'яносто", "дев'яноста", "дев'яноста"],
      },
      сотни: {
        1: ['сто', 'ста', 'ста', 'сто', 'ста', 'ста'],
        2: ['двісті', 'двохсот', 'двомстам', 'двісті', 'двомастами', 'двохстах'],
        3: ['триста', 'трьохсот', 'трьомстам', 'триста', 'трьомастами', 'трьохстах'],
        4: ['чотириста', 'чотирьохсот', 'чотирьомстам', 'чотириста', 'чотирмастами', 'чотирьохстах'],
        5: ["п'ятсот", "п'ятисот", "п'ятистам", "п'ятсот", "п'ятьмастами", "п'ятистах"],
        6: ['шістсот', 'шестисот', 'шестистам', 'шістсот', 'шістьмастами', 'шестистах'],
        7: ['сімсот', 'семисот', 'семистам', 'сімсот', 'сьомастами', 'семистах'],
        8: ['вісімсот', 'восьмисот', 'восьмистам', 'вісімсот', 'вісьмастами', 'восьмистах'],
        9: ["дев'ятсот", "дев'ятисот", "дев'ятистам", "дев'ятсот", "дев'ятьмастами", "дев'ятистах"],
      },
      разряды: [
        null,
        { род: 'ж',
          ед: ['тисяча', 'тисячі', 'тисячі', 'тисячу', 'тисячею', 'тисячі'],
          мн: ['тисячі', 'тисяч', 'тисячам', 'тисячі', 'тисячами', 'тисячах'],
          двеЧетыре: 'тисячі', многие: 'тисяч' },
        { род: 'м',
          ед: ['мільйон', 'мільйона', 'мільйону', 'мільйон', 'мільйоном', 'мільйоні'],
          мн: ['мільйони', 'мільйонів', 'мільйонам', 'мільйони', 'мільйонами', 'мільйонах'],
          двеЧетыре: 'мільйони', многие: 'мільйонів' },
        { род: 'м',
          ед: ['мільярд', 'мільярда', 'мільярду', 'мільярд', 'мільярдом', 'мільярді'],
          мн: ['мільярди', 'мільярдів', 'мільярдам', 'мільярди', 'мільярдами', 'мільярдах'],
          двеЧетыре: 'мільярди', многие: 'мільярдів' },
        { род: 'м',
          ед: ['трильйон', 'трильйона', 'трильйону', 'трильйон', 'трильйоном', 'трильйоні'],
          мн: ['трильйони', 'трильйонів', 'трильйонам', 'трильйони', 'трильйонами', 'трильйонах'],
          двеЧетыре: 'трильйони', многие: 'трильйонів' },
      ],
      ноль: ['нуль', 'нуля', 'нулю', 'нуль', 'нулем', 'нулі'],
      предлог: 'на',
    };

    const ТАБЛИЦЫ = { ru: РУ, uk: УК };

    /** Подростки склоняются одинаково: мягкий знак меняется на «и», в творительном на «ью». */
    function подростокФормы(слово, язык) {
      const осн = слово.slice(0, -1);
      if (язык === 'uk') return [слово, осн + 'и', осн + 'и', слово, осн + 'ьма', осн + 'и'];
      return [слово, осн + 'и', осн + 'и', слово, осн + 'ью', осн + 'и'];
    }

    /** Слова одной тройки в нужном падеже. */
    function тройка(значение, падеж, род, одушевлённое, простое, язык) {
      const т = ТАБЛИЦЫ[язык];
      const слова = [];
      const сот = Math.floor(значение / 100);
      const ост = значение % 100;
      const дес = Math.floor(ост / 10);
      const ед = ост % 10;

      if (сот) слова.push(т.сотни[сот][падеж]);

      if (ост >= 10 && ост < 20) {
        слова.push(подростокФормы(т.подростки[ост - 10], язык)[падеж]);
        return слова;
      }
      if (дес) слова.push(т.десятки[дес][падеж]);
      if (ед) {
        const набор = (ед === 1 || ед === 2) ? т.единицы[род] : т.единицы.общие;
        let форма = набор[ед][падеж];
        // Одушевлённость меняет винительный только у ПРОСТЫХ один, два, три, четыре.
        // У составных норма требует формы именительного: «двадцать два студента».
        if (падеж === В && одушевлённое && простое) {
          const свои = (ед === 1 || ед === 2) ? т.одушевлённыйВин[род] : т.одушевлённыйВин.общие;
          if (свои && свои[ед]) форма = свои[ед];
        }
        слова.push(форма);
      }
      return слова;
    }

    /** Форма разрядного слова: своё число и свой падеж. */
    function разрядноеСлово(значение, падеж, описание) {
      const сотня = значение % 100;
      const десяток = значение % 10;
      const одна = десяток === 1 && сотня !== 11;
      const малые = десяток >= 2 && десяток <= 4 && !(сотня >= 12 && сотня <= 14);
      if (падеж === И || падеж === В) {
        if (одна) return описание.ед[падеж];
        if (малые) return описание.двеЧетыре;
        return описание.многие;
      }
      // В косвенных падежах разрядное слово идёт во множественном -- кроме «одной тысячи».
      return одна ? описание.ед[падеж] : описание.мн[падеж];
    }

    /**
     * Число прописью в нужном падеже.
     *   цифры -- строка, падеж -- 0..5, род -- род последнего слова в простом числе,
     *   одушевлённое -- влияет на винительный у простых 1-4.
     */
    function склонить(цифры, падеж, род = 'м', одушевлённое = false, язык = 'ru') {
      const т = ТАБЛИЦЫ[язык];
      const чистые = String(цифры).replace(/^0+(?=\d)/, '');
      if (чистые === '0') return т.ноль[падеж];

      const тройки = [];
      for (let к = чистые.length; к > 0; к -= 3) тройки.unshift(чистые.slice(Math.max(0, к - 3), к));
      const простое = Number(чистые) <= 4;      // одушевлённость важна только для простых 1-4

      const слова = [];
      тройки.forEach((кусок, и) => {
        const значение = parseInt(кусок, 10);
        if (!значение) return;
        const разряд = тройки.length - 1 - и;
        const описание = т.разряды[разряд];
        // Тысяча женского рода: «двух тысяч», но «двумя миллионами».
        const родТройки = разряд === 0 ? род : (описание ? описание.род : 'м');
        слова.push(...тройка(значение, падеж, родТройки, одушевлённое, простое, язык));
        if (описание) слова.push(разрядноеСлово(значение, падеж, описание));
      });
      return слова.join(' ');
    }

    /** Полная таблица: шесть падежей. */
    function таблица(цифры, род, одушевлённое, язык) {
      const т = ТАБЛИЦЫ[язык];
      return [0, 1, 2, 3, 4, 5].map((падеж) => {
        const форма = склонить(цифры, падеж, род, одушевлённое, язык);
        // У предложного падежа числительное само по себе не употребляется -- только с предлогом.
        return падеж === П ? `${т.предлог} ${форма}` : форма;
      });
    }

    /* ---- Английский: количественное, порядковое, чековая запись ------------------------------- */

    const EN_ЕД = ['', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'];
    const EN_ПОДР = ['ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen',
      'seventeen', 'eighteen', 'nineteen'];
    const EN_ДЕС = ['', '', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty', 'ninety'];
    const EN_РАЗРЯДЫ = ['', 'thousand', 'million', 'billion', 'trillion'];
    // Порядковые: у большинства слов своя форма, а не просто «+th».
    const EN_ПОРЯДКОВЫЕ = {
      one: 'first', two: 'second', three: 'third', four: 'fourth', five: 'fifth', six: 'sixth',
      seven: 'seventh', eight: 'eighth', nine: 'ninth', ten: 'tenth', eleven: 'eleventh',
      twelve: 'twelfth', thirteen: 'thirteenth', fourteen: 'fourteenth', fifteen: 'fifteenth',
      sixteen: 'sixteenth', seventeen: 'seventeenth', eighteen: 'eighteenth',
      nineteen: 'nineteenth', twenty: 'twentieth', thirty: 'thirtieth', forty: 'fortieth',
      fifty: 'fiftieth', sixty: 'sixtieth', seventy: 'seventieth', eighty: 'eightieth',
      ninety: 'ninetieth', hundred: 'hundredth', thousand: 'thousandth', million: 'millionth',
      billion: 'billionth', trillion: 'trillionth',
    };

    function английскаяТройка(значение, сИ) {
      const слова = [];
      const сот = Math.floor(значение / 100);
      const ост = значение % 100;
      if (сот) слова.push(EN_ЕД[сот], 'hundred');
      // Британская запись ставит «and» между сотнями и остатком: five hundred and forty-two.
      if (сот && ост && сИ) слова.push('and');
      if (ост >= 10 && ост < 20) слова.push(EN_ПОДР[ост - 10]);
      else {
        const д = Math.floor(ост / 10), е = ост % 10;
        if (д && е) слова.push(`${EN_ДЕС[д]}-${EN_ЕД[е]}`);
        else if (д) слова.push(EN_ДЕС[д]);
        else if (е) слова.push(EN_ЕД[е]);
      }
      return слова;
    }

    function английское(цифры, сИ = false) {
      const чистые = String(цифры).replace(/^0+(?=\d)/, '');
      if (чистые === '0') return 'zero';
      const тройки = [];
      for (let к = чистые.length; к > 0; к -= 3) тройки.unshift(чистые.slice(Math.max(0, к - 3), к));
      const слова = [];
      тройки.forEach((кусок, и) => {
        const значение = parseInt(кусок, 10);
        if (!значение) return;
        const разряд = тройки.length - 1 - и;
        // «And» нужно только в последней группе -- перед десятками и единицами.
        слова.push(...английскаяТройка(значение, сИ && разряд === 0));
        if (разряд) слова.push(EN_РАЗРЯДЫ[разряд]);
      });
      // Если сотен в последней группе нет, «and» ставится перед ней целиком: one thousand and five.
      if (сИ && тройки.length > 1) {
        const последняя = parseInt(тройки[тройки.length - 1], 10);
        if (последняя > 0 && последняя < 100 && !слова.includes('and')) {
          const где = слова.length - английскаяТройка(последняя, false).length;
          слова.splice(где, 0, 'and');
        }
      }
      return слова.join(' ');
    }

    /** Порядковое: меняется только ПОСЛЕДНЕЕ слово, и у большинства слов своя форма. */
    function английскоеПорядковое(цифры) {
      const строка = английское(цифры, false);
      if (строка === 'zero') return 'zeroth';
      const слова = строка.split(' ');
      const последнее = слова.pop();
      // «forty-two» -- одно слово через дефис, меняется только часть после дефиса.
      const части = последнее.split('-');
      const хвост = части.pop();
      части.push(EN_ПОРЯДКОВЫЕ[хвост] || хвост + 'th');
      слова.push(части.join('-'));
      return слова.join(' ');
    }

    /* ---- Испанский: количественное, порядковое, женский род ----------------------------------- */

    const ES_ЕД = ['', 'uno', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve'];
    const ES_ПОДР = ['diez', 'once', 'doce', 'trece', 'catorce', 'quince', 'dieciséis',
      'diecisiete', 'dieciocho', 'diecinueve'];
    const ES_ДВАДЦАТЬ = ['veinte', 'veintiuno', 'veintidós', 'veintitrés', 'veinticuatro',
      'veinticinco', 'veintiséis', 'veintisiete', 'veintiocho', 'veintinueve'];
    const ES_ДЕС = ['', '', 'veinte', 'treinta', 'cuarenta', 'cincuenta', 'sesenta', 'setenta',
      'ochenta', 'noventa'];
    const ES_СОТНИ = ['', 'ciento', 'doscientos', 'trescientos', 'cuatrocientos', 'quinientos',
      'seiscientos', 'setecientos', 'ochocientos', 'novecientos'];

    function испанскаяТройка(значение, род) {
      const слова = [];
      const сот = Math.floor(значение / 100);
      const ост = значение % 100;
      if (сот === 1 && ост === 0) слова.push('cien');
      else if (сот) {
        let с = ES_СОТНИ[сот];
        if (род === 'ж' && сот > 1) с = с.replace(/os$/, 'as');
        слова.push(с);
      }
      const единица = (з) => (з === 1 ? (род === 'ж' ? 'una' : 'uno') : ES_ЕД[з]);
      if (ост >= 10 && ост < 20) слова.push(ES_ПОДР[ост - 10]);
      else if (ост >= 20 && ост < 30) {
        слова.push(ост === 21 ? (род === 'ж' ? 'veintiuna' : 'veintiuno') : ES_ДВАДЦАТЬ[ост - 20]);
      } else {
        const д = Math.floor(ост / 10), е = ост % 10;
        if (д && е) слова.push(ES_ДЕС[д], 'y', единица(е));
        else if (д) слова.push(ES_ДЕС[д]);
        else if (е) слова.push(единица(е));
      }
      return слова;
    }

    function испанское(цифры, род = 'м') {
      const чистые = String(цифры).replace(/^0+(?=\d)/, '');
      if (чистые === '0') return 'cero';
      const тройки = [];
      for (let к = чистые.length; к > 0; к -= 3) тройки.unshift(чистые.slice(Math.max(0, к - 3), к));
      const РАЗРЯДЫ = ['', 'mil', 'millón', 'billón', 'trillón'];
      const слова = [];
      тройки.forEach((кусок, и) => {
        const значение = parseInt(кусок, 10);
        if (!значение) return;
        const разряд = тройки.length - 1 - и;
        if (разряд === 1) {
          if (значение !== 1) слова.push(...испанскаяТройка(значение, 'ж'));
          слова.push('mil');
        } else if (разряд >= 2) {
          слова.push(...испанскаяТройка(значение, 'м'));
          слова.push(значение === 1 ? РАЗРЯДЫ[разряд] : РАЗРЯДЫ[разряд].replace(/ón$/, 'ones'));
        } else слова.push(...испанскаяТройка(значение, род));
      });
      return слова.join(' ');
    }

    // Испанские порядковые: у каждой сотни своё слово, и наизусть их не помнит никто.
    const ES_ПОРЯДКОВЫЕ_ЕД = ['', 'primero', 'segundo', 'tercero', 'cuarto', 'quinto', 'sexto',
      'séptimo', 'octavo', 'noveno'];
    const ES_ПОРЯДКОВЫЕ_ДЕС = ['', 'décimo', 'vigésimo', 'trigésimo', 'cuadragésimo',
      'quincuagésimo', 'sexagésimo', 'septuagésimo', 'octogésimo', 'nonagésimo'];
    const ES_ПОРЯДКОВЫЕ_ПОДР = ['décimo', 'undécimo', 'duodécimo', 'decimotercero',
      'decimocuarto', 'decimoquinto', 'decimosexto', 'decimoséptimo', 'decimoctavo',
      'decimonoveno'];
    const ES_ПОРЯДКОВЫЕ_СОТ = ['', 'centésimo', 'ducentésimo', 'tricentésimo', 'cuadringentésimo',
      'quingentésimo', 'sexcentésimo', 'septingentésimo', 'octingentésimo', 'noningentésimo'];
    const ES_ПОРЯДКОВЫЕ_ТЫС = ['', 'milésimo', 'dosmilésimo', 'tresmilésimo', 'cuatromilésimo',
      'cincomilésimo', 'seismilésimo', 'sietemilésimo', 'ochomilésimo', 'nuevemilésimo'];

    function испанскоеПорядковое(цифры, род = 'м') {
      const число = Number(String(цифры).replace(/^0+(?=\d)/, ''));
      if (!число) return 'cero';
      if (число > 9999) return null;          // дальше формы становятся книжными и спорными
      const тыс = Math.floor(число / 1000);
      const сот = Math.floor((число % 1000) / 100);
      const ост = число % 100;
      const части = [];
      if (тыс) части.push(ES_ПОРЯДКОВЫЕ_ТЫС[тыс]);
      if (сот) части.push(ES_ПОРЯДКОВЫЕ_СОТ[сот]);
      if (ост >= 10 && ост < 20) части.push(ES_ПОРЯДКОВЫЕ_ПОДР[ост - 10]);
      else {
        const д = Math.floor(ост / 10), е = ост % 10;
        if (д) части.push(ES_ПОРЯДКОВЫЕ_ДЕС[д]);
        if (е) части.push(ES_ПОРЯДКОВЫЕ_ЕД[е]);
      }
      const строка = части.join(' ');
      return род === 'ж' ? строка.replace(/o(\b)/g, 'a$1') : строка;
    }

    /* ---- Показ ------------------------------------------------------------------------------ */

    const ПРЕДЕЛ = 15;   // до триллионов: дальше слов для разрядов у нас нет

    function пусто(текст) {
      const э = document.createElement('div');
      э.className = 'скл-пусто';
      э.textContent = текст;
      окно.replaceChildren(э);
    }

    function ряд(имя, вопрос, форма) {
      const строка = document.createElement('div');
      строка.className = 'скл-ряд';

      const подпись = document.createElement('span');
      подпись.className = 'скл-имя';
      подпись.textContent = имя;
      if (вопрос) {
        const в = document.createElement('i');
        в.textContent = вопрос;
        подпись.append(в);
      }

      const значение = document.createElement('span');
      значение.className = 'скл-форма';
      значение.textContent = форма;

      const кнопка = document.createElement('button');
      кнопка.type = 'button';
      кнопка.className = 'скл-копия';
      кнопка.textContent = с.copy;
      кнопка.addEventListener('click', async () => {
        let вышло = false;
        try { await navigator.clipboard.writeText(форма); вышло = true; }
        catch (ошибка) { вышло = false; }
        if (!вышло) return;
        кнопка.textContent = с.copied;
        кнопка.classList.add('готово');
        clearTimeout(кнопка._т);
        кнопка._т = setTimeout(() => {
          кнопка.textContent = с.copy;
          кнопка.classList.remove('готово');
        }, 1000);
      });

      строка.append(подпись, значение, кнопка);
      return строка;
    }

    function показать(формы) {
      const куски = document.createDocumentFragment();
      const шапка = document.createElement('div');
      шапка.className = 'скл-шапка';
      шапка.textContent = с.head;
      куски.append(шапка);
      формы.forEach((форма, и) => {
        if (форма === null) return;   // формы нет -- строку не выдумываем
        const [имя, вопрос] = с.ряды[и];
        куски.append(ряд(имя, вопрос, форма));
      });
      окно.replaceChildren(куски);
    }

    /* ---- Работа ------------------------------------------------------------------------------ */

    function пересчитать() {
      const цифры = ввод.value.replace(/\D/g, '');
      if (!цифры) { пусто(с.empty); return; }
      if (цифры.replace(/^0+(?=\d)/, '').length > ПРЕДЕЛ) { пусто(с.errBig); return; }

      if (падежный) { показать(таблица(цифры, род, одушевлённое, язык)); return; }
      if (язык === 'en') {
        показать([английское(цифры), английскоеПорядковое(цифры), английское(цифры, true)]);
        return;
      }
      показать([испанское(цифры), испанскоеПорядковое(цифры), испанское(цифры, 'ж')]);
    }

    function выбрать(кнопка, соседи, дело) {
      for (const и of соседи) $(и).classList.toggle('выбран', и === кнопка);
      дело();
      пересчитать();
    }

    if (падежный) {
      const роды = ['скл-м', 'скл-ж', 'скл-с'];
      const объекты = ['скл-вещи', 'скл-люди'];
      $('скл-м').addEventListener('click', () => выбрать('скл-м', роды, () => { род = 'м'; }));
      $('скл-ж').addEventListener('click', () => выбрать('скл-ж', роды, () => { род = 'ж'; }));
      $('скл-с').addEventListener('click', () => выбрать('скл-с', роды, () => { род = 'с'; }));
      $('скл-вещи').addEventListener('click', () =>
        выбрать('скл-вещи', объекты, () => { одушевлённое = false; }));
      $('скл-люди').addEventListener('click', () =>
        выбрать('скл-люди', объекты, () => { одушевлённое = true; }));
    }

    ввод.addEventListener('input', пересчитать);
    $('скл-очистить').addEventListener('click', () => {
      ввод.value = '';
      пересчитать();
      ввод.focus();
    });

    пересчитать();

    window.__склСостояние = () => ({
      род, одушевлённое,
      строк: окно.querySelectorAll('.скл-ряд').length,
      формы: [...окно.querySelectorAll('.скл-форма')].map((э) => э.textContent),
      пусто: Boolean(окно.querySelector('.скл-пусто')),
      пустоТекст: (окно.querySelector('.скл-пусто') || {}).textContent || '',
    });
  })();
</script>
