---
// ДАТА ПРОПИСЬЮ.
//
// ТРИ МЕСТА, ГДЕ ОШИБАЮТСЯ ПОЧТИ ВСЕ, и все три здесь проверены отдельной таблицей:
//   1. В годе склоняется ТОЛЬКО последнее слово: «две тысячи двадцать шестого», а не
//      «двух тысяч двадцать шестого».
//   2. Круглые годы -- свои слова: 2000 -- «двухтысячного», 1900 -- «тысяча девятисотого»,
//      1000 -- «тысячного». Общее правило тут не работает вовсе.
//   3. Тысяча в годе идёт без «одна»: говорят «тысяча девятьсот», а не «одна тысяча
//      девятьсот». В сумме прописью -- наоборот, «одна тысяча», и это разные случаи.
//
// День -- порядковое среднего рода в именительном: «двадцать первое». Месяц -- родительный:
// «сентября». Год -- порядковое мужского рода в родительном: «шестого года».
//
// Дата никуда не уходит: всё считается в браузере.
import css from '../styles/date-to-words.css?inline';

const { locale = 'ru' } = Astro.props;

const СЛОВА = {
  ru: {
    style: 'Стиль', full: 'Полностью прописью', mixed: 'Смешанный', yearOnly: 'Только год',
    fromCalendar: 'Выберите в календаре', byHand: 'Или введите вручную',
    handPlace: '04.09.2026',
    today: 'Сегодняшняя дата',
    empty: 'Выберите дату в календаре или введите её вручную — запись прописью появится здесь.',
    errParse: 'Не разобрал дату. Подойдут записи вида 04.09.2026, 04/09/2026 или 2026-09-04.',
    errRange: 'Такой даты не бывает: проверьте день и месяц.',
    errYear: 'Год за пределами: считаем с первого по девятитысячный.',
    copyBig: 'Копировать результат', copiedBig: 'Скопировано!', clearAll: 'Очистить всё',
    nothing: 'Ещё нечего копировать', copyFail: 'Браузер не дал скопировать',
    n1: '<b>В годе склоняется только последнее слово.</b> «Две тысячи двадцать шестого года» — «две тысячи» остаётся в начальной форме, меняется лишь последнее числительное. Это первое, на чём спотыкаются: пишут «двух тысяч двадцать шестого».',
    n2: '<b>Круглые годы — отдельные слова.</b> 2000 — «двухтысячного», 1900 — «тысяча девятисотого», 1000 — «тысячного». Общее правило тут не работает вовсе, и такие годы приходится знать наизусть.',
    n3: '<b>Тысяча в дате идёт без «одна».</b> «Тысяча девятьсот девяносто первого года», а не «одна тысяча девятьсот». В сумме прописью — ровно наоборот: «одна тысяча рублей». Один и тот же год в договоре и в сумме пишется по-разному.',
    n4: '<b>День — среднего рода, месяц — в родительном.</b> «Двадцать первое сентября»: день отвечает на вопрос «какое?», а месяц — «чего?». Отсюда «сентября», а не «сентябрь».',
    n5: '<b>Смешанный стиль тоже официальный.</b> «04 сентября 2026 года» — обычная форма для приказов и писем. Полностью прописью пишут там, где дату важно защитить от исправления: в договорах, доверенностях, дипломах.',
    n6: 'Всё считается в вашем браузере. Даты договоров, рождения и подписания никуда не отправляются и нигде не сохраняются.',
  },
  uk: {
    style: 'Стиль', full: 'Повністю прописом', mixed: 'Змішаний', yearOnly: 'Лише рік',
    fromCalendar: 'Оберіть у календарі', byHand: 'Або введіть вручну',
    handPlace: '04.09.2026',
    today: 'Сьогоднішня дата',
    empty: 'Оберіть дату в календарі або введіть її вручну — запис прописом з’явиться тут.',
    errParse: 'Не розібрав дату. Підійдуть записи виду 04.09.2026, 04/09/2026 або 2026-09-04.',
    errRange: 'Такої дати не буває: перевірте день і місяць.',
    errYear: 'Рік поза межами: рахуємо з першого по дев’ятитисячний.',
    copyBig: 'Копіювати результат', copiedBig: 'Скопійовано!', clearAll: 'Очистити все',
    nothing: 'Ще нічого копіювати', copyFail: 'Браузер не дав скопіювати',
    n1: '<b>У році відмінюється лише останнє слово.</b> «Дві тисячі двадцять шостого року» — «дві тисячі» лишається в початковій формі, змінюється тільки останній числівник.',
    n2: '<b>Круглі роки — окремі слова.</b> 2000 — «двохтисячного», 1900 — «тисяча дев’ятисотого», 1000 — «тисячного». Загальне правило тут не працює взагалі.',
    n3: '<b>Тисяча в даті йде без «одна».</b> «Тисяча дев’ятсот дев’яносто першого року», а не «одна тисяча дев’ятсот». У сумі прописом — навпаки: «одна тисяча гривень».',
    n4: '<b>День — середнього роду, місяць — у родовому.</b> «Двадцять перше вересня»: день відповідає на питання «яке?», а місяць — «чого?». Звідси «вересня», а не «вересень».',
    n5: '<b>Змішаний стиль теж офіційний.</b> «04 вересня 2026 року» — звичайна форма для наказів і листів. Повністю прописом пишуть там, де дату важливо захистити від виправлення.',
    n6: 'Усе рахується у вашому браузері. Дати договорів, народження й підписання нікуди не надсилаються і ніде не зберігаються.',
  },
  en: {
    style: 'Style', full: 'Fully in words', mixed: 'Mixed', yearOnly: 'Year only',
    fromCalendar: 'Pick in the calendar', byHand: 'Or type it in',
    handPlace: '04.09.2026',
    today: 'Today',
    empty: 'Pick a date in the calendar or type one in — the written form appears here.',
    errParse: 'I could not read that date. Try 04.09.2026, 04/09/2026 or 2026-09-04.',
    errRange: 'There is no such date: check the day and the month.',
    errYear: 'Year out of range: we spell out from the first to the nine thousandth.',
    copyBig: 'Copy the result', copiedBig: 'Copied!', clearAll: 'Clear everything',
    nothing: 'There is nothing to copy yet', copyFail: 'The browser refused to copy',
    n1: '<b>English keeps it simple, Slavic languages do not.</b> Here the day takes an ordinal — “the fourth of September” — and the year is read as a plain number. In Russian and Ukrainian the year also changes its ending, and only in the last word.',
    n2: '<b>Formal documents spell the year out in full.</b> “Two thousand twenty-six”, not the spoken “twenty twenty-six”. The short spoken form is fine in speech and out of place in a contract.',
    n3: '<b>Day before month, or month before day.</b> Writing 04/09/2026 means the fourth of September in Britain and the ninth of April in the United States. That is exactly why documents spell the month out in letters — the ambiguity disappears.',
    n4: '<b>The mixed style is official too.</b> “04 September 2026” is the usual form for orders and letters. Fully written-out dates belong where the date must be protected from tampering: contracts, powers of attorney, diplomas.',
    n5: 'Everything is computed in your browser. Contract, birth and signing dates are never sent anywhere and never stored.',
    n6: '',
  },
  es: {
    style: 'Estilo', full: 'Todo en letras', mixed: 'Mixto', yearOnly: 'Solo el año',
    fromCalendar: 'Elige en el calendario', byHand: 'O escríbela',
    handPlace: '04.09.2026',
    today: 'Fecha de hoy',
    empty: 'Elige una fecha en el calendario o escríbela: la forma en letras aparecerá aquí.',
    errParse: 'No he podido leer la fecha. Prueba con 04.09.2026, 04/09/2026 o 2026-09-04.',
    errRange: 'Esa fecha no existe: revisa el día y el mes.',
    errYear: 'Año fuera de rango: escribimos en letras del primero al nueve mil.',
    copyBig: 'Copiar el resultado', copiedBig: '¡Copiado!', clearAll: 'Limpiar todo',
    nothing: 'Todavía no hay nada que copiar', copyFail: 'El navegador no dejó copiar',
    n1: '<b>En español el día va en cardinal.</b> «Cuatro de septiembre de dos mil veintiséis», no «cuarto». La excepción es el día uno, que en América se escribe a menudo «primero de septiembre»; las dos formas son correctas.',
    n2: '<b>Los meses van en minúscula.</b> «4 de septiembre», nunca «4 de Septiembre». Es un error muy extendido que llega del inglés, donde los meses sí se escriben con mayúscula.',
    n3: '<b>El año se lee como un número normal.</b> «Dos mil veintiséis», y «mil novecientos noventa y nueve» para 1999: sin «un mil», porque en español el millar no lleva «uno» delante.',
    n4: '<b>El estilo mixto también es oficial.</b> «04 de septiembre de 2026» es la forma habitual en resoluciones y cartas. Todo en letras se reserva para cuando la fecha debe quedar protegida de cualquier retoque.',
    n5: 'Todo se calcula en tu navegador. Las fechas de contratos, nacimientos y firmas no se envían a ninguna parte ni se guardan.',
    n6: '',
  },
};
const с = СЛОВА[locale] || СЛОВА.ru;
const заметки = [с.n1, с.n2, с.n3, с.n4, с.n5, с.n6].filter(Boolean);
---

<style is:inline set:html={css}></style>

<div class="дт2" data-words={JSON.stringify(с)} data-locale={locale}>
  <div class="дт2-верх">
    <span class="дт2-подпись">{с.style}:</span>
    <div class="дт2-кнопки" role="group">
      <button type="button" class="дт2-выбор выбран" id="дт2-полностью">{с.full}</button>
      <button type="button" class="дт2-выбор" id="дт2-смешанный">{с.mixed}</button>
      <button type="button" class="дт2-выбор" id="дт2-год">{с.yearOnly}</button>
    </div>
  </div>

  <div class="дт2-ввод-ряд">
    <label class="дт2-клетка">
      <span class="дт2-к">{с.fromCalendar}</span>
      <input class="дт2-поле-даты" id="дт2-календарь" type="date">
    </label>
    <label class="дт2-клетка">
      <span class="дт2-к">{с.byHand}</span>
      <input class="дт2-поле-даты" id="дт2-руками" type="text" placeholder={с.handPlace}
        inputmode="numeric" spellcheck="false">
    </label>
  </div>

  <div class="дт2-низ" style="margin-top:0;margin-bottom:12px">
    <button type="button" class="дт2-простая" id="дт2-сегодня">{с.today}</button>
  </div>

  <div class="дт2-итог пусто" id="дт2-итог">
    <span class="дт2-ответ" id="дт2-ответ">{с.empty}</span>
  </div>

  <div class="дт2-низ">
    <button type="button" class="дт2-кнопка" id="дт2-копировать">{с.copyBig}</button>
    <button type="button" class="дт2-простая" id="дт2-очистить">{с.clearAll}</button>
  </div>

  <div class="дт2-заметки">
    {заметки.map((з) => <div class="дт2-заметка" set:html={з}></div>)}
  </div>
</div>

<script>
  const корень = document.querySelector('.дт2');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const язык = корень.dataset.locale || 'ru';
    const $ = (и) => document.getElementById(и);
    const итог = $('дт2-итог');
    const ответ = $('дт2-ответ');
    let стиль = 'полностью';

    /* ДАТА ПРОПИСЬЮ.
     *
     * Три места, где ошибаются почти все:
     *   1. В годе склоняется ТОЛЬКО последнее слово: «две тысячи двадцать шестого», а не
     *      «двух тысяч двадцать шестого».
     *   2. Круглые годы -- отдельные слова: 2000 -- «двухтысячного», 1900 -- «тысяча
     *      девятисотого», а не «две тысячи нулевого».
     *   3. Тысяча в годе без «одна»: говорят «тысяча девятьсот», а не «одна тысяча девятьсот».
     */

    const РУ = {
      // День: порядковое, средний род, именительный.
      порядковыеЕд: ['', 'первое', 'второе', 'третье', 'четвёртое', 'пятое', 'шестое', 'седьмое',
        'восьмое', 'девятое'],
      порядковыеПодр: ['десятое', 'одиннадцатое', 'двенадцатое', 'тринадцатое', 'четырнадцатое',
        'пятнадцатое', 'шестнадцатое', 'семнадцатое', 'восемнадцатое', 'девятнадцатое'],
      порядковыеДес: ['', '', 'двадцатое', 'тридцатое'],
      количественныеДес: ['', '', 'двадцать', 'тридцать'],
      месяцы: ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа',
        'сентября', 'октября', 'ноября', 'декабря'],
      месяцыИм: ['январь', 'февраль', 'март', 'апрель', 'май', 'июнь', 'июль', 'август',
        'сентябрь', 'октябрь', 'ноябрь', 'декабрь'],
      // Год: порядковое, мужской род, родительный падеж -- «шестого года».
      родЕд: ['', 'первого', 'второго', 'третьего', 'четвёртого', 'пятого', 'шестого', 'седьмого',
        'восьмого', 'девятого'],
      родПодр: ['десятого', 'одиннадцатого', 'двенадцатого', 'тринадцатого', 'четырнадцатого',
        'пятнадцатого', 'шестнадцатого', 'семнадцатого', 'восемнадцатого', 'девятнадцатого'],
      родДес: ['', '', 'двадцатого', 'тридцатого', 'сорокового', 'пятидесятого', 'шестидесятого',
        'семидесятого', 'восьмидесятого', 'девяностого'],
      родСот: ['', 'сотого', 'двухсотого', 'трёхсотого', 'четырёхсотого', 'пятисотого',
        'шестисотого', 'семисотого', 'восьмисотого', 'девятисотого'],
      родТыс: ['', 'тысячного', 'двухтысячного', 'трёхтысячного', 'четырёхтысячного',
        'пятитысячного', 'шеститысячного', 'семитысячного', 'восьмитысячного', 'девятитысячного'],
      колЕд: ['', 'один', 'два', 'три', 'четыре', 'пять', 'шесть', 'семь', 'восемь', 'девять'],
      колПодр: ['десять', 'одиннадцать', 'двенадцать', 'тринадцать', 'четырнадцать', 'пятнадцать',
        'шестнадцать', 'семнадцать', 'восемнадцать', 'девятнадцать'],
      колДес: ['', '', 'двадцать', 'тридцать', 'сорок', 'пятьдесят', 'шестьдесят', 'семьдесят',
        'восемьдесят', 'девяносто'],
      колСот: ['', 'сто', 'двести', 'триста', 'четыреста', 'пятьсот', 'шестьсот', 'семьсот',
        'восемьсот', 'девятьсот'],
      тысячи: ['', 'тысяча', 'две тысячи', 'три тысячи', 'четыре тысячи', 'пять тысяч',
        'шесть тысяч', 'семь тысяч', 'восемь тысяч', 'девять тысяч'],
      года: 'года',
    };

    const УК = {
      порядковыеЕд: ['', 'перше', 'друге', 'третє', 'четверте', "п'яте", 'шосте', 'сьоме',
        'восьме', "дев'яте"],
      порядковыеПодр: ['десяте', 'одинадцяте', 'дванадцяте', 'тринадцяте', 'чотирнадцяте',
        "п'ятнадцяте", 'шістнадцяте', 'сімнадцяте', 'вісімнадцяте', "дев'ятнадцяте"],
      порядковыеДес: ['', '', 'двадцяте', 'тридцяте'],
      количественныеДес: ['', '', 'двадцять', 'тридцять'],
      месяцы: ['січня', 'лютого', 'березня', 'квітня', 'травня', 'червня', 'липня', 'серпня',
        'вересня', 'жовтня', 'листопада', 'грудня'],
      месяцыИм: ['січень', 'лютий', 'березень', 'квітень', 'травень', 'червень', 'липень',
        'серпень', 'вересень', 'жовтень', 'листопад', 'грудень'],
      родЕд: ['', 'першого', 'другого', 'третього', 'четвертого', "п'ятого", 'шостого', 'сьомого',
        'восьмого', "дев'ятого"],
      родПодр: ['десятого', 'одинадцятого', 'дванадцятого', 'тринадцятого', 'чотирнадцятого',
        "п'ятнадцятого", 'шістнадцятого', 'сімнадцятого', 'вісімнадцятого', "дев'ятнадцятого"],
      родДес: ['', '', 'двадцятого', 'тридцятого', 'сорокового', "п'ятдесятого", 'шістдесятого',
        'сімдесятого', 'вісімдесятого', "дев'яностого"],
      родСот: ['', 'сотого', 'двохсотого', 'трьохсотого', 'чотирьохсотого', "п'ятисотого",
        'шестисотого', 'семисотого', 'восьмисотого', "дев'ятисотого"],
      родТыс: ['', 'тисячного', 'двохтисячного', 'трьохтисячного', 'чотирьохтисячного',
        "п'ятитисячного", 'шеститисячного', 'семитисячного', 'восьмитисячного', "дев'ятитисячного"],
      колЕд: ['', 'один', 'два', 'три', 'чотири', "п'ять", 'шість', 'сім', 'вісім', "дев'ять"],
      колПодр: ['десять', 'одинадцять', 'дванадцять', 'тринадцять', 'чотирнадцять', "п'ятнадцять",
        'шістнадцять', 'сімнадцять', 'вісімнадцять', "дев'ятнадцять"],
      колДес: ['', '', 'двадцять', 'тридцять', 'сорок', "п'ятдесят", 'шістдесят', 'сімдесят',
        'вісімдесят', "дев'яносто"],
      колСот: ['', 'сто', 'двісті', 'триста', 'чотириста', "п'ятсот", 'шістсот', 'сімсот',
        'вісімсот', "дев'ятсот"],
      тысячи: ['', 'тисяча', 'дві тисячі', 'три тисячі', 'чотири тисячі', "п'ять тисяч",
        'шість тисяч', 'сім тисяч', 'вісім тисяч', "дев'ять тисяч"],
      года: 'року',
    };

    const ТАБЛИЦЫ = { ru: РУ, uk: УК };

    /** День месяца порядковым числительным среднего рода: «двадцать первое». */
    function деньСловами(день, язык) {
      const т = ТАБЛИЦЫ[язык];
      if (день >= 10 && день <= 19) return т.порядковыеПодр[день - 10];
      const дес = Math.floor(день / 10);
      const ед = день % 10;
      if (!ед) return т.порядковыеДес[дес];
      // В составном числительном порядковое только последнее слово: «двадцать первое».
      return (дес ? т.количественныеДес[дес] + ' ' : '') + т.порядковыеЕд[ед];
    }

    /** Год порядковым числительным в родительном падеже: «две тысячи двадцать шестого». */
    function годСловами(год, язык) {
      const т = ТАБЛИЦЫ[язык];
      const тыс = Math.floor(год / 1000);
      const сот = Math.floor((год % 1000) / 100);
      const остаток = год % 100;
      const дес = Math.floor(остаток / 10);
      const ед = остаток % 10;

      const начало = [];
      // Тысяча в годе идёт без «одна»: говорят «тысяча девятьсот», а не «одна тысяча девятьсот».
      if (тыс) начало.push(т.тысячи[тыс]);
      if (сот) начало.push(т.колСот[сот]);

      // Склоняется ТОЛЬКО последнее слово. Ищем, какое именно оказалось последним.
      if (остаток >= 11 && остаток <= 19) {
        return [...начало, т.родПодр[остаток - 10]].join(' ');
      }
      if (ед) {
        if (дес) начало.push(т.колДес[дес]);
        else if (остаток === 10) начало.push(т.колПодр[0]);
        return [...начало, т.родЕд[ед]].join(' ');
      }
      if (остаток === 10) return [...начало, т.родПодр[0]].join(' ');
      if (дес) return [...начало, т.родДес[дес]].join(' ');
      if (сот) { начало.pop(); return [...начало, т.родСот[сот]].join(' '); }
      if (тыс) return т.родТыс[тыс];
      return '';
    }

    /* ---- Английский и испанский ------------------------------------------------------------ */

    const EN = {
      месяцы: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August',
        'September', 'October', 'November', 'December'],
      порядковые: ['', 'first', 'second', 'third', 'fourth', 'fifth', 'sixth', 'seventh',
        'eighth', 'ninth', 'tenth', 'eleventh', 'twelfth', 'thirteenth', 'fourteenth',
        'fifteenth', 'sixteenth', 'seventeenth', 'eighteenth', 'nineteenth', 'twentieth',
        'twenty-first', 'twenty-second', 'twenty-third', 'twenty-fourth', 'twenty-fifth',
        'twenty-sixth', 'twenty-seventh', 'twenty-eighth', 'twenty-ninth', 'thirtieth',
        'thirty-first'],
      единицы: ['', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'],
      подростки: ['ten', 'eleven', 'twelve', 'thirteen', 'fourteen', 'fifteen', 'sixteen',
        'seventeen', 'eighteen', 'nineteen'],
      десятки: ['', '', 'twenty', 'thirty', 'forty', 'fifty', 'sixty', 'seventy', 'eighty',
        'ninety'],
    };
    const ES = {
      месяцы: ['enero', 'febrero', 'marzo', 'abril', 'mayo', 'junio', 'julio', 'agosto',
        'septiembre', 'octubre', 'noviembre', 'diciembre'],
      единицы: ['', 'uno', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve'],
      подростки: ['diez', 'once', 'doce', 'trece', 'catorce', 'quince', 'dieciséis',
        'diecisiete', 'dieciocho', 'diecinueve'],
      двадцать: ['veinte', 'veintiuno', 'veintidós', 'veintitrés', 'veinticuatro',
        'veinticinco', 'veintiséis', 'veintisiete', 'veintiocho', 'veintinueve'],
      десятки: ['', '', 'veinte', 'treinta', 'cuarenta', 'cincuenta', 'sesenta', 'setenta',
        'ochenta', 'noventa'],
      сотни: ['', 'ciento', 'doscientos', 'trescientos', 'cuatrocientos', 'quinientos',
        'seiscientos', 'setecientos', 'ochocientos', 'novecientos'],
    };

    function малоеEN(н) {
      if (н >= 10 && н < 20) return EN.подростки[н - 10];
      const д = Math.floor(н / 10), е = н % 10;
      if (д && е) return `${EN.десятки[д]}-${EN.единицы[е]}`;
      return д ? EN.десятки[д] : EN.единицы[е];
    }
    function годEN(год) {
      const тыс = Math.floor(год / 1000), сот = Math.floor((год % 1000) / 100), ост = год % 100;
      const части = [];
      if (тыс) части.push(EN.единицы[тыс], 'thousand');
      if (сот) части.push(EN.единицы[сот], 'hundred');
      if (ост) части.push(малоеEN(ост));
      return части.join(' ');
    }
    function малоеES(н) {
      if (н >= 10 && н < 20) return ES.подростки[н - 10];
      if (н >= 20 && н < 30) return ES.двадцать[н - 20];
      const д = Math.floor(н / 10), е = н % 10;
      if (д && е) return `${ES.десятки[д]} y ${ES.единицы[е]}`;
      return д ? ES.десятки[д] : ES.единицы[е];
    }
    function годES(год) {
      const тыс = Math.floor(год / 1000), сот = Math.floor((год % 1000) / 100), ост = год % 100;
      const части = [];
      // «Un mil» по-испански не говорят: тысяча идёт словом «mil» без единицы.
      if (тыс) части.push(тыс === 1 ? 'mil' : `${ES.единицы[тыс]} mil`);
      if (сот) части.push(сот === 1 && !ост ? 'cien' : ES.сотни[сот]);
      if (ост) части.push(малоеES(ост));
      return части.join(' ');
    }

    /* ---- Сборка записи --------------------------------------------------------------------- */

    const сБольшой = (т) => т.charAt(0).toUpperCase() + т.slice(1);

    function записать(день, месяц, год) {
      const дв = String(день).padStart(2, '0');
      if (язык === 'en') {
        const м = EN.месяцы[месяц - 1];
        if (стиль === 'смешанный') return `${дв} ${м} ${год}`;
        if (стиль === 'год') return `${день} ${м} ${годEN(год)}`;
        return сБольшой(`the ${EN.порядковые[день]} of ${м}, ${годEN(год)}`);
      }
      if (язык === 'es') {
        const м = ES.месяцы[месяц - 1];
        if (стиль === 'смешанный') return `${дв} de ${м} de ${год}`;
        if (стиль === 'год') return `${день} de ${м} de ${годES(год)}`;
        return сБольшой(`${малоеES(день)} de ${м} de ${годES(год)}`);
      }
      const т = язык === 'uk' ? УК : РУ;
      if (стиль === 'смешанный') return `${дв} ${т.месяцы[месяц - 1]} ${год} ${т.года}`;
      if (стиль === 'год') return `${день} ${т.месяцы[месяц - 1]} ${годСловами(год, язык)} ${т.года}`;
      return сБольшой(`${деньСловами(день, язык)} ${т.месяцы[месяц - 1]} ${годСловами(год, язык)} ${т.года}`);
    }

    /* ---- Разбор введённого ------------------------------------------------------------------ */

    function разобрать(строка) {
      const чистая = строка.trim();
      if (!чистая) return null;
      // Год впереди -- значит запись вида 2026-09-04.
      let м = чистая.match(/^(\d{4})[-./](\d{1,2})[-./](\d{1,2})$/);
      if (м) return { год: +м[1], месяц: +м[2], день: +м[3] };
      м = чистая.match(/^(\d{1,2})[-./](\d{1,2})[-./](\d{4})$/);
      if (м) return { день: +м[1], месяц: +м[2], год: +м[3] };
      throw { вид: 'разбор' };
    }

    // Проверяем настоящим календарём: тридцатого февраля не бывает, а в високосный год
    // двадцать девятое есть. Сами такие правила выписывать незачем.
    function бывает({ день, месяц, год }) {
      if (месяц < 1 || месяц > 12 || день < 1 || день > 31) return false;
      const д = new Date(Date.UTC(год, месяц - 1, день));
      return д.getUTCFullYear() === год && д.getUTCMonth() === месяц - 1 && д.getUTCDate() === день;
    }

    /* ---- Работа ------------------------------------------------------------------------------ */

    function пересчитать(откуда) {
      const изКалендаря = $('дт2-календарь').value;
      const руками = $('дт2-руками').value;
      итог.classList.remove('беда', 'пусто');

      let строка = '';
      if (откуда === 'календарь' && изКалендаря) строка = изКалендаря;
      else if (руками.trim()) строка = руками;
      else if (изКалендаря) строка = изКалендаря;

      if (!строка) { итог.classList.add('пусто'); ответ.textContent = с.empty; return; }

      let дата;
      try { дата = разобрать(строка); }
      catch (е) { итог.classList.add('беда'); ответ.textContent = с.errParse; return; }
      if (!дата) { итог.classList.add('пусто'); ответ.textContent = с.empty; return; }
      if (дата.год < 1 || дата.год > 9999) {
        итог.classList.add('беда'); ответ.textContent = с.errYear; return;
      }
      if (!бывает(дата)) { итог.classList.add('беда'); ответ.textContent = с.errRange; return; }

      ответ.textContent = записать(дата.день, дата.месяц, дата.год);
    }

    function поставитьСтиль(имя, кнопка) {
      стиль = имя;
      for (const и of ['дт2-полностью', 'дт2-смешанный', 'дт2-год']) {
        $(и).classList.toggle('выбран', и === кнопка);
      }
      пересчитать();
    }

    function сказать(текст) {
      const э = $('дт2-ответ');
      // Отдельной строки для сообщений тут нет: коротко подменяем сам ответ.
      const было = э.textContent;
      э.textContent = текст;
      clearTimeout(э._т);
      э._т = setTimeout(() => { э.textContent = было; }, 1500);
    }

    $('дт2-календарь').addEventListener('input', () => {
      // Из календаря дата пришла точная -- ручное поле подстраиваем под неё, чтобы человек
      // видел одно и то же в обоих местах.
      const з = $('дт2-календарь').value;
      if (з) {
        const [г, м, д] = з.split('-');
        $('дт2-руками').value = `${д}.${м}.${г}`;
      }
      пересчитать('календарь');
    });
    $('дт2-руками').addEventListener('input', () => {
      // А вот назад в календарь кладём только разобравшееся -- иначе он мигал бы на
      // каждой недопечатанной цифре.
      try {
        const д = разобрать($('дт2-руками').value);
        if (д && бывает(д)) {
          $('дт2-календарь').value = `${String(д.год).padStart(4, '0')}-`
            + `${String(д.месяц).padStart(2, '0')}-${String(д.день).padStart(2, '0')}`;
        }
      } catch (е) { /* ещё дописывают */ }
      пересчитать('руками');
    });

    for (const и of ['дт2-полностью', 'дт2-смешанный', 'дт2-год']) {
      $(и).addEventListener('click', () => поставитьСтиль(
        и === 'дт2-полностью' ? 'полностью' : (и === 'дт2-смешанный' ? 'смешанный' : 'год'), и));
    }

    $('дт2-сегодня').addEventListener('click', () => {
      const н = new Date();
      const д = String(н.getDate()).padStart(2, '0');
      const м = String(н.getMonth() + 1).padStart(2, '0');
      $('дт2-календарь').value = `${н.getFullYear()}-${м}-${д}`;
      $('дт2-руками').value = `${д}.${м}.${н.getFullYear()}`;
      пересчитать('календарь');
    });

    $('дт2-копировать').addEventListener('click', async () => {
      const кнопка = $('дт2-копировать');
      if (итог.classList.contains('пусто') || итог.classList.contains('беда')) {
        сказать(с.nothing); return;
      }
      let вышло = false;
      try { await navigator.clipboard.writeText(ответ.textContent); вышло = true; }
      catch (ошибка) { вышло = false; }
      if (!вышло) { сказать(с.copyFail); return; }
      кнопка.textContent = с.copiedBig;
      clearTimeout(кнопка._т);
      кнопка._т = setTimeout(() => { кнопка.textContent = с.copyBig; }, 1500);
    });

    $('дт2-очистить').addEventListener('click', () => {
      $('дт2-календарь').value = '';
      $('дт2-руками').value = '';
      пересчитать();
      $('дт2-руками').focus();
    });

    пересчитать();

    window.__дт2Состояние = () => ({
      ответ: ответ.textContent, стиль,
      календарь: $('дт2-календарь').value, руками: $('дт2-руками').value,
      пусто: итог.classList.contains('пусто'), беда: итог.classList.contains('беда'),
    });
    window.__дт2Год = (г) => годСловами(г, язык);
    window.__дт2День = (д) => деньСловами(д, язык);
  })();
</script>
