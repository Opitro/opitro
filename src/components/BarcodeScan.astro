    otherShort: "QR",
    goOther: "Analizar este código",
    mode: 'Modo', camera: 'Cámara', photo: "Archivo",
    stop: 'Apagar la cámara',
    camIdle: 'Pulse el icono de la cámara y acerque el código de barras al objetivo',
    camDenied: 'El navegador no dio acceso a la cámara. Permítalo en los ajustes del sitio o cambie a «Archivo o captura».',
    camNo1D: 'En este navegador la cámara en vivo solo capta códigos QR. El código de barras se lee desde una imagen: cambie a «Archivo o captura».',
    pick: 'Elegir archivo', again: 'Elegir otro',
    drop: 'Arrastre una imagen aquí, elija un archivo o pegue una captura con Ctrl+V',
    waiting: 'Apunte la cámara a un código o cargue una imagen',
    notFound: 'No se encontró ningún código. Acérquese y enderece la toma: las barras deben caber enteras en el encuadre, junto con los márgenes blancos de los extremos.',
    copy: 'Copiar los dígitos', copied: 'Copiado',
    kindBar: 'Código de barras', kindQr: 'Código QR',
    fFormat: 'Formato', fCheck: 'Dígito de control', fCountry: 'Número emitido en',
    fIsbn10: 'ISBN-10 antiguo', fInside: 'Contenido',
    checkOk: 'coincide', checkBad: 'no coincide: debería ser',
    badTitle: 'El dígito de control no coincide.',
    badText: 'O bien el código se leyó mal —pruebe a tomar la foto de nuevo— o los dígitos se escribieron con un error. Un código comercial auténtico siempre coincide.',
    markБook: 'Libro (ISBN)', markНоты: 'Partitura (ISMN)', markЖурнал: 'Revista o periódico (ISSN)',
    markВнутренний: 'Código interno de la tienda', markКупон: 'Cupón',
    markВозврат: 'Recibo de devolución', markGs1: 'Número de servicio GS1',
    inStore: 'Ese código lo imprime la propia tienda, normalmente en producto a granel pesado en el mostrador. Fuera de ella no significa nada: en otra cadena los mismos dígitos son otro producto.',
    other: 'Escáner de códigos QR', otherHint: 'Esto es un código QR, no un código de barras. El análisis de enlaces y la comprobación de direcciones falsas están en la página vecina.',
    n1: '<b>Las primeras cifras indican el país donde se emitió el número, no donde se fabricó el producto.</b> Es el error más extendido sobre los códigos de barras. El prefijo dice en qué oficina de GS1 se registró el fabricante. Una empresa alemana con prefijo 400 puede coser en China, y un importador pondrá su prefijo nacional a mercancía turca. El país de fabricación no se deduce del código: se escribe con letras en el envase.',
    n2: '<b>El nombre del producto está a un botón.</b> En el código no está: las cifras no guardan palabras. Pero el número se puede buscar en la base abierta Open Food Facts. Es sobre todo comida y la recopilan personas, así que no está todo. Si no pulsa el botón, no sale nada de la página.',
    n3: '<b>El dígito de control se comprueba aquí mismo.</b> La última cifra de un EAN o un UPC se calcula a partir del resto. Si no coincide, el código se leyó mal o se tecleó con un error. Es una comprobación fiable: basta con intercambiar dos cifras para romperla.',
    n4: '<b>En el iPhone el código de barras se lee desde una imagen.</b> En Chrome y en Android el reconocedor está integrado en el propio navegador y capta las barras directamente de la cámara. Safari no lo tiene, así que allí la cámara en vivo busca solo QR; en cambio una foto o un archivo se analizan por completo, con el mismo juego de formatos.',
    n5: '<b>Esta página también lee códigos QR.</b> Si en lugar de barras entra un cuadrado en el encuadre, lo leeremos y mostraremos su contenido, y le remitiremos al escáner de QR para el análisis del enlace: allí es donde se comprueba si la dirección está suplantada.',
    n6: 'La imagen no se sube a ninguna parte: el reconocimiento ocurre dentro de la propia pestaña. Lo único que sale es el número, y solo si pulsa «Buscar en la base abierta».',
  },
};
const с = СЛОВА[locale] || СЛОВА.ru;
---

<div class="скш" data-words={JSON.stringify(с)} data-locale={locale}>
  <div class="скш-пульт">
    <span class="скш-отступ">
      <span class="скш-подпись">{с.mode}:</span>
      <span class="скш-набор">
        <!-- Значок фотоаппарата САМ включает камеру: нажал на камеру -- получил камеру.
             Отдельной кнопки «включить» нет, два нажатия ради одного действия ни к чему.
             Пока камера работает, значок перечёркнут -- нажатие её выключит. -->
        <button type="button" class="скш-выбор скш-глаз" data-р="camera"
                id="скш-глаз" aria-label={с.camera} title={с.camera}>
          <svg class="идёт-нет" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 7.5h3.4L8.2 5h7.6l1.8 2.5H21a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V8.5a1 1 0 0 1 1-1Z"/>
            <circle cx="12" cy="13.3" r="3.5"/>
          </svg>
          <svg class="стоп" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 7.5h3.4L8.2 5h7.6l1.8 2.5H21a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V8.5a1 1 0 0 1 1-1Z"/>
            <circle cx="12" cy="13.3" r="3.5"/>
            <path d="M3.5 3.5l17 17"/>
          </svg>
        </button>
        <button type="button" class="скш-выбор" data-р="photo">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M13.5 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5L13.5 3Z"/>
            <path d="M13.5 3v5.5H19"/>
          </svg>
          {с.photo}
        </button>
      </span>
    </span>
    <!-- Переход на сканер QR стоит прямо здесь, у самого инструмента: человек с кодом в
         руках часто не знает, полоски у него или квадратик, и уходить за этим вниз страницы
         неправильно. -->
    <a class="скш-сосед" href={`/${locale}/qr-scan`}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h2v2h-2zM18 14h2v2h-2zM16 16h2v2h-2zM14 18h2v2h-2zM18 18h2v2h-2z"/></svg>
      <span class="скш-полно">{с.other}</span>
      <span class="скш-кратко">{с.otherShort}</span>
    </a>
  </div>

  <div class="скш-пара">
    <div>
      <div class="скш-глазок" id="скш-глазок">
        <video id="скш-видео" playsinline muted></video>
        <!-- Рабочий холст живого разбора -- он не показывается никогда. -->
        <canvas id="скш-холст"></canvas>
        <!-- Застывший кадр: его человек и рассматривает, пока идёт разбор. -->
        <canvas id="скш-кадр" class="скш-кадр"></canvas>
        <div class="скш-прицел"><i></i><i></i></div>
        <div class="скш-луч"></div>
        <div class="скш-затвор-ряд">
          <span class="скш-намёк" id="скш-намёк"></span>
          <button type="button" class="скш-затвор" id="скш-затвор"
                  aria-label={с.shot} title={с.shot}><i></i></button>
        </div>
        <div class="скш-заслон" id="скш-заслон">
          <button type="button" class="скш-крупный" id="скш-крупный" aria-label={с.camera}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 7.5h3.4L8.2 5h7.6l1.8 2.5H21a1 1 0 0 1 1 1V19a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V8.5a1 1 0 0 1 1-1Z"/>
              <circle cx="12" cy="13.3" r="3.5"/>
            </svg>
          </button>
          <span id="скш-слово">{с.camIdle}</span>
        </div>
      </div>

      <label class="скш-зона" id="скш-зона" hidden>
        <p>{с.drop}</p>
        <span class="скш-взять" id="скш-выбрать">{с.pick}</span>
        <input type="file" id="скш-файл" accept="image/*" />
      </label>
    </div>

    <div class="скш-итог" id="скш-итог">
      <span class="скш-ждём" id="скш-ждём">{с.waiting}</span>
    </div>
  </div>

  <div class="скш-ряд" id="скш-ряд">
    <button type="button" class="скш-кнопка" id="скш-копировать" disabled>{с.copy}</button>
    <a class="скш-обводка" id="скш-туда" href={`/${locale}/qr-scan`} style="display:none">{с.goOther}</a>
    <button type="button" class="скш-обводка" id="скш-база" style="display:none">{с.base}</button>
    <a class="скш-обводка" id="скш-искать" style="display:none" target="_blank"
       rel="noopener noreferrer nofollow">{с.search}</a>
  </div>

  <div class="скш-заметки">
    <div class="скш-заметка" set:html={с.n1}></div>
    <div class="скш-заметка" set:html={с.n2}></div>
    <div class="скш-заметка" set:html={с.n3}></div>
    <div class="скш-заметка" set:html={с.n4}></div>
    <div class="скш-заметка" set:html={с.n5}></div>
    <div class="скш-заметка">{с.n6}</div>
  </div>
</div>

<style is:inline set:html={css}></style>

<script>
  import { прочитатьКадр, прочитатьСнимок, камераВидитПолоски } from '../lib/code-read.js';
  import { разобратьШтрих, названиеСтраны } from '../lib/barcode-info.js';
  import { разобратьGS1 } from '../lib/gs1.js';
  import { разобратьСодержимое } from '../lib/qr-read.js';

  const корень = document.querySelector('.скш');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const язык = корень.dataset.locale || 'ru';
    const $ = (и) => document.getElementById(и);
    const видео = $('скш-видео');
    const холст = $('скш-холст');
    const итог = $('скш-итог');

    let режим = 'camera';
    let поток = null;
    let ищем = false;
    let найдено = '';
    let снимаем = false;
    let ловитПолоски = true;   // умеет ли живая камера ловить полосы; уточняется ниже

    const узел = (тег, класс, текст) => {
      const э = document.createElement(тег);
      if (класс) э.className = класс;
      if (текст !== undefined) э.textContent = текст;
      return э;
    };

    function пары(список) {
      const дл = document.createElement('dl');
      дл.className = 'скш-пары';
      for (const [имя, значение] of список) {
        if (!значение) continue;
        дл.append(узел('dt', '', имя), узел('dd', '', значение));
      }
      return дл;
    }

    /** Короткий тихий сигнал: подсказка, а не сирена. */
    function пикнуть() {
      try {
        const ак = new (window.AudioContext || window.webkitAudioContext)();
        const ген = ак.createOscillator();
        const гром = ак.createGain();
        ген.type = 'sine';
        ген.frequency.value = 1320;
        гром.gain.setValueAtTime(0.0001, ак.currentTime);
        гром.gain.exponentialRampToValueAtTime(0.08, ак.currentTime + 0.01);
        гром.gain.exponentialRampToValueAtTime(0.0001, ак.currentTime + 0.12);
        ген.connect(гром); гром.connect(ак.destination);
        ген.start(); ген.stop(ак.currentTime + 0.13);
        setTimeout(() => ак.close(), 400);
      } catch (е) { /* звук -- приятная мелочь, без него всё работает */ }
    }

    /** Человеческое имя формата: ean_13 и EAN_13 от разных движков -- одно и то же. */
    function имяФормата(ф) {
      const к = String(ф || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
      const карта = { EAN13: 'EAN-13', EAN8: 'EAN-8', UPCA: 'UPC-A', UPCE: 'UPC-E',
        CODE128: 'Code 128', CODE39: 'Code 39', CODE93: 'Code 93', ITF: 'ITF',
        QRCODE: 'QR', DATAMATRIX: 'Data Matrix', PDF417: 'PDF417', AZTEC: 'Aztec' };
      return карта[к] || String(ф || '');
    }

    function показатьQR(текст) {
      const разбор = разобратьСодержимое(текст);
      итог.appendChild(узел('span', 'скш-вид', с.kindQr));
      итог.appendChild(узел('div', 'скш-значение', разбор.текст));
      итог.appendChild(узел('div', 'скш-подсказ', с.otherHint));
      $('скш-туда').style.display = 'inline-flex';
    }

    /** Дата на языке страницы. Числами -- их ни с чем не спутать в любой стране. */
    function датой(разбор) {
      if (!разбор) return '';
      const д = разбор.дата.toLocaleDateString(язык, { year: 'numeric', month: 'long', day: 'numeric' });
      return разбор.конецМесяца ? `${д} (${с.endMonth})` : д;
    }

    /** Поля кода GS1: срок годности, партия, вес -- всё, что в нём действительно есть. */
    function показатьGS1(поля) {
      итог.appendChild(узел('div', 'скш-шапка-разбора', с.gs1Head));
      итог.appendChild(пары(поля.map((п) => {
        const имя = (с.ai || {})[п.имя] || п.имя;
        let значение = п.значение;
        if (п.вид === 'дата' && п.разбор) значение = датой(п.разбор);
        if (п.вид === 'мера' && п.разбор) {
          значение = `${п.разбор.число} ${п.разбор.единица}`.trim();
        }
        return [`${имя} (${п.код})`, значение];
      })));
    }

    function показатьШтрих(текст, формат) {
      const р = разобратьШтрих(текст, формат);
      итог.appendChild(узел('span', 'скш-вид', с.kindBar));
      итог.appendChild(узел('div', 'скш-значение', р.цифры));

      const строки = [[с.fFormat, имяФормата(р.формат)]];
      if (р.контроль) {
        строки.push([с.fCheck, р.контроль.сошлась
          ? с.checkOk
          : `${с.checkBad} ${р.контроль.должна}`]);
      }
      if (р.страна) строки.push([с.fCountry, названиеСтраны(р.страна, язык)]);
      if (р.пометка) {
        const слово = { книга: с.markБook, ноты: с.markНоты, журнал: с.markЖурнал,
          внутренний: с.markВнутренний, купон: с.markКупон, возврат: с.markВозврат,
          gs1: с.markGs1 }[р.пометка];
        if (слово) строки.push([с.fInside, слово]);
      }
      if (р.isbn10) строки.push([с.fIsbn10, р.isbn10]);
      // Из чего сложены цифры: префикс организации, номер фирмы с товаром и контрольная.
      // Человеку это видно сразу, и понятно, откуда взялась страна.
      if (р.контроль && р.цифры.length >= 8) {
        const тело = р.цифры.slice(0, -1);
        const части = `${тело.slice(0, 3)} · ${тело.slice(3)} · ${р.цифры.slice(-1)}`;
        строки.push([с.fParts, `${части}   (${с.pPrefix} · ${с.pBody} · ${с.pCheck})`]);
      }
      итог.appendChild(пары(строки));

      // Если внутри GS1 -- показываем всё, что там записано. Товарные EAN и UPC сюда не
      // отдаём: полей GS1 в них не бывает, а цифры вроде 2000000000008 разбор принимает за
      // поле «вариант» и выдумывает то, чего в коде нет.
      const поля = р.контроль ? [] : разобратьGS1(текст);
      if (поля.length) показатьGS1(поля);
      else if (р.контроль) {
        // А если это обычный товарный код -- говорим прямо, чего в нём нет. Иначе человек
        // ищет глазами срок годности и решает, что инструмент сломан.
        итог.appendChild(узел('div', 'скш-подсказ', с.noMore));
      }

      // Внутренний код магазина без пояснения выглядит как поломка: страны нет, смысла нет.
      if (р.пометка === 'внутренний') итог.appendChild(узел('div', 'скш-подсказ', с.inStore));

      if (р.контроль && !р.контроль.сошлась) {
        const б = узел('div', 'скш-тревога');
        б.innerHTML = `<b>${с.badTitle}</b> ${с.badText}`;
        итог.appendChild(б);
      }
    }

    function показать(находка) {
      найдено = находка.текст;
      итог.replaceChildren();
      $('скш-копировать').disabled = false;
      $('скш-туда').style.display = 'none';
      $('скш-искать').style.display = 'none';
      $('скш-база').style.display = 'none';
      if (находка.вид === 'qr') показатьQR(находка.текст);
      else {
        показатьШтрих(находка.текст, находка.формат);
        // Названия товара в коде нет и быть не может -- но найти его по номеру можно, и это
        // ровно то, зачем сюда приходят. Кнопка честная: она уводит в поиск, а не делает вид,
        // что мы знаем товар.
        const искать = $('скш-искать');
        искать.href = 'https://www.google.com/search?q=' + encodeURIComponent(находка.текст);
        искать.style.display = 'inline-flex';
        // В открытой базе лежат товары, а не складские наклейки: спрашивать её имеет смысл
        // только про розничный номер.
        const р = разобратьШтрих(находка.текст, находка.формат);
        if (р.контроль && р.контроль.сошлась) {
          const б = $('скш-база');
          б.style.display = 'inline-flex';
          б.disabled = false;
          б.textContent = с.base;
          б.dataset.код = р.цифры;
        }
      }
      пикнуть();
      $('скш-глазок').classList.add('нашёл');
      setTimeout(() => $('скш-глазок').classList.remove('нашёл'), 900);
    }

    function сказатьВИтог(текст) {
      итог.replaceChildren(узел('span', 'скш-ждём', текст));
      $('скш-копировать').disabled = true;
      $('скш-искать').style.display = 'none';
      $('скш-туда').style.display = 'none';
      $('скш-база').style.display = 'none';
      найдено = '';
    }

    /** Один проход по картинке. */
    async function разобратьКадр(источник, ширина, высота, рисовать, снимок) {
      if (!ширина || !высота) return null;
      холст.width = ширина;
      холст.height = высота;
      const рис = холст.getContext('2d', { willReadFrequently: true });
      рисовать(рис);
      const точки = рис.getImageData(0, 0, ширина, высота);
      return прочитатьКадр({ источник, точки, нужно: 'оба', снимок });
    }

    async function круг() {
      if (!ищем || режим !== 'camera') return;
      if (видео.readyState >= 2) {
        try {
          const к = Math.min(1, 960 / Math.max(видео.videoWidth, видео.videoHeight));
          const н = await разобратьКадр(видео,
            Math.round(видео.videoWidth * к), Math.round(видео.videoHeight * к),
            (рис) => рис.drawImage(видео, 0, 0, видео.videoWidth * к, видео.videoHeight * к),
            false);
          if (н && н.текст !== найдено) показать(н);
        } catch (е) { /* один неудачный кадр -- не беда, ждём следующий */ }
      }
      if (ищем) setTimeout(() => requestAnimationFrame(круг), 250);
    }

    /** Снимок: кадр застывает, по нему проходит луч, и в это время идёт разбор. */
    async function снять() {
      if (!поток || снимаем || видео.readyState < 2) return;
      снимаем = true;
      ищем = false;                                  // живой разбор на время снимка не нужен
      const кадр = $('скш-кадр');
      кадр.width = видео.videoWidth;
      кадр.height = видео.videoHeight;
      кадр.getContext('2d').drawImage(видео, 0, 0);
      $('скш-глазок').classList.add('снимок', 'ищет');
      щёлкнуть();
      сказатьВИтог(с.looking);

      // Луч идёт своё время, разбор -- своё. Показываем, когда готово И то, и другое: ответ
      // поверх недобежавшего луча выглядел бы поломкой. Но и держать готовый ответ ради
      // красоты не станем -- ждём ровно один проход луча, не дольше.
      const луч = new Promise((г) => setTimeout(г, 900));
      let н = null;
      try { н = await прочитатьСнимок({ картинка: кадр, нужно: 'оба' }); } catch (е) { н = null; }
      await луч;
      $('скш-глазок').classList.remove('ищет');
      снимаем = false;
      if (н) показать(н); else сказатьВИтог(с.notShot);
    }

    /** Щелчок затвора: короткий и тихий, это подтверждение, а не звуковой эффект. */
    function щёлкнуть() {
      try {
        const ак = new (window.AudioContext || window.webkitAudioContext)();
        const шум = ак.createBufferSource();
        const б = ак.createBuffer(1, ак.sampleRate * 0.04, ак.sampleRate);
        const д = б.getChannelData(0);
        for (let и = 0; и < д.length; и++) д[и] = (Math.random() * 2 - 1) * (1 - и / д.length) ** 6;
        шум.buffer = б;
        const гром = ак.createGain();
        гром.gain.value = 0.22;
        шум.connect(гром); гром.connect(ак.destination);
        шум.start();
        setTimeout(() => ак.close(), 300);
      } catch (е) { /* без звука всё работает */ }
    }

    /** Вернуться к живой картинке после снимка. */
    function снятьЕщё() {
      $('скш-глазок').classList.remove('снимок', 'ищет');
      if (поток) { ищем = true; круг(); }
    }

    async function включить() {
      if (поток) { выключить(); return; }
      try {
        поток = await navigator.mediaDevices.getUserMedia({
          // Полосы тоньше, чем клетки QR: просим кадр покрупнее, иначе они сливаются.
          video: { facingMode: 'environment', width: { ideal: 1920 } }, audio: false,
        });
      } catch (е) {
        $('скш-заслон').hidden = false;
        $('скш-слово').textContent = с.camDenied;
        return;
      }
      видео.srcObject = поток;
      await видео.play().catch(() => {});
      $('скш-заслон').hidden = true;
      значокКамеры(true);
      $('скш-глазок').classList.remove('снимок', 'ищет');
      // Подсказка честная: там, где живая камера полос не ловит, снимок -- единственный путь,
      // и молчать об этом нельзя. Где ловит -- она всё равно не мешает.
      $('скш-намёк').textContent = с.liveHint;
      ищем = true;
      круг();
    }

    function выключить() {
      ищем = false;
      if (поток) { поток.getTracks().forEach((д) => д.stop()); поток = null; }
      видео.srcObject = null;
      снимаем = false;
      $('скш-глазок').classList.remove('снимок', 'ищет');
      $('скш-заслон').hidden = false;
      $('скш-слово').textContent = ловитПолоски ? с.camIdle : с.camNo1D;
      значокКамеры(false);
    }

    /** Перечёркнутый фотоаппарат = «выключить». Подпись меняется вместе со значком:
        кнопка без букв должна называть себя хотя бы голосовому чтению. */
    function значокКамеры(идёт) {
      const к = $('скш-глаз');
      к.classList.toggle('идёт', идёт);
      к.setAttribute('aria-label', идёт ? с.stop : с.camera);
      к.setAttribute('title', идёт ? с.stop : с.camera);
    }

    async function взятьКартинку(файл) {
      if (!файл) return;
      сказатьВИтог(с.looking);
      const адрес = URL.createObjectURL(файл);
      const карт = new Image();
      карт.onload = async () => {
        let н = null;
        try {
          н = await прочитатьСнимок({ картинка: карт, нужно: 'оба' });
        } catch (е) { н = null; }
        // Показываем сам снимок: сразу видно, тот ли файл разбирали.
        // Поле файла надо забрать ДО замены содержимого: replaceChildren вынимает его
        // из страницы, и getElementById после этого возвращает пусто. Из-за этого «Выбрать
        // другой» падал с ошибкой, и второй файл выбрать было уже нельзя.
        const поле = $('скш-файл');
        const ещё = узел('span', 'скш-взять', с.again);
        ещё.addEventListener('click', (е) => { е.preventDefault(); поле.click(); });
        $('скш-зона').replaceChildren(карт, ещё, поле);
        if (н) показать(н); else сказатьВИтог(с.notShot);
        URL.revokeObjectURL(адрес);
      };
      карт.onerror = () => { сказатьВИтог(с.notFound); URL.revokeObjectURL(адрес); };
      карт.src = адрес;
    }

    function выбратьРежим(новый) {
      режим = новый;
      корень.querySelector('.скш-выбор[data-р="photo"]')
        .classList.toggle('выбран', новый === 'photo');
      const камера = новый === 'camera';
      $('скш-глазок').hidden = !камера;
      $('скш-зона').hidden = камера;
      if (!камера) выключить();
    }

    // Нажатие на фотоаппарат: из режима снимка -- переключиться и сразу включить камеру;
    // в режиме камеры -- включить или выключить её.
    $('скш-крупный').addEventListener('click', () => {
      if (режим !== 'camera') выбратьРежим('camera');
      включить();
    });

    $('скш-затвор').addEventListener('click', () => {
      if ($('скш-глазок').classList.contains('снимок')) снятьЕщё(); else снять();
    });

    $('скш-глаз').addEventListener('click', () => {
      if (режим !== 'camera') { выбратьРежим('camera'); включить(); return; }
      if (поток) выключить(); else включить();
    });
    корень.querySelector('.скш-выбор[data-р="photo"]')
      .addEventListener('click', () => выбратьРежим('photo'));

    $('скш-файл').addEventListener('change', (е) => взятьКартинку(е.target.files && е.target.files[0]));
    $('скш-выбрать').addEventListener('click', (е) => { е.preventDefault(); $('скш-файл').click(); });

    for (const событие of ['dragenter', 'dragover']) {
      $('скш-зона').addEventListener(событие, (е) => { е.preventDefault(); $('скш-зона').classList.add('держат'); });
    }
    $('скш-зона').addEventListener('dragleave', () => $('скш-зона').classList.remove('держат'));
    $('скш-зона').addEventListener('drop', (е) => {
      е.preventDefault();
      $('скш-зона').classList.remove('держат');
      взятьКартинку(е.dataTransfer && е.dataTransfer.files && е.dataTransfer.files[0]);
    });

    document.addEventListener('paste', (е) => {
      const вещи = е.clipboardData && е.clipboardData.items;
      if (!вещи) return;
      for (const в of вещи) {
        if (в.type && в.type.startsWith('image/')) {
          const файл = в.getAsFile();
          if (файл) {
            корень.querySelector('.скш-выбор[data-р="photo"]').click();
            взятьКартинку(файл);
          }
          break;
        }
      }
    });

    /** Спросить открытую базу. Уходит только номер и только отсюда. */
    async function спроситьБазу() {
      const кнопка = $('скш-база');
      const код = кнопка.dataset.код;
      if (!код) return;
      кнопка.disabled = true;
      кнопка.textContent = с.baseWait;

      let товар = null;
      try {
        const поля = ['product_name', 'product_name_' + язык, 'brands', 'quantity',
          'categories', 'countries', 'nutriscore_grade', 'image_front_small_url'].join(',');
        const ответ = await fetch(
          `https://world.openfoodfacts.org/api/v2/product/${encodeURIComponent(код)}.json?fields=${поля}`);
        const данные = await ответ.json();
        товар = данные && данные.status === 1 ? данные.product : false;
      } catch (е) {
        товар = null;                      // связи нет -- это не то же самое, что «не найден»
      }

      кнопка.style.display = 'none';
      const коробка = узел('div', 'скш-товар');
      if (товар === null) {
        коробка.appendChild(узел('div', 'скш-подсказ', с.baseFail));
        кнопка.disabled = false;
        кнопка.textContent = с.base;
        кнопка.style.display = 'inline-flex';
      } else if (товар === false) {
        коробка.appendChild(узел('div', 'скш-подсказ', с.baseNone));
      } else {
        const имя = товар['product_name_' + язык] || товар.product_name || '';
        if (товар.image_front_small_url) {
          const карт = document.createElement('img');
          карт.className = 'скш-снимок-товара';
          карт.src = товар.image_front_small_url;
          карт.alt = имя;
          карт.loading = 'lazy';
          коробка.appendChild(карт);
        }
        const строки = [[с.fName, имя], [с.fBrand, товар.brands], [с.fQty, товар.quantity]];
        if (товар.nutriscore_grade) строки.push([с.fScore, String(товар.nutriscore_grade).toUpperCase()]);
        // Списки в базе длинные, и целиком они не помогают -- берём первые три. Заодно
        // выбрасываем служебные метки вида «pt:bebidas»: это внутренняя запись базы, для
        // человека она выглядит опечаткой.
        const коротко = (с2) => String(с2 || '').split(',').map((к) => к.trim())
          .filter((к) => к && !/^[a-z]{2}:/.test(к)).slice(0, 3).join(', ');
        строки.push([с.fCats, коротко(товар.categories)], [с.fWhere, коротко(товар.countries)]);
        коробка.appendChild(пары(строки));
        // Данные чужие и открытые: назвать источник -- условие, на котором их отдают.
        коробка.appendChild(узел('div', 'скш-источник', с.baseFrom));
      }
      итог.appendChild(коробка);
    }

    $('скш-база').addEventListener('click', спроситьБазу);

    $('скш-копировать').addEventListener('click', async () => {
      const кнопка = $('скш-копировать');
      if (!найдено) return;
      try { await navigator.clipboard.writeText(найдено); }
      catch (е) { return; }
      кнопка.textContent = с.copied;
      clearTimeout(кнопка._т);
      кнопка._т = setTimeout(() => { кнопка.textContent = с.copy; }, 1500);
    });

    window.addEventListener('pagehide', выключить);

    // Честная надпись под камерой там, где браузер не умеет ловить полосы на лету.
    камераВидитПолоски().then((умеет) => {
      ловитПолоски = умеет;
      if (!умеет && !поток) $('скш-слово').textContent = с.camNo1D;
    });

    window.__скшСостояние = () => ({
      режим,
      снимаем,
      стопКадр: $('скш-глазок').classList.contains('снимок'),
      затворВиден: $('скш-затвор').getBoundingClientRect().width > 0,
      найдено,
      итог: итог.textContent.trim(),
      вид: (итог.querySelector('.скш-вид') || {}).textContent || '',
      значение: (итог.querySelector('.скш-значение') || {}).textContent || '',
      пары: [...итог.querySelectorAll('.скш-пары dt')].map((д, и) =>
        [д.textContent, итог.querySelectorAll('.скш-пары dd')[и].textContent]),
      тревога: !!итог.querySelector('.скш-тревога'),
      кнопкаЖива: !$('скш-копировать').disabled,
      базаВидна: $('скш-база').style.display !== 'none',
      товар: (итог.querySelector('.скш-товар') || {}).textContent || '',
      наQR: $('скш-туда').style.display !== 'none',
    });
    window.__скшПоказать = показать;
  })();
</script>
