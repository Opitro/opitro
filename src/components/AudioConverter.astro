---
// First concrete audio tool, and the template for the rest of the ffmpeg.wasm-based audio
// family: drop zone, format/bitrate controls, progress bar, error box. The heavy lifting
// (loading ffmpeg, running the conversion) lives in src/lib/audio-engine.js so this component
// stays UI-only and the same runner can back trim/volume/speed/reverse tools later.
interface Props {
  dropLabel: string;
  dropHint: string;
  formatLabel: string;
  bitrateLabel: string;
  convertLabel: string;
  newFileLabel: string;
  preparingLabel: string;
  convertingLabel: string;
  doneLabel: string;
  loadingEncoderLabel: string;
}

const {
  dropLabel,
  dropHint,
  formatLabel,
  bitrateLabel,
  convertLabel,
  newFileLabel,
  preparingLabel,
  convertingLabel,
  doneLabel,
  loadingEncoderLabel,
} = Astro.props;
---

<div class="audio-tool" data-preparing={preparingLabel} data-converting={convertingLabel} data-done={doneLabel} data-loading-encoder={loadingEncoderLabel}>
  <div class="drop" id="audio-drop">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5M12 15V3"/></svg>
    <div class="big">{dropLabel}</div>
    <div class="small">{dropHint}</div>
  </div>
  <input type="file" id="audio-file-input" accept="audio/*">

  <div class="panel" id="audio-panel">
    <div class="fileinfo" id="audio-fileinfo"></div>
    <div class="row">
      <div class="field">
        <label for="audio-fmt">{formatLabel}</label>
        <select id="audio-fmt">
          <option value="mp3">MP3</option>
          <option value="m4a">M4A (AAC)</option>
          <option value="m4r">M4R</option>
          <option value="wav">WAV</option>
          <option value="ogg">OGG</option>
          <option value="flac">FLAC</option>
        </select>
      </div>
      <div class="field" id="audio-br-field">
        <label for="audio-br">{bitrateLabel}</label>
        <select id="audio-br">
          <option value="320">320 kbps</option>
          <option value="256">256 kbps</option>
          <option value="192" selected>192 kbps</option>
          <option value="128">128 kbps</option>
          <option value="96">96 kbps</option>
        </select>
      </div>
    </div>

    <div class="controls">
      <button class="act primary" id="audio-convert-btn">{convertLabel}</button>
      <button class="act" id="audio-new-btn">{newFileLabel}</button>
    </div>

    <div class="progress" id="audio-progress">
      <div class="progress-bar"><div class="progress-fill" id="audio-progress-fill"></div></div>
      <div class="progress-text" id="audio-progress-text"></div>
    </div>

    <div class="err" id="audio-err"></div>
  </div>
</div>

<script>
  import { runFFmpeg, downloadBlob, loadFFmpeg } from '../lib/audio-engine.js';

  const MAX_MB = 500;
  const root = document.querySelector('.audio-tool');
  if (root) {
    const drop = root.querySelector('#audio-drop');
    const fileInput = root.querySelector('#audio-file-input');
    const panel = root.querySelector('#audio-panel');
    const fileInfo = root.querySelector('#audio-fileinfo');
    const fmtSel = root.querySelector('#audio-fmt');
    const brSel = root.querySelector('#audio-br');
    const brField = root.querySelector('#audio-br-field');
    const convertBtn = root.querySelector('#audio-convert-btn');
    const newBtn = root.querySelector('#audio-new-btn');
    const progress = root.querySelector('#audio-progress');
    const progressFill = root.querySelector('#audio-progress-fill');
    const progressText = root.querySelector('#audio-progress-text');
    const errBox = root.querySelector('#audio-err');

    const LABELS = {
      preparing: root.dataset.preparing,
      converting: root.dataset.converting,
      done: root.dataset.done,
      loadingEncoder: root.dataset.loadingEncoder,
    };

    let file = null;

    function showError(message) {
      errBox.textContent = message;
      errBox.classList.add('show');
    }
    function clearError() {
      errBox.classList.remove('show');
    }

    function pickFile(f) {
      clearError();
      if (f.size > MAX_MB * 1024 * 1024) {
        showError(`File is larger than ${MAX_MB} MB.`);
        return;
      }
      file = f;
      const sizeMB = f.size / 1048576;
      fileInfo.innerHTML = `<b>${f.name}</b> · ${sizeMB.toFixed(1)} MB`;
      panel.classList.add('on');
      drop.style.display = 'none';
      // Warm the encoder in the background while the user picks a format -- shaves the
      // ~30 MB core+wasm download off the perceived wait once they hit "Convert".
      loadFFmpeg().catch(() => {});
    }

    drop.addEventListener('click', () => fileInput.click());
    newBtn.addEventListener('click', () => fileInput.click());
    drop.addEventListener('dragover', (e) => {
      e.preventDefault();
      drop.classList.add('over');
    });
    drop.addEventListener('dragleave', () => drop.classList.remove('over'));
    drop.addEventListener('drop', (e) => {
      e.preventDefault();
      drop.classList.remove('over');
      if (e.dataTransfer.files[0]) pickFile(e.dataTransfer.files[0]);
    });
    fileInput.addEventListener('change', (e) => {
      if (e.target.files[0]) pickFile(e.target.files[0]);
    });

    fmtSel.addEventListener('change', () => {
      const lossless = ['wav', 'flac'].includes(fmtSel.value);
      brField.style.display = lossless ? 'none' : '';
    });

    function buildArgsFor(format, bitrate) {
      return (inputName, outputName) => {
        if (format === 'mp3') return ['-i', inputName, '-b:a', `${bitrate}k`, outputName];
        if (format === 'm4a') return ['-i', inputName, '-c:a', 'aac', '-b:a', `${bitrate}k`, outputName];
        if (format === 'm4r') return ['-i', inputName, '-c:a', 'aac', '-b:a', `${bitrate}k`, '-f', 'ipod', outputName];
        if (format === 'wav') return ['-i', inputName, outputName];
        if (format === 'ogg') return ['-i', inputName, '-c:a', 'libvorbis', '-b:a', `${bitrate}k`, outputName];
        if (format === 'flac') return ['-i', inputName, outputName];
        return ['-i', inputName, outputName];
      };
    }

    const MIME = { mp3: 'audio/mpeg', m4a: 'audio/mp4', m4r: 'audio/x-m4r', wav: 'audio/wav', ogg: 'audio/ogg', flac: 'audio/flac' };

    convertBtn.addEventListener('click', async () => {
      if (!file) return;
      clearError();
      convertBtn.disabled = true;
      progress.classList.add('on');
      progressFill.style.width = '0%';
      progressText.textContent = LABELS.preparing;

      const format = fmtSel.value;
      const bitrate = brSel.value;
      const outputName = `out.${format}`;

      try {
        const blob = await runFFmpeg({
          file,
          buildArgs: buildArgsFor(format, bitrate),
          outputName,
          mimeType: MIME[format] || 'audio/mpeg',
          onProgress: (pct) => {
            progressFill.style.width = pct + '%';
            progressText.textContent = `${LABELS.converting} ${pct}%`;
          },
        });
        const base = file.name.replace(/\.[^.]+$/, '') || 'audio';
        downloadBlob(blob, `${base}.${format}`);
        progressFill.style.width = '100%';
        progressText.textContent = LABELS.done;
      } catch (e) {
        showError(e && e.message ? e.message : String(e));
        progress.classList.remove('on');
      }
      convertBtn.disabled = false;
    });
  }
</script>

<style is:global>
  .audio-tool .drop{border:1.5px dashed var(--line);border-radius:14px;padding:32px 20px;text-align:center;cursor:pointer;transition:.2s;background:var(--surface)}
  .audio-tool .drop:hover,.audio-tool .drop.over{border-color:var(--accent);background:rgba(74,222,158,0.04)}
  .audio-tool .drop svg{width:34px;height:34px;color:var(--accent);margin-bottom:10px}
  .audio-tool .drop .big{font-size:15px;font-weight:600;margin-bottom:4px}
  .audio-tool .drop .small{font-size:12px;color:var(--muted)}
  .audio-tool input[type=file]{display:none}

  .audio-tool .panel{display:none;margin-top:8px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px}
  .audio-tool .panel.on{display:block}
  .audio-tool .fileinfo{font-size:13px;color:var(--muted);margin-bottom:16px;word-break:break-word}
  .audio-tool .fileinfo b{color:var(--text)}

  .audio-tool .row{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:14px}
  .audio-tool .field{flex:1;min-width:150px}
  .audio-tool .field label{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);display:block;margin-bottom:6px}
  .audio-tool .field select{width:100%;background:var(--surface-2);border:1px solid var(--line);border-radius:10px;color:var(--text);font-family:inherit;font-size:15px;padding:10px 12px;height:46px;cursor:pointer}
  .audio-tool .field select:focus{outline:none;border-color:rgba(74,222,158,0.5)}

  .audio-tool .controls{display:flex;gap:12px;flex-wrap:wrap;margin-top:6px}
  .audio-tool button.act{font-family:inherit;font-weight:600;font-size:14px;cursor:pointer;border:1px solid var(--line);background:var(--surface-2);color:var(--text);border-radius:12px;padding:14px 18px;flex:1;min-width:130px;transition:transform .12s,background .2s,border-color .2s}
  .audio-tool button.act:hover{transform:translateY(-2px);border-color:rgba(255,255,255,0.2)}
  .audio-tool button.act:disabled{opacity:.35;cursor:not-allowed;transform:none}
  .audio-tool .primary{background:linear-gradient(180deg,var(--accent),var(--accent2));border-color:var(--accent);color:#08130d;font-weight:700}

  .audio-tool .progress{display:none;margin-top:16px}
  .audio-tool .progress.on{display:block}
  .audio-tool .progress-bar{height:6px;background:rgba(255,255,255,0.08);border-radius:6px;overflow:hidden}
  .audio-tool .progress-fill{height:100%;width:0%;background:linear-gradient(90deg,var(--accent),var(--accent2));transition:width .2s}
  .audio-tool .progress-text{font-size:12px;color:var(--muted);margin-top:8px;text-align:center}

  .audio-tool .err{display:none;margin-top:14px;background:rgba(255,58,94,.12);border:1px solid rgba(255,58,94,.4);color:#ffb3c0;border-radius:10px;padding:12px 14px;font-size:12.5px;line-height:1.5}
  .audio-tool .err.show{display:block}
</style>
