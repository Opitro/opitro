};
const с = СЛОВА[locale] || СЛОВА.ru;
---

<style is:inline set:html={css}></style>

<div class="рч" data-words={JSON.stringify(с)} data-locale={locale} data-limit={ПРЕДЕЛ}>
  <div class="рч-пульт">
    <span class="рч-модели" id="рч-модели">
      {МОДЕЛИ.map((м) => (
        <button type="button" class:list={['рч-модель', м.ключ === 'piper' && 'выбран']}
                id={`рч-м-${м.ключ}`} data-модель={м.ключ}>
          <b class="рч-м-имя">{м.имя}</b>
          <span class="рч-м-вес">{м.весМин ? `${м.весМин}–${м.вес}` : м.вес} МБ</span>
          <span class="рч-м-что">{м.ключ === 'piper' ? с.mPiper : м.ключ === 'kokoro' ? с.mKokoro : с.mSupertonic}</span>
        </button>
      ))}
      <button type="button" class="рч-дв" id="рч-дв-устройство" hidden>{с.engDev}</button>
      <button type="button" class="рч-дв" id="рч-дв-свой" hidden>{с.engOwn}</button>
    </span>
    <span class="рч-м-подпись">{с.mNote}</span>
    <span class="рч-голос-гнездо">
      <span class="рч-подпись">{с.voice}:</span>
      <select class="рч-список" id="рч-голос" disabled>
        <option>{с.loadingVoices}</option>
      </select>
    </span>
    <span class="рч-ручки">
      <span class="рч-ручка">
        <span class="рч-подпись">{с.rate}:</span>
        <input type="range" class="рч-ползунок" id="рч-скорость" min="0.5" max="2" step="0.05" value="1" />
        <span class="рч-значение" id="рч-скорость-знач">1.00x</span>
      </span>
      <span class="рч-ручка" id="рч-ручка-тон" hidden>
        <span class="рч-подпись">{с.pitch}:</span>
        <input type="range" class="рч-ползунок" id="рч-тон" min="0" max="2" step="0.05" value="1" />
        <span class="рч-значение" id="рч-тон-знач">1.00</span>
      </span>
      <span class="рч-голос-весть" id="рч-голос-весть"></span>
    </span>
  </div>

  <div class="рч-поле">
    <textarea class="рч-ввод" id="рч-ввод" placeholder={с.place} maxlength={ПРЕДЕЛ} spellcheck="false"></textarea>
  </div>

  <div class="рч-счётчики">
    <span id="рч-знаков-гнездо">{с.chars}: <b id="рч-знаков">0</b> / {ПРЕДЕЛ}</span>
    <span>{с.parts}: <b id="рч-кусков">0</b></span>
    <span class="рч-сказ" id="рч-сказ"></span>
  </div>

  <div class="рч-читается" id="рч-читается">{с.idle}</div>

  <div class="рч-низ">
    <button type="button" class="рч-кнопка" id="рч-играть">{с.play}</button>
    <button type="button" class="рч-простая" id="рч-стоп" disabled>{с.stop}</button>
    <span class="рч-формат">
      <button type="button" class="рч-фмт выбран" id="рч-mp3" data-ф="mp3">MP3</button>
      <button type="button" class="рч-фмт" id="рч-wav" data-ф="wav">WAV</button>
      <button type="button" class="рч-скачать" id="рч-скачать">{с.download}</button>
    </span>
  </div>

  <div class="рч-полоса" id="рч-полоса"><i id="рч-полоса-и"></i></div>
  <div class="рч-ответ" id="рч-ответ"></div>

  <div class="рч-заметки">
    <div class="рч-заметка" set:html={с.n1}></div>
    <div class="рч-заметка" set:html={с.n2}></div>
    <div class="рч-заметка" set:html={с.n3}></div>
    <div class="рч-заметка" set:html={с.n4}></div>
    <div class="рч-заметка" set:html={с.n5}></div>
    <div class="рч-заметка">{с.n6}</div>
  </div>
</div>

<script>
  import { encodeWAV, encodeMP3, downloadBlob, peakOf } from '../lib/web-audio-engine.js';
  import { ГОЛОСА } from '../lib/piper-voices.js';

  const корень = document.querySelector('.рч');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const язык = корень.dataset.locale || 'ru';
    const ПРЕДЕЛ = Number(корень.dataset.limit) || 5000;
    const $ = (и) => document.getElementById(и);

    const ввод = $('рч-ввод');
    const списокГолосов = $('рч-голос');
    const кнИграть = $('рч-играть');
    const кнСтоп = $('рч-стоп');
    const кнСкачать = $('рч-скачать');
    const строкаЧитается = $('рч-читается');
    const окноОтвета = $('рч-ответ');
    const полоса = $('рч-полоса');
    const полосаИ = $('рч-полоса-и');

    const синтез = window.speechSynthesis;
    let голоса = [];
    // Двигатель: «устройство» -- голоса системы, «свой» -- Piper прямо в браузере.
    // Встроенный голос -- первым и по умолчанию: только он даёт файл на любом устройстве.
    // Голоса устройства -- второй кнопкой, для прослушивания.
    let двигатель = 'piper';
    let работник = null;
    let скачанные = [];
    // ВСЕ языки, а не только язык страницы: озвучивать приходится и чужой текст -- испанскую
    // фразу в русской статье, немецкую цитату в английской. Язык страницы идёт первым, потому
    // что нужен чаще всего. Название языка берётся на нём же самом («Deutsch», «Українська»):
    // так человек находит своё на любой языковой версии и переводить ничего не надо.
    let своиГолоса = ГОЛОСА.slice().sort((а, б) => {
      const свой = (г) => (г.я === язык ? 0 : 1);
      return свой(а) - свой(б) || а.яз.localeCompare(б.яз) || а.мб - б.мб || а.имя.localeCompare(б.имя);
    });
    let плеер = null;          // обычный <audio> для встроенного голоса
    let плеерРазбужен = false;
    // Полсотни миллисекунд тишины: нужны только чтобы разбудить проигрыватель в жесте.
    const ТИШИНА = 'data:audio/wav;base64,UklGRjIAAABXQVZFZm10IBAAAAABAAEAgD4AAAB9AAACABAAZGF0YQ4AAAAAAAAAAAAAAAAAAAAAAA==';
    let готовыйЗвук = null;    // {ключ, blob} -- чтобы не считать одно и то же дважды
    let ждущие = [];
    let формат = 'mp3';
    let очередь = [];
    let ноль = 0;              // с какого куска читаем -- нужно при смене скорости на ходу
    let текущее = null;
    let состояние = 'стоп';    // стоп | читает | пауза | пишет
    let отменено = false;
    let приЗавершении = null;  // ждёт конца чтения, когда идёт запись

    // ---- Среда -------------------------------------------------------------------------------
    // От неё зависит и подсказка в окне выбора, и сам факт наличия записи.
    const среда = (() => {
      const ua = navigator.userAgent || '';
      const iOS = /iPad|iPhone|iPod/.test(ua) ||
        (navigator.platform === 'MacIntel' && (navigator.maxTouchPoints || 0) > 1);
      const android = /Android/i.test(ua);
      const safari = /Safari/.test(ua) && !/Chrome|Chromium|CriOS|Edg|OPR|FxiOS/.test(ua);
      const windows = /Windows/i.test(ua);
      const умеет = !!(navigator.mediaDevices && navigator.mediaDevices.getDisplayMedia) &&
        typeof window.MediaRecorder === 'function' && !iOS && !android && !safari;
      return { iOS, android, safari, windows, умеет };
    })();

    // ---- Встроенный голос: связь с работником --------------------------------------------------------
    // Синтез идёт в стороне от страницы: на своём потоке длинный текст заморозил бы её на
    // десятки секунд, и Chrome предложил бы её закрыть.

    // Поток на каждую модель: договор у них один, а состояние своё. Переключился туда и
    // обратно -- модель не качается заново, поток жив.
    const ПОТОКИ = {
      piper: '../lib/tts-piper-worker.js',
      kokoro: '../lib/tts-kokoro-worker.js',
      supertonic: '../lib/tts-supertonic-worker.js',
    };
    const работники = new Map();

    function поднятьРаботника() {
      const ключ = двигатель;
      if (работники.has(ключ)) { работник = работники.get(ключ); return работник; }
      const адрес = ПОТОКИ[ключ] || ПОТОКИ.piper;
      работник = new Worker(new URL(адрес, import.meta.url), { type: 'module' });
      работники.set(ключ, работник);
      работник.onmessage = (е) => {
        const д = е.data || {};
        if (д.список) { скачанные = д.список; показатьПроГолос(); }
        if (д.тип === 'ход') {
          const подпись = д.этап === 'синтез' ? с.synth : с.dling;
          показатьРаботу(`${подпись}… ${Math.round(д.доля)}%`, д.доля);
          return;
        }
        const ждёт = ждущие.shift();
        if (!ждёт) return;
        if (д.тип === 'беда') ждёт.беда(new Error(д.текст));
        else ждёт.готово(д);
      };
      работник.onerror = () => {
        const ждёт = ждущие.shift();
        if (ждёт) ждёт.беда(new Error(с.piperFail));
      };
      работник.postMessage({ тип: 'что-скачано' });
      return работник;
    }

    function спросить(весть) {
      поднятьРаботника();
      return new Promise((готово, беда) => {
        ждущие.push({ готово, беда });
        работник.postMessage(весть);
      });
    }

    function показатьРаботу(текст, доля) {
      строкаЧитается.classList.add('идёт');
      строкаЧитается.textContent = текст;
      полоса.classList.add('идёт');
      полосаИ.style.width = `${Math.max(2, Math.round(доля))}%`;
    }

    // Строка под списком: сколько весит голос и лежит ли он уже на устройстве.
    function показатьПроГолос() {
      const э = $('рч-голос-весть');
      if (двигатель !== 'свой') { э.textContent = ''; return; }
      const г = выбранныйГолос();
      if (!г) { э.textContent = ''; return; }
      const есть = скачанные.includes(г.к);
      э.textContent = `${с.size}: ${г.мб} ${с.mb} — ${есть ? с.ready : с.notReady}`;
      э.classList.toggle('готов', есть);
    }

    // ---- Мелочи ------------------------------------------------------------------------------

    function сказать(текст) {
      const э = $('рч-сказ');
      э.textContent = текст;
      э.classList.add('видно');
      clearTimeout(э._т);
      э._т = setTimeout(() => э.classList.remove('видно'), 2600);
    }

    function весть(содержимое, беда) {
      окноОтвета.innerHTML =
        `<div class="рч-весть${беда ? ' беда' : ''}">${содержимое}</div>`;
    }
    function убратьВесть() { окноОтвета.innerHTML = ''; }

    // ---- Голоса ------------------------------------------------------------------------------
    // getVoices() при первом вызове почти всегда пуст: список приходит позже событием.
    // Поэтому спрашиваем и по событию, и несколько раз по таймеру -- на части браузеров
    // событие не приходит вовсе.

    // Пометка «устройства / сетевой» -- не украшение: сетевой голос играет внутри вкладки и
    // потому записывается, а голос системы часто идёт мимо неё. При неудачной записи мы
    // ссылаемся ровно на эту пометку.
    function подписьГолоса(г) {
      return `${г.name} (${г.lang}) — ${г.localService ? с.local : с.network}`;
    }

    function собратьГолоса() {
      const список = синтез ? синтез.getVoices() : [];
      if (!список.length) return false;
      // Порядок: сначала язык страницы, а внутри него -- СЕТЕВЫЕ ГОЛОСА ВПЕРЁД.
      // Сетевые (в Chrome это голоса Google) звучат заметно лучше системных и по-русски читают
      // без акцента. Раньше «Google русский» терялся среди двух сотен строк, и человек его
      // просто не находил. Они же надёжнее других записываются в файл: играют внутри вкладки.
      const свой = (г) => ((г.lang || '').toLowerCase().startsWith(язык) ? 0 : 1);
      const сетевой = (г) => (г.localService ? 1 : 0);
      голоса = список.slice().sort((а, б) => свой(а) - свой(б) || сетевой(а) - сетевой(б));
      const было = списокГолосов.value;
      const куски = голоса.map((г, и) => {
        const о = document.createElement('option');
        о.value = String(и);
        о.textContent = подписьГолоса(г);
        return о;
      });
      // Список приходит с задержкой. Если человек к этому времени смотрит встроенные голоса,
      // трогать поле нельзя: иначе в нём оказывается «Милена (ru-RU)», а считает совсем другой
      // голос -- номер-то берётся из другого списка.
      if (двигатель !== 'устройство') { видКнопок(); return true; }
      списокГолосов.replaceChildren(...куски);
      списокГолосов.disabled = false;
      if (было && голоса[Number(было)]) списокГолосов.value = было;
      // Голоса приходят позже отрисовки, и вид кнопок надо пересчитать ЗДЕСЬ. Без этого
      // «Воспроизвести» остаётся заблокированной навсегда: при первом расчёте голосов ещё нет.
      видКнопок();
      return true;
    }

    function ждатьГолоса() {
      if (собратьГолоса()) return;
      let попыток = 0;
      const часы = setInterval(() => {
        if (собратьГолоса() || ++попыток > 20) {
          clearInterval(часы);
          if (!голоса.length) списокГолосов.replaceChildren(new Option(с.noVoices, ''));
        }
      }, 250);
      if (синтез) синтез.addEventListener('voiceschanged', () => { собратьГолоса(); });
    }

    // У встроенного голоса подпись говорит и о местности, и о качестве, и о весе: человек выбирает
    // не только звучание, но и сколько ему качать.
    function заполнитьСвои() {
      const было = списокГолосов.value;
      списокГолосов.replaceChildren(...своиГолоса.map((г, и) => {
        const о = document.createElement('option');
        о.value = String(и);
        о.textContent = `${г.яз} · ${г.имя} (${г.м}) — ${г.мб} ${с.mb}`;
        return о;
      }));
      списокГолосов.disabled = !своиГолоса.length;
      if (было && своиГолоса[Number(было)]) списокГолосов.value = было;
      видКнопок();
      показатьПроГолос();
    }

    const выбранныйГолос = () => (true
      ? своиГолоса[Number(списокГолосов.value)] || null
      : голоса[Number(списокГолосов.value)] || null);

    // ---- Резка текста ------------------------------------------------------------------------
    // Chrome обрывает речь примерно на пятнадцатой секунде. Кусок считаем не в знаках вообще,
    // а в знаках ПРИ ЭТОЙ СКОРОСТИ: на скорости 0.5 те же 150 знаков звучат вдвое дольше.

    function накуски(текст, скорость) {
      const длина = Math.max(60, Math.round(150 * Math.min(1, скорость)));
      const слова = (текст.replace(/\r/g, '').match(/\S+\s*/g)) || [];
      const куски = [];
      let текущий = '';
      for (const слово of слова) {
        if (текущий && текущий.length + слово.length > длина) { куски.push(текущий); текущий = ''; }
        текущий += слово;
        // Конец предложения -- лучшее место для разрыва, но только если кусок уже не крошечный:
        // иначе «Да. Нет.» разъедется на отдельные вздохи с паузами между ними.
        if (/[.!?…]["»)\]]?\s+$/.test(текущий) && текущий.trim().length > 40) {
          куски.push(текущий); текущий = '';
        }
      }
      if (текущий.trim()) куски.push(текущий);
      return куски.map((к) => к.trim()).filter(Boolean);
    }

    // ---- Чтение ------------------------------------------------------------------------------

    const скорость = () => Number($('рч-скорость').value);
    const тон = () => Number($('рч-тон').value);

    function показатьКусок(и) {
      if (и < 0 || !очередь[и]) {
        строкаЧитается.textContent = с.idle;
        строкаЧитается.classList.remove('идёт');
        return;
      }
      строкаЧитается.classList.add('идёт');
      строкаЧитается.textContent = `${с.reading} ${и + 1}/${очередь.length}: ${очередь[и]}`;
      полосаИ.style.width = `${Math.round(((и + 1) / очередь.length) * 100)}%`;
    }

    // Ширина кнопки пуска. Надпись на ней меняется («Воспроизвести» -- «Пауза» --
    // «Продолжить»), и без запаса кнопка на каждом нажатии прыгает, а с ней и весь ряд.
    // Меряем ВСЕ три надписи и держим место под самую длинную. Пересчитываем после загрузки
    // шрифта и при смене размера окна: до готовности шрифта ширина получается чужая.
    function держатьШиринуПуска() {
      const вид = getComputedStyle(кнИграть);
      const проба = document.createElement("span");
      проба.style.cssText = "position:absolute;visibility:hidden;white-space:nowrap;left:-9999px";
      проба.style.font = вид.font;
      проба.style.letterSpacing = вид.letterSpacing;
      корень.appendChild(проба);
      let макс = 0;
      for (const надпись of [с.play, с.pause, с.resume]) {
        проба.textContent = надпись;
        макс = Math.max(макс, проба.getBoundingClientRect().width);
      }
      проба.remove();
      const бока = parseFloat(вид.paddingLeft) + parseFloat(вид.paddingRight)
        + parseFloat(вид.borderLeftWidth) + parseFloat(вид.borderRightWidth);
      кнИграть.style.minWidth = Math.ceil(макс + бока) + "px";
    }

    function видКнопок() {
      const пишем = состояние === 'пишет';
      кнИграть.textContent = состояние === 'читает' ? с.pause
        : (состояние === 'пауза' ? с.resume : с.play);
      // Кнопку не глушим из-за пустого списка голосов: на части систем (и на Android
      // особенно) getVoices() возвращает пустоту, а speak() говорит голосом по умолчанию.
      кнИграть.disabled = пишем;
      кнСтоп.disabled = состояние === 'стоп';
      кнСкачать.disabled = пишем;
      списокГолосов.disabled = пишем || !своиГолоса.length;
      // Не hidden: исчезающая полоса подпрыгивала бы макетом на каждом пуске чтения.
      полоса.classList.toggle('идёт', состояние !== 'стоп');
    }

    function произнести(и) {
      if (отменено) return;
      if (и >= очередь.length) { закончили(); return; }
      ноль = и;
      показатьКусок(и);
      const у = new SpeechSynthesisUtterance(очередь[и]);
      const г = выбранныйГолос();
      if (г) { у.voice = г; у.lang = г.lang; }
      у.rate = скорость();
      у.pitch = тон();
      у.volume = 1;
      у.onend = () => { if (!отменено) произнести(и + 1); };
      у.onerror = (е) => {
        // «interrupted» и «canceled» -- наш же cancel(), это не беда.
        if (отменено || е.error === 'interrupted' || е.error === 'canceled') return;
        сказать(String(е.error || 'error'));
        закончили();
      };
      текущее = у;
      синтез.speak(у);
    }

    function закончили() {
      состояние = 'стоп';
      текущее = null;
      показатьКусок(-1);
      полосаИ.style.width = '0%';
      видКнопок();
      if (приЗавершении) { const ф = приЗавершении; приЗавершении = null; ф(); }
    }

    // Один и тот же текст тем же голосом не пересчитываем: синтез не мгновенный, а человек
    // жмёт «Воспроизвести» по нескольку раз подряд.
    function ключЗвука() {
      const г = выбранныйГолос();
      return [ввод.value.trim(), г && г.к, г && г.г, скорость()].join('|');
    }

    async function свойЗвук() {
      const ключ = ключЗвука();
      if (готовыйЗвук && готовыйЗвук.ключ === ключ) return готовыйЗвук.blob;
      const г = выбранныйГолос();
      if (!г) throw new Error(с.noVoices);
      const ответ = await спросить({
        тип: 'синтез', текст: ввод.value.trim(), голос: г.к, номер: г.г, скорость: скорость(),
      });
      const blob = new Blob([ответ.байты], { type: 'audio/wav' });
      готовыйЗвук = { ключ, blob };
      return blob;
    }

    // Заводим проигрыватель, пока жест ещё «горячий». Дальше можно ждать сколько угодно:
    // разбуженному элементу браузер уже не откажет.
    function разбудитьПлеер() {
      if (!плеер) {
        плеер = new Audio();
        плеер.addEventListener('ended', () => { if (плеерРазбужен && плеер.dataset.свой === '1') закончили(); });
      }
      if (плеерРазбужен) return;
      плеер.dataset.свой = '0';
      плеер.src = ТИШИНА;
      const п = плеер.play();
      if (п && п.catch) п.catch(() => {});
      плеерРазбужен = true;
    }

    async function своёЧтение() {
      if (!ввод.value.trim()) { сказать(с.empty); return; }
      состояние = 'читает';
      видКнопок();
      try {
        const blob = await свойЗвук();
        if (состояние !== 'читает') return;   // успели нажать «Стоп»
        разбудитьПлеер();
        if (плеер.src.startsWith('blob:')) URL.revokeObjectURL(плеер.src);
        плеер.dataset.свой = '1';
        плеер.src = URL.createObjectURL(blob);
        строкаЧитается.classList.add('идёт');
        строкаЧитается.textContent = `${с.reading}: ${ввод.value.trim().slice(0, 120)}`;
        полосаИ.style.width = '100%';
        await плеер.play();
      } catch (ошибка) {
        весть(`${с.piperFail}: ${String(ошибка.message || ошибка)}`, true);
        закончили();
      }
    }

    function начать(сНуля) {
      const текст = ввод.value.trim();
      if (!текст) { сказать(с.empty); return false; }
      отменено = true;
      синтез.cancel();
      отменено = false;
      очередь = накуски(текст, скорость());
      $('рч-кусков').textContent = String(очередь.length);
      if (!очередь.length) { сказать(с.empty); return false; }
      состояние = состояние === 'пишет' ? 'пишет' : 'читает';
      видКнопок();
      // Chrome глотает speak(), вызванный сразу после cancel(): даём ему кадр на уборку.
      setTimeout(() => произнести(сНуля ? 0 : ноль), 60);
      return true;
    }

    function остановить() {
      if (плеер) { плеер.pause(); плеер.currentTime = 0; }
      отменено = true;
      if (синтез) синтез.cancel();
      ноль = 0;
      закончили();
      // Флаг снимаем следующим кадром, иначе onerror от cancel() успеет пройти как беда.
      setTimeout(() => { отменено = false; }, 50);
    }

    // ---- Кнопки ------------------------------------------------------------------------------

    кнИграть.addEventListener('click', () => {
      убратьВесть();
      {
        if (состояние === 'читает' && плеер && !плеер.paused) {
          плеер.pause(); состояние = 'пауза'; видКнопок(); return;
        }
        if (состояние === 'пауза' && плеер) {
          плеер.play(); состояние = 'читает'; видКнопок(); return;
        }
        разбудитьПлеер();   // строго внутри жеста, до любого ожидания
        своёЧтение();
        return;
      }
      if (состояние === 'читает') {
        синтез.pause();
        состояние = 'пауза';
        видКнопок();
        return;
      }
      if (состояние === 'пауза') {
        синтез.resume();
        состояние = 'читает';
        видКнопок();
        return;
      }
      начать(true);
    });

    кнСтоп.addEventListener('click', () => { убратьВесть(); остановить(); });

    function переключить(на) {
      if (двигатель === на) return;
      остановить();
      двигатель = на;
      готовыйЗвук = null;
      скачанные = [];
      for (const к of Object.keys(ПОТОКИ)) {
        const кн = $('рч-м-' + к);
        if (кн) кн.classList.toggle('выбран', к === на);
      }
      // Тона нет ни у одной из трёх моделей -- ручку не показываем, а не делаем вид,
      // что она работает.
      $('рч-ручка-тон').hidden = true;
      кнСкачать.classList.remove('служебная');
      списокГолосов.value = '';
      поднятьРаботника();
      заполнитьСвои();
      убратьВесть();
      работник.postMessage({ тип: 'что-скачано' });
      показатьПроГолос();
    }
    for (const к of Object.keys(ПОТОКИ)) {
      const кн = $('рч-м-' + к);
      if (кн) кн.addEventListener('click', () => переключить(к));
    }
    // Смена голоса или скорости на ходу должна ПЕРЕЗАПУСТИТЬ чтение тем, что выбрали.
    // Раньше здесь только чистился кеш: старый голос продолжал читать, а нажатие
    // «Воспроизвести» ставило его на паузу вместо переключения.
    function перезапустить() {
      готовыйЗвук = null;
      if (состояние !== 'читает' && состояние !== 'пауза') return;
      остановить(); своёЧтение();
    }

    списокГолосов.addEventListener('change', () => {
      готовыйЗвук = null;
      показатьПроГолос();
      перезапустить();
    });

    for (const кн of корень.querySelectorAll('.рч-фмт')) {
      кн.addEventListener('click', () => {
        формат = кн.dataset.ф;
        for (const д of корень.querySelectorAll('.рч-фмт')) д.classList.toggle('выбран', д === кн);
      });
    }

    // Скорость и тон применяются сразу: на ходу перезапускаем с текущего куска, иначе человек
    // двигает ползунок и не слышит разницы до конца абзаца.
    for (const [ид, знач, вид] of [['рч-скорость', 'рч-скорость-знач', (з) => `${з.toFixed(2)}x`],
                                   ['рч-тон', 'рч-тон-знач', (з) => з.toFixed(2)]]) {
      const п = $(ид);
      const покрасить = () => {
        const доля = ((Number(п.value) - Number(п.min)) / (Number(п.max) - Number(п.min))) * 100;
        п.style.setProperty('--доля', `${доля}%`);
        $(знач).textContent = вид(Number(п.value));
      };
      п.addEventListener('input', покрасить);
      // Через общий перезапуск: у встроенного голоса своё чтение, и начать() -- которое зовёт
      // синтезатор системы -- запускало бы голос устройства поверх.
      п.addEventListener('change', перезапустить);
      покрасить();
    }

    ввод.addEventListener('input', () => {
      const длина = ввод.value.length;
      $('рч-знаков').textContent = String(длина);
      $('рч-знаков-гнездо').classList.toggle('перебор', длина >= ПРЕДЕЛ);
      $('рч-кусков').textContent = String(накуски(ввод.value.trim(), скорость()).length);
    });

    // ---- Запись в файл -----------------------------------------------------------------------

    function подсказкаЗахвата() {
      const а = среда.windows ? с.askWinA : с.askTabA;
      const б = среда.windows ? с.askWinB : с.askTabB;
      весть(`<b>${с.askTitle}</b><ol><li>${а}</li><li>${б}</li></ol><p style="margin:8px 0 0">${с.askTail}</p>`);
    }

    function почемуНельзя() {
      if (среда.iOS) return с.noCaptureIOS;
      if (среда.android) return с.noCaptureAndroid;
      if (среда.safari) return с.noCaptureSafari;
      return с.noCaptureSafari;
    }

    // Тишину по краям срезаем: между разрешением и первым словом всегда есть паузa, и без
    // обрезки файл начинается с секунды пустоты.
    function обрезать(буфер, ак) {
      const порог = Math.max(0.004, peakOf(буфер) * 0.02);
      const данные = буфер.getChannelData(0);
      let начало = 0;
      let конец = буфер.length - 1;
      while (начало < конец && Math.abs(данные[начало]) < порог) начало++;
      while (конец > начало && Math.abs(данные[конец]) < порог) конец--;
      const запас = Math.round(буфер.sampleRate * 0.08);
      начало = Math.max(0, начало - запас);
      конец = Math.min(буфер.length - 1, конец + запас);
      const длина = Math.max(1, конец - начало + 1);
      // Речь -- моно: два одинаковых канала удваивают вес файла ни за чем.
      const готовый = ак.createBuffer(1, длина, буфер.sampleRate);
      const цель = готовый.getChannelData(0);
      const каналов = буфер.numberOfChannels;
      for (let и = 0; и < длина; и++) {
        let сумма = 0;
        for (let к = 0; к < каналов; к++) сумма += буфер.getChannelData(к)[начало + и];
        цель[и] = сумма / каналов;
      }
      return готовый;
    }

    // Встроенным голосом файл собирается сразу: отсчёты рождаются здесь, разрешения не нужны,
    // диалога нет, и на iPhone это тоже работает.
    async function своёСкачивание() {
      состояние = 'пишет';
      видКнопок();
      try {
        const blob = await свойЗвук();
        показатьРаботу(с.encoding, 100);
        let файл;
        if (формат === 'wav') {
          // Из синтезатора уже выходит готовый WAV с верным заголовком. Пересобирать его
          // незачем: любой пересчёт здесь -- только потеря времени и качества.
          файл = blob;
        } else {
          // Считаем на ЧАСТОТЕ САМОГО ЗВУКА (у Piper это 22050). Обычный AudioContext
          // работает на 48000 и молча пересчитывает вверх -- файл выходил вдвое тяжелее,
          // а лучше от этого не звучал.
          const байты = await blob.arrayBuffer();
          const частота = new DataView(байты).getUint32(24, true) || 22050;
          const ак = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: частота });
          const буфер = await ак.decodeAudioData(байты);
          файл = await encodeMP3(буфер, 128);
          await ак.close();
        }
        const имя = (ввод.value.trim().slice(0, 32).replace(/[^\p{L}\p{N}]+/gu, '-')
          .replace(/^-|-$/g, '') || 'speech');
        downloadBlob(файл, `${имя}.${формат}`);
        сказать(с.done);
      } catch (ошибка) {
        весть(`${с.piperFail}: ${String(ошибка.message || ошибка)}`, true);
      }
      состояние = 'стоп';
      видКнопок();
      показатьКусок(-1);
    }

    async function записать() {
      const текст = ввод.value.trim();
      if (!текст) { сказать(с.empty); return; }
      if (состояние === 'пишет') { сказать(с.busy); return; }
      // Системных голосов больше нет: файл всегда собирает модель, и запись экрана не нужна.
      await своёСкачивание();
      return;

      if (!среда.умеет) {
        весть(`<b>${с.noCapture}.</b> ${почемуНельзя()}`, true);
        return;
      }

      подсказкаЗахвата();
      let поток = null;
      try {
        // Видео нам не нужно, но Chrome без него не отдаёт окно выбора вовсе.
        поток = await navigator.mediaDevices.getDisplayMedia({
          video: true,
          audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false },
        });
      } catch (ошибка) {
        весть(с.denied, true);
        return;
      }

      const звуковые = поток.getAudioTracks();
      if (!звуковые.length) {
        поток.getTracks().forEach((д) => д.stop());
        весть(с.noTrack, true);
        return;
      }
      // Картинку сразу гасим: писать её незачем, а горящий значок «идёт съёмка экрана»
      // пугает человека сильнее, чем нужно.
      поток.getVideoTracks().forEach((д) => д.stop());

      const тихийПоток = new MediaStream(звуковые);
      let писатель;
      try {
        писатель = new MediaRecorder(тихийПоток);
      } catch (ошибка) {
        поток.getTracks().forEach((д) => д.stop());
        весть(с.noTrack, true);
        return;
      }

      const куски = [];
      писатель.ondataavailable = (е) => { if (е.data && е.data.size) куски.push(е.data); };
      const записано = new Promise((готово) => { писатель.onstop = готово; });

      убратьВесть();
      состояние = 'пишет';
      видКнопок();
      сказать(с.recording);
      писатель.start();

      // Ждём, пока очередь дочитает до конца, и только тогда останавливаем запись.
      await new Promise((дочитал) => {
        приЗавершении = дочитал;
        if (!начать(true)) { приЗавершении = null; дочитал(); }
      });
      // Хвост: последний звук ещё доигрывает в момент onend.
      await new Promise((р) => setTimeout(р, 450));
      if (писатель.state !== 'inactive') писатель.stop();
      await записано;
      звуковые.forEach((д) => д.stop());

      состояние = 'стоп';
      видКнопок();
      сказать(с.encoding);

      const кусок = new Blob(куски, { type: писатель.mimeType || 'audio/webm' });
      const ак = new (window.AudioContext || window.webkitAudioContext)();
      let буфер = null;
      try {
        буфер = await ак.decodeAudioData(await кусок.arrayBuffer());
      } catch (ошибка) {
        буфер = null;
      }

      // ГЛАВНАЯ ПРОВЕРКА. Тихий файл пользователю не отдаём ни при каких условиях.
      if (!буфер || буфер.length < 1000 || peakOf(буфер) < 0.01) {
        await ак.close();
        весть(`<b>${с.silentTitle}.</b> ${с.silentWhy}<ul><li>${с.silentA}</li><li>${с.silentB}</li><li>${с.silentC}</li></ul>`, true);
        return;
      }

      const готовый = обрезать(буфер, ак);
      const файл = формат === 'wav' ? encodeWAV(готовый) : await encodeMP3(готовый, 128);
      await ак.close();
      const имя = (ввод.value.trim().slice(0, 32).replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-|-$/g, '') || 'speech');
      downloadBlob(файл, `${имя}.${формат}`);
      сказать(с.done);
    }

    кнСкачать.addEventListener('click', () => { убратьВесть(); записать(); });
    if (!среда.умеет) кнСкачать.classList.add('служебная');

    // ---- Запуск ------------------------------------------------------------------------------

    // Голоса устройства ищем сразу, хотя показываем позже: список приходит с задержкой, и
    // ко второй кнопке он должен быть уже готов.
    if (синтез) ждатьГолоса();
    заполнитьСвои();
    видКнопок();
    держатьШиринуПуска();
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(держатьШиринуПуска);
    window.addEventListener("resize", держатьШиринуПуска);
    // Работника поднимаем не сразу: на странице, куда пришли просто послушать, лишние
    // триста килобайт ни к чему. Заводим в простое, чтобы к первому нажатию он был готов
    // и уже знал, какие голоса лежат на устройстве.
    if (typeof requestIdleCallback === 'function') requestIdleCallback(() => поднятьРаботника(), { timeout: 4000 });
    else setTimeout(() => поднятьРаботника(), 1500);
    // Речь переживает переход по страницам сайта: без этого голос продолжает читать вслух
    // на следующей странице, и остановить его нечем.
    window.addEventListener('pagehide', () => { try { синтез.cancel(); } catch (е) {} });

    window.__рчСостояние = () => ({
      голосов: голоса.length,
      знаков: $('рч-знаков').textContent,
      кусков: $('рч-кусков').textContent,
      состояние,
      формат,
      скорость: $('рч-скорость-знач').textContent,
      тон: $('рч-тон-знач').textContent,
      играть: кнИграть.textContent,
      стопДоступен: !кнСтоп.disabled,
      захват: среда.умеет,
      двигатель,
      своихГолосов: своиГолоса.length,
      скачано: скачанные.length,
      весть: $('рч-голос-весть').textContent,
      тонВиден: !$('рч-ручка-тон').hidden,
