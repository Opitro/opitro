const с = СЛОВА[locale] || СЛОВА.ru;

// Значки вместо надписей: «Воспроизвести» и «Стоп» в четырёх языках -- четыре разные длины,
// и ряд кнопок от этого разъезжается. Треугольник и квадрат понятны без перевода.
const ЗН_ИГРАТЬ = '<svg class="зн-играть" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"/></svg>'
  + '<svg class="зн-пауза" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5.5v13M15 5.5v13"/></svg>';
const ЗН_СТОП = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6.5" y="6.5" width="11" height="11" rx="1.5"/></svg>';
// В СТРОКЕ СПИСКА -- только имя и вес. Описание с ограничением стоит ПОД списком: в закрытом
// списке длинная фраза не помещается ни на одном телефоне, обрезка у нового вида списков
// (appearance: base-select) не срабатывает, и имя модели уезжало под стрелку. Под списком
// строка переносится и читается целиком.
// Под списком -- ТОЛЬКО ФАКТ: где эта модель работает и что умеет. Оценок «лёгкая» и
// «тяжёлая» здесь нет нарочно (владелец 11.09.2026): вес написан в строке списка, и что
// считать лёгким, человек решает сам -- у кого-то безлимит, у кого-то мобильный интернет.
const ПРО_МОДЕЛЬ = { piper: с.mPiper, kokoro: с.mKokoro, supertonic: с.mSupertonic };

// Адреса лицензий -- НАСТОЯЩИЕ, все шесть проверены запросом 11.09.2026 (код 200).
// Название лицензии без ссылки -- это просто слово: проверить его человек не может.
const ЛИЦЕНЗИИ = {
  'MIT': 'https://opensource.org/license/mit',
  'Apache 2.0': 'https://www.apache.org/licenses/LICENSE-2.0',
  'OpenRAIL-M': 'https://www.licenses.ai/ai-pubs-open-railm-vz1',
};
const ПРО_СПРАВКУ = { piper: с.rPiper, kokoro: с.rKokoro, supertonic: с.rSupertonic };
const СКОРОСТЬ_МОДЕЛИ = { piper: с.sPiper, kokoro: с.sKokoro, supertonic: с.sSupertonic };

const ЗН_КРЕСТ ='<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg>';
const ЗН_ВНИЗ = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11"/>'
  + '<path d="M7.5 10.5L12 15l4.5-4.5"/><path d="M5 19h14"/></svg>';
---

<style is:inline set:html={css}></style>

<div class="рч" data-words={JSON.stringify(с)} data-locale={locale} data-limit={ПРЕДЕЛ} data-models={JSON.stringify(ПРО_МОДЕЛЬ)}>
  <!-- Два выбора в одну строку, надпись НАД полем: подпись сбоку съедала ширину списка,
       и длинное имя голоса в него не помещалось. На узком экране полосы встают друг под друга. -->
  <div class="рч-верх">
    <label class="рч-стойка">
      <span class="рч-шапка">{с.model}</span>
      <span class="рч-гнездо">
      <select class="рч-список" id="рч-модель">
        {МОДЕЛИ.map((м) => (
          <option value={м.ключ} selected={м.ключ === 'piper'}>
            {м.имя} · {м.весМин ? `${м.весМин}–${м.вес}` : м.вес} МБ
          </option>
        ))}
      </select>
      <span class="рч-стрелка" aria-hidden="true"></span>
      </span>
      <span class="рч-под" id="рч-м-где">{ПРО_МОДЕЛЬ.piper}</span>
    </label>
    <label class="рч-стойка">
      <span class="рч-шапка">{с.voice}</span>
      <span class="рч-гнездо">
      <select class="рч-список" id="рч-голос" disabled>
        <option>{с.loadingVoices}</option>
      </select>
      <span class="рч-стрелка" aria-hidden="true"></span>
      </span>
      <span class="рч-под" id="рч-голос-весть"></span>
    </label>
  </div>

  <div class="рч-поле">
    <textarea class="рч-ввод" id="рч-ввод" placeholder={с.place} maxlength={ПРЕДЕЛ} spellcheck="false"></textarea>
  </div>

  <!-- Ход работы стоит ЗДЕСЬ, между счётчиками, а не отдельной строкой: отдельная строка
       занимала место постоянно, а говорила что-то одну секунду из ста. Кружок крутится всё
       время работы -- без него замерший процент читается как «зависло». -->
  <div class="рч-счётчики">
    <span class="рч-счёт">
      <span id="рч-знаков-гнездо"><span class="рч-знаков-слово">{с.chars}: </span><b id="рч-знаков">0</b> / {ПРЕДЕЛ}</span>
    </span>
    <span class="рч-ход" id="рч-ход"><i class="рч-круг" aria-hidden="true"></i><span id="рч-ход-текст"></span><b id="рч-ход-число"></b></span>
    <span class="рч-сказ" id="рч-сказ"></span>
  </div>

  <!-- Скорость стоит вплотную к пуску нарочно: её меняют и жмут «Сгенерировать» ещё раз,
       чтобы сравнить на слух. Держать её наверху значило бы гонять человека через всю страницу. -->
  <div class="рч-пуск-ряд">
    <span class="рч-ручка">
      <span class="рч-подпись">{с.rate}</span>
      <input type="range" class="рч-ползунок" id="рч-скорость" min="0.5" max="2" step="0.05" value="1" />
      <span class="рч-значение" id="рч-скорость-знач">1.00×</span>
    </span>
    <button type="button" class="рч-сгенерировать" id="рч-генерировать">{с.gen}</button>
  </div>

  <!-- Новая дорожка встаёт СВЕРХУ: только что сделанное -- главное, за ним не надо листать. -->
  <div class="рч-треки" id="рч-треки"></div>
  <div class="рч-ответ" id="рч-ответ"></div>

  <!-- СПРАВКА О МОДЕЛЯХ. Раньше это был один абзац в общем списке заметок, и выбирать по нему
       было нельзя: три модели слипались в сплошной текст. Теперь три карточки -- имя, вес,
       что умеет, скорость и лицензия ссылкой, которую можно открыть и прочитать. -->
  <div class="рч-справка">
    <h2 class="рч-спр-шапка">{с.refTitle}</h2>
    <p class="рч-спр-лид">{с.mNote}</p>
    <div class="рч-спр-ряд">
      {МОДЕЛИ.map((м) => (
        <div class="рч-спр-карта">
          <div class="рч-спр-верх">
            <a class="рч-спр-имя" href={`https://huggingface.co/${м.хранилище}`}
               target="_blank" rel="noopener nofollow" title={с.srcHint}>{м.имя}</a>
            <span class="рч-спр-вес">
              {м.весМин ? `${м.весМин}–${м.вес}` : м.вес} {с.mb}{м.ключ === 'piper' ? ` ${с.perVoice}` : ''}
            </span>
          </div>
          <p class="рч-спр-что">{ПРО_СПРАВКУ[м.ключ]}</p>
          <div class="рч-спр-низ">
            <span class="рч-спр-скорость">{СКОРОСТЬ_МОДЕЛИ[м.ключ]}</span>
            <a class="рч-спр-лиц" href={ЛИЦЕНЗИИ[м.лицензия]}
               target="_blank" rel="noopener nofollow">{с.license}: {м.лицензия}</a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="рч-заметки">
    <div class="рч-заметка" set:html={с.n0}></div>
    <div class="рч-заметка" set:html={с.n2}></div>
    <div class="рч-заметка" set:html={с.n3}></div>
    <div class="рч-заметка" set:html={с.n4}></div>
    <div class="рч-заметка" set:html={с.n5}></div>
    <div class="рч-заметка">{с.n6}</div>
  </div>
</div>

<!-- Образец готовой дорожки. Дорожек бывает несколько -- по одной на каждое нажатие
     «Сгенерировать», -- поэтому разметка лежит здесь, а не повторяется в теле страницы. -->
<template id="рч-образец">
  <div class="рч-трек">
    <div class="рч-трек-ряд">
      <button type="button" class="рч-знк рч-пуск" data-роль="играть" aria-label={с.play} title={с.play} set:html={ЗН_ИГРАТЬ}></button>
      <button type="button" class="рч-знк" data-роль="стоп" aria-label={с.stop} title={с.stop} set:html={ЗН_СТОП}></button>
      <div class="рч-бег">
        <div class="рч-полоса" role="slider" tabindex="0" aria-label={с.seek}
             aria-valuemin="0" aria-valuemax="0" aria-valuenow="0" aria-valuetext="0:00">
          <i></i>
          <span class="рч-черта"></span>
          <span class="рч-точка"></span>
        </div>
        <span class="рч-часы"><b>0:00</b> / <span>0:00</span></span>
      </div>
      <button type="button" class="рч-знк рч-убрать" data-роль="убрать" aria-label={с.remove} title={с.remove} set:html={ЗН_КРЕСТ}></button>
    </div>
    <div class="рч-трек-низ">
      <span class="рч-трек-что"></span>
      <span class="рч-трек-файлы">
        <button type="button" class="рч-скачать" data-роль="mp3" title={с.download}><span set:html={ЗН_ВНИЗ}></span>MP3</button>
        <button type="button" class="рч-скачать" data-роль="wav" title={с.download}><span set:html={ЗН_ВНИЗ}></span>WAV</button>
      </span>
    </div>
  </div>
</template>

<script>
  import { encodeMP3, downloadBlob } from '../lib/web-audio-engine.js';
  import { ГОЛОСА } from '../lib/piper-voices.js';
  import { этоПК } from '../lib/pc-only.js';

  // Считаем ЗДЕСЬ, а не в потоке: этоПК() смотрит matchMedia, screen и maxTouchPoints,
  // а в потоке их нет вовсе -- проверка там ответила бы «компьютер» даже на iPhone.
  const ЭТО_ПК = этоПК();

  const корень = document.querySelector('.рч');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const язык = корень.dataset.locale || 'ru';
    const ПРЕДЕЛ = Number(корень.dataset.limit) || 5000;
    const ПРО_МОДЕЛЬ = JSON.parse(корень.dataset.models || '{}');
    const $ = (и) => document.getElementById(и);

    const ввод = $('рч-ввод');
    const списокГолосов = $('рч-голос');
    const кнГенерировать = $('рч-генерировать');
    const ходГнездо = $('рч-ход');
    const ходТекст = $('рч-ход-текст');
    const ходЧисло = $('рч-ход-число');
    const окноОтвета = $('рч-ответ');
    const гнездоТреков = $('рч-треки');
    const образец = $('рч-образец');

    let двигатель = 'piper';
    let работник = null;
    let скачанные = [];
    // Голоса КАЖДОЙ модели в её собственном виде. Записи приведены к одному виду
    // {к, г, я, яз, м, мб, имя}, чтобы остальная страница не разбиралась, чьи это голоса.
    const ГОЛОСА_KOKORO = [
      ['af_heart','Heart'],['af_bella','Bella'],['af_nicole','Nicole'],['af_sarah','Sarah'],
      ['af_sky','Sky'],['af_alloy','Alloy'],['af_aoede','Aoede'],['af_jessica','Jessica'],
      ['af_kore','Kore'],['af_nova','Nova'],['af_river','River'],
      ['am_adam','Adam'],['am_echo','Echo'],['am_eric','Eric'],['am_fenrir','Fenrir'],
      ['am_liam','Liam'],['am_michael','Michael'],['am_onyx','Onyx'],['am_puck','Puck'],
      ['am_santa','Santa'],
      ['bf_emma','Emma'],['bf_isabella','Isabella'],['bf_alice','Alice'],['bf_lily','Lily'],
      ['bm_george','George'],['bm_lewis','Lewis'],['bm_daniel','Daniel'],['bm_fable','Fable'],
    ].map(([к, имя]) => ({
      к, г: 0, я: 'en', яз: 'English', м: к[0] === 'b' ? 'GB' : 'US', мб: 93, имя,
    }));

    // У Supertonic голоса безымянные: пять женских и пять мужских. Язык он берёт из ТЕКСТА,
    // а не из голоса, поэтому у записи стоит язык страницы -- его и шлём в поток.
    // Имена вместо F1 и M3: «M3» человеку ничего не говорит, он ткнёт наугад.
    const ГОЛОСА_SUPERTONIC = [
      ['F1', 'Alma'], ['F2', 'Nora'], ['F3', 'Vera'], ['F4', 'Lina'], ['F5', 'Rita'],
      ['M1', 'Adam'], ['M2', 'Leon'], ['M3', 'Marc'], ['M4', 'Timo'], ['M5', 'Nils'],
    ].map(([к, имя]) => ({ к, г: 0, я: язык, яз: '', м: '', мб: 380,
      имя: `${имя} · ${к[0] === 'F' ? с.vFemale : с.vMale}` }));

    const голосаМодели = (м) => (м === 'kokoro' ? ГОЛОСА_KOKORO
      : м === 'supertonic' ? ГОЛОСА_SUPERTONIC : ГОЛОСА);

    let своиГолоса = ГОЛОСА.slice().sort((а, б) => {
      const свой = (г) => (г.я === язык ? 0 : 1);
      return свой(а) - свой(б) || а.яз.localeCompare(б.яз) || а.мб - б.мб || а.имя.localeCompare(б.имя);
    });

    let готовыйЗвук = null;    // {ключ, blob} -- одно и то же дважды не считаем
    let ждущие = [];
    let состояние = 'стоп';    // стоп | считает | играет | пауза

    // ---- Встроенный голос: связь с работником --------------------------------------------------
    // Синтез идёт в стороне от страницы: на своём потоке длинный текст заморозил бы её на
    // десятки секунд, и Chrome предложил бы её закрыть.
    //
    // АДРЕС ПОТОКА ЗАПИСАН БУКВАЛЬНО, И ЭТО ОБЯЗАТЕЛЬНО. Сборщик находит файлы потоков,
    // только читая new URL('...', import.meta.url) как есть. Стоило собрать адрес из
    // переменной -- и он просто не положил файлы в сборку: страница просила их по адресу,
    // которого нет, поток не поднимался, и модель «не загружалась».
    const ПОТОКИ = {
      piper: () => new Worker(new URL('../lib/tts-piper-worker.js', import.meta.url), { type: 'module' }),
      kokoro: () => new Worker(new URL('../lib/tts-kokoro-worker.js', import.meta.url), { type: 'module' }),
      supertonic: () => new Worker(new URL('../lib/tts-supertonic-worker.js', import.meta.url), { type: 'module' }),
    };
    const работники = new Map();

    function поднятьРаботника() {
      const ключ = двигатель;
      if (работники.has(ключ)) { работник = работники.get(ключ); return работник; }
      работник = (ПОТОКИ[ключ] || ПОТОКИ.piper)();
      работники.set(ключ, работник);
      работник.onmessage = (е) => {
        const д = е.data || {};
        if (д.список) { скачанные = д.список; показатьПроГолос(); }
        if (д.тип === 'ход') {
          // Этапов три: скачивание, подготовка и сам счёт. Первые два для человека -- одно
          // и то же «идёт загрузка», и подписывать подготовку словами «считаем речь» нельзя:
          // речь тогда ещё и не начинали.
          const считает = д.этап === 'синтез';
          // ПРОЦЕНТ ПОКАЗЫВАЕМ, КОГДА ОН НАСТОЯЩИЙ. На загрузке он считается по байтам,
          // на счёте у Piper -- по кускам текста. У Supertonic счёт идёт одним куском и
          // числа нет вовсе: там остаётся крутящийся кружок. Ноль на экране не держим --
          // замершее число читается как «зависло».
          if (считает && !(Number(д.доля) > 0)) {
            // Счёт начался, а числа нет -- ведём примерный ход по своему опыту.
            пуститьОжидание(ввод.value.trim().length);
            return;
          }
          остановитьОжидание();
          показатьРаботу(считает ? с.synth : с.dling, д.доля, Number(д.доля) > 0, д.мб);
          return;
        }
        const ждёт = ждущие.shift();
        if (!ждёт) return;
        if (д.тип === 'беда') ждёт.беда(new Error(д.текст));
        else ждёт.готово(д);
      };
      работник.onerror = () => {
        const ждёт = ждущие.shift();
        if (ждёт) ждёт.беда(new Error(с.piperFail));
      };
      работник.postMessage({ тип: 'что-скачано' });
      return работник;
    }

    function спросить(весть) {
      поднятьРаботника();
      return new Promise((готово, беда) => {
        ждущие.push({ готово, беда });
        работник.postMessage({ ...весть, пк: ЭТО_ПК });
      });
    }

    // Ход работы: крутящийся кружок и подпись между счётчиками.
    // ПРОЦЕНТ ПОКАЗЫВАЕМ ТОЛЬКО ТАМ, ГДЕ ОН НАСТОЯЩИЙ, -- на загрузке модели, где он считается
    // по байтам. На счёте речи его взять неоткуда: модель получает текст целиком и молчит до
    // конца, и число стояло бы на нуле всю минуту. Замерший процент пугает сильнее, чем его
    // отсутствие: владелец так и сказал -- «кажется, что зависло». Поэтому там только кружок.
    function показатьРаботу(текст, доля, сПроцентом, мб, примерно) {
      ходГнездо.classList.add('идёт');
      // Процент -- если он настоящий; иначе скачанные мегабайты; иначе одна подпись с кружком.
      // Знака «примерно» перед числом нет по решению владельца: он читается как оговорка,
      // а человеку нужен ход, а не сноска. Само число всё равно приблизительное -- об этом
      // говорит поведение: оно идёт ровно и останавливается на 97, пока файл не готов.
      // Число зелёное и стоит отдельным узлом: белым оно сливалось с подписью рядом,
      // а взгляд ищет именно его.
      ходТекст.textContent = текст;
      ходЧисло.textContent = сПроцентом ? `${Math.round(доля)}%`
        : (Number(мб) > 0.5 ? `${Math.round(Number(мб))} ${с.mb}` : '');
    }

    // ---- ПРИМЕРНЫЙ ХОД СЧЁТА -----------------------------------------------------------------
    // Supertonic получает текст целиком и молчит до конца: настоящего числа у нас нет. Минута
    // с одним крутящимся кружком ощущается точно так же, как зависший ноль, -- владелец сказал
    // это прямо. Поэтому показываем ПРИМЕРНЫЙ ход, и не выдуманный: страница запоминает, сколько
    // эта модель считала на ЭТОМ устройстве, и в следующий раз считает ожидание по своему же
    // опыту. Знак «≈» стоит перед числом, чтобы не выдавать догадку за измерение.
    //
    // Первое ожидание берётся из наших замеров (секунд на тысячу знаков при обычной скорости):
    // Supertonic считает быстрее реального времени, Kokoro вдвое медленнее, Piper посередине.
    // Piper: 11 секунд на тысячу знаков измерено на этой машине; телефон медленнее, поэтому
    // берём с запасом. Ошибиться лучше в сторону «дольше»: тогда полоса добегает раньше срока,
    // а не упирается в 97 и стоит.
    // Замерено: Supertonic на 980 знаках считал дольше минуты. Ошибаться надо в сторону
    // «дольше»: полоса, добежавшая раньше времени, оставляет ощущение «справилось быстрее,
    // чем обещали», а упёршаяся в потолок -- ощущение зависшего экрана.
    const ОЖИДАНИЕ_ПО_УМОЛЧАНИЮ = { piper: 15, kokoro: 190, supertonic: 95 };
    const КЛЮЧ_ОПЫТА = 'opitro:озвучка:скорость';

    function опыт() {
      try { return JSON.parse(localStorage.getItem(КЛЮЧ_ОПЫТА) || '{}'); } catch (ош) { return {}; }
    }
    // Запоминаем не голое время, а СЕКУНДЫ НА ТЫСЯЧУ ЗНАКОВ при обычной скорости речи:
    // на медленной речи тех же знаков звучит больше, и считать их дольше.
    function запомнитьОпыт(модель, знаков, секунд, скор) {
      if (!знаков || !(секунд > 0)) return;
      const о = опыт();
      const новое = (секунд / знаков) * 1000 * (скор || 1);
      // Среднее со сдвигом к свежему: устройство одно, но браузер мог освободить память.
      о[модель] = о[модель] ? о[модель] * 0.6 + новое * 0.4 : новое;
      try { localStorage.setItem(КЛЮЧ_ОПЫТА, JSON.stringify(о)); } catch (ош) {}
    }

    let часыОжидания = 0;
    function остановитьОжидание() { if (часыОжидания) clearInterval(часыОжидания); часыОжидания = 0; }
    function пуститьОжидание(знаков) {
      остановитьОжидание();
      const на1000 = опыт()[двигатель] || ОЖИДАНИЕ_ПО_УМОЛЧАНИЮ[двигатель] || 60;
      const всего = Math.max(2, (знаков / 1000) * на1000 / Math.max(0.5, скорость()));
      const старт = performance.now();
      const шаг = () => {
        const прошло = (performance.now() - старт) / 1000;
        // Кривая с ЗАМЕДЛЕНИЕМ, а не ровный ход. Ровный упирался в потолок и замирал: у
        // владельца на Supertonic число простояло на 97 полтора десятка секунд, и это снова
        // выглядело зависанием. Здесь шаг к концу становится всё мельче, но никогда не
        // обращается в ноль -- число ползёт, пока идёт счёт, и до ста не доходит никогда:
        // сотню ставит только готовый файл.
        const доля = 100 * (1 - Math.exp(-прошло / (всего * 0.6)));
        показатьРаботу(с.synth, Math.min(99, доля), true, 0, true);
      };
      шаг();
      часыОжидания = setInterval(шаг, 300);
    }
    function убратьРаботу() {
      остановитьОжидание();
      ходГнездо.classList.remove('идёт');
      ходТекст.textContent = '';
      ходЧисло.textContent = '';
    }

    // Строка под списком голосов: сколько весит голос и лежит ли он уже на устройстве.
    function показатьПроГолос() {
      const э = $('рч-голос-весть');
      const г = выбранныйГолос();
      if (!г) { э.textContent = ''; return; }
      // У Piper СВОЙ ФАЙЛ НА КАЖДЫЙ ГОЛОС -- сменил голос, качается заново. У Kokoro и
      // Supertonic файл один на все их голоса, и переключение не стоит ничего.
      // Раньше готовность искалась по ключу голоса всегда, а эти двое отвечают ключом
      // модели: строка твердила «загрузится при первом пуске» даже когда модель уже лежала
      // на устройстве. Человек по ней считал, что ему снова качать 380 мегабайт.
      const общий = двигатель !== 'piper';
      const есть = скачанные.includes(общий ? двигатель : г.к);
      // Коротко: вес и одно слово о том, лежит ли файл на устройстве. Длинная фраза здесь
      // занимала две строки на любом телефоне и держала высоту всего верхнего блока --
      // поле ввода из-за неё отъезжало вниз на ровном месте.
      э.textContent = общий
        ? `${с.model}: ${есть ? с.mReady : с.mNotReady}`
        : `${г.мб} ${с.mb} · ${есть ? с.ready : с.notReady}`;
      э.classList.toggle('готов', есть);
    }

    // ---- Мелочи ------------------------------------------------------------------------------

    function сказать(текст) {
      const э = $('рч-сказ');
      э.textContent = текст;
      э.classList.add('видно');
      clearTimeout(э._т);
      э._т = setTimeout(() => э.classList.remove('видно'), 2600);
    }

    function весть(содержимое, беда) {
      окноОтвета.innerHTML =
        `<div class="рч-весть${беда ? ' беда' : ''}">${содержимое}</div>`;
    }
    function убратьВесть() { окноОтвета.innerHTML = ''; }

    // Отказ модели приходит строкой от WebAssembly и на человеческий язык не похож:
    // «Aborted(OOM)», «memory access out of bounds», «Failed to fetch». Чаще всего это
    // телефон, которому не хватило памяти на тяжёлую модель. Молчать об этом нельзя --
    // человек решит, что сломан весь сайт, вместо того чтобы взять модель полегче.
    function почемуНеВышло(ошибка) {
      const т = String((ошибка && ошибка.message) || ошибка || '').toLowerCase();
      if (/memory|allocat|aborted|out of bounds|array buffer|buffer size/.test(т)) return с.failMem;
      if (/fetch|network|err_|load failed|failed to load|connection/.test(т)) return с.failNet;
      if (/webassembly|sharedarraybuffer|unsupported|not supported|is not a function/.test(т)) return с.failOld;
      return '';
    }

    // ---- Голоса ------------------------------------------------------------------------------
    // У встроенного голоса подпись говорит и о местности, и о весе: человек выбирает не только
    // звучание, но и сколько ему качать.
    function заполнитьСвои() {
      const было = списокГолосов.value;
      списокГолосов.replaceChildren(...своиГолоса.map((г, и) => {
        const о = document.createElement('option');
        о.value = String(и);
        // Вес пишем ТОЛЬКО у Piper: там каждый голос -- отдельный файл, и это честное число.
        // У Kokoro и Supertonic файл один на все голоса, и «380 МБ» у каждого читалось бы
        // как «за каждый». Их вес стоит в строке модели, где ему и место.
        const свой = двигатель === 'piper' ? ` — ${г.мб} ${с.mb}` : '';
        о.textContent = `${г.имя}${г.яз ? ` · ${г.яз}` : ''}${г.м ? ` (${г.м})` : ''}${свой}`;
        return о;
      }));
      списокГолосов.disabled = !своиГолоса.length;
      if (было && своиГолоса[Number(было)]) списокГолосов.value = было;
      видКнопок();
      показатьПроГолос();
    }

    const выбранныйГолос = () => своиГолоса[Number(списокГолосов.value)] || null;

    const скорость = () => Number($('рч-скорость').value);

    // ---- Один проигрыватель на все дорожки -----------------------------------------------------
    // Обычный <audio>, а не звуковой движок: движок после долгого сна телефона умирает молча,
    // и лечит это только обновление страницы. Проигрыватель это переживает и играет потоком,
    // не разжимая файл целиком в память.
    //
    // Проигрыватель ОДИН на все дорожки: два звука разом -- это каша, а не сравнение.
    // Нажали пуск на другой дорожке -- прежняя встаёт там, где стояла, и ждёт.
    let плеер = null;
    let активный = null;       // дорожка, которая сейчас заряжена в проигрыватель
    const треки = [];          // новые -- в начале
    const поУзлу = new Map();
    const ПРЕДЕЛ_ТРЕКОВ = 8;

    const мм = (сек) => {
      const ц = Math.max(0, Math.floor(Number(сек) || 0));
      return `${Math.floor(ц / 60)}:${String(ц % 60).padStart(2, '0')}`;
    };

    function завестиПлеер() {
      if (плеер) return плеер;
      плеер = new Audio();
      плеер.preload = 'auto';
      плеер.addEventListener('play', () => { состояние = 'играет'; видКнопок(); пуститьКадры(); });
      плеер.addEventListener('pause', () => {
        if (состояние === 'играет') состояние = 'пауза';
        видКнопок(); рисовать();
      });
      плеер.addEventListener('ended', () => {
        // Конец дорожки: бегунок возвращается в начало, как на всех плеерах сайта.
        // Обнулить надо и сам проигрыватель: показываем мы ЕГО положение, а он после конца
        // стоит на последней секунде -- бегунок так и замирал бы у правого края.
        if (активный) активный.позиция = 0;
        try { плеер.currentTime = 0; } catch (ош) {}
        состояние = 'стоп';
        остановитьКадры();
        видКнопок(); рисовать();
      });
      return плеер;
    }

    // ---- Бегунок со временем -------------------------------------------------------------------
    // Ведём КАДРАМИ (requestAnimationFrame), а не событием timeupdate: оно приходит четыре
    // раза в секунду, и бегунок от него дёргается.
    // Черта следует за курсором, время этой точки показывают часы справа.
    // Нажали по полосе: играло -- играет дальше с нового места, стояло -- остаётся стоять.
    let кадр = 0;
    let тянут = null;          // дорожка, полосу которой тащат
    let игралДоТяги = false;

    const позиция = (т) => (активный === т && плеер ? (плеер.currentTime || 0) : т.позиция);

    function рисовать(т) {
      for (const д of (т ? [т] : треки)) {
        const длина = д.длина || 0;
        const поз = Math.min(позиция(д), длина || 0);
        const доля = длина ? поз / длина : 0;
        д.заливка.style.width = `${(доля * 100).toFixed(2)}%`;
        д.точка.style.left = `${(доля * 100).toFixed(2)}%`;
        if (!д.узел.classList.contains('наведено')) д.времяЭ.textContent = мм(поз);
        д.длинаЭ.textContent = мм(длина);
        д.полоса.setAttribute('aria-valuemax', String(Math.round(длина)));
        д.полоса.setAttribute('aria-valuenow', String(Math.round(поз)));
        д.полоса.setAttribute('aria-valuetext', `${мм(поз)} / ${мм(длина)}`);
      }
    }

    function вестиКадры() {
      кадр = requestAnimationFrame(вестиКадры);
      рисовать(активный || undefined);
      if (!плеер || (плеер.paused && !тянут)) остановитьКадры();
    }
    function пуститьКадры() { if (!кадр) кадр = requestAnimationFrame(вестиКадры); }
    function остановитьКадры() { if (кадр) cancelAnimationFrame(кадр); кадр = 0; }

    // Долю считаем от самой полосы, а не от страницы: полоса тянется по ширине окна.
    function доляСобытия(т, е) {
      const р = т.полоса.getBoundingClientRect();
      return р.width ? Math.max(0, Math.min(1, (е.clientX - р.left) / р.width)) : 0;
    }

    function перемотать(т, доля) {
      const длина = т.длина || 0;
      if (!длина) return;
      const д = Math.max(0, Math.min(1, доля || 0));
      // Ровно в конец не ставим: браузер тут же шлёт ended, и дорожка «заканчивалась» бы сама
      // собой, стоило дотянуть бегунок до правого края.
      т.позиция = Math.min(д * длина, Math.max(0, длина - 0.05));
      if (активный === т && плеер) плеер.currentTime = т.позиция;
      рисовать(т);
    }

    // Ведение перемотки слушает ОКНО, а не сама полоса, и «захвата указателя» здесь нет.
    // Причина найдена опытом: при захвате отпускание изредка не доходило до полосы -- тяга
    // не завершалась, звук оставался на паузе, а следующее нажатие вело себя наоборот.
    // Окно получает отпускание всегда, где бы палец ни оторвался, и это заодно даёт
    // перетаскивание за пределами полосы -- так работают все ползунки.
    window.addEventListener('pointermove', (е) => {
      if (тянут) перемотать(тянут, доляСобытия(тянут, е));
    });
    const завершитьТягу = () => {
      const т = тянут;
      if (!т) return;
      тянут = null;
      // Играло до перемотки -- играет дальше с нового места; стояло -- остаётся стоять.
      if (игралДоТяги) включить(т, true);
      else рисовать(т);
    };
    window.addEventListener('pointerup', завершитьТягу);
    window.addEventListener('pointercancel', завершитьТягу);

    // ---- Готовая дорожка -------------------------------------------------------------------------

    // Длительность берём из заголовка WAV, а не из проигрывателя: так время видно сразу,
    // не дожидаясь, пока человек нажмёт пуск.
    async function длинаWAV(blob) {
      try {
        const в = new DataView(await blob.slice(0, 44).arrayBuffer());
        const каналов = в.getUint16(22, true) || 1;
        const частота = в.getUint32(24, true) || 22050;
        const бит = в.getUint16(34, true) || 16;
        const байтНаОтсчёт = каналов * (бит / 8);
        return байтНаОтсчёт ? (blob.size - 44) / (частота * байтНаОтсчёт) : 0;
      } catch (ош) { return 0; }
    }

    // Зарядить дорожку в проигрыватель. Свежую заряжаем СРАЗУ, как только она появилась, --
    // тогда нажатие «играть» звучит мгновенно, без ожидания загрузки файла. Раньше файл
    // начинал грузиться только по нажатию, и первый пуск изредка запаздывал на пару секунд:
    // человек жмёт, а тишина.
    function зарядить(т) {
      завестиПлеер();
      if (активный === т) return;
      if (активный) {
        активный.позиция = плеер.currentTime || 0;
        активный.узел.classList.remove('звучит');
      }
      плеер.pause();
      активный = т;
      т.узел.classList.add('звучит');
      плеер.src = т.url;
      плеер.load();
    }

    function включить(т, играть) {
      const сменили = активный !== т;
      зарядить(т);
      if (!играть) return;
      const пуск = () => {
        if (т.позиция > 0.05 && Math.abs((плеер.currentTime || 0) - т.позиция) > 0.1) {
          try { плеер.currentTime = т.позиция; } catch (ош) {}
        }
        const п = плеер.play();
        if (п && п.catch) п.catch(() => {});
      };
      // Ждать первых данных надо ТОЛЬКО когда подменили файл: просить играть сразу после
      // подмены нельзя, браузер отменяет запрос («play() interrupted by a new load request»).
      // Во всех остальных случаях играем немедленно. Раньше здесь стояла проверка готовности,
      // и она подводила после перемотки: во время поиска места браузер на миг сбрасывает
      // готовность, код уходил ждать запасной таймер -- и звук возвращался почти через
      // секунду. Со стороны это выглядело как «нажал, а оно молчит».
      if (!сменили || плеер.readyState >= 2) { пуск(); return; }
      let было = false;
      const разок = () => { if (было) return; было = true; пуск(); };
      плеер.addEventListener('loadeddata', разок, { once: true });
      setTimeout(разок, 400);
    }

    function остановить(т) {
      if (активный !== т) { т.позиция = 0; рисовать(т); видКнопок(); return; }
      плеер.pause();
      т.позиция = 0;
      try { плеер.currentTime = 0; } catch (ош) {}
      состояние = 'стоп';
      остановитьКадры();
      рисовать(т);
      видКнопок();
    }

    function убрать(т) {
      if (активный === т) {
        плеер.pause();
        плеер.removeAttribute('src');
        плеер.load();
        активный = null;
        состояние = 'стоп';
        остановитьКадры();
      }
      URL.revokeObjectURL(т.url);
      поУзлу.delete(т.узел);
      т.узел.remove();
      const и = треки.indexOf(т);
      if (и >= 0) треки.splice(и, 1);
      видКнопок();
    }

    async function скачать(т, формат) {
      try {
        let файл = т.blob;
        if (формат === 'mp3') {
          // Считаем на ЧАСТОТЕ САМОГО ЗВУКА (у Piper это 22050). Обычный AudioContext
          // работает на 48000 и молча пересчитывает вверх -- файл выходил вдвое тяжелее,
          // а лучше от этого не звучал.
          const байты = await т.blob.arrayBuffer();
          const частота = new DataView(байты).getUint32(24, true) || 22050;
          const ак = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: частота });
          const буфер = await ак.decodeAudioData(байты);
          файл = await encodeMP3(буфер, 128);
          await ак.close();
        }
        downloadBlob(файл, `${т.имя}.${формат}`);
        сказать(с.done);
      } catch (ошибка) {
        весть(`${с.piperFail}. ${String((ошибка && ошибка.message) || ошибка)}`, true);
      }
    }

    async function добавитьТрек(blob, подпись, имя) {
      const узел = образец.content.firstElementChild.cloneNode(true);
      const т = {
        узел, blob, имя,
        url: URL.createObjectURL(blob),
        длина: await длинаWAV(blob),
        позиция: 0,
        полоса: узел.querySelector('.рч-полоса'),
        заливка: узел.querySelector('.рч-полоса i'),
        точка: узел.querySelector('.рч-точка'),
        черта: узел.querySelector('.рч-черта'),
        времяЭ: узел.querySelector('.рч-часы b'),
        длинаЭ: узел.querySelector('.рч-часы span'),
        кнИграть: узел.querySelector('[data-роль="играть"]'),
      };
      узел.querySelector('.рч-трек-что').textContent = подпись;

      узел.addEventListener('click', (е) => {
        const кн = е.target.closest('[data-роль]');
        if (!кн) return;
        const роль = кн.dataset.роль;
        if (роль === 'играть') {
          if (активный === т && состояние === 'играет') { плеер.pause(); return; }
          включить(т, true);
        } else if (роль === 'стоп') остановить(т);
        else if (роль === 'убрать') убрать(т);
        else if (роль === 'mp3' || роль === 'wav') скачать(т, роль);
      });

      т.полоса.addEventListener('pointerdown', (е) => {
        if (!т.длина) return;
        е.preventDefault();
        тянут = т;
        игралДоТяги = активный === т && плеер && !плеер.paused;
        // Пока тащат, звук молчит: иначе он рвётся обрывками на каждом движении пальца.
        if (игралДоТяги) плеер.pause();
        перемотать(т, доляСобытия(т, е));
      });
      // Ведение и отпускание слушает ОКНО (см. ниже) -- палец и мышь уходят с полосы.
      т.полоса.addEventListener('pointermove', (е) => {
        if (тянут || !т.длина) return;
        const доля = доляСобытия(т, е);
        т.черта.style.left = `${(доля * 100).toFixed(2)}%`;
        узел.classList.add('наведено');
        т.времяЭ.textContent = мм(доля * т.длина);
      });
      т.полоса.addEventListener('pointerleave', () => {
        if (!узел.classList.contains('наведено')) return;
        узел.classList.remove('наведено');
        рисовать(т);
      });
      // С клавиатуры: стрелки по пять секунд, Home и End -- к краям.
      т.полоса.addEventListener('keydown', (е) => {
        if (!т.длина) return;
        const шаг = е.key === 'ArrowLeft' ? -5 : е.key === 'ArrowRight' ? 5 : 0;
        if (шаг) перемотать(т, (позиция(т) + шаг) / т.длина);
        else if (е.key === 'Home') перемотать(т, 0);
        else if (е.key === 'End') перемотать(т, 1);
        else return;
        е.preventDefault();
      });

      поУзлу.set(узел, т);
      треки.unshift(т);
      гнездоТреков.prepend(узел);
      // Больше восьми дорожек в памяти держать незачем: каждая -- целый файл звука.
      while (треки.length > ПРЕДЕЛ_ТРЕКОВ) убрать(треки[треки.length - 1]);
      рисовать(т);
      if (!активный) зарядить(т);
      видКнопок();
      return т;
    }

    // ---- Вид кнопок ----------------------------------------------------------------------------

    function видКнопок() {
      const считает = состояние === 'считает';
      кнГенерировать.disabled = считает;
      кнГенерировать.classList.toggle('считает', считает);
      списокГолосов.disabled = считает || !своиГолоса.length;
      $('рч-модель').disabled = считает;
      for (const т of треки) {
        // Треугольник или две палочки -- вид кнопки, а не её надпись. Подпись для чтецов
        // экрана меняем тем же движением, иначе незрячий слышит «воспроизвести» на паузе.
        const идёт = активный === т && состояние === 'играет';
        т.кнИграть.classList.toggle('играет', идёт);
        т.кнИграть.setAttribute('aria-label', идёт ? с.pause : с.play);
        т.кнИграть.title = т.кнИграть.getAttribute('aria-label');
      }
    }

    // ---- Синтез --------------------------------------------------------------------------------

    // Один и тот же текст тем же голосом не пересчитываем: синтез не мгновенный, а человек
    // жмёт «Сгенерировать» по нескольку раз подряд.
    function ключЗвука() {
      const г = выбранныйГолос();
      return [ввод.value.trim(), двигатель, г && г.к, г && г.г, скорость()].join('|');
    }

    async function свойЗвук() {
      const ключ = ключЗвука();
      if (готовыйЗвук && готовыйЗвук.ключ === ключ) return готовыйЗвук.blob;
      const г = выбранныйГолос();
      if (!г) throw new Error(с.noVoices);
      const ответ = await спросить({
        тип: 'синтез', текст: ввод.value.trim(), голос: г.к, номер: г.г, скорость: скорость(),
        // Supertonic определяет произношение по языку, а не по голосу: без этого русский
        // текст читался бы английскими правилами. Piper и Kokoro поле просто не смотрят.
        язык: г.я || язык,
      });
      // Поток отдаёт, сколько секунд он считал. Это и есть опыт устройства: в следующий раз
      // ожидание считается по нему, а не по нашим числам из реестра.
      запомнитьОпыт(двигатель, ввод.value.trim().length, Number(ответ.секунд), скорость());
      const blob = new Blob([ответ.байты], { type: 'audio/wav' });
      готовыйЗвук = { ключ, blob };
      return blob;
    }

    async function сгенерировать() {
      const текст = ввод.value.trim();
      if (!текст) { сказать(с.empty); ввод.focus(); return; }
      if (состояние === 'считает') return;
      убратьВесть();
      состояние = 'считает';
      видКнопок();
      кнГенерировать.textContent = `${с.working}…`;
      try {
        const blob = await свойЗвук();
        const г = выбранныйГолос();
        const имя = (текст.slice(0, 32).replace(/[^\p{L}\p{N}]+/gu, '-')
          .replace(/^-|-$/g, '') || 'speech');
        // Подпись говорит, чем эта дорожка отличается от соседней: голос и скорость.
        // Начала текста здесь нет: текст у всех дорожек один и тот же и стоит в поле выше.
        const подпись = [г && г.имя, `${скорость().toFixed(2)}×`].filter(Boolean).join(' · ');
        состояние = 'стоп';
        await добавитьТрек(blob, подпись, имя);
        убратьРаботу();
      } catch (ошибка) {
        состояние = 'стоп';
        весть(`${с.piperFail}. ${почемуНеВышло(ошибка) || String((ошибка && ошибка.message) || ошибка)}`, true);
        убратьРаботу();
      }
      кнГенерировать.textContent = с.gen;
      видКнопок();
    }

    кнГенерировать.addEventListener('click', сгенерировать);

    // ---- Настройки -----------------------------------------------------------------------------

    function переключить(на) {
      if (двигатель === на) return;
      двигатель = на;
      готовыйЗвук = null;
      скачанные = [];
      const списокМоделей = $('рч-модель');
      if (списокМоделей) списокМоделей.value = на;
      // Описание и ограничение живут ПОД списком: в строке закрытого списка длинная фраза
      // не помещается ни на одном телефоне, а знать, поедет ли модель на телефоне,
      // надо ДО нажатия.
      const где = $('рч-м-где');
      if (где) где.textContent = ПРО_МОДЕЛЬ[на] || '';
      списокГолосов.value = '';
      поднятьРаботника();
      своиГолоса = голосаМодели(на).slice().sort((а, б) => {
        const свой = (г) => (г.я === язык ? 0 : 1);
        return свой(а) - свой(б) || (а.яз || '').localeCompare(б.яз || '')
          || а.мб - б.мб || а.имя.localeCompare(б.имя);
      });
      заполнитьСвои();
      убратьВесть();
      работник.postMessage({ тип: 'что-скачано' });
      показатьПроГолос();
    }
    $('рч-модель').addEventListener('change', (е) => переключить(е.target.value));

    // Готовые дорожки при смене настроек НЕ трогаем: они для того и сделаны, чтобы сравнить
    // прежний голос с новым. Сбрасывается только кеш, чтобы следующий пуск считал заново.
    списокГолосов.addEventListener('change', () => {
      готовыйЗвук = null;
      показатьПроГолос();
    });

    {
      const п = $('рч-скорость');
      const покрасить = () => {
        const доля = ((Number(п.value) - Number(п.min)) / (Number(п.max) - Number(п.min))) * 100;
        п.style.setProperty('--доля', `${доля}%`);
        $('рч-скорость-знач').textContent = `${Number(п.value).toFixed(2)}×`;
      };
      п.addEventListener('input', покрасить);
      п.addEventListener('change', () => { готовыйЗвук = null; });
      покрасить();
    }

    ввод.addEventListener('input', () => {
      const длина = ввод.value.length;
      $('рч-знаков').textContent = String(длина);
      $('рч-знаков-гнездо').classList.toggle('перебор', длина >= ПРЕДЕЛ);
      // Готовые дорожки при наборе НЕ трогаем: они сделаны ровно для того, чтобы сравнивать,
      // и пропадать от каждой набранной буквы им незачем.
    });

    // ---- Запуск ------------------------------------------------------------------------------

    заполнитьСвои();
    видКнопок();
    // Работника поднимаем не сразу: на странице, куда пришли просто почитать, лишние
    // триста килобайт ни к чему. Заводим в простое, чтобы к первому нажатию он был готов
    // и уже знал, какие голоса лежат на устройстве.
    if (typeof requestIdleCallback === 'function') requestIdleCallback(() => поднятьРаботника(), { timeout: 4000 });
    else setTimeout(() => поднятьРаботника(), 1500);
    // Уходя со страницы, отпускаем и звук, и память под дорожками.
    window.addEventListener('pagehide', () => {
      try { if (плеер) плеер.pause(); } catch (е) {}
      for (const т of треки.slice()) { try { URL.revokeObjectURL(т.url); } catch (е) {} }
    });

    window.__рчСостояние = () => ({
      знаков: $('рч-знаков').textContent,
      состояние,
      скорость: $('рч-скорость-знач').textContent,
      двигатель,
      своихГолосов: своиГолоса.length,
      скачано: скачанные.length,
      весть: $('рч-голос-весть').textContent,
      ответ: окноОтвета.textContent.trim(),
      ход: (ходТекст.textContent + ' ' + ходЧисло.textContent).trim(),
      ходИдёт: ходГнездо.classList.contains('идёт'),
      треков: треки.length,
      идётЗвук: !!(плеер && !плеер.paused),
      дорожки: треки.map((т) => ({
        что: т.узел.querySelector('.рч-трек-что').textContent,
        время: т.времяЭ.textContent,
        длина: т.длинаЭ.textContent,
        всего: Number((т.длина || 0).toFixed(2)),
        поз: Number(позиция(т).toFixed(2)),
        бегунок: т.заливка.style.width,
        активная: активный === т,
      })),
    });
    // Проверять перемотку надо ДЕЙСТВИЕМ: нажатие по полосе на долю её ширины.
    window.__рчПеремотка = (номер, доля) => {
      const т = треки[номер];
      const р = т.полоса.getBoundingClientRect();
      const х = р.left + р.width * доля;
      for (const вид of ['pointerdown', 'pointermove', 'pointerup']) {
        т.полоса.dispatchEvent(new PointerEvent(вид, { clientX: х, clientY: р.top + р.height / 2,
          bubbles: true, pointerId: 1 }));
      }
      return window.__рчСостояние();
    };
    // Проба связки целиком: выбрать модель, вписать текст, получить звук. Возвращает размер
    // и ПИК -- по пику видно, звук это или тишина, а тишину глазами не отличить.
    window.__рчПроба = async (модель, текст) => {
      переключить(модель);
      ввод.value = текст;
      ввод.dispatchEvent(new Event('input', { bubbles: true }));
      const blob = await свойЗвук();
      const буфер = await blob.arrayBuffer();
      const в = new DataView(буфер);
      let пик = 0;
      for (let и = 44; и + 1 < буфер.byteLength; и += 2) {
        const з = Math.abs(в.getInt16(и, true)) / 32768;
        if (з > пик) пик = з;
      }
      const г = выбранныйГолос();
      return { модель: двигатель, голос: г && г.к, язык: г && г.я,
               кб: Math.round(буфер.byteLength / 1024), пик: Number(пик.toFixed(3)),
               голосов: своиГолоса.length };
    };
  })();
</script>
