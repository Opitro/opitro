---
// КАРТОЧКА ИНСТРУМЕНТА -- одна на весь сайт.
//
// Раньше её разметка была скопирована в трёх местах: дважды на странице рубрики (в полках и
// в общей сетке) и внизу страницы инструмента, в плитках «попробуйте ещё». Любая правка вида
// требовала найти все три, а при 500 инструментах и десятке языков именно такое расходится
// первым. Теперь место одно.
//
// СТИЛИ ЛЕЖАТ ЗДЕСЬ ЖЕ, И ЭТО НЕ УКРАШЕНИЕ. В Astro <style> внутри .astro-файла привязан к
// элементам ЭТОГО файла: сборщик дописывает им метку вида data-astro-cid-…. Когда разметка
// уехала в компонент, а правило цвета значка осталось на странице рубрики, оно перестало
// совпадать -- метки у новых элементов нет. Правило молча выпало, и все значки стали зелёными
// от общего .tc-ico в Layout. Поэтому стили карточки живут вместе с карточкой: так велит
// документация Astro и так их нельзя потерять при следующем переносе.
//
// На карточке только название. Подписи под ним нет намеренно: если название говорит
// «Генератор QR-кода», вторая строка повторяет его же и делает плитку многословнее, а не
// понятнее. Поле summary в шапках осталось -- оно пригодится поиску по сайту.
import { iconFor, colorFor } from '../lib/tool-icons.js';

export interface Props {
  /** data записи коллекции tools или mediaTools */
  данные: any;
}

const { данные } = Astro.props;
const имя = данные.navName || данные.h1;
---

<a class="tool-card" href={`/${данные.locale}/${данные.toolSlug}`}>
  <span class="tc-плашка" style={`--цвет: ${colorFor(данные.toolSlug, данные.category)}`}>
    <svg class="tc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
         stroke-linecap="round" stroke-linejoin="round" set:html={iconFor(данные.toolSlug, данные.category)} />
  </span>
  <span class="tc-name">{имя}</span>
</a>

<style>
  /* ЦВЕТ ЗНАЧКА -- свой у каждого инструмента, а не общий зелёный. Тринадцать зелёных плашек
     подряд читаются как один сплошной список; цвет взят от того, что нарисовано на значке
     (см. colorFor) и приходит переменной --цвет прямо из разметки, поэтому одного правила
     хватает на все плитки сразу.
     Правило нарочно сильнее общего .tc-ico в Layout: два имени класса против одного. */
  .tc-плашка { flex: none; display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px }
  .tc-плашка .tc-ico { color: var(--цвет); width: 19px; height: 19px }
</style>
