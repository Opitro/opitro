---

import { iconFor, colorFor } from '../lib/tool-icons.js';

export interface Props {

  данные: any;
}

const { данные } = Astro.props;
const имя = данные.navName || данные.h1;
---

<a class="tool-card" href={`/${данные.locale}/${данные.toolSlug}`}>
  <span class="tc-плашка" style={`--цвет: ${colorFor(данные.toolSlug, данные.category)}`}>
    <svg class="tc-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
         stroke-linecap="round" stroke-linejoin="round" set:html={iconFor(данные.toolSlug, данные.category)} />
  </span>
  <span class="tc-name">{имя}</span>
</a>

<style>

  .tc-плашка { flex: none; display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 10px;
    background: color-mix(in srgb, var(--цвет) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--цвет) 22%, transparent);
    transition: background .18s, border-color .18s }
  .tc-плашка .tc-ico { color: var(--цвет); width: 18px; height: 18px }

  .tool-card:hover .tc-плашка { background: color-mix(in srgb, var(--цвет) 22%, transparent);
    border-color: color-mix(in srgb, var(--цвет) 38%, transparent) }
</style>
