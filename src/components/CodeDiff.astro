const с = СЛОВА[locale] || СЛОВА.ru;

const КОРЗИНА = `<svg viewBox="0 0 24 24" aria-hidden="true">
  <path d="M4 7h16"></path>
  <path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
  <path d="M6.5 7l.9 12.6a1.5 1.5 0 0 0 1.5 1.4h6.2a1.5 1.5 0 0 0 1.5-1.4L17.5 7"></path>
  <path d="M10 11v6M14 11v6"></path>
</svg>`;
const ЛИСТ = `<svg class="лист" viewBox="0 0 24 24" aria-hidden="true">
  <rect x="9" y="9" width="11" height="12" rx="2"></rect>
  <path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"></path>
</svg><svg class="галка" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5.5 5.5L20 7"></path></svg>`;
---

<style is:inline set:html={css}></style>

<div class="дп" data-words={JSON.stringify(с)}>

  <div class="дп-верх">
    <span class="дп-подпись">{с.ignore}:</span>
    <label class="дп-галка"><input type="checkbox" id="дп-хвосты"><i></i>{с.igTrailing}</label>
    <label class="дп-галка"><input type="checkbox" id="дп-пустые"><i></i>{с.igBlank}</label>
    <label class="дп-галка"><input type="checkbox" id="дп-отступ"><i></i>{с.igIndent}</label>
  </div>

  <div class="дп-пара">
    <div class="дп-поле">
      <span class="дп-имя">{с.nameA}</span>
      <textarea class="дп-ввод" id="дп-а" placeholder={с.placeA} spellcheck="false"
                autocomplete="off" autocapitalize="off"></textarea>
      <div class="дп-полоса">
        <span class="дп-счёт" id="дп-счёт-а"></span>
        <button type="button" class="дп-значок" id="дп-корзина-а" disabled
                aria-label={с.clearOne} title={с.clearOne} set:html={КОРЗИНА}></button>
      </div>
    </div>
    <div class="дп-поле">
      <span class="дп-имя">{с.nameB}</span>
      <textarea class="дп-ввод" id="дп-б" placeholder={с.placeB} spellcheck="false"
                autocomplete="off" autocapitalize="off"></textarea>
      <div class="дп-полоса">
        <span class="дп-счёт" id="дп-счёт-б"></span>
        <button type="button" class="дп-значок" id="дп-корзина-б" disabled
                aria-label={с.clearOne} title={с.clearOne} set:html={КОРЗИНА}></button>
      </div>
    </div>
  </div>

  <!-- Место под находки отведено всегда: без этого страница дёргалась бы, ведь сравнение
       идёт на лету. -->
  <div class="дп-невидимое" id="дп-невидимое">
    <div class="дп-заголовок-находок">{с.hidden}</div>
    <div class="дп-находки" id="дп-находки"></div>
  </div>

  <div class="дп-окно">
    <div class="дп-итог" id="дп-итог">
      <div class="дп-пусто">{с.empty}</div>
    </div>
    <div class="дп-полоса">
      <span class="дп-счётчики">
        <span class="убрано">{с.removed}: <b id="дп-убрано">0</b></span>
        <span class="добавлено">{с.added}: <b id="дп-добавлено">0</b></span>
        <span class="дп-сказ" id="дп-сказ"></span>
      </span>
      <button type="button" class="дп-значок дп-копи" id="дп-копировать" disabled
              aria-label={с.copy} title={с.copy} set:html={ЛИСТ}></button>
    </div>
  </div>

  <div class="дп-низ">
    <button type="button" class="дп-простая" id="дп-поменять">{с.swap}</button>
    <button type="button" class="дп-простая" id="дп-очистить">{с.clearAll}</button>
  </div>

  <div class="дп-заметки">
    <div class="дп-заметка" set:html={с.n1}></div>
    <div class="дп-заметка" set:html={с.n2}></div>
    <div class="дп-заметка" set:html={с.n3}></div>
    <div class="дп-заметка" set:html={с.n4}></div>
    <div class="дп-заметка" set:html={с.n5}></div>
  </div>
</div>

<script>
  import { сравнить as сличить, наСтроки } from '../lib/diff.js';
  import { невидимыеРазличия, патч, участки, видКонцов } from '../lib/code-diff.js';

  const корень = document.querySelector('.дп');
  if (корень) (() => {
    const с = JSON.parse(корень.dataset.words || '{}');
    const $ = (и) => document.getElementById(и);
    const полеА = $('дп-а');
    const полеБ = $('дп-б');
    const итог = $('дп-итог');
    let последние = null;
    let огрубили = false;
    // Какие свёрнутые участки человек уже развернул -- по их месту в ряду, чтобы при
    // следующем пересчёте они не схлопнулись обратно.
    let развёрнутые = new Set();
    /* Концы строк берём из СЫРОГО текста вставки: поле ввода само приводит CRLF к LF, и из
       его содержимого их уже не узнать. Измерено -- textarea.value отдаёт LF всегда.
       Сведения ПРИВЯЗАНЫ к самому тексту: помним, что вышло в поле сразу после вставки, и
       верим находке, только пока в поле лежит ровно оно. Иначе надпись пережила бы свой
       текст -- вставил один раз CRLF, а она висит и над совсем другим содержимым. */
    const вставка = { а: null, б: null };
    const концыСейчас = () => ({
      а: вставка.а && вставка.а.текст === полеА.value ? вставка.а.концы : null,
      б: вставка.б && вставка.б.текст === полеБ.value ? вставка.б.концы : null,
    });
    /** Что поле сделает со вставленным: приведёт любые концы строк к LF. */
    const какЛяжет = (сырое) => String(сырое).replace(/\r\n|\r/g, '\n');

    /* ---- Сравнение ------------------------------------------------------------------------ */

    function сравнитель() {
      const хвосты = $('дп-хвосты').checked;
      const отступ = $('дп-отступ').checked;
      return (x, y) => {
        let а = x, б = y;
        if (хвосты) { а = а.replace(/[ \t]+$/, ''); б = б.replace(/[ \t]+$/, ''); }
        // Величина отступа, а не сам факт: ведущие пробелы и табы сводим к одному пробелу.
        if (отступ) {
          а = а.replace(/^[ \t]+/, (м) => (м ? ' ' : ''));
          б = б.replace(/^[ \t]+/, (м) => (м ? ' ' : ''));
        }
        return а === б;
      };
    }

    const резать = (текст) => {
      const строки = наСтроки(текст);
      return $('дп-пустые').checked ? строки.filter((с2) => с2.trim() !== '') : строки;
    };

    /* ---- Невидимое ------------------------------------------------------------------------- */

    const ПОДПИСИ = {
      концы: () => [с.hCrlf, с.hCrlfWhy],
      концыСмешаны: () => [с.hMixed, с.hMixedWhy],
      отступы: () => [с.hIndent, с.hIndentWhy],
      хвосты: (сколько) => [`${с.hTrail} (${сколько})`, с.hTrailWhy],
      метка: () => [с.hBom, с.hBomWhy],
      неразрывные: (сколько) => [`${с.hNbsp} (${сколько})`, с.hNbspWhy],
    };

    function показатьНевидимое(а, б) {
      const гнездо = $('дп-находки');
      гнездо.replaceChildren();
      if (!а && !б) { гнездо.append(строчкаНаходки('', с.hNone, true)); return; }
      const находки = невидимыеРазличия(а, б, концыСейчас());
      if (!находки.length) { гнездо.append(строчкаНаходки('', с.hNone, true)); return; }
      for (const [ключ, подробность] of находки) {
        const делать = ПОДПИСИ[ключ];
        if (!делать) continue;
        const [имя, почему] = делать(подробность);
        гнездо.append(строчкаНаходки(имя, почему, false, ключ === 'концы' ? подробность : ''));
      }
    }

    function строчкаНаходки(имя, почему, тихо, добавка) {
      const э = document.createElement('div');
      э.className = 'дп-находка' + (тихо ? ' тихо' : '');
      if (имя) {
        const б = document.createElement('b');
        б.textContent = добавка ? `${имя}: ${добавка}` : имя;
        э.append(б, document.createTextNode(' — ' + почему));
      } else {
        э.textContent = почему;
      }
      return э;
    }

    /* ---- Показ ------------------------------------------------------------------------------ */

    function строкаУзел(к) {
      const строка = document.createElement('div');
      строка.className = 'дп-строка' + (к.вид === 'равно' ? '' : ' ' + к.вид);
      const на = document.createElement('span');
      на.className = 'номер';
      на.textContent = к.на === null ? '' : String(к.на);
      const нб = document.createElement('span');
      нб.className = 'номер';
      нб.textContent = к.нб === null ? '' : String(к.нб);
      const знак = document.createElement('span');
      знак.className = 'знак';
      знак.textContent = к.вид === 'удалено' ? '−' : (к.вид === 'добавлено' ? '+' : ' ');
      const тело = document.createElement('span');
      тело.className = 'тело';
      тело.textContent = к.вид === 'добавлено' ? к.б : к.а;
      строка.append(на, нб, знак, тело);
      return строка;
    }

    function показать(куски) {
      итог.replaceChildren();
      const части = участки(куски, 3);
      части.forEach((часть, номер) => {
        if (часть.вид === 'строки' || развёрнутые.has(номер)) {
          for (const к of часть.строки) итог.append(строкаУзел(к));
          return;
        }
        const кнопка = document.createElement('button');
        кнопка.type = 'button';
        кнопка.className = 'дп-развернуть';
        кнопка.textContent = `${с.expand} ${часть.строки.length} ${с.linesShort}`;
        кнопка.addEventListener('click', () => {
          развёрнутые.add(номер);
          показать(последние);
        });
        итог.append(кнопка);
      });
    }

    function пусто(текст) {
      const э = document.createElement('div');
      э.className = 'дп-пусто';
      э.textContent = текст;
      итог.replaceChildren(э);
    }

    /* ---- Работа ------------------------------------------------------------------------------ */

    /* «1 строк» -- так по-русски не говорят. Формы: 1 строка, 2-4 строки, 5 строк, и снова
       с одиннадцати по четырнадцать -- «строк». В английском и испанском форм всего две. */
    function форма(число, формы) {
      if (формы.length === 2) return формы[число === 1 ? 0 : 1];
      const сотня = Math.abs(число) % 100;
      const десяток = сотня % 10;
      if (сотня >= 11 && сотня <= 14) return формы[2];
      if (десяток === 1) return формы[0];
      if (десяток >= 2 && десяток <= 4) return формы[1];
      return формы[2];
    }

    function пересчитатьОкна() {
      for (const [поле, счёт, корзина] of [[полеА, 'дп-счёт-а', 'дп-корзина-а'],
                                           [полеБ, 'дп-счёт-б', 'дп-корзина-б']]) {
        const текст = поле.value;
        $(счёт).textContent = текст
          ? `${с.countLines}: ${наСтроки(текст).length} · ${с.countChars}: ${[...текст].length}`
          : '';
        $(корзина).disabled = !текст;
      }
    }

    /* Предупреждение об огрублении -- состояние, а не мигалка: пока на экране грубый ответ,
       надпись обязана висеть, иначе человек примет грубое за точное. */
    function состояниеСказа() {
      const э = $('дп-сказ');
      э.textContent = огрубили ? с.coarse : '';
      э.classList.toggle('видно', огрубили);
    }

    function сказать(текст, сколько = 1800) {
      const э = $('дп-сказ');
      э.textContent = текст;
      э.classList.add('видно');
      clearTimeout(э._т);
      э._т = setTimeout(состояниеСказа, сколько);
    }

    function сравнить(сброситьРазвёрнутые = true) {
      if (сброситьРазвёрнутые) развёрнутые = new Set();
      const текстА = полеА.value;
      const текстБ = полеБ.value;
      пересчитатьОкна();
      показатьНевидимое(текстА, текстБ);

      if (!текстА && !текстБ) {
        последние = null; огрубили = false;
        пусто(с.empty);
        $('дп-убрано').textContent = '0';
        $('дп-добавлено').textContent = '0';
        $('дп-копировать').disabled = true;
        состояниеСказа();
        return;
      }

      const итогСличения = сличить(резать(текстА), резать(текстБ), сравнитель());
      последние = итогСличения.куски;
      огрубили = итогСличения.огрублено;

      const убрано = последние.filter((к) => к.вид === 'удалено').length;
      const добавлено = последние.filter((к) => к.вид === 'добавлено').length;
      $('дп-убрано').textContent = `${убрано} ${форма(убрано, с.lines)}`;
      $('дп-добавлено').textContent = `${добавлено} ${форма(добавлено, с.lines)}`;
      $('дп-копировать').disabled = !(убрано || добавлено);
      состояниеСказа();

      if (!убрано && !добавлено) {
        пусто(текстА === текстБ ? с.same : с.sameButIgnored);
        return;
      }
      показать(последние);
    }

    for (const [поле, имя] of [[полеА, 'а'], [полеБ, 'б']]) {
      поле.addEventListener('input', () => сравнить());
      // Вставку ловим до того, как поле выровняет концы строк.
      поле.addEventListener('paste', (е) => {
        const сырое = е.clipboardData && е.clipboardData.getData('text/plain');
        if (typeof сырое !== 'string') return;
        // Ждём, пока браузер вставит, и запоминаем только если в поле легло РОВНО вставленное:
        // при вставке в непустое поле сведения о концах описывали бы лишь часть содержимого.
        setTimeout(() => {
          const норм = какЛяжет(сырое);
          вставка[имя] = поле.value === норм ? { концы: видКонцов(сырое), текст: норм } : null;
          сравнить();
        }, 0);
      });
    }
    for (const и of ['дп-хвосты', 'дп-пустые', 'дп-отступ']) {
      $(и).addEventListener('change', () => сравнить());
    }

    for (const [поле, корзина] of [[полеА, 'дп-корзина-а'], [полеБ, 'дп-корзина-б']]) {
      $(корзина).addEventListener('click', () => {
        поле.value = '';
        вставка[поле === полеА ? 'а' : 'б'] = null;
        сравнить();
        поле.focus();
      });
    }

    $('дп-поменять').addEventListener('click', () => {
      const было = полеА.value;
      полеА.value = полеБ.value;
      полеБ.value = было;
      const к = вставка.а; вставка.а = вставка.б; вставка.б = к;
      сравнить();
    });

    $('дп-очистить').addEventListener('click', () => {
      полеА.value = ''; полеБ.value = '';
      вставка.а = null; вставка.б = null;
      сравнить();
      полеА.focus();
    });

    $('дп-копировать').addEventListener('click', async () => {
      const кнопка = $('дп-копировать');
      if (!последние || !последние.some((к) => к.вид !== 'равно')) { сказать(с.nothing); return; }
      const текст = патч(последние, { а: с.nameA, б: с.nameB });
      let вышло = false;
      try { await navigator.clipboard.writeText(текст); вышло = true; } catch (е) { вышло = false; }
      if (!вышло) { сказать(с.copyFail); return; }
      кнопка.classList.add('готово');
      кнопка.setAttribute('aria-label', с.copied);
      clearTimeout(кнопка._т);
      кнопка._т = setTimeout(() => {
        кнопка.classList.remove('готово');
        кнопка.setAttribute('aria-label', с.copy);
      }, 1500);
    });

    сравнить();

    window.__дпСостояние = () => ({
      убрано: $('дп-убрано').textContent, добавлено: $('дп-добавлено').textContent,
      счётА: $('дп-счёт-а').textContent, счётБ: $('дп-счёт-б').textContent,
      корзинаАЖива: !$('дп-корзина-а').disabled, корзинаБЖива: !$('дп-корзина-б').disabled,
      копиЖива: !$('дп-копировать').disabled,
      сказ: $('дп-сказ').textContent, огрубили,
      находки: [...document.querySelectorAll('.дп-находка')].map((э) => э.textContent),
      тихо: document.querySelectorAll('.дп-находка.тихо').length,
      пусто: Boolean(итог.querySelector('.дп-пусто')),
      пустоТекст: (итог.querySelector('.дп-пусто') || {}).textContent || '',
      строк: итог.querySelectorAll('.дп-строка').length,
      убранных: итог.querySelectorAll('.дп-строка.удалено').length,
      добавленных: итог.querySelectorAll('.дп-строка.добавлено').length,
      свёрток: итог.querySelectorAll('.дп-развернуть').length,
      номера: [...итог.querySelectorAll('.дп-строка')].slice(0, 6)
        .map((э) => [...э.querySelectorAll('.номер')].map((н) => н.textContent).join('/')),
    });
    window.__дпВвод = (а, б) => {
      const н = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, 'value').set;
      if (а !== undefined) н.call(полеА, а);
      if (б !== undefined) н.call(полеБ, б);
      сравнить();
      return window.__дпСостояние();
    };
    /* Вставка так, как её делает человек: сырой текст с CR попадает в обработчик, а в поле
       ложится уже выровненный -- ровно как в браузере. */
    window.__дпВставка = (сырое, куда) => {
      const имя = куда === 'б' ? 'б' : 'а';
      const поле = имя === 'б' ? полеБ : полеА;
      const норм = какЛяжет(сырое);
      const н = Object.getOwnPropertyDescriptor(HTMLTextAreaElement.prototype, 'value').set;
      н.call(поле, норм);   // поле выравнивает концы -- делаем то же самое
      вставка[имя] = { концы: видКонцов(сырое), текст: норм };
      сравнить();
      return window.__дпСостояние();
    };
    window.__дпПатч = () => (последние ? патч(последние, { а: с.nameA, б: с.nameB }) : '');
    window.__дпГалка = (имя, знач) => { $('дп-' + имя).checked = знач; сравнить(); return window.__дпСостояние(); };
    window.__дпРазвернуть = () => {
      const к = итог.querySelector('.дп-развернуть');
      if (к) к.click();
      return window.__дпСостояние();
    };
  })();
</script>
