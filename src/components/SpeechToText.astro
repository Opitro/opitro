---
import playerCss from '../styles/player.css?inline';
import css from '../styles/speech-to-text.css?inline';
// Speech to text. Its own component for the same reason AudioToMidi is: the output is text, not
// a buffer, so none of AudioTool's render/export machinery applies.
//
// Whisper via transformers.js, running in the visitor's own browser. The model is downloaded from
// a CDN; the recording is not uploaded anywhere, which is what lets this page carry the same
// promise as every other page here.
//
// Deliberately NOT the browser's built-in SpeechRecognition, which is what the reference
// implementation used: that one is microphone-only (it cannot transcribe a file at all), works
// only in Chrome and Edge, and sends the audio to Google's servers. See project-browser-models.
import AdSlot from './AdSlot.astro';

interface Props {
  locale: string;
  labels: Record<string, any>;
  // 'file'  — a recording you already have: lectures, interviews, subtitles for video.
  // 'voice' — speaking into the microphone right now.
  // Two pages, one component: the work is identical, but the two are different jobs people search
  // for in different words, and each page is simpler for dropping the other one's controls.
  mode?: 'file' | 'voice';
}

const { locale, labels, mode = 'file' } = Astro.props;
const isVoice = mode === 'voice';

const ICO = {
  download: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5M12 15V3"/>',
  copy: '<rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>',
  check: '<polyline points="20 6 9 17 4 12"/>',
  text: '<path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/>',
  trash: '<path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>',
};
---

{/* The component's stylesheet is imported as a string and written out here, rather
    than left as an Astro <style> block. Astro attaches a page's styles by walking what
    the page module imports, not what it renders, so one route file importing all the
    tool components put every component's CSS into every page -- an identical 47 KB
    everywhere, of which a calculator page used almost none. As a plain string it lands
    only on the page that renders this component. It goes first, before any markup, so
    nothing is ever painted unstyled. */}
<style is:inline set:html={playerCss + css}></style>

<div class="stt-tool" data-locale={locale} data-mode={mode} data-labels={JSON.stringify(labels)}>
  {!isVoice && (
  <div class="drop" id="st-drop">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5M12 15V3"/></svg>
    <div class="big">{labels.dropLabel}</div>
    <div class="small">{labels.dropHint}</div>
    <div class="small formats">{labels.sttAcceptsLabel}</div>
  </div>
  )}
  <input type="file" id="st-file">

  {isVoice && <div class="voice-lead">{labels.voiceLeadLabel}</div>}
  {/* Круглая кнопка записи вместо полосы во всю ширину. Знак выбран не на вкус: красный кружок --
      это «запись» из плёночной традиции, так подписаны диктофоны и запись экрана; квадрат -- это
      «остановить». Микрофон означает другое -- «говорите», голосовой ввод, -- и для кнопки,
      которая начинает и заканчивает запись, читается хуже. Узнаваемость даёт форма, а не размер,
      поэтому полоса и не нужна. */}
  {isVoice && (
  <div class="mic-row" id="st-mic-row">
    <button type="button" class="mic-btn" id="st-mic" aria-label={labels.sttRecordLabel}>
      <span class="mic-dot" aria-hidden="true"></span>
    </button>
    <div class="mic-text">
      <span id="st-mic-label">{labels.sttRecordLabel}</span>
      <span class="mic-time" id="st-mic-time"></span>
    </div>
  </div>
  )}

  <div class="panel" id="st-panel">
    {/* Панель того же вида, что на остальных аудиоинструментах: имя файла -- верхняя строка,
        волна, под ней управление. Раньше здесь была отдельная плашка над плеером, кнопка внутри
        волны и часы прямо в дорожке. */}
    <div class="wave-shell compact" id="st-wave-shell">
      <div class="fileinfo" id="st-fileinfo"></div>
      <div class="wave-area" id="st-wave-area">
        <canvas id="st-wave"></canvas>
        <div class="playhead" id="st-playhead"></div>
        <div class="wave-guide" id="st-wave-guide"></div>
        <div class="wave-tip" id="st-wave-tip"></div>
      </div>
    </div>
    <div class="transport" id="st-transport">
      <button type="button" class="tp-btn tp-play" id="st-play" disabled aria-label={labels.playLabel}>
        <svg class="ico" id="st-play-ico" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      </button>
      <button type="button" class="tp-btn tp-stop" id="st-stop" disabled aria-label={labels.stopLabel}>
        <svg viewBox="0 0 24 24" fill="currentColor"><rect x="7" y="7" width="10" height="10" rx="2"/></svg>
      </button>
      <span class="tp-time" id="st-cur" hidden>0:00</span>
      <span class="tp-total" id="st-total" hidden>0:00</span>
    </div>

    <div class="row" id="st-settings">
      <div class="field">
        <label for="st-lang">{labels.sttLanguageLabel}</label>
        <select id="st-lang"></select>
      </div>
      <div class="field">
        <label for="st-task">{labels.sttTaskLabel}</label>
        <select id="st-task">
          <option value="transcribe">{labels.sttTaskTranscribeLabel}</option>
          <option value="translate">{labels.sttTaskTranslateLabel}</option>
        </select>
      </div>
      <div class="field">
        <label for="st-quality">{labels.sttQualityLabel}</label>
        <select id="st-quality">
          <option value="small" selected>{labels.sttQualityBestLabel}</option>
          <option value="base">{labels.sttQualityFastLabel}</option>
        </select>
      </div>
    </div>
    <div class="format-hint" id="st-quality-hint"></div>

    {!isVoice && (
    <label class="check-row" for="st-speakers">
      <input type="checkbox" id="st-speakers">
      <span>
        <b>{labels.sttSpeakersLabel}</b>
        <span class="check-hint">{labels.sttSpeakersHint}</span>
      </span>
    </label>
    )}

    <div class="progress" id="st-progress">
      <div class="progress-bar"><div class="progress-fill" id="st-progress-fill"></div></div>
    </div>
    {/* The stage caption and a clock beside it. During a long transcription nothing else on the
        page moves, and a still screen reads as a hung one -- which is exactly how it felt. */}
    <div class="stage-text"><span id="st-stage"></span><span class="stage-clock" id="st-timer"></span></div>

    <div class="controls" id="st-run-row">
      {/* Disabled until a file is loaded. The panel hides it anyway, but a control that looks
          live with nothing to act on is the same defect the audio tools had with download. */}
      <button type="button" class="act primary" id="st-run" disabled>
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICO.text} />
        <span id="st-run-label">{labels.sttRunLabel}</span>
      </button>
    </div>

    <div class="results" id="st-results" style="display:none">
      <div class="summary" id="st-summary"></div>

      {/* Timestamps and subtitles belong to a recording of something that happened; dictation is
          just text, and the extra controls would only be in the way. */}
      {!isVoice && (
      <div class="view-toggle" id="st-view-toggle">
        <button type="button" class="vt-seg active" data-view="plain">{labels.sttViewPlainLabel}</button>
        <button type="button" class="vt-seg" data-view="stamped">{labels.sttViewStampedLabel}</button>
      </div>
      )}

      {/* Editable on purpose. No recogniser is perfect, and fixing two words in place beats
          copying the text somewhere else to fix it there. */}
      <textarea id="st-text" spellcheck="true" aria-label={labels.sttTextAreaLabel}></textarea>
      <div class="text-note" id="st-edit-note"></div>

      <div class="text-actions">
        <button type="button" class="act" id="st-copy">
          <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICO.copy} />
          <span id="st-copy-label">{labels.sttCopyLabel}</span>
        </button>
        <button type="button" class="act" id="st-clear">
          <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICO.trash} />
          {labels.sttClearLabel}
        </button>
      </div>

      <div class="deck">
        <div class="field field-fmt">
          <label for="st-fmt">{labels.formatLabel}</label>
          <select id="st-fmt">
            <option value="txt">TXT</option>
            {!isVoice && <option value="srt">SRT</option>}
            {!isVoice && <option value="vtt">VTT</option>}
          </select>
        </div>
        <button type="button" class="act primary deck-act" id="st-dl">
          <svg class="i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={ICO.download} />
          {labels.downloadResultLabel}
        </button>
      </div>
      <div class="fmt-hint" id="st-fmt-hint"></div>
    </div>

    <div class="err" id="st-err"></div>
  </div>
</div>

<script>
  import { decodeFile, drawWaveform, createLiveWaveform, createPlayer, startKeeper } from '../lib/web-audio-engine.js';
  import { toSrt, toVtt, toPlainText, toTimestamped, countWords, normalizeChunks,
    attachSpeakers, speakerCount, toSpeakerText, toSpeakerTimestamped } from '../lib/transcript-format.js';

  // Pinned exactly. A floating tag would change everyone's results on a silent major bump.
  const TRANSFORMERS = 'https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.5.1/dist/transformers.min.js';
  // `rate` is seconds of work per second of audio, measured on this page (not on a benchmark
  // harness) against 188 seconds of Russian speech on a desktop with the model already cached:
  // the light model ran at 0.22x, the best one at 0.82x. That is nearly a fourfold difference and
  // it decides whether an hour-long lecture takes thirteen minutes or fifty, so it is shown to
  // the user for their actual file rather than left as a surprise.
  const MODELS = {
    small: { repo: 'onnx-community/whisper-small', mb: 240, rate: 0.82 },
    base: { repo: 'onnx-community/whisper-base', mb: 76, rate: 0.22 },
  };
  const MODEL_RATE = 16000;   // what Whisper was trained on
  const MAX_MINUTES = 60;
  const WARN_MINUTES = 20;

  // Every language Whisper knows: its own two- or three-letter code and its own name for it,
  // which is what the pipeline wants. There are 99 of them and no list of translations is kept
  // here -- the browser writes each name in the page's own language through Intl.DisplayNames,
  // so adding a site locale costs nothing and never leaves a language untranslated.
  const WHISPER_LANGS = [
    ['en','english'],['zh','chinese'],['de','german'],['es','spanish'],['ru','russian'],['ko','korean'],
    ['fr','french'],['ja','japanese'],['pt','portuguese'],['tr','turkish'],['pl','polish'],['ca','catalan'],
    ['nl','dutch'],['ar','arabic'],['sv','swedish'],['it','italian'],['id','indonesian'],['hi','hindi'],
    ['fi','finnish'],['vi','vietnamese'],['he','hebrew'],['uk','ukrainian'],['el','greek'],['ms','malay'],
    ['cs','czech'],['ro','romanian'],['da','danish'],['hu','hungarian'],['ta','tamil'],['no','norwegian'],
    ['th','thai'],['ur','urdu'],['hr','croatian'],['bg','bulgarian'],['lt','lithuanian'],['la','latin'],
    ['mi','maori'],['ml','malayalam'],['cy','welsh'],['sk','slovak'],['te','telugu'],['fa','persian'],
    ['lv','latvian'],['bn','bengali'],['sr','serbian'],['az','azerbaijani'],['sl','slovenian'],['kn','kannada'],
    ['et','estonian'],['mk','macedonian'],['br','breton'],['eu','basque'],['is','icelandic'],['hy','armenian'],
    ['ne','nepali'],['mn','mongolian'],['bs','bosnian'],['kk','kazakh'],['sq','albanian'],['sw','swahili'],
    ['gl','galician'],['mr','marathi'],['pa','punjabi'],['si','sinhala'],['km','khmer'],['sn','shona'],
    ['yo','yoruba'],['so','somali'],['af','afrikaans'],['oc','occitan'],['ka','georgian'],['be','belarusian'],
    ['tg','tajik'],['sd','sindhi'],['gu','gujarati'],['am','amharic'],['yi','yiddish'],['lo','lao'],
    ['uz','uzbek'],['fo','faroese'],['ht','haitian creole'],['ps','pashto'],['tk','turkmen'],['nn','nynorsk'],
    ['mt','maltese'],['sa','sanskrit'],['lb','luxembourgish'],['my','myanmar'],['bo','tibetan'],['tl','tagalog'],
    ['mg','malagasy'],['as','assamese'],['tt','tatar'],['haw','hawaiian'],['ln','lingala'],['ha','hausa'],
    ['ba','bashkir'],['jw','javanese'],['su','sundanese'],['yue','cantonese'],
  ];
  // Whisper's codes are not all valid BCP 47 tags; these are the ones Intl needs spelled its way.
  const INTL_ALIAS = { jw: 'jv', yue: 'yue', haw: 'haw', nn: 'nn' };
  // Offered first because they are what this site's visitors actually upload; the rest follow in
  // alphabetical order of their translated names.
  const COMMON = ['ru', 'uk', 'en', 'es', 'de', 'fr', 'pl', 'it', 'pt', 'tr', 'kk', 'ar', 'zh', 'ja', 'ko'];
  const BY_CODE = new Map(WHISPER_LANGS.map((l) => [l[0], l]));

  const root = document.querySelector('.stt-tool');
  if (root) {
    const labels = JSON.parse(root.dataset.labels);
    const isVoice = root.dataset.mode === 'voice';
    const $ = (id) => root.querySelector('#' + id);

    const drop = $('st-drop');
    const fileInput = $('st-file');
    const micRow = $('st-mic-row');
    const micBtn = $('st-mic');
    const micLabel = $('st-mic-label');
    const micTime = $('st-mic-time');
    const panel = $('st-panel');
    const fileInfo = $('st-fileinfo');
    const waveShell = $('st-wave-shell');
    const waveCanvas = $('st-wave');
    const playBtn = $('st-play');
    const playIco = $('st-play-ico');
    const curEl = $('st-cur');
    const totalEl = $('st-total');
    const playhead = $('st-playhead');
    const stopBtn = $('st-stop');
    const waveArea = $('st-wave-area');
    const waveGuide = $('st-wave-guide');
    const waveTip = $('st-wave-tip');
    const langSel = $('st-lang');
    const taskSel = $('st-task');
    const qualitySel = $('st-quality');
    const speakersBox = $('st-speakers');
    const qualityHint = $('st-quality-hint');
    const progress = $('st-progress');
    const progressFill = $('st-progress-fill');
    const stageEl = $('st-stage');
    const timerEl = $('st-timer');
    const runBtn = $('st-run');
    const runLabel = $('st-run-label');
    const results = $('st-results');
    const summaryEl = $('st-summary');
    const viewToggle = $('st-view-toggle');
    const textEl = $('st-text');
    const editNote = $('st-edit-note');
    const copyBtn = $('st-copy');
    const copyLabel = $('st-copy-label');
    const clearBtn = $('st-clear');
    const fmtSelect = $('st-fmt');
    const fmtHint = $('st-fmt-hint');
    const dlBtn = $('st-dl');
    const errBox = $('st-err');

    const ICO_WAVE = '<path d="M4 10v4"/><path d="M8 6v12"/><path d="M12 9v6"/><path d="M16 4v16"/><path d="M20 10v4"/>';
    const ICO_CLOSE = '<path d="M6 6l12 12"/><path d="M18 6L6 18"/>';
    const ICO_UPLOAD = '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 8l5-5 5 5M12 3v12"/>';
    const ICO_PLAY = '<path d="M8 5v14l11-7z"/>';
    const ICO_PAUSE = '<rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/>';
    const svgIco = (p, c) => `<svg class="${c}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
    const escapeHtml = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    startKeeper();   // держатель тишины для iOS, см. ios-keeper.js
    const player = createPlayer();
    // Сторож молчания: если браузер прервал звук (Safari делает это, когда вкладка уходит
    // в фон), нажатие на пуск не даёт НИЧЕГО -- ни звука, ни ошибки. Теперь страница
    // говорит, что случилось, вместо того чтобы молча притворяться рабочей.
    player.onStuck(() => showError(labels.audioStuckLabel));
    let file = null;
    let sourceBuffer = null;
    let asr = null;
    let asrKey = '';
    let chunks = [];
    let edited = false;
    let view = 'plain';
    let rafId = 0;

    // Names written by the browser in the page's own language, capitalised the way a list wants.
    const locale = root.dataset.locale || 'en';
    let displayNames = null;
    try { displayNames = new Intl.DisplayNames([locale], { type: 'language' }); } catch (e) { /* older browser */ }
    function nameOf(code, fallback) {
      let n = null;
      try { n = displayNames ? displayNames.of(INTL_ALIAS[code] || code) : null; } catch (e) { n = null; }
      if (!n || n === code) n = fallback || code;
      return n.charAt(0).toUpperCase() + n.slice(1);
    }
    const named = WHISPER_LANGS.map(([code, whisper]) => ({ code, whisper, label: nameOf(code, whisper) }));
    const common = COMMON.map((c) => named.find((n) => n.code === c)).filter(Boolean);
    const rest = named.filter((n) => !COMMON.includes(n.code)).sort((a, b) => a.label.localeCompare(b.label, locale));
    const auto = document.createElement('option');
    auto.value = 'auto';
    auto.textContent = labels.sttLangAuto;
    langSel.appendChild(auto);
    for (const group of [common, rest]) {
      for (const n of group) {
        const o = document.createElement('option');
        o.value = n.whisper;
        o.dataset.code = n.code;
        o.textContent = n.label;
        langSel.appendChild(o);
      }
    }
    langSel.value = 'auto';
    let detectedName = null;   // what auto-detection found, for the summary

    /**
     * Whisper predicts the language itself, as the very first token after the start marker.
     * transformers.js never lets it: with no `language` option it forces English, so a Russian
     * recording came back translated into English and the "detect automatically" choice was a lie.
     * Feeding only the start token and generating exactly one more gives the model's own answer,
     * which is what this does. Measured: correct on Russian, English and Ukrainian in under two
     * seconds, on thirty seconds of audio.
     */
    async function detectLanguage(audio) {
      const tok = asr.tokenizer;
      const ids = tok.model.tokens_to_ids;
      const idOf = (t) => (ids && typeof ids.get === 'function' ? ids.get(t) : ids?.[t]);
      const sot = idOf('<|startoftranscript|>');
      if (sot == null) return null;
      const inputs = await asr.processor(audio.slice(0, MODEL_RATE * 30));
      const out = await asr.model.generate({ ...inputs, decoder_input_ids: [[sot]], max_new_tokens: 1, return_dict_in_generate: true });
      const seq = out.sequences?.tolist ? out.sequences.tolist() : out.sequences;
      const last = seq?.[0]?.[seq[0].length - 1];
      if (last == null) return null;
      const text = tok.decode([Number(last)], { skip_special_tokens: false });
      const code = (String(text).match(/^<\|([a-z]{2,3})\|>$/) || [])[1];
      return code || null;
    }

    function showError(m) { errBox.textContent = m; errBox.classList.add('show'); }
    function clearError() { errBox.classList.remove('show'); }
    const fmtClock = (s) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    let stageTimer = 0;
    function setStage(text, pct) {
      clearTimeout(stageTimer);
      stageEl.textContent = text || '';
      if (text) { progress.classList.add('on'); progressFill.style.width = (pct == null ? 0 : pct) + '%'; }
      else progress.classList.remove('on');
    }
    function finishStage(text) {
      clearTimeout(stageTimer);
      progressFill.style.width = '100%';
      stageEl.textContent = text;
      stageTimer = window.setTimeout(() => { progress.classList.remove('on'); stageEl.textContent = ''; }, 2200);
    }

    // A clock, ticking on the page's own thread -- which it can only do because the model runs in
    // a worker. Elapsed time is always shown because it is always true; the estimate is only
    // offered while it still holds, and once it runs out the line says "almost done" rather than
    // counting into the negative or freezing on zero, either of which would be a small lie.
    let clockTimer = 0;
    let clockStart = 0;      // when the whole run began -- the elapsed count never restarts
    let phaseStart = 0;      // when the current phase began -- what the estimate counts against
    let clockEstimate = 0;
    function startClock() {
      stopClock();
      clockStart = phaseStart = Date.now();
      clockEstimate = 0;
      const tick = () => {
        const elapsed = (Date.now() - clockStart) / 1000;
        let text = fmtClock(elapsed);
        if (clockEstimate > 0) {
          const left = clockEstimate - (Date.now() - phaseStart) / 1000;
          text += ' · ' + (left > 1
            ? (labels.sttRemainingLabel || '').replace('{t}', fmtClock(left))
            : (labels.sttAlmostLabel || ''));
        }
        timerEl.textContent = text;
      };
      tick();
      clockTimer = window.setInterval(tick, 1000);
    }
    // The estimate only becomes meaningful once the model is loaded and the work itself starts;
    // before that the wait is a download whose speed nobody here knows. Only the PHASE clock is
    // reset -- restarting the elapsed count too made the seconds jump backwards from 0:04 to 0:00,
    // which reads as a glitch for the same reason a percentage falling from 100 to 13 does.
    function setClockEstimate(seconds) {
      clockEstimate = seconds || 0;
      phaseStart = Date.now();
    }
    function stopClock() {
      clearInterval(clockTimer);
      clockTimer = 0;
      timerEl.textContent = '';
    }

    function renderQualityHint() {
      const m = MODELS[qualitySel.value];
      let text = labels.sttQualityHint || '';
      if (sourceBuffer) {
        // An estimate for THIS file, which is the only form of "it depends" anyone can act on.
        const secs = sourceBuffer.duration * m.rate;
        const pretty = secs < 90
          ? Math.max(5, Math.round(secs / 5) * 5) + ' ' + (labels.sttSecondsShortLabel || 's')
          : Math.max(1, Math.round(secs / 60)) + ' ' + (labels.sttMinutesShortLabel || 'min');
        text += ' ' + (labels.sttEstimateLabel || '').replace('{time}', pretty);
      }
      qualityHint.textContent = text;
    }
    qualitySel.addEventListener('change', renderQualityHint);
    renderQualityHint();

    /* --- input --------------------------------------------------------------------------- */
    if (drop) {
      drop.addEventListener('click', () => fileInput.click());
      drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('over'); });
      drop.addEventListener('dragleave', () => drop.classList.remove('over'));
      drop.addEventListener('drop', (e) => { e.preventDefault(); drop.classList.remove('over'); if (e.dataTransfer.files[0]) pickFile(e.dataTransfer.files[0]); });
    }
    fileInput.addEventListener('change', (e) => {
      const f = e.target.files[0];
      // Cleared immediately so picking the same file again still fires a change event.
      e.target.value = '';
      if (f) pickFile(f);
    });

    function resetAll() {
      player.stop();
      cancelAnimationFrame(rafId);
      file = null; sourceBuffer = null; chunks = []; edited = false;
      fileInfo.innerHTML = '';
      panel.classList.remove('on');
      if (drop) drop.style.display = '';
      if (micRow) micRow.style.display = '';
      waveShell.style.display = 'none';
      results.style.display = 'none';
      runBtn.disabled = true;
      runLabel.textContent = labels.sttRunLabel;
      playBtn.disabled = true;
      playIco.innerHTML = ICO_PLAY;
      textEl.value = '';
      setStage('');
      clearError();
    }

    async function pickFile(f) {
      clearError();
      player.stop();
      cancelAnimationFrame(rafId);
      chunks = []; edited = false;
      // Cleared before the decode, not after: the dictation page auto-runs once pickFile settles,
      // and a stale buffer from the previous take would be transcribed instead of the new one.
      sourceBuffer = null;
      results.style.display = 'none';
      runBtn.disabled = true;
      runLabel.textContent = labels.sttRunLabel;
      file = f;

      const sizeMB = f.size / (1024 * 1024);
      const swapLabel = escapeHtml(labels.newFileLabel || 'Upload a different file');
      const removeLabel = escapeHtml(labels.removeFileLabel || 'Remove');
      // No "swap file" button on the dictation page: there was no file to swap, and the button
      // would open a file picker, which is not what anyone who just spoke into a microphone wants.
      const swapBtn = isVoice ? '' : `<button type="button" class="fi-act fi-swap" id="st-fi-swap" aria-label="${swapLabel}" title="${swapLabel}">${svgIco(ICO_UPLOAD, 'i')}</button>`;
      fileInfo.innerHTML = `<div class="fi-row">${svgIco(ICO_WAVE, 'fi-ico')}<span class="fi-name">${escapeHtml(f.name)}</span><span class="fi-size">${sizeMB.toFixed(1)} MB</span>${swapBtn}<button type="button" class="fi-act fi-remove" id="st-fi-remove" aria-label="${removeLabel}" title="${removeLabel}">${svgIco(ICO_CLOSE, 'i')}</button></div>`;
      if (!isVoice) $('st-fi-swap').addEventListener('click', () => fileInput.click());
      $('st-fi-remove').addEventListener('click', resetAll);
      panel.classList.add('on');
      if (drop) drop.style.display = 'none';
      if (micRow) micRow.style.display = 'none';
      waveShell.style.display = '';

      setStage(labels.sttReadingLabel);
      try {
        sourceBuffer = await decodeFile(f);
      } catch (e) {
        setStage('');
        showError(labels.sttDecodeErrorLabel);
        return;
      }
      if (sourceBuffer.duration > MAX_MINUTES * 60) {
        setStage('');
        showError((labels.sttTooLongLabel || '').replace('{n}', String(MAX_MINUTES)));
        return;
      }
      setStage('');
      totalEl.textContent = fmtClock(sourceBuffer.duration);
      curEl.textContent = '0:00';
      playhead.style.display = 'none';
      playBtn.disabled = false;
      runBtn.disabled = false;
      renderQualityHint();
      if (sourceBuffer.duration > WARN_MINUTES * 60) {
        // Not an error -- just an honest heads-up before someone starts a long wait.
        showError((labels.sttLongFileNoteLabel || '').replace('{n}', String(Math.round(sourceBuffer.duration / 60))));
      }
      drawWave();
      window.dispatchEvent(new Event('opitro:tool-interaction'));
    }

    function drawWave(attempt = 0) {
      if (!sourceBuffer) return;
      if (waveCanvas.clientWidth < 2 && attempt < 6) { requestAnimationFrame(() => drawWave(attempt + 1)); return; }
      drawWaveform(waveCanvas, sourceBuffer);
    }
    new ResizeObserver(() => { if (sourceBuffer) drawWaveform(waveCanvas, sourceBuffer); }).observe(waveCanvas);

    /* --- microphone ---------------------------------------------------------------------- */
    let recorder = null, recChunks = [], recTimer = 0, recStart = 0;
    // Волна во время диктовки. Здесь она нужнее, чем где-либо: человек говорит в телефон и до
    // этого не имел ни одного признака, что его слышат, -- только счётчик времени, который
    // идёт одинаково и при выключенном микрофоне. Та же функция, что у диктофона, чтобы обе
    // страницы рисовали одно и то же, а не разошлись со временем.
    const liveWave = waveCanvas ? createLiveWaveform(waveCanvas) : null;
    let meterCtx = null, meterRaf = 0;
    function startLiveWave(stream) {
      stopLiveWave();
      if (!liveWave) return;
      waveShell.style.display = '';
      panel.classList.add('on');
      liveWave.start();
      try {
        meterCtx = new (window.AudioContext || window.webkitAudioContext)();
        const an = meterCtx.createAnalyser();
        an.fftSize = 1024;
        meterCtx.createMediaStreamSource(stream).connect(an);
        const buf = new Float32Array(an.fftSize);
        const tick = () => {
          an.getFloatTimeDomainData(buf);
          let peak = 0;
          for (const v of buf) { const a = Math.abs(v); if (a > peak) peak = a; }
          liveWave.push(Math.min(1, peak * 1.4));
          meterRaf = requestAnimationFrame(tick);
        };
        tick();
      } catch (e) { /* волна -- удобство, а не условие записи */ }
    }
    function stopLiveWave() {
      cancelAnimationFrame(meterRaf);
      meterRaf = 0;
      if (liveWave) liveWave.stop();
      if (meterCtx) { try { meterCtx.close(); } catch (e) {} meterCtx = null; }
    }
    if (micBtn) micBtn.addEventListener('click', async () => {
      if (recorder && recorder.state === 'recording') { recorder.stop(); return; }
      let stream;
      try {
        stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      } catch (e) {
        showError(labels.micDeniedLabel || 'No microphone access.');
        return;
      }
      clearError();
      recChunks = [];
      recorder = new MediaRecorder(stream);
      recorder.ondataavailable = (e) => { if (e.data.size) recChunks.push(e.data); };
      recorder.onstop = () => {
        clearInterval(recTimer);
        stopLiveWave();
        stream.getTracks().forEach((t) => t.stop());
        micBtn.classList.remove('on');
        micLabel.textContent = labels.sttRecordLabel;
        micTime.textContent = '';
        const blob = new Blob(recChunks, { type: recorder.mimeType || 'audio/webm' });
        const ext = (recorder.mimeType || '').includes('mp4') ? 'm4a' : 'webm';
        // On the dictation page the recording IS the request: making someone press a second
        // button after they have stopped talking adds a step for nothing.
        pickFile(new File([blob], (labels.sttRecordingFileName || 'recording') + '.' + ext, { type: blob.type }))
          .then(() => { if (isVoice && sourceBuffer) runBtn.click(); });
      };
      recorder.start();
      startLiveWave(stream);
      recStart = performance.now();
      micBtn.classList.add('on');
      micLabel.textContent = labels.sttStopLabel;
      recTimer = window.setInterval(() => { micTime.textContent = fmtClock((performance.now() - recStart) / 1000); }, 250);
    });

    /* --- playback ------------------------------------------------------------------------ */
    function setPlayhead(frac) {
      const base = waveCanvas.offsetLeft;
      const w = waveCanvas.clientWidth || waveShell.clientWidth;
      playhead.style.left = (base + Math.max(0, Math.min(1, frac)) * w) + 'px';
      playhead.style.display = 'block';
    }
    function tick() {
      const pos = player.getPosition();
      curEl.textContent = fmtClock(pos);
      curEl.hidden = false;
      if (stopBtn) stopBtn.disabled = false;
      if (замер) return;
      if (sourceBuffer) setPlayhead(pos / sourceBuffer.duration);
      if (player.isPlaying()) rafId = requestAnimationFrame(tick);
    }
    // Куда встал бегунок нажатием по волне -- отсюда пойдёт следующее «играть».
    let стоп = null;
    let замер = false;   // бегунок поставлен рукой -- отрисовка не спорит
    function startPlayback(seekTo) {
      if (seekTo == null && стоп != null) { seekTo = стоп; стоп = null; }
      замер = false;
      player.unlock();
      player.play(sourceBuffer, null, () => {
        playIco.innerHTML = ICO_PLAY;
        cancelAnimationFrame(rafId);
        curEl.textContent = fmtClock(0);
        curEl.hidden = true;
        if (stopBtn) stopBtn.disabled = true;
        playhead.style.display = 'none';
      }, seekTo);
      playIco.innerHTML = ICO_PAUSE;
      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(tick);
    }
    playBtn.addEventListener('click', (e) => {
      // Swapping the glyph detaches the event target, which the shell's own handler then cannot
      // match -- without this, playback stops a few milliseconds after it starts.
      e.stopPropagation();
      if (!sourceBuffer) return;
      if (player.isPlaying()) { player.pause(); playIco.innerHTML = ICO_PLAY; cancelAnimationFrame(rafId); }
      else startPlayback();
    });
    // Стоп: остановить и вернуть в начало. Выделения на этой странице нет, поэтому начало
    // выделения и начало файла -- одно и то же.
    if (stopBtn) {
      stopBtn.addEventListener('click', () => {
        player.reset();
        cancelAnimationFrame(rafId);
        playIco.innerHTML = ICO_PLAY;
        playhead.style.display = 'none';
        curEl.textContent = fmtClock(0);
        curEl.hidden = true;
        stopBtn.disabled = true;
      });
    }
    // Подсказка со временем под курсором -- как на остальных инструментах.
    // ПЕРЕМОТКА ЗДЕСЬ УЖЕ ЕСТЬ -- обработчик на самой волне ниже (waveShell click). Я
    // добавил второй, и звук стал накладываться: два воспроизведения разом. Свой убрал.
    // Урок: прежде чем добавлять обработчик, проверить, нет ли такого же ниже по файлу.
    if (waveArea && waveGuide && waveTip) {
      waveArea.addEventListener('mousemove', (e) => {
        if (!sourceBuffer) return;
        const r = waveArea.getBoundingClientRect();
        const x = Math.max(0, Math.min(r.width, e.clientX - r.left));
        waveGuide.style.left = x + 'px';
        waveGuide.style.display = 'block';
        waveTip.textContent = fmtClock((x / r.width) * sourceBuffer.duration);
        waveTip.style.display = 'block';
        const half = waveTip.offsetWidth / 2;
        waveTip.style.left = Math.max(half + 2, Math.min(r.width - half - 2, x)) + 'px';
      });
      waveArea.addEventListener('mouseleave', () => {
        waveGuide.style.display = 'none';
        waveTip.style.display = 'none';
      });
    }
    waveShell.addEventListener('click', (e) => {
      if (!sourceBuffer) return;
      if (e.composedPath().some((n) => n instanceof Element && n.classList?.contains('wave-play-btn'))) return;
      const r = waveCanvas.getBoundingClientRect();
      const место = Math.max(0, Math.min(1, (e.clientX - r.left) / r.width)) * sourceBuffer.duration;
      // Прежний звук ГЛУШИМ, иначе новый ложится поверх и слышно два разом -- владелец это
      // и услышал. Дальше играем с нового места.
      try { player.stop(); } catch (err) {}
      cancelAnimationFrame(rafId);
      startPlayback(место);
    });

    /* --- transcription -------------------------------------------------------------------- */
    // Decoded straight to 16 kHz mono from the original file, NOT resampled down from the buffer
    // the player uses. That buffer is already at the device's rate (usually 48 kHz), so going
    // through it means resampling twice, and measured on the same 48-word passage that cost real
    // accuracy: 89.6% through the double conversion against 95.8% decoding once at 16 kHz.
    async function toModelRate(f, fallbackBuffer) {
      try {
        const ctx = new (window.AudioContext || window.webkitAudioContext)({ sampleRate: MODEL_RATE });
        const decoded = await ctx.decodeAudioData(await f.arrayBuffer());
        ctx.close();
        if (decoded.sampleRate === MODEL_RATE) {
          if (decoded.numberOfChannels === 1) return decoded.getChannelData(0);
          const a = decoded.getChannelData(0), b = decoded.getChannelData(1);
          const mono = new Float32Array(a.length);
          for (let i = 0; i < a.length; i++) mono[i] = (a[i] + b[i]) / 2;
          return mono;
        }
      } catch (e) {
        // Safari has historically ignored the requested sample rate, and some containers only
        // decode through the default context. Falling back keeps the tool working.
      }
      const oc = new OfflineAudioContext(1, Math.ceil(fallbackBuffer.duration * MODEL_RATE), MODEL_RATE);
      const src = oc.createBufferSource();
      src.buffer = fallbackBuffer;
      src.connect(oc.destination);
      src.start(0);
      return (await oc.startRendering()).getChannelData(0);
    }

    // One worker for the life of the page, so the model stays loaded between runs.
    let worker = null;
    let pending = null;
    const STAGE_LABELS = {
      connecting: 'sttLoadingModelLabel',
      detecting: 'sttDetectingLabel',
      transcribing: 'sttTranscribingLabel',
      translating: 'sttTranslatingLabel',
      loadingSpeakers: 'sttLoadingSpeakersLabel',
      speakers: 'sttSpeakersStageLabel',
    };
    function ensureWorker() {
      if (worker) return worker;
      worker = new Worker(new URL('../lib/stt-worker.js', import.meta.url), { type: 'module' });
      worker.onmessage = (e) => {
        const m = e.data || {};
        if (m.type === 'stage') {
          setStage(labels[STAGE_LABELS[m.stage]] || '', m.stage === 'connecting' ? 1 : 60);
          // Once the audio itself is being worked through, the wait becomes predictable: the rate
          // for each model was measured on this page, so the estimate is arithmetic, not a guess.
          if (m.stage === 'transcribing' || m.stage === 'translating') {
            const model = MODELS[qualitySel.value];
            setClockEstimate(sourceBuffer ? sourceBuffer.duration * model.rate : 0);
          } else if (m.stage === 'speakers' || m.stage === 'detecting') {
            setClockEstimate(0);
          }
        }
        else if (m.type === 'progress') setStage((labels.sttDownloadingLabel || '').replace('{pct}', String(Math.round(m.pct))), m.pct * 0.55);
        else if (m.type === 'done' || m.type === 'failed') { const p = pending; pending = null; if (p) p(m); }
      };
      worker.onerror = () => { const p = pending; pending = null; if (p) p({ type: 'failed', message: '' }); };
      return worker;
    }

    runBtn.addEventListener('click', async () => {
      if (!sourceBuffer || pending) return;
      clearError();
      runBtn.disabled = true;
      runLabel.textContent = labels.sttRunningLabel;
      try {
        const model = MODELS[qualitySel.value];
        setStage(labels.sttPreparingLabel, 1);
        startClock();
        const audio = await toModelRate(file, sourceBuffer);
        const langValue = langSel.value;
        const result = await new Promise((resolve) => {
          pending = resolve;
          // The audio buffer is transferred, not copied: a long recording is tens of megabytes and
          // cloning it would double the memory for no reason.
          ensureWorker().postMessage({
            type: 'run', rate: MODEL_RATE, audio,
            repo: model.repo, key: qualitySel.value, totalBytes: model.mb * 1e6,
            language: langValue === 'auto' ? null : langValue,
            task: taskSel.value === 'translate' ? 'translate' : 'transcribe',
            speakers: !!(speakersBox && speakersBox.checked),
          }, [audio.buffer]);
        });
        if (result.type === 'failed') throw new Error(result.message || '');

        detectedName = null;
        if (result.detected) {
          const known = BY_CODE.get(result.detected);
          detectedName = known ? nameOf(known[0], known[1]) : result.detected.toUpperCase();
        }
        const raw = result.chunks && result.chunks.length ? result.chunks
          : [{ timestamp: [0, sourceBuffer.duration], text: result.text || '' }];
        chunks = result.speakers && result.speakers.length
          ? attachSpeakers(raw, result.speakers, { duration: sourceBuffer.duration })
          : normalizeChunks(raw, sourceBuffer.duration);
        if (!chunks.length) {
          stopClock();
          setStage('');
          showError(labels.sttEmptyLabel);
          runBtn.disabled = false;
          return;
        }
        edited = false;
        renderText();
        renderSummary();
        renderFmtHint();
        stopClock();
        finishStage(labels.sttDoneLabel);
        results.style.display = '';
        window.dispatchEvent(new Event('opitro:tool-interaction'));
      } catch (e) {
        stopClock();
        setStage('');
        showError((labels.sttFailedLabel || 'Failed.') + ' ' + (e && e.message ? e.message : ''));
      } finally {
        runBtn.disabled = false;
        runLabel.textContent = labels.sttRunLabel;
      }
    });

    // Changing a setting after a run has to be actionable. The run row used to be hidden on
    // success, so switching model or language left no way to try again short of removing the file
    // and adding it back -- which is exactly what happened.
    for (const sel of [qualitySel, taskSel, langSel, speakersBox].filter(Boolean)) {
      sel.addEventListener('change', () => {
        if (!chunks.length) return;
        runLabel.textContent = labels.sttRerunLabel || labels.sttRunLabel;
      });
    }

    /* --- results -------------------------------------------------------------------------- */
    const speakerName = (n) => (labels.sttSpeakerName || 'Speaker {n}').replace('{n}', String(n));
    function bodyFor(v) {
      const opts = { duration: sourceBuffer ? sourceBuffer.duration : 0 };
      if (speakerCount(chunks) > 1) {
        return v === 'stamped' ? toSpeakerTimestamped(chunks, speakerName) : toSpeakerText(chunks, speakerName, opts);
      }
      // One voice, or none found: names would be noise.
      return v === 'stamped' ? toTimestamped(chunks, opts) : toPlainText(chunks, opts);
    }
    function renderText() {
      textEl.value = bodyFor(view);
      updateCount();
    }
    function updateCount() {
      const words = countWords(textEl.value);
      const cells = [
        [labels.sttStatWordsLabel, String(words)],
        [labels.sttStatCharsLabel, String(textEl.value.length)],
        [labels.sttStatDurationLabel, sourceBuffer ? fmtClock(sourceBuffer.duration) : '—'],
      ];
      // Only when it was detected rather than chosen -- otherwise it just repeats the dropdown.
      if (detectedName) cells.push([labels.sttStatLanguageLabel, detectedName]);
      const voices = speakerCount(chunks);
      if (voices > 1) cells.push([labels.sttStatSpeakersLabel, String(voices)]);
      summaryEl.innerHTML = cells.map(([l, v]) => `<div class="sum-cell"><span class="sum-label">${escapeHtml(l)}</span><span class="sum-value">${escapeHtml(v)}</span></div>`).join('');
    }
    function renderSummary() { updateCount(); }

    textEl.addEventListener('input', () => {
      edited = true;
      updateCount();
      // Switching views would throw away hand corrections, so once the text has been touched the
      // toggle says so instead of silently replacing it.
      editNote.textContent = labels.sttEditedNote || '';
    });

    if (viewToggle) viewToggle.addEventListener('click', (e) => {
      const btn = e.target.closest('.vt-seg');
      if (!btn || btn.dataset.view === view) return;
      if (edited && !window.confirm(labels.sttSwitchWarning || 'Your edits will be lost. Continue?')) return;
      view = btn.dataset.view;
      viewToggle.querySelectorAll('.vt-seg').forEach((b) => b.classList.toggle('active', b === btn));
      edited = false;
      editNote.textContent = '';
      renderText();
    });

    copyBtn.addEventListener('click', async () => {
      if (!textEl.value.trim()) return;
      try {
        await navigator.clipboard.writeText(textEl.value);
      } catch (e) {
        // Clipboard access can be refused; selecting the text is something the user can act on.
        textEl.select();
        showError(labels.sttCopyFailedLabel);
        return;
      }
      const original = copyLabel.textContent;
      copyLabel.textContent = labels.sttCopiedLabel;
      setTimeout(() => { copyLabel.textContent = original; }, 1500);
    });

    clearBtn.addEventListener('click', () => {
      textEl.value = '';
      edited = true;
      editNote.textContent = '';
      updateCount();
    });

    function renderFmtHint() {
      const hints = labels.sttFmtHints || {};
      fmtHint.textContent = hints[fmtSelect.value] || '';
    }
    fmtSelect.addEventListener('change', renderFmtHint);

    dlBtn.addEventListener('click', () => {
      const base = (file?.name || 'transcript').replace(/\.[^.]+$/, '');
      const duration = sourceBuffer ? sourceBuffer.duration : 0;
      const fmt = fmtSelect.value;
      let body, ext;
      // Subtitles name the speaker the way captions normally do, but only when there is more
      // than one -- a single-speaker recording would just repeat "Speaker 1" on every line.
      const named = speakerCount(chunks) > 1
        ? chunks.map((c) => ({ ...c, text: (c.speaker ? speakerName(c.speaker) + ': ' : '') + c.text }))
        : chunks;
      if (fmt === 'srt') { body = toSrt(named, { duration }); ext = 'srt'; }
      else if (fmt === 'vtt') { body = toVtt(named, { duration }); ext = 'vtt'; }
      // Plain text follows what is on screen, edits included -- subtitles cannot, because the
      // timings belong to the recognised chunks rather than to the edited text.
      else { body = textEl.value; ext = 'txt'; }
      const blob = new Blob([body], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = base + '.' + ext;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      window.dispatchEvent(new Event('opitro:tool-interaction'));
    });
  }
</script>

